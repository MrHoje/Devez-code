{
  // Cloudflare Workers 설정. 배포 전 compatibility_date 를 실제 배포일 기준 최신 날짜로 올릴 것.
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "devezcode-relay",
  "account_id": "e744ce0444a685558d261341b4bbd7e1",
  "main": "src/index.js",
  "compatibility_date": "2026-07-15",

  // 정적 자산(포털/대시보드/xterm/폰트/아이콘) 서빙. Worker 코드에서 env.ASSETS.fetch(request)로 사용.
  "assets": {
    "directory": "./public",
    "binding": "ASSETS"
  },

  // device 별 DeviceHub 인스턴스 바인딩.
  "durable_objects": {
    "bindings": [
      { "name": "DEVICE_HUB", "class_name": "DeviceHub" }
    ]
  },
  "migrations": [
    { "tag": "v1", "new_sqlite_classes": ["DeviceHub"] }
  ],

  // device/owner/pair/allowlist 저장소. id 는 `wrangler kv namespace create DEVICES` 로 생성 후 채울 것.
  "kv_namespaces": [
    { "binding": "DEVICES", "id": "6dbd462d739241bf92c6b18253db2050" }
  ],

  "vars": {
    // Google OAuth redirect_uri 구성에 쓰이는 경로(호스트는 요청 URL에서 자동 유도).
    "GOOGLE_REDIRECT_PATH": "/auth/callback"
  }

  // 아래 시크릿은 `wrangler secret put <이름>` 으로 등록(이 파일에는 값 절대 기록 금지):
  //   SESSION_SIGNING_KEY   - 세션 JWT HMAC 서명 키 (예: openssl rand -base64 32)
  //   GOOGLE_CLIENT_ID      - Google OAuth 클라이언트 ID
  //   GOOGLE_CLIENT_SECRET  - Google OAuth 클라이언트 시크릿
}
