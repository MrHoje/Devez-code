<UserControl x:Class="DevezCode.Views.AccountSettingsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <UserControl.Resources>
        <Style x:Key="AccountKeyboardFocus" TargetType="Control">
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Control">
                        <Border Margin="-2" CornerRadius="10" BorderThickness="1.5" BorderBrush="{DynamicResource PrimaryBrush}"/>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="AccountActionButton" TargetType="Button" BasedOn="{StaticResource SecondaryButton}">
            <Setter Property="IsTabStop" Value="True"/>
            <Setter Property="FocusVisualStyle" Value="{StaticResource AccountKeyboardFocus}"/>
        </Style>
    </UserControl.Resources>
    <StackPanel>
        <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
            <Path Style="{StaticResource LucideIcon}" Data="{StaticResource IconUserRound}"
                  Width="16" Height="16" Margin="0,0,9,0" Stroke="{DynamicResource TextBrush}"/>
            <TextBlock Text="계정" FontSize="{DynamicResource Fs14}" FontWeight="SemiBold"
                       Foreground="{DynamicResource TextBrush}"/>
        </StackPanel>
        <TextBlock Text="설정·스킬·대화 기록은 함께 사용하고, Claude와 Codex의 로그인 계정만 변경합니다."
                   FontSize="{DynamicResource Fs12}" Foreground="{DynamicResource TextMutedBrush}" TextWrapping="Wrap"/>
        <Border Background="{DynamicResource PanelSoftBrush}" CornerRadius="8" Padding="14" Margin="0,16,0,20">
            <TextBlock Text="계정을 변경하면 앱 안에서 실행 중인 세션을 모두 다시 엽니다. 작성 중인 입력과 진행 중인 응답은 중단될 수 있습니다. 외부 터미널 세션은 먼저 닫아 주세요."
                       TextWrapping="Wrap" FontSize="{DynamicResource Fs12}" Foreground="{DynamicResource TextMutedBrush}"/>
        </Border>
        <TextBlock x:Name="StatusText" TextWrapping="Wrap" Margin="0,0,0,12"
                   AutomationProperties.LiveSetting="Polite" Foreground="{DynamicResource TextMutedBrush}">
            <TextBlock.Style>
                <Style TargetType="TextBlock" BasedOn="{StaticResource {x:Type TextBlock}}">
                    <Style.Triggers>
                        <Trigger Property="Text" Value=""><Setter Property="Visibility" Value="Collapsed"/></Trigger>
                    </Style.Triggers>
                </Style>
            </TextBlock.Style>
        </TextBlock>
        <ItemsControl x:Name="Providers">
            <ItemsControl.ItemTemplate>
                <DataTemplate>
                    <Border Background="{DynamicResource PanelBrush}" BorderBrush="{DynamicResource LineBrush}"
                            BorderThickness="1" CornerRadius="10" Padding="20" Margin="0,0,0,16">
                        <StackPanel>
                            <TextBlock Text="{Binding Name}" FontSize="{DynamicResource Fs14}" FontWeight="SemiBold"
                                       Foreground="{DynamicResource TextBrush}" Margin="0,0,0,12"/>
                            <TextBlock Text="사용할 계정" FontSize="{DynamicResource Fs12}" Foreground="{DynamicResource TextMutedBrush}" Margin="0,0,0,6"/>
                            <ComboBox ItemsSource="{Binding Options}" SelectedValuePath="Id"
                                      IsEnabled="{Binding CanSwitch}"
                                      SelectedValue="{Binding ActiveId, Mode=OneWay}"
                                      SelectionChanged="Account_SelectionChanged" Style="{StaticResource ThemedCombo}"
                                      Height="40" HorizontalAlignment="Stretch" Cursor="Arrow"
                                      AutomationProperties.Name="{Binding SelectionLabel}">
                                <ComboBox.ItemTemplate>
                                    <DataTemplate>
                                        <TextBlock Text="{Binding Name}" TextTrimming="CharacterEllipsis" ToolTip="{Binding Name}"/>
                                    </DataTemplate>
                                </ComboBox.ItemTemplate>
                            </ComboBox>
                            <WrapPanel Margin="0,12,0,16">
                                <Button Content="계정 추가" Click="AddAccount_Click" Style="{StaticResource AccountActionButton}"
                                        Height="38" MinWidth="80" Cursor="Arrow" Margin="0,0,8,4"
                                        AutomationProperties.Name="{Binding AddLabel}"/>
                                <Button Content="현재 CLI 계정 가져오기" Click="ImportAccount_Click" Style="{StaticResource AccountActionButton}"
                                        Height="38" MinWidth="80" Cursor="Arrow" Margin="0,0,0,4"/>
                            </WrapPanel>
                            <ItemsControl ItemsSource="{Binding Accounts}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Border BorderBrush="{DynamicResource LineBrush}" BorderThickness="0,1,0,0" Padding="0,10">
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="Auto"/>
                                                </Grid.ColumnDefinitions>
                                                <StackPanel VerticalAlignment="Center" Margin="0,0,12,0">
                                                    <TextBlock Text="{Binding Name}" TextTrimming="CharacterEllipsis" ToolTip="{Binding Name}"
                                                               Foreground="{DynamicResource TextBrush}" FontSize="{DynamicResource Fs13}"/>
                                                    <TextBlock Text="{Binding StateLabel}" Foreground="{DynamicResource TextMutedBrush}" FontSize="{DynamicResource Fs11}" Margin="0,3,0,0"/>
                                                </StackPanel>
                                                <Button Grid.Column="1" Content="삭제" Click="DeleteAccount_Click" IsEnabled="{Binding CanDelete}"
                                                        Style="{StaticResource AccountActionButton}"
                                                        Cursor="Arrow" Height="32" MinWidth="60" VerticalAlignment="Center"
                                                        ToolTip="{Binding DeleteHint}" ToolTipService.ShowOnDisabled="True"
                                                        AutomationProperties.Name="{Binding DeleteLabel}"/>
                                            </Grid>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>
                    </Border>
                </DataTemplate>
            </ItemsControl.ItemTemplate>
        </ItemsControl>
    </StackPanel>
</UserControl>
