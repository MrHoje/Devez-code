<Window x:Class="DevezCode.Views.FileEditorWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="편집" Height="640" Width="880"
        WindowStartupLocation="CenterOwner" ResizeMode="NoResize"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        ShowInTaskbar="False"
        PreviewKeyDown="Window_KeyDown"
        UseLayoutRounding="True"
        SnapsToDevicePixels="True"
        TextOptions.TextFormattingMode="Display"
        TextOptions.TextRenderingMode="ClearType"
        FontFamily="{StaticResource PretendardFont}">

    <Grid Margin="20">
        <!-- Shadow layer -->
        <Border Background="{DynamicResource BgBrush}" CornerRadius="14">
            <Border.Effect>
                <DropShadowEffect ShadowDepth="0" BlurRadius="40" Color="{DynamicResource ShadowColor}" Opacity="{DynamicResource ShadowOpacity}"/>
            </Border.Effect>
        </Border>
        <!-- Content layer -->
        <Border x:Name="ContentRoot" CornerRadius="14"
                Background="{DynamicResource BgBrush}"
                BorderBrush="{DynamicResource LineBrush}" BorderThickness="1"
                ClipToBounds="True">
            <Grid x:Name="ContentClip">
                <Grid.RowDefinitions>
                    <RowDefinition Height="48"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <!-- Header -->
                <Border Grid.Row="0"
                        Background="{DynamicResource PanelBrush}"
                        BorderBrush="{DynamicResource LineBrush}"
                        BorderThickness="0,0,0,1"
                        MouseLeftButtonDown="Header_DragMove">
                    <Grid>
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="16,0,0,0">
                            <Path x:Name="HeaderIcon" Style="{StaticResource LucideIcon}"
                                  Data="{StaticResource IconPencil}"
                                  Width="15" Height="15" VerticalAlignment="Center"
                                  Stroke="{DynamicResource TextBrush}" Margin="0,-1,10,0"/>
                            <TextBlock x:Name="TitleText" Text="편집" VerticalAlignment="Center"
                                       FontSize="{DynamicResource Fs14}" FontWeight="SemiBold"
                                       Foreground="{DynamicResource TextBrush}"/>
                            <TextBlock x:Name="PathText" VerticalAlignment="Center" Margin="12,1,0,0"
                                       FontSize="{DynamicResource Fs11}"
                                       Foreground="{DynamicResource TextMutedBrush}"
                                       TextTrimming="CharacterEllipsis" MaxWidth="480"/>
                        </StackPanel>
                        <Button Click="CloseBtn_Click"
                                HorizontalAlignment="Right" VerticalAlignment="Center"
                                Width="40" Height="32" Margin="0,0,8,0"
                                Style="{StaticResource WinCloseBtn}">
                            <TextBlock Text="&#x2715;" FontSize="{DynamicResource Fs11}"/>
                        </Button>
                    </Grid>
                </Border>

                <!-- 편집 영역 -->
                <Border Grid.Row="1" Margin="20,18,20,0" CornerRadius="10"
                        Background="{DynamicResource PanelSoftBrush}"
                        BorderBrush="{DynamicResource LineBrush}" BorderThickness="1">
                    <TextBox x:Name="EditorBox"
                             AcceptsReturn="True" AcceptsTab="True"
                             TextWrapping="NoWrap"
                             BorderThickness="0" Background="Transparent"
                             Padding="14,12,14,12"
                             VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto"
                             VerticalContentAlignment="Top"
                             FocusVisualStyle="{x:Null}"
                             FontFamily="Consolas, Cascadia Code, PretendardFont"
                             FontSize="{DynamicResource Fs13}"
                             Foreground="{DynamicResource TextBrush}"
                             CaretBrush="{DynamicResource TextBrush}">
                        <TextBox.Resources>
                            <Style TargetType="Border"><Setter Property="CornerRadius" Value="0"/></Style>
                        </TextBox.Resources>
                    </TextBox>
                </Border>

                <!-- Footer -->
                <Grid Grid.Row="2" Margin="20,14,20,18">
                    <TextBlock x:Name="StatusText" VerticalAlignment="Center" HorizontalAlignment="Left"
                               FontSize="{DynamicResource Fs11}" Foreground="{DynamicResource TextMutedBrush}"/>
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                        <Button Click="CancelBtn_Click" Height="36" MinWidth="88"
                                Style="{StaticResource SecondaryButton}">
                            <TextBlock Text="취소" FontSize="{DynamicResource Fs13}"/>
                        </Button>
                        <Button x:Name="SaveBtn" Click="SaveBtn_Click" Height="36" MinWidth="104" Margin="10,0,0,0"
                                Style="{StaticResource PrimaryButton}">
                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                                <Path Style="{StaticResource LucideButtonIcon}" Data="{StaticResource IconSave}"
                                      Width="14" Height="14" Margin="0,0,8,0" Stroke="White"/>
                                <TextBlock Text="저장" Foreground="White" FontWeight="SemiBold"
                                           FontSize="{DynamicResource Fs13}"/>
                            </StackPanel>
                        </Button>
                    </StackPanel>
                </Grid>
            </Grid>
        </Border>
    </Grid>
</Window>
