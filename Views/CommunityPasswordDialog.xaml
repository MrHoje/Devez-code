<Window x:Class="DevezCode.Views.CommunityPasswordDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="비밀번호 입력" Width="420" Height="292"
        WindowStartupLocation="CenterOwner" WindowStyle="None" ResizeMode="NoResize"
        AllowsTransparency="True" Background="Transparent" ShowInTaskbar="False"
        FontFamily="{StaticResource PretendardFont}"
        UseLayoutRounding="True" SnapsToDevicePixels="True"
        TextOptions.TextFormattingMode="Display" TextOptions.TextRenderingMode="ClearType"
        PreviewKeyDown="Window_PreviewKeyDown">
    <Grid Margin="{DynamicResource WindowShadowOuterMargin}">
        <Border Background="{DynamicResource BgBrush}"
                CornerRadius="{DynamicResource WindowShadowCornerRadius}"
                Margin="{DynamicResource WindowShadowInnerMargin}"
                SnapsToDevicePixels="True">
            <Border.Effect>
                <DropShadowEffect ShadowDepth="0" BlurRadius="{DynamicResource WindowShadowBlurRadius}"
                                  Direction="270"
                                  Color="{DynamicResource ShadowColor}"
                                  Opacity="{DynamicResource ShadowOpacity}"/>
            </Border.Effect>
        </Border>
        <Border Background="{DynamicResource BgBrush}"
                BorderBrush="{DynamicResource LineBrush}" BorderThickness="1"
                CornerRadius="14" ClipToBounds="True">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="48"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="66"/>
                </Grid.RowDefinitions>
                <Border Grid.Row="0" BorderBrush="{DynamicResource LineBrush}"
                        BorderThickness="0,0,0,1" Background="{DynamicResource PanelBrush}"
                        MouseLeftButtonDown="Header_DragMove">
                    <Grid Margin="16,0,8,0">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <Path Style="{StaticResource LucideIcon}"
                                  Data="{StaticResource IconLock}" Width="14" Height="14"
                                  Stroke="{DynamicResource TextBrush}" Margin="0,0,9,0"/>
                            <TextBlock x:Name="HeaderTitleText" FontSize="{DynamicResource Fs14}"
                                       FontWeight="SemiBold" Foreground="{DynamicResource TextBrush}"/>
                        </StackPanel>
                        <Button Click="CancelBtn_Click" HorizontalAlignment="Right"
                                Width="40" Height="32" Style="{StaticResource WinCloseBtn}">
                            <TextBlock Text="&#x2715;" FontSize="{DynamicResource Fs11}"/>
                        </Button>
                    </Grid>
                </Border>

                <StackPanel Grid.Row="1" Margin="20,17,20,10">
                    <TextBlock x:Name="MessageText" FontSize="{DynamicResource Fs12}"
                               Foreground="{DynamicResource TextMutedBrush}"
                               TextWrapping="Wrap" Margin="2,0,0,10"/>
                    <Border x:Name="PasswordFrame" Style="{StaticResource AuthInputBorder}"
                            Padding="12,0">
                        <PasswordBox x:Name="PasswordInput" Style="{StaticResource PasswordStyle}"
                                     MaxLength="72" FontSize="{DynamicResource Fs13}"
                                     VerticalContentAlignment="Center"/>
                    </Border>
                    <TextBlock x:Name="HintText" Text="비밀번호는 4자 이상 입력하세요."
                               FontSize="{DynamicResource Fs11}"
                               Foreground="{DynamicResource DangerBrush}"
                               Margin="2,7,0,0" Visibility="Collapsed"/>
                </StackPanel>

                <Border Grid.Row="2" Background="{DynamicResource PanelSoftBrush}"
                        BorderBrush="{DynamicResource LineBrush}" BorderThickness="0,1,0,0">
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right"
                                VerticalAlignment="Center" Margin="20,0">
                        <Button Click="CancelBtn_Click" Height="38" MinWidth="80"
                                Padding="16,0" Margin="0,0,8,0"
                                Style="{StaticResource SecondaryButton}" FontSize="{DynamicResource Fs12}">
                            <TextBlock Text="취소"/>
                        </Button>
                        <Button Click="OkBtn_Click" Height="38" MinWidth="80"
                                Padding="16,0" Style="{StaticResource PrimaryButton}"
                                FontSize="{DynamicResource Fs12}">
                            <TextBlock x:Name="OkText" Text="확인" Foreground="White"/>
                        </Button>
                    </StackPanel>
                </Border>
            </Grid>
        </Border>
    </Grid>
</Window>
