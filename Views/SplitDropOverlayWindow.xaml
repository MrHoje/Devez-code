<Window x:Class="DevezCode.Views.SplitDropOverlayWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        ResizeMode="NoResize" ShowInTaskbar="False" Topmost="True"
        WindowStartupLocation="Manual"
        FontFamily="{StaticResource PretendardFont}">
    <!-- 탭 드래그로 분할 위치를 미리 보여주는 반투명 하이라이트. 별도 최상위 창이라
         터미널(WebView2 HWND) 위에 합성된다(정적일 때만 — airspace 참고). -->
    <Border Background="{DynamicResource PrimaryBrush}" Opacity="0.22"
            BorderBrush="{DynamicResource PrimaryBrush}" BorderThickness="2"/>
</Window>
