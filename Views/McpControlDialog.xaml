<UserControl x:Class="DevezCode.Views.McpControlDialog"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:models="clr-namespace:DevezCode.Models"
             UseLayoutRounding="True"
             SnapsToDevicePixels="True"
             TextOptions.TextFormattingMode="Display"
             TextOptions.TextRenderingMode="ClearType"
             FontFamily="{StaticResource PretendardFont}">

    <UserControl.Resources>
        <!-- 카드 안 액션 아이콘 버튼 -->
        <Style x:Key="RowIconBtn" TargetType="Button" BasedOn="{StaticResource TitleBarChipButton}">
            <Setter Property="Width" Value="32"/>
            <Setter Property="Height" Value="32"/>
            <Setter Property="Margin" Value="4,0,0,0"/>
        </Style>
    </UserControl.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="48"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- 헤더 -->
        <Border Grid.Row="0"
                Background="{DynamicResource PanelBrush}"
                BorderBrush="{DynamicResource LineBrush}"
                BorderThickness="0,0,0,1"
                MouseLeftButtonDown="Header_DragMove">
            <Grid>
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="16,0,0,0">
                    <Path Style="{StaticResource LucideIcon}"
                          Data="{StaticResource IconZap}"
                          Width="16" Height="16" VerticalAlignment="Center"
                          Stroke="{DynamicResource TextBrush}"
                          Margin="0,-1,11,0"/>
                    <TextBlock Text="MCP 컨트롤러" VerticalAlignment="Center"
                               FontSize="{DynamicResource Fs14}" FontWeight="SemiBold"
                               Foreground="{DynamicResource TextBrush}"/>
                    <Border Margin="10,0,0,0" Padding="6,1" CornerRadius="4"
                            Background="{DynamicResource PanelSoftBrush}">
                        <TextBlock Text="Claude Code" VerticalAlignment="Center"
                                   FontSize="{DynamicResource Fs10}" Foreground="{DynamicResource TextMutedBrush}"/>
                    </Border>
                </StackPanel>
                <Button Click="CloseBtn_Click"
                        HorizontalAlignment="Right" VerticalAlignment="Center"
                        Width="40" Height="32" Margin="0,0,8,0"
                        Style="{StaticResource WinCloseBtn}">
                    <TextBlock Text="&#x2715;" FontSize="{DynamicResource Fs11}"/>
                </Button>
            </Grid>
        </Border>

        <!-- 본문 -->
        <Grid Grid.Row="1" Margin="24,20,24,4">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <!-- 컨트롤 카드: 자동 재조회 + 간격 + 마지막 갱신 + 새로고침 -->
            <Border Grid.Row="0" Padding="16,12" CornerRadius="12" Margin="0,0,0,16"
                    Background="{DynamicResource PanelSoftBrush}"
                    BorderBrush="{DynamicResource LineBrush}" BorderThickness="1">
                <Grid>
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <Path Style="{StaticResource LucideIcon}" Data="{StaticResource IconServer}"
                              Width="14" Height="14" VerticalAlignment="Center" Margin="0,0,8,0"
                              Stroke="{DynamicResource TextMutedBrush}"/>
                        <TextBlock Text="MCP 서버 상태" VerticalAlignment="Center"
                                   FontSize="{DynamicResource Fs12}" FontWeight="SemiBold"
                                   Foreground="{DynamicResource TextBrush}"/>
                    </StackPanel>
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                        <Ellipse x:Name="RefreshSpinner" Width="18" Height="18" Margin="0,0,10,0"
                                 Visibility="Collapsed" VerticalAlignment="Center"
                                 models:SpinnerActivator.Track="True"
                                 Stroke="{DynamicResource PrimaryBrush}" StrokeThickness="2.2"
                                 StrokeDashArray="15 100" StrokeDashCap="Round"
                                 RenderTransformOrigin="0.5,0.5">
                            <Ellipse.RenderTransform>
                                <RotateTransform Angle="{Binding Angle, Source={x:Static models:SpinnerSync.Instance}}"/>
                            </Ellipse.RenderTransform>
                        </Ellipse>
                        <TextBlock x:Name="LastRefreshedText" VerticalAlignment="Center" Margin="0,0,12,0"
                                   FontSize="{DynamicResource Fs11}" Foreground="{DynamicResource TextMutedBrush}"/>
                        <Button x:Name="RefreshBtn" Click="RefreshBtn_Click"
                                Style="{StaticResource SecondaryButton}" Height="34" Padding="14,0">
                            <StackPanel Orientation="Horizontal">
                                <Path Style="{StaticResource LucideButtonIcon}" Data="{StaticResource IconRefresh}"
                                      Width="13" Height="13" Margin="0,0,7,0"/>
                                <TextBlock Text="새로고침" FontSize="{DynamicResource Fs12}" FontWeight="SemiBold"/>
                            </StackPanel>
                        </Button>
                    </StackPanel>
                </Grid>
            </Border>

            <!-- 서버 목록 -->
            <Grid Grid.Row="1">
                <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                    <ItemsControl x:Name="ServerList">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate DataType="{x:Type models:McpServer}">
                                <Border Margin="0,0,0,10" Padding="16,13" CornerRadius="12"
                                        Background="{DynamicResource PanelSoftBrush}"
                                        BorderBrush="{DynamicResource LineBrush}" BorderThickness="1">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>

                                        <!-- 상태 점 -->
                                        <Ellipse Grid.Column="0" Width="10" Height="10" VerticalAlignment="Center"
                                                 Margin="2,0,14,0"
                                                 Fill="{Binding Status, Converter={x:Static models:McpStatusToBrushConverter.Instance}}"/>

                                        <!-- 이름 + 메타 -->
                                        <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                            <StackPanel Orientation="Horizontal">
                                                <TextBlock Text="{Binding Name}" FontSize="{DynamicResource Fs13}"
                                                           FontWeight="SemiBold" Foreground="{DynamicResource TextBrush}"
                                                           TextTrimming="CharacterEllipsis" VerticalAlignment="Center"/>
                                                <Border Margin="8,0,0,0" Padding="6,1" CornerRadius="4"
                                                        VerticalAlignment="Center"
                                                        Background="{DynamicResource PanelBrush}">
                                                    <TextBlock Text="{Binding Type, Converter={x:Static models:McpTypeToLabelConverter.Instance}}"
                                                               FontSize="{DynamicResource Fs10}"
                                                               Foreground="{DynamicResource TextMutedBrush}"/>
                                                </Border>
                                                <Border Margin="6,0,0,0" Padding="6,1" CornerRadius="4"
                                                        VerticalAlignment="Center"
                                                        Background="{DynamicResource PanelBrush}"
                                                        ToolTip="{Binding ReadOnlyReason}"
                                                        Visibility="{Binding IsReadOnly, Converter={x:Static models:BoolToVisibilityConverter.Instance}}">
                                                    <TextBlock Text="읽기 전용" FontSize="{DynamicResource Fs10}"
                                                               Foreground="{DynamicResource TextMutedBrush}"/>
                                                </Border>
                                            </StackPanel>
                                            <StackPanel Orientation="Horizontal" Margin="0,4,0,0">
                                                <TextBlock Text="{Binding Status, Converter={x:Static models:McpStatusToLabelConverter.Instance}}"
                                                           FontSize="{DynamicResource Fs11}"
                                                           Foreground="{DynamicResource TextMutedBrush}"/>
                                                <TextBlock Text=" · " FontSize="{DynamicResource Fs11}"
                                                           Foreground="{DynamicResource TextMutedBrush}"
                                                           Visibility="{Binding Type, Converter={x:Static models:McpRemoteToVisibilityConverter.Instance}}"/>
                                                <TextBlock Text="{Binding Url}"
                                                           FontSize="{DynamicResource Fs11}"
                                                           Foreground="{DynamicResource TextMutedBrush}"
                                                           TextTrimming="CharacterEllipsis" MaxWidth="380"
                                                           Visibility="{Binding Type, Converter={x:Static models:McpRemoteToVisibilityConverter.Instance}}"/>
                                            </StackPanel>
                                        </StackPanel>

                                        <!-- 액션 -->
                                        <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                                            <CheckBox IsChecked="{Binding Enabled, Mode=OneWay}"
                                                      Click="EnableToggle_Click"
                                                      Style="{StaticResource ToggleSwitch}"
                                                      VerticalAlignment="Center" Margin="0,0,8,0"
                                                      ToolTip="활성/비활성 (모든 프로젝트)"/>
                                            <Button Style="{StaticResource RowIconBtn}" Click="Login_Click"
                                                    ToolTip="OAuth 인증 (login)"
                                                    Visibility="{Binding Type, Converter={x:Static models:McpRemoteToVisibilityConverter.Instance}}">
                                                <Path Style="{StaticResource LucideButtonIcon}" Data="{StaticResource IconKey}"
                                                      Width="14" Height="14" Stroke="{DynamicResource TextMutedBrush}"/>
                                            </Button>
                                            <Button Style="{StaticResource RowIconBtn}" Click="Logout_Click"
                                                    ToolTip="OAuth 로그아웃 (logout)"
                                                    Visibility="{Binding Type, Converter={x:Static models:McpRemoteToVisibilityConverter.Instance}}">
                                                <Path Style="{StaticResource LucideButtonIcon}" Data="{StaticResource IconLogOut}"
                                                      Width="14" Height="14" Stroke="{DynamicResource TextMutedBrush}"/>
                                            </Button>
                                            <Button Style="{StaticResource RowIconBtn}" Click="Detail_Click"
                                                    ToolTip="상세 (get)">
                                                <Path Style="{StaticResource LucideButtonIcon}" Data="{StaticResource IconEye}"
                                                      Width="14" Height="14" Stroke="{DynamicResource TextMutedBrush}"/>
                                            </Button>
                                        </StackPanel>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>

                <!-- 빈 상태 -->
                <StackPanel x:Name="EmptyState" VerticalAlignment="Center" HorizontalAlignment="Center"
                            Visibility="Collapsed">
                    <Path Style="{StaticResource LucideIcon}" Data="{StaticResource IconServer}"
                          Width="40" Height="40" Stroke="{DynamicResource LineBrush}"
                          HorizontalAlignment="Center"/>
                    <TextBlock Text="등록된 MCP 서버가 없습니다"
                               FontSize="{DynamicResource Fs14}" FontWeight="SemiBold"
                               Foreground="{DynamicResource TextBrush}"
                               Margin="0,14,0,0" HorizontalAlignment="Center"/>
                    <TextBlock Text="MCP 서버 관리에서 서버를 추가하면 여기에 표시됩니다."
                               FontSize="{DynamicResource Fs12}" Foreground="{DynamicResource TextMutedBrush}"
                               Margin="0,6,0,0" HorizontalAlignment="Center"/>
                </StackPanel>
            </Grid>
        </Grid>

        <!-- 상세 출력 패널 (get / logout 결과) -->
        <Border x:Name="DetailPanel" Grid.Row="2" Visibility="Collapsed"
                Background="{DynamicResource PanelBrush}"
                BorderBrush="{DynamicResource LineBrush}" BorderThickness="0,1,0,0"
                MaxHeight="220">
            <Grid Margin="24,12,24,14">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>
                <Grid Grid.Row="0" Margin="0,0,0,8">
                    <TextBlock x:Name="DetailTitle" Text="상세" FontSize="{DynamicResource Fs11}"
                               FontWeight="SemiBold" Foreground="{DynamicResource TextMutedBrush}"
                               VerticalAlignment="Center"/>
                    <Button Click="DetailClose_Click" HorizontalAlignment="Right" VerticalAlignment="Center"
                            Style="{StaticResource TitleBarChipButton}" Width="26" Height="26"
                            ToolTip="닫기">
                        <Path Style="{StaticResource LucideButtonIcon}" Data="{StaticResource IconX}"
                              Width="12" Height="12" Stroke="{DynamicResource TextMutedBrush}"/>
                    </Button>
                </Grid>
                <Border Grid.Row="1" CornerRadius="10" Padding="12,10"
                        Background="{DynamicResource PanelSoftBrush}"
                        BorderBrush="{DynamicResource LineBrush}" BorderThickness="1">
                    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto">
                        <TextBox x:Name="DetailText" IsReadOnly="True" BorderThickness="0"
                                 Background="Transparent" TextWrapping="NoWrap"
                                 FontFamily="Consolas, Cascadia Code, PretendardFont"
                                 FontSize="{DynamicResource Fs11}"
                                 Foreground="{DynamicResource TextBrush}"/>
                    </ScrollViewer>
                </Border>
            </Grid>
        </Border>
    </Grid>
</UserControl>
