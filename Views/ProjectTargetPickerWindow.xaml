<Window x:Class="DevezCode.Views.ProjectTargetPickerWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        ResizeMode="NoResize" ShowInTaskbar="False"
        WindowStartupLocation="Manual"
        PreviewKeyDown="Window_PreviewKeyDown"
        FontFamily="{StaticResource PretendardFont}">
    <Grid Background="#33000000">
        <Grid x:Name="Card" Width="560" Height="220"
              HorizontalAlignment="Center" VerticalAlignment="Center"
              Opacity="0" RenderTransformOrigin="0.5,0.5">
            <Grid.RenderTransform>
                <ScaleTransform ScaleX="0.96" ScaleY="0.96"/>
            </Grid.RenderTransform>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="4"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <Border Grid.Column="0" BorderBrush="{DynamicResource LineBrush}" BorderThickness="1"
                    CornerRadius="14,0,0,14" Cursor="Hand"
                    MouseLeftButtonDown="PaneA_MouseLeftButtonDown">
                <Border.Style>
                    <Style TargetType="Border">
                        <Setter Property="Background" Value="{DynamicResource PanelBrush}"/>
                        <Style.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Background" Value="{DynamicResource PanelSoftBrush}"/>
                            </Trigger>
                        </Style.Triggers>
                    </Style>
                </Border.Style>
                <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                    <TextBlock Text="왼쪽 패널" FontSize="{DynamicResource Fs16}"
                               FontWeight="SemiBold" Foreground="{DynamicResource TextBrush}"
                               HorizontalAlignment="Center"/>
                    <TextBlock x:Name="PaneAText" Margin="0,8,0,0"
                               FontSize="{DynamicResource Fs12}" Foreground="{DynamicResource TextMutedBrush}"
                               HorizontalAlignment="Center" TextTrimming="CharacterEllipsis"/>
                </StackPanel>
            </Border>
            <Border Grid.Column="1" Background="{DynamicResource BgBrush}"/>
            <Border Grid.Column="2" BorderBrush="{DynamicResource LineBrush}" BorderThickness="1"
                    CornerRadius="0,14,14,0" Cursor="Hand"
                    MouseLeftButtonDown="PaneB_MouseLeftButtonDown">
                <Border.Style>
                    <Style TargetType="Border">
                        <Setter Property="Background" Value="{DynamicResource PanelBrush}"/>
                        <Style.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Background" Value="{DynamicResource PanelSoftBrush}"/>
                            </Trigger>
                        </Style.Triggers>
                    </Style>
                </Border.Style>
                <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                    <TextBlock Text="오른쪽 패널" FontSize="{DynamicResource Fs16}"
                               FontWeight="SemiBold" Foreground="{DynamicResource TextBrush}"
                               HorizontalAlignment="Center"/>
                    <TextBlock x:Name="PaneBText" Margin="0,8,0,0"
                               FontSize="{DynamicResource Fs12}" Foreground="{DynamicResource TextMutedBrush}"
                               HorizontalAlignment="Center" TextTrimming="CharacterEllipsis"/>
                </StackPanel>
            </Border>
        </Grid>
    </Grid>
</Window>