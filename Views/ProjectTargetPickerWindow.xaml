<Window x:Class="DevezCode.Views.ProjectTargetPickerWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        ResizeMode="NoResize" ShowInTaskbar="False"
        WindowStartupLocation="Manual"
        FontFamily="{StaticResource PretendardFont}">
    <!-- 좌/우 컬럼 폭은 MainWindow 가 실제 PaneA/PaneB 폭으로 채워 패널 영역에 정확히 맞춘다.
         현재 떠 있는 프로젝트 이름을 표시하고, 호버 시에만 살짝 밝아진다(흰색 저알파). -->
    <Grid x:Name="Root">
        <Grid.ColumnDefinitions>
            <ColumnDefinition x:Name="LeftCol" Width="*"/>
            <ColumnDefinition x:Name="GapCol" Width="0"/>
            <!-- 오른쪽은 남은 폭을 모두 채워 패널 B 영역에 확실히 맞춘다(반올림으로 비는 것 방지). -->
            <ColumnDefinition x:Name="RightCol" Width="*"/>
        </Grid.ColumnDefinitions>
        <Border Grid.Column="0" Cursor="Hand"
                MouseLeftButtonDown="PaneA_MouseLeftButtonDown">
            <Border.Style>
                <Style TargetType="Border">
                    <!-- 기본은 어둡게 깔고(딤), 호버 시 살짝 밝아진다. Setter 로 둬야 Trigger 가 덮어쓴다. -->
                    <Setter Property="Background" Value="#66000000"/>
                    <Style.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter Property="Background" Value="#40000000"/>
                        </Trigger>
                    </Style.Triggers>
                </Style>
            </Border.Style>
            <TextBlock x:Name="PaneAText" VerticalAlignment="Center" HorizontalAlignment="Center"
                       Margin="16,0" TextTrimming="CharacterEllipsis"
                       FontSize="{DynamicResource Fs14}" FontWeight="SemiBold"
                       Foreground="{DynamicResource PrimaryBrush}">
                <TextBlock.Effect>
                    <DropShadowEffect x:Name="ShadowA" BlurRadius="6" ShadowDepth="0" Opacity="0.6" Color="Black"/>
                </TextBlock.Effect>
            </TextBlock>
        </Border>
        <Border Grid.Column="2" Cursor="Hand"
                MouseLeftButtonDown="PaneB_MouseLeftButtonDown">
            <Border.Style>
                <Style TargetType="Border">
                    <!-- 기본은 어둡게 깔고(딤), 호버 시 살짝 밝아진다. Setter 로 둬야 Trigger 가 덮어쓴다. -->
                    <Setter Property="Background" Value="#66000000"/>
                    <Style.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter Property="Background" Value="#40000000"/>
                        </Trigger>
                    </Style.Triggers>
                </Style>
            </Border.Style>
            <TextBlock x:Name="PaneBText" VerticalAlignment="Center" HorizontalAlignment="Center"
                       Margin="16,0" TextTrimming="CharacterEllipsis"
                       FontSize="{DynamicResource Fs14}" FontWeight="SemiBold"
                       Foreground="{DynamicResource PrimaryBrush}">
                <TextBlock.Effect>
                    <DropShadowEffect x:Name="ShadowB" BlurRadius="6" ShadowDepth="0" Opacity="0.6" Color="Black"/>
                </TextBlock.Effect>
            </TextBlock>
        </Border>
    </Grid>
</Window>
