<Window x:Class="DevezCode.Views.ProjectTargetPickerWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        ResizeMode="NoResize" ShowInTaskbar="False"
        WindowStartupLocation="Manual"
        Deactivated="Window_Deactivated"
        PreviewKeyDown="Window_PreviewKeyDown"
        FontFamily="{StaticResource PretendardFont}">
    <!-- 좌/우 컬럼 폭은 MainWindow 가 실제 PaneA/PaneB 폭으로 채워 패널 영역에 정확히 맞춘다.
         평소엔 투명, 호버 시에만 살짝 밝아진다(흰색 저알파). -->
    <Grid x:Name="Root">
        <Grid.ColumnDefinitions>
            <ColumnDefinition x:Name="LeftCol" Width="*"/>
            <ColumnDefinition x:Name="GapCol" Width="0"/>
            <ColumnDefinition x:Name="RightCol" Width="*"/>
        </Grid.ColumnDefinitions>
        <Border Grid.Column="0" Cursor="Hand" Background="Transparent"
                MouseLeftButtonDown="PaneA_MouseLeftButtonDown">
            <Border.Style>
                <Style TargetType="Border">
                    <Style.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter Property="Background" Value="#1AFFFFFF"/>
                        </Trigger>
                    </Style.Triggers>
                </Style>
            </Border.Style>
        </Border>
        <Border Grid.Column="2" Cursor="Hand" Background="Transparent"
                MouseLeftButtonDown="PaneB_MouseLeftButtonDown">
            <Border.Style>
                <Style TargetType="Border">
                    <Style.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter Property="Background" Value="#1AFFFFFF"/>
                        </Trigger>
                    </Style.Triggers>
                </Style>
            </Border.Style>
        </Border>
    </Grid>
</Window>
