<Window x:Class="DevezCode.Views.ProjectAddDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="프로젝트 영역에 추가"
        Width="370" SizeToContent="Height"
        WindowStartupLocation="CenterOwner"
        WindowStyle="None"
        ResizeMode="NoResize"
        AllowsTransparency="True"
        Background="Transparent"
        ShowInTaskbar="False"
        UseLayoutRounding="True"
        SnapsToDevicePixels="True"
        TextOptions.TextFormattingMode="Display"
        FontFamily="{StaticResource PretendardFont}">
    <Window.Resources>
        <Style x:Key="AddKindCard" TargetType="Button">
            <Setter Property="Cursor" Value="Arrow"/>
            <Setter Property="Focusable" Value="False"/>
            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
            <Setter Property="VerticalContentAlignment" Value="Stretch"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="0"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Card"
                                CornerRadius="8" BorderThickness="1"
                                BorderBrush="{DynamicResource LineBrush}"
                                Background="{DynamicResource PanelBrush}"
                                Padding="10,7" Margin="0,0,0,6"
                                SnapsToDevicePixels="True">
                            <ContentPresenter/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Card" Property="Background" Value="{DynamicResource PanelSoftBrush}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid Margin="{DynamicResource WindowShadowOuterMargin}">
        <Border Background="{DynamicResource BgBrush}"
                CornerRadius="{DynamicResource WindowShadowCornerRadius}"
                Margin="{DynamicResource WindowShadowInnerMargin}"
                SnapsToDevicePixels="True">
            <Border.Effect>
                <DropShadowEffect ShadowDepth="0" BlurRadius="{DynamicResource WindowShadowBlurRadius}"
                                  Direction="270" Color="{DynamicResource ShadowColor}"
                                  Opacity="{DynamicResource ShadowOpacity}"/>
            </Border.Effect>
        </Border>

        <Border CornerRadius="14"
                Background="{DynamicResource BgBrush}"
                BorderBrush="{DynamicResource LineBrush}" BorderThickness="1"
                ClipToBounds="True" SnapsToDevicePixels="True">
            <Grid x:Name="ContentRoot">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <StackPanel Grid.Row="0" Margin="16,12,16,9">
                    <Grid Margin="0,0,0,8">
                        <TextBlock Text="프로젝트 영역에 추가"
                                   FontSize="{DynamicResource Fs14}" FontWeight="SemiBold"
                                   Foreground="{DynamicResource TextBrush}"
                                   VerticalAlignment="Center"/>
                        <Button Click="CancelBtn_Click"
                                HorizontalAlignment="Right" VerticalAlignment="Top"
                                Width="28" Height="28" Margin="0,-4,-6,0"
                                Style="{StaticResource WinCloseBtn}">
                            <TextBlock Text="&#x2715;" FontSize="{DynamicResource Fs11}"/>
                        </Button>
                    </Grid>

                    <TextBlock Text="추가할 항목을 선택하세요"
                               FontSize="{DynamicResource Fs11}"
                               Foreground="{DynamicResource TextMutedBrush}"
                               Margin="0,0,0,13"/>

                    <Button Style="{StaticResource AddKindCard}" Click="FolderCard_Click">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="38"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <Border Grid.Column="0" Width="32" Height="32" CornerRadius="8"
                                    Background="{DynamicResource PanelSoftBrush}"
                                    VerticalAlignment="Center" HorizontalAlignment="Left">
                                <Path Style="{StaticResource LucideIcon}"
                                      Data="{StaticResource IconFolderPlus}"
                                      Width="17" Height="17"
                                      Stroke="{DynamicResource TextMutedBrush}"
                                      HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                            <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="3,0,8,0">
                                <TextBlock Text="폴더" FontSize="{DynamicResource Fs13}"
                                           FontWeight="SemiBold" Foreground="{DynamicResource TextBrush}"/>
                                <TextBlock Text="프로젝트를 묶어 정리합니다"
                                           FontSize="{DynamicResource Fs11}"
                                           Foreground="{DynamicResource TextMutedBrush}" Margin="0,1,0,0"/>
                            </StackPanel>
                            <Path Grid.Column="2" Style="{StaticResource LucideButtonIcon}"
                                  Data="{StaticResource IconChevronRight}" Width="12" Height="12"
                                  Stroke="{DynamicResource TextMutedBrush}"
                                  VerticalAlignment="Center"/>
                        </Grid>
                    </Button>

                    <Button Style="{StaticResource AddKindCard}" Click="ProjectCard_Click">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="38"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <Border Grid.Column="0" Width="32" Height="32" CornerRadius="8"
                                    Background="{DynamicResource PanelSoftBrush}"
                                    VerticalAlignment="Center" HorizontalAlignment="Left">
                                <Path Style="{StaticResource LucideIcon}"
                                      Data="{StaticResource IconCode2}"
                                      Width="17" Height="17"
                                      Stroke="{DynamicResource TextMutedBrush}"
                                      HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                            <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="3,0,8,0">
                                <TextBlock Text="프로젝트" FontSize="{DynamicResource Fs13}"
                                           FontWeight="SemiBold" Foreground="{DynamicResource TextBrush}"/>
                                <TextBlock Text="작업 디렉터리를 연결합니다"
                                           FontSize="{DynamicResource Fs11}"
                                           Foreground="{DynamicResource TextMutedBrush}" Margin="0,1,0,0"/>
                            </StackPanel>
                            <Path Grid.Column="2" Style="{StaticResource LucideButtonIcon}"
                                  Data="{StaticResource IconChevronRight}" Width="12" Height="12"
                                  Stroke="{DynamicResource TextMutedBrush}"
                                  VerticalAlignment="Center"/>
                        </Grid>
                    </Button>
                </StackPanel>

                <Border Grid.Row="1"
                        Background="{DynamicResource PanelSoftBrush}"
                        BorderBrush="{DynamicResource LineBrush}"
                        BorderThickness="0,1,0,0">
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right"
                                Margin="16,9,16,9">
                        <Button Click="CancelBtn_Click"
                                Width="92" Height="34"
                                Style="{StaticResource SecondaryButton}"
                                FontSize="{DynamicResource Fs12}">
                            <TextBlock Text="취소"/>
                        </Button>
                    </StackPanel>
                </Border>
            </Grid>
        </Border>
    </Grid>
</Window>
