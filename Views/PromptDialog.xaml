<Window x:Class="DevezCode.Views.PromptDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="입력" Height="276" Width="420"
        WindowStartupLocation="CenterOwner" ResizeMode="NoResize"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        ShowInTaskbar="False"
        UseLayoutRounding="True"
        SnapsToDevicePixels="True"
        TextOptions.TextFormattingMode="Display"
        TextOptions.TextRenderingMode="ClearType"
        TextOptions.TextHintingMode="Fixed"
        RenderOptions.ClearTypeHint="Enabled"
        FontFamily="{StaticResource PretendardFont}">

    <Grid Margin="20">
        <!-- Shadow layer -->
        <Border Background="{DynamicResource BgBrush}" CornerRadius="14">
            <Border.Effect>
                <DropShadowEffect ShadowDepth="0" BlurRadius="40" Color="{DynamicResource ShadowColor}" Opacity="{DynamicResource ShadowOpacity}"/>
            </Border.Effect>
        </Border>
        <!-- Content layer -->
        <Border CornerRadius="14"
                Background="{DynamicResource BgBrush}"
                BorderBrush="{DynamicResource LineBrush}" BorderThickness="1"
                ClipToBounds="True">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="48"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <!-- Header -->
                <Border Grid.Row="0"
                        BorderBrush="{DynamicResource LineBrush}"
                        BorderThickness="0,0,0,1"
                        Background="Transparent"
                        MouseLeftButtonDown="Header_DragMove">
                    <Grid>
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center"
                                    Margin="20,0,0,0">
                            <TextBlock x:Name="TitleText"
                                       VerticalAlignment="Center"
                                       FontSize="{DynamicResource Fs14}" FontWeight="SemiBold"
                                       Foreground="{DynamicResource TextBrush}"/>
                        </StackPanel>

                        <Button Click="CancelBtn_Click"
                                HorizontalAlignment="Right" VerticalAlignment="Center"
                                Width="40" Height="32" Margin="0,0,8,0"
                                Style="{StaticResource WinCloseBtn}">
                            <TextBlock Text="&#x2715;" FontSize="{DynamicResource Fs11}"/>
                        </Button>
                    </Grid>
                </Border>

                <!-- Body -->
                <StackPanel Grid.Row="1" Margin="20,18,20,8">
                    <TextBlock x:Name="MessageText"
                               FontSize="{DynamicResource Fs13}"
                               Foreground="{DynamicResource TextMutedBrush}"
                               Margin="2,0,0,8"
                               TextWrapping="Wrap"/>

                    <Border x:Name="InputFrame"
                            BorderBrush="{DynamicResource LineBrush}"
                            BorderThickness="1.5"
                            Background="{DynamicResource PanelBrush}"
                            CornerRadius="10"
                            Height="44"
                            Padding="14,0">
                        <TextBox x:Name="InputBox"
                                 BorderThickness="0"
                                 Background="Transparent"
                                 FocusVisualStyle="{x:Null}"
                                 Foreground="{DynamicResource TextBrush}"
                                 CaretBrush="{DynamicResource TextBrush}"
                                 FontSize="{DynamicResource Fs14}"
                                 FontFamily="{StaticResource PretendardFont}"
                                 VerticalContentAlignment="Center"
                                 Padding="0"
                                 GotFocus="InputBox_GotFocus"
                                 LostFocus="InputBox_LostFocus"
                                 KeyDown="InputBox_KeyDown">
                            <TextBox.Resources>
                                <Style TargetType="Border"><Setter Property="CornerRadius" Value="0"/></Style>
                            </TextBox.Resources>
                        </TextBox>
                    </Border>
                </StackPanel>

                <!-- Footer -->
                <Border Grid.Row="2"
                        Background="{DynamicResource PanelSoftBrush}"
                        BorderBrush="{DynamicResource LineBrush}"
                        BorderThickness="0,1,0,0"
                        CornerRadius="0,0,14,14">
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right"
                                Margin="20,14,20,14">
                        <Button x:Name="CancelBtn" Click="CancelBtn_Click"
                                MinWidth="80" Height="38" Padding="16,0"
                                Style="{StaticResource SecondaryButton}"
                                FontSize="{DynamicResource Fs13}" Margin="0,0,8,0">
                            <TextBlock Text="취소" TextTrimming="None"/>
                        </Button>

                        <Button x:Name="OkBtn" Click="OkBtn_Click"
                                MinWidth="80" Height="38" Padding="16,0"
                                Style="{StaticResource PrimaryButton}"
                                FontSize="{DynamicResource Fs13}">
                            <TextBlock x:Name="OkText" Text="확인" Foreground="White" TextTrimming="None"/>
                        </Button>
                    </StackPanel>
                </Border>
            </Grid>
        </Border>
    </Grid>
</Window>
