<Window x:Class="DevezCode.Views.ShortcutDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="바로가기"
        Width="560" SizeToContent="Height"
        WindowStartupLocation="CenterOwner"
        WindowStyle="None"
        ResizeMode="NoResize"
        AllowsTransparency="True"
        Background="Transparent"
        ShowInTaskbar="False"
        UseLayoutRounding="True"
        SnapsToDevicePixels="True"
        TextOptions.TextFormattingMode="Display"
        FontFamily="{StaticResource PretendardFont}">

    <Window.RenderTransform>
        <TranslateTransform/>
    </Window.RenderTransform>

    <Grid Margin="20">
        <!-- 그림자 -->
        <Border Background="{DynamicResource BgBrush}" CornerRadius="14">
            <Border.Effect>
                <DropShadowEffect ShadowDepth="0" BlurRadius="40" Direction="270"
                                  Color="{DynamicResource ShadowColor}" Opacity="{DynamicResource ShadowOpacity}"/>
            </Border.Effect>
        </Border>

        <Border CornerRadius="14" Background="{DynamicResource BgBrush}"
                BorderBrush="{DynamicResource LineBrush}" BorderThickness="1" ClipToBounds="True">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="48"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <!-- 헤더 -->
                <Border Grid.Row="0" BorderBrush="{DynamicResource LineBrush}" BorderThickness="0,0,0,1"
                        Background="Transparent" MouseLeftButtonDown="Header_DragMove">
                    <Grid>
                        <TextBlock x:Name="TitleText" Margin="20,0,0,0" VerticalAlignment="Center"
                                   FontSize="{DynamicResource Fs14}" FontWeight="SemiBold"
                                   Foreground="{DynamicResource TextBrush}"/>
                        <Button Click="CancelBtn_Click" HorizontalAlignment="Right" VerticalAlignment="Center"
                                Width="40" Height="32" Margin="0,0,8,0" Style="{StaticResource WinCloseBtn}">
                            <TextBlock Text="&#x2715;" FontSize="{DynamicResource Fs11}"/>
                        </Button>
                    </Grid>
                </Border>

                <!-- 본문 -->
                <Grid Grid.Row="1" Margin="20,18,20,13">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <!-- 이름 -->
                    <Grid Margin="2,0,0,8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Text="이름" FontSize="{DynamicResource Fs12}" FontWeight="SemiBold"
                                   Foreground="{DynamicResource TextBrush}" VerticalAlignment="Center"/>
                        <TextBlock x:Name="NameErrorText" Grid.Column="2" FontSize="{DynamicResource Fs11}" FontWeight="SemiBold"
                                   Foreground="#ef4444" VerticalAlignment="Center" Visibility="Collapsed"/>
                    </Grid>
                    <Border x:Name="NameFrame" Grid.Row="1" BorderBrush="{DynamicResource LineBrush}" BorderThickness="1.5"
                            Background="{DynamicResource PanelBrush}" CornerRadius="10" Height="44" Padding="14,0" Margin="0,0,0,16">
                        <TextBox x:Name="NameBox" BorderThickness="0" Background="Transparent"
                                 Foreground="{DynamicResource TextBrush}" CaretBrush="{DynamicResource TextBrush}"
                                 FontSize="{DynamicResource Fs14}" VerticalContentAlignment="Center"
                                 GotFocus="InputBox_GotFocus" LostFocus="InputBox_LostFocus"/>
                    </Border>

                    <!-- 파일 경로 -->
                    <TextBlock Text="파일" Grid.Row="2" FontSize="{DynamicResource Fs12}" FontWeight="SemiBold"
                               Foreground="{DynamicResource TextBrush}" Margin="2,0,0,8"/>
                    <Grid Grid.Row="3" Margin="0,0,0,16">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <Border x:Name="PathFrame" Grid.Column="0" BorderBrush="{DynamicResource LineBrush}" BorderThickness="1.5"
                                Background="{DynamicResource PanelBrush}" CornerRadius="10" Height="44" Padding="14,0">
                            <TextBox x:Name="PathBox" BorderThickness="0" Background="Transparent"
                                     Foreground="{DynamicResource TextBrush}" CaretBrush="{DynamicResource TextBrush}"
                                     FontSize="{DynamicResource Fs13}" VerticalContentAlignment="Center"
                                     GotFocus="InputBox_GotFocus" LostFocus="InputBox_LostFocus"/>
                        </Border>
                        <Button Grid.Column="1" Click="BrowseBtn_Click" Width="92" Height="44" Margin="8,0,0,0"
                                Style="{StaticResource SecondaryButton}" FontSize="{DynamicResource Fs13}">
                            <TextBlock Text="찾아보기"/>
                        </Button>
                    </Grid>

                    <!-- 관리자 권한 실행 -->
                    <StackPanel Grid.Row="4" Orientation="Horizontal" Margin="2,2,0,0">
                        <CheckBox x:Name="RunAsAdminCheck" Style="{StaticResource ModernCheckBox}"
                                  Content="관리자 권한으로 실행"/>
                    </StackPanel>
                </Grid>

                <!-- 푸터 -->
                <Border Grid.Row="2" Background="{DynamicResource PanelSoftBrush}"
                        BorderBrush="{DynamicResource LineBrush}" BorderThickness="0,1,0,0" CornerRadius="0,0,14,14">
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="20,14,20,14">
                        <Button Click="CancelBtn_Click" Width="100" Height="38" Style="{StaticResource SecondaryButton}"
                                FontSize="{DynamicResource Fs13}" Margin="0,0,8,0">
                            <TextBlock Text="취소"/>
                        </Button>
                        <Button Click="OkBtn_Click" Width="100" Height="38" Style="{StaticResource PrimaryButton}"
                                FontSize="{DynamicResource Fs13}">
                            <TextBlock Text="저장" Foreground="White"/>
                        </Button>
                    </StackPanel>
                </Border>
            </Grid>
        </Border>
    </Grid>
</Window>
