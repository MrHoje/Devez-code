<Window x:Class="DevezCode.Views.CommunityEditorWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="게시글 작성" Width="720" Height="720"
        WindowStartupLocation="CenterOwner" WindowStyle="None" ResizeMode="NoResize"
        AllowsTransparency="True" Background="Transparent" ShowInTaskbar="False"
        FontFamily="{StaticResource PretendardFont}"
        UseLayoutRounding="True" SnapsToDevicePixels="True"
        TextOptions.TextFormattingMode="Display" TextOptions.TextRenderingMode="ClearType"
        PreviewKeyDown="Window_PreviewKeyDown">
    <Window.Resources>
        <Style x:Key="CommunityFieldLabel" TargetType="TextBlock"
               BasedOn="{StaticResource {x:Type TextBlock}}">
            <Setter Property="FontSize" Value="{DynamicResource Fs12}"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="{DynamicResource TextBrush}"/>
            <Setter Property="Margin" Value="2,0,0,7"/>
        </Style>
        <Style x:Key="CommunityComboItem" TargetType="ComboBoxItem">
            <Setter Property="Foreground" Value="{DynamicResource TextBrush}"/>
            <Setter Property="FontSize" Value="{DynamicResource Fs13}"/>
            <Setter Property="FontFamily" Value="{StaticResource PretendardFont}"/>
            <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ComboBoxItem">
                        <Border x:Name="Bd" Background="Transparent" CornerRadius="6"
                                Padding="10,8" Margin="3,1">
                            <ContentPresenter/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsHighlighted" Value="True">
                                <Setter TargetName="Bd" Property="Background"
                                        Value="{DynamicResource PanelSoftBrush}"/>
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="Bd" Property="Background"
                                        Value="{DynamicResource PrimarySoftBrush}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- 설정창의 ThemedCombo 패턴과 동일한 폼용 분류 선택기. -->
        <Style x:Key="CommunityCombo" TargetType="ComboBox">
            <Setter Property="Foreground" Value="{DynamicResource TextBrush}"/>
            <Setter Property="FontFamily" Value="{StaticResource PretendardFont}"/>
            <Setter Property="FontSize" Value="{DynamicResource Fs13}"/>
            <Setter Property="Height" Value="40"/>
            <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
            <Setter Property="ItemContainerStyle" Value="{StaticResource CommunityComboItem}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ComboBox">
                        <Grid>
                            <ToggleButton Focusable="False" ClickMode="Press"
                                          IsChecked="{Binding IsDropDownOpen, Mode=TwoWay, RelativeSource={RelativeSource TemplatedParent}}">
                                <ToggleButton.Template>
                                    <ControlTemplate TargetType="ToggleButton">
                                        <Border x:Name="Bd" CornerRadius="8" BorderThickness="1.5"
                                                BorderBrush="{DynamicResource LineBrush}"
                                                Background="{DynamicResource PanelBrush}">
                                            <Path HorizontalAlignment="Right" VerticalAlignment="Center"
                                                  Margin="0,0,13,0"
                                                  Data="{DynamicResource IconChevronDown}"
                                                  Stroke="{DynamicResource TextMutedBrush}" StrokeThickness="2"
                                                  StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                                                  StrokeLineJoin="Round" Width="12" Height="12"
                                                  Stretch="Uniform" Fill="Transparent"/>
                                        </Border>
                                        <ControlTemplate.Triggers>
                                            <Trigger Property="IsMouseOver" Value="True">
                                                <Setter TargetName="Bd" Property="Background"
                                                        Value="{DynamicResource PanelSoftBrush}"/>
                                            </Trigger>
                                            <Trigger Property="IsChecked" Value="True">
                                                <Setter TargetName="Bd" Property="BorderBrush"
                                                        Value="{DynamicResource PrimaryBrush}"/>
                                            </Trigger>
                                        </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                </ToggleButton.Template>
                            </ToggleButton>
                            <ContentPresenter Content="{TemplateBinding SelectionBoxItem}"
                                              ContentTemplate="{TemplateBinding SelectionBoxItemTemplate}"
                                              IsHitTestVisible="False" Margin="12,0,34,0"
                                              VerticalAlignment="Center"/>
                            <Popup x:Name="PART_Popup" Placement="Bottom" VerticalOffset="3"
                                   IsOpen="{TemplateBinding IsDropDownOpen}"
                                   AllowsTransparency="True" Focusable="False">
                                <Border Background="{DynamicResource PanelBrush}"
                                        BorderBrush="{DynamicResource LineBrush}" BorderThickness="1"
                                        CornerRadius="8" Padding="2"
                                        MinWidth="{Binding ActualWidth, RelativeSource={RelativeSource TemplatedParent}}">
                                    <Border.Effect>
                                        <DropShadowEffect BlurRadius="18" ShadowDepth="2"
                                                          Opacity="{DynamicResource PopupShadowOpacity}"
                                                          Color="{DynamicResource ShadowColor}"/>
                                    </Border.Effect>
                                    <ScrollViewer MaxHeight="220" Background="Transparent">
                                        <ItemsPresenter/>
                                    </ScrollViewer>
                                </Border>
                            </Popup>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid Margin="{DynamicResource WindowShadowOuterMargin}">
        <Border Background="{DynamicResource BgBrush}"
                CornerRadius="{DynamicResource WindowShadowCornerRadius}"
                Margin="{DynamicResource WindowShadowInnerMargin}"
                SnapsToDevicePixels="True">
            <Border.Effect>
                <DropShadowEffect ShadowDepth="0" BlurRadius="{DynamicResource WindowShadowBlurRadius}"
                                  Direction="270"
                                  Color="{DynamicResource ShadowColor}"
                                  Opacity="{DynamicResource ShadowOpacity}"/>
            </Border.Effect>
        </Border>
        <Border Background="{DynamicResource BgBrush}"
                BorderBrush="{DynamicResource LineBrush}" BorderThickness="1"
                CornerRadius="14" ClipToBounds="True">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="50"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="66"/>
                </Grid.RowDefinitions>

                <Border Grid.Row="0" BorderBrush="{DynamicResource LineBrush}"
                        BorderThickness="0,0,0,1" Background="{DynamicResource PanelBrush}"
                        MouseLeftButtonDown="Header_DragMove">
                    <Grid Margin="16,0,8,0">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <Path Style="{StaticResource LucideIcon}"
                                  Data="{StaticResource IconPencil}" Width="15" Height="15"
                                  Stroke="{DynamicResource TextBrush}" Margin="0,0,10,0"/>
                            <TextBlock x:Name="HeaderTitleText" Text="게시글 작성"
                                       FontSize="{DynamicResource Fs14}" FontWeight="SemiBold"
                                       Foreground="{DynamicResource TextBrush}"/>
                        </StackPanel>
                        <Button Click="CancelBtn_Click" HorizontalAlignment="Right"
                                Width="40" Height="32" Style="{StaticResource WinCloseBtn}">
                            <TextBlock Text="&#x2715;" FontSize="{DynamicResource Fs11}"/>
                        </Button>
                    </Grid>
                </Border>

                <Grid Grid.Row="1" Margin="22,18,22,14">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="14"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="0"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="14"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="14"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <Grid Grid.Row="0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="150"/>
                            <ColumnDefinition Width="12"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel>
                            <TextBlock Text="분류" Style="{StaticResource CommunityFieldLabel}"/>
                            <ComboBox x:Name="CategoryBox" Style="{StaticResource CommunityCombo}"
                                      DisplayMemberPath="Label" SelectedValuePath="Value"
                                      FontSize="{DynamicResource Fs13}"/>
                        </StackPanel>
                        <StackPanel Grid.Column="2">
                            <TextBlock Text="제목" Style="{StaticResource CommunityFieldLabel}"/>
                            <Border Style="{StaticResource AuthInputBorder}" Padding="12,0">
                                <TextBox x:Name="TitleBox" Style="{StaticResource InputStyle}"
                                         FontSize="{DynamicResource Fs13}"
                                         MaxLength="100"/>
                            </Border>
                        </StackPanel>
                    </Grid>

                    <TextBlock Grid.Row="2" Text="내용" Style="{StaticResource CommunityFieldLabel}"/>
                    <TextBox x:Name="BodyBox" Grid.Row="4"
                             Style="{StaticResource MemoInputStyle}"
                             AcceptsReturn="True" TextWrapping="Wrap"
                             VerticalScrollBarVisibility="Auto"
                             MaxLength="5000" FontSize="{DynamicResource Fs13}"/>

                    <Grid Grid.Row="6">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="12"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel>
                            <TextBlock Text="이름" Style="{StaticResource CommunityFieldLabel}"/>
                            <Border Style="{StaticResource AuthInputBorder}" Padding="12,0">
                                <TextBox x:Name="AuthorBox" Style="{StaticResource InputStyle}"
                                         FontSize="{DynamicResource Fs13}"
                                         MaxLength="20"/>
                            </Border>
                        </StackPanel>
                        <StackPanel x:Name="PasswordSection" Grid.Column="2">
                            <TextBlock Text="비밀번호 (4자 이상)" Style="{StaticResource CommunityFieldLabel}"/>
                            <Border Style="{StaticResource AuthInputBorder}" Padding="12,0">
                                <PasswordBox x:Name="PasswordBox" Style="{StaticResource PasswordStyle}"
                                             MaxLength="72" FontSize="{DynamicResource Fs13}"
                                             VerticalContentAlignment="Center"/>
                            </Border>
                        </StackPanel>
                    </Grid>

                    <Border Grid.Row="8" CornerRadius="9" Padding="12,9"
                            Background="{DynamicResource PanelSoftBrush}"
                            BorderBrush="{DynamicResource LineBrush}" BorderThickness="1">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="32"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <Border Width="26" Height="26" CornerRadius="7"
                                    Background="{DynamicResource PrimarySoftBrush}"
                                    HorizontalAlignment="Left" VerticalAlignment="Center">
                                <Path Style="{StaticResource LucideIcon}"
                                      Data="{StaticResource IconLock}" Width="12" Height="12"
                                      Stroke="{DynamicResource PrimaryBrush}"
                                      HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                            <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                <TextBlock Text="비공개 글" FontSize="{DynamicResource Fs12}"
                                           FontWeight="SemiBold" Foreground="{DynamicResource TextBrush}"/>
                                <TextBlock Text="비밀번호 확인 후에만 본문을 볼 수 있습니다."
                                           Margin="0,2,0,0" FontSize="{DynamicResource Fs10}"
                                           Foreground="{DynamicResource TextMutedBrush}"/>
                            </StackPanel>
                            <CheckBox x:Name="PrivateCheckBox" Grid.Column="2"
                                      Style="{StaticResource ToggleSwitch}"
                                      VerticalAlignment="Center" ToolTip="비공개 글로 등록"/>
                        </Grid>
                    </Border>

                    <TextBlock x:Name="StatusText" Grid.Row="9" Margin="2,9,0,0"
                               FontSize="{DynamicResource Fs11}"
                               Foreground="{DynamicResource DangerBrush}"
                               Visibility="Collapsed" TextWrapping="Wrap"/>
                </Grid>

                <Border Grid.Row="2" Background="{DynamicResource PanelSoftBrush}"
                        BorderBrush="{DynamicResource LineBrush}" BorderThickness="0,1,0,0">
                    <Grid Margin="22,0">
                        <TextBlock Text="Ctrl + Enter로 저장" VerticalAlignment="Center"
                                   FontSize="{DynamicResource Fs10}"
                                   Foreground="{DynamicResource TextMutedBrush}"/>
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right"
                                    VerticalAlignment="Center">
                            <Button Click="CancelBtn_Click" Height="38" MinWidth="80"
                                    Padding="16,0" Margin="0,0,8,0"
                                    Style="{StaticResource SecondaryButton}"
                                    FontSize="{DynamicResource Fs12}">
                                <TextBlock Text="취소"/>
                            </Button>
                            <Button x:Name="SaveBtn" Click="SaveBtn_Click" Height="38" MinWidth="92"
                                    Padding="16,0" Style="{StaticResource PrimaryButton}"
                                    FontSize="{DynamicResource Fs12}">
                                <TextBlock x:Name="SaveBtnText" Text="등록" Foreground="White"/>
                            </Button>
                        </StackPanel>
                    </Grid>
                </Border>
            </Grid>
        </Border>
    </Grid>
</Window>
