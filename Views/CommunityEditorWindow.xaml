<Window x:Class="DevezCode.Views.CommunityEditorWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="게시글 작성" Width="620" Height="650"
        WindowStartupLocation="CenterOwner" WindowStyle="None" ResizeMode="NoResize"
        AllowsTransparency="True" Background="Transparent" ShowInTaskbar="False"
        FontFamily="{StaticResource PretendardFont}"
        UseLayoutRounding="True" SnapsToDevicePixels="True"
        TextOptions.TextFormattingMode="Display" TextOptions.TextRenderingMode="ClearType"
        PreviewKeyDown="Window_PreviewKeyDown">
    <Window.Resources>
        <Style x:Key="CommunityFieldLabel" TargetType="TextBlock"
               BasedOn="{StaticResource {x:Type TextBlock}}">
            <Setter Property="FontSize" Value="{DynamicResource Fs12}"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="{DynamicResource TextBrush}"/>
            <Setter Property="Margin" Value="2,0,0,7"/>
        </Style>
        <Style x:Key="CommunityFieldTextBox" TargetType="TextBox"
               BasedOn="{StaticResource {x:Type TextBox}}">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Foreground" Value="{DynamicResource TextBrush}"/>
            <Setter Property="CaretBrush" Value="{DynamicResource TextBrush}"/>
            <Setter Property="FontSize" Value="{DynamicResource Fs13}"/>
            <Setter Property="Padding" Value="0"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
        </Style>
    </Window.Resources>

    <Grid Margin="20">
        <Border Background="{DynamicResource BgBrush}" CornerRadius="14">
            <Border.Effect>
                <DropShadowEffect ShadowDepth="0" BlurRadius="40"
                                  Color="{DynamicResource ShadowColor}"
                                  Opacity="{DynamicResource ShadowOpacity}"/>
            </Border.Effect>
        </Border>
        <Border Background="{DynamicResource BgBrush}"
                BorderBrush="{DynamicResource LineBrush}" BorderThickness="1"
                CornerRadius="14" ClipToBounds="True">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="50"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="66"/>
                </Grid.RowDefinitions>

                <Border Grid.Row="0" BorderBrush="{DynamicResource LineBrush}"
                        BorderThickness="0,0,0,1" MouseLeftButtonDown="Header_DragMove">
                    <Grid Margin="18,0,8,0">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <Path Style="{StaticResource LucideIcon}"
                                  Data="{StaticResource IconPencil}" Width="15" Height="15"
                                  Stroke="{DynamicResource TextBrush}" Margin="0,0,9,0"/>
                            <TextBlock x:Name="HeaderTitleText" Text="게시글 작성"
                                       FontSize="{DynamicResource Fs14}" FontWeight="SemiBold"
                                       Foreground="{DynamicResource TextBrush}"/>
                        </StackPanel>
                        <Button Click="CancelBtn_Click" HorizontalAlignment="Right"
                                Width="40" Height="32" Style="{StaticResource WinCloseBtn}">
                            <TextBlock Text="&#x2715;" FontSize="{DynamicResource Fs11}"/>
                        </Button>
                    </Grid>
                </Border>

                <Grid Grid.Row="1" Margin="22,18,22,14">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="14"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="14"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="14"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="14"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <Grid Grid.Row="0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="150"/>
                            <ColumnDefinition Width="12"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel>
                            <TextBlock Text="분류" Style="{StaticResource CommunityFieldLabel}"/>
                            <ComboBox x:Name="CategoryBox" Height="42"
                                      DisplayMemberPath="Label" SelectedValuePath="Value"
                                      FontSize="{DynamicResource Fs13}"/>
                        </StackPanel>
                        <StackPanel Grid.Column="2">
                            <TextBlock Text="제목" Style="{StaticResource CommunityFieldLabel}"/>
                            <Border Height="42" CornerRadius="9"
                                    Background="{DynamicResource PanelBrush}"
                                    BorderBrush="{DynamicResource LineBrush}" BorderThickness="1"
                                    Padding="12,0">
                                <TextBox x:Name="TitleBox" Style="{StaticResource CommunityFieldTextBox}"
                                         MaxLength="100"/>
                            </Border>
                        </StackPanel>
                    </Grid>

                    <TextBlock Grid.Row="2" Text="내용" Style="{StaticResource CommunityFieldLabel}"/>
                    <TextBox x:Name="BodyBox" Grid.Row="4"
                             Style="{StaticResource MemoInputStyle}"
                             AcceptsReturn="True" TextWrapping="Wrap"
                             VerticalScrollBarVisibility="Auto"
                             MaxLength="5000" FontSize="{DynamicResource Fs13}"/>

                    <Grid Grid.Row="6">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="12"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel>
                            <TextBlock Text="이름" Style="{StaticResource CommunityFieldLabel}"/>
                            <Border Height="42" CornerRadius="9"
                                    Background="{DynamicResource PanelBrush}"
                                    BorderBrush="{DynamicResource LineBrush}" BorderThickness="1"
                                    Padding="12,0">
                                <TextBox x:Name="AuthorBox" Style="{StaticResource CommunityFieldTextBox}"
                                         MaxLength="20"/>
                            </Border>
                        </StackPanel>
                        <StackPanel x:Name="PasswordSection" Grid.Column="2">
                            <TextBlock Text="비밀번호 (4자 이상)" Style="{StaticResource CommunityFieldLabel}"/>
                            <Border Height="42" CornerRadius="9"
                                    Background="{DynamicResource PanelBrush}"
                                    BorderBrush="{DynamicResource LineBrush}" BorderThickness="1"
                                    Padding="12,0">
                                <PasswordBox x:Name="PasswordBox" Style="{StaticResource PasswordStyle}"
                                             MaxLength="72" FontSize="{DynamicResource Fs13}"
                                             VerticalContentAlignment="Center"/>
                            </Border>
                        </StackPanel>
                    </Grid>

                    <Grid Grid.Row="8">
                        <CheckBox x:Name="PrivateCheckBox" VerticalAlignment="Center">
                            <StackPanel Orientation="Horizontal">
                                <Path Style="{StaticResource LucideIcon}"
                                      Data="{StaticResource IconLock}" Width="12" Height="12"
                                      Stroke="{DynamicResource TextMutedBrush}" Margin="0,0,7,0"/>
                                <TextBlock Text="비공개 글로 등록" FontSize="{DynamicResource Fs12}"
                                           Foreground="{DynamicResource TextBrush}"/>
                            </StackPanel>
                        </CheckBox>
                        <TextBlock Text="비공개 글은 비밀번호 확인 후에만 본문을 볼 수 있습니다."
                                   HorizontalAlignment="Right" VerticalAlignment="Center"
                                   FontSize="{DynamicResource Fs10}"
                                   Foreground="{DynamicResource TextMutedBrush}"/>
                    </Grid>

                    <TextBlock x:Name="StatusText" Grid.Row="9" Margin="2,9,0,0"
                               FontSize="{DynamicResource Fs11}"
                               Foreground="{DynamicResource DangerBrush}"
                               Visibility="Collapsed" TextWrapping="Wrap"/>
                </Grid>

                <Border Grid.Row="2" Background="{DynamicResource PanelSoftBrush}"
                        BorderBrush="{DynamicResource LineBrush}" BorderThickness="0,1,0,0">
                    <Grid Margin="22,0">
                        <TextBlock Text="Ctrl + Enter로 저장" VerticalAlignment="Center"
                                   FontSize="{DynamicResource Fs10}"
                                   Foreground="{DynamicResource TextMutedBrush}"/>
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right"
                                    VerticalAlignment="Center">
                            <Button Click="CancelBtn_Click" Height="38" MinWidth="80"
                                    Padding="16,0" Margin="0,0,8,0"
                                    Style="{StaticResource SecondaryButton}"
                                    FontSize="{DynamicResource Fs12}">
                                <TextBlock Text="취소"/>
                            </Button>
                            <Button x:Name="SaveBtn" Click="SaveBtn_Click" Height="38" MinWidth="92"
                                    Padding="16,0" Style="{StaticResource PrimaryButton}"
                                    FontSize="{DynamicResource Fs12}">
                                <TextBlock x:Name="SaveBtnText" Text="등록" Foreground="White"/>
                            </Button>
                        </StackPanel>
                    </Grid>
                </Border>
            </Grid>
        </Border>
    </Grid>
</Window>
