<Window x:Class="DevezCode.Views.QuickOpenWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:models="clr-namespace:DevezCode.Models"
        Title="빠른 열기"
        Height="560" Width="820"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        ShowInTaskbar="False"
        FontFamily="{StaticResource PretendardFont}">

    <Grid Margin="20">
        <Border Background="{DynamicResource BgBrush}" CornerRadius="14">
            <Border.Effect>
                <DropShadowEffect ShadowDepth="0" BlurRadius="40"
                                  Color="{DynamicResource ShadowColor}"
                                  Opacity="{DynamicResource ShadowOpacity}" />
            </Border.Effect>
        </Border>

        <Border CornerRadius="14"
                Background="{DynamicResource BgBrush}"
                BorderBrush="{DynamicResource LineBrush}" BorderThickness="1"
                ClipToBounds="True">
            <Grid Margin="18">
                <Grid.RowDefinitions>
                    <RowDefinition Height="52" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="30" />
                </Grid.RowDefinitions>

                <Border BorderBrush="{DynamicResource LineBrush}" BorderThickness="0,0,0,1">
                    <Grid>
                        <TextBlock Text="빠른 열기 (Ctrl+P)"
                                   VerticalAlignment="Center"
                                   Margin="16,0,0,0"
                                   FontSize="{DynamicResource Fs14}"
                                   FontWeight="SemiBold"
                                   Foreground="{DynamicResource TextBrush}" />

                        <TextBlock x:Name="ResultHintText"
                                   Text="Esc: 닫기"
                                   VerticalAlignment="Center"
                                   Margin="0,0,16,0"
                                   HorizontalAlignment="Right"
                                   FontSize="{DynamicResource Fs11}"
                                   Foreground="{DynamicResource TextMutedBrush}" />
                    </Grid>
                </Border>

                <Border Grid.Row="1"
                        Margin="8,10,8,0"
                        BorderBrush="{DynamicResource LineBrush}"
                        BorderThickness="1.5"
                        Background="{DynamicResource PanelBrush}"
                        CornerRadius="10"
                        Height="44">
                    <TextBox x:Name="SearchBox"
                             BorderThickness="0"
                             Background="Transparent"
                             FontSize="{DynamicResource Fs14}"
                             Foreground="{DynamicResource TextBrush}"
                             CaretBrush="{DynamicResource TextBrush}"
                             Padding="12,0"
                             VerticalContentAlignment="Center"
                             TextChanged="SearchBox_TextChanged"
                             PreviewKeyDown="SearchBox_PreviewKeyDown">
                        <TextBox.Resources>
                            <Style TargetType="Border">
                                <Setter Property="CornerRadius" Value="0" />
                            </Style>
                        </TextBox.Resources>
                    </TextBox>
                </Border>

                <ListBox x:Name="ResultList"
                         Grid.Row="2"
                         Margin="8,12,8,0"
                         Background="{DynamicResource PanelBrush}"
                         BorderBrush="{DynamicResource LineBrush}"
                         BorderThickness="1"
                         Foreground="{DynamicResource TextBrush}"
                         ItemsSource="{Binding}"
                         FocusVisualStyle="{x:Null}"
                         ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                         PreviewKeyDown="ResultList_PreviewKeyDown"
                         MouseDoubleClick="ResultList_MouseDoubleClick">
                    <ListBox.ItemTemplate>
                        <DataTemplate DataType="{x:Type models:QuickOpenItem}">
                            <Grid Margin="10,6">
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                </Grid.RowDefinitions>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>

                                <Border Background="{DynamicResource PanelSoftBrush}"
                                        BorderBrush="{DynamicResource LineBrush}"
                                        BorderThickness="1"
                                        CornerRadius="6"
                                        Padding="8,2"
                                        HorizontalAlignment="Left">
                                    <TextBlock Text="{Binding KindText}"
                                               FontSize="{DynamicResource Fs10}"
                                               Foreground="{DynamicResource TextMutedBrush}" />
                                </Border>

                                <StackPanel Grid.Column="1" Margin="10,0,0,0">
                                    <TextBlock Text="{Binding Title}"
                                               FontSize="{DynamicResource Fs14}"
                                               Foreground="{DynamicResource TextBrush}"
                                               TextTrimming="CharacterEllipsis" />
                                    <TextBlock Text="{Binding Subtitle}"
                                               FontSize="{DynamicResource Fs11}"
                                               Foreground="{DynamicResource TextMutedBrush}"
                                               TextTrimming="CharacterEllipsis"
                                               Margin="0,3,0,0" />
                                </StackPanel>
                            </Grid>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>

                <TextBlock x:Name="SearchHintText"
                           Grid.Row="3"
                           Margin="10,6,10,0"
                           FontSize="{DynamicResource Fs11}"
                           Foreground="{DynamicResource TextMutedBrush}" />
            </Grid>
        </Border>
    </Grid>
</Window>
