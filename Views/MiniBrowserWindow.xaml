<Window x:Class="DevezCode.Views.MiniBrowserWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
        Title="미니 브라우저"
        Width="520" Height="700" MinWidth="320" MinHeight="240"
        WindowStyle="None" ResizeMode="CanResize" ShowInTaskbar="False"
        Background="{DynamicResource BgBrush}"
        FontFamily="{StaticResource PretendardFont}">
    <shell:WindowChrome.WindowChrome>
        <!-- 리사이즈 적중 판정은 코드(WM_NCHITTEST)에서 직접 한다 — 변/모서리를 더 넉넉하게 잡기 위해. -->
        <shell:WindowChrome CaptionHeight="0"
                            ResizeBorderThickness="0"
                            CornerRadius="0"
                            GlassFrameThickness="0"
                            UseAeroCaptionButtons="False"/>
    </shell:WindowChrome.WindowChrome>

    <Border x:Name="Chrome"
            Background="{DynamicResource BgBrush}"
            BorderBrush="{DynamicResource LineBrush}"
            BorderThickness="1">
        <Grid x:Name="Root">
            <!-- 웹 화면이 창을 꽉 채운다. -->
            <Grid x:Name="BrowserHost"/>

            <!-- 컨트롤박스: 웹 화면은 별도 HWND 라 WPF 요소로는 그 위를 덮을 수 없다.
                 팝업은 자체 HWND 라 웹 화면 위에 뜬다. 창 이동 전용(드래그). -->
            <Popup x:Name="HeaderPopup"
                   Placement="Relative"
                   PlacementTarget="{Binding ElementName=Root}"
                   Width="{Binding ActualWidth, ElementName=Root}"
                   AllowsTransparency="True"
                   StaysOpen="True"
                   IsOpen="False">
                <Border x:Name="HeaderBar"
                        Height="0"
                        HorizontalAlignment="Stretch"
                        Background="{DynamicResource BgBrush}"
                        BorderBrush="{DynamicResource LineBrush}"
                        BorderThickness="0,0,0,1"
                        CornerRadius="7,7,0,0"
                        ClipToBounds="True"
                        MouseLeftButtonDown="HeaderBar_MouseLeftButtonDown"
                        MouseMove="HeaderBar_MouseMove"
                        MouseLeftButtonUp="HeaderBar_MouseLeftButtonUp"/>
            </Popup>
            <!-- 리사이즈 그립: 웹 화면은 별도 HWND 라 그 위에서는 창 테두리 판정이 오지 않는다.
                 팝업은 자체 HWND 라 웹 화면 위에 올라가므로 우하단 모서리 그립으로 크기를 조절한다. -->
            <Popup x:Name="GripPopup"
                   Placement="Relative"
                   PlacementTarget="{Binding ElementName=Root}"
                   AllowsTransparency="True"
                   StaysOpen="True"
                   IsOpen="False">
                <Border x:Name="Grip"
                        Width="18" Height="18"
                        Background="Transparent"
                        Cursor="SizeNWSE"
                        MouseLeftButtonDown="Grip_MouseLeftButtonDown"
                        MouseMove="Grip_MouseMove"
                        MouseLeftButtonUp="Grip_MouseLeftButtonUp"/>
            </Popup>
        </Grid>
    </Border>
</Window>
