<Window x:Class="DevezCode.Views.MiniBrowserWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
        xmlns:views="clr-namespace:DevezCode.Views"
        Title="미니 브라우저"
        Width="520" Height="700" MinWidth="320" MinHeight="240"
        WindowStyle="None" ResizeMode="CanResize" ShowInTaskbar="False"
        Background="{DynamicResource BgBrush}"
        FontFamily="{StaticResource PretendardFont}">
    <shell:WindowChrome.WindowChrome>
        <shell:WindowChrome CaptionHeight="0"
                            ResizeBorderThickness="6"
                            CornerRadius="0"
                            GlassFrameThickness="0"
                            UseAeroCaptionButtons="False"/>
    </shell:WindowChrome.WindowChrome>

    <Border x:Name="Chrome"
            Background="{DynamicResource BgBrush}"
            BorderBrush="{DynamicResource LineBrush}"
            BorderThickness="1"
            CornerRadius="8">
        <Grid x:Name="Root">
            <Grid.RowDefinitions>
                <RowDefinition Height="30"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <!-- 헤더: 드래그 이동 + 제목 + 외부 열기/닫기 -->
            <Border x:Name="Header" Grid.Row="0"
                    Background="{DynamicResource PanelBrush}"
                    BorderBrush="{DynamicResource LineBrush}"
                    BorderThickness="0,0,0,1"
                    Padding="10,0,4,0"
                    MouseLeftButtonDown="Header_MouseLeftButtonDown">
                <DockPanel LastChildFill="True">
                    <Button x:Name="CloseBtn" DockPanel.Dock="Right"
                            Style="{StaticResource WinCloseBtn}"
                            Cursor="Arrow" ToolTip="닫기"
                            Click="CloseBtn_Click">
                        <TextBlock Text="&#x2715;" FontSize="12"/>
                    </Button>
                    <Button x:Name="OpenExternalBtn" DockPanel.Dock="Right"
                            Width="24" Height="24" Margin="0,0,2,0"
                            VerticalAlignment="Center"
                            Style="{StaticResource IconButton}"
                            Cursor="Arrow" ToolTip="기본 브라우저로 열기"
                            Click="OpenExternalBtn_Click">
                        <Path Style="{StaticResource LucideButtonIcon}"
                              Data="{StaticResource IconExternalLink}" Width="12" Height="12"/>
                    </Button>
                    <TextBlock x:Name="TitleText"
                               Text="미니 브라우저"
                               FontSize="{DynamicResource Fs12}"
                               Foreground="{DynamicResource TextBrush}"
                               VerticalAlignment="Center"
                               TextTrimming="CharacterEllipsis"/>
                </DockPanel>
            </Border>

            <views:BrowserHostView x:Name="Browser" Grid.Row="1"/>
        </Grid>
    </Border>
</Window>
