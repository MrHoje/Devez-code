<Window x:Class="DevezCode.Views.MiniBrowserWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
        Title="미니 브라우저"
        Width="520" Height="700" MinWidth="320" MinHeight="240"
        WindowStyle="None" ResizeMode="CanResize" ShowInTaskbar="False"
        FontFamily="{StaticResource PretendardFont}">
    <shell:WindowChrome.WindowChrome>
        <shell:WindowChrome CaptionHeight="0"
                            ResizeBorderThickness="7"
                            CornerRadius="0"
                            GlassFrameThickness="0"
                            UseAeroCaptionButtons="False"/>
    </shell:WindowChrome.WindowChrome>

    <!-- 창 투명도·CornerRadius 는 렌더 모드에 따라 코드에서 정한다(MiniBrowserWindow 생성자 주석 참고). -->
    <Border x:Name="Chrome"
            Background="{DynamicResource BgBrush}"
            BorderBrush="{DynamicResource LineBrush}"
            BorderThickness="1"
            SnapsToDevicePixels="False">
        <Grid x:Name="Root">
            <!-- 웹 화면이 창 전체를 채운다(상단에 별도 헤더 영역을 두지 않는다). -->
            <Grid x:Name="BrowserHost"/>

            <!-- 창 이동·닫기용 오버레이 띠. 평소에는 아무것도 보이지 않고, 마우스를 올리면 닫기 버튼만 나타난다. -->
            <Border x:Name="Header"
                    VerticalAlignment="Top" Height="26"
                    Background="Transparent"
                    Padding="0,0,6,0"
                    MouseLeftButtonDown="Header_MouseLeftButtonDown">
                <Button x:Name="CloseBtn"
                        HorizontalAlignment="Right" VerticalAlignment="Center"
                        Width="20" Height="20"
                        Cursor="Arrow" ToolTip="닫기"
                        Click="CloseBtn_Click">
                    <Button.Style>
                        <Style TargetType="Button" BasedOn="{StaticResource IconButton}">
                            <Setter Property="Opacity" Value="0"/>
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding IsMouseOver, ElementName=Header}" Value="True">
                                    <Setter Property="Opacity" Value="1"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Button.Style>
                    <TextBlock Text="&#x2715;" FontSize="11"
                               Foreground="{DynamicResource TextMutedBrush}"/>
                </Button>
            </Border>
        </Grid>
    </Border>
</Window>
