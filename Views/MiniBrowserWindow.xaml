<Window x:Class="DevezCode.Views.MiniBrowserWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
        Title="미니 브라우저"
        Width="520" Height="700" MinWidth="320" MinHeight="240"
        WindowStyle="None" ResizeMode="CanResize" ShowInTaskbar="False"
        Background="{DynamicResource BgBrush}"
        FontFamily="{StaticResource PretendardFont}">
    <shell:WindowChrome.WindowChrome>
        <!-- 웹 화면(별도 HWND)이 가리지 않는 6px 여백에서 표준 창 리사이즈가 동작한다. -->
        <shell:WindowChrome CaptionHeight="0"
                            ResizeBorderThickness="6"
                            CornerRadius="0"
                            GlassFrameThickness="0"
                            UseAeroCaptionButtons="False"/>
    </shell:WindowChrome.WindowChrome>

    <!-- Chrome 배경 = 현재 페이지 배경색(코드에서 갱신). 6px 여백이 그 색으로 채워져 이음새가 안 보인다. -->
    <Border x:Name="Chrome"
            Background="{DynamicResource BgBrush}"
            BorderBrush="{DynamicResource LineBrush}"
            BorderThickness="1">
        <Grid x:Name="Root">
            <!-- 웹 화면은 6px 안으로 들여 창 테두리 리사이즈 영역을 노출한다. -->
            <Grid x:Name="BrowserHost" Margin="6"/>

            <!-- 컨트롤박스: 웹 화면 위에 뜨는 팝업(자체 HWND). 창 최상단 전체 폭을 덮는다(창 테두리 여백 포함).
                 그 자리의 표준 리사이즈는 사라지므로, 헤더 위쪽 가장자리에서 코드가 직접 리사이즈를 처리한다. -->
            <Popup x:Name="HeaderPopup"
                   Placement="Relative"
                   PlacementTarget="{Binding ElementName=Root}"
                   Width="{Binding ActualWidth, ElementName=Root}"
                   AllowsTransparency="True"
                   StaysOpen="True"
                   IsOpen="False">
                <!-- 배경·보더·글자색은 '지금 열린 페이지 색'에 맞춰 코드에서 칠한다(ApplyHeaderPalette). -->
                <Border x:Name="HeaderBar"
                        Height="0"
                        HorizontalAlignment="Stretch"
                        BorderThickness="0,0,0,1"
                        CornerRadius="7,7,0,0"
                        Padding="6,0,6,0"
                        ClipToBounds="True"
                        MouseLeftButtonDown="HeaderBar_MouseLeftButtonDown"
                        MouseMove="HeaderBar_MouseMove"
                        MouseLeftButtonUp="HeaderBar_MouseLeftButtonUp">
                    <DockPanel LastChildFill="True" VerticalAlignment="Center">
                        <Button x:Name="BackBtn" DockPanel.Dock="Left"
                                Width="22" Height="22"
                                Style="{StaticResource IconButton}"
                                Cursor="Arrow" ToolTip="뒤로"
                                Click="BackBtn_Click">
                            <TextBlock x:Name="BackGlyph" Text="&#x2039;" FontSize="17" Margin="0,-2,0,0"/>
                        </Button>
                        <Button x:Name="ForwardBtn" DockPanel.Dock="Left"
                                Width="22" Height="22"
                                Style="{StaticResource IconButton}"
                                Cursor="Arrow" ToolTip="앞으로"
                                Click="ForwardBtn_Click">
                            <TextBlock x:Name="ForwardGlyph" Text="&#x203A;" FontSize="17" Margin="0,-2,0,0"/>
                        </Button>
                        <Button x:Name="CloseBtn" DockPanel.Dock="Right"
                                Width="18" Height="18"
                                Style="{StaticResource IconButton}"
                                Cursor="Arrow" ToolTip="닫기"
                                Click="CloseBtn_Click">
                            <!-- 글리프가 시각적으로 아래로 치우쳐 보여 아이콘만 1px 올린다. -->
                            <TextBlock x:Name="CloseGlyph" Text="&#x2715;" FontSize="11" Margin="0,-1,0,0"/>
                        </Button>
                        <!-- 디자인 시스템 입력: 라운드 8·보더 1·PanelSoft 배경. 색은 페이지 팔레트에 맞춰
                             코드에서 칠하고, 포커스 시 보더를 Primary 로 강조한다. -->
                        <Border x:Name="AddressBorder"
                                Margin="6,0,4,0" Height="24"
                                VerticalAlignment="Center"
                                CornerRadius="8" BorderThickness="1"
                                Padding="10,0" SnapsToDevicePixels="True">
                            <TextBox x:Name="AddressBox"
                                     Style="{StaticResource InputStyle}"
                                     FontSize="{DynamicResource Fs12}"
                                     VerticalContentAlignment="Center"
                                     KeyDown="AddressBox_KeyDown"
                                     GotKeyboardFocus="AddressBox_FocusChanged"
                                     LostKeyboardFocus="AddressBox_FocusChanged"/>
                        </Border>
                    </DockPanel>
                </Border>
            </Popup>
        </Grid>
    </Border>
</Window>
