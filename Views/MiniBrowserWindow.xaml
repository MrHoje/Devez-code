<Window x:Class="DevezCode.Views.MiniBrowserWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
        Title="미니 브라우저"
        Width="520" Height="700" MinWidth="320" MinHeight="240"
        WindowStyle="None" ResizeMode="CanResize" ShowInTaskbar="False"
        Background="{DynamicResource BgBrush}"
        FontFamily="{StaticResource PretendardFont}">
    <shell:WindowChrome.WindowChrome>
        <!-- 툴바(상단)는 WPF 라 표준 리사이즈가 그대로 오고, 웹 화면(별도 HWND)이 가리는 좌·우·하단은
             BrowserHost 여백으로 창 테두리를 노출해 표준 리사이즈가 동작한다. -->
        <shell:WindowChrome CaptionHeight="0"
                            ResizeBorderThickness="6"
                            CornerRadius="0"
                            GlassFrameThickness="0"
                            UseAeroCaptionButtons="False"/>
    </shell:WindowChrome.WindowChrome>

    <!-- Chrome 배경 = 현재 페이지 배경색(코드에서 갱신). 웹 화면 좌·우·하단 여백이 그 색으로 채워져 이음새가 안 보인다. -->
    <Border x:Name="Chrome"
            Background="{DynamicResource BgBrush}"
            BorderBrush="{DynamicResource LineBrush}"
            BorderThickness="1">
        <Grid x:Name="Root">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <!-- 컨트롤박스(상시 표시): 내장 브라우저 툴바와 동일한 모양. 빈 영역을 끌면 창이 이동한다. -->
            <Border x:Name="Toolbar" Grid.Row="0" Height="35"
                    Background="{DynamicResource PanelBrush}"
                    BorderBrush="{DynamicResource LineBrush}"
                    BorderThickness="0,0,0,1"
                    Padding="11,0,8,0"
                    MouseLeftButtonDown="Toolbar_MouseLeftButtonDown">
                <DockPanel LastChildFill="True">
                    <Button x:Name="BackBtn" DockPanel.Dock="Left" Width="24" Height="24"
                            Style="{StaticResource IconButton}"
                            Click="BackBtn_Click" ToolTip="뒤로"
                            IsEnabled="False" VerticalAlignment="Center">
                        <Path Style="{StaticResource LucideButtonIcon}"
                              Data="{StaticResource IconArrowLeft}" Width="12" Height="12"/>
                    </Button>
                    <Button x:Name="ForwardBtn" DockPanel.Dock="Left" Width="24" Height="24"
                            Style="{StaticResource IconButton}"
                            Click="ForwardBtn_Click" ToolTip="앞으로"
                            IsEnabled="False" VerticalAlignment="Center" Margin="2,0,0,0">
                        <Path Style="{StaticResource LucideButtonIcon}"
                              Data="{StaticResource IconArrowRight}" Width="12" Height="12"/>
                    </Button>
                    <Button x:Name="RefreshBtn" DockPanel.Dock="Left" Width="24" Height="24"
                            Style="{StaticResource IconButton}"
                            Click="RefreshBtn_Click" ToolTip="새로고침"
                            VerticalAlignment="Center" Margin="2,0,6,0">
                        <Path Style="{StaticResource LucideButtonIcon}"
                              Data="{StaticResource IconRotateCcw}" Width="12" Height="12"/>
                    </Button>

                    <!-- 닫기(미니 창 전용) — 오른쪽 끝 -->
                    <Button x:Name="CloseBtn" DockPanel.Dock="Right" Width="24" Height="24"
                            Style="{StaticResource IconButton}"
                            Click="CloseBtn_Click" ToolTip="닫기"
                            VerticalAlignment="Center" Margin="6,0,0,0">
                        <Path Style="{StaticResource LucideButtonIcon}"
                              Data="{StaticResource IconX}" Width="12" Height="12"/>
                    </Button>

                    <!-- 화면 맞추기 — 열려 있는 오른쪽 서브 패널 영역을 그대로 덮는 위치·크기로 이동 -->
                    <Button x:Name="FitBtn" DockPanel.Dock="Right" Width="24" Height="24"
                            Style="{StaticResource IconButton}"
                            Click="FitBtn_Click" ToolTip="오른쪽 패널 영역에 맞추기"
                            IsEnabled="False" VerticalAlignment="Center" Margin="6,0,0,0">
                        <Path Style="{StaticResource LucideButtonIcon}"
                              Data="{StaticResource IconSquareDimensions}" Width="12" Height="12"/>
                    </Button>

                    <!-- 주소창 -->
                    <Border Height="22" VerticalAlignment="Center"
                            Background="{DynamicResource PanelSoftBrush}"
                            BorderBrush="{DynamicResource LineBrush}"
                            BorderThickness="1" CornerRadius="8"
                            Padding="8,0">
                        <TextBox x:Name="AddressBox"
                                 BorderThickness="0" Background="Transparent"
                                 Foreground="{DynamicResource TextBrush}"
                                 CaretBrush="{DynamicResource TextBrush}"
                                 FontSize="{DynamicResource Fs12}"
                                 FontFamily="{StaticResource PretendardFont}"
                                 VerticalContentAlignment="Center" Padding="0"
                                 GotKeyboardFocus="AddressBox_GotKeyboardFocus"
                                 PreviewMouseLeftButtonDown="AddressBox_PreviewMouseLeftButtonDown"
                                 KeyDown="AddressBox_KeyDown"/>
                    </Border>
                </DockPanel>
            </Border>

            <!-- 웹 화면은 좌·우·하단 6px 안으로 들여 창 테두리 리사이즈 영역을 노출한다(상단은 툴바가 처리). -->
            <Grid x:Name="BrowserHost" Grid.Row="1" Margin="6,0,6,6"/>
        </Grid>
    </Border>
</Window>
