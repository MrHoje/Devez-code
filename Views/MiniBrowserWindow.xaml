<Window x:Class="DevezCode.Views.MiniBrowserWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
        Title="미니 브라우저"
        Width="520" Height="700" MinWidth="320" MinHeight="240"
        WindowStyle="None" ResizeMode="CanResize" ShowInTaskbar="False"
        Background="{DynamicResource BgBrush}"
        FontFamily="{StaticResource PretendardFont}">
    <shell:WindowChrome.WindowChrome>
        <!-- 리사이즈는 아래 네 변 팝업이 담당한다(웹 화면이 HWND 라 창 테두리 판정이 오지 않음). -->
        <shell:WindowChrome CaptionHeight="0"
                            ResizeBorderThickness="0"
                            CornerRadius="0"
                            GlassFrameThickness="0"
                            UseAeroCaptionButtons="False"/>
    </shell:WindowChrome.WindowChrome>

    <Border x:Name="Chrome"
            Background="{DynamicResource BgBrush}"
            BorderBrush="{DynamicResource LineBrush}"
            BorderThickness="1">
        <Grid x:Name="Root">
            <!-- 웹 화면이 창을 꽉 채운다. -->
            <Grid x:Name="BrowserHost"/>

            <!-- 컨트롤박스: 웹 화면은 별도 HWND 라 WPF 요소로는 그 위를 덮을 수 없다.
                 팝업은 자체 HWND 라 웹 화면 위에 뜬다. 창 이동(드래그) + 닫기. -->
            <Popup x:Name="HeaderPopup"
                   Placement="Relative"
                   PlacementTarget="{Binding ElementName=Root}"
                   Width="{Binding ActualWidth, ElementName=Root}"
                   AllowsTransparency="True"
                   StaysOpen="True"
                   IsOpen="False">
                <Border x:Name="HeaderBar"
                        Height="0"
                        HorizontalAlignment="Stretch"
                        Background="{DynamicResource BgBrush}"
                        BorderBrush="{DynamicResource LineBrush}"
                        BorderThickness="0,0,0,1"
                        CornerRadius="7,7,0,0"
                        Padding="0,0,6,0"
                        ClipToBounds="True"
                        MouseLeftButtonDown="HeaderBar_MouseLeftButtonDown"
                        MouseMove="HeaderBar_MouseMove"
                        MouseLeftButtonUp="HeaderBar_MouseLeftButtonUp">
                    <Button x:Name="CloseBtn"
                            HorizontalAlignment="Right" VerticalAlignment="Center"
                            Width="18" Height="18"
                            Style="{StaticResource IconButton}"
                            Cursor="Arrow" ToolTip="닫기"
                            Click="CloseBtn_Click">
                        <TextBlock Text="&#x2715;" FontSize="11"
                                   Foreground="{DynamicResource TextMutedBrush}"/>
                    </Button>
                </Border>
            </Popup>

            <!-- 리사이즈 영역: 웹 화면은 별도 HWND 라 그 위에서는 창 테두리 판정이 오지 않는다.
                 팝업은 자체 HWND 라 웹 화면 위에 올라가므로 네 변에 투명 띠를 겹쳐 리사이즈를 받는다.
                 각 띠의 양 끝은 모서리(대각선) 리사이즈로 처리한다. -->
            <Popup x:Name="EdgeLeftPopup" Placement="Relative" PlacementTarget="{Binding ElementName=Root}"
                   AllowsTransparency="True" StaysOpen="True" IsOpen="False">
                <Border x:Name="EdgeLeft" Background="Transparent" Cursor="SizeWE"
                        MouseMove="Edge_MouseMove"
                        MouseLeftButtonDown="Edge_MouseLeftButtonDown"
                        MouseLeftButtonUp="Edge_MouseLeftButtonUp"/>
            </Popup>
            <Popup x:Name="EdgeRightPopup" Placement="Relative" PlacementTarget="{Binding ElementName=Root}"
                   AllowsTransparency="True" StaysOpen="True" IsOpen="False">
                <Border x:Name="EdgeRight" Background="Transparent" Cursor="SizeWE"
                        MouseMove="Edge_MouseMove"
                        MouseLeftButtonDown="Edge_MouseLeftButtonDown"
                        MouseLeftButtonUp="Edge_MouseLeftButtonUp"/>
            </Popup>
            <Popup x:Name="EdgeTopPopup" Placement="Relative" PlacementTarget="{Binding ElementName=Root}"
                   AllowsTransparency="True" StaysOpen="True" IsOpen="False">
                <Border x:Name="EdgeTop" Background="Transparent" Cursor="SizeNS"
                        MouseMove="Edge_MouseMove"
                        MouseLeftButtonDown="Edge_MouseLeftButtonDown"
                        MouseLeftButtonUp="Edge_MouseLeftButtonUp"/>
            </Popup>
            <Popup x:Name="EdgeBottomPopup" Placement="Relative" PlacementTarget="{Binding ElementName=Root}"
                   AllowsTransparency="True" StaysOpen="True" IsOpen="False">
                <Border x:Name="EdgeBottom" Background="Transparent" Cursor="SizeNS"
                        MouseMove="Edge_MouseMove"
                        MouseLeftButtonDown="Edge_MouseLeftButtonDown"
                        MouseLeftButtonUp="Edge_MouseLeftButtonUp"/>
            </Popup>
        </Grid>
    </Border>
</Window>
