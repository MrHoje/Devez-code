<Window x:Class="DevezCode.Views.MiniBrowserWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
        Title="미니 브라우저"
        Width="520" Height="700" MinWidth="320" MinHeight="240"
        WindowStyle="None" ResizeMode="CanResize" ShowInTaskbar="False"
        FontFamily="{StaticResource PretendardFont}">
    <shell:WindowChrome.WindowChrome>
        <shell:WindowChrome CaptionHeight="0"
                            ResizeBorderThickness="7"
                            CornerRadius="0"
                            GlassFrameThickness="0"
                            UseAeroCaptionButtons="False"/>
    </shell:WindowChrome.WindowChrome>

    <!-- 창 투명도·CornerRadius 는 렌더 모드에 따라 코드에서 정한다(MiniBrowserWindow 생성자 주석 참고). -->
    <Border x:Name="Chrome"
            Background="{DynamicResource BgBrush}"
            BorderBrush="{DynamicResource LineBrush}"
            BorderThickness="1"
            SnapsToDevicePixels="False">
        <Grid x:Name="Root">
            <!-- 웹 화면이 창 전체를 채운다(상단에 별도 컨트롤 영역을 두지 않는다). -->
            <Grid x:Name="BrowserHost"/>

            <!-- 감지 영역: 평소엔 완전히 비어 보이고, 마우스가 들어오면 컨트롤박스가 나타난다. -->
            <Border x:Name="Header"
                    VerticalAlignment="Top" Height="28"
                    Background="Transparent"
                    MouseEnter="Header_MouseEnter"
                    MouseLeave="Header_MouseLeave"
                    MouseLeftButtonDown="Header_MouseLeftButtonDown">
                <Border x:Name="HeaderBar"
                        Opacity="0"
                        Background="{DynamicResource BgBrush}"
                        BorderBrush="{DynamicResource LineBrush}"
                        BorderThickness="0,0,0,1"
                        Padding="0,0,6,0">
                    <Button x:Name="CloseBtn"
                            HorizontalAlignment="Right" VerticalAlignment="Center"
                            Width="20" Height="20"
                            Style="{StaticResource IconButton}"
                            Cursor="Arrow" ToolTip="닫기"
                            Click="CloseBtn_Click">
                        <TextBlock Text="&#x2715;" FontSize="11"
                                   Foreground="{DynamicResource TextMutedBrush}"/>
                    </Button>
                </Border>
            </Border>
        </Grid>
    </Border>
</Window>
