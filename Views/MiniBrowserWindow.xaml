<Window x:Class="DevezCode.Views.MiniBrowserWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
        Title="미니 브라우저"
        Width="520" Height="700" MinWidth="320" MinHeight="240"
        WindowStyle="None" ResizeMode="CanResize" ShowInTaskbar="False"
        FontFamily="{StaticResource PretendardFont}">
    <shell:WindowChrome.WindowChrome>
        <shell:WindowChrome CaptionHeight="0"
                            ResizeBorderThickness="7"
                            CornerRadius="0"
                            GlassFrameThickness="0"
                            UseAeroCaptionButtons="False"/>
    </shell:WindowChrome.WindowChrome>

    <!-- 창 투명도·CornerRadius 는 렌더 모드에 따라 코드에서 정한다(MiniBrowserWindow 생성자 주석 참고). -->
    <Border x:Name="Chrome"
            Background="{DynamicResource BgBrush}"
            BorderBrush="{DynamicResource LineBrush}"
            BorderThickness="1"
            SnapsToDevicePixels="False">
        <Grid x:Name="Root">
            <Grid.RowDefinitions>
                <!-- 컨트롤박스 행 — 헤더 높이를 따라간다(기본 0 = 안 보임). 커서가 창 위쪽에 오면 코드가 펼친다. -->
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <!-- 컨트롤박스: 창 이동(드래그) + 닫기 -->
            <Border x:Name="Header" Grid.Row="0"
                    Height="0"
                    Background="{DynamicResource BgBrush}"
                    BorderBrush="{DynamicResource LineBrush}"
                    BorderThickness="0,0,0,1"
                    Padding="0,0,6,0"
                    ClipToBounds="True"
                    MouseLeftButtonDown="Header_MouseLeftButtonDown">
                <Button x:Name="CloseBtn"
                        HorizontalAlignment="Right" VerticalAlignment="Center"
                        Width="20" Height="20"
                        Style="{StaticResource IconButton}"
                        Cursor="Arrow" ToolTip="닫기"
                        Click="CloseBtn_Click">
                    <TextBlock Text="&#x2715;" FontSize="11"
                               Foreground="{DynamicResource TextMutedBrush}"/>
                </Button>
            </Border>

            <!-- 브라우저 본문 -->
            <Grid x:Name="BrowserHost" Grid.Row="1"/>
        </Grid>
    </Border>
</Window>
