<UserControl x:Class="DevezCode.Views.McpManagerDialog"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:models="clr-namespace:DevezCode.Models"
             UseLayoutRounding="True"
             SnapsToDevicePixels="True"
             TextOptions.TextFormattingMode="Display"
             TextOptions.TextRenderingMode="ClearType"
             FontFamily="{StaticResource PretendardFont}">

    <UserControl.Resources>
        <!-- 좌측 서버 목록 한 줄: 상태 점 + 이름 + 타입 칩 + 비활성 표시 -->
        <Style x:Key="McpListItem" TargetType="ListBoxItem">
            <Setter Property="IsTabStop" Value="False"/>
            <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
            <Setter Property="Padding" Value="0"/>
            <Setter Property="Margin" Value="0,0,0,2"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ListBoxItem">
                        <Border x:Name="Bd" Background="Transparent" CornerRadius="8" Padding="10,8"
                                BorderThickness="0">
                            <ContentPresenter/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource PanelSoftBrush}"/>
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource PrimarySoftBrush}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- 타입 칩 (local/remote) -->
        <Style x:Key="TypeChip" TargetType="Border">
            <Setter Property="CornerRadius" Value="4"/>
            <Setter Property="Padding" Value="5,1"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>

        <!-- 필드 라벨 -->
        <Style x:Key="FieldLabel" TargetType="TextBlock">
            <Setter Property="FontSize" Value="{DynamicResource Fs11}"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="{DynamicResource TextMutedBrush}"/>
            <Setter Property="Margin" Value="0,0,0,6"/>
        </Style>

        <!-- 단일 라인 텍스트박스 -->
        <Style x:Key="FieldInput" TargetType="TextBox" BasedOn="{StaticResource InputStyle}">
            <Setter Property="Height" Value="34"/>
            <Setter Property="FontSize" Value="{DynamicResource Fs12}"/>
            <Setter Property="Padding" Value="10,0"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
        </Style>

        <!-- 여러 줄 텍스트박스(command / env / headers) -->
        <Style x:Key="MultiLineInput" TargetType="TextBox" BasedOn="{StaticResource InputStyle}">
            <Setter Property="FontFamily" Value="Consolas, Cascadia Code, PretendardFont"/>
            <Setter Property="FontSize" Value="{DynamicResource Fs12}"/>
            <Setter Property="Padding" Value="10,8"/>
            <Setter Property="AcceptsReturn" Value="True"/>
            <Setter Property="VerticalScrollBarVisibility" Value="Auto"/>
            <Setter Property="TextWrapping" Value="NoWrap"/>
            <Setter Property="MinHeight" Value="80"/>
        </Style>

        <!-- 필드 컨테이너 (라벨 + 입력) -->
        <Style x:Key="FieldBox" TargetType="Border">
            <Setter Property="BorderBrush" Value="{DynamicResource LineBrush}"/>
            <Setter Property="BorderThickness" Value="1.5"/>
            <Setter Property="Background" Value="{DynamicResource PanelBrush}"/>
            <Setter Property="CornerRadius" Value="8"/>
        </Style>
    </UserControl.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="48"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- 헤더 -->
        <Border Grid.Row="0"
                Background="{DynamicResource PanelBrush}"
                BorderBrush="{DynamicResource LineBrush}"
                BorderThickness="0,0,0,1"
                MouseLeftButtonDown="Header_DragMove">
            <Grid>
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="16,0,0,0">
                    <Path Style="{StaticResource LucideIcon}"
                          Data="{StaticResource IconServer}"
                          Width="16" Height="16" VerticalAlignment="Center"
                          Stroke="{DynamicResource TextBrush}"
                          Margin="0,-1,11,0"/>
                    <TextBlock Text="MCP 서버" VerticalAlignment="Center"
                               FontSize="{DynamicResource Fs14}" FontWeight="SemiBold"
                               Foreground="{DynamicResource TextBrush}"/>
                    <Border Margin="10,0,0,0" Padding="6,1" CornerRadius="4"
                            Background="{DynamicResource PanelSoftBrush}">
                        <TextBlock x:Name="ConfigPathHint" Text="opencode.json"
                                   FontSize="{DynamicResource Fs10}" Foreground="{DynamicResource TextMutedBrush}"
                                   VerticalAlignment="Center"/>
                    </Border>
                </StackPanel>
                <Button Click="CancelBtn_Click"
                        HorizontalAlignment="Right" VerticalAlignment="Center"
                        Width="40" Height="32" Margin="0,0,8,0"
                        Style="{StaticResource WinCloseBtn}">
                    <TextBlock Text="&#x2715;" FontSize="{DynamicResource Fs11}"/>
                </Button>
            </Grid>
        </Border>

        <!-- 에이전트 탭 (opencode / Claude / Codex) -->
        <Border Grid.Row="1" Background="{DynamicResource PanelBrush}"
                BorderBrush="{DynamicResource LineBrush}" BorderThickness="0,0,0,1"
                Padding="8,0">
            <StackPanel x:Name="AgentTabsPanel" Orientation="Horizontal" Margin="8,6,8,6"/>
        </Border>

        <!-- 본문: 좌(목록) | 우(상세) -->
        <Grid Grid.Row="2">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="280"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- 좌: 서버 목록 + 추가 버튼 -->
            <Border Grid.Column="0" Background="{DynamicResource PanelSoftBrush}"
                    BorderBrush="{DynamicResource LineBrush}" BorderThickness="0,0,1,0">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>
                    <!-- 목록 상단 라벨 + 새로고침 -->
                    <Grid Grid.Row="0" Margin="14,12,8,8">
                        <TextBlock Text="서버" FontSize="{DynamicResource Fs11}" FontWeight="SemiBold"
                                   Foreground="{DynamicResource TextMutedBrush}" VerticalAlignment="Center"/>
                        <Button x:Name="RefreshStatusBtn" Click="RefreshStatusBtn_Click"
                                HorizontalAlignment="Right" VerticalAlignment="Center"
                                Style="{StaticResource TitleBarChipButton}"
                                ToolTip="연결 상태 새로고침">
                            <Path Style="{StaticResource LucideButtonIcon}" Data="{StaticResource IconRefresh}"
                                  Width="13" Height="13" Stroke="{DynamicResource TextMutedBrush}"/>
                        </Button>
                    </Grid>

                    <ListBox x:Name="ServerList" Grid.Row="1"
                             Background="Transparent" BorderThickness="0"
                             ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                             Margin="8,0,8,8"
                             SelectionChanged="ServerList_SelectionChanged">
                        <ListBox.ItemTemplate>
                            <DataTemplate DataType="{x:Type models:McpServer}">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <!-- 상태 점 -->
                                    <Ellipse Grid.Column="0" Width="8" Height="8" VerticalAlignment="Center"
                                             Margin="0,0,8,0"
                                             Fill="{Binding Status, Converter={x:Static models:McpStatusToBrushConverter.Instance}}"/>
                                    <!-- 이름 -->
                                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                        <TextBlock Text="{Binding Name}" FontSize="{DynamicResource Fs12}"
                                                   FontWeight="SemiBold" Foreground="{DynamicResource TextBrush}"
                                                   TextTrimming="CharacterEllipsis"/>
                                        <StackPanel Orientation="Horizontal" Margin="0,2,0,0">
                                            <Border Style="{StaticResource TypeChip}"
                                                    Background="{DynamicResource PanelBrush}">
                                                <TextBlock Text="{Binding Type, Converter={x:Static models:McpTypeToLabelConverter.Instance}}"
                                                           FontSize="{DynamicResource Fs10}"
                                                           Foreground="{DynamicResource TextMutedBrush}"/>
                                            </Border>
                                            <TextBlock Text="비활성" FontSize="{DynamicResource Fs10}"
                                                       Foreground="{DynamicResource TextMutedBrush}"
                                                       VerticalAlignment="Center" Margin="6,0,0,0"
                                                       Visibility="{Binding Enabled, Converter={x:Static models:BoolToVisibilityConverter.Instance}, ConverterParameter=invert}"/>
                                        </StackPanel>
                                    </StackPanel>
                                </Grid>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>

                    <!-- 추가 버튼 -->
                    <Button Grid.Row="2" x:Name="AddBtn" Click="AddBtn_Click" Margin="8,0,8,12"
                            Style="{StaticResource SecondaryButton}" Height="36">
                        <StackPanel Orientation="Horizontal">
                            <Path Style="{StaticResource LucideButtonIcon}" Data="{StaticResource IconPlus}"
                                  Width="13" Height="13" Margin="0,0,6,0"/>
                            <TextBlock Text="서버 추가" FontSize="{DynamicResource Fs12}" FontWeight="SemiBold"/>
                        </StackPanel>
                    </Button>
                </Grid>
            </Border>

            <!-- 우: 상세 편집 -->
            <Grid Grid.Column="1" Background="{DynamicResource PanelBrush}">
                <!-- 미선택 시 빈 화면 -->
                <StackPanel x:Name="EmptyState" VerticalAlignment="Center" HorizontalAlignment="Center"
                            Visibility="Visible">
                    <Path Style="{StaticResource LucideIcon}" Data="{StaticResource IconServer}"
                          Width="36" Height="36" Stroke="{DynamicResource LineBrush}"
                          HorizontalAlignment="Center"/>
                    <TextBlock Text="왼쪽에서 서버를 선택하거나 새로 추가하세요"
                               FontSize="{DynamicResource Fs12}" Foreground="{DynamicResource TextMutedBrush}"
                               Margin="0,12,0,0" HorizontalAlignment="Center"/>
                </StackPanel>

                <ScrollViewer x:Name="EditorScroll" VerticalScrollBarVisibility="Auto"
                              HorizontalScrollBarVisibility="Disabled" Visibility="Collapsed">
                    <StackPanel x:Name="EditorPanel" Margin="24,18,24,18" DataContext="{Binding ElementName=ServerList, Path=SelectedItem}">

                        <!-- 이름 + 상태 -->
                        <Grid Margin="0,0,0,16">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <Border Style="{StaticResource FieldBox}">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBox x:Name="NameBox" Grid.Column="0"
                                             Style="{StaticResource FieldInput}"
                                             BorderThickness="0" Background="Transparent"
                                             Text="{Binding Name, UpdateSourceTrigger=PropertyChanged}"
                                             ToolTip="서버 이름 (영숫자/하이픈). opencode config 의 키로 사용됩니다."/>
                                    <Border Grid.Column="1" VerticalAlignment="Center" Margin="0,0,10,0"
                                            Padding="6,2" CornerRadius="4" Background="{DynamicResource PanelSoftBrush}">
                                        <StackPanel Orientation="Horizontal">
                                            <Ellipse Width="7" Height="7" VerticalAlignment="Center" Margin="0,0,5,0"
                                                     Fill="{Binding Status, Converter={x:Static models:McpStatusToBrushConverter.Instance}}"/>
                                            <TextBlock Text="{Binding Status, Converter={x:Static models:McpStatusToLabelConverter.Instance}}"
                                                       FontSize="{DynamicResource Fs10}"
                                                       Foreground="{DynamicResource TextMutedBrush}"
                                                       VerticalAlignment="Center"/>
                                        </StackPanel>
                                    </Border>
                                </Grid>
                            </Border>
                            <CheckBox Grid.Column="1" x:Name="EnabledBox" Content="활성"
                                      IsChecked="{Binding Enabled, Mode=TwoWay}"
                                      Style="{StaticResource ToggleSwitch}"
                                      VerticalAlignment="Center" Margin="10,0,0,0"/>
                        </Grid>

                        <!-- 타입 토글 -->
                        <Grid Margin="0,0,0,14">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <Border x:Name="TypeLocalBtn" Grid.Column="0" Tag="local"
                                    Style="{StaticResource FieldBox}" Margin="0,0,4,0" Padding="14,10"
                                    Cursor="Hand" MouseLeftButtonDown="TypeBtn_Click">
                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                    <Path Style="{StaticResource LucideIcon}" Data="{StaticResource IconBox}"
                                          Width="14" Height="14" Stroke="{DynamicResource TextBrush}" Margin="0,0,8,0"/>
                                    <TextBlock Text="로컬" FontWeight="SemiBold" FontSize="{DynamicResource Fs12}"
                                               Foreground="{DynamicResource TextBrush}" VerticalAlignment="Center"/>
                                    <TextBlock Text="(stdio)" FontSize="{DynamicResource Fs11}"
                                               Foreground="{DynamicResource TextMutedBrush}"
                                               VerticalAlignment="Center" Margin="4,0,0,0"/>
                                </StackPanel>
                            </Border>
                            <Border x:Name="TypeRemoteBtn" Grid.Column="1" Tag="remote"
                                    Style="{StaticResource FieldBox}" Margin="4,0,0,0" Padding="14,10"
                                    Cursor="Hand" MouseLeftButtonDown="TypeBtn_Click">
                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                    <Path Style="{StaticResource LucideIcon}" Data="{StaticResource IconNetwork}"
                                          Width="14" Height="14" Stroke="{DynamicResource TextBrush}" Margin="0,0,8,0"/>
                                    <TextBlock Text="원격" FontWeight="SemiBold" FontSize="{DynamicResource Fs12}"
                                               Foreground="{DynamicResource TextBrush}" VerticalAlignment="Center"/>
                                    <TextBlock Text="(http/sse)" FontSize="{DynamicResource Fs11}"
                                               Foreground="{DynamicResource TextMutedBrush}"
                                               VerticalAlignment="Center" Margin="4,0,0,0"/>
                                </StackPanel>
                            </Border>
                        </Grid>

                        <!-- 로컬 필드 -->
                        <StackPanel x:Name="LocalPanel" Margin="0,0,0,14">
                            <TextBlock Text="Command (실행 커맨드 + 인자, 한 줄에 하나씩 또는 공백 구분)"
                                       Style="{StaticResource FieldLabel}"/>
                            <Border Style="{StaticResource FieldBox}">
                                <TextBox x:Name="CommandBox" Style="{StaticResource MultiLineInput}"
                                         BorderThickness="0" Background="Transparent"
                                         Text="{Binding CommandText, UpdateSourceTrigger=PropertyChanged}"
                                         ToolTip="예: npx -y @modelcontextprotocol/server-filesystem C:/work"/>
                            </Border>
                            <TextBlock Text="환경변수 (선택, KEY=VALUE 한 줄에 하나)"
                                       Style="{StaticResource FieldLabel}" Margin="0,12,0,6"/>
                            <Border Style="{StaticResource FieldBox}">
                                <TextBox x:Name="EnvBox" Style="{StaticResource MultiLineInput}"
                                         BorderThickness="0" Background="Transparent"
                                         Text="{Binding EnvironmentText, UpdateSourceTrigger=PropertyChanged}"/>
                            </Border>
                        </StackPanel>

                        <!-- 원격 필드 -->
                        <StackPanel x:Name="RemotePanel" Margin="0,0,0,14" Visibility="Collapsed">
                            <TextBlock Text="URL" Style="{StaticResource FieldLabel}"/>
                            <Border Style="{StaticResource FieldBox}">
                                <TextBox x:Name="UrlBox" Style="{StaticResource FieldInput}"
                                         BorderThickness="0" Background="Transparent"
                                         Text="{Binding Url, UpdateSourceTrigger=PropertyChanged}"
                                         ToolTip="원격 MCP 서버 엔드포인트. 예: https://mcp.example.com/sse"/>
                            </Border>
                            <TextBlock Text="헤더 (선택, KEY=VALUE 한 줄에 하나)"
                                       Style="{StaticResource FieldLabel}" Margin="0,12,0,6"/>
                            <Border Style="{StaticResource FieldBox}">
                                <TextBox x:Name="HeaderBox" Style="{StaticResource MultiLineInput}"
                                         BorderThickness="0" Background="Transparent"
                                         Text="{Binding HeadersText, UpdateSourceTrigger=PropertyChanged}"/>
                            </Border>

                            <StackPanel x:Name="OAuthSection">
                                <TextBlock Text="OAuth" Style="{StaticResource FieldLabel}" Margin="0,12,0,6"/>
                                <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                                    <RadioButton x:Name="OAuthAutoBtn" Content="자동" GroupName="oauth"
                                                 Checked="OAuthMode_Changed"
                                                 Style="{StaticResource McpRadioLeft}" Margin="0,0,6,0"/>
                                    <RadioButton x:Name="OAuthDisabledBtn" Content="사용 안 함" GroupName="oauth"
                                                 Checked="OAuthMode_Changed"
                                                 Style="{StaticResource McpRadioMid}" Margin="0,0,6,0"/>
                                    <RadioButton x:Name="OAuthExplicitBtn" Content="명시 설정" GroupName="oauth"
                                                 Checked="OAuthMode_Changed"
                                                 Style="{StaticResource McpRadioRight}"/>
                                </StackPanel>
                                <StackPanel x:Name="OAuthExplicitPanel" Visibility="Collapsed">
                                    <TextBlock Text="clientId" Style="{StaticResource FieldLabel}"/>
                                    <Border Style="{StaticResource FieldBox}" Margin="0,0,0,8">
                                        <TextBox Style="{StaticResource FieldInput}" BorderThickness="0" Background="Transparent"
                                                 Text="{Binding OAuthClientId, UpdateSourceTrigger=PropertyChanged}"/>
                                    </Border>
                                    <TextBlock Text="clientSecret" Style="{StaticResource FieldLabel}"/>
                                    <Border Style="{StaticResource FieldBox}" Margin="0,0,0,8">
                                        <PasswordBox x:Name="OAuthSecretBox" Height="34" Padding="10,0"
                                                     BorderThickness="0" Background="Transparent"
                                                 PasswordChanged="OAuthSecretBox_Changed"
                                                 Style="{StaticResource PasswordStyle}"
                                                 ToolTip="비밀번호 — 화면에 그대로 보이지 않습니다."/>
                                </Border>
                                <TextBlock Text="scope (선택)" Style="{StaticResource FieldLabel}"/>
                                <Border Style="{StaticResource FieldBox}">
                                    <TextBox Style="{StaticResource FieldInput}" BorderThickness="0" Background="Transparent"
                                             Text="{Binding OAuthScope, UpdateSourceTrigger=PropertyChanged}"/>
                                </Border>
                            </StackPanel>
                        </StackPanel>
                        </StackPanel>

                        <!-- 타임아웃 + 상태 메시지 -->
                        <Grid Margin="0,0,0,8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="200"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel>
                                <TextBlock Text="Timeout (ms, 0=기본)" Style="{StaticResource FieldLabel}"/>
                                <Border Style="{StaticResource FieldBox}">
                                    <TextBox Style="{StaticResource FieldInput}" BorderThickness="0" Background="Transparent"
                                             Text="{Binding TimeoutMs, UpdateSourceTrigger=PropertyChanged}"
                                             ToolTip="연결/응답 타임아웃(ms). 비워두면 opencode 기본값 사용."/>
                                </Border>
                            </StackPanel>
                        </Grid>

                        <TextBlock x:Name="StatusMessageText" Text="{Binding StatusMessage}"
                                   FontSize="{DynamicResource Fs11}" Foreground="{DynamicResource DangerBrush}"
                                   TextWrapping="Wrap" Margin="0,4,0,0"
                                   Visibility="{Binding Status, Converter={x:Static models:McpStatusToVisibilityConverter.Instance}}"/>
                    </StackPanel>
                </ScrollViewer>
            </Grid>
        </Grid>

        <!-- 하단 액션 바 -->
        <Border Grid.Row="3" Background="{DynamicResource PanelBrush}"
                BorderBrush="{DynamicResource LineBrush}" BorderThickness="0,1,0,0"
                Padding="16,10">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <Button Grid.Column="0" x:Name="DeleteBtn" Click="DeleteBtn_Click"
                        HorizontalAlignment="Left"
                        Style="{StaticResource SecondaryButton}" Height="36"
                        Visibility="Collapsed">
                    <StackPanel Orientation="Horizontal">
                        <Path Style="{StaticResource LucideButtonIcon}" Data="{StaticResource IconTrash2}"
                              Width="13" Height="13" Margin="0,0,6,0"/>
                        <TextBlock Text="삭제" FontSize="{DynamicResource Fs12}" FontWeight="SemiBold"/>
                    </StackPanel>
                </Button>
                <StackPanel Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Right">
                    <Button x:Name="CancelBtn" Click="CancelBtn_Click"
                            Style="{StaticResource SecondaryButton}" Height="36" Margin="0,0,8,0"
                            MinWidth="80">
                        <TextBlock Text="취소" FontSize="{DynamicResource Fs12}" FontWeight="SemiBold"/>
                    </Button>
                    <Button x:Name="SaveBtn" Click="SaveBtn_Click"
                            Style="{StaticResource PrimaryButton}" Height="36"
                            MinWidth="100">
                        <StackPanel Orientation="Horizontal">
                            <Path Style="{StaticResource LucideButtonIcon}" Data="{StaticResource IconSave}"
                                  Width="13" Height="13" Margin="0,0,6,0" Stroke="White"/>
                            <TextBlock Text="저장" FontSize="{DynamicResource Fs12}" FontWeight="SemiBold"/>
                        </StackPanel>
                    </Button>
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</UserControl>
