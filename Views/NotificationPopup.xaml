<Window x:Class="DevezCode.Views.NotificationPopup"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        WindowStyle="None" AllowsTransparency="True"
        ShowInTaskbar="False" Topmost="True"
        ResizeMode="NoResize"
        Width="340" SizeToContent="Height"
        Background="Transparent"
        FontFamily="{StaticResource PretendardFont}">

    <Window.RenderTransform>
        <TranslateTransform/>
    </Window.RenderTransform>

    <Border Background="{DynamicResource PanelBrush}"
            BorderBrush="{DynamicResource LineBrush}"
            BorderThickness="1" CornerRadius="12"
            Margin="5,5,5,7"
            MouseLeftButtonUp="Body_Click" Cursor="Hand">
        <Border.Effect>
            <DropShadowEffect Color="{DynamicResource ShadowColor}" Opacity="{DynamicResource PopupShadowOpacity}"
                              BlurRadius="22" ShadowDepth="6" Direction="270"/>
        </Border.Effect>

        <StackPanel>
            <!-- 헤더: 벨 아이콘 + Devez + 닫기 (높이 축소: 상하 여백 12→2) -->
            <Grid Margin="16,2,12,2">
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <Path Data="{DynamicResource IconBell}" Width="13" Height="13" Margin="0,0,7,0"
                          VerticalAlignment="Center" Stretch="Uniform" Fill="Transparent"
                          StrokeThickness="1.5" StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round"
                          Stroke="{DynamicResource PrimaryBrush}"/>
                    <TextBlock Text="Devez" FontSize="{DynamicResource Fs12}" FontWeight="SemiBold"
                               Foreground="{DynamicResource TextMutedBrush}" VerticalAlignment="Center"/>
                </StackPanel>
                <Button HorizontalAlignment="Right" VerticalAlignment="Center"
                        Width="22" Height="22" Click="Close_Click"
                        Background="Transparent" BorderThickness="0" Cursor="Hand"
                        FocusVisualStyle="{x:Null}">
                    <Button.Template>
                        <ControlTemplate TargetType="Button">
                            <Border x:Name="Bd" Background="Transparent" CornerRadius="4">
                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="Bd" Property="Background" Value="{DynamicResource PanelSoftBrush}"/>
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Button.Template>
                    <Path Width="9" Height="9" Stretch="Uniform" StrokeThickness="1.5"
                          StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                          Stroke="{DynamicResource TextMutedBrush}"
                          Data="M18 6 6 18 M6 6 l12 12"/>
                </Button>
            </Grid>

            <Border Height="1" Background="{DynamicResource LineBrush}"/>

            <!-- 본문: 프로젝트명(큰 글씨) + 세션명(작은 글씨). 아래 여백 +20 (16→36) -->
            <StackPanel Margin="16,16,16,36">
                <TextBlock x:Name="TitleText" FontSize="{DynamicResource Fs16}" FontWeight="Bold"
                           Foreground="{DynamicResource TextBrush}"
                           TextWrapping="Wrap" Margin="0,0,0,5"/>
                <TextBlock x:Name="ContentText" FontSize="{DynamicResource Fs12}"
                           Foreground="{DynamicResource TextMutedBrush}"
                           TextWrapping="Wrap" Visibility="Collapsed"/>
            </StackPanel>
        </StackPanel>
    </Border>
</Window>
