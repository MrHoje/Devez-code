<Window x:Class="DevezCode.Views.SubagentTranscriptView"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="서브에이전트 대화" Height="600" Width="720"
        MinHeight="400" MinWidth="520"
        WindowStartupLocation="CenterOwner" ResizeMode="CanResizeWithGrow"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        ShowInTaskbar="False"
        UseLayoutRounding="True"
        SnapsToDevicePixels="True"
        TextOptions.TextFormattingMode="Display"
        TextOptions.TextRenderingMode="ClearType"
        TextOptions.TextHintingMode="Fixed"
        RenderOptions.ClearTypeHint="Enabled"
        FontFamily="{StaticResource PretendardFont}">

    <Grid Margin="20">
        <!-- Shadow layer -->
        <Border Background="{DynamicResource BgBrush}" CornerRadius="14">
            <Border.Effect>
                <DropShadowEffect ShadowDepth="0" BlurRadius="40" Color="{DynamicResource ShadowColor}" Opacity="{DynamicResource ShadowOpacity}"/>
            </Border.Effect>
        </Border>
        <!-- Content layer -->
        <Border CornerRadius="14"
                Background="{DynamicResource BgBrush}"
                BorderBrush="{DynamicResource LineBrush}" BorderThickness="1"
                ClipToBounds="True">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <!-- Header -->
                <Border Grid.Row="0"
                        BorderBrush="{DynamicResource LineBrush}"
                        BorderThickness="0,0,0,1"
                        Background="Transparent"
                        MouseLeftButtonDown="Header_DragMove">
                    <Grid Margin="16,8,8,8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <!-- Agent badge + ID -->
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <Border x:Name="AgentTypeBadge" CornerRadius="4"
                                    Background="{DynamicResource PrimaryBrush}"
                                    Padding="6,2" VerticalAlignment="Center">
                                <TextBlock x:Name="AgentTypeText"
                                           FontSize="{DynamicResource Fs10}"
                                           Foreground="White" FontWeight="SemiBold"/>
                            </Border>
                            <TextBlock x:Name="AgentIdText"
                                       Margin="8,0,0,0" FontSize="{DynamicResource Fs12}"
                                       Foreground="{DynamicResource TextBrush}"
                                       TextTrimming="CharacterEllipsis"
                                       VerticalAlignment="Center" MaxWidth="280"/>
                            <!-- Status badge -->
                            <Border x:Name="StatusBadge" CornerRadius="4"
                                    Background="{DynamicResource PanelSoftBrush}"
                                    Padding="6,2" Margin="8,0,0,0" VerticalAlignment="Center">
                                <TextBlock x:Name="StatusText"
                                           FontSize="{DynamicResource Fs10}"
                                           Foreground="{DynamicResource TextMutedBrush}"/>
                            </Border>
                        </StackPanel>

                        <!-- Prompt preview -->
                        <TextBlock Grid.Column="1" x:Name="PromptPreviewText"
                                   Margin="12,0,12,0" FontSize="{DynamicResource Fs11}"
                                   Foreground="{DynamicResource TextMutedBrush}"
                                   TextTrimming="CharacterEllipsis"
                                   VerticalAlignment="Center"
                                   MaxHeight="20"/>

                        <!-- Close button -->
                        <Button Grid.Column="2" Click="CloseBtn_Click"
                                Width="40" Height="32" Margin="0,0,0,0"
                                Style="{StaticResource WinCloseBtn}">
                            <TextBlock Text="&#x2715;" FontSize="{DynamicResource Fs11}"/>
                        </Button>
                    </Grid>
                </Border>

                <!-- Content area -->
                <Grid Grid.Row="1">

                    <!-- JSONL transcript view (chat) -->
                    <ScrollViewer x:Name="TranscriptScrollViewer"
                                  Visibility="Collapsed"
                                  VerticalScrollBarVisibility="Auto"
                                  Padding="16,12,16,12">
                        <ItemsControl x:Name="TranscriptList">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border CornerRadius="8" Padding="10,8" Margin="0,3"
                                            MaxWidth="620" HorizontalAlignment="Left"
                                            BorderBrush="{DynamicResource LineBrush}" BorderThickness="1"
                                            Background="{DynamicResource PanelSoftBrush}">
                                        <Border.Style>
                                            <Style TargetType="Border">
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding Role}" Value="user">
                                                        <Setter Property="HorizontalAlignment" Value="Right"/>
                                                        <Setter Property="Background" Value="{DynamicResource PrimaryBrush}"/>
                                                        <Setter Property="BorderThickness" Value="0"/>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Border.Style>
                                        <Grid>
                                            <Grid.RowDefinitions>
                                                <RowDefinition Height="Auto"/>
                                                <RowDefinition Height="Auto"/>
                                            </Grid.RowDefinitions>
                                            <Grid Grid.Row="0">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="Auto"/>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="Auto"/>
                                                </Grid.ColumnDefinitions>
                                                <Border CornerRadius="3" Padding="5,1"
                                                        Background="{DynamicResource PrimaryBrush}">
                                                    <Border.Style>
                                                        <Style TargetType="Border">
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding Role}" Value="user">
                                                                    <Setter Property="Background" Value="{DynamicResource TextMutedBrush}"/>
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </Border.Style>
                                                    <TextBlock Text="{Binding Role}"
                                                               FontSize="{DynamicResource Fs10}"
                                                               Foreground="White" FontWeight="SemiBold"/>
                                                </Border>
                                                <TextBlock Grid.Column="2" Text="{Binding Timestamp}"
                                                           FontSize="{DynamicResource Fs10}"
                                                           Foreground="{DynamicResource TextMutedBrush}"
                                                           VerticalAlignment="Center"/>
                                            </Grid>
                                            <TextBlock Grid.Row="1" Margin="0,6,0,0"
                                                       Text="{Binding Content}"
                                                       FontSize="{DynamicResource Fs12}"
                                                       TextWrapping="Wrap"
                                                       LineStackingStrategy="BlockLineHeight"
                                                       LineHeight="20">
                                                <TextBlock.Style>
                                                    <Style TargetType="TextBlock">
                                                        <Setter Property="Foreground" Value="{DynamicResource TextBrush}"/>
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding Role}" Value="user">
                                                                <Setter Property="Foreground" Value="White"/>
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </TextBlock.Style>
                                            </TextBlock>
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>

                    <!-- Empty / fallback hook data view -->
                    <ScrollViewer x:Name="FallbackScrollViewer"
                                  Visibility="Visible"
                                  VerticalScrollBarVisibility="Auto"
                                  Padding="28,20,28,20">
                        <StackPanel>
                            <!-- No transcript notice -->
                            <Border CornerRadius="8"
                                    Background="{DynamicResource PanelSoftBrush}"
                                    Padding="14,10" Margin="0,0,0,16">
                                <StackPanel>
                                    <TextBlock Text="대화 transcript 없음"
                                               FontSize="{DynamicResource Fs12}"
                                               FontWeight="SemiBold"
                                               Foreground="{DynamicResource TextMutedBrush}"/>
                                    <TextBlock Margin="0,4,0,0"
                                               FontSize="{DynamicResource Fs11}"
                                               Foreground="{DynamicResource TextMutedBrush}"
                                               TextWrapping="Wrap"
                                               Text="Claude Code가 DevezCode를 통해 실행될 때는 subagent 대화 transcript(.jsonl)가 생성되지 않습니다. 대신 훅 데이터를 표시합니다."/>
                                </StackPanel>
                            </Border>

                            <!-- Agent ID -->
                            <Border CornerRadius="6"
                                    Background="{DynamicResource PanelSoftBrush}"
                                    Padding="12,8" Margin="0,0,0,6">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="80"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="Agent ID"
                                               FontSize="{DynamicResource Fs11}"
                                               Foreground="{DynamicResource TextMutedBrush}"/>
                                    <TextBlock Grid.Column="1" x:Name="FallbackAgentId"
                                               FontSize="{DynamicResource Fs12}"
                                               Foreground="{DynamicResource TextBrush}"/>
                                </Grid>
                            </Border>

                            <!-- Agent Type -->
                            <Border CornerRadius="6"
                                    Background="{DynamicResource PanelSoftBrush}"
                                    Padding="12,8" Margin="0,0,0,6">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="80"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="Agent Type"
                                               FontSize="{DynamicResource Fs11}"
                                               Foreground="{DynamicResource TextMutedBrush}"/>
                                    <TextBlock Grid.Column="1" x:Name="FallbackAgentType"
                                               FontSize="{DynamicResource Fs12}"
                                               Foreground="{DynamicResource TextBrush}"/>
                                </Grid>
                            </Border>

                            <!-- Status -->
                            <Border CornerRadius="6"
                                    Background="{DynamicResource PanelSoftBrush}"
                                    Padding="12,8" Margin="0,0,0,6">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="80"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="Status"
                                               FontSize="{DynamicResource Fs11}"
                                               Foreground="{DynamicResource TextMutedBrush}"/>
                                    <TextBlock Grid.Column="1" x:Name="FallbackStatus"
                                               FontSize="{DynamicResource Fs12}"
                                               Foreground="{DynamicResource TextBrush}"/>
                                </Grid>
                            </Border>

                            <!-- Reason -->
                            <Border x:Name="FallbackReasonPanel" CornerRadius="6"
                                    Background="{DynamicResource PanelSoftBrush}"
                                    Padding="12,8" Margin="0,0,0,6"
                                    Visibility="Collapsed">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="80"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="사유"
                                               FontSize="{DynamicResource Fs11}"
                                               Foreground="{DynamicResource TextMutedBrush}"/>
                                    <TextBlock Grid.Column="1" x:Name="FallbackReason"
                                               FontSize="{DynamicResource Fs12}"
                                               Foreground="{DynamicResource TextBrush}"
                                               TextWrapping="Wrap"/>
                                </Grid>
                            </Border>

                            <!-- Tool call count -->
                            <Border CornerRadius="6"
                                    Background="{DynamicResource PanelSoftBrush}"
                                    Padding="12,8" Margin="0,0,0,6">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="80"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="Tool 호출"
                                               FontSize="{DynamicResource Fs11}"
                                               Foreground="{DynamicResource TextMutedBrush}"/>
                                    <TextBlock Grid.Column="1" x:Name="FallbackToolCalls"
                                               FontSize="{DynamicResource Fs12}"
                                               Foreground="{DynamicResource TextBrush}"/>
                                </Grid>
                            </Border>

                            <!-- Started / Ended -->
                            <Border CornerRadius="6"
                                    Background="{DynamicResource PanelSoftBrush}"
                                    Padding="12,8" Margin="0,0,0,6">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="80"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="시작"
                                               FontSize="{DynamicResource Fs11}"
                                               Foreground="{DynamicResource TextMutedBrush}"/>
                                    <TextBlock Grid.Column="1" x:Name="FallbackStarted"
                                               FontSize="{DynamicResource Fs12}"
                                               Foreground="{DynamicResource TextBrush}"/>
                                </Grid>
                            </Border>

                            <Border CornerRadius="6"
                                    Background="{DynamicResource PanelSoftBrush}"
                                    Padding="12,8" Margin="0,0,0,6">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="80"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="종료"
                                               FontSize="{DynamicResource Fs11}"
                                               Foreground="{DynamicResource TextMutedBrush}"/>
                                    <TextBlock Grid.Column="1" x:Name="FallbackEnded"
                                               FontSize="{DynamicResource Fs12}"
                                               Foreground="{DynamicResource TextBrush}"/>
                                </Grid>
                            </Border>

                            <!-- Prompt (full) -->
                            <Border CornerRadius="6"
                                    Background="{DynamicResource PanelSoftBrush}"
                                    Padding="12,8" Margin="0,0,0,6">
                                <Grid>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                    </Grid.RowDefinitions>
                                    <TextBlock Text="Prompt"
                                               FontSize="{DynamicResource Fs11}"
                                               Foreground="{DynamicResource TextMutedBrush}"
                                               Margin="0,0,0,6"/>
                                    <Border Grid.Row="1"
                                            Background="{DynamicResource BgBrush}"
                                            CornerRadius="6" Padding="10,8"
                                            BorderBrush="{DynamicResource LineBrush}"
                                            BorderThickness="1">
                                        <TextBlock x:Name="FallbackPrompt"
                                                   FontSize="{DynamicResource Fs11}"
                                                   Foreground="{DynamicResource TextBrush}"
                                                   TextWrapping="Wrap"
                                                   FontFamily="Cascadia Code, Consolas, monospace"/>
                                    </Border>
                                </Grid>
                            </Border>
                        </StackPanel>
                    </ScrollViewer>
                </Grid>

                <!-- Footer -->
                <Border Grid.Row="2"
                        Background="{DynamicResource PanelSoftBrush}"
                        BorderBrush="{DynamicResource LineBrush}"
                        BorderThickness="0,1,0,0"
                        CornerRadius="0,0,14,14">
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right"
                                Margin="20,10,20,10">
                        <Button x:Name="OpenAsFileBtn" Click="OpenAsFileBtn_Click"
                                MinWidth="100" Height="34" Padding="14,0"
                                Style="{StaticResource SecondaryButton}"
                                FontSize="{DynamicResource Fs12}" Margin="0,0,8,0">
                            <TextBlock Text="파일로 열기" TextTrimming="None"/>
                        </Button>
                        <Button Click="CloseBtn_Click"
                                MinWidth="80" Height="34" Padding="14,0"
                                Style="{StaticResource PrimaryButton}"
                                FontSize="{DynamicResource Fs12}">
                            <TextBlock Text="닫기" Foreground="White" TextTrimming="None"/>
                        </Button>
                    </StackPanel>
                </Border>
            </Grid>
        </Border>
    </Grid>
</Window>
