<UserControl x:Class="DevezCode.Views.MarkdownFileEditorView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:views="clr-namespace:DevezCode.Views"
             Background="{DynamicResource BgBrush}"
             ClipToBounds="True"
             UseLayoutRounding="True"
             FontFamily="{StaticResource PretendardFont}">

    <UserControl.Resources>
        <Style x:Key="HdrIconBtn" TargetType="Button">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="6,4"/>
            <Setter Property="Cursor" Value="Arrow"/>
            <Setter Property="IsTabStop" Value="False"/>
            <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd" Background="Transparent" CornerRadius="6" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource LineBrush}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsEnabled" Value="False">
                    <Setter Property="Opacity" Value="0.45"/>
                </Trigger>
            </Style.Triggers>
        </Style>
    </UserControl.Resources>

    <Border BorderBrush="{DynamicResource LineBrush}" BorderThickness="1,0,0,0">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="44"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <Border Grid.Row="0" Background="{DynamicResource PanelBrush}"
                    BorderBrush="{DynamicResource LineBrush}" BorderThickness="0,0,0,1">
                <Grid Margin="14,0,8,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <Grid Grid.Column="0" VerticalAlignment="Center" Margin="0,0,10,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <Path Grid.Column="0" Style="{StaticResource LucideIcon}" Data="{StaticResource IconFileText}"
                              Width="15" Height="15" VerticalAlignment="Center" Stroke="{DynamicResource TextMutedBrush}"/>
                        <TextBlock x:Name="FileNameText" Grid.Column="1" Margin="9,0,0,0" VerticalAlignment="Center"
                                   FontSize="{DynamicResource Fs13}" FontWeight="SemiBold"
                                   Foreground="{DynamicResource TextBrush}" TextTrimming="CharacterEllipsis"/>
                        <Ellipse x:Name="DirtyDot" Grid.Column="2" Width="7" Height="7" Margin="8,1,0,0"
                                 VerticalAlignment="Center" Visibility="Collapsed" Fill="{DynamicResource PrimaryBrush}"/>
                        <TextBlock x:Name="FilePathText" Grid.Column="3" Margin="12,0,0,0" VerticalAlignment="Center"
                                   FontSize="{DynamicResource Fs11}" Foreground="{DynamicResource TextMutedBrush}"
                                   TextTrimming="CharacterEllipsis"/>
                    </Grid>

                    <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center" HorizontalAlignment="Right">
                        <Button x:Name="SaveBtn" Click="SaveBtn_Click" IsEnabled="False" Style="{StaticResource HdrIconBtn}" ToolTip="저장 (Ctrl+S)">
                            <Path Style="{StaticResource LucideIcon}" Data="{StaticResource IconSave}"
                                  Width="13" Height="13" Stroke="{DynamicResource TextMutedBrush}"/>
                        </Button>
                        <Button x:Name="CloseBtn" Click="CloseBtn_Click" Margin="2,0,0,0" Style="{StaticResource HdrIconBtn}" ToolTip="닫기 (Esc)">
                            <Path Style="{StaticResource LucideIcon}" Data="{StaticResource IconX}"
                                  Width="13" Height="13" Stroke="{DynamicResource TextMutedBrush}"/>
                        </Button>
                    </StackPanel>
                </Grid>
            </Border>

            <Grid Grid.Row="1" Background="{DynamicResource BgBrush}">
                <views:MarkdownWysiwygHost x:Name="MdHost"/>
                <Border x:Name="LoadingOverlay" Background="{DynamicResource BgBrush}">
                    <TextBlock Text="마크다운 편집기를 준비 중입니다..." HorizontalAlignment="Center" VerticalAlignment="Center"
                               Foreground="{DynamicResource TextMutedBrush}" FontSize="{DynamicResource Fs13}"/>
                </Border>
            </Grid>
        </Grid>
    </Border>
</UserControl>
