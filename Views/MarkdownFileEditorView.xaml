<UserControl x:Class="DevezCode.Views.MarkdownFileEditorView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:views="clr-namespace:DevezCode.Views"
             xmlns:models="clr-namespace:DevezCode.Models"
             Background="{DynamicResource BgBrush}"
             ClipToBounds="True"
             UseLayoutRounding="True"
             FontFamily="{StaticResource PretendardFont}">

    <Border BorderBrush="{DynamicResource LineBrush}" BorderThickness="1,0,0,0">
        <Grid Background="{DynamicResource BgBrush}">
            <views:MarkdownWysiwygHost x:Name="MdHost"/>
            <Border x:Name="LoadingOverlay" Background="{DynamicResource BgBrush}">
                <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                    <Ellipse Width="36" Height="36" StrokeThickness="3"
                             Fill="Transparent"
                             Stroke="{DynamicResource PrimaryBrush}"
                             StrokeDashArray="28 10"
                             HorizontalAlignment="Center"
                             models:SpinnerActivator.Track="True"
                             RenderTransformOrigin="0.5,0.5">
                        <Ellipse.RenderTransform>
                            <RotateTransform Angle="{Binding Angle, Source={x:Static models:SpinnerSync.Instance}}"/>
                        </Ellipse.RenderTransform>
                    </Ellipse>
                    <TextBlock Text="마크다운 편집기를 준비 중입니다..." Margin="0,14,0,0"
                               HorizontalAlignment="Center"
                               Foreground="{DynamicResource TextMutedBrush}" FontSize="{DynamicResource Fs13}"/>
                </StackPanel>
            </Border>
        </Grid>
    </Border>
</UserControl>
