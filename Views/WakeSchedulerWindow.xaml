<Window x:Class="DevezCode.Views.WakeSchedulerWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:models="clr-namespace:DevezCode.Models"
        Title="루틴" Width="760" Height="600"
        WindowStartupLocation="CenterOwner" WindowStyle="None" ResizeMode="NoResize"
        AllowsTransparency="True" Background="Transparent" ShowInTaskbar="False"
        FontFamily="{StaticResource PretendardFont}"
        UseLayoutRounding="True" SnapsToDevicePixels="True"
        TextOptions.TextFormattingMode="Display" TextOptions.TextRenderingMode="ClearType">
    <Window.Resources>
        <Style x:Key="WakeSectionLabel" TargetType="TextBlock"
               BasedOn="{StaticResource {x:Type TextBlock}}">
            <Setter Property="FontSize" Value="{DynamicResource Fs12}"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="{DynamicResource TextMutedBrush}"/>
            <Setter Property="Margin" Value="0,0,0,8"/>
        </Style>

        <!-- 설정창 FormFieldBox 정합: 높이 38·라운드 10·1.5 라인, 포커스 시 Primary 테두리 -->
        <Style x:Key="WakeFieldBorder" TargetType="Border">
            <Setter Property="BorderBrush" Value="{DynamicResource LineBrush}"/>
            <Setter Property="BorderThickness" Value="1.5"/>
            <Setter Property="Background" Value="{DynamicResource PanelBrush}"/>
            <Setter Property="CornerRadius" Value="10"/>
            <Setter Property="Height" Value="38"/>
            <Style.Triggers>
                <Trigger Property="IsKeyboardFocusWithin" Value="True">
                    <Setter Property="BorderBrush" Value="{DynamicResource PrimaryBrush}"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="WakeDayToggle" TargetType="ToggleButton">
            <Setter Property="Focusable" Value="False"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Height" Value="34"/>
            <Setter Property="Margin" Value="0,0,6,0"/>
            <Setter Property="Foreground" Value="{DynamicResource TextMutedBrush}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ToggleButton">
                        <Border x:Name="DayChip" CornerRadius="8" BorderThickness="1"
                                BorderBrush="{DynamicResource LineBrush}"
                                Background="{DynamicResource PanelBrush}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="DayChip" Property="Background" Value="{DynamicResource PanelSoftBrush}"/>
                            </Trigger>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="DayChip" Property="Background" Value="{DynamicResource PrimarySoftBrush}"/>
                                <Setter TargetName="DayChip" Property="BorderBrush" Value="{DynamicResource PrimaryBrush}"/>
                                <Setter Property="Foreground" Value="{DynamicResource PrimaryBrush}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="WakeScheduleItem" TargetType="ListBoxItem">
            <Setter Property="Focusable" Value="False"/>
            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
            <Setter Property="Padding" Value="0"/>
            <Setter Property="Margin" Value="0,0,0,8"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ListBoxItem">
                        <Border x:Name="Card" CornerRadius="10" BorderThickness="1"
                                BorderBrush="{DynamicResource LineBrush}"
                                Background="{DynamicResource PanelBrush}"
                                Padding="12,11">
                            <ContentPresenter/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Card" Property="Background" Value="{DynamicResource PanelSoftBrush}"/>
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="Card" Property="BorderBrush" Value="{DynamicResource PrimaryBrush}"/>
                                <Setter TargetName="Card" Property="Background" Value="{DynamicResource PrimarySoftBrush}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid Margin="20">
        <Border Background="{DynamicResource BgBrush}" CornerRadius="14">
            <Border.Effect>
                <DropShadowEffect ShadowDepth="0" BlurRadius="40"
                                  Color="{DynamicResource ShadowColor}"
                                  Opacity="{DynamicResource ShadowOpacity}"/>
            </Border.Effect>
        </Border>

        <Border CornerRadius="14" ClipToBounds="True"
                Background="{DynamicResource BgBrush}"
                BorderBrush="{DynamicResource LineBrush}" BorderThickness="1">
            <Grid x:Name="RootContent">
                <Grid.RowDefinitions>
                    <RowDefinition Height="48"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <!-- Header: 설정창 정합 — PanelBrush 배경, 아이콘 없이 제목만, 닫기 40×32 -->
                <Border Grid.Row="0" Background="{DynamicResource PanelBrush}"
                        BorderBrush="{DynamicResource LineBrush}" BorderThickness="0,0,0,1"
                        MouseLeftButtonDown="Header_DragMove">
                    <Grid>
                        <TextBlock Text="루틴" VerticalAlignment="Center" Margin="16,0,0,0"
                                   FontSize="{DynamicResource Fs14}" FontWeight="SemiBold"
                                   Foreground="{DynamicResource TextBrush}"/>
                        <Button Click="Cancel_Click" HorizontalAlignment="Right" VerticalAlignment="Center"
                                Width="40" Height="32" Margin="0,0,8,0"
                                Style="{StaticResource WinCloseBtn}">
                            <TextBlock Text="&#x2715;" FontSize="{DynamicResource Fs11}"/>
                        </Button>
                    </Grid>
                </Border>

                <Grid Grid.Row="1">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="280"/>
                        <ColumnDefinition Width="1"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <Grid Grid.Column="0" Margin="18,18,16,16">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0" Margin="0,0,10,0">
                                <TextBlock Text="루틴 목록" FontSize="{DynamicResource Fs13}" FontWeight="SemiBold"
                                           Foreground="{DynamicResource TextBrush}"/>
                                <TextBlock Text="여러 시간대를 자유롭게 추가할 수 있어요"
                                           Margin="0,3,0,0" FontSize="{DynamicResource Fs11}"
                                           TextTrimming="CharacterEllipsis"
                                           Foreground="{DynamicResource TextMutedBrush}"/>
                            </StackPanel>
                            <Button Grid.Column="1" VerticalAlignment="Center"
                                    Click="Add_Click" Style="{StaticResource PrimaryButton}"
                                    Height="34" Padding="12,0">
                                <StackPanel Orientation="Horizontal">
                                    <Path Style="{StaticResource LucideIcon}" Data="{StaticResource IconPlus}"
                                          Width="14" Height="14" Stroke="White" Margin="0,0,6,0"/>
                                    <TextBlock Text="추가" Foreground="White" FontSize="{DynamicResource Fs12}"/>
                                </StackPanel>
                            </Button>
                        </Grid>

                        <ListBox x:Name="ScheduleList" Grid.Row="1" Margin="0,16,0,0"
                                 Background="Transparent" BorderThickness="0"
                                 ItemContainerStyle="{StaticResource WakeScheduleItem}"
                                 SelectionChanged="ScheduleList_SelectionChanged"
                                 ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                            <ListBox.ItemTemplate>
                                <DataTemplate>
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <Border Width="36" Height="36" CornerRadius="9"
                                                Background="{DynamicResource BgBrush}" VerticalAlignment="Center">
                                            <Image Width="22" Height="22"
                                                   Source="{Binding Provider, Converter={x:Static models:AgentImageConverter.Instance}}"
                                                   RenderOptions.BitmapScalingMode="HighQuality"/>
                                        </Border>
                                        <StackPanel Grid.Column="1" Margin="10,0,4,0" VerticalAlignment="Center">
                                            <TextBlock Text="{Binding ProviderDisplayName}" FontSize="{DynamicResource Fs13}"
                                                       FontWeight="SemiBold" Foreground="{DynamicResource TextBrush}"
                                                       TextTrimming="CharacterEllipsis"/>
                                            <TextBlock Text="{Binding ScheduleSummary}" Margin="0,3,0,0"
                                                       FontSize="{DynamicResource Fs11}"
                                                       Foreground="{DynamicResource TextMutedBrush}"
                                                       TextTrimming="CharacterEllipsis"/>
                                        </StackPanel>
                                        <Ellipse Grid.Column="2" Width="7" Height="7" VerticalAlignment="Center">
                                            <Ellipse.Style>
                                                <Style TargetType="Ellipse">
                                                    <Setter Property="Fill" Value="{DynamicResource PrimaryBrush}"/>
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding Enabled}" Value="False">
                                                            <Setter Property="Fill" Value="{DynamicResource TextMutedBrush}"/>
                                                            <Setter Property="Opacity" Value="0.45"/>
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </Ellipse.Style>
                                        </Ellipse>
                                    </Grid>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>

                        <Border x:Name="EmptyHint" Grid.Row="2" Margin="0,12,0,0" Padding="10,8" CornerRadius="8"
                                Background="{DynamicResource PanelSoftBrush}">
                            <TextBlock Text="목록이 비어 있으면 위의 추가 버튼을 눌러 시작하세요."
                                       TextWrapping="Wrap" FontSize="{DynamicResource Fs10}"
                                       Foreground="{DynamicResource TextMutedBrush}"/>
                        </Border>
                    </Grid>

                    <Border Grid.Column="1" Background="{DynamicResource LineBrush}"/>

                    <ScrollViewer x:Name="EditorPanel" Grid.Column="2" VerticalScrollBarVisibility="Auto">
                        <StackPanel Margin="24,20,24,18">
                            <Grid Margin="0,0,0,20">
                                <StackPanel>
                                    <TextBlock Text="일정 설정" FontSize="{DynamicResource Fs15}" FontWeight="SemiBold"
                                               Foreground="{DynamicResource TextBrush}"/>
                                    <TextBlock Text="선택한 루틴의 실행 조건을 설정하세요"
                                               Margin="0,4,0,0" FontSize="{DynamicResource Fs11}"
                                               Foreground="{DynamicResource TextMutedBrush}"/>
                                </StackPanel>
                                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                                    <TextBlock Text="사용" Margin="0,0,9,0" VerticalAlignment="Center"
                                               FontSize="{DynamicResource Fs12}" Foreground="{DynamicResource TextBrush}"/>
                                    <CheckBox x:Name="EnabledToggle" Style="{StaticResource ToggleSwitchSmall}" IsChecked="True"
                                              Checked="EnabledToggle_Changed" Unchecked="EnabledToggle_Changed"/>
                                </StackPanel>
                            </Grid>

                            <TextBlock Text="에이전트" Style="{StaticResource WakeSectionLabel}"/>
                            <Border Style="{StaticResource WakeFieldBorder}" Padding="10,0">
                                <ComboBox x:Name="ProviderCombo" BorderThickness="0" Background="Transparent"
                                          Foreground="{DynamicResource TextBrush}" VerticalContentAlignment="Center">
                                    <ComboBox.ItemTemplate>
                                        <DataTemplate>
                                            <StackPanel Orientation="Horizontal">
                                                <Image Width="20" Height="20" Margin="0,0,9,0"
                                                       Source="{Binding Converter={x:Static models:AgentImageConverter.Instance}}"/>
                                                <TextBlock x:Name="ProviderName" VerticalAlignment="Center"
                                                           Foreground="{DynamicResource TextBrush}">
                                                    <TextBlock.Style>
                                                        <Style TargetType="TextBlock" BasedOn="{StaticResource {x:Type TextBlock}}">
                                                            <Setter Property="Text" Value="{Binding}"/>
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding}" Value="claude">
                                                                    <Setter Property="Text" Value="Claude"/>
                                                                </DataTrigger>
                                                                <DataTrigger Binding="{Binding}" Value="codex">
                                                                    <Setter Property="Text" Value="Codex"/>
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </TextBlock.Style>
                                                </TextBlock>
                                            </StackPanel>
                                        </DataTemplate>
                                    </ComboBox.ItemTemplate>
                                </ComboBox>
                            </Border>

                            <TextBlock Text="요일" Style="{StaticResource WakeSectionLabel}" Margin="0,20,0,8"/>
                            <UniformGrid Columns="7">
                                <ToggleButton x:Name="Mon" Content="월" Style="{StaticResource WakeDayToggle}"/>
                                <ToggleButton x:Name="Tue" Content="화" Style="{StaticResource WakeDayToggle}"/>
                                <ToggleButton x:Name="Wed" Content="수" Style="{StaticResource WakeDayToggle}"/>
                                <ToggleButton x:Name="Thu" Content="목" Style="{StaticResource WakeDayToggle}"/>
                                <ToggleButton x:Name="Fri" Content="금" Style="{StaticResource WakeDayToggle}"/>
                                <ToggleButton x:Name="Sat" Content="토" Style="{StaticResource WakeDayToggle}"/>
                                <ToggleButton x:Name="Sun" Content="일" Style="{StaticResource WakeDayToggle}" Margin="0"/>
                            </UniformGrid>

                            <TextBlock Text="시간" Style="{StaticResource WakeSectionLabel}" Margin="0,20,0,8"/>
                            <Border Style="{StaticResource WakeFieldBorder}">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="42"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <Path Style="{StaticResource LucideIcon}" Data="{StaticResource IconClock}"
                                          Width="16" Height="16" Stroke="{DynamicResource TextMutedBrush}"/>
                                    <TextBox x:Name="TimeBox" Grid.Column="1" Text="09:00"
                                             BorderThickness="0" Background="Transparent" Padding="0"
                                             FontSize="{DynamicResource Fs14}" FontWeight="SemiBold"
                                             Foreground="{DynamicResource TextBrush}" CaretBrush="{DynamicResource TextBrush}"
                                             VerticalContentAlignment="Center"/>
                                    <TextBlock Grid.Column="2" Text="24시간" Margin="0,0,12,0" VerticalAlignment="Center"
                                               FontSize="{DynamicResource Fs10}" Foreground="{DynamicResource TextMutedBrush}"/>
                                </Grid>
                            </Border>

                            <Border Margin="0,22,0,0" Padding="14,12" CornerRadius="10"
                                    BorderBrush="{DynamicResource LineBrush}" BorderThickness="1"
                                    Background="{DynamicResource PanelSoftBrush}">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <Border Width="32" Height="32" CornerRadius="8"
                                            Background="{DynamicResource BgBrush}" VerticalAlignment="Top">
                                        <Path Style="{StaticResource LucideIcon}" Data="{StaticResource IconCheck}"
                                              Width="15" Height="15" Stroke="{DynamicResource TextMutedBrush}"/>
                                    </Border>
                                    <StackPanel Grid.Column="1" Margin="10,0,0,0">
                                        <TextBlock Text="최근 실행 상태" FontSize="{DynamicResource Fs11}"
                                                   Foreground="{DynamicResource TextMutedBrush}"/>
                                        <TextBlock x:Name="LastStatus" Text="아직 실행 기록이 없습니다"
                                                   Margin="0,4,0,0" TextWrapping="Wrap"
                                                   FontSize="{DynamicResource Fs12}" Foreground="{DynamicResource TextBrush}"/>
                                    </StackPanel>
                                </Grid>
                            </Border>

                            <Button x:Name="DeleteButton" Click="Delete_Click" Margin="0,18,0,0"
                                    HorizontalAlignment="Left" Height="34" Padding="12,0"
                                    Style="{StaticResource SecondaryButton}">
                                <StackPanel Orientation="Horizontal">
                                    <Path Style="{StaticResource LucideIcon}" Data="{StaticResource IconTrash2}"
                                          Width="14" Height="14" Margin="0,0,7,0"
                                          Stroke="{DynamicResource DangerBrush}"/>
                                    <TextBlock Text="이 루틴 삭제" FontSize="{DynamicResource Fs11}"
                                               Foreground="{DynamicResource DangerBrush}"/>
                                </StackPanel>
                            </Button>
                        </StackPanel>
                    </ScrollViewer>
                </Grid>

                <Border Grid.Row="2" Background="{DynamicResource PanelSoftBrush}"
                        BorderBrush="{DynamicResource LineBrush}" BorderThickness="0,1,0,0">
                    <Grid Margin="20,14">
                        <TextBlock Text="예약 시간에는 DevezCode가 실행 중이어야 합니다"
                                   VerticalAlignment="Center" FontSize="{DynamicResource Fs10}"
                                   Foreground="{DynamicResource TextMutedBrush}"/>
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                            <Button Content="취소" Click="Cancel_Click" Width="100" Height="38"
                                    Style="{StaticResource SecondaryButton}" FontSize="{DynamicResource Fs13}"
                                    Margin="0,0,8,0"/>
                            <Button Content="저장" Click="Save_Click" Width="100" Height="38"
                                    Style="{StaticResource PrimaryButton}" FontSize="{DynamicResource Fs13}"/>
                        </StackPanel>
                    </Grid>
                </Border>
            </Grid>
        </Border>
    </Grid>
</Window>
