<Window x:Class="DevezCode.Views.WakeSchedulerWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:models="clr-namespace:DevezCode.Models"
        Title="깨우기" Width="720" Height="520"
        WindowStartupLocation="CenterOwner" WindowStyle="None" ResizeMode="NoResize"
        AllowsTransparency="True" Background="Transparent" ShowInTaskbar="False"
        FontFamily="{StaticResource PretendardFont}"
        UseLayoutRounding="True" SnapsToDevicePixels="True"
        TextOptions.TextFormattingMode="Display" TextOptions.TextRenderingMode="ClearType">
    <Window.Resources>
        <Style x:Key="WakeSectionLabel" TargetType="TextBlock"
               BasedOn="{StaticResource {x:Type TextBlock}}">
            <Setter Property="FontSize" Value="{DynamicResource Fs12}"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="{DynamicResource TextMutedBrush}"/>
            <Setter Property="Margin" Value="0,0,0,8"/>
        </Style>

        <Style x:Key="WakeFieldBorder" TargetType="Border">
            <Setter Property="BorderBrush" Value="{DynamicResource LineBrush}"/>
            <Setter Property="BorderThickness" Value="1.5"/>
            <Setter Property="Background" Value="{DynamicResource PanelBrush}"/>
            <Setter Property="CornerRadius" Value="10"/>
            <Setter Property="Height" Value="40"/>
            <Style.Triggers>
                <Trigger Property="IsKeyboardFocusWithin" Value="True">
                    <Setter Property="BorderBrush" Value="{DynamicResource PrimaryBrush}"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <!-- 설정창 왼쪽 카테고리와 같은 단일 선택 행 -->
        <Style x:Key="WakeAgentItem" TargetType="ListBoxItem">
            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
            <Setter Property="Padding" Value="0"/>
            <Setter Property="Margin" Value="0,0,0,4"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ListBoxItem">
                        <Border x:Name="ItemBackground" CornerRadius="8" Padding="10,9"
                                Background="Transparent">
                            <ContentPresenter/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="ItemBackground" Property="Background"
                                        Value="{DynamicResource PanelBrush}"/>
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="ItemBackground" Property="Background"
                                        Value="{DynamicResource PrimarySoftBrush}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid Margin="20">
        <Border Background="{DynamicResource BgBrush}" CornerRadius="14">
            <Border.Effect>
                <DropShadowEffect ShadowDepth="0" BlurRadius="40"
                                  Color="{DynamicResource ShadowColor}"
                                  Opacity="{DynamicResource ShadowOpacity}"/>
            </Border.Effect>
        </Border>

        <Border CornerRadius="14" ClipToBounds="True"
                Background="{DynamicResource BgBrush}"
                BorderBrush="{DynamicResource LineBrush}" BorderThickness="1">
            <Grid x:Name="RootContent">
                <Grid.RowDefinitions>
                    <RowDefinition Height="48"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <Border Grid.Row="0" Background="{DynamicResource PanelBrush}"
                        BorderBrush="{DynamicResource LineBrush}" BorderThickness="0,0,0,1"
                        MouseLeftButtonDown="Header_DragMove">
                    <Grid>
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="16,0,0,0">
                            <Path Style="{StaticResource LucideIcon}"
                                  Data="{StaticResource IconAlarmClock}"
                                  Width="16" Height="16" VerticalAlignment="Center"
                                  Stroke="{DynamicResource TextBrush}"
                                  Margin="0,-1,11,0"/>
                            <TextBlock Text="깨우기" VerticalAlignment="Center"
                                       FontSize="{DynamicResource Fs14}" FontWeight="SemiBold"
                                       Foreground="{DynamicResource TextBrush}"/>
                        </StackPanel>
                        <Button Click="Cancel_Click" HorizontalAlignment="Right" VerticalAlignment="Center"
                                Width="40" Height="32" Margin="0,0,8,0"
                                Style="{StaticResource WinCloseBtn}">
                            <TextBlock Text="&#x2715;" FontSize="{DynamicResource Fs11}"/>
                        </Button>
                    </Grid>
                </Border>

                <Grid Grid.Row="1">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="220"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <Border Grid.Column="0" Background="{DynamicResource PanelSoftBrush}"
                            BorderBrush="{DynamicResource LineBrush}" BorderThickness="0,0,1,0">
                        <Grid Margin="10,16">
                            <Grid>
                                <ListBox x:Name="AgentList" Background="Transparent" BorderThickness="0"
                                         ItemContainerStyle="{StaticResource WakeAgentItem}"
                                         SelectionChanged="AgentList_SelectionChanged"
                                         ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                                    <ListBox.ItemTemplate>
                                        <DataTemplate>
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="Auto"/>
                                                    <ColumnDefinition Width="*"/>
                                                </Grid.ColumnDefinitions>
                                                <Image Width="24" Height="24" VerticalAlignment="Center"
                                                       Source="{Binding Id, Converter={x:Static models:AgentImageConverter.Instance}}"
                                                       RenderOptions.BitmapScalingMode="HighQuality"/>
                                                <StackPanel Grid.Column="1" Margin="10,0,0,0" VerticalAlignment="Center">
                                                    <TextBlock Text="{Binding DisplayName}" FontSize="{DynamicResource Fs12}"
                                                               FontWeight="SemiBold" Foreground="{DynamicResource TextBrush}"
                                                               TextTrimming="CharacterEllipsis"/>
                                                    <TextBlock Text="{Binding Provider}" Margin="0,2,0,0"
                                                               FontSize="{DynamicResource Fs10}"
                                                               Foreground="{DynamicResource TextMutedBrush}"/>
                                                </StackPanel>
                                            </Grid>
                                        </DataTemplate>
                                    </ListBox.ItemTemplate>
                                </ListBox>

                                <TextBlock x:Name="EmptyHint"
                                           Text="설정에서 Claude 또는 Codex를 사용으로 켜면 여기에 표시됩니다."
                                           Margin="8,8" TextWrapping="Wrap" FontSize="{DynamicResource Fs10}"
                                           Foreground="{DynamicResource TextMutedBrush}"
                                           Visibility="Collapsed"/>
                            </Grid>
                        </Grid>
                    </Border>

                    <ScrollViewer x:Name="EditorPanel" Grid.Column="1" VerticalScrollBarVisibility="Auto">
                        <StackPanel Margin="26,22,26,20">
                            <Grid Margin="0,0,0,22">
                                <StackPanel>
                                    <TextBlock Text="{Binding DisplayName}" FontSize="{DynamicResource Fs15}"
                                               FontWeight="SemiBold" Foreground="{DynamicResource TextBrush}"/>
                                    <TextBlock Text="정해진 시간에 고정 메시지를 한 번 보냅니다"
                                               Margin="0,4,0,0" FontSize="{DynamicResource Fs11}"
                                               Foreground="{DynamicResource TextMutedBrush}"/>
                                </StackPanel>
                                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                                    <TextBlock Text="깨우기 사용" Margin="0,0,9,0" VerticalAlignment="Center"
                                               FontSize="{DynamicResource Fs12}" Foreground="{DynamicResource TextBrush}"/>
                                    <CheckBox x:Name="EnabledToggle" Style="{StaticResource ToggleSwitchSmall}"
                                              IsChecked="True"/>
                                </StackPanel>
                            </Grid>

                            <TextBlock Text="시간" Style="{StaticResource WakeSectionLabel}"/>
                            <Border Style="{StaticResource WakeFieldBorder}">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="42"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <Path Style="{StaticResource LucideIcon}" Data="{StaticResource IconClock}"
                                          Width="16" Height="16" Stroke="{DynamicResource TextMutedBrush}"/>
                                    <TextBox x:Name="TimeBox" Grid.Column="1" Text="09:00"
                                             BorderThickness="0" Background="Transparent" Padding="0"
                                             FontSize="{DynamicResource Fs14}" FontWeight="SemiBold"
                                             Foreground="{DynamicResource TextBrush}" CaretBrush="{DynamicResource TextBrush}"
                                             VerticalContentAlignment="Center"/>
                                    <TextBlock Grid.Column="2" Text="24시간" Margin="0,0,12,0" VerticalAlignment="Center"
                                               FontSize="{DynamicResource Fs10}" Foreground="{DynamicResource TextMutedBrush}"/>
                                </Grid>
                            </Border>

                            <Border Margin="0,22,0,0" Padding="14,12" CornerRadius="10"
                                    BorderBrush="{DynamicResource LineBrush}" BorderThickness="1"
                                    Background="{DynamicResource PanelSoftBrush}">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <Path Style="{StaticResource LucideIcon}" Data="{StaticResource IconCheck}"
                                          Width="15" Height="15" Margin="2,2,11,0" VerticalAlignment="Top"
                                          Stroke="{DynamicResource TextMutedBrush}"/>
                                    <StackPanel Grid.Column="1">
                                        <TextBlock Text="최근 실행 상태" FontSize="{DynamicResource Fs11}"
                                                   Foreground="{DynamicResource TextMutedBrush}"/>
                                        <TextBlock x:Name="LastStatus" Text="아직 실행 기록이 없습니다"
                                                   Margin="0,4,0,0" TextWrapping="Wrap"
                                                   FontSize="{DynamicResource Fs12}" Foreground="{DynamicResource TextBrush}"/>
                                    </StackPanel>
                                </Grid>
                            </Border>
                        </StackPanel>
                    </ScrollViewer>
                </Grid>

                <Border Grid.Row="2" Background="{DynamicResource PanelSoftBrush}"
                        BorderBrush="{DynamicResource LineBrush}" BorderThickness="0,1,0,0">
                    <Grid Margin="20,14">
                        <TextBlock Text="예약 시간에는 DevezCode가 실행 중이어야 합니다"
                                   VerticalAlignment="Center" FontSize="{DynamicResource Fs10}"
                                   Foreground="{DynamicResource TextMutedBrush}"/>
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                            <Button Content="취소" Click="Cancel_Click" Width="100" Height="38"
                                    Style="{StaticResource SecondaryButton}" FontSize="{DynamicResource Fs13}"
                                    Margin="0,0,8,0"/>
                            <Button Content="저장" Click="Save_Click" Width="100" Height="38"
                                    Style="{StaticResource PrimaryButton}" FontSize="{DynamicResource Fs13}"/>
                        </StackPanel>
                    </Grid>
                </Border>
            </Grid>
        </Border>
    </Grid>
</Window>
