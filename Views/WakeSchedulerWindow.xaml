<Window x:Class="DevezCode.Views.WakeSchedulerWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="깨우기" Width="620" Height="560" WindowStartupLocation="CenterOwner"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent" ShowInTaskbar="False"
        FontFamily="{StaticResource PretendardFont}" UseLayoutRounding="True">
    <Grid Margin="18">
        <Border Background="{DynamicResource BgBrush}" BorderBrush="{DynamicResource LineBrush}" BorderThickness="1" CornerRadius="14">
            <Border.Effect><DropShadowEffect ShadowDepth="0" BlurRadius="30" Color="{DynamicResource ShadowColor}" Opacity="{DynamicResource ShadowOpacity}"/></Border.Effect>
            <Grid>
                <Grid.RowDefinitions><RowDefinition Height="52"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                <Border Grid.Row="0" BorderBrush="{DynamicResource LineBrush}" BorderThickness="0,0,0,1" MouseLeftButtonDown="Header_DragMove">
                    <DockPanel Margin="20,0">
                        <Button DockPanel.Dock="Right" Click="Cancel_Click" Style="{StaticResource WinCloseBtn}" Width="34" Height="30"><TextBlock Text="&#x2715;"/></Button>
                        <TextBlock Text="깨우기" VerticalAlignment="Center" FontSize="{DynamicResource Fs15}" FontWeight="SemiBold" Foreground="{DynamicResource TextBrush}"/>
                    </DockPanel>
                </Border>
                <Grid Grid.Row="1" Margin="20,16">
                    <Grid.ColumnDefinitions><ColumnDefinition Width="230"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                    <Grid Grid.Column="0" Margin="0,0,14,0">
                        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
                        <Button Grid.Row="0" Content="깨우기 추가" Click="Add_Click" Height="36" Style="{StaticResource PrimaryButton}"/>
                        <ListBox x:Name="ScheduleList" Grid.Row="1" Margin="0,12,0,0" Background="Transparent" BorderThickness="0" SelectionChanged="ScheduleList_SelectionChanged">
                            <ListBox.ItemTemplate>
                                <DataTemplate>
                                    <Border Padding="8" Margin="0,0,0,4" Background="{DynamicResource PanelBrush}" CornerRadius="6">
                                        <StackPanel>
                                            <TextBlock Text="{Binding Provider}" Foreground="{DynamicResource TextBrush}" FontWeight="SemiBold"/>
                                            <TextBlock Text="{Binding Time}" Foreground="{DynamicResource TextMutedBrush}" FontSize="{DynamicResource Fs12}"/>
                                            <TextBlock Text="{Binding LastResult}" Foreground="{DynamicResource TextMutedBrush}" FontSize="{DynamicResource Fs11}"/>
                                        </StackPanel>
                                    </Border>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>
                    </Grid>
                    <ScrollViewer Grid.Column="1" VerticalScrollBarVisibility="Auto">
                        <StackPanel>
                            <TextBlock Text="제공자" Foreground="{DynamicResource TextMutedBrush}" FontSize="{DynamicResource Fs13}" Margin="0,0,0,6"/>
                            <ComboBox x:Name="ProviderCombo" Height="36"
                                      Background="{DynamicResource PanelBrush}" Foreground="{DynamicResource TextBrush}"/>
                            <TextBlock Text="요일" Foreground="{DynamicResource TextMutedBrush}" FontSize="{DynamicResource Fs13}" Margin="0,16,0,6"/>
                            <UniformGrid Columns="4">
                                <ToggleButton x:Name="Mon" Content="월" Margin="0,0,4,4"/>
                                <ToggleButton x:Name="Tue" Content="화" Margin="0,0,4,4"/>
                                <ToggleButton x:Name="Wed" Content="수" Margin="0,0,4,4"/>
                                <ToggleButton x:Name="Thu" Content="목" Margin="0,0,0,4"/>
                                <ToggleButton x:Name="Fri" Content="금" Margin="0,0,4,0"/>
                                <ToggleButton x:Name="Sat" Content="토" Margin="0,0,4,0"/>
                                <ToggleButton x:Name="Sun" Content="일" Margin="0,0,4,0"/>
                            </UniformGrid>
                            <TextBlock Text="시간 (24시간)" Foreground="{DynamicResource TextMutedBrush}" FontSize="{DynamicResource Fs13}" Margin="0,16,0,6"/>
                            <TextBox x:Name="TimeBox" Height="36" Text="09:00" Padding="10,0" VerticalContentAlignment="Center"/>
                            <CheckBox x:Name="EnabledToggle" Content="사용" IsChecked="True" Margin="0,16,0,0" Foreground="{DynamicResource TextBrush}"/>
                            <TextBlock Text="최근 상태" Foreground="{DynamicResource TextMutedBrush}" FontSize="{DynamicResource Fs13}" Margin="0,16,0,4"/>
                            <TextBlock x:Name="LastStatus" Text="-" Foreground="{DynamicResource TextBrush}" TextWrapping="Wrap"/>
                            <Button x:Name="DeleteButton" Content="삭제" Click="Delete_Click" Width="80" Height="32" HorizontalAlignment="Left" Margin="0,20,0,0" Style="{StaticResource SecondaryButton}"/>
                        </StackPanel>
                    </ScrollViewer>
                </Grid>
                <Border Grid.Row="2" Background="{DynamicResource PanelSoftBrush}" BorderBrush="{DynamicResource LineBrush}" BorderThickness="0,1,0,0" CornerRadius="0,0,14,14">
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="20,12">
                        <Button Content="취소" Click="Cancel_Click" Width="92" Height="36" Style="{StaticResource SecondaryButton}" Margin="0,0,8,0"/>
                        <Button Content="저장" Click="Save_Click" Width="92" Height="36" Style="{StaticResource PrimaryButton}"/>
                    </StackPanel>
                </Border>
            </Grid>
        </Border>
    </Grid>
</Window>
