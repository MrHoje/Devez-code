<Window x:Class="DevezCode.Views.WakeSchedulerWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:models="clr-namespace:DevezCode.Models"
        Title="깨우기" Width="720" Height="520"
        WindowStartupLocation="CenterOwner" WindowStyle="None" ResizeMode="NoResize"
        AllowsTransparency="True" Background="Transparent" ShowInTaskbar="False"
        FontFamily="{StaticResource PretendardFont}"
        UseLayoutRounding="True" SnapsToDevicePixels="True"
        TextOptions.TextFormattingMode="Display" TextOptions.TextRenderingMode="ClearType">
    <Window.Resources>
        <Style x:Key="WakeSectionLabel" TargetType="TextBlock"
               BasedOn="{StaticResource {x:Type TextBlock}}">
            <Setter Property="FontSize" Value="{DynamicResource Fs12}"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="{DynamicResource TextMutedBrush}"/>
            <Setter Property="Margin" Value="0,0,0,8"/>
        </Style>

        <Style x:Key="WakeDayToggle" TargetType="ToggleButton">
            <Setter Property="Focusable" Value="False"/>
            <Setter Property="Height" Value="34"/>
            <Setter Property="Margin" Value="0,0,6,0"/>
            <Setter Property="Foreground" Value="{DynamicResource TextMutedBrush}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ToggleButton">
                        <Border x:Name="DayChip" CornerRadius="8" BorderThickness="1"
                                BorderBrush="{DynamicResource LineBrush}"
                                Background="{DynamicResource PanelBrush}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="DayChip" Property="Background" Value="{DynamicResource PanelSoftBrush}"/>
                            </Trigger>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="DayChip" Property="Background" Value="{DynamicResource PrimarySoftBrush}"/>
                                <Setter TargetName="DayChip" Property="BorderBrush" Value="{DynamicResource PrimaryBrush}"/>
                                <Setter Property="Foreground" Value="{DynamicResource PrimaryBrush}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="ThemedComboItem" TargetType="ComboBoxItem">
            <Setter Property="Foreground" Value="{DynamicResource TextBrush}"/>
            <Setter Property="FontSize" Value="{DynamicResource Fs13}"/>
            <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ComboBoxItem">
                        <Border x:Name="Bd" Background="Transparent" CornerRadius="6"
                                Padding="12,8" Margin="3,1">
                            <ContentPresenter/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsHighlighted" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource PanelSoftBrush}"/>
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource PrimarySoftBrush}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- devez 일정 추가 팝업과 동일한 직접 입력 + 드롭다운 시간 콤보 -->
        <Style x:Key="EditableTimeCombo" TargetType="ComboBox">
            <Setter Property="Foreground" Value="{DynamicResource TextBrush}"/>
            <Setter Property="FontFamily" Value="{StaticResource PretendardFont}"/>
            <Setter Property="FontSize" Value="{DynamicResource Fs13}"/>
            <Setter Property="Height" Value="40"/>
            <Setter Property="IsEditable" Value="True"/>
            <Setter Property="IsTextSearchEnabled" Value="True"/>
            <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
            <Setter Property="ItemContainerStyle" Value="{StaticResource ThemedComboItem}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ComboBox">
                        <Border CornerRadius="10" BorderThickness="1"
                                BorderBrush="{DynamicResource LineBrush}"
                                Background="{DynamicResource PanelBrush}">
                            <Grid>
                                <Path HorizontalAlignment="Left" VerticalAlignment="Center"
                                      Margin="14,0,0,0" IsHitTestVisible="False"
                                      Data="{StaticResource IconClock}"
                                      Stroke="{DynamicResource TextMutedBrush}" StrokeThickness="1.5"
                                      StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round"
                                      Width="14" Height="14" Stretch="Uniform" Fill="Transparent"/>
                                <TextBox x:Name="PART_EditableTextBox"
                                         Margin="36,0,36,0" VerticalAlignment="Center"
                                         Background="Transparent" BorderThickness="0"
                                         Foreground="{DynamicResource TextBrush}"
                                         CaretBrush="{DynamicResource TextBrush}"
                                         FontSize="{DynamicResource Fs13}" FontFamily="{StaticResource PretendardFont}"
                                         TextOptions.TextFormattingMode="Ideal"
                                         TextOptions.TextRenderingMode="ClearType"
                                         FocusVisualStyle="{x:Null}"
                                         IsReadOnly="{TemplateBinding IsReadOnly}"/>
                                <ToggleButton x:Name="PART_ToggleButton"
                                              HorizontalAlignment="Right" Width="36"
                                              Focusable="False" ClickMode="Press"
                                              IsChecked="{Binding IsDropDownOpen, Mode=TwoWay, RelativeSource={RelativeSource TemplatedParent}}">
                                    <ToggleButton.Template>
                                        <ControlTemplate TargetType="ToggleButton">
                                            <Border Background="Transparent">
                                                <Path Data="{StaticResource IconChevronDown}"
                                                      Stroke="{DynamicResource TextMutedBrush}" StrokeThickness="2"
                                                      StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round"
                                                      Width="12" Height="12" Stretch="Uniform" Fill="Transparent"
                                                      HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                            </Border>
                                        </ControlTemplate>
                                    </ToggleButton.Template>
                                </ToggleButton>
                                <Popup x:Name="PART_Popup" Placement="Bottom" VerticalOffset="3"
                                       IsOpen="{TemplateBinding IsDropDownOpen}"
                                       AllowsTransparency="True" Focusable="False">
                                    <Border Background="{DynamicResource PanelBrush}"
                                            BorderBrush="{DynamicResource LineBrush}" BorderThickness="1"
                                            CornerRadius="8" SnapsToDevicePixels="True"
                                            MinWidth="{Binding ActualWidth, RelativeSource={RelativeSource AncestorType=ComboBox}}">
                                        <ScrollViewer MaxHeight="200" Background="Transparent" Margin="3">
                                            <ItemsPresenter/>
                                        </ScrollViewer>
                                    </Border>
                                </Popup>
                            </Grid>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- 설정창 왼쪽 카테고리와 같은 단일 선택 행 -->
        <Style x:Key="WakeAgentItem" TargetType="ListBoxItem">
            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
            <Setter Property="Padding" Value="0"/>
            <Setter Property="Margin" Value="0,0,0,4"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ListBoxItem">
                        <Border x:Name="ItemBackground" CornerRadius="8" Padding="10,9"
                                Background="Transparent">
                            <ContentPresenter/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="ItemBackground" Property="Background"
                                        Value="{DynamicResource PanelBrush}"/>
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="ItemBackground" Property="Background"
                                        Value="{DynamicResource PrimarySoftBrush}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid Margin="20">
        <Border Background="{DynamicResource BgBrush}" CornerRadius="14">
            <Border.Effect>
                <DropShadowEffect ShadowDepth="0" BlurRadius="40"
                                  Color="{DynamicResource ShadowColor}"
                                  Opacity="{DynamicResource ShadowOpacity}"/>
            </Border.Effect>
        </Border>

        <Border CornerRadius="14" ClipToBounds="True"
                Background="{DynamicResource BgBrush}"
                BorderBrush="{DynamicResource LineBrush}" BorderThickness="1">
            <Grid x:Name="RootContent">
                <Grid.RowDefinitions>
                    <RowDefinition Height="48"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <Border Grid.Row="0" Background="{DynamicResource PanelBrush}"
                        BorderBrush="{DynamicResource LineBrush}" BorderThickness="0,0,0,1"
                        MouseLeftButtonDown="Header_DragMove">
                    <Grid>
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="16,0,0,0">
                            <Path Style="{StaticResource LucideIcon}"
                                  Data="{StaticResource IconAlarmClock}"
                                  Width="16" Height="16" VerticalAlignment="Center"
                                  Stroke="{DynamicResource TextBrush}"
                                  Margin="0,-1,11,0"/>
                            <TextBlock Text="깨우기" VerticalAlignment="Center"
                                       FontSize="{DynamicResource Fs14}" FontWeight="SemiBold"
                                       Foreground="{DynamicResource TextBrush}"/>
                        </StackPanel>
                        <Button Click="Cancel_Click" HorizontalAlignment="Right" VerticalAlignment="Center"
                                Width="40" Height="32" Margin="0,0,8,0"
                                Style="{StaticResource WinCloseBtn}">
                            <TextBlock Text="&#x2715;" FontSize="{DynamicResource Fs11}"/>
                        </Button>
                    </Grid>
                </Border>

                <Grid Grid.Row="1">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="220"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <Border Grid.Column="0" Background="{DynamicResource PanelSoftBrush}"
                            BorderBrush="{DynamicResource LineBrush}" BorderThickness="0,0,1,0">
                        <Grid Margin="10,16">
                            <Grid>
                                <ListBox x:Name="AgentList" Background="Transparent" BorderThickness="0"
                                         ItemContainerStyle="{StaticResource WakeAgentItem}"
                                         SelectionChanged="AgentList_SelectionChanged"
                                         ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                                    <ListBox.ItemTemplate>
                                        <DataTemplate>
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="Auto"/>
                                                    <ColumnDefinition Width="*"/>
                                                </Grid.ColumnDefinitions>
                                                <Image Width="24" Height="24" VerticalAlignment="Center"
                                                       Source="{Binding Id, Converter={x:Static models:AgentImageConverter.Instance}}"
                                                       RenderOptions.BitmapScalingMode="HighQuality"/>
                                                <StackPanel Grid.Column="1" Margin="10,0,0,0" VerticalAlignment="Center">
                                                    <TextBlock Text="{Binding DisplayName}" FontSize="{DynamicResource Fs12}"
                                                               FontWeight="SemiBold" Foreground="{DynamicResource TextBrush}"
                                                               TextTrimming="CharacterEllipsis"/>
                                                    <TextBlock Text="{Binding Provider}" Margin="0,2,0,0"
                                                               FontSize="{DynamicResource Fs10}"
                                                               Foreground="{DynamicResource TextMutedBrush}"/>
                                                </StackPanel>
                                            </Grid>
                                        </DataTemplate>
                                    </ListBox.ItemTemplate>
                                </ListBox>

                                <TextBlock x:Name="EmptyHint"
                                           Text="설정에서 Claude 또는 Codex를 사용으로 켜면 여기에 표시됩니다."
                                           Margin="8,8" TextWrapping="Wrap" FontSize="{DynamicResource Fs10}"
                                           Foreground="{DynamicResource TextMutedBrush}"
                                           Visibility="Collapsed"/>
                            </Grid>
                        </Grid>
                    </Border>

                    <ScrollViewer x:Name="EditorPanel" Grid.Column="1" VerticalScrollBarVisibility="Auto">
                        <StackPanel Margin="26,22,26,20">
                            <Grid Margin="0,0,0,22">
                                <StackPanel>
                                    <TextBlock Text="{Binding DisplayName}" FontSize="{DynamicResource Fs15}"
                                               FontWeight="SemiBold" Foreground="{DynamicResource TextBrush}"/>
                                    <TextBlock Text="정해진 시간에 고정 메시지를 한 번 보냅니다"
                                               Margin="0,4,0,0" FontSize="{DynamicResource Fs11}"
                                               Foreground="{DynamicResource TextMutedBrush}"/>
                                </StackPanel>
                                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                                    <TextBlock Text="깨우기 사용" Margin="0,0,9,0" VerticalAlignment="Center"
                                               FontSize="{DynamicResource Fs12}" Foreground="{DynamicResource TextBrush}"/>
                                    <CheckBox x:Name="EnabledToggle" Style="{StaticResource ToggleSwitchSmall}"
                                              IsChecked="True" Click="EnabledToggle_Click"/>
                                </StackPanel>
                            </Grid>

                            <TextBlock Text="요일" Style="{StaticResource WakeSectionLabel}"/>
                            <UniformGrid Columns="7">
                                <ToggleButton x:Name="Mon" Content="월" IsChecked="True" Style="{StaticResource WakeDayToggle}"/>
                                <ToggleButton x:Name="Tue" Content="화" IsChecked="True" Style="{StaticResource WakeDayToggle}"/>
                                <ToggleButton x:Name="Wed" Content="수" IsChecked="True" Style="{StaticResource WakeDayToggle}"/>
                                <ToggleButton x:Name="Thu" Content="목" IsChecked="True" Style="{StaticResource WakeDayToggle}"/>
                                <ToggleButton x:Name="Fri" Content="금" IsChecked="True" Style="{StaticResource WakeDayToggle}"/>
                                <ToggleButton x:Name="Sat" Content="토" IsChecked="True" Style="{StaticResource WakeDayToggle}"/>
                                <ToggleButton x:Name="Sun" Content="일" IsChecked="True" Style="{StaticResource WakeDayToggle}" Margin="0"/>
                            </UniformGrid>

                            <TextBlock Text="시간" Style="{StaticResource WakeSectionLabel}" Margin="0,20,0,8"/>
                            <ComboBox x:Name="TimeCombo" Style="{StaticResource EditableTimeCombo}"
                                      LostFocus="TimeCombo_LostFocus"/>

                            <Border Margin="0,22,0,0" Padding="14,12" CornerRadius="10"
                                    BorderBrush="{DynamicResource LineBrush}" BorderThickness="1"
                                    Background="{DynamicResource PanelSoftBrush}">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <Path Style="{StaticResource LucideIcon}" Data="{StaticResource IconCheck}"
                                          Width="15" Height="15" Margin="2,2,11,0" VerticalAlignment="Top"
                                          Stroke="{DynamicResource TextMutedBrush}"/>
                                    <StackPanel Grid.Column="1">
                                        <TextBlock Text="최근 실행 일시" FontSize="{DynamicResource Fs11}"
                                                   Foreground="{DynamicResource TextMutedBrush}"/>
                                        <TextBlock x:Name="LastExecutionText" Text="아직 실행 기록이 없습니다"
                                                   Margin="0,4,0,0" TextWrapping="Wrap"
                                                   FontSize="{DynamicResource Fs12}" Foreground="{DynamicResource TextBrush}"/>
                                    </StackPanel>
                                </Grid>
                            </Border>

                            <Border x:Name="TrustPanel" Margin="0,14,0,0" Padding="14,12" CornerRadius="10"
                                    BorderBrush="{DynamicResource LineBrush}" BorderThickness="1"
                                    Background="{DynamicResource PanelSoftBrush}" Visibility="Collapsed">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <Path Style="{StaticResource LucideIcon}" Data="{StaticResource IconShield}"
                                          Width="15" Height="15" Margin="2,2,11,0" VerticalAlignment="Top"
                                          Stroke="{DynamicResource TextMutedBrush}"/>
                                    <StackPanel Grid.Column="1">
                                        <TextBlock x:Name="TrustMessage"
                                                   Text="프로젝트 경로의 신뢰 설정을 자동으로 확인하고 있습니다."
                                                   TextWrapping="Wrap" FontSize="{DynamicResource Fs12}"
                                                   Foreground="{DynamicResource TextBrush}"/>
                                    </StackPanel>
                                </Grid>
                            </Border>
                        </StackPanel>
                    </ScrollViewer>
                </Grid>

                <Border Grid.Row="2" Background="{DynamicResource PanelSoftBrush}"
                        BorderBrush="{DynamicResource LineBrush}" BorderThickness="0,1,0,0">
                    <Grid Margin="20,14">
                        <TextBlock Text="예약 시간에는 DevezCode가 실행 중이어야 합니다"
                                   VerticalAlignment="Center" FontSize="{DynamicResource Fs10}"
                                   Foreground="{DynamicResource TextMutedBrush}"/>
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                            <Button Content="취소" Click="Cancel_Click" Width="100" Height="38"
                                    Style="{StaticResource SecondaryButton}" FontSize="{DynamicResource Fs13}"
                                    Margin="0,0,8,0"/>
                            <Button x:Name="SaveButton" Content="저장" Click="Save_Click" Width="100" Height="38"
                                    Style="{StaticResource PrimaryButton}" FontSize="{DynamicResource Fs13}"/>
                        </StackPanel>
                    </Grid>
                </Border>
            </Grid>
        </Border>
    </Grid>
</Window>
