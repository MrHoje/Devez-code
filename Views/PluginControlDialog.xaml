<UserControl x:Class="DevezCode.Views.PluginControlDialog"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:models="clr-namespace:DevezCode.Models"
             UseLayoutRounding="True"
             SnapsToDevicePixels="True"
             TextOptions.TextFormattingMode="Display"
             TextOptions.TextRenderingMode="ClearType"
             FontFamily="{StaticResource PretendardFont}">

    <UserControl.Resources>
        <Style x:Key="RowIconBtn" TargetType="Button" BasedOn="{StaticResource TitleBarChipButton}">
            <Setter Property="Width" Value="32"/>
            <Setter Property="Height" Value="32"/>
            <Setter Property="Margin" Value="4,0,0,0"/>
        </Style>
        <!-- 좌측 에이전트 카테고리 버튼(세션 클리너 패턴) -->
        <Style x:Key="CategoryItem" TargetType="Button">
            <Setter Property="IsTabStop" Value="False"/>
            <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Foreground" Value="{DynamicResource TextBrush}"/>
            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
            <Setter Property="HorizontalAlignment" Value="Stretch"/>
            <Setter Property="Padding" Value="12,10"/>
            <Setter Property="FontSize" Value="{DynamicResource Fs13}"/>
            <Setter Property="Margin" Value="0,2"/>
            <Setter Property="Cursor" Value="Arrow"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd" Background="{TemplateBinding Background}"
                                CornerRadius="8" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Stretch" VerticalAlignment="Center"
                                              TextElement.Foreground="{TemplateBinding Foreground}"
                                              TextElement.FontWeight="{TemplateBinding FontWeight}"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource PanelBrush}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </UserControl.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="48"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- 헤더 -->
        <Border Grid.Row="0"
                Background="{DynamicResource PanelBrush}"
                BorderBrush="{DynamicResource LineBrush}"
                BorderThickness="0,0,0,1"
                MouseLeftButtonDown="Header_DragMove">
            <Grid>
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="16,0,0,0">
                    <Path Style="{StaticResource LucideIcon}"
                          Data="{StaticResource IconPlug}"
                          Width="16" Height="16" VerticalAlignment="Center"
                          Stroke="{DynamicResource TextBrush}"
                          Margin="0,-1,11,0"/>
                    <TextBlock Text="플러그인 컨트롤러" VerticalAlignment="Center"
                               FontSize="{DynamicResource Fs14}" FontWeight="SemiBold"
                               Foreground="{DynamicResource TextBrush}"/>
                </StackPanel>
                <Button Click="CloseBtn_Click"
                        HorizontalAlignment="Right" VerticalAlignment="Center"
                        Width="40" Height="32" Margin="0,0,8,0"
                        Style="{StaticResource WinCloseBtn}">
                    <TextBlock Text="&#x2715;" FontSize="{DynamicResource Fs11}"/>
                </Button>
            </Grid>
        </Border>

        <!-- 본문: 좌(에이전트) | 우(플러그인) -->
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="180"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- 좌: 에이전트 카테고리 -->
            <Border Grid.Column="0" Background="{DynamicResource PanelSoftBrush}"
                    BorderBrush="{DynamicResource LineBrush}" BorderThickness="0,0,1,0">
                <StackPanel Margin="12,16,12,16">
                    <TextBlock Text="에이전트" FontSize="{DynamicResource Fs11}" FontWeight="SemiBold"
                               Foreground="{DynamicResource TextMutedBrush}" Margin="4,0,0,8"/>
                    <Button x:Name="ClaudeCatBtn" Tag="claude" Style="{StaticResource CategoryItem}"
                            Click="Category_Click" Visibility="Collapsed">
                        <StackPanel Orientation="Horizontal">
                            <Image Width="18" Height="18" Margin="0,0,10,0" VerticalAlignment="Center"
                                   Source="{Binding Tag, RelativeSource={RelativeSource AncestorType=Button}, Converter={x:Static models:AgentImageConverter.Instance}}"
                                   RenderOptions.BitmapScalingMode="HighQuality"/>
                            <TextBlock Text="Claude" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>
                    <Button x:Name="OpenCodeCatBtn" Tag="opencode" Style="{StaticResource CategoryItem}"
                            Click="Category_Click" Visibility="Collapsed">
                        <StackPanel Orientation="Horizontal">
                            <Image Width="18" Height="18" Margin="0,0,10,0" VerticalAlignment="Center"
                                   Source="{Binding Tag, RelativeSource={RelativeSource AncestorType=Button}, Converter={x:Static models:AgentImageConverter.Instance}}"
                                   RenderOptions.BitmapScalingMode="HighQuality"/>
                            <TextBlock Text="OpenCode" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>
                    <Button x:Name="GajaeCatBtn" Tag="gajae" Style="{StaticResource CategoryItem}"
                            Click="Category_Click" Visibility="Collapsed">
                        <StackPanel Orientation="Horizontal">
                            <Image Width="18" Height="18" Margin="0,0,10,0" VerticalAlignment="Center"
                                   Source="{Binding Tag, RelativeSource={RelativeSource AncestorType=Button}, Converter={x:Static models:AgentImageConverter.Instance}}"
                                   RenderOptions.BitmapScalingMode="HighQuality"/>
                            <TextBlock Text="Gajae Code" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>
                </StackPanel>
            </Border>

            <!-- 우: 선택 에이전트의 플러그인 -->
            <Grid Grid.Column="1">
                <!-- 켜진 에이전트 없음 -->
                <StackPanel x:Name="NoAgentPanel" Visibility="Collapsed" VerticalAlignment="Center" Margin="28">
                    <TextBlock Text="사용 중인 에이전트가 없습니다"
                               FontSize="{DynamicResource Fs14}" FontWeight="SemiBold"
                               Foreground="{DynamicResource TextBrush}" TextAlignment="Center"/>
                    <TextBlock Text="설정 &gt; 에이전트에서 사용할 에이전트를 켜면 여기에 표시됩니다."
                               FontSize="{DynamicResource Fs12}" Foreground="{DynamicResource TextMutedBrush}"
                               TextAlignment="Center" Margin="0,8,0,0"/>
                </StackPanel>

                <Grid x:Name="ContentPanel" Margin="24,20,24,4">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <!-- 컨트롤 카드 -->
                    <Border Grid.Row="0" Padding="16,12" CornerRadius="12" Margin="0,0,0,16"
                            Background="{DynamicResource PanelSoftBrush}"
                            BorderBrush="{DynamicResource LineBrush}" BorderThickness="1">
                        <Grid>
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <Button x:Name="InstallBtn" Click="InstallBtn_Click"
                                        Style="{StaticResource SecondaryButton}" Height="34" Padding="14,0">
                                    <StackPanel Orientation="Horizontal">
                                        <Path Style="{StaticResource LucideButtonIcon}" Data="{StaticResource IconDownload}"
                                              Width="13" Height="13" Margin="0,0,7,0"/>
                                        <TextBlock x:Name="InstallBtnText" Text="설치" FontSize="{DynamicResource Fs12}" FontWeight="SemiBold"/>
                                    </StackPanel>
                                </Button>
                                <Button x:Name="MarketBtn" Click="MarketBtn_Click" Margin="8,0,0,0"
                                        Style="{StaticResource SecondaryButton}" Height="34" Padding="14,0">
                                    <StackPanel Orientation="Horizontal">
                                        <Path Style="{StaticResource LucideButtonIcon}" Data="{StaticResource IconStore}"
                                              Width="13" Height="13" Margin="0,0,7,0"/>
                                        <TextBlock Text="마켓플레이스" FontSize="{DynamicResource Fs12}" FontWeight="SemiBold"/>
                                    </StackPanel>
                                </Button>
                            </StackPanel>
                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                                <Ellipse x:Name="RefreshSpinner" Width="18" Height="18" Margin="0,0,10,0"
                                         Visibility="Collapsed" VerticalAlignment="Center"
                                         models:SpinnerActivator.Track="True"
                                         Stroke="{DynamicResource PrimaryBrush}" StrokeThickness="2.2"
                                         StrokeDashArray="15 100" StrokeDashCap="Round"
                                         RenderTransformOrigin="0.5,0.5">
                                    <Ellipse.RenderTransform>
                                        <RotateTransform Angle="{Binding Angle, Source={x:Static models:SpinnerSync.Instance}}"/>
                                    </Ellipse.RenderTransform>
                                </Ellipse>
                                <TextBlock x:Name="LastRefreshedText" VerticalAlignment="Center" Margin="0,0,12,0"
                                           FontSize="{DynamicResource Fs11}" Foreground="{DynamicResource TextMutedBrush}"/>
                                <Button x:Name="RefreshBtn" Click="RefreshBtn_Click"
                                        Style="{StaticResource SecondaryButton}" Height="34" Padding="14,0">
                                    <StackPanel Orientation="Horizontal">
                                        <Path Style="{StaticResource LucideButtonIcon}" Data="{StaticResource IconRefresh}"
                                              Width="13" Height="13" Margin="0,0,7,0"/>
                                        <TextBlock Text="새로고침" FontSize="{DynamicResource Fs12}" FontWeight="SemiBold"/>
                                    </StackPanel>
                                </Button>
                            </StackPanel>
                        </Grid>
                    </Border>

                    <!-- 플러그인 목록 -->
                    <Grid Grid.Row="1">
                        <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                            <ItemsControl x:Name="PluginList">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate DataType="{x:Type models:PluginItem}">
                                        <Border Margin="0,0,0,10" Padding="16,13" CornerRadius="12"
                                                Background="{DynamicResource PanelSoftBrush}"
                                                BorderBrush="{DynamicResource LineBrush}" BorderThickness="1">
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="Auto"/>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="Auto"/>
                                                </Grid.ColumnDefinitions>

                                                <Ellipse Grid.Column="0" Width="10" Height="10" VerticalAlignment="Center"
                                                         Margin="2,0,14,0"
                                                         Fill="{Binding Enabled, Converter={x:Static models:BoolToOnOffBrushConverter.Instance}}"/>

                                                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                                    <StackPanel Orientation="Horizontal">
                                                        <TextBlock Text="{Binding Name}" FontSize="{DynamicResource Fs13}"
                                                                   FontWeight="SemiBold" Foreground="{DynamicResource TextBrush}"
                                                                   TextTrimming="CharacterEllipsis" VerticalAlignment="Center"/>
                                                        <Border Margin="8,0,0,0" Padding="6,1" CornerRadius="4"
                                                                VerticalAlignment="Center"
                                                                Background="{DynamicResource PanelBrush}">
                                                            <TextBlock Text="{Binding Source}" FontSize="{DynamicResource Fs10}"
                                                                       Foreground="{DynamicResource TextMutedBrush}"/>
                                                        </Border>
                                                        <Border Margin="6,0,0,0" Padding="6,1" CornerRadius="4"
                                                                VerticalAlignment="Center"
                                                                Background="{DynamicResource PanelBrush}"
                                                                ToolTip="DevezCode 연동 플러그인 — 제거 불가"
                                                                Visibility="{Binding IsProtected, Converter={x:Static models:BoolToVisibilityConverter.Instance}}">
                                                            <TextBlock Text="보호됨" FontSize="{DynamicResource Fs10}"
                                                                       Foreground="{DynamicResource TextMutedBrush}"/>
                                                        </Border>
                                                    </StackPanel>
                                                    <StackPanel Orientation="Horizontal" Margin="0,4,0,0">
                                                        <TextBlock Text="{Binding VersionText}" FontSize="{DynamicResource Fs11}"
                                                                   Foreground="{DynamicResource TextMutedBrush}"/>
                                                        <TextBlock Text="{Binding Meta}" FontSize="{DynamicResource Fs11}"
                                                                   Foreground="{DynamicResource TextMutedBrush}" Margin="8,0,0,0"/>
                                                    </StackPanel>
                                                </StackPanel>

                                                <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                                                    <CheckBox IsChecked="{Binding Enabled, Mode=OneWay}"
                                                              Click="EnableToggle_Click"
                                                              Style="{StaticResource ToggleSwitch}"
                                                              VerticalAlignment="Center" Margin="0,0,8,0"
                                                              ToolTip="활성/비활성"
                                                              Visibility="{Binding CanToggle, Converter={x:Static models:BoolToVisibilityConverter.Instance}}"/>
                                                    <Button Style="{StaticResource RowIconBtn}" Click="Detail_Click"
                                                            ToolTip="상세"
                                                            Visibility="{Binding CanDetails, Converter={x:Static models:BoolToVisibilityConverter.Instance}}">
                                                        <Path Style="{StaticResource LucideButtonIcon}" Data="{StaticResource IconEye}"
                                                              Width="14" Height="14" Stroke="{DynamicResource TextMutedBrush}"/>
                                                    </Button>
                                                    <Button Style="{StaticResource RowIconBtn}" Click="Update_Click"
                                                            ToolTip="업데이트"
                                                            Visibility="{Binding CanUpdate, Converter={x:Static models:BoolToVisibilityConverter.Instance}}">
                                                        <Path Style="{StaticResource LucideButtonIcon}" Data="{StaticResource IconDownload}"
                                                              Width="14" Height="14" Stroke="{DynamicResource TextMutedBrush}"/>
                                                    </Button>
                                                    <Button Style="{StaticResource RowIconBtn}" Click="Uninstall_Click"
                                                            ToolTip="삭제">
                                                        <Path Style="{StaticResource LucideButtonIcon}" Data="{StaticResource IconTrash2}"
                                                              Width="14" Height="14" Stroke="{DynamicResource DangerBrush}"/>
                                                    </Button>
                                                </StackPanel>
                                            </Grid>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </ScrollViewer>

                        <StackPanel x:Name="EmptyState" VerticalAlignment="Center" HorizontalAlignment="Center"
                                    Visibility="Collapsed">
                            <Path Style="{StaticResource LucideIcon}" Data="{StaticResource IconBox}"
                                  Width="40" Height="40" Stroke="{DynamicResource LineBrush}"
                                  HorizontalAlignment="Center"/>
                            <TextBlock x:Name="EmptyText" Text="설치된 플러그인이 없습니다"
                                       FontSize="{DynamicResource Fs14}" FontWeight="SemiBold"
                                       Foreground="{DynamicResource TextBrush}"
                                       Margin="0,14,0,0" HorizontalAlignment="Center"/>
                        </StackPanel>
                    </Grid>
                </Grid>
            </Grid>
        </Grid>

        <!-- 상세/결과 출력 패널 -->
        <Border x:Name="DetailPanel" Grid.Row="2" Visibility="Collapsed"
                Background="{DynamicResource PanelBrush}"
                BorderBrush="{DynamicResource LineBrush}" BorderThickness="0,1,0,0"
                MaxHeight="220">
            <Grid Margin="24,12,24,14">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>
                <Grid Grid.Row="0" Margin="0,0,0,8">
                    <TextBlock x:Name="DetailTitle" Text="상세" FontSize="{DynamicResource Fs11}"
                               FontWeight="SemiBold" Foreground="{DynamicResource TextMutedBrush}"
                               VerticalAlignment="Center"/>
                    <Button Click="DetailClose_Click" HorizontalAlignment="Right" VerticalAlignment="Center"
                            Style="{StaticResource TitleBarChipButton}" Width="26" Height="26" ToolTip="닫기">
                        <Path Style="{StaticResource LucideButtonIcon}" Data="{StaticResource IconX}"
                              Width="12" Height="12" Stroke="{DynamicResource TextMutedBrush}"/>
                    </Button>
                </Grid>
                <Border Grid.Row="1" CornerRadius="10" Padding="12,10"
                        Background="{DynamicResource PanelSoftBrush}"
                        BorderBrush="{DynamicResource LineBrush}" BorderThickness="1">
                    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto">
                        <TextBox x:Name="DetailText" IsReadOnly="True" BorderThickness="0"
                                 Background="Transparent" TextWrapping="NoWrap"
                                 FontFamily="Consolas, Cascadia Code, PretendardFont"
                                 FontSize="{DynamicResource Fs11}"
                                 Foreground="{DynamicResource TextBrush}"/>
                    </ScrollViewer>
                </Border>
            </Grid>
        </Border>

        <!-- 마켓플레이스 오버레이 (claude/gjc 전용) -->
        <Grid x:Name="MarketOverlay" Grid.Row="1" Grid.RowSpan="2" Visibility="Collapsed" Panel.ZIndex="10">
            <Border Background="#66000000" MouseLeftButtonDown="MarketScrim_Click"/>
            <Border Width="520" MaxHeight="440" VerticalAlignment="Center" HorizontalAlignment="Center"
                    CornerRadius="14" Background="{DynamicResource BgBrush}"
                    BorderBrush="{DynamicResource LineBrush}" BorderThickness="1">
                <Border.Effect>
                    <DropShadowEffect ShadowDepth="0" BlurRadius="28" Direction="270"
                                      Color="{DynamicResource ShadowColor}" Opacity="{DynamicResource ShadowOpacity}"/>
                </Border.Effect>
                <Grid Margin="20,18,20,18">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <Grid Grid.Row="0" Margin="0,0,0,14">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <Path Style="{StaticResource LucideIcon}" Data="{StaticResource IconStore}"
                                  Width="16" Height="16" Stroke="{DynamicResource TextBrush}"
                                  VerticalAlignment="Center" Margin="0,0,10,0"/>
                            <TextBlock Text="마켓플레이스" FontSize="{DynamicResource Fs14}" FontWeight="SemiBold"
                                       Foreground="{DynamicResource TextBrush}" VerticalAlignment="Center"/>
                        </StackPanel>
                        <Button Click="MarketClose_Click" HorizontalAlignment="Right" VerticalAlignment="Center"
                                Style="{StaticResource TitleBarChipButton}" Width="28" Height="28" ToolTip="닫기">
                            <Path Style="{StaticResource LucideButtonIcon}" Data="{StaticResource IconX}"
                                  Width="12" Height="12" Stroke="{DynamicResource TextMutedBrush}"/>
                        </Button>
                    </Grid>

                    <Grid Grid.Row="1" Margin="0,0,0,12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <Button Grid.Column="0" Click="MarketAdd_Click"
                                Style="{StaticResource SecondaryButton}" Height="34" HorizontalAlignment="Left" Padding="14,0">
                            <StackPanel Orientation="Horizontal">
                                <Path Style="{StaticResource LucideButtonIcon}" Data="{StaticResource IconPlus}"
                                      Width="13" Height="13" Margin="0,0,7,0"/>
                                <TextBlock Text="마켓플레이스 추가" FontSize="{DynamicResource Fs12}" FontWeight="SemiBold"/>
                            </StackPanel>
                        </Button>
                        <Button Grid.Column="1" x:Name="MarketUpdateAllBtn" Click="MarketUpdateAll_Click"
                                Style="{StaticResource SecondaryButton}" Height="34" Padding="14,0"
                                ToolTip="모든 마켓플레이스 업데이트">
                            <StackPanel Orientation="Horizontal">
                                <Path Style="{StaticResource LucideButtonIcon}" Data="{StaticResource IconRefresh}"
                                      Width="13" Height="13" Margin="0,0,7,0"/>
                                <TextBlock Text="전체 업데이트" FontSize="{DynamicResource Fs12}" FontWeight="SemiBold"/>
                            </StackPanel>
                        </Button>
                    </Grid>

                    <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                        <ItemsControl x:Name="MarketList">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate DataType="{x:Type models:ClaudeMarketplace}">
                                    <Border Margin="0,0,0,8" Padding="14,11" CornerRadius="10"
                                            Background="{DynamicResource PanelSoftBrush}"
                                            BorderBrush="{DynamicResource LineBrush}" BorderThickness="1">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>
                                            <StackPanel Grid.Column="0" VerticalAlignment="Center">
                                                <TextBlock Text="{Binding Name}" FontSize="{DynamicResource Fs12}"
                                                           FontWeight="SemiBold" Foreground="{DynamicResource TextBrush}"/>
                                                <TextBlock Text="{Binding OriginText}" FontSize="{DynamicResource Fs11}"
                                                           Foreground="{DynamicResource TextMutedBrush}" Margin="0,3,0,0"
                                                           TextTrimming="CharacterEllipsis" MaxWidth="360"/>
                                            </StackPanel>
                                            <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                                                <Button Style="{StaticResource RowIconBtn}" Click="MarketItemUpdate_Click"
                                                        ToolTip="이 마켓플레이스 업데이트">
                                                    <Path Style="{StaticResource LucideButtonIcon}" Data="{StaticResource IconRefresh}"
                                                          Width="13" Height="13" Stroke="{DynamicResource TextMutedBrush}"/>
                                                </Button>
                                                <Button Style="{StaticResource RowIconBtn}" Click="MarketItemRemove_Click"
                                                        ToolTip="삭제">
                                                    <Path Style="{StaticResource LucideButtonIcon}" Data="{StaticResource IconTrash2}"
                                                          Width="13" Height="13" Stroke="{DynamicResource DangerBrush}"/>
                                                </Button>
                                            </StackPanel>
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>
                </Grid>
            </Border>
        </Grid>
    </Grid>
</UserControl>
