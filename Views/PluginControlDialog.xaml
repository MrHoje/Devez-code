<UserControl x:Class="DevezCode.Views.PluginControlDialog"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:models="clr-namespace:DevezCode.Models"
             UseLayoutRounding="True"
             SnapsToDevicePixels="True"
             TextOptions.TextFormattingMode="Display"
             TextOptions.TextRenderingMode="ClearType"
             FontFamily="{StaticResource PretendardFont}">

    <UserControl.Resources>
        <Style x:Key="RowIconBtn" TargetType="Button">
            <Setter Property="Width" Value="32"/>
            <Setter Property="Height" Value="32"/>
            <Setter Property="Margin" Value="4,0,0,0"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Cursor" Value="Arrow"/>
            <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd" Background="{TemplateBinding Background}" CornerRadius="7">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource PanelBrush}"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource PrimarySoftBrush}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <!-- 좌측 탭(플러그인 / 마켓플레이스) — 세션 클리너 카테고리 패턴 -->
        <Style x:Key="CategoryItem" TargetType="Button">
            <Setter Property="IsTabStop" Value="False"/>
            <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Foreground" Value="{DynamicResource TextBrush}"/>
            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
            <Setter Property="HorizontalAlignment" Value="Stretch"/>
            <Setter Property="Padding" Value="12,10"/>
            <Setter Property="FontSize" Value="{DynamicResource Fs13}"/>
            <Setter Property="Margin" Value="0,2"/>
            <Setter Property="Cursor" Value="Arrow"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd" Background="{TemplateBinding Background}"
                                CornerRadius="8" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Stretch" VerticalAlignment="Center"
                                              TextElement.Foreground="{TemplateBinding Foreground}"
                                              TextElement.FontWeight="{TemplateBinding FontWeight}"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource PanelBrush}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </UserControl.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="48"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- 헤더 (드래그는 WindowChrome 캡션이 담당) -->
        <Border Grid.Row="0"
                Background="{DynamicResource PanelBrush}"
                BorderBrush="{DynamicResource LineBrush}"
                BorderThickness="0,0,0,1">
            <Grid>
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="16,0,0,0">
                    <Path Style="{StaticResource LucideIcon}"
                          Data="{StaticResource IconPlug}"
                          Width="16" Height="16" VerticalAlignment="Center"
                          Stroke="{DynamicResource TextBrush}"
                          Margin="0,-1,11,0"/>
                    <TextBlock Text="Claude 플러그인 관리" VerticalAlignment="Center"
                               FontSize="{DynamicResource Fs14}" FontWeight="SemiBold"
                               Foreground="{DynamicResource TextBrush}"/>
                    <TextBlock Text="플러그인 변경사항은 세션 재실행 또는 /reload-plugins 호출 후 적용됩니다."
                               VerticalAlignment="Center" Margin="14,1,0,0"
                               FontSize="{DynamicResource Fs11}"
                               Foreground="{DynamicResource TextMutedBrush}"/>
                </StackPanel>
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center"
                            Margin="0,0,8,0">
                    <Button x:Name="MaxRestoreBtn" Click="MaxRestore_Click"
                            Style="{StaticResource WinCtrlBtn}" ToolTip="최대화">
                        <TextBlock x:Name="MaxRestoreGlyph" Text="&#x25A1;" FontSize="14"/>
                    </Button>
                    <Button Click="CloseBtn_Click" Style="{StaticResource WinCloseBtn}">
                        <TextBlock Text="&#x2715;" FontSize="{DynamicResource Fs11}"/>
                    </Button>
                </StackPanel>
            </Grid>
        </Border>

        <!-- 본문: 좌(탭) | 중(리스트) | 우(출력) -->
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="164"/>
                <ColumnDefinition Width="*" MinWidth="360"/>
                <ColumnDefinition Width="6"/>
                <ColumnDefinition x:Name="OutputCol" Width="490" MinWidth="340"/>
            </Grid.ColumnDefinitions>

            <!-- 좌: 탭 -->
            <Border Grid.Column="0" Background="{DynamicResource PanelSoftBrush}"
                    BorderBrush="{DynamicResource LineBrush}" BorderThickness="0,0,1,0">
                <StackPanel Margin="12,16,12,16">
                    <Button x:Name="PluginTabBtn" Tag="plugins" Style="{StaticResource CategoryItem}"
                            Click="Tab_Click">
                        <StackPanel Orientation="Horizontal">
                            <Path Style="{StaticResource LucideButtonIcon}" Data="{StaticResource IconPlug}"
                                  Width="15" Height="15" Margin="0,0,10,0" VerticalAlignment="Center"/>
                            <TextBlock Text="플러그인" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>
                    <Button x:Name="MarketTabBtn" Tag="marketplaces" Style="{StaticResource CategoryItem}"
                            Click="Tab_Click">
                        <StackPanel Orientation="Horizontal">
                            <Path Style="{StaticResource LucideButtonIcon}" Data="{StaticResource IconStore}"
                                  Width="15" Height="15" Margin="0,0,10,0" VerticalAlignment="Center"/>
                            <TextBlock Text="마켓플레이스" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>
                </StackPanel>
            </Border>

            <!-- 중: 리스트 -->
            <Grid Grid.Column="1" Margin="20,18,20,18">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <!-- 툴바 카드 -->
                <!-- 상단 액션 버튼(패널 없이 그대로 노출) -->
                <Grid Grid.Row="0" Margin="0,0,0,14">
                        <!-- 플러그인 탭 액션 -->
                        <StackPanel x:Name="PluginActions" Orientation="Horizontal" VerticalAlignment="Center">
                            <Button x:Name="InstallBtn" Click="InstallBtn_Click"
                                    Style="{StaticResource SecondaryButton}" Height="34" Padding="14,0">
                                <StackPanel Orientation="Horizontal">
                                    <Path Style="{StaticResource LucideButtonIcon}" Data="{StaticResource IconPlus}"
                                          Width="13" Height="13" Margin="0,0,7,0"/>
                                    <TextBlock Text="설치" FontSize="{DynamicResource Fs12}" FontWeight="SemiBold"/>
                                </StackPanel>
                            </Button>
                            <Button x:Name="PluginUpdateAllBtn" Click="PluginUpdateAll_Click" Margin="8,0,0,0"
                                    Style="{StaticResource SecondaryButton}" Height="34" Padding="14,0"
                                    ToolTip="설치된 모든 플러그인 업데이트">
                                <StackPanel Orientation="Horizontal">
                                    <Path Style="{StaticResource LucideButtonIcon}" Data="{StaticResource IconDownload}"
                                          Width="13" Height="13" Margin="0,0,7,0"/>
                                    <TextBlock Text="전체 업데이트" FontSize="{DynamicResource Fs12}" FontWeight="SemiBold"/>
                                </StackPanel>
                            </Button>
                        </StackPanel>
                        <!-- 마켓플레이스 탭 액션 -->
                        <StackPanel x:Name="MarketActions" Orientation="Horizontal" VerticalAlignment="Center"
                                    Visibility="Collapsed">
                            <Button x:Name="MarketAddBtn" Click="MarketAdd_Click"
                                    Style="{StaticResource SecondaryButton}" Height="34" Padding="14,0">
                                <StackPanel Orientation="Horizontal">
                                    <Path Style="{StaticResource LucideButtonIcon}" Data="{StaticResource IconPlus}"
                                          Width="13" Height="13" Margin="0,0,7,0"/>
                                    <TextBlock Text="추가" FontSize="{DynamicResource Fs12}" FontWeight="SemiBold"/>
                                </StackPanel>
                            </Button>
                            <Button x:Name="MarketUpdateAllBtn" Click="MarketUpdateAll_Click" Margin="8,0,0,0"
                                    Style="{StaticResource SecondaryButton}" Height="34" Padding="14,0"
                                    ToolTip="모든 마켓플레이스 업데이트">
                                <StackPanel Orientation="Horizontal">
                                    <Path Style="{StaticResource LucideButtonIcon}" Data="{StaticResource IconDownload}"
                                          Width="13" Height="13" Margin="0,0,7,0"/>
                                    <TextBlock Text="전체 업데이트" FontSize="{DynamicResource Fs12}" FontWeight="SemiBold"/>
                                </StackPanel>
                            </Button>
                        </StackPanel>

                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                            <Ellipse x:Name="RefreshSpinner" Width="18" Height="18" Margin="0,0,10,0"
                                     Visibility="Collapsed" VerticalAlignment="Center"
                                     models:SpinnerActivator.Track="True"
                                     Stroke="{DynamicResource PrimaryBrush}" StrokeThickness="2.2"
                                     StrokeDashArray="15 100" StrokeDashCap="Round"
                                     RenderTransformOrigin="0.5,0.5">
                                <Ellipse.RenderTransform>
                                    <RotateTransform Angle="{Binding Angle, Source={x:Static models:SpinnerSync.Instance}}"/>
                                </Ellipse.RenderTransform>
                            </Ellipse>
                            <Button x:Name="RefreshBtn" Click="RefreshBtn_Click"
                                    Style="{StaticResource SecondaryButton}" Height="34" Padding="14,0">
                                <StackPanel Orientation="Horizontal">
                                    <Path Style="{StaticResource LucideButtonIcon}" Data="{StaticResource IconRefresh}"
                                          Width="13" Height="13" Margin="0,0,7,0"/>
                                    <TextBlock Text="새로고침" FontSize="{DynamicResource Fs12}" FontWeight="SemiBold"/>
                                </StackPanel>
                            </Button>
                        </StackPanel>
                </Grid>

                <!-- 검색창 (모든 탭 공통) -->
                <Border Grid.Row="1" Height="35" Margin="0,0,0,14"
                        Background="{DynamicResource PanelSoftBrush}"
                        BorderBrush="{DynamicResource LineBrush}"
                        BorderThickness="1" CornerRadius="8">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <Path Grid.Column="0" Style="{StaticResource LucideIcon}"
                              Data="{StaticResource IconSearch}"
                              Stroke="{DynamicResource TextMutedBrush}"
                              Width="13" Height="13"
                              Margin="12,0,0,0" VerticalAlignment="Center"/>
                        <Grid Grid.Column="1">
                            <TextBox x:Name="SearchBox"
                                     Margin="8,0,0,0" Padding="0" VerticalContentAlignment="Center"
                                     Background="Transparent" BorderThickness="0"
                                     FocusVisualStyle="{x:Null}"
                                     Foreground="{DynamicResource TextBrush}"
                                     CaretBrush="{DynamicResource TextBrush}"
                                     FontSize="{DynamicResource Fs13}"
                                     FontFamily="{StaticResource PretendardFont}"
                                     TextChanged="SearchBox_TextChanged">
                                <TextBox.Resources>
                                    <Style TargetType="Border"><Setter Property="CornerRadius" Value="0"/></Style>
                                </TextBox.Resources>
                            </TextBox>
                            <TextBlock x:Name="SearchPlaceholder" Text="검색"
                                       IsHitTestVisible="False"
                                       Margin="8,0,0,0" Padding="0" VerticalAlignment="Center"
                                       Foreground="{DynamicResource TextMutedBrush}"
                                       FontSize="{DynamicResource Fs13}"
                                       FontFamily="{StaticResource PretendardFont}">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock" BasedOn="{StaticResource {x:Type TextBlock}}">
                                        <Setter Property="Visibility" Value="Collapsed"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding Text, ElementName=SearchBox}" Value="">
                                                <Setter Property="Visibility" Value="Visible"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>
                        </Grid>
                        <Button x:Name="SearchClearBtn" Grid.Column="2"
                                Width="20" Height="20" Margin="0,0,10,0"
                                VerticalAlignment="Center" Visibility="Collapsed"
                                Click="SearchClear_Click" Cursor="Arrow"
                                Background="Transparent" BorderThickness="0"
                                IsTabStop="False" FocusVisualStyle="{x:Null}"
                                ToolTip="지우기">
                            <Button.Template>
                                <ControlTemplate TargetType="Button">
                                    <Border x:Name="Bd" Width="20" Height="20" CornerRadius="4"
                                            Background="{TemplateBinding Background}">
                                        <Path Style="{StaticResource LucideButtonIcon}"
                                              Data="{StaticResource IconX}"
                                              Width="11" Height="11" Stretch="Uniform"
                                              HorizontalAlignment="Center" VerticalAlignment="Center"
                                              Stroke="{DynamicResource TextMutedBrush}"/>
                                    </Border>
                                    <ControlTemplate.Triggers>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter TargetName="Bd" Property="Background" Value="{DynamicResource LineBrush}"/>
                                        </Trigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </Button.Template>
                        </Button>
                    </Grid>
                </Border>

                <!-- 리스트 영역 -->
                <Grid Grid.Row="2">
                    <!-- 플러그인 목록 -->
                    <ScrollViewer x:Name="PluginScroll" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"
                                  ScrollChanged="ListScrollChanged">
                        <ItemsControl x:Name="PluginList">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate DataType="{x:Type models:ClaudePlugin}">
                                    <Border Margin="0,0,0,10" Padding="16,13" CornerRadius="12"
                                            Background="{DynamicResource PanelSoftBrush}"
                                            BorderBrush="{DynamicResource LineBrush}" BorderThickness="1">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto"/>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>

                                            <Ellipse Grid.Column="0" Width="10" Height="10" VerticalAlignment="Center"
                                                     Margin="2,0,14,0"
                                                     Fill="{Binding Enabled, Converter={x:Static models:BoolToOnOffBrushConverter.Instance}}"/>

                                            <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                                <StackPanel Orientation="Horizontal">
                                                    <TextBlock Text="{Binding Name}" FontSize="{DynamicResource Fs13}"
                                                               FontWeight="SemiBold" Foreground="{DynamicResource TextBrush}"
                                                               TextTrimming="CharacterEllipsis" VerticalAlignment="Center"/>
                                                    <Border Margin="8,0,0,0" Padding="6,1" CornerRadius="4"
                                                            VerticalAlignment="Center"
                                                            Background="{DynamicResource PanelBrush}">
                                                        <TextBlock Text="{Binding Marketplace}" FontSize="{DynamicResource Fs10}"
                                                                   Foreground="{DynamicResource TextMutedBrush}"/>
                                                    </Border>
                                                </StackPanel>
                                                <StackPanel Orientation="Horizontal" Margin="0,4,0,0">
                                                    <TextBlock Text="{Binding VersionText}" FontSize="{DynamicResource Fs11}"
                                                               Foreground="{DynamicResource TextMutedBrush}"/>
                                                    <!-- 최신 확인됨 -->
                                                    <TextBlock Text="최신" FontSize="{DynamicResource Fs11}" Margin="8,0,0,0"
                                                               Foreground="{DynamicResource TextMutedBrush}"
                                                               Visibility="{Binding IsLatest, Converter={x:Static models:BoolToVisibilityConverter.Instance}}"/>
                                                    <!-- 업데이트 가능 배지 -->
                                                    <Border Margin="8,0,0,0" Padding="6,1" CornerRadius="4"
                                                            VerticalAlignment="Center"
                                                            Background="{DynamicResource PrimarySoftBrush}"
                                                            Visibility="{Binding UpdateAvailable, Converter={x:Static models:BoolToVisibilityConverter.Instance}}">
                                                        <TextBlock Text="{Binding UpdateBadgeText}" FontSize="{DynamicResource Fs10}"
                                                                   FontWeight="SemiBold" Foreground="{DynamicResource PrimaryBrush}"/>
                                                    </Border>
                                                    <TextBlock Text="{Binding McpText}" FontSize="{DynamicResource Fs11}"
                                                               Foreground="{DynamicResource TextMutedBrush}" Margin="8,0,0,0"/>
                                                    <TextBlock Text="{Binding UpdatedText}" FontSize="{DynamicResource Fs11}"
                                                               Foreground="{DynamicResource TextMutedBrush}" Margin="8,0,0,0"/>
                                                </StackPanel>
                                            </StackPanel>

                                            <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                                                <CheckBox IsChecked="{Binding Enabled, Mode=OneWay}"
                                                          Click="EnableToggle_Click"
                                                          Style="{StaticResource ToggleSwitch}"
                                                          VerticalAlignment="Center" Margin="0,0,8,0"
                                                          ToolTip="활성/비활성"/>
                                                <Button Style="{StaticResource RowIconBtn}" Click="Detail_Click" ToolTip="상세">
                                                    <Path Style="{StaticResource LucideButtonIcon}" Data="{StaticResource IconPackageSearch}"
                                                          Width="14" Height="14" Stroke="{DynamicResource TextMutedBrush}"/>
                                                </Button>
                                                <Button Style="{StaticResource RowIconBtn}" Click="Update_Click" ToolTip="업데이트">
                                                    <Path Style="{StaticResource LucideButtonIcon}" Data="{StaticResource IconDownload}"
                                                          Width="14" Height="14" Stroke="{DynamicResource TextMutedBrush}"/>
                                                </Button>
                                                <Button Style="{StaticResource RowIconBtn}" Click="Uninstall_Click" ToolTip="삭제">
                                                    <Path Style="{StaticResource LucideButtonIcon}" Data="{StaticResource IconTrash2}"
                                                          Width="14" Height="14" Stroke="{DynamicResource DangerBrush}"/>
                                                </Button>
                                            </StackPanel>
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>

                    <!-- 마켓플레이스 목록 -->
                    <ScrollViewer x:Name="MarketScroll" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"
                                  ScrollChanged="ListScrollChanged" Visibility="Collapsed">
                        <ItemsControl x:Name="MarketList">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate DataType="{x:Type models:ClaudeMarketplace}">
                                    <Border Margin="0,0,0,10" Padding="16,13" CornerRadius="12"
                                            Background="{DynamicResource PanelSoftBrush}"
                                            BorderThickness="1.5">
                                        <Border.Style>
                                            <Style TargetType="Border">
                                                <Setter Property="BorderBrush" Value="{DynamicResource LineBrush}"/>
                                                <!-- 프로젝트 카드와 동일: 픽셀 스냅·레이아웃 라운딩 끄고 안티에일리어싱 → 부드러운 라운드 보더 -->
                                                <Setter Property="SnapsToDevicePixels" Value="False"/>
                                                <Setter Property="UseLayoutRounding" Value="False"/>
                                                <Setter Property="RenderOptions.EdgeMode" Value="Unspecified"/>
                                                <Style.Triggers>
                                                    <!-- 선택된(상세 열린) 마켓: 프로젝트 카드처럼 primary 보더만 하이라이트 -->
                                                    <DataTrigger Binding="{Binding IsSelected}" Value="True">
                                                        <Setter Property="BorderBrush" Value="{DynamicResource PrimaryBrush}"/>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Border.Style>
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>
                                            <StackPanel Grid.Column="0" VerticalAlignment="Center">
                                                <TextBlock Text="{Binding Name}" FontSize="{DynamicResource Fs13}"
                                                           FontWeight="SemiBold" Foreground="{DynamicResource TextBrush}"/>
                                                <TextBlock Text="{Binding OriginText}" FontSize="{DynamicResource Fs11}"
                                                           Foreground="{DynamicResource TextMutedBrush}" Margin="0,4,0,0"
                                                           TextTrimming="CharacterEllipsis"/>
                                            </StackPanel>
                                            <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                                                <Button Style="{StaticResource RowIconBtn}" Click="MarketItemDetail_Click" ToolTip="상세">
                                                    <Path Style="{StaticResource LucideButtonIcon}" Data="{StaticResource IconPackageSearch}"
                                                          Width="14" Height="14" Stroke="{DynamicResource TextMutedBrush}"/>
                                                </Button>
                                                <Button Style="{StaticResource RowIconBtn}" Click="MarketItemUpdate_Click"
                                                        ToolTip="이 마켓플레이스 업데이트">
                                                    <Path Style="{StaticResource LucideButtonIcon}" Data="{StaticResource IconDownload}"
                                                          Width="14" Height="14" Stroke="{DynamicResource TextMutedBrush}"/>
                                                </Button>
                                                <Button Style="{StaticResource RowIconBtn}" Click="MarketItemRemove_Click"
                                                        ToolTip="삭제">
                                                    <Path Style="{StaticResource LucideButtonIcon}" Data="{StaticResource IconTrash2}"
                                                          Width="14" Height="14" Stroke="{DynamicResource DangerBrush}"/>
                                                </Button>
                                            </StackPanel>
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>

                    <!-- 스크롤 상·하단 페이드(프로젝트 영역과 동일). 스크롤이 생겼을 때만 노출 -->
                    <Rectangle x:Name="ListFadeTop" Height="22" VerticalAlignment="Top" IsHitTestVisible="False"
                               Panel.ZIndex="2" Visibility="Collapsed" Fill="{DynamicResource BgBrush}">
                        <Rectangle.OpacityMask>
                            <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                                <GradientStop Offset="0" Color="Black"/>
                                <GradientStop Offset="0.7" Color="Transparent"/>
                            </LinearGradientBrush>
                        </Rectangle.OpacityMask>
                    </Rectangle>
                    <Rectangle x:Name="ListFadeBottom" Height="22" VerticalAlignment="Bottom" IsHitTestVisible="False"
                               Panel.ZIndex="2" Visibility="Collapsed" Fill="{DynamicResource BgBrush}">
                        <Rectangle.OpacityMask>
                            <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                                <GradientStop Offset="0" Color="Transparent"/>
                                <GradientStop Offset="0.7" Color="Black"/>
                            </LinearGradientBrush>
                        </Rectangle.OpacityMask>
                    </Rectangle>

                    <!-- 빈 상태 -->
                    <StackPanel x:Name="EmptyState" VerticalAlignment="Center" HorizontalAlignment="Center"
                                Visibility="Collapsed">
                        <Path Style="{StaticResource LucideIcon}" Data="{StaticResource IconPlug}"
                              Width="40" Height="40" Stroke="{DynamicResource LineBrush}"
                              HorizontalAlignment="Center"/>
                        <TextBlock x:Name="EmptyText" Text="설치된 플러그인이 없습니다"
                                   FontSize="{DynamicResource Fs14}" FontWeight="SemiBold"
                                   Foreground="{DynamicResource TextBrush}"
                                   Margin="0,14,0,0" HorizontalAlignment="Center"/>
                    </StackPanel>
                </Grid>
            </Grid>

            <!-- 스플리터: 중앙 리스트 ↔ 우측 출력 크기 조절. 메인화면과 동일 방식 —
                 좌·우 패널이 각자 1px LineBrush 세퍼레이터를 그리고 그 사이 BgBrush 채널,
                 위에 투명 GridSplitter 오버레이(전역 스타일: 호버 시 PrimaryBrush 핸들).
                 GridSplitter 는 컬럼정의를 가진 본문 Grid 의 직접 자식이어야 실제로 컬럼을 리사이즈한다
                 (Wrapper Grid 안에 넣으면 그 안쪽 단일 컬럼만 만져 동작하지 않음). -->
            <Border Grid.Column="2" Width="1" HorizontalAlignment="Left"  Background="{DynamicResource LineBrush}"/>
            <Border Grid.Column="2" Width="1" HorizontalAlignment="Right" Background="{DynamicResource LineBrush}"/>
            <GridSplitter Grid.Column="2" HorizontalAlignment="Stretch" VerticalAlignment="Stretch"
                          ResizeBehavior="PreviousAndNext" ResizeDirection="Columns"
                          DragCompleted="OutputSplitter_DragCompleted"/>

            <!-- 우: 출력 영역 (+ 마켓 상세 시 하단 절반에 Discover) -->
            <Border Grid.Column="3" Background="{DynamicResource PanelBrush}">
                <Grid Margin="16,16,16,16">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*" x:Name="OutputRow"/>
                        <RowDefinition Height="0" x:Name="DiscoverRow"/>
                    </Grid.RowDefinitions>
                    <TextBlock Grid.Row="0" Text="출력" Margin="2,0,0,10"
                               FontSize="{DynamicResource Fs11}" FontWeight="SemiBold"
                               Foreground="{DynamicResource TextMutedBrush}" VerticalAlignment="Center"/>
                    <!-- 패딩을 Border 가 아니라 콘텐츠(TextBox)의 Margin 으로 줘야, 세로 스크롤바가 생겨도
                         텍스트가 스크롤바로부터 왼쪽 여백과 동일한 간격을 유지한다(스크롤바는 테두리 안쪽 끝에 붙음). -->
                    <Border Grid.Row="1" CornerRadius="10"
                            Background="{DynamicResource PanelSoftBrush}"
                            BorderBrush="{DynamicResource LineBrush}" BorderThickness="1">
                        <Grid>
                            <TextBlock x:Name="OutputPlaceholder" TextWrapping="Wrap" VerticalAlignment="Top"
                                       Margin="14,12,14,12"
                                       FontSize="{DynamicResource Fs11}" Foreground="{DynamicResource TextMutedBrush}"
                                       Text="상세·업데이트·삭제 등의 실행 결과가 여기에 표시됩니다."/>
                            <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                                <TextBox x:Name="OutputText" IsReadOnly="True" BorderThickness="0"
                                         Background="Transparent" TextWrapping="Wrap" Margin="14,12,14,12"
                                         FontFamily="Consolas, Cascadia Code, PretendardFont"
                                         FontSize="{DynamicResource Fs12}"
                                         Foreground="{DynamicResource TextBrush}"/>
                            </ScrollViewer>
                        </Grid>
                    </Border>

                    <!-- Discover 섹션 (마켓 상세 시 하단 2/3): 헤더 · 검색창 · 목록 -->
                    <Grid Grid.Row="2">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>

                        <!-- 헤더 -->
                        <Grid x:Name="DiscoverHeader" Grid.Row="0" Margin="2,16,0,8">
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <Path Style="{StaticResource LucideIcon}" Data="{StaticResource IconPackageSearch}"
                                      Width="14" Height="14" VerticalAlignment="Center"
                                      Stroke="{DynamicResource TextMutedBrush}" Margin="0,0,7,0"/>
                                <TextBlock Text="설치 가능한 플러그인" VerticalAlignment="Center"
                                           FontSize="{DynamicResource Fs11}" FontWeight="SemiBold"
                                           Foreground="{DynamicResource TextMutedBrush}"/>
                                <TextBlock x:Name="DiscoverTitle" VerticalAlignment="Center" Margin="8,0,0,0"
                                           FontSize="{DynamicResource Fs11}" Foreground="{DynamicResource TextMutedBrush}"/>
                                <Ellipse x:Name="DiscoverSpinner" Width="14" Height="14" Margin="8,0,0,0"
                                         Visibility="Collapsed" VerticalAlignment="Center"
                                         models:SpinnerActivator.Track="True"
                                         Stroke="{DynamicResource PrimaryBrush}" StrokeThickness="2"
                                         StrokeDashArray="15 100" StrokeDashCap="Round"
                                         RenderTransformOrigin="0.5,0.5">
                                    <Ellipse.RenderTransform>
                                        <RotateTransform Angle="{Binding Angle, Source={x:Static models:SpinnerSync.Instance}}"/>
                                    </Ellipse.RenderTransform>
                                </Ellipse>
                            </StackPanel>
                        </Grid>

                        <!-- 검색창 (설치 가능한 플러그인 필터). 높이 35 — 프로젝트 영역 검색창과 동일 -->
                        <Border Grid.Row="1" Height="35" Margin="0,0,0,8"
                                Background="{DynamicResource PanelSoftBrush}"
                                BorderBrush="{DynamicResource LineBrush}"
                                BorderThickness="1" CornerRadius="8">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <Path Grid.Column="0" Style="{StaticResource LucideIcon}"
                                      Data="{StaticResource IconSearch}"
                                      Stroke="{DynamicResource TextMutedBrush}"
                                      Width="12" Height="12" Margin="11,0,0,0" VerticalAlignment="Center"/>
                                <Grid Grid.Column="1">
                                    <TextBox x:Name="DiscoverSearchBox"
                                             Margin="8,0,0,0" Padding="0" VerticalContentAlignment="Center"
                                             Background="Transparent" BorderThickness="0"
                                             FocusVisualStyle="{x:Null}"
                                             Foreground="{DynamicResource TextBrush}"
                                             CaretBrush="{DynamicResource TextBrush}"
                                             FontSize="{DynamicResource Fs13}"
                                             FontFamily="{StaticResource PretendardFont}"
                                             TextChanged="DiscoverSearchBox_TextChanged">
                                        <TextBox.Resources>
                                            <Style TargetType="Border"><Setter Property="CornerRadius" Value="0"/></Style>
                                        </TextBox.Resources>
                                    </TextBox>
                                    <TextBlock x:Name="DiscoverSearchPlaceholder" Text="플러그인 검색"
                                               IsHitTestVisible="False"
                                               Margin="8,0,0,0" Padding="0" VerticalAlignment="Center"
                                               Foreground="{DynamicResource TextMutedBrush}"
                                               FontSize="{DynamicResource Fs13}"
                                               FontFamily="{StaticResource PretendardFont}">
                                        <TextBlock.Style>
                                            <Style TargetType="TextBlock" BasedOn="{StaticResource {x:Type TextBlock}}">
                                                <Setter Property="Visibility" Value="Collapsed"/>
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding Text, ElementName=DiscoverSearchBox}" Value="">
                                                        <Setter Property="Visibility" Value="Visible"/>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </TextBlock.Style>
                                    </TextBlock>
                                </Grid>
                                <Button x:Name="DiscoverSearchClearBtn" Grid.Column="2"
                                        Width="18" Height="18" Margin="0,0,9,0"
                                        VerticalAlignment="Center" Visibility="Collapsed"
                                        Click="DiscoverSearchClear_Click" Cursor="Arrow"
                                        Background="Transparent" BorderThickness="0"
                                        IsTabStop="False" FocusVisualStyle="{x:Null}" ToolTip="지우기">
                                    <Button.Template>
                                        <ControlTemplate TargetType="Button">
                                            <Border x:Name="Bd" Width="18" Height="18" CornerRadius="4"
                                                    Background="{TemplateBinding Background}">
                                                <Path Style="{StaticResource LucideButtonIcon}"
                                                      Data="{StaticResource IconX}"
                                                      Width="10" Height="10" Stretch="Uniform"
                                                      HorizontalAlignment="Center" VerticalAlignment="Center"
                                                      Stroke="{DynamicResource TextMutedBrush}"/>
                                            </Border>
                                            <ControlTemplate.Triggers>
                                                <Trigger Property="IsMouseOver" Value="True">
                                                    <Setter TargetName="Bd" Property="Background" Value="{DynamicResource LineBrush}"/>
                                                </Trigger>
                                            </ControlTemplate.Triggers>
                                        </ControlTemplate>
                                    </Button.Template>
                                </Button>
                            </Grid>
                        </Border>

                        <!-- 목록 -->
                        <Border Grid.Row="2" CornerRadius="10"
                                Background="{DynamicResource PanelSoftBrush}"
                                BorderBrush="{DynamicResource LineBrush}" BorderThickness="1">
                        <Grid>
                            <ScrollViewer x:Name="DiscoverScroll" VerticalScrollBarVisibility="Auto"
                                          HorizontalScrollBarVisibility="Disabled" Padding="10,10,4,10">
                                <ItemsControl x:Name="DiscoverList">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate DataType="{x:Type models:ClaudeAvailablePlugin}">
                                            <Border Margin="0,0,6,8" Padding="12,10" CornerRadius="10"
                                                    BorderBrush="{DynamicResource LineBrush}" BorderThickness="1"
                                                    Cursor="Arrow" MouseLeftButtonUp="DiscoverCard_Click">
                                                <Border.Style>
                                                    <Style TargetType="Border">
                                                        <Setter Property="Background" Value="{DynamicResource PanelBrush}"/>
                                                        <Style.Triggers>
                                                            <Trigger Property="IsMouseOver" Value="True">
                                                                <Setter Property="Background" Value="{DynamicResource PrimarySoftBrush}"/>
                                                            </Trigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </Border.Style>
                                                <Grid>
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="*"/>
                                                        <ColumnDefinition Width="Auto"/>
                                                    </Grid.ColumnDefinitions>
                                                    <StackPanel Grid.Column="0" VerticalAlignment="Center">
                                                        <StackPanel Orientation="Horizontal">
                                                            <TextBlock Text="{Binding Name}" FontSize="{DynamicResource Fs12}"
                                                                       FontWeight="SemiBold" Foreground="{DynamicResource TextBrush}"
                                                                       TextTrimming="CharacterEllipsis" VerticalAlignment="Center"/>
                                                            <TextBlock Text="{Binding InstallCountText}" FontSize="{DynamicResource Fs10}"
                                                                       Foreground="{DynamicResource TextMutedBrush}" Margin="8,0,0,0"
                                                                       VerticalAlignment="Center"/>
                                                        </StackPanel>
                                                        <TextBlock Text="{Binding Description}" FontSize="{DynamicResource Fs10}"
                                                                   Foreground="{DynamicResource TextMutedBrush}" Margin="0,3,0,0"
                                                                   TextWrapping="Wrap" TextTrimming="None"
                                                                   LineHeight="15" LineStackingStrategy="BlockLineHeight" MaxHeight="30"/>
                                                    </StackPanel>
                                                    <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                                                        <Border Padding="7,3" CornerRadius="6" VerticalAlignment="Center"
                                                                Background="{DynamicResource PanelSoftBrush}"
                                                                Visibility="{Binding IsInstalled, Converter={x:Static models:BoolToVisibilityConverter.Instance}}">
                                                            <TextBlock Text="설치됨" FontSize="{DynamicResource Fs10}"
                                                                       Foreground="{DynamicResource TextMutedBrush}"/>
                                                        </Border>
                                                        <Path Style="{StaticResource LucideIcon}" Data="{StaticResource IconChevronRight}"
                                                              Width="14" Height="14" Margin="6,0,0,0" VerticalAlignment="Center"
                                                              Stroke="{DynamicResource TextMutedBrush}"/>
                                                    </StackPanel>
                                                </Grid>
                                            </Border>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </ScrollViewer>
                            <TextBlock x:Name="DiscoverEmpty" Text="설치 가능한 플러그인이 없습니다"
                                       VerticalAlignment="Center" HorizontalAlignment="Center" Visibility="Collapsed"
                                       FontSize="{DynamicResource Fs11}" Foreground="{DynamicResource TextMutedBrush}"/>
                        </Grid>
                        </Border>
                    </Grid>
                </Grid>
            </Border>
        </Grid>
    </Grid>
</UserControl>
