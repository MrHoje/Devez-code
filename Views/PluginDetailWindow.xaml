<Window x:Class="DevezCode.Views.PluginDetailWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="플러그인" Height="440" Width="740"
        WindowStartupLocation="CenterOwner" ResizeMode="NoResize"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        ShowInTaskbar="False"
        PreviewKeyDown="Window_KeyDown"
        UseLayoutRounding="True"
        SnapsToDevicePixels="True"
        TextOptions.TextFormattingMode="Display"
        TextOptions.TextRenderingMode="ClearType"
        FontFamily="{StaticResource PretendardFont}">

    <Grid Margin="20">
        <!-- Shadow layer -->
        <Border Background="{DynamicResource BgBrush}" CornerRadius="14">
            <Border.Effect>
                <DropShadowEffect ShadowDepth="0" BlurRadius="40" Color="{DynamicResource ShadowColor}" Opacity="{DynamicResource ShadowOpacity}"/>
            </Border.Effect>
        </Border>
        <!-- Content layer -->
        <Border x:Name="ContentRoot" CornerRadius="14"
                Background="{DynamicResource BgBrush}"
                BorderBrush="{DynamicResource LineBrush}" BorderThickness="1"
                ClipToBounds="True">
            <Grid x:Name="ContentClip">
                <Grid.RowDefinitions>
                    <RowDefinition Height="48"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <!-- Header -->
                <Border Grid.Row="0"
                        Background="{DynamicResource PanelBrush}"
                        BorderBrush="{DynamicResource LineBrush}"
                        BorderThickness="0,0,0,1"
                        MouseLeftButtonDown="Header_DragMove">
                    <Grid>
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="16,0,0,0">
                            <TextBlock Text="플러그인 상세" VerticalAlignment="Center"
                                       FontSize="{DynamicResource Fs14}" FontWeight="SemiBold"
                                       Foreground="{DynamicResource TextBrush}"/>
                        </StackPanel>
                        <Button Click="CloseBtn_Click"
                                HorizontalAlignment="Right" VerticalAlignment="Center"
                                Width="40" Height="32" Margin="0,0,8,0"
                                Style="{StaticResource WinCloseBtn}">
                            <TextBlock Text="&#x2715;" FontSize="{DynamicResource Fs11}"/>
                        </Button>
                    </Grid>
                </Border>

                <!-- Body: 좌(정보 + 설치) | 우(출력) -->
                <Grid Grid.Row="1">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <!-- 좌: 정보 + 설치 버튼 -->
                    <Grid Grid.Column="0" Margin="20,18,16,18">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>

                        <StackPanel Grid.Row="0">
                            <TextBlock x:Name="NameText" FontSize="{DynamicResource Fs16}" FontWeight="SemiBold"
                                       Foreground="{DynamicResource TextBrush}" TextWrapping="Wrap"/>
                            <StackPanel Orientation="Horizontal" Margin="0,7,0,0">
                                <Border Padding="7,2" CornerRadius="5" VerticalAlignment="Center"
                                        Background="{DynamicResource PanelBrush}">
                                    <TextBlock x:Name="MarketText" FontSize="{DynamicResource Fs10}"
                                               Foreground="{DynamicResource TextMutedBrush}"/>
                                </Border>
                                <TextBlock x:Name="VersionText" FontSize="{DynamicResource Fs11}"
                                           Foreground="{DynamicResource TextMutedBrush}" Margin="8,0,0,0"
                                           VerticalAlignment="Center"/>
                                <TextBlock x:Name="InstallCountText" FontSize="{DynamicResource Fs11}"
                                           Foreground="{DynamicResource TextMutedBrush}" Margin="8,0,0,0"
                                           VerticalAlignment="Center"/>
                            </StackPanel>
                            <!-- 저장소 링크 (source.url 있을 때) -->
                            <Button x:Name="RepoLink" Click="RepoLink_Click" Margin="0,8,0,0"
                                    HorizontalAlignment="Left" Cursor="Hand" Visibility="Collapsed"
                                    Background="Transparent" BorderThickness="0" Padding="0"
                                    IsTabStop="False" FocusVisualStyle="{x:Null}">
                                <Button.Template>
                                    <ControlTemplate TargetType="Button">
                                        <StackPanel Orientation="Horizontal">
                                            <Path Style="{StaticResource LucideButtonIcon}" Data="{StaticResource IconExternalLink}"
                                                  Width="12" Height="12" Margin="0,0,6,0" VerticalAlignment="Center"
                                                  Stroke="{DynamicResource PrimaryBrush}"/>
                                            <TextBlock x:Name="RepoText" Text="저장소 열기" VerticalAlignment="Center"
                                                       FontSize="{DynamicResource Fs11}" Foreground="{DynamicResource PrimaryBrush}"/>
                                        </StackPanel>
                                    </ControlTemplate>
                                </Button.Template>
                            </Button>
                        </StackPanel>

                        <!-- 설명 -->
                        <Border Grid.Row="1" Margin="0,14,0,0" CornerRadius="10"
                                Background="{DynamicResource PanelSoftBrush}"
                                BorderBrush="{DynamicResource LineBrush}" BorderThickness="1">
                            <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                                <TextBlock x:Name="DescText" Margin="14,12,14,12" TextWrapping="Wrap"
                                           FontSize="{DynamicResource Fs12}" Foreground="{DynamicResource TextBrush}"/>
                            </ScrollViewer>
                        </Border>

                        <!-- 설치 버튼 / 설치됨 -->
                        <Grid Grid.Row="2" Margin="0,14,0,0">
                            <Button x:Name="InstallBtn" Click="InstallBtn_Click"
                                    Height="40" Style="{StaticResource PrimaryButton}"
                                    HorizontalAlignment="Stretch">
                                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                                    <Path Style="{StaticResource LucideButtonIcon}" Data="{StaticResource IconDownload}"
                                          Width="14" Height="14" Margin="0,0,8,0" Stroke="White"/>
                                    <TextBlock Text="설치" Foreground="White" FontWeight="SemiBold"
                                               FontSize="{DynamicResource Fs13}"/>
                                </StackPanel>
                            </Button>
                            <Border x:Name="InstalledChip" Height="40" CornerRadius="10" Visibility="Collapsed"
                                    Background="{DynamicResource PanelSoftBrush}"
                                    BorderBrush="{DynamicResource LineBrush}" BorderThickness="1">
                                <TextBlock Text="설치됨" HorizontalAlignment="Center" VerticalAlignment="Center"
                                           FontSize="{DynamicResource Fs13}" FontWeight="SemiBold"
                                           Foreground="{DynamicResource TextMutedBrush}"/>
                            </Border>
                        </Grid>
                    </Grid>

                    <!-- 우: 출력 -->
                    <Border Grid.Column="1" Background="{DynamicResource PanelBrush}"
                            BorderBrush="{DynamicResource LineBrush}" BorderThickness="1,0,0,0">
                        <Grid Margin="16,16,16,16">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*"/>
                            </Grid.RowDefinitions>
                            <TextBlock Grid.Row="0" Text="출력" Margin="2,0,0,10"
                                       FontSize="{DynamicResource Fs11}" FontWeight="SemiBold"
                                       Foreground="{DynamicResource TextMutedBrush}" VerticalAlignment="Center"/>
                            <Border Grid.Row="1" CornerRadius="10"
                                    Background="{DynamicResource PanelSoftBrush}"
                                    BorderBrush="{DynamicResource LineBrush}" BorderThickness="1">
                                <Grid>
                                    <TextBlock x:Name="OutputPlaceholder" TextWrapping="Wrap" VerticalAlignment="Top"
                                               Margin="14,12,14,12"
                                               FontSize="{DynamicResource Fs11}" Foreground="{DynamicResource TextMutedBrush}"
                                               Text="설치 실행 결과가 여기에 표시됩니다."/>
                                    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                                        <TextBox x:Name="OutputText" IsReadOnly="True" BorderThickness="0"
                                                 Background="Transparent" TextWrapping="Wrap" Margin="14,12,14,12"
                                                 FontFamily="Consolas, Cascadia Code, PretendardFont"
                                                 FontSize="{DynamicResource Fs12}"
                                                 Foreground="{DynamicResource TextBrush}"/>
                                    </ScrollViewer>
                                </Grid>
                            </Border>
                        </Grid>
                    </Border>
                </Grid>
            </Grid>
        </Border>
    </Grid>
</Window>
