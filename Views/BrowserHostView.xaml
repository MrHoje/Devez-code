<UserControl x:Class="DevezCode.Views.BrowserHostView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Background="{DynamicResource BgBrush}"
             FontFamily="{StaticResource PretendardFont}">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition x:Name="ToolbarRow" Height="35"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- 브라우저 툴바 (devez 정합) -->
        <Border x:Name="Toolbar" Grid.Row="0"
                Background="{DynamicResource PanelBrush}"
                BorderBrush="{DynamicResource LineBrush}"
                BorderThickness="0,0,0,1"
                Padding="11,0,8,0">
            <DockPanel LastChildFill="True">
                <Button x:Name="BackBtn" DockPanel.Dock="Left" Width="24" Height="24"
                        Style="{StaticResource IconButton}"
                        Click="BackBtn_Click" ToolTip="뒤로"
                        IsEnabled="False" VerticalAlignment="Center">
                    <Path Style="{StaticResource LucideButtonIcon}"
                          Data="{StaticResource IconArrowLeft}" Width="12" Height="12"/>
                </Button>
                <Button x:Name="ForwardBtn" DockPanel.Dock="Left" Width="24" Height="24"
                        Style="{StaticResource IconButton}"
                        Click="ForwardBtn_Click" ToolTip="앞으로"
                        IsEnabled="False" VerticalAlignment="Center" Margin="2,0,0,0">
                    <Path Style="{StaticResource LucideButtonIcon}"
                          Data="{StaticResource IconArrowRight}" Width="12" Height="12"/>
                </Button>
                <Button x:Name="RefreshBtn" DockPanel.Dock="Left" Width="24" Height="24"
                        Style="{StaticResource IconButton}"
                        Click="RefreshBtn_Click" ToolTip="새로고침"
                        VerticalAlignment="Center" Margin="2,0,6,0">
                    <Path Style="{StaticResource LucideButtonIcon}"
                          Data="{StaticResource IconRotateCcw}" Width="12" Height="12"/>
                </Button>

                <!-- 주소창 -->
                <Border Height="22" VerticalAlignment="Center"
                        Background="{DynamicResource PanelSoftBrush}"
                        BorderBrush="{DynamicResource LineBrush}"
                        BorderThickness="1" CornerRadius="8"
                        Padding="8,0">
                    <TextBox x:Name="AddressBox"
                             BorderThickness="0" Background="Transparent"
                             Foreground="{DynamicResource TextBrush}"
                             CaretBrush="{DynamicResource TextBrush}"
                             FontSize="{DynamicResource Fs12}"
                             FontFamily="{StaticResource PretendardFont}"
                             VerticalContentAlignment="Center" Padding="0"
                             GotKeyboardFocus="AddressBox_GotKeyboardFocus"
                             PreviewMouseLeftButtonDown="AddressBox_PreviewMouseLeftButtonDown"
                             KeyDown="AddressBox_KeyDown"/>
                </Border>
            </DockPanel>
        </Border>

        <!-- WebView2 컨테이너 -->
        <Grid Grid.Row="1" x:Name="BrowserContent"/>

        <!-- airspace 우회용 스냅샷 — 오버레이(설정창 등) 열릴 때 WebView2 대신 표시 -->
        <Image x:Name="BrowserSnapshot" Grid.Row="1" Panel.ZIndex="10"
               Stretch="Fill" Visibility="Collapsed"
               RenderOptions.BitmapScalingMode="HighQuality"/>
    </Grid>
</UserControl>
