<UserControl x:Class="DevezCode.Views.FileExplorerView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:models="clr-namespace:DevezCode.Models"
             Background="{DynamicResource PanelBrush}"
             FontFamily="{StaticResource PretendardFont}">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Header -->
        <Border Grid.Row="0" Height="44"
                BorderBrush="{DynamicResource LineBrush}" BorderThickness="0,0,0,1"
                Background="{DynamicResource PanelBrush}">
            <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="14,0">
                <Path Style="{StaticResource LucideIcon}" Data="{StaticResource IconFolderOpen}"
                      Width="15" Height="15" Stroke="{DynamicResource TextMutedBrush}"/>
                <TextBlock x:Name="PathText" Text="파일 탐색기"
                           Margin="8,0,0,0" VerticalAlignment="Center"
                           FontSize="{DynamicResource Fs12}" FontWeight="SemiBold"
                           TextTrimming="CharacterEllipsis"
                           Foreground="{DynamicResource TextBrush}"/>
            </StackPanel>
        </Border>

        <!-- File tree -->
        <TreeView x:Name="Tree" Grid.Row="1"
                  Background="Transparent" BorderThickness="0"
                  Padding="6,8"
                  ScrollViewer.HorizontalScrollBarVisibility="Auto"
                  VirtualizingStackPanel.IsVirtualizing="True"
                  VirtualizingStackPanel.VirtualizationMode="Recycling">
            <TreeView.Resources>
                <Style TargetType="TreeViewItem">
                    <Setter Property="IsExpanded" Value="{Binding IsExpanded, Mode=TwoWay}"/>
                    <Setter Property="Foreground" Value="{DynamicResource TextBrush}"/>
                    <Setter Property="FontSize" Value="{DynamicResource Fs12}"/>
                </Style>
                <HierarchicalDataTemplate DataType="{x:Type models:FileNode}" ItemsSource="{Binding Children}">
                    <StackPanel Orientation="Horizontal" Margin="0,2" MouseLeftButtonDown="Node_DoubleClick">
                        <Path Style="{StaticResource LucideIcon}"
                              Data="{Binding IsDirectory, Converter={x:Static models:DirIconConverter.Instance}}"
                              Width="13" Height="13"
                              Stroke="{DynamicResource TextMutedBrush}"
                              VerticalAlignment="Center"/>
                        <TextBlock Text="{Binding Name}" Margin="7,0,0,0" VerticalAlignment="Center"
                                   Foreground="{DynamicResource TextBrush}"/>
                    </StackPanel>
                </HierarchicalDataTemplate>
            </TreeView.Resources>
        </TreeView>
    </Grid>
</UserControl>
