<UserControl x:Class="DevezCode.Views.FileExplorerView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:models="clr-namespace:DevezCode.Models"
             xmlns:v="clr-namespace:DevezCode.Views"
             Background="{DynamicResource PanelBrush}"
             FontFamily="{StaticResource PretendardFont}">
    <UserControl.Resources>
        <!-- 상단 뷰 전환 탭 버튼: 아이콘 + 라벨. 활성은 PrimaryBrush, 비활성은 Muted.
             (호버 시 컨텐츠 0.5 투명도 — 배경 박스 없이 텍스트만 하이라이트) -->
        <Style x:Key="ViewTabButton" TargetType="Button">
            <Setter Property="Cursor" Value="Arrow"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="IsTabStop" Value="False"/>
            <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
            <Setter Property="Height" Value="35"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd" Background="{TemplateBinding Background}"
                                Margin="2,4" Padding="7,0" CornerRadius="7">
                            <ContentPresenter x:Name="Cp"
                                              VerticalAlignment="Center" HorizontalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Cp" Property="Opacity" Value="0.5"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </UserControl.Resources>
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- 뷰 전환 메뉴 패널 (최상단): 파일 탐색기 / 브라우저 / DIFF / 작업 큐
             (배경 박스 없이 텍스트만 하이라이트) -->
        <Border Grid.Row="0" Height="35"
                BorderBrush="{DynamicResource LineBrush}" BorderThickness="0,0,0,1"
                Background="{DynamicResource PanelBrush}">
          <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <ScrollViewer x:Name="ViewTabScroller" Grid.Column="0"
                          HorizontalScrollBarVisibility="Hidden" VerticalScrollBarVisibility="Disabled"
                          CanContentScroll="False" Background="{x:Null}"
                          ScrollChanged="ViewTabScroller_ScrollChanged"
                          PreviewMouseWheel="ViewTabScroller_PreviewMouseWheel">
            <StackPanel x:Name="TabBarGrid" Orientation="Horizontal" VerticalAlignment="Stretch" HorizontalAlignment="Left">
                <Button x:Name="DirViewBtn" Click="TabBtn_Click" Tag="0"
                        Style="{StaticResource ViewTabButton}" ToolTip="파일 탐색기">
                    <Path x:Name="DirViewIcon" Style="{StaticResource LucideIcon}"
                          Data="{StaticResource IconFolderOpen}" Width="13" Height="13" VerticalAlignment="Center"/>
                </Button>
                <!-- 작업 큐 (devez 채팅방 풍 버블 입력) — 탐색기 오른쪽에 배치. -->
                <Button x:Name="QueueViewBtn" Click="TabBtn_Click" Tag="3"
                        Style="{StaticResource ViewTabButton}" ToolTip="작업 큐">
                    <Path x:Name="QueueViewIcon" Style="{StaticResource LucideIcon}"
                          Data="{StaticResource IconListTodo}" Width="13" Height="13" VerticalAlignment="Center"/>
                </Button>
                <Button x:Name="BrowserViewBtn" Click="TabBtn_Click" Tag="1"
                        Style="{StaticResource ViewTabButton}" ToolTip="브라우저">
                    <Path x:Name="BrowserViewIcon" Style="{StaticResource LucideIcon}"
                          Data="{StaticResource IconGlobe}" Width="13" Height="13" VerticalAlignment="Center"/>
                </Button>
                <Button x:Name="DiffViewBtn" Click="TabBtn_Click" Tag="2"
                        Style="{StaticResource ViewTabButton}" ToolTip="DIFF">
                    <Path x:Name="DiffViewIcon" Style="{StaticResource LucideIcon}"
                          Data="{StaticResource IconGitCompare}" Width="13" Height="13" VerticalAlignment="Center"/>
                </Button>
                <Button x:Name="TaskViewBtn" Click="TabBtn_Click" Tag="4"
                        Style="{StaticResource ViewTabButton}" ToolTip="작업 태스크 뷰">
                    <Path x:Name="TaskViewIcon" Style="{StaticResource LucideIcon}"
                          Data="{StaticResource IconListChecks}" Width="13" Height="13" VerticalAlignment="Center"/>
                </Button>
            </StackPanel>
            </ScrollViewer>

            <!-- 탭 오버플로우 시 좌·우 스크롤 버튼 (세션 탭 헤더 TabNavGroup 정합) — 평소 숨김 -->
            <StackPanel x:Name="ViewTabNavGroup" Grid.Column="1" Orientation="Horizontal"
                        VerticalAlignment="Center" Margin="2,0,6,0" Visibility="Collapsed"
                        Background="{DynamicResource PanelBrush}">
                <Button x:Name="ViewTabScrollLeftBtn" Style="{StaticResource TabNavButton}"
                        Click="ViewTabScrollLeft_Click" ToolTip="이전">
                    <Path Style="{StaticResource LucideIcon}" Data="{StaticResource IconChevronLeft}"
                          Width="14" Height="14" Stretch="Uniform" StrokeThickness="1.8"
                          Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"/>
                </Button>
                <Button x:Name="ViewTabScrollRightBtn" Style="{StaticResource TabNavButton}"
                        Click="ViewTabScrollRight_Click" Margin="2,0,0,0" ToolTip="다음">
                    <Path Style="{StaticResource LucideIcon}" Data="{StaticResource IconChevronRight}"
                          Width="14" Height="14" Stretch="Uniform" StrokeThickness="1.8"
                          Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"/>
                </Button>
            </StackPanel>
          </Grid>
        </Border>

        <!-- Header: 현재 뷰의 경로/제목 (세션 탭 헤더와 정합: 44).
             큐 모드에서는 Collapsed → row Height=Auto 라 자연스럽게 0 으로 축소되어
             콘텐츠(버블 리스트+입력)가 탭 바로 아래에 이어진다. -->
        <Border x:Name="HeaderBar" Grid.Row="1" Height="35"
                BorderBrush="{DynamicResource LineBrush}" BorderThickness="0,0,0,1"
                Background="{DynamicResource PanelBrush}">
            <Grid Margin="14,0,8,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                    <Path x:Name="HeaderIcon" Style="{StaticResource LucideIcon}" Data="{StaticResource IconFolderOpen}"
                          Width="15" Height="15" Stroke="{DynamicResource TextMutedBrush}" VerticalAlignment="Center"/>
                    <TextBlock x:Name="PathText" Text="파일 탐색기"
                                Margin="8,0,0,0" VerticalAlignment="Center"
                               FontSize="{DynamicResource Fs12}" FontWeight="SemiBold"
                                TextTrimming="CharacterEllipsis"
                                Foreground="{DynamicResource TextBrush}"/>
                </StackPanel>
                <Button x:Name="FileSearchToggleBtn" Grid.Column="1"
                        Width="24" Height="24"
                        Style="{StaticResource IconButton}"
                        Click="FileSearchToggleBtn_Click"
                        ToolTip="파일 검색">
                    <Path Style="{StaticResource LucideButtonIcon}"
                          Data="{StaticResource IconSearch}"
                          Width="12" Height="12"/>
                </Button>
            </Grid>
        </Border>

        <!-- Search row — 좌측 프로젝트 검색과 동일하게 아래로 슬라이드되며 트리를 밀어낸다. -->
        <Border x:Name="FileSearchRow" Grid.Row="2" Height="0"
                ClipToBounds="True">
            <Border Margin="8" Height="35"
                    Background="{DynamicResource PanelSoftBrush}"
                    BorderBrush="{DynamicResource LineBrush}"
                    BorderThickness="1" CornerRadius="8">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <Path Grid.Column="0" Style="{StaticResource LucideIcon}"
                          Data="{StaticResource IconSearch}"
                          Stroke="{DynamicResource TextMutedBrush}"
                          Width="13" Height="13"
                          Margin="10,0,0,0" VerticalAlignment="Center"/>
                    <Grid Grid.Column="1">
                        <TextBox x:Name="FileSearchBox"
                                 Margin="6,0,0,0" Padding="0,0,10,0" VerticalContentAlignment="Center"
                                 Background="Transparent" BorderThickness="0"
                                 FocusVisualStyle="{x:Null}"
                                 Foreground="{DynamicResource TextBrush}"
                                 CaretBrush="{DynamicResource TextBrush}"
                                 FontSize="{DynamicResource Fs13}"
                                 FontFamily="{StaticResource PretendardFont}"
                                 TextChanged="FileSearchBox_TextChanged">
                            <TextBox.Resources>
                                <Style TargetType="Border"><Setter Property="CornerRadius" Value="0"/></Style>
                            </TextBox.Resources>
                        </TextBox>
                        <TextBlock Text="파일 검색"
                                   IsHitTestVisible="False"
                                   Margin="8,0,10,0" Padding="0" VerticalAlignment="Center"
                                   Foreground="{DynamicResource TextMutedBrush}"
                                   FontSize="{DynamicResource Fs13}"
                                   FontFamily="{StaticResource PretendardFont}">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock" BasedOn="{StaticResource {x:Type TextBlock}}">
                                    <Setter Property="Visibility" Value="Collapsed"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding Text, ElementName=FileSearchBox}" Value="">
                                            <Setter Property="Visibility" Value="Visible"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>
                    </Grid>
                </Grid>
            </Border>
        </Border>

        <!-- File tree -->
        <TreeView x:Name="Tree" Grid.Row="3"
                  Background="Transparent" BorderThickness="0"
                  Padding="6,8"
                  ScrollViewer.HorizontalScrollBarVisibility="Auto"
                  VirtualizingStackPanel.IsVirtualizing="True"
                  VirtualizingStackPanel.VirtualizationMode="Recycling"
                  ContextMenuOpening="Tree_ContextMenuOpening">
            <TreeView.Resources>
                <!-- TreeView 펼침 토글(삼각형). 기본 시스템 화살표 대신 테마색 -->
                <Style x:Key="FileTreeExpander" TargetType="ToggleButton">
                    <Setter Property="Focusable" Value="False"/>
                    <Setter Property="Width" Value="16"/>
                    <Setter Property="Height" Value="16"/>
                    <Setter Property="Template">
                        <Setter.Value>
                            <ControlTemplate TargetType="ToggleButton">
                                <Border Background="Transparent" Width="16" Height="16">
                                    <Path x:Name="Arrow" Width="7" Height="7" Stretch="Uniform"
                                          Fill="{DynamicResource TextMutedBrush}"
                                          Data="M 0 0 L 4 4 L 0 8 Z"
                                          RenderTransformOrigin="0.5,0.5"
                                          HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Border>
                                <ControlTemplate.Triggers>
                                    <Trigger Property="IsChecked" Value="True">
                                        <Setter TargetName="Arrow" Property="RenderTransform">
                                            <Setter.Value><RotateTransform Angle="90"/></Setter.Value>
                                        </Setter>
                                    </Trigger>
                                </ControlTemplate.Triggers>
                            </ControlTemplate>
                        </Setter.Value>
                    </Setter>
                </Style>

                <!-- 선택 행: 테마색(PrimarySoftBrush), 호버: PanelSoftBrush — devez 사이드바 정합 -->
                <Style TargetType="TreeViewItem">
                    <Setter Property="IsExpanded" Value="{Binding IsExpanded, Mode=TwoWay}"/>
                    <Setter Property="Foreground" Value="{DynamicResource TextBrush}"/>
                    <Setter Property="FontSize" Value="{DynamicResource Fs13}"/>
                    <EventSetter Event="MouseDoubleClick" Handler="TreeItem_DoubleClick"/>
                    <EventSetter Event="MouseRightButtonDown" Handler="TreeItem_RightClick"/>
                    <Setter Property="Template">
                        <Setter.Value>
                            <ControlTemplate TargetType="TreeViewItem">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition MinWidth="16" Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition/>
                                    </Grid.RowDefinitions>
                                    <ToggleButton x:Name="Expander" Grid.Row="0" Grid.Column="0"
                                                  Style="{StaticResource FileTreeExpander}"
                                                  IsChecked="{Binding IsExpanded, RelativeSource={RelativeSource TemplatedParent}}"
                                                  ClickMode="Press" VerticalAlignment="Center"/>
                                    <Border x:Name="Bd" Grid.Row="0" Grid.Column="1"
                                            CornerRadius="6" Background="Transparent"
                                            Padding="4,3" SnapsToDevicePixels="True">
                                        <ContentPresenter x:Name="PART_Header" ContentSource="Header"
                                                          HorizontalAlignment="Stretch"/>
                                    </Border>
                                    <ItemsPresenter x:Name="ItemsHost" Grid.Row="1" Grid.Column="1"/>
                                </Grid>
                                <ControlTemplate.Triggers>
                                    <Trigger Property="IsExpanded" Value="False">
                                        <Setter TargetName="ItemsHost" Property="Visibility" Value="Collapsed"/>
                                    </Trigger>
                                    <Trigger Property="HasItems" Value="False">
                                        <Setter TargetName="Expander" Property="Visibility" Value="Hidden"/>
                                    </Trigger>
                                    <Trigger SourceName="Bd" Property="IsMouseOver" Value="True">
                                        <Setter TargetName="Bd" Property="Background" Value="{DynamicResource PanelSoftBrush}"/>
                                    </Trigger>
                                    <Trigger Property="IsSelected" Value="True">
                                        <Setter TargetName="Bd" Property="Background" Value="{DynamicResource PrimarySoftBrush}"/>
                                    </Trigger>
                                </ControlTemplate.Triggers>
                            </ControlTemplate>
                        </Setter.Value>
                    </Setter>
                </Style>
                <HierarchicalDataTemplate DataType="{x:Type models:FileNode}" ItemsSource="{Binding Children}">
                    <StackPanel Orientation="Horizontal" Margin="0,2"
                                MouseLeftButtonDown="Node_DoubleClick"
                                MouseRightButtonDown="Node_RightClick">
                        <StackPanel.ContextMenu>
                            <ContextMenu DataContext="{Binding PlacementTarget.DataContext, RelativeSource={RelativeSource Self}}"
                                         Opened="NodeMenu_Opened">
                                <MenuItem Header="실행" Click="Execute_Click" InputGestureText="Enter">
                                    <MenuItem.Icon><Path Style="{StaticResource LucideMenuIcon}" Data="{StaticResource IconPlay}"/></MenuItem.Icon>
                                </MenuItem>
                                <Separator/>
                                <MenuItem Header="잘라내기" Click="Cut_Click" InputGestureText="Ctrl+X">
                                    <MenuItem.Icon><Path Style="{StaticResource LucideMenuIcon}" Data="{StaticResource IconScissors}"/></MenuItem.Icon>
                                </MenuItem>
                                <MenuItem Header="복사" Click="Copy_Click" InputGestureText="Ctrl+C">
                                    <MenuItem.Icon><Path Style="{StaticResource LucideMenuIcon}" Data="{StaticResource IconCopy}"/></MenuItem.Icon>
                                </MenuItem>
                                <MenuItem x:Name="PasteMenuItem" Header="붙여넣기" Click="Paste_Click" InputGestureText="Ctrl+V">
                                    <MenuItem.Icon><Path Style="{StaticResource LucideMenuIcon}" Data="{StaticResource IconClipboard}"/></MenuItem.Icon>
                                </MenuItem>
                                <Separator/>
                                <MenuItem Header="이름 바꾸기" Click="Rename_Click" InputGestureText="F2">
                                    <MenuItem.Icon><Path Style="{StaticResource LucideMenuIcon}" Data="{StaticResource IconPencil}"/></MenuItem.Icon>
                                </MenuItem>
                                <MenuItem Header="삭제" Click="Delete_Click" InputGestureText="Del">
                                    <MenuItem.Icon><Path Style="{StaticResource LucideMenuIcon}" Data="{StaticResource IconTrash2}"/></MenuItem.Icon>
                                </MenuItem>
                                <Separator/>
                                <MenuItem Header="경로 복사" Click="CopyPath_Click">
                                    <MenuItem.Icon><Path Style="{StaticResource LucideMenuIcon}" Data="{StaticResource IconLink}"/></MenuItem.Icon>
                                </MenuItem>
                            </ContextMenu>
                        </StackPanel.ContextMenu>
                        <Path Style="{StaticResource LucideIcon}"
                              Data="{Binding Converter={x:Static models:DirIconConverter.Instance}}"
                              Width="14" Height="14"
                              Stroke="{DynamicResource TextMutedBrush}"
                              VerticalAlignment="Center"/>
                        <TextBlock Text="{Binding Name}" Margin="7,0,0,0" VerticalAlignment="Center"
                                   Foreground="{DynamicResource TextBrush}"/>
                    </StackPanel>
                </HierarchicalDataTemplate>
            </TreeView.Resources>
        </TreeView>

        <!-- 브라우저 뷰 (브라우저 모드일 때만 표시) -->
        <v:BrowserHostView x:Name="Browser" Grid.Row="3" Visibility="Collapsed"/>

        <!-- DIFF 뷰 (DIFF 모드일 때만 표시) — git 변경 내역 + diff -->
        <v:GitDiffView x:Name="DiffView" Grid.Row="3" Visibility="Collapsed"/>

        <!-- 작업 큐 뷰 (큐 모드일 때만 표시) — 버블 입력 + 영속화 -->
        <v:TaskQueueView x:Name="QueueView" Grid.Row="3" Visibility="Collapsed"/>

        <!-- 작업 태스크 뷰 (작업 태스크 모드일 때만 표시) -->
        <v:TaskView x:Name="TaskView" Grid.Row="3" Visibility="Collapsed"/>
    </Grid>
</UserControl>
