<UserControl x:Class="DevezCode.Views.SettingsDialog"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:models="clr-namespace:DevezCode.Models"
             UseLayoutRounding="True"
             SnapsToDevicePixels="True"
             TextOptions.TextFormattingMode="Display"
             TextOptions.TextRenderingMode="ClearType"
             FontFamily="{StaticResource PretendardFont}">

    <UserControl.Resources>
        <!-- 계정 사용량 provider 로그인/재연결 링크 버튼 (아이콘+PrimaryBrush 텍스트, 호버 시 흐려짐) -->
        <Style x:Key="UsageLoginButton" TargetType="Button">
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="0"/>
            <Setter Property="HorizontalAlignment" Value="Left"/>
            <Setter Property="IsTabStop" Value="False"/>
            <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="Transparent"><ContentPresenter x:Name="cp"/></Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="cp" Property="Opacity" Value="0.6"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- 좌측 카테고리 항목 (devez 이식) -->
        <Style x:Key="CategoryItem" TargetType="Button">
            <Setter Property="IsTabStop" Value="False"/>
            <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Foreground" Value="{DynamicResource TextBrush}"/>
            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
            <Setter Property="HorizontalAlignment" Value="Stretch"/>
            <Setter Property="Padding" Value="12,10"/>
            <Setter Property="FontSize" Value="{DynamicResource Fs13}"/>
            <Setter Property="Margin" Value="0,2"/>
            <Setter Property="Cursor" Value="Arrow"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd" Background="{TemplateBinding Background}"
                                CornerRadius="8" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Stretch" VerticalAlignment="Center"
                                              TextElement.Foreground="{TemplateBinding Foreground}"
                                              TextElement.FontWeight="{TemplateBinding FontWeight}"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource PanelBrush}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- ── 설정 폼 콤보박스 (devez 이식: 둥근 카드 + chevron + 테마 드롭다운) ── -->
        <Style x:Key="ThemedComboItem" TargetType="ComboBoxItem">
            <Setter Property="Foreground" Value="{DynamicResource TextBrush}"/>
            <Setter Property="FontSize" Value="{DynamicResource Fs13}"/>
            <Setter Property="FontFamily" Value="{StaticResource PretendardFont}"/>
            <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ComboBoxItem">
                        <Border x:Name="Bd" Background="Transparent" CornerRadius="6"
                                Padding="10,8" Margin="3,1">
                            <ContentPresenter/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsHighlighted" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource PanelSoftBrush}"/>
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource PrimarySoftBrush}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="ThemedCombo" TargetType="ComboBox">
            <Setter Property="Foreground" Value="{DynamicResource TextBrush}"/>
            <Setter Property="FontFamily" Value="{StaticResource PretendardFont}"/>
            <Setter Property="FontSize" Value="{DynamicResource Fs13}"/>
            <Setter Property="Height" Value="38"/>
            <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
            <Setter Property="ItemContainerStyle" Value="{StaticResource ThemedComboItem}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ComboBox">
                        <Grid>
                            <ToggleButton x:Name="ToggleBd" Focusable="False" ClickMode="Press"
                                          IsChecked="{Binding IsDropDownOpen, Mode=TwoWay, RelativeSource={RelativeSource TemplatedParent}}">
                                <ToggleButton.Template>
                                    <ControlTemplate TargetType="ToggleButton">
                                        <Border x:Name="Bd" CornerRadius="10" BorderThickness="1"
                                                BorderBrush="{DynamicResource LineBrush}"
                                                Background="{DynamicResource PanelBrush}">
                                            <Path HorizontalAlignment="Right" VerticalAlignment="Center"
                                                  Margin="0,0,14,0"
                                                  Data="{DynamicResource IconChevronDown}"
                                                  Stroke="{DynamicResource TextMutedBrush}" StrokeThickness="2"
                                                  StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round"
                                                  Width="12" Height="12" Stretch="Uniform" Fill="Transparent"/>
                                        </Border>
                                    </ControlTemplate>
                                </ToggleButton.Template>
                            </ToggleButton>
                            <ContentPresenter Content="{TemplateBinding SelectionBoxItem}"
                                              ContentTemplate="{TemplateBinding SelectionBoxItemTemplate}"
                                              IsHitTestVisible="False"
                                              Margin="14,0,36,0" VerticalAlignment="Center"/>
                            <Popup x:Name="PART_Popup" Placement="Bottom" VerticalOffset="2"
                                   IsOpen="{TemplateBinding IsDropDownOpen}"
                                   AllowsTransparency="True" Focusable="False">
                                <Border Background="{DynamicResource PanelBrush}"
                                        BorderBrush="{DynamicResource LineBrush}" BorderThickness="1"
                                        CornerRadius="8" SnapsToDevicePixels="True"
                                        MinWidth="{Binding ActualWidth, RelativeSource={RelativeSource AncestorType=ComboBox}}">
                                    <ScrollViewer MaxHeight="220" Background="Transparent" Margin="2">
                                        <ItemsPresenter/>
                                    </ScrollViewer>
                                </Border>
                            </Popup>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Discord 패널 입력 필드 라벨 (MCP 관리자 폼과 동일 톤) -->
        <Style x:Key="DiscordFieldLabel" TargetType="TextBlock" BasedOn="{StaticResource {x:Type TextBlock}}">
            <Setter Property="FontSize" Value="{DynamicResource Fs11}"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="{DynamicResource TextMutedBrush}"/>
            <Setter Property="Margin" Value="0,0,0,7"/>
        </Style>

        <!-- Discord 입력 카드 (둥근 모서리 + 포커스 시 PrimaryBrush 테두리) -->
        <Style x:Key="DiscordFieldBox" TargetType="Border" BasedOn="{StaticResource AuthInputBorder}">
            <Setter Property="Height" Value="38"/>
            <Setter Property="Padding" Value="12,0"/>
        </Style>
    </UserControl.Resources>

    <!-- 설정창 콘텐츠 (devez SettingsDialog 이식).
         둥근 모서리/그림자/외곽선은 부모 SettingsWindow 가 담당하고, 이 컨트롤은 콘텐츠만 채운다.
         라운드 클립이 부모 Border(ClipToBounds=True)에서 적용되므로 자식 영역은 직각이어도 된다. -->
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="48"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

                    <!-- Header: 아이콘 + "설정" + 닫기. 좌상단 드래그 → 부모 SettingsWindow 이동 -->
                    <Border Grid.Row="0"
                            Background="{DynamicResource PanelBrush}"
                            BorderBrush="{DynamicResource LineBrush}"
                            BorderThickness="0,0,0,1"
                            MouseLeftButtonDown="Header_DragMove">
                        <Grid>
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="16,0,0,0">
                                <Path Style="{StaticResource LucideIcon}"
                                      Data="{StaticResource IconSettings}"
                                      Width="16" Height="16" VerticalAlignment="Center"
                                      Stroke="{DynamicResource TextBrush}"
                                      Margin="0,-1,11,0"/>
                                <TextBlock Text="설정" VerticalAlignment="Center"
                                           FontSize="{DynamicResource Fs14}" FontWeight="SemiBold"
                                           Foreground="{DynamicResource TextBrush}"/>
                            </StackPanel>
                            <Button Click="CancelBtn_Click"
                                    HorizontalAlignment="Right" VerticalAlignment="Center"
                                    Width="40" Height="32" Margin="0,0,8,0"
                                    Style="{StaticResource WinCloseBtn}">
                                <TextBlock Text="&#x2715;" FontSize="{DynamicResource Fs11}"/>
                            </Button>
                        </Grid>
                    </Border>

                    <!-- Body: 좌측 카테고리 | 우측 콘텐츠 -->
                    <Grid Grid.Row="1">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="170"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <!-- 좌측 카테고리 -->
                        <Border Grid.Column="0"
                                Background="{DynamicResource PanelSoftBrush}"
                                BorderBrush="{DynamicResource LineBrush}"
                                BorderThickness="0,0,1,0">
                            <StackPanel Margin="10,16,10,16">
                                <Button x:Name="CatGeneralBtn" Tag="general"
                                        Style="{StaticResource CategoryItem}" Click="Category_Click">
                                    <StackPanel Orientation="Horizontal">
                                        <Path Style="{StaticResource LucideButtonIcon}"
                                              Data="{StaticResource IconSettings}" Width="15" Height="15"
                                              Margin="0,0,10,0" VerticalAlignment="Center"/>
                                        <TextBlock Text="일반" VerticalAlignment="Center"/>
                                    </StackPanel>
                                </Button>
                                <Button x:Name="CatNotifyBtn" Tag="notify"
                                        Style="{StaticResource CategoryItem}" Click="Category_Click">
                                    <StackPanel Orientation="Horizontal">
                                        <Path Style="{StaticResource LucideButtonIcon}"
                                              Data="{StaticResource IconBell}" Width="15" Height="15"
                                              Margin="0,0,10,0" VerticalAlignment="Center"/>
                                        <TextBlock Text="알림" VerticalAlignment="Center"/>
                                    </StackPanel>
                                </Button>
                                <Button x:Name="CatDiscordBtn" Tag="discord" Visibility="Collapsed"
                                        Style="{StaticResource CategoryItem}" Click="Category_Click">
                                    <StackPanel Orientation="Horizontal">
                                        <Path Style="{StaticResource LucideButtonIcon}"
                                              Data="{StaticResource IconServer}" Width="15" Height="15"
                                              Margin="0,0,10,0" VerticalAlignment="Center"/>
                                        <TextBlock Text="Discord" VerticalAlignment="Center"/>
                                    </StackPanel>
                                </Button>
                                <Button x:Name="CatProjectBtn" Tag="project"
                                        Style="{StaticResource CategoryItem}" Click="Category_Click">
                                    <StackPanel Orientation="Horizontal">
                                        <Path Style="{StaticResource LucideButtonIcon}"
                                              Data="{StaticResource IconFolder}" Width="15" Height="15"
                                              Margin="0,0,10,0" VerticalAlignment="Center"/>
                                        <TextBlock Text="프로젝트" VerticalAlignment="Center"/>
                                    </StackPanel>
                                </Button>
                                <Button x:Name="CatThemeBtn" Tag="theme"
                                        Style="{StaticResource CategoryItem}" Click="Category_Click">
                                    <StackPanel Orientation="Horizontal">
                                        <Path Style="{StaticResource LucideButtonIcon}"
                                              Data="{StaticResource IconPalette}" Width="15" Height="15"
                                              Margin="0,0,10,0" VerticalAlignment="Center"/>
                                        <TextBlock Text="테마/글꼴" VerticalAlignment="Center"/>
                                    </StackPanel>
                                </Button>
                                <Button x:Name="CatAgentBtn" Tag="agent"
                                        Style="{StaticResource CategoryItem}" Click="Category_Click">
                                    <StackPanel Orientation="Horizontal">
                                        <Path Style="{StaticResource LucideButtonIcon}"
                                              Data="{StaticResource IconTerminal}" Width="15" Height="15"
                                              Margin="0,0,10,0" VerticalAlignment="Center"/>
                                        <TextBlock Text="에이전트" VerticalAlignment="Center"/>
                                    </StackPanel>
                                </Button>
                                <Button x:Name="CatSidePanelBtn" Tag="sidepanel"
                                        Style="{StaticResource CategoryItem}" Click="Category_Click">
                                    <StackPanel Orientation="Horizontal">
                                        <Path Style="{StaticResource LucideButtonIcon}"
                                              Data="{StaticResource IconPanelLeft}" Width="15" Height="15"
                                              Margin="0,0,10,0" VerticalAlignment="Center"/>
                                        <TextBlock Text="사이드 패널" VerticalAlignment="Center"/>
                                    </StackPanel>
                                </Button>
                                <Button x:Name="CatUsageBtn" Tag="usage"
                                        Style="{StaticResource CategoryItem}" Click="Category_Click">
                                    <StackPanel Orientation="Horizontal">
                                        <Path Style="{StaticResource LucideButtonIcon}"
                                              Data="{StaticResource IconChartBar}" Width="15" Height="15"
                                              Margin="0,0,10,0" VerticalAlignment="Center"/>
                                        <TextBlock Text="계정 사용량" VerticalAlignment="Center"/>
                                    </StackPanel>
                                </Button>
                                <Button x:Name="CatShortcutBtn" Tag="shortcut"
                                        Style="{StaticResource CategoryItem}" Click="Category_Click">
                                    <StackPanel Orientation="Horizontal">
                                        <Path Style="{StaticResource LucideButtonIcon}"
                                              Data="{StaticResource IconZap}" Width="15" Height="15"
                                              Margin="0,0,10,0" VerticalAlignment="Center"/>
                                        <TextBlock Text="단축키" VerticalAlignment="Center"/>
                                    </StackPanel>
                                </Button>
                                <Button x:Name="CatChangelogBtn" Tag="changelog"
                                        Style="{StaticResource CategoryItem}" Click="Category_Click">
                                    <StackPanel Orientation="Horizontal">
                                        <Path Style="{StaticResource LucideButtonIcon}"
                                              Data="{StaticResource IconClock}" Width="15" Height="15"
                                              Margin="0,0,10,0" VerticalAlignment="Center"/>
                                        <TextBlock Text="업데이트 내역" VerticalAlignment="Center"/>
                                    </StackPanel>
                                </Button>
                                <!-- MCP 카테고리 보류 (2026-06): Visibility="Collapsed" — 재활성 시 제거 -->
                                <Button x:Name="CatMcpBtn" Tag="mcp" Visibility="Collapsed"
                                        Style="{StaticResource CategoryItem}" Click="Category_Click">
                                    <StackPanel Orientation="Horizontal">
                                        <Path Style="{StaticResource LucideButtonIcon}"
                                              Data="{StaticResource IconServer}" Width="15" Height="15"
                                              Margin="0,0,10,0" VerticalAlignment="Center"/>
                                        <TextBlock Text="MCP 서버" VerticalAlignment="Center"/>
                                    </StackPanel>
                                </Button>
                            </StackPanel>
                        </Border>

                        <!-- 우측 콘텐츠 -->
                        <ScrollViewer Grid.Column="1" VerticalScrollBarVisibility="Auto"
                                      HorizontalScrollBarVisibility="Disabled"
                                      Background="{DynamicResource PanelBrush}">
                          <Grid>
                            <!-- 일반 패널 -->
                            <StackPanel x:Name="GeneralPanel" Margin="28,22,28,20">
                                <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                                    <Path Style="{StaticResource LucideIcon}" Data="{StaticResource IconSettings}"
                                          Width="16" Height="16" VerticalAlignment="Center" Margin="0,0,9,0"
                                          Stroke="{DynamicResource TextBrush}"/>
                                    <TextBlock Text="일반" FontSize="{DynamicResource Fs14}" FontWeight="SemiBold"
                                               Foreground="{DynamicResource TextBrush}" VerticalAlignment="Center"/>
                                </StackPanel>
                                <TextBlock Text="프로젝트와 세션의 기본 동작을 설정합니다." FontSize="{DynamicResource Fs12}"
                                           Foreground="{DynamicResource TextMutedBrush}" Margin="0,0,0,20"/>

                                <Border Padding="0" CornerRadius="0"
                                        BorderThickness="0" Background="Transparent" Margin="0,16,0,0">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <StackPanel Grid.Column="0" VerticalAlignment="Center">
                                            <TextBlock Text="프로젝트 선택 시 세션 모두 로드" FontSize="{DynamicResource Fs13}"
                                                       Foreground="{DynamicResource TextBrush}"/>
                                            <TextBlock Text="끄면 첫 번째 세션만 실행하고, 다른 세션은 선택할 때 로드합니다."
                                                       FontSize="{DynamicResource Fs11}" TextWrapping="Wrap"
                                                       Foreground="{DynamicResource TextMutedBrush}" Margin="0,3,12,0"/>
                                        </StackPanel>
                                        <CheckBox x:Name="PreloadAllSessionsToggle" Grid.Column="1"
                                                  Style="{StaticResource ToggleSwitch}" VerticalAlignment="Center"
                                                  Checked="PreloadAllSessionsToggle_Changed" Unchecked="PreloadAllSessionsToggle_Changed"/>
                                    </Grid>
                                </Border>

                                <Border Padding="0" CornerRadius="0"
                                        BorderThickness="0" Background="Transparent" Margin="0,16,0,0">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <StackPanel Grid.Column="0" VerticalAlignment="Center">
                                            <TextBlock Text="프로그램 실행 시 프로젝트 자동 로드" FontSize="{DynamicResource Fs13}"
                                                       Foreground="{DynamicResource TextBrush}"/>
                                            <TextBlock Text="켜면 시작할 때 마지막으로 보던 프로젝트를 자동으로 불러옵니다."
                                                       FontSize="{DynamicResource Fs11}" TextWrapping="Wrap"
                                                       Foreground="{DynamicResource TextMutedBrush}" Margin="0,3,12,0"/>
                                        </StackPanel>
                                        <CheckBox x:Name="AutoLoadLastProjectToggle" Grid.Column="1"
                                                  Style="{StaticResource ToggleSwitch}" VerticalAlignment="Center"
                                                  Checked="AutoLoadLastProjectToggle_Changed" Unchecked="AutoLoadLastProjectToggle_Changed"/>
                                    </Grid>
                                </Border>

                                <Border Padding="0" CornerRadius="0"
                                        BorderThickness="0" Background="Transparent" Margin="0,16,0,0">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <StackPanel Grid.Column="0" VerticalAlignment="Center">
                                            <TextBlock Text="선택된 프로젝트 정보 헤더 숨기기" FontSize="{DynamicResource Fs13}"
                                                       Foreground="{DynamicResource TextBrush}"/>
                                            <TextBlock Text="켜면 세션 탭 위의 프로젝트명·경로·모델·effort 영역을 숨깁니다."
                                                       FontSize="{DynamicResource Fs11}" TextWrapping="Wrap"
                                                       Foreground="{DynamicResource TextMutedBrush}" Margin="0,3,12,0"/>
                                        </StackPanel>
                                        <CheckBox x:Name="HideProjectInfoHeaderToggle" Grid.Column="1"
                                                  Style="{StaticResource ToggleSwitch}" VerticalAlignment="Center"
                                                  Checked="HideProjectInfoHeaderToggle_Changed" Unchecked="HideProjectInfoHeaderToggle_Changed"/>
                                    </Grid>
                                </Border>

                                <Border Padding="0" CornerRadius="0"
                                        BorderThickness="0" Background="Transparent" Margin="0,16,0,0">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <StackPanel Grid.Column="0" VerticalAlignment="Center">
                                            <TextBlock Text="전체화면 사용" FontSize="{DynamicResource Fs13}"
                                                       Foreground="{DynamicResource TextBrush}"/>
                                            <TextBlock Text="켜면 창을 최대화할 때 작업표시줄까지 덮는 전체화면으로 표시합니다."
                                                       FontSize="{DynamicResource Fs11}" TextWrapping="Wrap"
                                                       Foreground="{DynamicResource TextMutedBrush}" Margin="0,3,12,0"/>
                                        </StackPanel>
                                        <CheckBox x:Name="UseFullScreenToggle" Grid.Column="1"
                                                  Style="{StaticResource ToggleSwitch}" VerticalAlignment="Center"
                                                  Checked="UseFullScreenToggle_Changed" Unchecked="UseFullScreenToggle_Changed"/>
                                    </Grid>
                                </Border>
                            </StackPanel>

                            <!-- 프로젝트 패널 — 목록 열 수(1/2) -->
                            <StackPanel x:Name="ProjectPanel" Margin="28,22,28,20" Visibility="Collapsed">
                                <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                                    <Path Style="{StaticResource LucideIcon}" Data="{StaticResource IconFolder}"
                                          Width="16" Height="16" VerticalAlignment="Center" Margin="0,0,9,0"
                                          Stroke="{DynamicResource TextBrush}"/>
                                    <TextBlock Text="프로젝트" FontSize="{DynamicResource Fs14}" FontWeight="SemiBold"
                                               Foreground="{DynamicResource TextBrush}" VerticalAlignment="Center"/>
                                </StackPanel>
                                <TextBlock Text="좌측 프로젝트 목록을 몇 열로 표시할지 선택합니다." FontSize="{DynamicResource Fs12}"
                                           Foreground="{DynamicResource TextMutedBrush}" Margin="0,0,0,4"/>
                                <TextBlock Text="2열로 두면 좌측 패널 최소 너비가 넓어지고, 카드를 가로로 끌어 옮길 수 있습니다."
                                           FontSize="{DynamicResource Fs11}" TextWrapping="Wrap"
                                           Foreground="{DynamicResource TextMutedBrush}" Margin="0,0,0,16"/>

                                <TextBlock Text="목록 열 수" FontSize="{DynamicResource Fs13}" FontWeight="SemiBold"
                                           Foreground="{DynamicResource TextBrush}" Margin="0,4,0,12"/>
                                <StackPanel Orientation="Horizontal">
                                    <!-- 1열 -->
                                    <Border x:Name="ColCard_1" Tag="1" Width="120" Height="56"
                                            BorderBrush="{DynamicResource LineBrush}" BorderThickness="2"
                                            Background="{DynamicResource PanelBrush}" CornerRadius="10" Margin="0,0,10,0"
                                            Cursor="Arrow" MouseLeftButtonDown="ProjectColumnsCard_Click">
                                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center">
                                            <Grid Width="14" Height="14" Margin="0,0,8,0">
                                                <Ellipse Stroke="{DynamicResource LineBrush}" StrokeThickness="1.5"/>
                                                <Ellipse x:Name="ColRadioDot_1" Width="7" Height="7"
                                                         Fill="{DynamicResource PrimaryBrush}" Visibility="Collapsed"/>
                                            </Grid>
                                            <TextBlock Text="1열" FontSize="{DynamicResource Fs13}"
                                                       Foreground="{DynamicResource TextBrush}" VerticalAlignment="Center"/>
                                        </StackPanel>
                                    </Border>
                                    <!-- 2열 -->
                                    <Border x:Name="ColCard_2" Tag="2" Width="120" Height="56"
                                            BorderBrush="{DynamicResource LineBrush}" BorderThickness="2"
                                            Background="{DynamicResource PanelBrush}" CornerRadius="10" Margin="0,0,10,0"
                                            Cursor="Arrow" MouseLeftButtonDown="ProjectColumnsCard_Click">
                                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center">
                                            <Grid Width="14" Height="14" Margin="0,0,8,0">
                                                <Ellipse Stroke="{DynamicResource LineBrush}" StrokeThickness="1.5"/>
                                                <Ellipse x:Name="ColRadioDot_2" Width="7" Height="7"
                                                         Fill="{DynamicResource PrimaryBrush}" Visibility="Collapsed"/>
                                            </Grid>
                                            <TextBlock Text="2열" FontSize="{DynamicResource Fs13}"
                                                       Foreground="{DynamicResource TextBrush}" VerticalAlignment="Center"/>
                                        </StackPanel>
                                    </Border>
                                </StackPanel>
                            </StackPanel>

                            <!-- 에이전트 패널 (설치된 CLI + 활성화 토글) -->
                            <StackPanel x:Name="AgentPanel" Margin="28,22,28,20" Visibility="Collapsed">
                                <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                                    <Path Style="{StaticResource LucideIcon}" Data="{StaticResource IconTerminal}"
                                          Width="16" Height="16" VerticalAlignment="Center" Margin="0,0,9,0"
                                          Stroke="{DynamicResource TextBrush}"/>
                                    <TextBlock Text="에이전트" FontSize="{DynamicResource Fs14}" FontWeight="SemiBold"
                                               Foreground="{DynamicResource TextBrush}" VerticalAlignment="Center"/>
                                </StackPanel>
                                <TextBlock Text="세션 추가 시 사용할 에이전트(CLI)를 선택합니다. PATH 에서 자동 감지합니다." FontSize="{DynamicResource Fs12}"
                                           Foreground="{DynamicResource TextMutedBrush}" Margin="0,0,0,18"/>

                                <ItemsControl x:Name="AgentList">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Border Margin="0,0,0,18" Padding="0,0,0,18" CornerRadius="0"
                                                    BorderBrush="{DynamicResource LineBrush}" BorderThickness="0,0,0,1"
                                                    Background="Transparent">
                                                <Grid>
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="*"/>
                                                        <ColumnDefinition Width="Auto"/>
                                                    </Grid.ColumnDefinitions>
                                                    <StackPanel Grid.Column="0" VerticalAlignment="Center">
                                                        <StackPanel Orientation="Horizontal">
                                                            <TextBlock Text="{Binding DisplayName}" FontSize="{DynamicResource Fs13}" FontWeight="SemiBold"
                                                                       Foreground="{DynamicResource TextBrush}" VerticalAlignment="Center"/>
                                                            <Border Margin="8,0,0,0" Padding="6,1" CornerRadius="4"
                                                                    Background="{Binding InstalledBrush}">
                                                                <TextBlock Text="{Binding InstalledLabel}" FontSize="{DynamicResource Fs10}"
                                                                           Foreground="White" VerticalAlignment="Center"/>
                                                            </Border>
                                                        </StackPanel>
                                                        <TextBlock Text="{Binding CommandHint}" FontSize="{DynamicResource Fs11}"
                                                                   Foreground="{DynamicResource TextMutedBrush}" Margin="0,3,0,0"/>
                                                        <!-- Claude Code 전용: 세션 유지기간 (~/.claude/settings.json 의 cleanupPeriodDays) -->
                                                        <StackPanel Margin="0,12,0,0"
                                                                    Visibility="{Binding IsClaudeCode, Converter={x:Static models:BoolVisibilityConverter.Instance}}">
                                                            <StackPanel Orientation="Horizontal">
                                                                <TextBlock Text="마지막 접근 후" FontSize="{DynamicResource Fs12}"
                                                                           Foreground="{DynamicResource TextBrush}" VerticalAlignment="Center"/>
                                                                <ComboBox Style="{StaticResource DockComboBox}" Margin="10,0,0,0" Width="108"
                                                                          VerticalAlignment="Center"
                                                                          ItemsSource="{Binding RetentionOptions}"
                                                                          DisplayMemberPath="Label" SelectedValuePath="Days"
                                                                          SelectedValue="{Binding RetentionDays, Mode=TwoWay}"/>
                                                            </StackPanel>
                                                            <TextBlock Text="설정 기간 동안 다시 열리지 않은 세션 기록을 Claude Code 가 자동 정리합니다. (전역설정)"
                                                                       FontSize="{DynamicResource Fs11}" Margin="0,6,0,0" TextWrapping="Wrap"
                                                                       Foreground="{DynamicResource TextMutedBrush}"/>
                                                        </StackPanel>
                                                    </StackPanel>
                                                    <CheckBox Grid.Column="1" IsChecked="{Binding Enabled, Mode=TwoWay}"
                                                              IsEnabled="{Binding Installed}"
                                                              Style="{StaticResource ToggleSwitch}" VerticalAlignment="Center"/>
                                                </Grid>
                                            </Border>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>

                                <!-- OAuth 토큰 외부 연동 경고 -->
                                <Border Margin="0,4,0,0" Padding="12,10" CornerRadius="10"
                                        Background="{DynamicResource PanelSoftBrush}"
                                        BorderBrush="{DynamicResource DangerBrush}" BorderThickness="1.5"
                                        SnapsToDevicePixels="False" UseLayoutRounding="False"
                                        RenderOptions.EdgeMode="Unspecified">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>
                                        <Path Grid.Column="0" Style="{StaticResource LucideIcon}" Data="{StaticResource IconTriangleAlert}"
                                              Width="15" Height="15" Margin="0,1,10,0" VerticalAlignment="Top"
                                              Stroke="{DynamicResource DangerBrush}"/>
                                        <TextBlock Grid.Column="1" TextWrapping="Wrap" FontSize="{DynamicResource Fs11}"
                                                   Foreground="{DynamicResource TextBrush}" LineHeight="17">
                                            <Run Text="Claude Code의 OAuth 토큰을 외부 서드파티 툴이나 커스텀 에이전트에 연동하는 경우, 약관 위반으로 계정이 정지될 수 있습니다."/>
                                            <Run Text="외부 연동은 반드시 정식 API Key 또는 다른 정액제 플랜을 사용하세요."/>
                                            <LineBreak/>
                                            <Run Text="- OpenCode, Gajae Code"/>
                                        </TextBlock>
                                    </Grid>
                                </Border>
                            </StackPanel>

                            <!-- MCP 서버 패널 (별도 오버레이로 열기 — Theme/Agent 와 성격이 다름) -->
                            <StackPanel x:Name="McpPanel" Margin="28,22,28,20" Visibility="Collapsed">
                                <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                                    <Path Style="{StaticResource LucideIcon}" Data="{StaticResource IconServer}"
                                          Width="16" Height="16" VerticalAlignment="Center" Margin="0,0,9,0"
                                          Stroke="{DynamicResource TextBrush}"/>
                                    <TextBlock Text="MCP 서버" FontSize="{DynamicResource Fs14}" FontWeight="SemiBold"
                                               Foreground="{DynamicResource TextBrush}" VerticalAlignment="Center"/>
                                </StackPanel>
                                <TextBlock Text="opencode 의 MCP(Model Context Protocol) 서버를 추가·편집·삭제합니다." FontSize="{DynamicResource Fs12}"
                                           Foreground="{DynamicResource TextMutedBrush}" Margin="0,0,0,4"/>
                                <TextBlock Text="저장 시 ~/.config/opencode/opencode.json 의 mcp 섹션만 갱신합니다. 다른 필드는 보존됩니다."
                                           FontSize="{DynamicResource Fs11}" Foreground="{DynamicResource TextMutedBrush}" Margin="0,0,0,16"/>
                                <Button Style="{StaticResource PrimaryButton}" Click="OpenMcpManager_Click"
                                        Height="40" HorizontalAlignment="Left" Padding="18,0">
                                    <StackPanel Orientation="Horizontal">
                                        <Path Style="{StaticResource LucideButtonIcon}" Data="{StaticResource IconServer}"
                                              Width="13" Height="13" Margin="0,0,8,0" Stroke="White"/>
                                        <TextBlock Text="MCP 서버 관리 열기" FontSize="{DynamicResource Fs12}" FontWeight="SemiBold"/>
                                    </StackPanel>
                                </Button>
                            </StackPanel>

                            <!-- 업데이트 내역(Changelog) 패널 — devez 정합 -->
                            <StackPanel x:Name="ChangelogPanel" Margin="28,22,28,20" Visibility="Collapsed">
                                <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                                    <Path Style="{StaticResource LucideIcon}" Data="{StaticResource IconClock}"
                                          Width="16" Height="16" VerticalAlignment="Center" Margin="0,0,9,0"
                                          Stroke="{DynamicResource TextBrush}"/>
                                    <TextBlock Text="업데이트 내역" FontSize="{DynamicResource Fs14}" FontWeight="SemiBold"
                                               Foreground="{DynamicResource TextBrush}" VerticalAlignment="Center"/>
                                </StackPanel>

                                <!-- 버전 카드는 코드비하인드에서 동적 생성 -->
                                <StackPanel x:Name="ChangelogItemsHost" Margin="0,16,0,0"/>

                                <!-- 페이지네이션 -->
                                <Grid x:Name="ChangelogPager" Margin="0,10,0,0" Visibility="Collapsed">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <Button Grid.Column="0" x:Name="PrevPageBtn" Click="PrevPageBtn_Click"
                                            HorizontalAlignment="Left"
                                            Style="{StaticResource CategoryItem}" Padding="10,6" Margin="0">
                                        <StackPanel Orientation="Horizontal">
                                            <Path Style="{StaticResource LucideButtonIcon}"
                                                  Data="{StaticResource IconChevronRight}"
                                                  Width="14" Height="14" Margin="0,0,4,0" VerticalAlignment="Center"
                                                  RenderTransformOrigin="0.5,0.5">
                                                <Path.RenderTransform>
                                                    <ScaleTransform ScaleX="-1"/>
                                                </Path.RenderTransform>
                                            </Path>
                                            <TextBlock Text="이전" FontSize="{DynamicResource Fs12}" VerticalAlignment="Center"/>
                                        </StackPanel>
                                    </Button>
                                    <TextBlock Grid.Column="1" x:Name="PageIndicator"
                                               FontSize="{DynamicResource Fs12}" VerticalAlignment="Center"
                                               Foreground="{DynamicResource TextMutedBrush}"
                                               HorizontalAlignment="Center"/>
                                    <Button Grid.Column="2" x:Name="NextPageBtn" Click="NextPageBtn_Click"
                                            HorizontalAlignment="Right"
                                            Style="{StaticResource CategoryItem}" Padding="10,6" Margin="0">
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock Text="다음" FontSize="{DynamicResource Fs12}" VerticalAlignment="Center"/>
                                            <Path Style="{StaticResource LucideButtonIcon}"
                                                  Data="{StaticResource IconChevronRight}"
                                                  Width="14" Height="14" Margin="4,0,0,0" VerticalAlignment="Center"/>
                                        </StackPanel>
                                    </Button>
                                </Grid>
                            </StackPanel>

                            <!-- 사이드 패널 버튼 표시/숨김 패널 -->
                            <StackPanel x:Name="SidePanelPanel" Margin="28,22,28,20" Visibility="Collapsed">
                                <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                                    <Path Style="{StaticResource LucideIcon}" Data="{StaticResource IconPanelLeft}"
                                          Width="16" Height="16" VerticalAlignment="Center" Margin="0,0,9,0"
                                          Stroke="{DynamicResource TextBrush}"/>
                                    <TextBlock Text="사이드 패널" FontSize="{DynamicResource Fs14}" FontWeight="SemiBold"
                                               Foreground="{DynamicResource TextBrush}" VerticalAlignment="Center"/>
                                </StackPanel>
                                <TextBlock Text="우측 패널 상단의 뷰 전환 버튼 표시 여부를 선택합니다." FontSize="{DynamicResource Fs12}"
                                           Foreground="{DynamicResource TextMutedBrush}" Margin="0,0,0,20"/>

                                <Border Padding="0" CornerRadius="0"
                                        BorderThickness="0" Background="Transparent" Margin="0,16,0,0">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <StackPanel Grid.Column="0" VerticalAlignment="Center">
                                            <TextBlock Text="탐색기" FontSize="{DynamicResource Fs13}"
                                                       Foreground="{DynamicResource TextBrush}"/>
                                            <TextBlock Text="파일 탐색기 뷰 전환 버튼" FontSize="{DynamicResource Fs11}"
                                                       Foreground="{DynamicResource TextMutedBrush}" Margin="0,3,0,0"/>
                                        </StackPanel>
                                        <CheckBox x:Name="ShowDirViewToggle" Grid.Column="1"
                                                  Style="{StaticResource ToggleSwitch}" VerticalAlignment="Center"
                                                  Checked="SidePanelToggle_Changed" Unchecked="SidePanelToggle_Changed"/>
                                    </Grid>
                                </Border>

                                <Separator Margin="0,18,0,18" Background="{DynamicResource LineBrush}"/>

                                <Border Padding="0" CornerRadius="0"
                                        BorderThickness="0" Background="Transparent" Margin="0">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <StackPanel Grid.Column="0" VerticalAlignment="Center">
                                            <TextBlock Text="작업 큐" FontSize="{DynamicResource Fs13}"
                                                       Foreground="{DynamicResource TextBrush}"/>
                                            <TextBlock Text="작업 큐 뷰 전환 버튼" FontSize="{DynamicResource Fs11}"
                                                       Foreground="{DynamicResource TextMutedBrush}" Margin="0,3,0,0"/>
                                        </StackPanel>
                                        <CheckBox x:Name="ShowQueueViewToggle" Grid.Column="1"
                                                  Style="{StaticResource ToggleSwitch}" VerticalAlignment="Center"
                                                  Checked="SidePanelToggle_Changed" Unchecked="SidePanelToggle_Changed"/>
                                    </Grid>
                                </Border>

                                <Separator Margin="0,18,0,18" Background="{DynamicResource LineBrush}"/>

                                <Border Padding="0" CornerRadius="0"
                                        BorderThickness="0" Background="Transparent" Margin="0">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <StackPanel Grid.Column="0" VerticalAlignment="Center">
                                            <TextBlock Text="웹 브라우저" FontSize="{DynamicResource Fs13}"
                                                       Foreground="{DynamicResource TextBrush}"/>
                                            <TextBlock Text="브라우저 뷰 전환 버튼" FontSize="{DynamicResource Fs11}"
                                                       Foreground="{DynamicResource TextMutedBrush}" Margin="0,3,0,0"/>
                                        </StackPanel>
                                        <CheckBox x:Name="ShowBrowserViewToggle" Grid.Column="1"
                                                  Style="{StaticResource ToggleSwitch}" VerticalAlignment="Center"
                                                  Checked="SidePanelToggle_Changed" Unchecked="SidePanelToggle_Changed"/>
                                    </Grid>
                                </Border>

                                <Separator Margin="0,18,0,18" Background="{DynamicResource LineBrush}"/>

                                <Border Padding="0" CornerRadius="0"
                                        BorderThickness="0" Background="Transparent" Margin="0">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <StackPanel Grid.Column="0" VerticalAlignment="Center">
                                            <TextBlock Text="DIFF" FontSize="{DynamicResource Fs13}"
                                                       Foreground="{DynamicResource TextBrush}"/>
                                            <TextBlock Text="변경 내역(diff) 뷰 전환 버튼" FontSize="{DynamicResource Fs11}"
                                                       Foreground="{DynamicResource TextMutedBrush}" Margin="0,3,0,0"/>
                                        </StackPanel>
                                        <CheckBox x:Name="ShowDiffViewToggle" Grid.Column="1"
                                                  Style="{StaticResource ToggleSwitch}" VerticalAlignment="Center"
                                                  Checked="SidePanelToggle_Changed" Unchecked="SidePanelToggle_Changed"/>
                                    </Grid>
                                </Border>

                            </StackPanel>

                            <!-- 계정 사용량 패널 — 계정 연결(로그인) + 푸터 표시 토글 -->
                            <StackPanel x:Name="UsagePanel" Margin="28,22,28,20" Visibility="Collapsed">
                                <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                                    <Path Style="{StaticResource LucideIcon}" Data="{StaticResource IconChartBar}"
                                          Width="16" Height="16" VerticalAlignment="Center" Margin="0,0,9,0"
                                          Stroke="{DynamicResource TextBrush}"/>
                                    <TextBlock Text="계정 사용량" FontSize="{DynamicResource Fs14}" FontWeight="SemiBold"
                                               Foreground="{DynamicResource TextBrush}" VerticalAlignment="Center"/>
                                </StackPanel>
                                <TextBlock Text="계정을 연결하면 사용량 탭과 하단 푸터에서 사용량(5시간/주간 등 한도)을 확인할 수 있습니다."
                                           FontSize="{DynamicResource Fs12}" TextWrapping="Wrap"
                                           Foreground="{DynamicResource TextMutedBrush}" Margin="0,0,0,4"/>

                                <!-- 그룹 1: 계정 연결(로그인/재연결) -->
                                <TextBlock Text="계정 연결" FontSize="{DynamicResource Fs11}" FontWeight="SemiBold"
                                           Foreground="{DynamicResource TextMutedBrush}" Margin="0,24,0,12"/>

                                <Grid Margin="0,0,0,14">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                                        <TextBlock Text="Claude" VerticalAlignment="Center"
                                                   FontSize="{DynamicResource Fs13}" Foreground="{DynamicResource TextBrush}"/>
                                        <StackPanel x:Name="ClaudeConnectedBadge" Orientation="Horizontal" Visibility="Collapsed"
                                                    Margin="10,0,0,0" VerticalAlignment="Center">
                                            <Ellipse Width="6" Height="6" Fill="{DynamicResource SuccessBrush}" VerticalAlignment="Center"/>
                                            <TextBlock Text="연결됨" Margin="5,0,0,0" VerticalAlignment="Center"
                                                       FontSize="{DynamicResource Fs11}" Foreground="{DynamicResource SuccessBrush}"/>
                                        </StackPanel>
                                    </StackPanel>
                                    <Button Grid.Column="1" Click="ClaudeLogin_Click" Style="{StaticResource UsageLoginButton}"
                                            ToolTip="Claude 계정으로 로그인해 사용량 연결">
                                        <StackPanel Orientation="Horizontal">
                                            <Image Source="pack://application:,,,/Resources/Images/ShellPresets/claude_code.png"
                                                   Width="13" Height="13" VerticalAlignment="Center"
                                                   RenderOptions.BitmapScalingMode="HighQuality"/>
                                            <TextBlock Text="로그인 / 재연결" Margin="7,0,0,0" VerticalAlignment="Center"
                                                       FontSize="{DynamicResource Fs11}" Foreground="{DynamicResource TextBrush}"/>
                                        </StackPanel>
                                    </Button>
                                </Grid>

                                <Grid Margin="0,0,0,14">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                                        <TextBlock Text="Codex" VerticalAlignment="Center"
                                                   FontSize="{DynamicResource Fs13}" Foreground="{DynamicResource TextBrush}"/>
                                        <StackPanel x:Name="CodexConnectedBadge" Orientation="Horizontal" Visibility="Collapsed"
                                                    Margin="10,0,0,0" VerticalAlignment="Center">
                                            <Ellipse Width="6" Height="6" Fill="{DynamicResource SuccessBrush}" VerticalAlignment="Center"/>
                                            <TextBlock Text="연결됨" Margin="5,0,0,0" VerticalAlignment="Center"
                                                       FontSize="{DynamicResource Fs11}" Foreground="{DynamicResource SuccessBrush}"/>
                                        </StackPanel>
                                    </StackPanel>
                                    <Button Grid.Column="1" Click="CodexLogin_Click" Style="{StaticResource UsageLoginButton}"
                                            ToolTip="ChatGPT(Codex) 계정으로 로그인해 사용량 연결">
                                        <StackPanel Orientation="Horizontal">
                                            <Image Source="pack://application:,,,/Resources/Images/ShellPresets/codex.png"
                                                   Width="13" Height="13" VerticalAlignment="Center"
                                                   RenderOptions.BitmapScalingMode="HighQuality"/>
                                            <TextBlock Text="로그인 / 재연결" Margin="7,0,0,0" VerticalAlignment="Center"
                                                       FontSize="{DynamicResource Fs11}" Foreground="{DynamicResource TextBrush}"/>
                                        </StackPanel>
                                    </Button>
                                </Grid>

                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                                        <TextBlock Text="OpenCode Go" VerticalAlignment="Center"
                                                   FontSize="{DynamicResource Fs13}" Foreground="{DynamicResource TextBrush}"/>
                                        <StackPanel x:Name="GoConnectedBadge" Orientation="Horizontal" Visibility="Collapsed"
                                                    Margin="10,0,0,0" VerticalAlignment="Center">
                                            <Ellipse Width="6" Height="6" Fill="{DynamicResource SuccessBrush}" VerticalAlignment="Center"/>
                                            <TextBlock Text="연결됨" Margin="5,0,0,0" VerticalAlignment="Center"
                                                       FontSize="{DynamicResource Fs11}" Foreground="{DynamicResource SuccessBrush}"/>
                                        </StackPanel>
                                    </StackPanel>
                                    <Button Grid.Column="1" Click="OpenCodeLogin_Click" Style="{StaticResource UsageLoginButton}"
                                            ToolTip="opencode.ai 계정으로 로그인해 사용량 연결">
                                        <StackPanel Orientation="Horizontal">
                                            <Image Source="pack://application:,,,/Resources/Images/ShellPresets/opencode_icon_white_50.png"
                                                   Width="13" Height="13" VerticalAlignment="Center"
                                                   RenderOptions.BitmapScalingMode="HighQuality"/>
                                            <TextBlock Text="로그인 / 재연결" Margin="7,0,0,0" VerticalAlignment="Center"
                                                       FontSize="{DynamicResource Fs11}" Foreground="{DynamicResource TextBrush}"/>
                                        </StackPanel>
                                    </Button>
                                </Grid>

                                <Separator Margin="0,22,0,0" Background="{DynamicResource LineBrush}"/>

                                <!-- 그룹 2: 하단 푸터 표시 -->
                                <TextBlock Text="하단 푸터 표시" FontSize="{DynamicResource Fs11}" FontWeight="SemiBold"
                                           Foreground="{DynamicResource TextMutedBrush}" Margin="0,20,0,12"/>

                                <Grid Margin="0,0,0,14">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Grid.Column="0" VerticalAlignment="Center">
                                        <TextBlock Text="Claude" FontSize="{DynamicResource Fs13}"
                                                   Foreground="{DynamicResource TextBrush}"/>
                                        <TextBlock Text="Claude 계정 사용량" FontSize="{DynamicResource Fs11}"
                                                   Foreground="{DynamicResource TextMutedBrush}" Margin="0,3,0,0"/>
                                    </StackPanel>
                                    <CheckBox x:Name="ShowFooterClaudeToggle" Grid.Column="1"
                                              Style="{StaticResource ToggleSwitch}" VerticalAlignment="Center"
                                              Checked="FooterUsageToggle_Changed" Unchecked="FooterUsageToggle_Changed"/>
                                </Grid>

                                <Grid Margin="0,0,0,14">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Grid.Column="0" VerticalAlignment="Center">
                                        <TextBlock Text="Codex" FontSize="{DynamicResource Fs13}"
                                                   Foreground="{DynamicResource TextBrush}"/>
                                        <TextBlock Text="ChatGPT(Codex) 계정 사용량" FontSize="{DynamicResource Fs11}"
                                                   Foreground="{DynamicResource TextMutedBrush}" Margin="0,3,0,0"/>
                                    </StackPanel>
                                    <CheckBox x:Name="ShowFooterCodexToggle" Grid.Column="1"
                                              Style="{StaticResource ToggleSwitch}" VerticalAlignment="Center"
                                              Checked="FooterUsageToggle_Changed" Unchecked="FooterUsageToggle_Changed"/>
                                </Grid>

                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Grid.Column="0" VerticalAlignment="Center">
                                        <TextBlock Text="OpenCode Go" FontSize="{DynamicResource Fs13}"
                                                   Foreground="{DynamicResource TextBrush}"/>
                                        <TextBlock Text="OpenCode Go 계정 사용량" FontSize="{DynamicResource Fs11}"
                                                   Foreground="{DynamicResource TextMutedBrush}" Margin="0,3,0,0"/>
                                    </StackPanel>
                                    <CheckBox x:Name="ShowFooterGoToggle" Grid.Column="1"
                                              Style="{StaticResource ToggleSwitch}" VerticalAlignment="Center"
                                              Checked="FooterUsageToggle_Changed" Unchecked="FooterUsageToggle_Changed"/>
                                </Grid>
                            </StackPanel>

                            <!-- 단축키 패널 — 탭 이동 전역 단축키 수식키 리바인드 -->
                            <StackPanel x:Name="ShortcutPanel" Margin="28,22,28,20" Visibility="Collapsed">
                                <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                                    <Path Style="{StaticResource LucideIcon}" Data="{StaticResource IconZap}"
                                          Width="16" Height="16" VerticalAlignment="Center" Margin="0,0,9,0"
                                          Stroke="{DynamicResource TextBrush}"/>
                                    <TextBlock Text="단축키" FontSize="{DynamicResource Fs14}" FontWeight="SemiBold"
                                               Foreground="{DynamicResource TextBrush}" VerticalAlignment="Center"/>
                                </StackPanel>
                                <TextBlock Text="세션 탭을 이전/다음으로 이동하는 전역 단축키입니다. 수식키를 누른 채 ← / → 방향키를 누릅니다."
                                           FontSize="{DynamicResource Fs12}" TextWrapping="Wrap"
                                           Foreground="{DynamicResource TextMutedBrush}" Margin="0,0,0,4"/>
                                <TextBlock Text="다른 앱이 포그라운드여도 동작합니다. 키 칸을 클릭한 뒤 원하는 키를 누르세요. (Esc 취소)"
                                           FontSize="{DynamicResource Fs11}" TextWrapping="Wrap"
                                           Foreground="{DynamicResource TextMutedBrush}" Margin="0,0,0,20"/>

                                <!-- 수식키 -->
                                <Grid Margin="0,0,0,14">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Grid.Column="0" VerticalAlignment="Center">
                                        <TextBlock Text="수식키" FontSize="{DynamicResource Fs13}"
                                                   Foreground="{DynamicResource TextBrush}"/>
                                        <TextBlock Text="누르고 있는 동안 ← / → 방향키가 세션 탭 이전/다음 이동으로 동작" FontSize="{DynamicResource Fs11}"
                                                   TextWrapping="Wrap"
                                                   Foreground="{DynamicResource TextMutedBrush}" Margin="0,3,12,0"/>
                                    </StackPanel>
                                    <Border x:Name="ModKeyField" Grid.Column="1" Tag="mod"
                                            Width="130" Height="38" Cursor="Arrow"
                                            Background="{DynamicResource PanelSoftBrush}"
                                            BorderBrush="{DynamicResource LineBrush}" BorderThickness="2"
                                            CornerRadius="8" MouseLeftButtonDown="KeyField_Click">
                                        <TextBlock x:Name="ModKeyText" Text="한자" VerticalAlignment="Center"
                                                   HorizontalAlignment="Center" FontSize="{DynamicResource Fs13}"
                                                   FontWeight="SemiBold" Foreground="{DynamicResource TextBrush}"/>
                                    </Border>
                                </Grid>
                            </StackPanel>

                            <!-- 테마 패널 -->
                            <StackPanel x:Name="ThemePanel" Margin="28,22,28,20" Visibility="Collapsed">
                                <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                                    <Path Style="{StaticResource LucideIcon}" Data="{StaticResource IconPalette}"
                                          Width="16" Height="16" VerticalAlignment="Center" Margin="0,0,9,0"
                                          Stroke="{DynamicResource TextBrush}"/>
                                    <TextBlock Text="테마/글꼴" FontSize="{DynamicResource Fs14}" FontWeight="SemiBold"
                                               Foreground="{DynamicResource TextBrush}" VerticalAlignment="Center"/>
                                </StackPanel>

                                <TextBlock Text="앱 전체에 적용되는 색 테마를 선택합니다." FontSize="{DynamicResource Fs12}"
                                           Foreground="{DynamicResource TextMutedBrush}" Margin="0,0,0,16"/>

                                <!-- 테마 카드 3종 (클릭 시 즉시 적용·저장) -->
                                <StackPanel Orientation="Horizontal">

                                    <!-- ── 심플 (minimal) ─────────────────────────── -->
                                    <Border x:Name="ThemeCard_Minimal" Tag="minimal"
                                            Width="150" Height="150"
                                            BorderBrush="{DynamicResource LineBrush}" BorderThickness="2"
                                            Background="{DynamicResource PanelBrush}"
                                            CornerRadius="10" Margin="0,0,12,0"
                                            Cursor="Arrow" MouseLeftButtonDown="ThemeCard_Click">
                                        <Grid>
                                            <Grid.RowDefinitions>
                                                <RowDefinition Height="*"/>
                                                <RowDefinition Height="38"/>
                                            </Grid.RowDefinitions>
                                            <Border Grid.Row="0" CornerRadius="8,8,0,0" Margin="1"
                                                    Background="#F8FAFC" ClipToBounds="True">
                                                <Grid Margin="6">
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="32"/>
                                                        <ColumnDefinition Width="*"/>
                                                    </Grid.ColumnDefinitions>
                                                    <Border Grid.Column="0" Background="White" CornerRadius="3"
                                                            BorderBrush="#E2E8F0" BorderThickness="0.5">
                                                        <StackPanel Margin="3,4">
                                                            <Border Background="#2563EB" Height="3" CornerRadius="1.5" Margin="0,1.5"/>
                                                            <Border Background="#E2E8F0" Height="3" CornerRadius="1.5" Margin="0,1.5"/>
                                                            <Border Background="#E2E8F0" Height="3" CornerRadius="1.5" Margin="0,1.5"/>
                                                            <Border Background="#E2E8F0" Height="3" CornerRadius="1.5" Margin="0,1.5"/>
                                                        </StackPanel>
                                                    </Border>
                                                    <Border Grid.Column="1" Background="White" CornerRadius="3" Margin="4,0,0,0"
                                                            BorderBrush="#E2E8F0" BorderThickness="0.5">
                                                        <StackPanel Margin="5,5">
                                                            <Border Background="#0F172A" Height="4" Width="40" CornerRadius="1.5"
                                                                    HorizontalAlignment="Left" Margin="0,0,0,5"/>
                                                            <Border Background="#DBEAFE" Height="9" CornerRadius="3" Margin="0,2,8,2"/>
                                                            <Border Background="#F1F5F9" Height="9" CornerRadius="3" Margin="6,2,0,2"/>
                                                        </StackPanel>
                                                    </Border>
                                                </Grid>
                                            </Border>
                                            <Border Grid.Row="1" BorderBrush="{DynamicResource LineBrush}" BorderThickness="0,1,0,0">
                                                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center">
                                                    <Grid Width="14" Height="14" Margin="0,0,6,0">
                                                        <Ellipse Stroke="{DynamicResource LineBrush}" StrokeThickness="1.5"/>
                                                        <Ellipse x:Name="ThemeRadioDot_Minimal" Width="7" Height="7"
                                                                 Fill="{DynamicResource PrimaryBrush}" Visibility="Collapsed"/>
                                                    </Grid>
                                                    <TextBlock Text="심플" FontSize="{DynamicResource Fs12}"
                                                               Foreground="{DynamicResource TextBrush}" VerticalAlignment="Center"/>
                                                </StackPanel>
                                            </Border>
                                        </Grid>
                                    </Border>

                                    <!-- ── 소프트 (soft) ──────────────────────────── -->
                                    <Border x:Name="ThemeCard_Soft" Tag="soft"
                                            Width="150" Height="150"
                                            BorderBrush="{DynamicResource LineBrush}" BorderThickness="2"
                                            Background="{DynamicResource PanelBrush}"
                                            CornerRadius="10" Margin="0,0,12,0"
                                            Cursor="Arrow" MouseLeftButtonDown="ThemeCard_Click">
                                        <Grid>
                                            <Grid.RowDefinitions>
                                                <RowDefinition Height="*"/>
                                                <RowDefinition Height="38"/>
                                            </Grid.RowDefinitions>
                                            <Border Grid.Row="0" CornerRadius="8,8,0,0" Margin="1"
                                                    Background="#F2EDE6" ClipToBounds="True">
                                                <Grid Margin="6">
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="32"/>
                                                        <ColumnDefinition Width="*"/>
                                                    </Grid.ColumnDefinitions>
                                                    <Border Grid.Column="0" Background="#FAF7F2" CornerRadius="3"
                                                            BorderBrush="#D8D2C6" BorderThickness="0.5">
                                                        <StackPanel Margin="3,4">
                                                            <Border Background="#5C8C4A" Height="3" CornerRadius="1.5" Margin="0,1.5"/>
                                                            <Border Background="#D8D2C6" Height="3" CornerRadius="1.5" Margin="0,1.5"/>
                                                            <Border Background="#D8D2C6" Height="3" CornerRadius="1.5" Margin="0,1.5"/>
                                                            <Border Background="#D8D2C6" Height="3" CornerRadius="1.5" Margin="0,1.5"/>
                                                        </StackPanel>
                                                    </Border>
                                                    <Border Grid.Column="1" Background="#FAF7F2" CornerRadius="3" Margin="4,0,0,0"
                                                            BorderBrush="#D8D2C6" BorderThickness="0.5">
                                                        <StackPanel Margin="5,5">
                                                            <Border Background="#2A2620" Height="4" Width="40" CornerRadius="1.5"
                                                                    HorizontalAlignment="Left" Margin="0,0,0,5"/>
                                                            <Border Background="#DEECD6" Height="9" CornerRadius="3" Margin="0,2,8,2"/>
                                                            <Border Background="#ECE7DE" Height="9" CornerRadius="3" Margin="6,2,0,2"/>
                                                        </StackPanel>
                                                    </Border>
                                                </Grid>
                                            </Border>
                                            <Border Grid.Row="1" BorderBrush="{DynamicResource LineBrush}" BorderThickness="0,1,0,0">
                                                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center">
                                                    <Grid Width="14" Height="14" Margin="0,0,6,0">
                                                        <Ellipse Stroke="{DynamicResource LineBrush}" StrokeThickness="1.5"/>
                                                        <Ellipse x:Name="ThemeRadioDot_Soft" Width="7" Height="7"
                                                                 Fill="{DynamicResource PrimaryBrush}" Visibility="Collapsed"/>
                                                    </Grid>
                                                    <TextBlock Text="소프트" FontSize="{DynamicResource Fs12}"
                                                               Foreground="{DynamicResource TextBrush}" VerticalAlignment="Center"/>
                                                </StackPanel>
                                            </Border>
                                        </Grid>
                                    </Border>

                                    <!-- ── 다크 (dark) ────────────────────────────── -->
                                    <Border x:Name="ThemeCard_Dark" Tag="dark"
                                            Width="150" Height="150"
                                            BorderBrush="{DynamicResource LineBrush}" BorderThickness="2"
                                            Background="{DynamicResource PanelBrush}"
                                            CornerRadius="10" Margin="0"
                                            Cursor="Arrow" MouseLeftButtonDown="ThemeCard_Click">
                                        <Grid>
                                            <Grid.RowDefinitions>
                                                <RowDefinition Height="*"/>
                                                <RowDefinition Height="38"/>
                                            </Grid.RowDefinitions>
                                            <Border Grid.Row="0" CornerRadius="8,8,0,0" Margin="1"
                                                    Background="#1F1F1E" ClipToBounds="True">
                                                <Grid Margin="6">
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="32"/>
                                                        <ColumnDefinition Width="*"/>
                                                    </Grid.ColumnDefinitions>
                                                    <Border Grid.Column="0" Background="#272727" CornerRadius="3"
                                                            BorderBrush="#383838" BorderThickness="0.5">
                                                        <StackPanel Margin="3,4">
                                                            <Border Background="#E8E8E8" Height="3" CornerRadius="1.5" Margin="0,1.5"/>
                                                            <Border Background="#383838" Height="3" CornerRadius="1.5" Margin="0,1.5"/>
                                                            <Border Background="#383838" Height="3" CornerRadius="1.5" Margin="0,1.5"/>
                                                            <Border Background="#383838" Height="3" CornerRadius="1.5" Margin="0,1.5"/>
                                                        </StackPanel>
                                                    </Border>
                                                    <Border Grid.Column="1" Background="#272727" CornerRadius="3" Margin="4,0,0,0"
                                                            BorderBrush="#383838" BorderThickness="0.5">
                                                        <StackPanel Margin="5,5">
                                                            <Border Background="#E8E8E8" Height="4" Width="40" CornerRadius="1.5"
                                                                    HorizontalAlignment="Left" Margin="0,0,0,5"/>
                                                            <Border Background="#4A2810" Height="9" CornerRadius="3" Margin="0,2,8,2"/>
                                                            <Border Background="#363636" Height="9" CornerRadius="3" Margin="6,2,0,2"/>
                                                        </StackPanel>
                                                    </Border>
                                                </Grid>
                                            </Border>
                                            <Border Grid.Row="1" BorderBrush="{DynamicResource LineBrush}" BorderThickness="0,1,0,0">
                                                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center">
                                                    <Grid Width="14" Height="14" Margin="0,0,6,0">
                                                        <Ellipse Stroke="{DynamicResource LineBrush}" StrokeThickness="1.5"/>
                                                        <Ellipse x:Name="ThemeRadioDot_Dark" Width="7" Height="7"
                                                                 Fill="{DynamicResource PrimaryBrush}" Visibility="Collapsed"/>
                                                    </Grid>
                                                    <TextBlock Text="다크" FontSize="{DynamicResource Fs12}"
                                                               Foreground="{DynamicResource TextBrush}" VerticalAlignment="Center"/>
                                                </StackPanel>
                                            </Border>
                                        </Grid>
                                    </Border>

                                </StackPanel>

                                <Separator Margin="0,22,0,0" Background="{DynamicResource LineBrush}"/>

                                <!-- 글꼴 크기 (devez 이식: 작게=0 / 크게=1, 앱 전체 적용) -->
                                <TextBlock Text="글꼴 크기" FontSize="{DynamicResource Fs13}" FontWeight="SemiBold"
                                           Foreground="{DynamicResource TextBrush}" Margin="0,22,0,12"/>
                                <StackPanel Orientation="Horizontal">
                                    <Border x:Name="FontCard_Small" Tag="0" Width="120" Height="56"
                                            BorderBrush="{DynamicResource LineBrush}" BorderThickness="2"
                                            Background="{DynamicResource PanelBrush}" CornerRadius="10" Margin="0,0,10,0"
                                            Cursor="Arrow" MouseLeftButtonDown="FontSizeCard_Click">
                                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center">
                                            <Grid Width="14" Height="14" Margin="0,0,8,0">
                                                <Ellipse Stroke="{DynamicResource LineBrush}" StrokeThickness="1.5"/>
                                                <Ellipse x:Name="FontRadioDot_Small" Width="7" Height="7"
                                                         Fill="{DynamicResource PrimaryBrush}" Visibility="Collapsed"/>
                                            </Grid>
                                            <TextBlock Text="작게" FontSize="{DynamicResource Fs13}"
                                                       Foreground="{DynamicResource TextBrush}" VerticalAlignment="Center"/>
                                        </StackPanel>
                                    </Border>
                                    <Border x:Name="FontCard_Large" Tag="1" Width="120" Height="56"
                                            BorderBrush="{DynamicResource LineBrush}" BorderThickness="2"
                                            Background="{DynamicResource PanelBrush}" CornerRadius="10" Margin="0,0,10,0"
                                            Cursor="Arrow" MouseLeftButtonDown="FontSizeCard_Click">
                                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center">
                                            <Grid Width="14" Height="14" Margin="0,0,8,0">
                                                <Ellipse Stroke="{DynamicResource LineBrush}" StrokeThickness="1.5"/>
                                                <Ellipse x:Name="FontRadioDot_Large" Width="7" Height="7"
                                                         Fill="{DynamicResource PrimaryBrush}" Visibility="Collapsed"/>
                                            </Grid>
                                            <TextBlock Text="크게" FontSize="{DynamicResource Fs15}"
                                                       Foreground="{DynamicResource TextBrush}" VerticalAlignment="Center"/>
                                        </StackPanel>
                                    </Border>
                                </StackPanel>
                            </StackPanel>

                            <!-- 알림 패널 — 세션 종료 알림 / 자동 닫힘 / 표시 위치 / 모니터 -->
                            <StackPanel x:Name="NotifyPanel" Margin="28,22,28,20" Visibility="Collapsed">
                                <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                                    <Path Style="{StaticResource LucideIcon}" Data="{StaticResource IconBell}"
                                          Width="16" Height="16" VerticalAlignment="Center" Margin="0,0,9,0"
                                          Stroke="{DynamicResource TextBrush}"/>
                                    <TextBlock Text="알림" FontSize="{DynamicResource Fs14}" FontWeight="SemiBold"
                                               Foreground="{DynamicResource TextBrush}" VerticalAlignment="Center"/>
                                </StackPanel>
                                <TextBlock Text="세션의 응답이 끝나면 토스트 알림을 표시합니다." FontSize="{DynamicResource Fs12}"
                                           Foreground="{DynamicResource TextMutedBrush}" Margin="0,0,0,20"/>

                                <!-- 세션 종료 알림 토글 + 알림 테스트(토글 왼쪽, devez 정합) -->
                                <Border Padding="0" CornerRadius="0" BorderThickness="0" Background="Transparent" Margin="0,4,0,0">
                                    <Grid MinHeight="32">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <StackPanel Grid.Column="0" VerticalAlignment="Center" Margin="0,0,16,0">
                                            <TextBlock Text="세션 종료 알림" FontSize="{DynamicResource Fs13}"
                                                       Foreground="{DynamicResource TextBrush}"/>
                                            <TextBlock Text="응답 생성이 완료될 때 알려줍니다." FontSize="{DynamicResource Fs11}"
                                                       TextWrapping="Wrap"
                                                       Foreground="{DynamicResource TextMutedBrush}" Margin="0,3,0,0"/>
                                        </StackPanel>
                                        <Button x:Name="TestNotifyBtn" Grid.Column="1" Click="TestNotify_Click"
                                                Style="{StaticResource IconButton}"
                                                VerticalAlignment="Center" Margin="0,0,12,0" Padding="10,7"
                                                Background="Transparent" Cursor="Hand">
                                            <StackPanel Orientation="Horizontal">
                                                <Path Data="{StaticResource IconBell}" Width="13" Height="13" Margin="0,0,6,0"
                                                      VerticalAlignment="Center" Stretch="Uniform" Fill="Transparent"
                                                      StrokeThickness="1.5" StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round"
                                                      Stroke="{DynamicResource PrimaryBrush}"/>
                                                <TextBlock Text="알림 테스트" FontSize="{DynamicResource Fs12}"
                                                           Foreground="{DynamicResource PrimaryBrush}" VerticalAlignment="Center"/>
                                            </StackPanel>
                                        </Button>
                                        <CheckBox x:Name="NotifyEnabledToggle" Grid.Column="2"
                                                  Style="{StaticResource ToggleSwitch}" VerticalAlignment="Center"
                                                  Checked="NotifyEnabledToggle_Changed" Unchecked="NotifyEnabledToggle_Changed"/>
                                    </Grid>
                                </Border>

                                <!-- 세션 종료 알림이 켜져 있을 때만 표시되는 상세 설정 -->
                                <StackPanel x:Name="NotifyDetailPanel">
                                <Separator Margin="0,18,0,0" Background="{DynamicResource LineBrush}"/>

                                <!-- 자동 닫힘 시간 -->
                                <Grid Margin="0,18,0,0">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Grid.Column="0" VerticalAlignment="Center" Margin="0,0,16,0">
                                        <TextBlock Text="자동 닫힘 시간" FontSize="{DynamicResource Fs13}"
                                                   Foreground="{DynamicResource TextBrush}"/>
                                        <TextBlock Text="알림이 자동으로 사라지기까지의 시간입니다. '영구'면 직접 닫을 때까지 유지됩니다."
                                                   FontSize="{DynamicResource Fs11}" TextWrapping="Wrap"
                                                   Foreground="{DynamicResource TextMutedBrush}" Margin="0,3,0,0"/>
                                    </StackPanel>
                                    <ComboBox Grid.Column="1" x:Name="NotifyAutoCloseCombo"
                                              Style="{StaticResource ThemedCombo}" Width="120"
                                              VerticalAlignment="Center"
                                              SelectionChanged="NotifyAutoCloseCombo_Changed">
                                        <ComboBoxItem Tag="1">1초</ComboBoxItem>
                                        <ComboBoxItem Tag="2">2초</ComboBoxItem>
                                        <ComboBoxItem Tag="3">3초</ComboBoxItem>
                                        <ComboBoxItem Tag="4">4초</ComboBoxItem>
                                        <ComboBoxItem Tag="5">5초</ComboBoxItem>
                                        <ComboBoxItem Tag="6">6초</ComboBoxItem>
                                        <ComboBoxItem Tag="7">7초</ComboBoxItem>
                                        <ComboBoxItem Tag="8">8초</ComboBoxItem>
                                        <ComboBoxItem Tag="9">9초</ComboBoxItem>
                                        <ComboBoxItem Tag="10">10초</ComboBoxItem>
                                        <ComboBoxItem Tag="0">영구</ComboBoxItem>
                                    </ComboBox>
                                </Grid>

                                <Separator Margin="0,18,0,0" Background="{DynamicResource LineBrush}"/>

                                <!-- 표시 위치 (좌) + 표시 모니터 (우) — 제목 줄 맞춤 -->
                                <Grid Margin="0,18,0,0">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Grid.Column="0">
                                <TextBlock Text="표시 위치" FontSize="{DynamicResource Fs13}" FontWeight="SemiBold"
                                           Foreground="{DynamicResource TextBrush}" Margin="0,0,0,12"/>
                                <StackPanel Orientation="Horizontal">
                                    <Border x:Name="PosCard_tl" Tag="tl" Width="110" Height="50"
                                            BorderBrush="{DynamicResource LineBrush}" BorderThickness="2"
                                            Background="{DynamicResource PanelBrush}" CornerRadius="10" Margin="0,0,10,0"
                                            Cursor="Arrow" MouseLeftButtonDown="NotifyPositionCard_Click">
                                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center">
                                            <Grid Width="14" Height="14" Margin="0,0,8,0">
                                                <Ellipse Stroke="{DynamicResource LineBrush}" StrokeThickness="1.5"/>
                                                <Ellipse x:Name="PosDot_tl" Width="7" Height="7"
                                                         Fill="{DynamicResource PrimaryBrush}" Visibility="Collapsed"/>
                                            </Grid>
                                            <TextBlock Text="좌상단" FontSize="{DynamicResource Fs12}"
                                                       Foreground="{DynamicResource TextBrush}" VerticalAlignment="Center"/>
                                        </StackPanel>
                                    </Border>
                                    <Border x:Name="PosCard_tr" Tag="tr" Width="110" Height="50"
                                            BorderBrush="{DynamicResource LineBrush}" BorderThickness="2"
                                            Background="{DynamicResource PanelBrush}" CornerRadius="10" Margin="0"
                                            Cursor="Arrow" MouseLeftButtonDown="NotifyPositionCard_Click">
                                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center">
                                            <Grid Width="14" Height="14" Margin="0,0,8,0">
                                                <Ellipse Stroke="{DynamicResource LineBrush}" StrokeThickness="1.5"/>
                                                <Ellipse x:Name="PosDot_tr" Width="7" Height="7"
                                                         Fill="{DynamicResource PrimaryBrush}" Visibility="Collapsed"/>
                                            </Grid>
                                            <TextBlock Text="우상단" FontSize="{DynamicResource Fs12}"
                                                       Foreground="{DynamicResource TextBrush}" VerticalAlignment="Center"/>
                                        </StackPanel>
                                    </Border>
                                </StackPanel>
                                <StackPanel Orientation="Horizontal" Margin="0,10,0,0">
                                    <Border x:Name="PosCard_bl" Tag="bl" Width="110" Height="50"
                                            BorderBrush="{DynamicResource LineBrush}" BorderThickness="2"
                                            Background="{DynamicResource PanelBrush}" CornerRadius="10" Margin="0,0,10,0"
                                            Cursor="Arrow" MouseLeftButtonDown="NotifyPositionCard_Click">
                                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center">
                                            <Grid Width="14" Height="14" Margin="0,0,8,0">
                                                <Ellipse Stroke="{DynamicResource LineBrush}" StrokeThickness="1.5"/>
                                                <Ellipse x:Name="PosDot_bl" Width="7" Height="7"
                                                         Fill="{DynamicResource PrimaryBrush}" Visibility="Collapsed"/>
                                            </Grid>
                                            <TextBlock Text="좌하단" FontSize="{DynamicResource Fs12}"
                                                       Foreground="{DynamicResource TextBrush}" VerticalAlignment="Center"/>
                                        </StackPanel>
                                    </Border>
                                    <Border x:Name="PosCard_br" Tag="br" Width="110" Height="50"
                                            BorderBrush="{DynamicResource LineBrush}" BorderThickness="2"
                                            Background="{DynamicResource PanelBrush}" CornerRadius="10" Margin="0"
                                            Cursor="Arrow" MouseLeftButtonDown="NotifyPositionCard_Click">
                                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center">
                                            <Grid Width="14" Height="14" Margin="0,0,8,0">
                                                <Ellipse Stroke="{DynamicResource LineBrush}" StrokeThickness="1.5"/>
                                                <Ellipse x:Name="PosDot_br" Width="7" Height="7"
                                                         Fill="{DynamicResource PrimaryBrush}" Visibility="Collapsed"/>
                                            </Grid>
                                            <TextBlock Text="우하단" FontSize="{DynamicResource Fs12}"
                                                       Foreground="{DynamicResource TextBrush}" VerticalAlignment="Center"/>
                                        </StackPanel>
                                    </Border>
                                </StackPanel>
                                    </StackPanel>

                                    <!-- 표시 모니터 (위치 카드 오른쪽 남은 영역) — 제목을 표시 위치와 줄 맞춤 -->
                                    <StackPanel Grid.Column="1" VerticalAlignment="Top" Margin="28,0,0,0">
                                        <TextBlock Text="표시 모니터" FontSize="{DynamicResource Fs13}" FontWeight="SemiBold"
                                                   Foreground="{DynamicResource TextBrush}" Margin="0,0,0,12"/>
                                        <TextBlock Text="알림이 나타날 모니터를 선택합니다." FontSize="{DynamicResource Fs11}"
                                                   TextWrapping="Wrap"
                                                   Foreground="{DynamicResource TextMutedBrush}" Margin="0,0,0,10"/>
                                        <ComboBox x:Name="NotifyMonitorCombo"
                                                  Style="{StaticResource ThemedCombo}"
                                                  HorizontalAlignment="Left" MinWidth="200"
                                                  SelectionChanged="NotifyMonitorCombo_Changed"/>
                                    </StackPanel>
                                </Grid>
                                </StackPanel>
                            </StackPanel>

                            <!-- Discord 연동 패널 -->
                            <StackPanel x:Name="DiscordPanel" Margin="28,22,28,20" Visibility="Collapsed">
                                <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                                    <Path Style="{StaticResource LucideIcon}" Data="{StaticResource IconServer}"
                                          Width="16" Height="16" VerticalAlignment="Center" Margin="0,0,9,0"
                                          Stroke="{DynamicResource TextBrush}"/>
                                    <TextBlock Text="Discord" FontSize="{DynamicResource Fs14}" FontWeight="SemiBold"
                                               Foreground="{DynamicResource TextBrush}" VerticalAlignment="Center"/>
                                </StackPanel>
                                <TextBlock FontSize="{DynamicResource Fs12}" TextWrapping="Wrap"
                                           Foreground="{DynamicResource TextMutedBrush}" Margin="0,0,0,20"><Run Text="Discord 서버에서 프로젝트별 카테고리와 세션별 스레드로 DevezCode 세션을 원격 제어합니다."/><LineBreak/><Run Text="봇은 outbound WebSocket만 사용합니다."/></TextBlock>
                                <Grid Margin="0,4,0,0">
                                    <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                    <StackPanel Grid.Column="0" Margin="0,0,16,0">
                                        <TextBlock Text="Discord 연동 사용" FontSize="{DynamicResource Fs13}" Foreground="{DynamicResource TextBrush}"/>
                                        <TextBlock Text="토큰과 서버 ID가 저장되어 있어야 연결됩니다." FontSize="{DynamicResource Fs11}" Foreground="{DynamicResource TextMutedBrush}" Margin="0,3,0,0"/>
                                    </StackPanel>
                                    <CheckBox x:Name="DiscordEnabledToggle" Grid.Column="1" Style="{StaticResource ToggleSwitch}" Checked="DiscordSetting_Changed" Unchecked="DiscordSetting_Changed"/>
                                </Grid>
                                <Separator Margin="0,18,0,18" Background="{DynamicResource LineBrush}"/>

                                <!-- 연결 정보 -->
                                <TextBlock Text="연결 정보" FontSize="{DynamicResource Fs12}" FontWeight="SemiBold"
                                           Foreground="{DynamicResource TextBrush}" Margin="0,0,0,12"/>

                                <TextBlock Text="BOT TOKEN" Style="{StaticResource DiscordFieldLabel}"/>
                                <Border Style="{StaticResource DiscordFieldBox}">
                                    <PasswordBox x:Name="DiscordTokenBox" Style="{StaticResource PasswordStyle}"
                                                 FontSize="{DynamicResource Fs12}"
                                                 PasswordChanged="DiscordSetting_Changed"/>
                                </Border>
                                <TextBlock Text="Discord 개발자 포털 > Bot 에서 발급한 토큰." FontSize="{DynamicResource Fs11}"
                                           Foreground="{DynamicResource TextMutedBrush}" Margin="2,6,0,0"/>

                                <TextBlock Text="GUILD ID" Style="{StaticResource DiscordFieldLabel}" Margin="0,18,0,7"/>
                                <Border Style="{StaticResource DiscordFieldBox}">
                                    <TextBox x:Name="DiscordGuildIdBox" Style="{StaticResource InputStyle}"
                                             FontSize="{DynamicResource Fs12}"
                                             TextChanged="DiscordSetting_Changed"/>
                                </Border>
                                <TextBlock Text="서버 우클릭 > 서버 ID 복사 (개발자 모드 필요)." FontSize="{DynamicResource Fs11}"
                                           Foreground="{DynamicResource TextMutedBrush}" Margin="2,6,0,0"/>

                                <Separator Margin="0,18,0,18" Background="{DynamicResource LineBrush}"/>

                                <Grid Margin="0,0,0,0">
                                    <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                    <StackPanel Grid.Column="0" Margin="0,0,16,0">
                                        <TextBlock Text="세션 완료 Discord 알림" FontSize="{DynamicResource Fs13}" Foreground="{DynamicResource TextBrush}"/>
                                        <TextBlock Text="응답 완료 시 해당 세션 스레드에도 알립니다." FontSize="{DynamicResource Fs11}" Foreground="{DynamicResource TextMutedBrush}" Margin="0,3,0,0"/>
                                    </StackPanel>
                                    <CheckBox x:Name="DiscordNotifyDoneToggle" Grid.Column="1" Style="{StaticResource ToggleSwitch}" Checked="DiscordSetting_Changed" Unchecked="DiscordSetting_Changed"/>
                                </Grid>
                                <Button Click="DiscordReconnect_Click" Style="{StaticResource PrimaryButton}" Height="38" HorizontalAlignment="Left" Margin="0,22,0,0" Padding="18,0">
                                    <TextBlock Text="연결 다시 시작" Foreground="White" FontSize="{DynamicResource Fs12}" FontWeight="SemiBold"/>
                                </Button>
                            </StackPanel>
                          </Grid>
                        </ScrollViewer>
                    </Grid>

                    <!-- Footer: 취소 / 저장 (devez 이식) -->
                    <Border Grid.Row="2"
                            Background="{DynamicResource PanelSoftBrush}"
                            BorderBrush="{DynamicResource LineBrush}"
                            BorderThickness="0,1,0,0">
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right"
                                    Margin="20,14,20,14">
                            <Button Click="ForceCancelBtn_Click"
                                    Width="100" Height="38" Margin="0,0,8,0"
                                    Style="{StaticResource SecondaryButton}"
                                    FontSize="{DynamicResource Fs13}">
                                <TextBlock Text="취소"/>
                            </Button>
                            <Button x:Name="SaveBtn" Click="SaveBtn_Click"
                                    Width="100" Height="38"
                                    Style="{StaticResource PrimaryButton}"
                                    FontSize="{DynamicResource Fs13}">
                                <TextBlock Text="저장" Foreground="White"/>
                            </Button>
                        </StackPanel>
                    </Border>
    </Grid>
</UserControl>
