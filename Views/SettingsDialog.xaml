                                            <StackPanel Orientation="Horizontal">
                                                <Path Style="{StaticResource LucideButtonIcon}" Data="{StaticResource IconLogOut}"
                                                      Width="13" Height="13" Stroke="{DynamicResource DangerBrush}"/>
                                                <TextBlock Text="연결 끊기" Margin="6,0,0,0" VerticalAlignment="Center"
                                                           FontSize="{DynamicResource Fs11}" Foreground="{DynamicResource DangerBrush}"/>
                                            </StackPanel>
                                        </Button>
                                        <Button Click="CodexLogin_Click" Style="{StaticResource UsageLoginButton}"
                                                ToolTip="ChatGPT(Codex) 계정으로 로그인해 사용량 연결">
                                            <StackPanel Orientation="Horizontal">
                                                <Image Source="pack://application:,,,/Resources/Images/ShellPresets/codex.png"
                                                       Width="13" Height="13" VerticalAlignment="Center"
                                                       RenderOptions.BitmapScalingMode="HighQuality"/>
                                                <TextBlock Text="로그인 / 재연결" Margin="7,0,0,0" VerticalAlignment="Center"
                                                           FontSize="{DynamicResource Fs11}" Foreground="{DynamicResource TextBrush}"/>
                                            </StackPanel>
                                        </Button>
                                    </StackPanel>
                                </Grid>

                                <Grid Margin="0,0,0,18">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                                        <TextBlock Text="OpenCode Go" VerticalAlignment="Center"
                                                   FontSize="{DynamicResource Fs13}" Foreground="{DynamicResource TextBrush}"/>
                                        <StackPanel x:Name="GoConnectedBadge" Orientation="Horizontal" Visibility="Collapsed"
                                                    Margin="10,0,0,0" VerticalAlignment="Center">
                                            <Ellipse Width="6" Height="6" Fill="{DynamicResource SuccessBrush}" VerticalAlignment="Center"/>
                                            <TextBlock Text="연결됨" Margin="5,0,0,0" VerticalAlignment="Center"
                                                       FontSize="{DynamicResource Fs11}" Foreground="{DynamicResource SuccessBrush}"/>
                                        </StackPanel>
                                    </StackPanel>
                                    <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                                        <Button x:Name="GoDisconnectButton" Tag="opencode-go" Click="UsageDisconnect_Click"
                                                Style="{StaticResource UsageLoginButton}" Margin="0,0,14,0"
                                                ToolTip="OpenCode Go 계정 사용량 연결 끊기" Visibility="Collapsed">
                                            <StackPanel Orientation="Horizontal">
                                                <Path Style="{StaticResource LucideButtonIcon}" Data="{StaticResource IconLogOut}"
                                                      Width="13" Height="13" Stroke="{DynamicResource DangerBrush}"/>
                                                <TextBlock Text="연결 끊기" Margin="6,0,0,0" VerticalAlignment="Center"
                                                           FontSize="{DynamicResource Fs11}" Foreground="{DynamicResource DangerBrush}"/>
                                            </StackPanel>
                                        </Button>
                                        <Button Click="OpenCodeLogin_Click" Style="{StaticResource UsageLoginButton}"
                                                ToolTip="opencode.ai 계정으로 로그인해 사용량 연결">
                                            <StackPanel Orientation="Horizontal">
                                                <Image x:Name="OpenCodeLoginIcon" Source="pack://application:,,,/Resources/Images/ShellPresets/opencode_icon_white_50.png"
                                                       Width="13" Height="13" VerticalAlignment="Center"
                                                       RenderOptions.BitmapScalingMode="HighQuality"/>
                                                <TextBlock Text="로그인 / 재연결" Margin="7,0,0,0" VerticalAlignment="Center"
                                                           FontSize="{DynamicResource Fs11}" Foreground="{DynamicResource TextBrush}"/>
                                            </StackPanel>
                                        </Button>
                                    </StackPanel>
                                </Grid>

                                <Grid Margin="0,0,0,18">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                                        <TextBlock Text="Grok Build" VerticalAlignment="Center"
                                                   FontSize="{DynamicResource Fs13}" Foreground="{DynamicResource TextBrush}"/>
                                        <StackPanel x:Name="GrokConnectedBadge" Orientation="Horizontal" Visibility="Collapsed"
                                                    Margin="10,0,0,0" VerticalAlignment="Center">
                                            <Ellipse Width="6" Height="6" Fill="{DynamicResource SuccessBrush}" VerticalAlignment="Center"/>
                                            <TextBlock Text="연결됨" Margin="5,0,0,0" VerticalAlignment="Center"
                                                       FontSize="{DynamicResource Fs11}" Foreground="{DynamicResource SuccessBrush}"/>
                                        </StackPanel>
                                    </StackPanel>
                                    <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                                        <Button x:Name="GrokDisconnectButton" Tag="grok" Click="UsageDisconnect_Click"
                                                Style="{StaticResource UsageLoginButton}" Margin="0,0,14,0"
                                                ToolTip="Grok Build 계정 사용량 연결 끊기" Visibility="Collapsed">
                                            <StackPanel Orientation="Horizontal">
                                                <Path Style="{StaticResource LucideButtonIcon}" Data="{StaticResource IconLogOut}"
                                                      Width="13" Height="13" Stroke="{DynamicResource DangerBrush}"/>
                                                <TextBlock Text="연결 끊기" Margin="6,0,0,0" VerticalAlignment="Center"
                                                           FontSize="{DynamicResource Fs11}" Foreground="{DynamicResource DangerBrush}"/>
                                            </StackPanel>
                                        </Button>
                                        <Button Click="GrokLogin_Click" Style="{StaticResource UsageLoginButton}"
                                                ToolTip="xAI 계정으로 로그인해 Grok Build 사용량 연결 (Grok CLI 토큰도 자동 인식)">
                                            <StackPanel Orientation="Horizontal">
                                                <Image x:Name="GrokLoginIcon"
                                                       Source="pack://application:,,,/Resources/Images/ShellPresets/grok_icon_white_50.png"
                                                       Width="13" Height="13" VerticalAlignment="Center"
                                                       RenderOptions.BitmapScalingMode="HighQuality"/>
                                                <TextBlock Text="로그인 / 재연결" Margin="7,0,0,0" VerticalAlignment="Center"
                                                           FontSize="{DynamicResource Fs11}" Foreground="{DynamicResource TextBrush}"/>
                                            </StackPanel>
                                        </Button>
                                    </StackPanel>
                                </Grid>

                                <!-- DeepSeek (API 키) -->
                                <Grid>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                    </Grid.RowDefinitions>
                                    <Grid Grid.Row="0">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                                            <TextBlock Text="DeepSeek" VerticalAlignment="Center"
                                                       FontSize="{DynamicResource Fs13}" Foreground="{DynamicResource TextBrush}"/>
                                            <StackPanel x:Name="DeepSeekConnectedBadge" Orientation="Horizontal" Visibility="Collapsed"
                                                        Margin="10,0,0,0" VerticalAlignment="Center">
                                                <Ellipse Width="6" Height="6" Fill="{DynamicResource SuccessBrush}" VerticalAlignment="Center"/>
                                                <TextBlock Text="연결됨" Margin="5,0,0,0" VerticalAlignment="Center"
                                                           FontSize="{DynamicResource Fs11}" Foreground="{DynamicResource SuccessBrush}"/>
                                            </StackPanel>
                                        </StackPanel>
                                        <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                                            <Button x:Name="DeepSeekDisconnectButton" Tag="deepseek" Click="UsageDisconnect_Click"
                                                    Style="{StaticResource UsageLoginButton}" Margin="0,0,14,0"
                                                    ToolTip="DeepSeek 계정 사용량 연결 끊기" Visibility="Collapsed">
                                                <StackPanel Orientation="Horizontal">
                                                    <Path Style="{StaticResource LucideButtonIcon}" Data="{StaticResource IconLogOut}"
                                                          Width="13" Height="13" Stroke="{DynamicResource DangerBrush}"/>
                                                    <TextBlock Text="연결 끊기" Margin="6,0,0,0" VerticalAlignment="Center"
                                                               FontSize="{DynamicResource Fs11}" Foreground="{DynamicResource DangerBrush}"/>
                                                    </StackPanel>
                                            </Button>
                                            <CheckBox x:Name="DeepSeekEnabledToggle"
                                                      Style="{StaticResource ToggleSwitch}" VerticalAlignment="Center"
                                                      Checked="DeepSeekToggle_Changed" Unchecked="DeepSeekToggle_Changed"/>
                                        </StackPanel>
                                    </Grid>
                                    <!-- API 키 입력 영역 (토글 ON 일 때만 표시) -->
                                    <Border x:Name="DeepSeekKeyArea" Grid.Row="1" Margin="0,10,0,0" Padding="12,10"
                                            CornerRadius="10" Background="{DynamicResource PanelSoftBrush}"
                                            BorderBrush="{DynamicResource LineBrush}" BorderThickness="1"
                                            Visibility="Collapsed">
                                        <StackPanel>
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="Auto"/>
                                                </Grid.ColumnDefinitions>
                                                <Border Grid.Column="0" Style="{StaticResource FormFieldBox}">
                                                    <Grid>
                                                        <PasswordBox x:Name="DeepSeekKeyBox"
                                                                     FontSize="{DynamicResource Fs12}"
                                                                     Foreground="{DynamicResource TextBrush}"
                                                                     CaretBrush="{DynamicResource TextBrush}"
                                                                     Background="Transparent"
                                                                     BorderThickness="0" Padding="0"
                                                                     VerticalContentAlignment="Center"
                                                                     IsTabStop="True"
                                                                     PasswordChanged="DeepSeekKeyBox_PasswordChanged"/>
                                                        <TextBlock x:Name="DeepSeekKeyHint" Text="DeepSeek API 키"
                                                                   FontSize="{DynamicResource Fs12}"
                                                                   Foreground="{DynamicResource TextMutedBrush}"
                                                                   VerticalAlignment="Center" IsHitTestVisible="False"/>
                                                    </Grid>
                                                </Border>
                                                <Button Grid.Column="1" x:Name="DeepSeekSaveKeyBtn" Click="DeepSeekSaveKey_Click"
                                                        Margin="10,0,0,0" Height="38" Padding="16,0"
                                                        Style="{StaticResource PrimaryButton}">
                                                    <TextBlock Text="저장" FontSize="{DynamicResource Fs12}" FontWeight="SemiBold"/>
                                                </Button>
                                            </Grid>
                                            <TextBlock x:Name="DeepSeekKeyStatus" Margin="0,6,0,0"
                                                       FontSize="{DynamicResource Fs11}" Foreground="{DynamicResource SuccessBrush}"
                                                       Visibility="Collapsed"/>
                                        </StackPanel>
                                    </Border>
                                </Grid>

                                <Separator Margin="0,22,0,0" Background="{DynamicResource LineBrush}"/>

                                <!-- 그룹 2: 한도 도달 예상 표시 -->
                                <Grid Margin="0,20,0,0">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Grid.Column="0" VerticalAlignment="Center">
                                        <TextBlock Text="한도 도달 예상 표시" FontSize="{DynamicResource Fs13}"
                                                   Foreground="{DynamicResource TextBrush}"/>
                                        <TextBlock Text="사이드바와 툴팁에 예상 소진 시각 표시" FontSize="{DynamicResource Fs11}"
                                                   Foreground="{DynamicResource TextMutedBrush}" Margin="0,3,0,0"/>
                            </StackPanel>
                                    <CheckBox x:Name="ShowEstimateToggle" Grid.Column="1"
                                              Style="{StaticResource ToggleSwitch}" VerticalAlignment="Center"
                                              Checked="EstimateToggle_Changed" Unchecked="EstimateToggle_Changed"/>
                                </Grid>

                                <Separator Margin="0,22,0,0" Background="{DynamicResource LineBrush}"/>

                                <!-- 그룹 3: 하단 푸터 표시 -->
                                <TextBlock Text="하단 푸터 표시" FontSize="{DynamicResource Fs11}" FontWeight="SemiBold"
                                           Foreground="{DynamicResource TextMutedBrush}" Margin="0,20,0,12"/>

                                <Grid Margin="0,0,0,14">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Grid.Column="0" VerticalAlignment="Center">
                                        <TextBlock Text="Claude" FontSize="{DynamicResource Fs13}"
                                                   Foreground="{DynamicResource TextBrush}"/>
                                        <TextBlock Text="Claude 계정 사용량" FontSize="{DynamicResource Fs11}"
                                                   Foreground="{DynamicResource TextMutedBrush}" Margin="0,3,0,0"/>
                                    </StackPanel>
                                    <CheckBox x:Name="ShowFooterClaudeToggle" Grid.Column="1"
                                              Style="{StaticResource ToggleSwitch}" VerticalAlignment="Center"
                                              Checked="FooterUsageToggle_Changed" Unchecked="FooterUsageToggle_Changed"/>
                                </Grid>

                                <Grid Margin="0,0,0,14">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Grid.Column="0" VerticalAlignment="Center">
                                        <TextBlock Text="Codex" FontSize="{DynamicResource Fs13}"
                                                   Foreground="{DynamicResource TextBrush}"/>
                                        <TextBlock Text="ChatGPT(Codex) 계정 사용량" FontSize="{DynamicResource Fs11}"
                                                   Foreground="{DynamicResource TextMutedBrush}" Margin="0,3,0,0"/>
                                    </StackPanel>
                                    <CheckBox x:Name="ShowFooterCodexToggle" Grid.Column="1"
                                              Style="{StaticResource ToggleSwitch}" VerticalAlignment="Center"
                                              Checked="FooterUsageToggle_Changed" Unchecked="FooterUsageToggle_Changed"/>
                                </Grid>

                                <Grid Margin="0,0,0,14">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Grid.Column="0" VerticalAlignment="Center">
                                        <TextBlock Text="OpenCode Go" FontSize="{DynamicResource Fs13}"
                                                   Foreground="{DynamicResource TextBrush}"/>
                                        <TextBlock Text="OpenCode Go 계정 사용량" FontSize="{DynamicResource Fs11}"
                                                   Foreground="{DynamicResource TextMutedBrush}" Margin="0,3,0,0"/>
                                    </StackPanel>
                                    <CheckBox x:Name="ShowFooterGoToggle" Grid.Column="1"
                                              Style="{StaticResource ToggleSwitch}" VerticalAlignment="Center"
                                              Checked="FooterUsageToggle_Changed" Unchecked="FooterUsageToggle_Changed"/>
                                </Grid>

                                <Grid Margin="0,0,0,14">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Grid.Column="0" VerticalAlignment="Center">
                                        <TextBlock Text="DeepSeek" FontSize="{DynamicResource Fs13}"
                                                   Foreground="{DynamicResource TextBrush}"/>
                                        <TextBlock Text="DeepSeek API 잔액" FontSize="{DynamicResource Fs11}"
                                                   Foreground="{DynamicResource TextMutedBrush}" Margin="0,3,0,0"/>
                                    </StackPanel>
                                    <CheckBox x:Name="ShowFooterDeepSeekToggle" Grid.Column="1"
                                              Style="{StaticResource ToggleSwitch}" VerticalAlignment="Center"
                                              Checked="FooterUsageToggle_Changed" Unchecked="FooterUsageToggle_Changed"/>
                                </Grid>

                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Grid.Column="0" VerticalAlignment="Center">
                                        <TextBlock Text="Grok Build" FontSize="{DynamicResource Fs13}"
                                                   Foreground="{DynamicResource TextBrush}"/>
                                        <TextBlock Text="Grok Build 주간 한도" FontSize="{DynamicResource Fs11}"
                                                   Foreground="{DynamicResource TextMutedBrush}" Margin="0,3,0,0"/>
                                    </StackPanel>
                                    <CheckBox x:Name="ShowFooterGrokToggle" Grid.Column="1"
                                              Style="{StaticResource ToggleSwitch}" VerticalAlignment="Center"
                                              Checked="FooterUsageToggle_Changed" Unchecked="FooterUsageToggle_Changed"/>
                                </Grid>

                            </StackPanel>

                            <!-- 단축키 패널 — 탭 이동 전역 단축키 수식키 리바인드 -->
                            <StackPanel x:Name="ShortcutPanel" Margin="28,22,28,20" Visibility="Collapsed">
                                <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                                    <Path Style="{StaticResource LucideIcon}" Data="{StaticResource IconZap}"
                                          Width="16" Height="16" VerticalAlignment="Center" Margin="0,0,9,0"
                                          Stroke="{DynamicResource TextBrush}"/>
                                    <TextBlock Text="단축키" FontSize="{DynamicResource Fs14}" FontWeight="SemiBold"
                                               Foreground="{DynamicResource TextBrush}" VerticalAlignment="Center"/>
                                </StackPanel>
                                <TextBlock Text="세션 탭을 이전/다음으로 이동하는 전역 단축키입니다. 수식키를 누른 채 ← / → 방향키를 누릅니다."
                                           FontSize="{DynamicResource Fs12}" TextWrapping="Wrap"
                                           Foreground="{DynamicResource TextMutedBrush}" Margin="0,0,0,4"/>
                                <TextBlock Text="다른 앱이 포그라운드여도 동작합니다. 키 칸을 클릭한 뒤 원하는 키를 누르세요. (Esc 취소)"
                                           FontSize="{DynamicResource Fs11}" TextWrapping="Wrap"
                                           Foreground="{DynamicResource TextMutedBrush}" Margin="0,0,0,20"/>

                                <!-- 수식키 -->
                                <Grid Margin="0,16,0,14">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Grid.Column="0" VerticalAlignment="Center">
                                        <TextBlock Text="수식키" FontSize="{DynamicResource Fs13}"
                                                   Foreground="{DynamicResource TextBrush}"/>
                                        <TextBlock Text="누르고 있는 동안 ← / → 방향키가 세션 탭 이전/다음 이동으로 동작" FontSize="{DynamicResource Fs11}"
                                                   TextWrapping="Wrap"
                                                   Foreground="{DynamicResource TextMutedBrush}" Margin="0,3,12,0"/>
                                    </StackPanel>
                                    <Border x:Name="ModKeyField" Grid.Column="1" Tag="mod"
                                            Width="130" Height="38" Cursor="Arrow"
                                            Background="{DynamicResource PanelSoftBrush}"
                                            BorderBrush="{DynamicResource LineBrush}" BorderThickness="2"
                                            CornerRadius="8" MouseLeftButtonDown="KeyField_Click">
                                        <TextBlock x:Name="ModKeyText" Text="한자" VerticalAlignment="Center"
                                                   HorizontalAlignment="Center" FontSize="{DynamicResource Fs13}"
                                                   FontWeight="SemiBold" Foreground="{DynamicResource TextBrush}"/>
                                    </Border>
                                </Grid>
                            </StackPanel>

                            <!-- 테마 패널 -->
                            <StackPanel x:Name="ThemePanel" Margin="28,22,28,20" Visibility="Collapsed">
                                <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                                    <Path Style="{StaticResource LucideIcon}" Data="{StaticResource IconPalette}"
                                          Width="16" Height="16" VerticalAlignment="Center" Margin="0,0,9,0"
                                          Stroke="{DynamicResource TextBrush}"/>
                                    <TextBlock Text="테마/글꼴" FontSize="{DynamicResource Fs14}" FontWeight="SemiBold"
                                               Foreground="{DynamicResource TextBrush}" VerticalAlignment="Center"/>
                                </StackPanel>

                                <TextBlock Text="앱 전체에 적용되는 색 테마를 선택합니다." FontSize="{DynamicResource Fs12}"
                                           Foreground="{DynamicResource TextMutedBrush}" Margin="0,0,0,20"/>

                                <!-- 테마 카드 3종 (클릭 시 즉시 적용·저장) -->
