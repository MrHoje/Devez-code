<UserControl x:Class="DevezCode.Views.SettingsDialog"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:models="clr-namespace:DevezCode.Models"
             UseLayoutRounding="True"
             SnapsToDevicePixels="True"
             TextOptions.TextFormattingMode="Display"
             TextOptions.TextRenderingMode="ClearType"
             FontFamily="{StaticResource PretendardFont}">

    <UserControl.Resources>
        <!-- 좌측 카테고리 항목 (devez 이식) -->
        <Style x:Key="CategoryItem" TargetType="Button">
            <Setter Property="IsTabStop" Value="False"/>
            <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Foreground" Value="{DynamicResource TextBrush}"/>
            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
            <Setter Property="HorizontalAlignment" Value="Stretch"/>
            <Setter Property="Padding" Value="12,10"/>
            <Setter Property="FontSize" Value="{DynamicResource Fs13}"/>
            <Setter Property="Margin" Value="0,2"/>
            <Setter Property="Cursor" Value="Arrow"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd" Background="{TemplateBinding Background}"
                                CornerRadius="8" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Stretch" VerticalAlignment="Center"
                                              TextElement.Foreground="{TemplateBinding Foreground}"
                                              TextElement.FontWeight="{TemplateBinding FontWeight}"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource PanelBrush}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </UserControl.Resources>

    <!-- 설정창 콘텐츠 (devez SettingsDialog 이식).
         둥근 모서리/그림자/외곽선은 부모 SettingsWindow 가 담당하고, 이 컨트롤은 콘텐츠만 채운다.
         라운드 클립이 부모 Border(ClipToBounds=True)에서 적용되므로 자식 영역은 직각이어도 된다. -->
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="48"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

                    <!-- Header: 아이콘 + "설정" + 닫기. 좌상단 드래그 → 부모 SettingsWindow 이동 -->
                    <Border Grid.Row="0"
                            Background="{DynamicResource PanelBrush}"
                            BorderBrush="{DynamicResource LineBrush}"
                            BorderThickness="0,0,0,1"
                            MouseLeftButtonDown="Header_DragMove">
                        <Grid>
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="16,0,0,0">
                                <Path Style="{StaticResource LucideIcon}"
                                      Data="{StaticResource IconSettings}"
                                      Width="16" Height="16" VerticalAlignment="Center"
                                      Stroke="{DynamicResource TextBrush}"
                                      Margin="0,-1,11,0"/>
                                <TextBlock Text="설정" VerticalAlignment="Center"
                                           FontSize="{DynamicResource Fs14}" FontWeight="SemiBold"
                                           Foreground="{DynamicResource TextBrush}"/>
                            </StackPanel>
                            <Button Click="CancelBtn_Click"
                                    HorizontalAlignment="Right" VerticalAlignment="Center"
                                    Width="40" Height="32" Margin="0,0,8,0"
                                    Style="{StaticResource WinCloseBtn}">
                                <TextBlock Text="&#x2715;" FontSize="{DynamicResource Fs11}"/>
                            </Button>
                        </Grid>
                    </Border>

                    <!-- Body: 좌측 카테고리 | 우측 콘텐츠 -->
                    <Grid Grid.Row="1">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="170"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <!-- 좌측 카테고리 -->
                        <Border Grid.Column="0"
                                Background="{DynamicResource PanelSoftBrush}"
                                BorderBrush="{DynamicResource LineBrush}"
                                BorderThickness="0,0,1,0">
                            <StackPanel Margin="10,16,10,16">
                                <Button x:Name="CatGeneralBtn" Tag="general"
                                        Style="{StaticResource CategoryItem}" Click="Category_Click">
                                    <StackPanel Orientation="Horizontal">
                                        <Path Style="{StaticResource LucideButtonIcon}"
                                              Data="{StaticResource IconSettings}" Width="15" Height="15"
                                              Margin="0,0,10,0" VerticalAlignment="Center"/>
                                        <TextBlock Text="일반" VerticalAlignment="Center"/>
                                    </StackPanel>
                                </Button>
                                <Button x:Name="CatThemeBtn" Tag="theme"
                                        Style="{StaticResource CategoryItem}" Click="Category_Click">
                                    <StackPanel Orientation="Horizontal">
                                        <Path Style="{StaticResource LucideButtonIcon}"
                                              Data="{StaticResource IconPalette}" Width="15" Height="15"
                                              Margin="0,0,10,0" VerticalAlignment="Center"/>
                                        <TextBlock Text="테마/글꼴" VerticalAlignment="Center"/>
                                    </StackPanel>
                                </Button>
                                <Button x:Name="CatAgentBtn" Tag="agent"
                                        Style="{StaticResource CategoryItem}" Click="Category_Click">
                                    <StackPanel Orientation="Horizontal">
                                        <Path Style="{StaticResource LucideButtonIcon}"
                                              Data="{StaticResource IconTerminal}" Width="15" Height="15"
                                              Margin="0,0,10,0" VerticalAlignment="Center"/>
                                        <TextBlock Text="에이전트" VerticalAlignment="Center"/>
                                    </StackPanel>
                                </Button>
                                <Button x:Name="CatSidePanelBtn" Tag="sidepanel"
                                        Style="{StaticResource CategoryItem}" Click="Category_Click">
                                    <StackPanel Orientation="Horizontal">
                                        <Path Style="{StaticResource LucideButtonIcon}"
                                              Data="{StaticResource IconPanelLeft}" Width="15" Height="15"
                                              Margin="0,0,10,0" VerticalAlignment="Center"/>
                                        <TextBlock Text="사이드 패널" VerticalAlignment="Center"/>
                                    </StackPanel>
                                </Button>
                                <Button x:Name="CatChangelogBtn" Tag="changelog"
                                        Style="{StaticResource CategoryItem}" Click="Category_Click">
                                    <StackPanel Orientation="Horizontal">
                                        <Path Style="{StaticResource LucideButtonIcon}"
                                              Data="{StaticResource IconClock}" Width="15" Height="15"
                                              Margin="0,0,10,0" VerticalAlignment="Center"/>
                                        <TextBlock Text="업데이트 내역" VerticalAlignment="Center"/>
                                    </StackPanel>
                                </Button>
                                <!-- MCP 카테고리 보류 (2026-06): Visibility="Collapsed" — 재활성 시 제거 -->
                                <Button x:Name="CatMcpBtn" Tag="mcp" Visibility="Collapsed"
                                        Style="{StaticResource CategoryItem}" Click="Category_Click">
                                    <StackPanel Orientation="Horizontal">
                                        <Path Style="{StaticResource LucideButtonIcon}"
                                              Data="{StaticResource IconServer}" Width="15" Height="15"
                                              Margin="0,0,10,0" VerticalAlignment="Center"/>
                                        <TextBlock Text="MCP 서버" VerticalAlignment="Center"/>
                                    </StackPanel>
                                </Button>
                            </StackPanel>
                        </Border>

                        <!-- 우측 콘텐츠 -->
                        <ScrollViewer Grid.Column="1" VerticalScrollBarVisibility="Auto"
                                      HorizontalScrollBarVisibility="Disabled"
                                      Background="{DynamicResource PanelBrush}">
                          <Grid>
                            <!-- 일반 패널 -->
                            <StackPanel x:Name="GeneralPanel" Margin="28,22,28,20">
                                <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                                    <Path Style="{StaticResource LucideIcon}" Data="{StaticResource IconSettings}"
                                          Width="16" Height="16" VerticalAlignment="Center" Margin="0,0,9,0"
                                          Stroke="{DynamicResource TextBrush}"/>
                                    <TextBlock Text="일반" FontSize="{DynamicResource Fs14}" FontWeight="SemiBold"
                                               Foreground="{DynamicResource TextBrush}" VerticalAlignment="Center"/>
                                </StackPanel>
                                <TextBlock Text="프로젝트와 세션의 기본 동작을 설정합니다." FontSize="{DynamicResource Fs12}"
                                           Foreground="{DynamicResource TextMutedBrush}" Margin="0,0,0,20"/>

                                <Border Padding="14,12" CornerRadius="10"
                                        BorderBrush="{DynamicResource LineBrush}" BorderThickness="1"
                                        Background="{DynamicResource PanelSoftBrush}" Margin="0,0,0,10">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <StackPanel Grid.Column="0" VerticalAlignment="Center">
                                            <TextBlock Text="프로젝트 선택 시 세션 모두 로드" FontSize="{DynamicResource Fs13}" FontWeight="SemiBold"
                                                       Foreground="{DynamicResource TextBrush}"/>
                                            <TextBlock Text="끄면 첫 번째 세션만 실행하고, 다른 세션은 선택할 때 로드합니다."
                                                       FontSize="{DynamicResource Fs11}" TextWrapping="Wrap"
                                                       Foreground="{DynamicResource TextMutedBrush}" Margin="0,3,12,0"/>
                                        </StackPanel>
                                        <CheckBox x:Name="PreloadAllSessionsToggle" Grid.Column="1"
                                                  Style="{StaticResource ToggleSwitch}" VerticalAlignment="Center"
                                                  Checked="PreloadAllSessionsToggle_Changed" Unchecked="PreloadAllSessionsToggle_Changed"/>
                                    </Grid>
                                </Border>
                            </StackPanel>

                            <!-- 에이전트 패널 (설치된 CLI + 활성화 토글) -->
                            <StackPanel x:Name="AgentPanel" Margin="28,22,28,20" Visibility="Collapsed">
                                <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                                    <Path Style="{StaticResource LucideIcon}" Data="{StaticResource IconTerminal}"
                                          Width="16" Height="16" VerticalAlignment="Center" Margin="0,0,9,0"
                                          Stroke="{DynamicResource TextBrush}"/>
                                    <TextBlock Text="에이전트" FontSize="{DynamicResource Fs14}" FontWeight="SemiBold"
                                               Foreground="{DynamicResource TextBrush}" VerticalAlignment="Center"/>
                                </StackPanel>
                                <TextBlock Text="세션 추가 시 사용할 에이전트(CLI)를 선택합니다. PATH 에서 자동 감지합니다." FontSize="{DynamicResource Fs12}"
                                           Foreground="{DynamicResource TextMutedBrush}" Margin="0,0,0,4"/>
                                <TextBlock Text="변경은 새 세션부터 적용됩니다. 기존 세션은 그대로 유지됩니다." FontSize="{DynamicResource Fs11}"
                                           Foreground="{DynamicResource TextMutedBrush}" Margin="0,0,0,18"/>

                                <ItemsControl x:Name="AgentList">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Border Margin="0,0,0,10" Padding="14,12" CornerRadius="10"
                                                    BorderBrush="{DynamicResource LineBrush}" BorderThickness="1"
                                                    Background="{DynamicResource PanelSoftBrush}">
                                                <Grid>
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="*"/>
                                                        <ColumnDefinition Width="Auto"/>
                                                    </Grid.ColumnDefinitions>
                                                    <StackPanel Grid.Column="0" VerticalAlignment="Center">
                                                        <StackPanel Orientation="Horizontal">
                                                            <TextBlock Text="{Binding DisplayName}" FontSize="{DynamicResource Fs13}" FontWeight="SemiBold"
                                                                       Foreground="{DynamicResource TextBrush}" VerticalAlignment="Center"/>
                                                            <Border Margin="8,0,0,0" Padding="6,1" CornerRadius="4"
                                                                    Background="{Binding InstalledBrush}">
                                                                <TextBlock Text="{Binding InstalledLabel}" FontSize="{DynamicResource Fs10}"
                                                                           Foreground="White" VerticalAlignment="Center"/>
                                                            </Border>
                                                        </StackPanel>
                                                        <TextBlock Text="{Binding CommandHint}" FontSize="{DynamicResource Fs11}"
                                                                   Foreground="{DynamicResource TextMutedBrush}" Margin="0,3,0,0"/>
                                                        <!-- Claude Code 전용: 세션 유지기간 (~/.claude/settings.json 의 cleanupPeriodDays) -->
                                                        <StackPanel Margin="0,12,0,0"
                                                                    Visibility="{Binding IsClaudeCode, Converter={x:Static models:BoolVisibilityConverter.Instance}}">
                                                            <StackPanel Orientation="Horizontal">
                                                                <TextBlock Text="마지막 접근 후" FontSize="{DynamicResource Fs12}"
                                                                           Foreground="{DynamicResource TextBrush}" VerticalAlignment="Center"/>
                                                                <ComboBox Style="{StaticResource DockComboBox}" Margin="10,0,0,0" Width="108"
                                                                          VerticalAlignment="Center"
                                                                          ItemsSource="{Binding RetentionOptions}"
                                                                          DisplayMemberPath="Label" SelectedValuePath="Days"
                                                                          SelectedValue="{Binding RetentionDays, Mode=TwoWay}"/>
                                                            </StackPanel>
                                                            <TextBlock Text="설정 기간 동안 다시 열리지 않은 세션 기록을 Claude Code 가 자동 정리합니다. (전역설정)"
                                                                       FontSize="{DynamicResource Fs11}" Margin="0,6,0,0" TextWrapping="Wrap"
                                                                       Foreground="{DynamicResource TextMutedBrush}"/>
                                                        </StackPanel>
                                                    </StackPanel>
                                                    <CheckBox Grid.Column="1" IsChecked="{Binding Enabled, Mode=TwoWay}"
                                                              IsEnabled="{Binding Installed}"
                                                              Style="{StaticResource ToggleSwitch}" VerticalAlignment="Center"/>
                                                </Grid>
                                            </Border>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </StackPanel>

                            <!-- MCP 서버 패널 (별도 오버레이로 열기 — Theme/Agent 와 성격이 다름) -->
                            <StackPanel x:Name="McpPanel" Margin="28,22,28,20" Visibility="Collapsed">
                                <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                                    <Path Style="{StaticResource LucideIcon}" Data="{StaticResource IconServer}"
                                          Width="16" Height="16" VerticalAlignment="Center" Margin="0,0,9,0"
                                          Stroke="{DynamicResource TextBrush}"/>
                                    <TextBlock Text="MCP 서버" FontSize="{DynamicResource Fs14}" FontWeight="SemiBold"
                                               Foreground="{DynamicResource TextBrush}" VerticalAlignment="Center"/>
                                </StackPanel>
                                <TextBlock Text="opencode 의 MCP(Model Context Protocol) 서버를 추가·편집·삭제합니다." FontSize="{DynamicResource Fs12}"
                                           Foreground="{DynamicResource TextMutedBrush}" Margin="0,0,0,4"/>
                                <TextBlock Text="저장 시 ~/.config/opencode/opencode.json 의 mcp 섹션만 갱신합니다. 다른 필드는 보존됩니다."
                                           FontSize="{DynamicResource Fs11}" Foreground="{DynamicResource TextMutedBrush}" Margin="0,0,0,16"/>
                                <Button Style="{StaticResource PrimaryButton}" Click="OpenMcpManager_Click"
                                        Height="40" HorizontalAlignment="Left" Padding="18,0">
                                    <StackPanel Orientation="Horizontal">
                                        <Path Style="{StaticResource LucideButtonIcon}" Data="{StaticResource IconServer}"
                                              Width="13" Height="13" Margin="0,0,8,0" Stroke="White"/>
                                        <TextBlock Text="MCP 서버 관리 열기" FontSize="{DynamicResource Fs12}" FontWeight="SemiBold"/>
                                    </StackPanel>
                                </Button>
                            </StackPanel>

                            <!-- 업데이트 내역(Changelog) 패널 — devez 정합 -->
                            <StackPanel x:Name="ChangelogPanel" Margin="28,22,28,20" Visibility="Collapsed">
                                <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                                    <Path Style="{StaticResource LucideIcon}" Data="{StaticResource IconClock}"
                                          Width="16" Height="16" VerticalAlignment="Center" Margin="0,0,9,0"
                                          Stroke="{DynamicResource TextBrush}"/>
                                    <TextBlock Text="업데이트 내역" FontSize="{DynamicResource Fs14}" FontWeight="SemiBold"
                                               Foreground="{DynamicResource TextBrush}" VerticalAlignment="Center"/>
                                </StackPanel>

                                <!-- 버전 카드는 코드비하인드에서 동적 생성 -->
                                <StackPanel x:Name="ChangelogItemsHost" Margin="0,16,0,0"/>

                                <!-- 페이지네이션 -->
                                <Grid x:Name="ChangelogPager" Margin="0,10,0,0" Visibility="Collapsed">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <Button Grid.Column="0" x:Name="PrevPageBtn" Click="PrevPageBtn_Click"
                                            HorizontalAlignment="Left"
                                            Style="{StaticResource CategoryItem}" Padding="10,6" Margin="0">
                                        <StackPanel Orientation="Horizontal">
                                            <Path Style="{StaticResource LucideButtonIcon}"
                                                  Data="{StaticResource IconChevronRight}"
                                                  Width="14" Height="14" Margin="0,0,4,0" VerticalAlignment="Center"
                                                  RenderTransformOrigin="0.5,0.5">
                                                <Path.RenderTransform>
                                                    <ScaleTransform ScaleX="-1"/>
                                                </Path.RenderTransform>
                                            </Path>
                                            <TextBlock Text="이전" FontSize="{DynamicResource Fs12}" VerticalAlignment="Center"/>
                                        </StackPanel>
                                    </Button>
                                    <TextBlock Grid.Column="1" x:Name="PageIndicator"
                                               FontSize="{DynamicResource Fs12}" VerticalAlignment="Center"
                                               Foreground="{DynamicResource TextMutedBrush}"
                                               HorizontalAlignment="Center"/>
                                    <Button Grid.Column="2" x:Name="NextPageBtn" Click="NextPageBtn_Click"
                                            HorizontalAlignment="Right"
                                            Style="{StaticResource CategoryItem}" Padding="10,6" Margin="0">
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock Text="다음" FontSize="{DynamicResource Fs12}" VerticalAlignment="Center"/>
                                            <Path Style="{StaticResource LucideButtonIcon}"
                                                  Data="{StaticResource IconChevronRight}"
                                                  Width="14" Height="14" Margin="4,0,0,0" VerticalAlignment="Center"/>
                                        </StackPanel>
                                    </Button>
                                </Grid>
                            </StackPanel>

                            <!-- 사이드 패널 버튼 표시/숨김 패널 -->
                            <StackPanel x:Name="SidePanelPanel" Margin="28,22,28,20" Visibility="Collapsed">
                                <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                                    <Path Style="{StaticResource LucideIcon}" Data="{StaticResource IconPanelLeft}"
                                          Width="16" Height="16" VerticalAlignment="Center" Margin="0,0,9,0"
                                          Stroke="{DynamicResource TextBrush}"/>
                                    <TextBlock Text="사이드 패널" FontSize="{DynamicResource Fs14}" FontWeight="SemiBold"
                                               Foreground="{DynamicResource TextBrush}" VerticalAlignment="Center"/>
                                </StackPanel>
                                <TextBlock Text="우측 패널 상단의 뷰 전환 버튼 표시 여부를 선택합니다." FontSize="{DynamicResource Fs12}"
                                           Foreground="{DynamicResource TextMutedBrush}" Margin="0,0,0,20"/>

                                <Border Padding="14,12" CornerRadius="10"
                                        BorderBrush="{DynamicResource LineBrush}" BorderThickness="1"
                                        Background="{DynamicResource PanelSoftBrush}" Margin="0,0,0,10">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <StackPanel Grid.Column="0" VerticalAlignment="Center">
                                            <TextBlock Text="탐색기" FontSize="{DynamicResource Fs13}" FontWeight="SemiBold"
                                                       Foreground="{DynamicResource TextBrush}"/>
                                            <TextBlock Text="파일 탐색기 뷰 전환 버튼" FontSize="{DynamicResource Fs11}"
                                                       Foreground="{DynamicResource TextMutedBrush}" Margin="0,3,0,0"/>
                                        </StackPanel>
                                        <CheckBox x:Name="ShowDirViewToggle" Grid.Column="1"
                                                  Style="{StaticResource ToggleSwitch}" VerticalAlignment="Center"
                                                  Checked="SidePanelToggle_Changed" Unchecked="SidePanelToggle_Changed"/>
                                    </Grid>
                                </Border>

                                <Border Padding="14,12" CornerRadius="10"
                                        BorderBrush="{DynamicResource LineBrush}" BorderThickness="1"
                                        Background="{DynamicResource PanelSoftBrush}" Margin="0,0,0,10">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <StackPanel Grid.Column="0" VerticalAlignment="Center">
                                            <TextBlock Text="작업 큐" FontSize="{DynamicResource Fs13}" FontWeight="SemiBold"
                                                       Foreground="{DynamicResource TextBrush}"/>
                                            <TextBlock Text="작업 큐 뷰 전환 버튼" FontSize="{DynamicResource Fs11}"
                                                       Foreground="{DynamicResource TextMutedBrush}" Margin="0,3,0,0"/>
                                        </StackPanel>
                                        <CheckBox x:Name="ShowQueueViewToggle" Grid.Column="1"
                                                  Style="{StaticResource ToggleSwitch}" VerticalAlignment="Center"
                                                  Checked="SidePanelToggle_Changed" Unchecked="SidePanelToggle_Changed"/>
                                    </Grid>
                                </Border>

                                <Border Padding="14,12" CornerRadius="10"
                                        BorderBrush="{DynamicResource LineBrush}" BorderThickness="1"
                                        Background="{DynamicResource PanelSoftBrush}" Margin="0,0,0,10">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <StackPanel Grid.Column="0" VerticalAlignment="Center">
                                            <TextBlock Text="웹 브라우저" FontSize="{DynamicResource Fs13}" FontWeight="SemiBold"
                                                       Foreground="{DynamicResource TextBrush}"/>
                                            <TextBlock Text="브라우저 뷰 전환 버튼" FontSize="{DynamicResource Fs11}"
                                                       Foreground="{DynamicResource TextMutedBrush}" Margin="0,3,0,0"/>
                                        </StackPanel>
                                        <CheckBox x:Name="ShowBrowserViewToggle" Grid.Column="1"
                                                  Style="{StaticResource ToggleSwitch}" VerticalAlignment="Center"
                                                  Checked="SidePanelToggle_Changed" Unchecked="SidePanelToggle_Changed"/>
                                    </Grid>
                                </Border>

                                <Border Padding="14,12" CornerRadius="10"
                                        BorderBrush="{DynamicResource LineBrush}" BorderThickness="1"
                                        Background="{DynamicResource PanelSoftBrush}" Margin="0,0,0,10">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <StackPanel Grid.Column="0" VerticalAlignment="Center">
                                            <TextBlock Text="DIFF" FontSize="{DynamicResource Fs13}" FontWeight="SemiBold"
                                                       Foreground="{DynamicResource TextBrush}"/>
                                            <TextBlock Text="변경 내역(diff) 뷰 전환 버튼" FontSize="{DynamicResource Fs11}"
                                                       Foreground="{DynamicResource TextMutedBrush}" Margin="0,3,0,0"/>
                                        </StackPanel>
                                        <CheckBox x:Name="ShowDiffViewToggle" Grid.Column="1"
                                                  Style="{StaticResource ToggleSwitch}" VerticalAlignment="Center"
                                                  Checked="SidePanelToggle_Changed" Unchecked="SidePanelToggle_Changed"/>
                                    </Grid>
                                </Border>
                            </StackPanel>

                            <!-- 테마 패널 -->
                            <StackPanel x:Name="ThemePanel" Margin="28,22,28,20" Visibility="Collapsed">
                                <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                                    <Path Style="{StaticResource LucideIcon}" Data="{StaticResource IconPalette}"
                                          Width="16" Height="16" VerticalAlignment="Center" Margin="0,0,9,0"
                                          Stroke="{DynamicResource TextBrush}"/>
                                    <TextBlock Text="테마/글꼴" FontSize="{DynamicResource Fs14}" FontWeight="SemiBold"
                                               Foreground="{DynamicResource TextBrush}" VerticalAlignment="Center"/>
                                </StackPanel>

                                <TextBlock Text="앱 전체에 적용되는 색 테마를 선택합니다." FontSize="{DynamicResource Fs12}"
                                           Foreground="{DynamicResource TextMutedBrush}" Margin="0,0,0,16"/>

                                <!-- 테마 카드 3종 (클릭 시 즉시 적용·저장) -->
                                <StackPanel Orientation="Horizontal">

                                    <!-- ── 심플 (minimal) ─────────────────────────── -->
                                    <Border x:Name="ThemeCard_Minimal" Tag="minimal"
                                            Width="150" Height="150"
                                            BorderBrush="{DynamicResource LineBrush}" BorderThickness="2"
                                            Background="{DynamicResource PanelBrush}"
                                            CornerRadius="10" Margin="0,0,12,0"
                                            Cursor="Arrow" MouseLeftButtonDown="ThemeCard_Click">
                                        <Grid>
                                            <Grid.RowDefinitions>
                                                <RowDefinition Height="*"/>
                                                <RowDefinition Height="38"/>
                                            </Grid.RowDefinitions>
                                            <Border Grid.Row="0" CornerRadius="8,8,0,0" Margin="1"
                                                    Background="#F8FAFC" ClipToBounds="True">
                                                <Grid Margin="6">
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="32"/>
                                                        <ColumnDefinition Width="*"/>
                                                    </Grid.ColumnDefinitions>
                                                    <Border Grid.Column="0" Background="White" CornerRadius="3"
                                                            BorderBrush="#E2E8F0" BorderThickness="0.5">
                                                        <StackPanel Margin="3,4">
                                                            <Border Background="#2563EB" Height="3" CornerRadius="1.5" Margin="0,1.5"/>
                                                            <Border Background="#E2E8F0" Height="3" CornerRadius="1.5" Margin="0,1.5"/>
                                                            <Border Background="#E2E8F0" Height="3" CornerRadius="1.5" Margin="0,1.5"/>
                                                            <Border Background="#E2E8F0" Height="3" CornerRadius="1.5" Margin="0,1.5"/>
                                                        </StackPanel>
                                                    </Border>
                                                    <Border Grid.Column="1" Background="White" CornerRadius="3" Margin="4,0,0,0"
                                                            BorderBrush="#E2E8F0" BorderThickness="0.5">
                                                        <StackPanel Margin="5,5">
                                                            <Border Background="#0F172A" Height="4" Width="40" CornerRadius="1.5"
                                                                    HorizontalAlignment="Left" Margin="0,0,0,5"/>
                                                            <Border Background="#DBEAFE" Height="9" CornerRadius="3" Margin="0,2,8,2"/>
                                                            <Border Background="#F1F5F9" Height="9" CornerRadius="3" Margin="6,2,0,2"/>
                                                        </StackPanel>
                                                    </Border>
                                                </Grid>
                                            </Border>
                                            <Border Grid.Row="1" BorderBrush="{DynamicResource LineBrush}" BorderThickness="0,1,0,0">
                                                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center">
                                                    <Grid Width="14" Height="14" Margin="0,0,6,0">
                                                        <Ellipse Stroke="{DynamicResource LineBrush}" StrokeThickness="1.5"/>
                                                        <Ellipse x:Name="ThemeRadioDot_Minimal" Width="7" Height="7"
                                                                 Fill="{DynamicResource PrimaryBrush}" Visibility="Collapsed"/>
                                                    </Grid>
                                                    <TextBlock Text="심플" FontSize="{DynamicResource Fs12}"
                                                               Foreground="{DynamicResource TextBrush}" VerticalAlignment="Center"/>
                                                </StackPanel>
                                            </Border>
                                        </Grid>
                                    </Border>

                                    <!-- ── 소프트 (soft) ──────────────────────────── -->
                                    <Border x:Name="ThemeCard_Soft" Tag="soft"
                                            Width="150" Height="150"
                                            BorderBrush="{DynamicResource LineBrush}" BorderThickness="2"
                                            Background="{DynamicResource PanelBrush}"
                                            CornerRadius="10" Margin="0,0,12,0"
                                            Cursor="Arrow" MouseLeftButtonDown="ThemeCard_Click">
                                        <Grid>
                                            <Grid.RowDefinitions>
                                                <RowDefinition Height="*"/>
                                                <RowDefinition Height="38"/>
                                            </Grid.RowDefinitions>
                                            <Border Grid.Row="0" CornerRadius="8,8,0,0" Margin="1"
                                                    Background="#F2EDE6" ClipToBounds="True">
                                                <Grid Margin="6">
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="32"/>
                                                        <ColumnDefinition Width="*"/>
                                                    </Grid.ColumnDefinitions>
                                                    <Border Grid.Column="0" Background="#FAF7F2" CornerRadius="3"
                                                            BorderBrush="#D8D2C6" BorderThickness="0.5">
                                                        <StackPanel Margin="3,4">
                                                            <Border Background="#5C8C4A" Height="3" CornerRadius="1.5" Margin="0,1.5"/>
                                                            <Border Background="#D8D2C6" Height="3" CornerRadius="1.5" Margin="0,1.5"/>
                                                            <Border Background="#D8D2C6" Height="3" CornerRadius="1.5" Margin="0,1.5"/>
                                                            <Border Background="#D8D2C6" Height="3" CornerRadius="1.5" Margin="0,1.5"/>
                                                        </StackPanel>
                                                    </Border>
                                                    <Border Grid.Column="1" Background="#FAF7F2" CornerRadius="3" Margin="4,0,0,0"
                                                            BorderBrush="#D8D2C6" BorderThickness="0.5">
                                                        <StackPanel Margin="5,5">
                                                            <Border Background="#2A2620" Height="4" Width="40" CornerRadius="1.5"
                                                                    HorizontalAlignment="Left" Margin="0,0,0,5"/>
                                                            <Border Background="#DEECD6" Height="9" CornerRadius="3" Margin="0,2,8,2"/>
                                                            <Border Background="#ECE7DE" Height="9" CornerRadius="3" Margin="6,2,0,2"/>
                                                        </StackPanel>
                                                    </Border>
                                                </Grid>
                                            </Border>
                                            <Border Grid.Row="1" BorderBrush="{DynamicResource LineBrush}" BorderThickness="0,1,0,0">
                                                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center">
                                                    <Grid Width="14" Height="14" Margin="0,0,6,0">
                                                        <Ellipse Stroke="{DynamicResource LineBrush}" StrokeThickness="1.5"/>
                                                        <Ellipse x:Name="ThemeRadioDot_Soft" Width="7" Height="7"
                                                                 Fill="{DynamicResource PrimaryBrush}" Visibility="Collapsed"/>
                                                    </Grid>
                                                    <TextBlock Text="소프트" FontSize="{DynamicResource Fs12}"
                                                               Foreground="{DynamicResource TextBrush}" VerticalAlignment="Center"/>
                                                </StackPanel>
                                            </Border>
                                        </Grid>
                                    </Border>

                                    <!-- ── 다크 (dark) ────────────────────────────── -->
                                    <Border x:Name="ThemeCard_Dark" Tag="dark"
                                            Width="150" Height="150"
                                            BorderBrush="{DynamicResource LineBrush}" BorderThickness="2"
                                            Background="{DynamicResource PanelBrush}"
                                            CornerRadius="10" Margin="0"
                                            Cursor="Arrow" MouseLeftButtonDown="ThemeCard_Click">
                                        <Grid>
                                            <Grid.RowDefinitions>
                                                <RowDefinition Height="*"/>
                                                <RowDefinition Height="38"/>
                                            </Grid.RowDefinitions>
                                            <Border Grid.Row="0" CornerRadius="8,8,0,0" Margin="1"
                                                    Background="#1F1F1E" ClipToBounds="True">
                                                <Grid Margin="6">
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="32"/>
                                                        <ColumnDefinition Width="*"/>
                                                    </Grid.ColumnDefinitions>
                                                    <Border Grid.Column="0" Background="#272727" CornerRadius="3"
                                                            BorderBrush="#383838" BorderThickness="0.5">
                                                        <StackPanel Margin="3,4">
                                                            <Border Background="#E8E8E8" Height="3" CornerRadius="1.5" Margin="0,1.5"/>
                                                            <Border Background="#383838" Height="3" CornerRadius="1.5" Margin="0,1.5"/>
                                                            <Border Background="#383838" Height="3" CornerRadius="1.5" Margin="0,1.5"/>
                                                            <Border Background="#383838" Height="3" CornerRadius="1.5" Margin="0,1.5"/>
                                                        </StackPanel>
                                                    </Border>
                                                    <Border Grid.Column="1" Background="#272727" CornerRadius="3" Margin="4,0,0,0"
                                                            BorderBrush="#383838" BorderThickness="0.5">
                                                        <StackPanel Margin="5,5">
                                                            <Border Background="#E8E8E8" Height="4" Width="40" CornerRadius="1.5"
                                                                    HorizontalAlignment="Left" Margin="0,0,0,5"/>
                                                            <Border Background="#4A2810" Height="9" CornerRadius="3" Margin="0,2,8,2"/>
                                                            <Border Background="#363636" Height="9" CornerRadius="3" Margin="6,2,0,2"/>
                                                        </StackPanel>
                                                    </Border>
                                                </Grid>
                                            </Border>
                                            <Border Grid.Row="1" BorderBrush="{DynamicResource LineBrush}" BorderThickness="0,1,0,0">
                                                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center">
                                                    <Grid Width="14" Height="14" Margin="0,0,6,0">
                                                        <Ellipse Stroke="{DynamicResource LineBrush}" StrokeThickness="1.5"/>
                                                        <Ellipse x:Name="ThemeRadioDot_Dark" Width="7" Height="7"
                                                                 Fill="{DynamicResource PrimaryBrush}" Visibility="Collapsed"/>
                                                    </Grid>
                                                    <TextBlock Text="다크" FontSize="{DynamicResource Fs12}"
                                                               Foreground="{DynamicResource TextBrush}" VerticalAlignment="Center"/>
                                                </StackPanel>
                                            </Border>
                                        </Grid>
                                    </Border>

                                </StackPanel>

                                <Separator Margin="0,22,0,0" Background="{DynamicResource LineBrush}"/>

                                <!-- 글꼴 크기 (devez 이식: 작게=0 / 크게=1, 앱 전체 적용) -->
                                <TextBlock Text="글꼴 크기" FontSize="{DynamicResource Fs13}" FontWeight="SemiBold"
                                           Foreground="{DynamicResource TextBrush}" Margin="0,22,0,12"/>
                                <StackPanel Orientation="Horizontal">
                                    <Border x:Name="FontCard_Small" Tag="0" Width="120" Height="56"
                                            BorderBrush="{DynamicResource LineBrush}" BorderThickness="2"
                                            Background="{DynamicResource PanelBrush}" CornerRadius="10" Margin="0,0,10,0"
                                            Cursor="Arrow" MouseLeftButtonDown="FontSizeCard_Click">
                                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center">
                                            <Grid Width="14" Height="14" Margin="0,0,8,0">
                                                <Ellipse Stroke="{DynamicResource LineBrush}" StrokeThickness="1.5"/>
                                                <Ellipse x:Name="FontRadioDot_Small" Width="7" Height="7"
                                                         Fill="{DynamicResource PrimaryBrush}" Visibility="Collapsed"/>
                                            </Grid>
                                            <TextBlock Text="작게" FontSize="{DynamicResource Fs13}"
                                                       Foreground="{DynamicResource TextBrush}" VerticalAlignment="Center"/>
                                        </StackPanel>
                                    </Border>
                                    <Border x:Name="FontCard_Large" Tag="1" Width="120" Height="56"
                                            BorderBrush="{DynamicResource LineBrush}" BorderThickness="2"
                                            Background="{DynamicResource PanelBrush}" CornerRadius="10" Margin="0,0,10,0"
                                            Cursor="Arrow" MouseLeftButtonDown="FontSizeCard_Click">
                                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center">
                                            <Grid Width="14" Height="14" Margin="0,0,8,0">
                                                <Ellipse Stroke="{DynamicResource LineBrush}" StrokeThickness="1.5"/>
                                                <Ellipse x:Name="FontRadioDot_Large" Width="7" Height="7"
                                                         Fill="{DynamicResource PrimaryBrush}" Visibility="Collapsed"/>
                                            </Grid>
                                            <TextBlock Text="크게" FontSize="{DynamicResource Fs15}"
                                                       Foreground="{DynamicResource TextBrush}" VerticalAlignment="Center"/>
                                        </StackPanel>
                                    </Border>
                                </StackPanel>
                            </StackPanel>
                          </Grid>
                        </ScrollViewer>
                    </Grid>

                    <!-- Footer: 취소 / 저장 (devez 이식) -->
                    <Border Grid.Row="2"
                            Background="{DynamicResource PanelSoftBrush}"
                            BorderBrush="{DynamicResource LineBrush}"
                            BorderThickness="0,1,0,0">
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right"
                                    Margin="20,14,20,14">
                            <Button Click="ForceCancelBtn_Click"
                                    Width="100" Height="38" Margin="0,0,8,0"
                                    Style="{StaticResource SecondaryButton}"
                                    FontSize="{DynamicResource Fs13}">
                                <TextBlock Text="취소"/>
                            </Button>
                            <Button x:Name="SaveBtn" Click="SaveBtn_Click"
                                    Width="100" Height="38"
                                    Style="{StaticResource PrimaryButton}"
                                    FontSize="{DynamicResource Fs13}">
                                <TextBlock Text="저장" Foreground="White"/>
                            </Button>
                        </StackPanel>
                    </Border>
    </Grid>
</UserControl>
