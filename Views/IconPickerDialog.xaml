<Window x:Class="DevezCode.Views.IconPickerDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="아이콘 바꾸기" Width="680"
        SizeToContent="Height"
        WindowStartupLocation="CenterOwner" ResizeMode="NoResize"
        WindowStyle="None" AllowsTransparency="True"
        Background="Transparent"
        ShowInTaskbar="False"
        UseLayoutRounding="True" SnapsToDevicePixels="True"
        TextOptions.TextFormattingMode="Display"
        TextOptions.TextRenderingMode="ClearType"
        TextOptions.TextHintingMode="Fixed"
        RenderOptions.ClearTypeHint="Enabled"
        FontFamily="{StaticResource PretendardFont}">

    <Grid Margin="18">
        <!-- Shadow layer -->
        <Border Background="{DynamicResource BgBrush}" CornerRadius="14">
            <Border.Effect>
                <DropShadowEffect ShadowDepth="0" BlurRadius="40" Color="{DynamicResource ShadowColor}" Opacity="{DynamicResource ShadowOpacity}"/>
            </Border.Effect>
        </Border>
        <!-- Content layer -->
        <Border CornerRadius="14"
                Background="{DynamicResource BgBrush}"
                BorderBrush="{DynamicResource LineBrush}" BorderThickness="1"
                ClipToBounds="True">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" MinHeight="48"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <!-- Header -->
                <Border Grid.Row="0" BorderBrush="{DynamicResource LineBrush}" BorderThickness="0,0,0,1" Padding="0,10"
                        Background="Transparent"
                        MouseLeftButtonDown="Header_DragMove">
                    <Grid>
                        <StackPanel Margin="20,0,0,0" VerticalAlignment="Center">
                            <TextBlock Text="아이콘 바꾸기"
                                       FontSize="{DynamicResource Fs14}" FontWeight="SemiBold"
                                       Foreground="{DynamicResource TextBrush}"/>
                            <TextBlock x:Name="SubtitleText"
                                       FontSize="{DynamicResource Fs11}"
                                       Foreground="{DynamicResource TextMutedBrush}"
                                       Margin="0,1,0,0"/>
                        </StackPanel>
                        <Button Click="CloseBtn_Click"
                                HorizontalAlignment="Right" VerticalAlignment="Center"
                                Width="40" Height="32" Margin="0,0,8,0"
                                Style="{StaticResource WinCloseBtn}">
                            <TextBlock Text="&#x2715;" FontSize="{DynamicResource Fs11}"/>
                        </Button>
                    </Grid>
                </Border>

                <!-- Body -->
                <StackPanel Grid.Row="1" Margin="20,16,20,16">
                    <TextBlock Text="아이콘" FontSize="{DynamicResource Fs11}" FontWeight="SemiBold"
                               Foreground="{DynamicResource TextMutedBrush}"
                               Margin="0,0,0,8"/>
                    <UniformGrid x:Name="IconGrid" Columns="10"/>

                    <TextBlock Text="색상" FontSize="{DynamicResource Fs11}" FontWeight="SemiBold"
                               Foreground="{DynamicResource TextMutedBrush}"
                               Margin="0,16,0,8"/>
                    <UniformGrid x:Name="ColorGrid" Columns="10"/>
                </StackPanel>

                <!-- Footer -->
                <Border Grid.Row="2"
                        Background="{DynamicResource PanelSoftBrush}"
                        BorderBrush="{DynamicResource LineBrush}"
                        BorderThickness="0,1,0,0"
                        CornerRadius="0,0,14,14">
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right"
                                Margin="20,12,20,12">
                        <Button x:Name="CancelBtn" Click="CancelBtn_Click"
                                Width="100" Height="38"
                                Style="{StaticResource SecondaryButton}"
                                FontSize="{DynamicResource Fs13}" Margin="0,0,8,0">
                            <TextBlock Text="취소"/>
                        </Button>
                        <Button Click="OkBtn_Click"
                                Width="100" Height="38"
                                Style="{StaticResource PrimaryButton}" FontSize="{DynamicResource Fs13}">
                            <TextBlock Text="적용" Foreground="White"/>
                        </Button>
                    </StackPanel>
                </Border>
            </Grid>
        </Border>
    </Grid>
</Window>
