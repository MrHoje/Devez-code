<Window x:Class="DevezCode.Views.ConfirmDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="확인" Height="340" Width="600"
        WindowStartupLocation="CenterOwner" ResizeMode="NoResize"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        ShowInTaskbar="False"
        UseLayoutRounding="True"
        SnapsToDevicePixels="True"
        TextOptions.TextFormattingMode="Display"
        TextOptions.TextRenderingMode="ClearType"
        TextOptions.TextHintingMode="Fixed"
        RenderOptions.ClearTypeHint="Enabled"
        FontFamily="{StaticResource PretendardFont}">

    <Grid Margin="20">
        <!-- Shadow layer -->
        <Border Background="{DynamicResource BgBrush}" CornerRadius="14">
            <Border.Effect>
                <DropShadowEffect ShadowDepth="0" BlurRadius="40" Color="{DynamicResource ShadowColor}" Opacity="{DynamicResource ShadowOpacity}"/>
            </Border.Effect>
        </Border>
        <!-- Content layer -->
        <Border CornerRadius="14"
                Background="{DynamicResource BgBrush}"
                BorderBrush="{DynamicResource LineBrush}" BorderThickness="1"
                ClipToBounds="True">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="48"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <!-- Header -->
                <Border Grid.Row="0"
                        BorderBrush="{DynamicResource LineBrush}"
                        BorderThickness="0,0,0,1"
                        Background="Transparent"
                        MouseLeftButtonDown="Header_DragMove">
                    <Grid>
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center"
                                    Margin="20,0,0,0">
                            <TextBlock x:Name="TitleText"
                                       Margin="0,0,0,0"
                                       VerticalAlignment="Center"
                                       FontSize="{DynamicResource Fs14}" FontWeight="SemiBold"
                                       Foreground="{DynamicResource TextBrush}"/>
                        </StackPanel>

                        <Button Click="CancelBtn_Click"
                                HorizontalAlignment="Right" VerticalAlignment="Center"
                                Width="40" Height="32" Margin="0,0,8,0"
                                Style="{StaticResource WinCloseBtn}">
                            <TextBlock Text="&#x2715;" FontSize="{DynamicResource Fs11}"/>
                        </Button>
                    </Grid>
                </Border>

                <!-- Body -->
                <StackPanel Grid.Row="1" Margin="28,18,28,10" VerticalAlignment="Center">
                    <TextBlock x:Name="MessageText"
                               FontSize="{DynamicResource Fs13}"
                               Foreground="{DynamicResource TextBrush}"
                               TextWrapping="Wrap"
                               LineStackingStrategy="BlockLineHeight"
                               LineHeight="22"/>
                    <StackPanel x:Name="ConfirmInputPanel" Visibility="Collapsed" Margin="0,14,0,0">
                        <TextBlock x:Name="ConfirmHintText"
                                   FontSize="{DynamicResource Fs12}"
                                   Foreground="{DynamicResource TextMutedBrush}"
                                   Margin="0,0,0,6"/>
                        <Border BorderBrush="{DynamicResource LineBrush}" BorderThickness="1.5"
                                Background="{DynamicResource PanelBrush}" CornerRadius="8"
                                Height="40" Padding="12,0">
                            <TextBox x:Name="ConfirmInputBox"
                                     Background="Transparent" BorderThickness="0"
                                     FocusVisualStyle="{x:Null}"
                                     Foreground="{DynamicResource TextBrush}"
                                     CaretBrush="{DynamicResource TextBrush}"
                                     FontSize="{DynamicResource Fs13}"
                                     FontFamily="{StaticResource PretendardFont}"
                                     VerticalContentAlignment="Center"
                                     TextChanged="ConfirmInputBox_TextChanged">
                                <TextBox.Resources>
                                    <Style TargetType="Border"><Setter Property="CornerRadius" Value="0"/></Style>
                                </TextBox.Resources>
                            </TextBox>
                        </Border>
                    </StackPanel>
                </StackPanel>

                <!-- Footer -->
                <Border Grid.Row="2"
                        Background="{DynamicResource PanelSoftBrush}"
                        BorderBrush="{DynamicResource LineBrush}"
                        BorderThickness="0,1,0,0"
                        CornerRadius="0,0,14,14">
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right"
                                Margin="20,14,20,14">
                        <Button x:Name="CancelBtn" Click="CancelBtn_Click"
                                MinWidth="80" Height="38" Padding="16,0"
                                Style="{StaticResource SecondaryButton}"
                                FontSize="{DynamicResource Fs13}" Margin="0,0,8,0">
                            <TextBlock Text="취소" TextTrimming="None"/>
                        </Button>

                        <!-- 3버튼 모드 전용 중간 버튼 (예: '저장 안 함'). 기본 숨김. -->
                        <Button x:Name="MiddleBtn" Click="MiddleBtn_Click"
                                MinWidth="80" Height="38" Padding="16,0" Visibility="Collapsed"
                                Style="{StaticResource SecondaryButton}"
                                FontSize="{DynamicResource Fs13}" Margin="0,0,8,0">
                            <TextBlock x:Name="MiddleText" TextTrimming="None"/>
                        </Button>

                        <Button x:Name="OkBtn" Click="OkBtn_Click"
                                MinWidth="80" Height="38" Padding="16,0"
                                Style="{StaticResource PrimaryButton}"
                                FontSize="{DynamicResource Fs13}">
                            <TextBlock x:Name="OkText" Text="확인" Foreground="White" TextTrimming="None"/>
                        </Button>
                    </StackPanel>
                </Border>
            </Grid>
        </Border>
    </Grid>
</Window>
