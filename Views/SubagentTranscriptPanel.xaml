<UserControl x:Class="DevezCode.Views.SubagentTranscriptPanel"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Background="{DynamicResource BgBrush}"
             FontFamily="{StaticResource PretendardFont}">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Header -->
        <Border BorderBrush="{DynamicResource LineBrush}" BorderThickness="0,0,0,1"
                Background="{DynamicResource PanelSoftBrush}" Padding="8,3">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <Border x:Name="AgentTypeBadge" CornerRadius="3"
                        Background="{DynamicResource PrimaryBrush}"
                        Padding="5,1" VerticalAlignment="Center">
                    <TextBlock x:Name="AgentTypeText"
                               FontSize="{DynamicResource Fs9}"
                               Foreground="White" FontWeight="SemiBold"/>
                </Border>

                <TextBlock Grid.Column="1" x:Name="AgentIdText"
                           Margin="5,0,0,0" FontSize="{DynamicResource Fs10}"
                           Foreground="{DynamicResource TextBrush}"
                           TextTrimming="CharacterEllipsis"
                           VerticalAlignment="Center" MaxWidth="300"/>

                <TextBlock Grid.Column="2" x:Name="StatusText"
                           FontSize="{DynamicResource Fs9}"
                           Foreground="{DynamicResource TextMutedBrush}"
                           VerticalAlignment="Center"/>
            </Grid>
        </Border>

        <!-- Content -->
        <ScrollViewer x:Name="TranscriptScroll" Visibility="Collapsed"
                      VerticalScrollBarVisibility="Auto"
                      HorizontalScrollBarVisibility="Disabled"
                      Padding="6,4,6,4">
            <ItemsControl x:Name="TranscriptList">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Border CornerRadius="5" Padding="6,4" Margin="0,1"
                                MaxWidth="420" HorizontalAlignment="Left"
                                BorderBrush="{DynamicResource LineBrush}" BorderThickness="1"
                                Background="{DynamicResource PanelSoftBrush}">
                            <Border.Style>
                                <Style TargetType="Border">
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding Role}" Value="user">
                                            <Setter Property="HorizontalAlignment" Value="Right"/>
                                            <Setter Property="Background" Value="{DynamicResource PrimaryBrush}"/>
                                            <Setter Property="BorderThickness" Value="0"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Border.Style>
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                </Grid.RowDefinitions>
                                <Grid Grid.Row="0">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <Border CornerRadius="2" Padding="4,0"
                                            Background="{DynamicResource PrimaryBrush}">
                                        <Border.Style>
                                            <Style TargetType="Border">
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding Role}" Value="user">
                                                        <Setter Property="Background" Value="{DynamicResource TextMutedBrush}"/>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Border.Style>
                                        <TextBlock Text="{Binding Role}"
                                                   FontSize="{DynamicResource Fs8}"
                                                   Foreground="White" FontWeight="SemiBold"/>
                                    </Border>
                                    <TextBlock Grid.Column="2" Text="{Binding Timestamp}"
                                               FontSize="{DynamicResource Fs8}"
                                               Foreground="{DynamicResource TextMutedBrush}"
                                               VerticalAlignment="Center"/>
                                </Grid>
                                <TextBlock Grid.Row="1" Margin="0,2,0,0"
                                           Text="{Binding Content}"
                                           FontSize="{DynamicResource Fs10}"
                                           TextWrapping="Wrap"
                                           LineStackingStrategy="BlockLineHeight"
                                           LineHeight="16">
                                    <TextBlock.Style>
                                        <Style TargetType="TextBlock">
                                            <Setter Property="Foreground" Value="{DynamicResource TextBrush}"/>
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding Role}" Value="user">
                                                    <Setter Property="Foreground" Value="White"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBlock.Style>
                                </TextBlock>
                            </Grid>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </ScrollViewer>

        <!-- Hook fallback -->
        <ScrollViewer x:Name="FallbackScroll" Visibility="Visible"
                      VerticalScrollBarVisibility="Auto" Padding="10,8,10,8">
            <TextBlock x:Name="FallbackPrompt"
                       FontSize="{DynamicResource Fs10}"
                       Foreground="{DynamicResource TextMutedBrush}"
                       TextWrapping="Wrap"
                       FontFamily="Cascadia Code, Consolas, monospace"/>
        </ScrollViewer>
    </Grid>
</UserControl>
