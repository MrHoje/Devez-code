<UserControl x:Class="DevezCode.Views.SubagentTranscriptPanel"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Background="{DynamicResource BgBrush}"
             FontFamily="{StaticResource PretendardFont}">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Header -->
        <Border BorderBrush="{DynamicResource LineBrush}" BorderThickness="0,0,0,1"
                Background="{DynamicResource PanelSoftBrush}" Padding="8,4">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <Border x:Name="AgentTypeBadge" CornerRadius="3"
                        Background="{DynamicResource PrimaryBrush}"
                        Padding="5,1" VerticalAlignment="Center">
                    <TextBlock x:Name="AgentTypeText"
                               FontSize="{DynamicResource Fs10}"
                               Foreground="White" FontWeight="SemiBold"/>
                </Border>

                <TextBlock Grid.Column="1" x:Name="AgentIdText"
                           Margin="6,0,0,0" FontSize="{DynamicResource Fs11}"
                           Foreground="{DynamicResource TextBrush}"
                           TextTrimming="CharacterEllipsis"
                           VerticalAlignment="Center"/>

                <TextBlock Grid.Column="2" x:Name="StatusText"
                           Margin="6,0,0,0" FontSize="{DynamicResource Fs10}"
                           Foreground="{DynamicResource TextMutedBrush}"
                           VerticalAlignment="Center"/>

                <Button Grid.Column="3" x:Name="CloseBtn"
                        Width="28" Height="28" Margin="4,0,0,0"
                        Style="{StaticResource WinCloseBtn}" Click="CloseBtn_Click">
                    <TextBlock Text="&#x2715;" FontSize="{DynamicResource Fs10}"/>
                </Button>
            </Grid>
        </Border>

        <!-- Content -->
        <Grid Grid.Row="1">
            <!-- JSONL transcript -->
            <ScrollViewer x:Name="TranscriptScroll" Visibility="Collapsed"
                          VerticalScrollBarVisibility="Auto" Padding="8,8,8,8">
                <ItemsControl x:Name="TranscriptList">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border CornerRadius="6" Padding="8,6" Margin="0,2"
                                    MaxWidth="400" HorizontalAlignment="Left"
                                    BorderBrush="{DynamicResource LineBrush}" BorderThickness="1"
                                    Background="{DynamicResource PanelSoftBrush}">
                                <Border.Style>
                                    <Style TargetType="Border">
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding Role}" Value="user">
                                                <Setter Property="HorizontalAlignment" Value="Right"/>
                                                <Setter Property="Background" Value="{DynamicResource PrimaryBrush}"/>
                                                <Setter Property="BorderThickness" Value="0"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Border.Style>
                                <Grid>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                    </Grid.RowDefinitions>
                                    <Grid Grid.Row="0">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <Border CornerRadius="2" Padding="4,0"
                                                Background="{DynamicResource PrimaryBrush}">
                                            <Border.Style>
                                                <Style TargetType="Border">
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding Role}" Value="user">
                                                            <Setter Property="Background" Value="{DynamicResource TextMutedBrush}"/>
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </Border.Style>
                                            <TextBlock Text="{Binding Role}"
                                                       FontSize="{DynamicResource Fs9}"
                                                       Foreground="White" FontWeight="SemiBold"/>
                                        </Border>
                                        <TextBlock Grid.Column="2" Text="{Binding Timestamp}"
                                                   FontSize="{DynamicResource Fs9}"
                                                   Foreground="{DynamicResource TextMutedBrush}"
                                                   VerticalAlignment="Center"/>
                                    </Grid>
                                    <TextBlock Grid.Row="1" Margin="0,4,0,0"
                                               Text="{Binding Content}"
                                               FontSize="{DynamicResource Fs11}"
                                               TextWrapping="Wrap"
                                               LineStackingStrategy="BlockLineHeight"
                                               LineHeight="18">
                                        <TextBlock.Style>
                                            <Style TargetType="TextBlock">
                                                <Setter Property="Foreground" Value="{DynamicResource TextBrush}"/>
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding Role}" Value="user">
                                                        <Setter Property="Foreground" Value="White"/>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </TextBlock.Style>
                                    </TextBlock>
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </ScrollViewer>

            <!-- Hook fallback -->
            <ScrollViewer x:Name="FallbackScroll" Visibility="Visible"
                          VerticalScrollBarVisibility="Auto" Padding="12,12,12,12">
                <StackPanel>
                    <Border CornerRadius="6"
                            Background="{DynamicResource PanelSoftBrush}"
                            Padding="10,8" Margin="0,0,0,10">
                        <TextBlock Text="대화 transcript 없음 — 훅 데이터를 표시합니다."
                                   FontSize="{DynamicResource Fs11}"
                                   Foreground="{DynamicResource TextMutedBrush}"
                                   TextWrapping="Wrap"/>
                    </Border>
                    <Border CornerRadius="4" Background="{DynamicResource PanelSoftBrush}"
                            Padding="8,6" Margin="0,0,0,4">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="60"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="Agent" FontSize="{DynamicResource Fs10}"
                                       Foreground="{DynamicResource TextMutedBrush}"/>
                            <TextBlock Grid.Column="1" x:Name="FbAgentId"
                                       FontSize="{DynamicResource Fs11}"
                                       Foreground="{DynamicResource TextBrush}"/>
                        </Grid>
                    </Border>
                    <Border CornerRadius="4" Background="{DynamicResource PanelSoftBrush}"
                            Padding="8,6" Margin="0,0,0,4">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="60"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="Type" FontSize="{DynamicResource Fs10}"
                                       Foreground="{DynamicResource TextMutedBrush}"/>
                            <TextBlock Grid.Column="1" x:Name="FbType"
                                       FontSize="{DynamicResource Fs11}"
                                       Foreground="{DynamicResource TextBrush}"/>
                        </Grid>
                    </Border>
                    <Border CornerRadius="4" Background="{DynamicResource PanelSoftBrush}"
                            Padding="8,6" Margin="0,0,0,4">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="60"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="Status" FontSize="{DynamicResource Fs10}"
                                       Foreground="{DynamicResource TextMutedBrush}"/>
                            <TextBlock Grid.Column="1" x:Name="FbStatus"
                                       FontSize="{DynamicResource Fs11}"
                                       Foreground="{DynamicResource TextBrush}"/>
                        </Grid>
                    </Border>
                    <Border CornerRadius="4" Background="{DynamicResource PanelSoftBrush}"
                            Padding="8,6" Margin="0,0,0,4"
                            BorderBrush="{DynamicResource LineBrush}" BorderThickness="0,0,0,0">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>
                            <TextBlock Text="Prompt" FontSize="{DynamicResource Fs10}"
                                       Foreground="{DynamicResource TextMutedBrush}"
                                       Margin="0,0,0,4"/>
                            <Border Grid.Row="1" Background="{DynamicResource BgBrush}"
                                    CornerRadius="4" Padding="8,6"
                                    BorderBrush="{DynamicResource LineBrush}" BorderThickness="1">
                                <TextBlock x:Name="FbPrompt"
                                           FontSize="{DynamicResource Fs10}"
                                           Foreground="{DynamicResource TextBrush}"
                                           TextWrapping="Wrap"
                                           FontFamily="Cascadia Code, Consolas, monospace"/>
                            </Border>
                        </Grid>
                    </Border>
                </StackPanel>
            </ScrollViewer>
        </Grid>
    </Grid>
</UserControl>
