<UserControl x:Class="DevezCode.Views.WorkspacePaneView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:models="clr-namespace:DevezCode.Models"
             xmlns:v="clr-namespace:DevezCode.Views"
             FontFamily="{StaticResource PretendardFont}">

    <!-- Center: tabs + content (좌·우 보더로 채널 형성).
         단일 패널일 때는 좌우 보더(1,0,1,0)로 중앙 채널을 만든다.
         분할 시 MainWindow 가 BorderThickness 를 조정한다. -->
    <Border x:Name="CenterArea" Background="{DynamicResource BgBrush}"
            BorderBrush="{DynamicResource LineBrush}" BorderThickness="1,0,1,0"
            MouseLeftButtonDown="Pane_PreviewInteract" PreviewMouseLeftButtonDown="Pane_PreviewInteract">
      <!-- 분할 포커스 프레임: 1px 공간은 항상 예약하고 색상만 바꿔 터미널 리사이즈를 막는다. -->
      <Border x:Name="FocusFrame" BorderThickness="1" BorderBrush="Transparent"
              Margin="0,1,0,0" UseLayoutRounding="True" SnapsToDevicePixels="True">
      <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- 프로젝트 메타 바 (탭 헤더와 같은 높이). 탭 바 위에 별도 행으로 부착. -->
        <Border x:Name="MetaBar" Grid.Row="0" Height="35" Background="{DynamicResource BgBrush}"
                BorderBrush="{DynamicResource LineBrush}" BorderThickness="0,0,0,1"
                Padding="16,0,12,0" Visibility="Collapsed">
            <Grid>
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
              </Grid.ColumnDefinitions>
              <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center" HorizontalAlignment="Left">
                <!-- 프로젝트 명 -->
                <Path Data="{StaticResource IconHash}" Width="14" Height="14" Stretch="Uniform"
                      Style="{StaticResource LucideIcon}"
                      Stroke="{DynamicResource TextMutedBrush}"
                      VerticalAlignment="Center"/>
                <TextBlock x:Name="ProjectNameText" Margin="6,0,0,0" VerticalAlignment="Center"
                           FontFamily="{StaticResource PretendardFont}"
                           FontSize="{DynamicResource Fs12}"
                           Foreground="{DynamicResource TextBrush}"
                           TextTrimming="CharacterEllipsis"/>

                <Border Width="1" Height="12" Margin="12,0,12,0" VerticalAlignment="Center"
                        Background="{DynamicResource TextMutedBrush}" Opacity="0.55"/>

                <!-- 프로젝트 경로 -->
                <Path Data="{StaticResource IconFolder}" Width="14" Height="14" Stretch="Uniform"
                      Style="{StaticResource LucideIcon}"
                      Stroke="{DynamicResource TextMutedBrush}"
                      VerticalAlignment="Center"/>
                <TextBlock x:Name="ProjectPathText" Margin="6,0,0,0" VerticalAlignment="Center"
                           FontFamily="{StaticResource PretendardFont}"
                           FontSize="{DynamicResource Fs12}"
                           Foreground="{DynamicResource TextBrush}"
                           TextTrimming="CharacterEllipsis"
                           Cursor="Arrow"
                           MouseLeftButtonUp="ProjectPathText_MouseLeftButtonUp">
                    <TextBlock.Style>
                        <Style TargetType="TextBlock">
                            <Style.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter Property="TextDecorations" Value="Underline"/>
                                </Trigger>
                            </Style.Triggers>
                        </Style>
                    </TextBlock.Style>
                </TextBlock>

                <!-- 얇은 세로선 + 브렌치(클릭 새로고침) — 비-git 저장소면 그룹 전체 숨김 -->
                <StackPanel x:Name="BranchGroup" Orientation="Horizontal" Visibility="Collapsed">
                    <Border Width="1" Height="12" Margin="12,0,12,0" VerticalAlignment="Center"
                            Background="{DynamicResource TextMutedBrush}" Opacity="0.55"/>
                    <Border Background="Transparent" VerticalAlignment="Center">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <Path Data="{StaticResource IconGitBranch}" Width="14" Height="14" Stretch="Uniform"
                                  Style="{StaticResource LucideIcon}"
                                  Stroke="{DynamicResource TextMutedBrush}"
                                  VerticalAlignment="Center"/>
                            <TextBlock x:Name="ProjectBranchText" Margin="6,0,0,0" VerticalAlignment="Center"
                                       FontFamily="{StaticResource PretendardFont}"
                                       FontSize="{DynamicResource Fs12}"
                                       Foreground="{DynamicResource TextBrush}"/>
                            <TextBlock x:Name="ProjectSyncCountText" Margin="8,0,0,0" VerticalAlignment="Center"
                                       FontFamily="{StaticResource PretendardFont}"
                                       FontSize="{DynamicResource Fs12}"
                                       Foreground="{DynamicResource TextMutedBrush}"
                                       Visibility="Collapsed"/>
                        </StackPanel>
                    </Border>
                </StackPanel>

                <!-- 세로선 + 이 세션 누적 토큰 사용량(입/출력/비용) — claude·codex 만, 그 외 숨김 -->
                <StackPanel x:Name="UsageGroup" Orientation="Horizontal" Visibility="Collapsed">
                    <Border Width="1" Height="12" Margin="12,0,12,0" VerticalAlignment="Center"
                            Background="{DynamicResource TextMutedBrush}" Opacity="0.55"/>
                    <TextBlock x:Name="UsageText" VerticalAlignment="Center" Margin="0,1,0,0"
                               FontFamily="{StaticResource PretendardFont}"
                               FontSize="{DynamicResource Fs11}"
                               Foreground="{DynamicResource TextMutedBrush}"/>
                </StackPanel>
              </StackPanel>

              <!-- 우측 dock: model/effort(지원 에이전트) + 터미널 폰트 크기(항상 노출) -->
              <StackPanel Grid.Column="1" Orientation="Horizontal"
                          VerticalAlignment="Center" HorizontalAlignment="Right">
                  <Button x:Name="AttachFileBtn" Style="{StaticResource TabNavButton}"
                          Visibility="Collapsed"
                          Click="AttachFileBtn_Click" ToolTip="파일 첨부">
                      <Path Style="{StaticResource LucideIcon}" Data="{StaticResource IconPaperclip}"
                            Width="14" Height="14" Stretch="Uniform" StrokeThickness="1.8"
                            Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"/>
                  </Button>
                  <StackPanel x:Name="ModelEffortDock" Orientation="Horizontal"
                              Margin="8,0,0,0" VerticalAlignment="Center" Visibility="Collapsed">
                      <ComboBox x:Name="ModelCombo" Style="{StaticResource DockComboBox}" MinWidth="104" Margin="0,4,0,4"
                                SelectedValuePath="Value"
                                SelectionChanged="ModelCombo_SelectionChanged"
                                DropDownClosed="DockCombo_DropDownClosed"
                                ToolTip="이 세션의 모델"/>
                      <ComboBox x:Name="EffortCombo" Style="{StaticResource DockComboBox}" MinWidth="92" Margin="8,4,0,4"
                                SelectedValuePath="Value"
                                SelectionChanged="EffortCombo_SelectionChanged"
                                DropDownClosed="DockCombo_DropDownClosed"
                                ToolTip="이 세션의 추론 강도(effort)"/>
                  </StackPanel>
                  <StackPanel x:Name="CodexModelEffortDock" Orientation="Horizontal"
                              Margin="8,0,0,0" VerticalAlignment="Center" Visibility="Collapsed">
                      <Border Style="{StaticResource DockValueBorder}" MinWidth="104" MaxWidth="180" Margin="0,4,0,4"
                              ToolTip="이 Codex 세션의 모델(읽기 전용)">
                          <TextBlock x:Name="CodexModelText" Style="{StaticResource DockValueText}"/>
                      </Border>
                      <Border x:Name="CodexEffortValueBorder" Style="{StaticResource DockValueBorder}"
                              MinWidth="72" Margin="8,4,0,4" ToolTip="이 Codex 세션의 추론 강도(읽기 전용)">
                          <TextBlock x:Name="CodexEffortText" Style="{StaticResource DockValueText}"/>
                      </Border>
                  </StackPanel>
                  <ComboBox x:Name="FontSizeCombo" Style="{StaticResource DockComboBox}" MinWidth="72" Margin="8,4,0,4"
                            SelectedValuePath="Value"
                            SelectionChanged="FontSizeCombo_SelectionChanged"
                            DropDownClosed="DockCombo_DropDownClosed"
                            ToolTip="터미널 폰트 크기"/>
              </StackPanel>
            </Grid>
        </Border>

        <!-- Tab strip (devez 브라우저식 탭: 둥근 상단 + 선택 탭이 헤더와 이어짐) -->
        <Border x:Name="TabBar" Grid.Row="1" Height="35" Background="{DynamicResource BgBrush}"
                BorderBrush="{DynamicResource LineBrush}" BorderThickness="0,0,0,1"
                Padding="0,4,12,0"
                PreviewMouseWheel="TabBar_PreviewMouseWheel">
          <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <Border Grid.Column="0" Background="Transparent"
                    MouseLeftButtonDown="TabStrip_DragMove"/>

            <ScrollViewer x:Name="TabScroller" Grid.Column="0"
                          HorizontalScrollBarVisibility="Hidden" VerticalScrollBarVisibility="Disabled"
                          CanContentScroll="False" Background="{x:Null}"
                          ScrollChanged="TabScroller_ScrollChanged">
                <StackPanel Orientation="Horizontal">
                <ItemsControl x:Name="TabsHost" Padding="11,0,0,0">
                    <ItemsControl.ItemContainerStyle>
                        <Style TargetType="ContentPresenter">
                            <Style.Triggers>
                                <DataTrigger Value="True">
                                    <DataTrigger.Binding>
                                        <MultiBinding Converter="{x:Static models:TabActiveConverter.Instance}">
                                            <Binding/>
                                            <Binding Path="SelectedTab" RelativeSource="{RelativeSource AncestorType=v:WorkspacePaneView}"/>
                                        </MultiBinding>
                                    </DataTrigger.Binding>
                                    <Setter Property="Panel.ZIndex" Value="10"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </ItemsControl.ItemContainerStyle>
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate><StackPanel Orientation="Horizontal"/></ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate DataType="{x:Type models:TabItemBase}">
                          <Grid x:Name="TabRoot" Margin="0,0,3,0">
                            <Grid.Style>
                                <Style TargetType="Grid">
                                    <Setter Property="Visibility" Value="Visible"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsEffectivelyHidden}" Value="True">
                                            <Setter Property="Visibility" Value="Collapsed"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Grid.Style>
                            <Border x:Name="TabBd" Margin="0,0,0,-1"
                                    VerticalAlignment="Bottom" Padding="0,6"
                                    MinWidth="131" MaxWidth="248"
                                    CornerRadius="9,9,0,0"
                                    BorderThickness="1,1,1,0"
                                    BorderBrush="{DynamicResource LineBrush}"
                                    Cursor="Arrow"
                                    PreviewMouseLeftButtonDown="Tab_PreviewMouseLeftButtonDown"
                                    MouseLeftButtonUp="Tab_Click"
                                    PreviewMouseRightButtonUp="Tab_RightClick">
                                <Border.Style>
                                    <Style TargetType="Border">
                                        <Setter Property="Background" Value="{DynamicResource PanelSoftBrush}"/>
                                        <Style.Triggers>
                                            <DataTrigger Value="True">
                                                <DataTrigger.Binding>
                                                    <MultiBinding Converter="{x:Static models:TabActiveConverter.Instance}">
                                                        <Binding/>
                                                        <Binding Path="SelectedTab" RelativeSource="{RelativeSource AncestorType=v:WorkspacePaneView}"/>
                                                    </MultiBinding>
                                                </DataTrigger.Binding>
                                                <Setter Property="Background" Value="{DynamicResource PanelBrush}"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Border.Style>
                                <Grid Margin="12,0,8,0">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Grid.Column="0" Orientation="Horizontal" Margin="0,0,7,0">
                                        <Grid>
                                            <Image x:Name="TabAgentIcon" Width="14" Height="14"
                                                   VerticalAlignment="Center"
                                                   Source="{Binding AgentId, Converter={x:Static models:AgentImageConverter.Instance}}"
                                                   RenderOptions.BitmapScalingMode="HighQuality"/>
                                             <Path x:Name="TabFileIcon" Width="14" Height="14"
                                                   Stretch="Uniform" Visibility="Collapsed"
                                                   Data="{StaticResource IconFileText}"
                                                   Style="{StaticResource LucideIcon}"
                                                   Stroke="{DynamicResource TextMutedBrush}"/>
                                             <Path x:Name="TabBrowserIcon" Width="14" Height="14"
                                                   Stretch="Uniform" Visibility="Collapsed"
                                                   Data="{StaticResource IconGlobe}"
                                                   Style="{StaticResource LucideIcon}"
                                                   Stroke="{DynamicResource TextMutedBrush}"/>
                                            <!-- 입력 대기(선택지 메뉴): 아이콘 자리에 ❗ 표시(에이전트 아이콘 위에 겹쳐 노출). -->
                                            <!-- 높이를 15→13 + 하단 Margin 2: 상단 고정, 아래만 2px 줄임. -->
                                            <Path x:Name="TabWaitingIcon" Width="15" Height="13" Margin="0,0,0,2"
                                                  Stretch="Uniform" Visibility="Collapsed" VerticalAlignment="Center"
                                                  Data="{StaticResource IconExclamation}"
                                                  Stroke="{DynamicResource WarningBrush}" StrokeThickness="2.2"
                                                  StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                                                  Fill="Transparent"/>
                                            <!-- 진행중 스피너: IsBusy + !IsWaitingChoice → 대신 표시 -->
                                            <Ellipse x:Name="TabBusySpinner" Width="12" Height="12"
                                                     VerticalAlignment="Center"
                                                     Visibility="Collapsed"
                                                     models:SpinnerActivator.Track="True"
                                                     Stroke="{DynamicResource PrimaryBrush}" StrokeThickness="1.6"
                                                     StrokeDashArray="15 100" StrokeDashCap="Round"
                                                     RenderTransformOrigin="0.5,0.5">
                                                <Ellipse.RenderTransform>
                                                    <RotateTransform Angle="{Binding Angle, Source={x:Static models:SpinnerSync.Instance}}"/>
                                                </Ellipse.RenderTransform>
                                            </Ellipse>
                                        </Grid>
                                    </StackPanel>
                                    <TextBlock x:Name="TabTitle" Grid.Column="1" Text="{Binding Title}"
                                               VerticalAlignment="Center" TextTrimming="CharacterEllipsis"
                                               FontSize="{DynamicResource Fs12}" FontWeight="SemiBold"
                                               Foreground="{DynamicResource TextMutedBrush}"/>
                                    <Button x:Name="TabCloseButton" Grid.Column="2" Width="16" Height="16" Margin="8,0,0,0"
                                            Click="TabHide_Click" Tag="{Binding}"
                                            Background="Transparent" BorderThickness="0"
                                            Cursor="Arrow" IsTabStop="False" FocusVisualStyle="{x:Null}"
                                            ToolTip="탭에서 숨기기 (프로젝트를 다시 선택하면 돌아옵니다)">
                                        <Button.Template>
                                            <ControlTemplate TargetType="Button">
                                                <Border x:Name="Bd" Background="{TemplateBinding Background}" CornerRadius="5">
                                                    <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                </Border>
                                                <ControlTemplate.Triggers>
                                                    <Trigger Property="IsMouseOver" Value="True">
                                                        <Setter TargetName="Bd" Property="Background" Value="{DynamicResource LineBrush}"/>
                                                    </Trigger>
                                                </ControlTemplate.Triggers>
                                            </ControlTemplate>
                                        </Button.Template>
                                        <Path Style="{StaticResource LucideIcon}" Data="{StaticResource IconX}"
                                              Width="9" Height="9" Stroke="{DynamicResource TextMutedBrush}"/>
                                    </Button>
                                </Grid>
                            </Border>

                            <Path x:Name="TabFootLeftFill"
                                  HorizontalAlignment="Left" VerticalAlignment="Bottom"
                                  Margin="-10,0,0,-1"
                                  Fill="{DynamicResource PanelBrush}"
                                  Data="M11,0 L10,0 A10,13 0 0 1 0,13 L11,13 Z"
                                  Visibility="Collapsed"/>
                            <Path x:Name="TabFootLeftLine"
                                  HorizontalAlignment="Left" VerticalAlignment="Bottom"
                                  Margin="-10,0,0,-1"
                                  Stroke="{DynamicResource LineBrush}" StrokeThickness="1"
                                  Data="M10,-3 L10,0 A10,13 0 0 1 0,13"
                                  Visibility="Collapsed"/>
                            <Path x:Name="TabFootRightFill"
                                  HorizontalAlignment="Right" VerticalAlignment="Bottom"
                                  Margin="0,0,-10,-1"
                                  Fill="{DynamicResource PanelBrush}"
                                  Data="M0,0 L1,0 A10,13 0 0 0 11,13 L0,13 Z"
                                  Visibility="Collapsed"/>
                            <Path x:Name="TabFootRightLine"
                                  HorizontalAlignment="Right" VerticalAlignment="Bottom"
                                  Margin="0,0,-10,-1"
                                  Stroke="{DynamicResource LineBrush}" StrokeThickness="1"
                                  Data="M1,-3 L1,0 A10,13 0 0 0 11,13"
                                  Visibility="Collapsed"/>
                          </Grid>
                            <DataTemplate.Triggers>
                                <Trigger SourceName="TabBd" Property="IsMouseOver" Value="True">
                                    <Setter TargetName="TabTitle" Property="Foreground" Value="{DynamicResource TextBrush}"/>
                                </Trigger>
                                 <DataTrigger Binding="{Binding Kind}" Value="File">
                                     <Setter TargetName="TabAgentIcon" Property="Visibility" Value="Collapsed"/>
                                     <Setter TargetName="TabFileIcon" Property="Visibility" Value="Visible"/>
                                     <Setter TargetName="TabCloseButton" Property="ToolTip" Value="닫기"/>
                                 </DataTrigger>
                                 <DataTrigger Binding="{Binding Kind}" Value="Browser">
                                     <Setter TargetName="TabAgentIcon" Property="Visibility" Value="Collapsed"/>
                                     <Setter TargetName="TabBrowserIcon" Property="Visibility" Value="Visible"/>
                                     <Setter TargetName="TabCloseButton" Property="ToolTip" Value="닫기"/>
                                 </DataTrigger>
                                <!-- 입력 대기: 에이전트 아이콘 숨기고 ❗ 노출(File 트리거 뒤에 둬서 세션 탭에서 우선). -->
                                <DataTrigger Binding="{Binding IsWaitingChoice}" Value="True">
                                    <Setter TargetName="TabAgentIcon" Property="Visibility" Value="Collapsed"/>
                                    <Setter TargetName="TabWaitingIcon" Property="Visibility" Value="Visible"/>
                                </DataTrigger>
                                <!-- 진행중 스피너: IsBusy + !IsWaitingChoice → 에이전트 아이콘 대신 스피너 -->
                                <MultiDataTrigger>
                                    <MultiDataTrigger.Conditions>
                                        <Condition Binding="{Binding IsBusy}" Value="True"/>
                                        <Condition Binding="{Binding IsWaitingChoice}" Value="False"/>
                                    </MultiDataTrigger.Conditions>
                                    <Setter TargetName="TabAgentIcon" Property="Visibility" Value="Collapsed"/>
                                    <Setter TargetName="TabBusySpinner" Property="Visibility" Value="Visible"/>
                                </MultiDataTrigger>
                                <DataTrigger Value="True">
                                    <DataTrigger.Binding>
                                        <MultiBinding Converter="{x:Static models:TabActiveConverter.Instance}">
                                            <Binding/>
                                            <Binding Path="SelectedTab" RelativeSource="{RelativeSource AncestorType=v:WorkspacePaneView}"/>
                                        </MultiBinding>
                                    </DataTrigger.Binding>
                                    <Setter TargetName="TabTitle" Property="Foreground" Value="{DynamicResource TextBrush}"/>
                                    <Setter TargetName="TabFootLeftFill" Property="Visibility" Value="Visible"/>
                                    <Setter TargetName="TabFootLeftLine" Property="Visibility" Value="Visible"/>
                                    <Setter TargetName="TabFootRightFill" Property="Visibility" Value="Visible"/>
                                    <Setter TargetName="TabFootRightLine" Property="Visibility" Value="Visible"/>
                                </DataTrigger>
                             </DataTemplate.Triggers>
                         </DataTemplate>
                     </ItemsControl.ItemTemplate>
                 </ItemsControl>
                <Button x:Name="NewTabBtn" Click="NewTabBtn_Click"
                        IsTabStop="False" FocusVisualStyle="{x:Null}" Cursor="Arrow"
                        Width="24" Height="24" Margin="3,0,11,0" VerticalAlignment="Center"
                        ToolTip="새 탭 추가" Visibility="Collapsed"
                        Style="{StaticResource NewTabButton}">
                    <Button.ContextMenu>
                        <ContextMenu>
                            <MenuItem Header="새 세션" Click="NewSessionMenuItem_Click">
                                <MenuItem.Icon>
                                    <Path Style="{StaticResource LucideIcon}" Data="{StaticResource IconTerminal}"
                                          Width="13" Height="13" Stroke="{DynamicResource TextMutedBrush}"/>
                                </MenuItem.Icon>
                            </MenuItem>
                            <MenuItem Header="웹 브라우저" Click="NewBrowserMenuItem_Click">
                                <MenuItem.Icon>
                                    <Path Style="{StaticResource LucideIcon}" Data="{StaticResource IconGlobe}"
                                          Width="13" Height="13" Stroke="{DynamicResource TextMutedBrush}"/>
                                </MenuItem.Icon>
                            </MenuItem>
                            <MenuItem Header="파일 열기" Click="OpenFileMenuItem_Click">
                                <MenuItem.Icon>
                                    <Path Style="{StaticResource LucideIcon}" Data="{StaticResource IconFileText}"
                                          Width="13" Height="13" Stroke="{DynamicResource TextMutedBrush}"/>
                                </MenuItem.Icon>
                            </MenuItem>
                        </ContextMenu>
                    </Button.ContextMenu>
                    <Path Style="{StaticResource LucideIcon}" Data="{StaticResource IconPlus}"
                          Width="11" Height="11" StrokeThickness="1.3"
                          Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"/>
                </Button>
                </StackPanel>
            </ScrollViewer>

            <!-- 탭 오버플로우 시 좌·우 스크롤 버튼 + 분할/닫기 토글 (devez TabNavGroup) -->
            <StackPanel Grid.Column="1" Orientation="Horizontal"
                        VerticalAlignment="Center" Margin="4,0,0,3">
                <StackPanel x:Name="TabNavGroup" Orientation="Horizontal" Visibility="Collapsed">
                    <Button x:Name="TabScrollLeftBtn" Style="{StaticResource TabNavButton}"
                            Click="TabScrollLeft_Click" ToolTip="이전 탭">
                        <Path Style="{StaticResource LucideIcon}" Data="{StaticResource IconChevronLeft}"
                              Width="14" Height="14" Stretch="Uniform" StrokeThickness="1.8"
                              Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"/>
                    </Button>
                    <Button x:Name="TabScrollRightBtn" Style="{StaticResource TabNavButton}"
                            Click="TabScrollRight_Click" Margin="2,0,0,0" ToolTip="다음 탭">
                        <Path Style="{StaticResource LucideIcon}" Data="{StaticResource IconChevronRight}"
                              Width="14" Height="14" Stretch="Uniform" StrokeThickness="1.8"
                              Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"/>
                    </Button>
                </StackPanel>
                <Button x:Name="SplitDockBtn" Style="{StaticResource TabNavButton}"
                        Click="SplitDockBtn_Click" Margin="4,0,0,0" ToolTip="분할 보기">
                    <Path x:Name="SplitDockIcon" Style="{StaticResource LucideIcon}"
                          Data="{StaticResource IconPanelLeftOpen}" Width="14" Height="14" Stretch="Uniform"
                          Stroke="{DynamicResource TextMutedBrush}"/>
                </Button>
            </StackPanel>
          </Grid>
        </Border>

        <Border x:Name="SelectedTabSeam" Grid.Row="1" Height="1"
                VerticalAlignment="Bottom" HorizontalAlignment="Left"
                Background="{DynamicResource PanelBrush}"
                Visibility="Collapsed" IsHitTestVisible="False" Panel.ZIndex="100"/>

        <!-- 세션 타이틀 영역 (devez HeaderBar 정합) -->
        <Border x:Name="SessionHeaderBar" Grid.Row="2" Height="35"
                Background="{DynamicResource PanelBrush}"
                BorderBrush="{DynamicResource LineBrush}" BorderThickness="0,0,0,1"
                Visibility="Collapsed">
            <Grid Margin="11,0,8,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                    <Path x:Name="FileHeaderIcon" Style="{StaticResource LucideIcon}" Data="{StaticResource IconFileText}"
                          Width="14" Height="14" Margin="0,0,8,0" VerticalAlignment="Center"
                          Stroke="{DynamicResource TextMutedBrush}" Visibility="Collapsed"/>
                    <TextBlock x:Name="LastMessageSep" Text="❯"
                               Margin="0,0,8,0" VerticalAlignment="Center"
                               FontSize="{DynamicResource Fs13}"
                               Foreground="{DynamicResource TextMutedBrush}"
                               Visibility="Collapsed"/>
                     <!-- 파일명·dirty점·경로를 한 TextBlock의 inline으로 두어 폰트 크기가 달라도
                          글자 밑선(baseline)이 항상 맞도록 한다. (박스 하단 정렬로는 descent 차이로 어긋남) -->
                     <TextBlock x:Name="SessionHeaderTitle"
                                VerticalAlignment="Center"
                                FontSize="{DynamicResource Fs13}"
                                Foreground="{DynamicResource TextBrush}"
                                TextOptions.TextFormattingMode="Ideal"
                                TextOptions.TextRenderingMode="ClearType"
                                TextTrimming="CharacterEllipsis">
                         <Run x:Name="SessionHeaderTitleRun" FontWeight="SemiBold"/>
                         <InlineUIContainer BaselineAlignment="Center">
                             <Ellipse x:Name="FileDirtyDot" Width="7" Height="7" Margin="8,0,0,0"
                                      Visibility="Collapsed"
                                      Fill="{DynamicResource PrimaryBrush}"/>
                         </InlineUIContainer>
                         <Run x:Name="FileHeaderPathRun" BaselineAlignment="Baseline"
                              FontSize="{DynamicResource Fs11}" FontWeight="Normal"
                              Foreground="{DynamicResource TextMutedBrush}"/>
                     </TextBlock>
                </StackPanel>
                <StackPanel x:Name="FileHeaderActions" Grid.Column="1" Orientation="Horizontal"
                            VerticalAlignment="Center" Visibility="Collapsed">
                    <TextBlock x:Name="FileSizeText" VerticalAlignment="Center"
                               FontSize="{DynamicResource Fs13}" FontWeight="Normal"
                               Foreground="{DynamicResource TextMutedBrush}"
                               Margin="0,0,12,0"/>
                    <Button x:Name="FileSaveBtn" Style="{StaticResource TabNavButton}"
                            Click="FileSaveBtn_Click" ToolTip="저장 (Ctrl+S)">
                        <Path Style="{StaticResource LucideIcon}" Data="{StaticResource IconSave}"
                              Width="14" Height="14" Stretch="Uniform" StrokeThickness="1.8"
                              Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"/>
                    </Button>
                </StackPanel>
            </Grid>
        </Border>

        <!-- 콘텐츠: 활성 탭에 따라 터미널(공유) 또는 파일 에디터(탭당 1개) 표시.
             ClipToBounds: 분할 애니메이션 중 좌상단 고정된 스냅샷이 패널 밖으로 넘치지 않게 잘라낸다. -->
        <Grid Grid.Row="3" ClipToBounds="True">
            <ContentControl x:Name="TerminalHostContainer"/>
            <ContentControl x:Name="FileEditorHostContainer" Visibility="Collapsed"/>
            <ContentControl x:Name="BrowserHostContainer" Visibility="Collapsed"/>
            <Image x:Name="TerminalSnapshot" Stretch="Fill" Visibility="Collapsed"
                   RenderOptions.BitmapScalingMode="HighQuality"/>
            <Border x:Name="TerminalCurtain" Background="{DynamicResource BgBrush}"
                    Visibility="Collapsed"/>
            <Grid x:Name="EmptyState" VerticalAlignment="Center" HorizontalAlignment="Stretch"
                  Visibility="Visible">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>
                <Path Grid.Row="0" Style="{StaticResource LucideIcon}" Data="{StaticResource IconTerminal}"
                      Width="40" Height="40" Stroke="{DynamicResource TextMutedBrush}"
                      HorizontalAlignment="Center" Opacity="0.5"/>
                <TextBlock x:Name="EmptyStateText" Grid.Row="1" Text="프로젝트를 추가하고 세션을 실행하세요."
                           Margin="0,16,0,0" FontSize="{DynamicResource Fs13}"
                           Foreground="{DynamicResource TextMutedBrush}" TextAlignment="Center"
                           TextWrapping="Wrap"/>
            </Grid>

            <Grid x:Name="TerminalLoadingOverlay" Visibility="Collapsed"
                  Background="{DynamicResource BgBrush}">
                <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                    <Ellipse x:Name="TermSpinner" Width="36" Height="36" StrokeThickness="3"
                             Fill="Transparent"
                             Stroke="{DynamicResource PrimaryBrush}"
                             StrokeDashArray="28 10"
                             HorizontalAlignment="Center"
                             models:SpinnerActivator.Track="True"
                             RenderTransformOrigin="0.5,0.5">
                        <Ellipse.RenderTransform>
                            <RotateTransform Angle="{Binding Angle, Source={x:Static models:SpinnerSync.Instance}}"/>
                        </Ellipse.RenderTransform>
                    </Ellipse>
                    <TextBlock Text="세션 여는 중…" Margin="0,14,0,0"
                               FontSize="{DynamicResource Fs13}" TextAlignment="Center"
                               Foreground="{DynamicResource TextMutedBrush}"/>
                </StackPanel>
            </Grid>
        </Grid>
      </Grid>
      </Border>
    </Border>
</UserControl>
