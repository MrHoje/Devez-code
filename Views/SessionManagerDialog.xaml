<Window x:Class="DevezCode.Views.SessionManagerDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:models="clr-namespace:DevezCode.Models"
        Title="세션 관리" Height="520" Width="460"
        WindowStartupLocation="CenterOwner" ResizeMode="NoResize"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        ShowInTaskbar="False"
        UseLayoutRounding="True"
        SnapsToDevicePixels="True"
        TextOptions.TextFormattingMode="Display"
        TextOptions.TextRenderingMode="ClearType"
        TextOptions.TextHintingMode="Fixed"
        RenderOptions.ClearTypeHint="Enabled"
        FontFamily="{StaticResource PretendardFont}">

    <Window.Resources>
        <!-- 세션 상태 점: 사이드바 SessionDot 동일(살아있으면 primary, 죽으면 회색) -->
        <Style x:Key="RowDot" TargetType="Ellipse">
            <Setter Property="Width" Value="8"/>
            <Setter Property="Height" Value="8"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="Fill" Value="#6B7280"/>
            <Style.Triggers>
                <DataTrigger Binding="{Binding Session.IsAlive}" Value="True">
                    <Setter Property="Fill" Value="{DynamicResource PrimaryBrush}"/>
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <!-- 삭제(위험) 버튼: SecondaryButton 외형에 Danger 텍스트/아이콘 색만 얹음 -->
        <Style x:Key="DangerFooterButton" TargetType="Button" BasedOn="{StaticResource SecondaryButton}">
            <Setter Property="Foreground" Value="{DynamicResource DangerBrush}"/>
        </Style>

        <!-- 세션 행 -->
        <DataTemplate x:Key="SessionRowTemplate" DataType="{x:Type models:SessionManagerRow}">
            <Border x:Name="RowRoot" CornerRadius="8" Background="Transparent"
                    Padding="8,0" Margin="0,1" MinHeight="38"
                    MouseLeftButtonUp="Row_Click">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <!-- 선택 체크박스: 잠금 세션은 체크박스 대신 자물쇠를 같은 자리에 보여준다 -->
                    <Grid Grid.Column="0" Width="16" Height="16" Margin="0,0,10,0" VerticalAlignment="Center">
                        <CheckBox x:Name="RowCheck" Width="16" Height="16" Tag="16"
                                  Style="{StaticResource ModernCheckBox}"
                                  IsChecked="{Binding IsChecked, Mode=TwoWay}"/>
                        <Path x:Name="LockIcon" Visibility="Collapsed"
                              Style="{StaticResource LucideIcon}" Data="{StaticResource IconLock}"
                              Width="14" Height="14"
                              HorizontalAlignment="Center" VerticalAlignment="Center"
                              Stroke="{DynamicResource TextMutedBrush}"/>
                    </Grid>

                    <!-- 에이전트 아이콘 -->
                    <Image Grid.Column="1" Width="15" Height="15" Margin="0,0,9,0"
                           VerticalAlignment="Center"
                           Source="{Binding Session.AgentId, Converter={x:Static models:AgentImageConverter.Instance}}"
                           RenderOptions.BitmapScalingMode="HighQuality"/>

                    <!-- 상태 점 ↔ 회전 스피너 ↔ 숨김 아이콘 -->
                    <Grid Grid.Column="2" Width="12" Height="12" Margin="0,0,10,0" VerticalAlignment="Center">
                        <Ellipse x:Name="Dot" Style="{StaticResource RowDot}"/>
                        <Ellipse x:Name="Spinner" Width="12" Height="12" Visibility="Collapsed"
                                 models:SpinnerActivator.Track="True"
                                 Stroke="{DynamicResource PrimaryBrush}" StrokeThickness="1.6"
                                 StrokeDashArray="15 100" StrokeDashCap="Round"
                                 RenderTransformOrigin="0.5,0.5">
                            <Ellipse.RenderTransform>
                                <RotateTransform Angle="{Binding Angle, Source={x:Static models:SpinnerSync.Instance}}"/>
                            </Ellipse.RenderTransform>
                        </Ellipse>
                        <Path x:Name="HiddenIcon" Visibility="Collapsed"
                              Data="{StaticResource IconEyeOff}"
                              Width="12" Height="12" Stretch="Uniform"
                              Stroke="{DynamicResource TextMutedBrush}" StrokeThickness="1.4"
                              Fill="Transparent" SnapsToDevicePixels="True"/>
                    </Grid>

                    <!-- 세션명 -->
                    <TextBlock x:Name="NameText" Grid.Column="3" Text="{Binding Session.Name}"
                               VerticalAlignment="Center" TextTrimming="CharacterEllipsis"
                               FontSize="{DynamicResource Fs13}"
                               Foreground="{DynamicResource TextBrush}"/>
                </Grid>
            </Border>

            <DataTemplate.Triggers>
                <Trigger SourceName="RowRoot" Property="IsMouseOver" Value="True">
                    <Setter TargetName="RowRoot" Property="Background" Value="{DynamicResource ProjectCardHoverBrush}"/>
                </Trigger>
                <!-- 요청 처리중: 스피너 -->
                <DataTrigger Binding="{Binding Session.IsBusy}" Value="True">
                    <Setter TargetName="Dot" Property="Visibility" Value="Collapsed"/>
                    <Setter TargetName="Spinner" Property="Visibility" Value="Visible"/>
                </DataTrigger>
                <!-- 숨김 세션: 점 대신 숨김 아이콘(+ 배지). busy 보다 뒤에 둬 우선. -->
                <DataTrigger Binding="{Binding Session.Hidden}" Value="True">
                    <Setter TargetName="Dot" Property="Visibility" Value="Collapsed"/>
                    <Setter TargetName="Spinner" Property="Visibility" Value="Collapsed"/>
                    <Setter TargetName="HiddenIcon" Property="Visibility" Value="Visible"/>
                    <Setter TargetName="NameText" Property="Foreground" Value="{DynamicResource TextMutedBrush}"/>
                </DataTrigger>
                <!-- 잠금 세션: 체크박스 대신 자물쇠 + 이름 흐리게 -->
                <DataTrigger Binding="{Binding Session.IsLocked}" Value="True">
                    <Setter TargetName="RowCheck" Property="Visibility" Value="Collapsed"/>
                    <Setter TargetName="LockIcon" Property="Visibility" Value="Visible"/>
                    <Setter TargetName="RowRoot" Property="Opacity" Value="0.7"/>
                </DataTrigger>
            </DataTemplate.Triggers>
        </DataTemplate>
    </Window.Resources>

    <Grid Margin="20">
        <!-- Shadow layer -->
        <Border Background="{DynamicResource BgBrush}" CornerRadius="14">
            <Border.Effect>
                <DropShadowEffect ShadowDepth="0" BlurRadius="40" Color="{DynamicResource ShadowColor}" Opacity="{DynamicResource ShadowOpacity}"/>
            </Border.Effect>
        </Border>
        <!-- Content layer -->
        <Border CornerRadius="14"
                Background="{DynamicResource BgBrush}"
                BorderBrush="{DynamicResource LineBrush}" BorderThickness="1"
                ClipToBounds="True">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="48"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <!-- Header -->
                <Border Grid.Row="0"
                        BorderBrush="{DynamicResource LineBrush}"
                        BorderThickness="0,0,0,1"
                        Background="Transparent"
                        MouseLeftButtonDown="Header_DragMove">
                    <Grid>
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="20,0,0,0">
                            <TextBlock Text="세션 관리" VerticalAlignment="Center"
                                       FontSize="{DynamicResource Fs14}" FontWeight="SemiBold"
                                       Foreground="{DynamicResource TextBrush}"/>
                            <TextBlock x:Name="ProjectNameText" VerticalAlignment="Center" Margin="8,1,0,0"
                                       FontSize="{DynamicResource Fs12}"
                                       Foreground="{DynamicResource TextMutedBrush}"
                                       TextTrimming="CharacterEllipsis" MaxWidth="240"/>
                        </StackPanel>
                        <Button Click="CloseBtn_Click"
                                HorizontalAlignment="Right" VerticalAlignment="Center"
                                Width="40" Height="32" Margin="0,0,8,0"
                                Style="{StaticResource WinCloseBtn}">
                            <TextBlock Text="&#x2715;" FontSize="{DynamicResource Fs11}"/>
                        </Button>
                    </Grid>
                </Border>

                <!-- Toolbar: 전체 선택 + 선택 카운트 -->
                <Border Grid.Row="1" Padding="20,10,20,10"
                        BorderBrush="{DynamicResource LineBrush}" BorderThickness="0,0,0,1">
                    <Grid>
                        <CheckBox x:Name="SelectAllBox" Tag="16"
                                  VerticalAlignment="Center"
                                  Style="{StaticResource ModernCheckBox}"
                                  Content="전체 선택"
                                  FontSize="{DynamicResource Fs13}"
                                  Foreground="{DynamicResource TextBrush}"
                                  Click="SelectAll_Click"/>
                        <TextBlock x:Name="CountText" HorizontalAlignment="Right" VerticalAlignment="Center"
                                   FontSize="{DynamicResource Fs12}"
                                   Foreground="{DynamicResource TextMutedBrush}"/>
                    </Grid>
                </Border>

                <!-- Body: 세션 목록 -->
                <Grid Grid.Row="2">
                    <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="12,8,12,8">
                        <ItemsControl x:Name="SessionList"
                                      ItemTemplate="{StaticResource SessionRowTemplate}"/>
                    </ScrollViewer>
                    <TextBlock x:Name="EmptyText" Text="세션이 없습니다."
                               Visibility="Collapsed"
                               HorizontalAlignment="Center" VerticalAlignment="Center"
                               FontSize="{DynamicResource Fs13}"
                               Foreground="{DynamicResource TextMutedBrush}"/>
                </Grid>

                <!-- Footer: 일괄 액션 -->
                <Border Grid.Row="3"
                        Background="{DynamicResource PanelSoftBrush}"
                        BorderBrush="{DynamicResource LineBrush}"
                        BorderThickness="0,1,0,0"
                        CornerRadius="0,0,14,14">
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="20,14,20,14">
                        <Button x:Name="HideBtn" Click="HideBtn_Click"
                                MinWidth="88" Height="38" Padding="14,0"
                                Style="{StaticResource SecondaryButton}"
                                FontSize="{DynamicResource Fs13}" Margin="0,0,8,0">
                            <StackPanel Orientation="Horizontal">
                                <Path Style="{StaticResource LucideIcon}" Data="{StaticResource IconEyeOff}"
                                      Width="14" Height="14" Margin="0,0,7,0" VerticalAlignment="Center"
                                      Stroke="{DynamicResource TextBrush}"/>
                                <TextBlock Text="숨기기" TextTrimming="None"/>
                            </StackPanel>
                        </Button>
                        <Button x:Name="CloseSessionsBtn" Click="CloseSessionsBtn_Click"
                                MinWidth="88" Height="38" Padding="14,0"
                                Style="{StaticResource SecondaryButton}"
                                FontSize="{DynamicResource Fs13}" Margin="0,0,8,0">
                            <StackPanel Orientation="Horizontal">
                                <Path Style="{StaticResource LucideIcon}" Data="{StaticResource IconX}"
                                      Width="14" Height="14" Margin="0,0,7,0" VerticalAlignment="Center"
                                      Stroke="{DynamicResource TextBrush}"/>
                                <TextBlock Text="닫기" TextTrimming="None"/>
                            </StackPanel>
                        </Button>
                        <Button x:Name="DeleteBtn" Click="DeleteBtn_Click"
                                MinWidth="88" Height="38" Padding="14,0"
                                Style="{StaticResource DangerFooterButton}"
                                FontSize="{DynamicResource Fs13}">
                            <StackPanel Orientation="Horizontal">
                                <Path Style="{StaticResource LucideIcon}" Data="{StaticResource IconTrash2}"
                                      Width="14" Height="14" Margin="0,0,7,0" VerticalAlignment="Center"
                                      Stroke="{DynamicResource DangerBrush}"/>
                                <TextBlock Text="삭제" TextTrimming="None"/>
                            </StackPanel>
                        </Button>
                    </StackPanel>
                </Border>
            </Grid>
        </Border>
    </Grid>
</Window>
