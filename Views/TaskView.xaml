<UserControl x:Class="DevezCode.Views.TaskView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:models="clr-namespace:DevezCode.Models"
             Background="{DynamicResource PanelBrush}"
             FontFamily="{StaticResource PretendardFont}">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- 진행 중 헤더 -->
        <Border Grid.Row="0" BorderBrush="{DynamicResource LineBrush}" BorderThickness="0,0,0,1">
            <Grid Margin="14,8,8,8">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <TextBlock Text="진행 중" FontSize="{DynamicResource Fs11}" FontWeight="SemiBold"
                           Foreground="{DynamicResource TextMutedBrush}"/>
                <TextBlock Grid.Column="1" Text="{Binding InProgressTasks.Count, RelativeSource={RelativeSource AncestorType=UserControl}}"
                           FontSize="{DynamicResource Fs11}"
                           Foreground="{DynamicResource TextMutedBrush}" Margin="4,0,0,0"/>
                <Border Grid.Column="2" x:Name="ProgressBar" Height="4" Width="80" CornerRadius="2"
                        Background="{DynamicResource LineBrush}" VerticalAlignment="Center">
                    <Border x:Name="ProgressFill" Width="0" HorizontalAlignment="Left" CornerRadius="2"
                            Background="{DynamicResource PrimaryBrush}"/>
                </Border>
            </Grid>
        </Border>

        <!-- 진행 중 아이템 -->
        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" MaxHeight="200"
                      Padding="4,4,4,0" Background="Transparent">
            <ItemsControl ItemsSource="{Binding InProgressTasks, RelativeSource={RelativeSource AncestorType=UserControl}}">
                <ItemsControl.ItemTemplate>
                    <DataTemplate DataType="{x:Type models:TaskItem}">
                        <Border CornerRadius="6" Background="{DynamicResource PanelSoftBrush}"
                                Padding="8,6" Margin="2,3">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                </Grid.RowDefinitions>
                                <Grid Grid.Row="0">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <Border CornerRadius="4" Background="{DynamicResource PrimaryBrush}"
                                            Padding="4,1" VerticalAlignment="Center">
                                        <TextBlock Text="{Binding Priority}"
                                                   FontSize="{DynamicResource Fs10}"
                                                   Foreground="White" FontWeight="SemiBold"/>
                                    </Border>
                                    <TextBlock Grid.Column="1" Text="{Binding Description}"
                                               Margin="6,0,0,0" FontSize="{DynamicResource Fs12}"
                                               Foreground="{DynamicResource TextBrush}"
                                               TextTrimming="CharacterEllipsis" VerticalAlignment="Center"/>
                                </Grid>
                                <TextBlock Grid.Row="1" Text="{Binding Source}"
                                           Margin="0,2,0,0" FontSize="{DynamicResource Fs10}"
                                           Foreground="{DynamicResource TextMutedBrush}"
                                           TextTrimming="CharacterEllipsis"/>
                            </Grid>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </ScrollViewer>

        <!-- 대기 헤더 -->
        <Border Grid.Row="2" BorderBrush="{DynamicResource LineBrush}" BorderThickness="0,0,0,1">
            <Grid Margin="14,8,8,8">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <TextBlock Text="대기" FontSize="{DynamicResource Fs11}" FontWeight="SemiBold"
                           Foreground="{DynamicResource TextMutedBrush}"/>
                <TextBlock Grid.Column="1"
                           Text="{Binding PendingTasks.Count, RelativeSource={RelativeSource AncestorType=UserControl}}"
                           FontSize="{DynamicResource Fs11}"
                           Foreground="{DynamicResource TextMutedBrush}" Margin="4,0,0,0"/>
            </Grid>
        </Border>

        <!-- 대기 아이템 -->
        <ScrollViewer Grid.Row="3" VerticalScrollBarVisibility="Auto" Padding="4,4,4,0" Background="Transparent">
            <ItemsControl ItemsSource="{Binding PendingTasks, RelativeSource={RelativeSource AncestorType=UserControl}}">
                <ItemsControl.ItemTemplate>
                    <DataTemplate DataType="{x:Type models:TaskItem}">
                        <Border CornerRadius="6" Background="{DynamicResource PanelSoftBrush}"
                                Padding="8,6" Margin="2,3" Opacity="0.7">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                </Grid.RowDefinitions>
                                <Grid Grid.Row="0">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <Border CornerRadius="4" Background="{DynamicResource TextMutedBrush}"
                                            Padding="4,1" VerticalAlignment="Center">
                                        <TextBlock Text="{Binding Priority}"
                                                   FontSize="{DynamicResource Fs10}"
                                                   Foreground="White" FontWeight="SemiBold"/>
                                    </Border>
                                    <TextBlock Grid.Column="1" Text="{Binding Description}"
                                               Margin="6,0,0,0" FontSize="{DynamicResource Fs12}"
                                               Foreground="{DynamicResource TextBrush}"
                                               TextTrimming="CharacterEllipsis" VerticalAlignment="Center"/>
                                </Grid>
                                <TextBlock Grid.Row="1" Text="{Binding Source}"
                                           Margin="0,2,0,0" FontSize="{DynamicResource Fs10}"
                                           Foreground="{DynamicResource TextMutedBrush}"
                                           TextTrimming="CharacterEllipsis"/>
                            </Grid>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </ScrollViewer>

        <!-- 완료 헤더 + 아이템 (ScrollViewer 내부) -->
        <Grid Grid.Row="4">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>
            <Border Grid.Row="0" BorderBrush="{DynamicResource LineBrush}" BorderThickness="0,0,0,1">
                <Grid Margin="14,8,8,8">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="완료" FontSize="{DynamicResource Fs11}" FontWeight="SemiBold"
                               Foreground="{DynamicResource TextMutedBrush}"/>
                    <TextBlock Grid.Column="1"
                               Text="{Binding CompletedTasks.Count, RelativeSource={RelativeSource AncestorType=UserControl}}"
                               FontSize="{DynamicResource Fs11}"
                               Foreground="{DynamicResource TextMutedBrush}" Margin="4,0,0,0"/>
                </Grid>
            </Border>
            <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" Padding="4,4,4,8" Background="Transparent">
                <ItemsControl ItemsSource="{Binding CompletedTasks, RelativeSource={RelativeSource AncestorType=UserControl}}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate DataType="{x:Type models:TaskItem}">
                            <Border CornerRadius="6" Background="{DynamicResource PanelSoftBrush}"
                                    Padding="8,6" Margin="2,3" Opacity="0.5">
                                <Grid>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                    </Grid.RowDefinitions>
                                    <Grid Grid.Row="0">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Text="{Binding StatusDisplay}"
                                                   FontSize="{DynamicResource Fs10}"
                                                   Foreground="{DynamicResource PrimaryBrush}" FontWeight="SemiBold"
                                                   VerticalAlignment="Center"/>
                                        <TextBlock Grid.Column="1" Text="{Binding Description}"
                                                   Margin="6,0,0,0" FontSize="{DynamicResource Fs12}"
                                                   Foreground="{DynamicResource TextBrush}"
                                                   TextTrimming="CharacterEllipsis" VerticalAlignment="Center"
                                                   TextDecorations="Strikethrough"/>
                                    </Grid>
                                    <TextBlock Grid.Row="1" Text="{Binding Source}"
                                               Margin="0,2,0,0" FontSize="{DynamicResource Fs10}"
                                               Foreground="{DynamicResource TextMutedBrush}"
                                               TextTrimming="CharacterEllipsis"/>
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </ScrollViewer>
        </Grid>

        <!-- empty state -->
        <TextBlock x:Name="EmptyText" Grid.Row="1" Grid.RowSpan="4"
                   Text="태스크 없음"
                   FontSize="{DynamicResource Fs12}"
                   Foreground="{DynamicResource TextMutedBrush}"
                   HorizontalAlignment="Center" VerticalAlignment="Center"
                   Visibility="Collapsed"/>
    </Grid>
</UserControl>
