<Window x:Class="DevezCode.Views.CommunityWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:models="clr-namespace:DevezCode.Models"
        Title="커뮤니티" Width="1200" Height="800"
        WindowStartupLocation="CenterOwner" WindowStyle="None" ResizeMode="NoResize"
        AllowsTransparency="True" Background="Transparent" ShowInTaskbar="False"
        FontFamily="{StaticResource PretendardFont}"
        UseLayoutRounding="True" SnapsToDevicePixels="True"
        TextOptions.TextFormattingMode="Display" TextOptions.TextRenderingMode="ClearType"
        PreviewKeyDown="Window_PreviewKeyDown">
    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVisibility"/>

        <Style x:Key="CommunitySearchBox" TargetType="TextBox"
               BasedOn="{StaticResource InputStyle}">
            <Setter Property="FontSize" Value="{DynamicResource Fs13}"/>
        </Style>

        <Style x:Key="CommunityListItem" TargetType="ListBoxItem"
               BasedOn="{StaticResource {x:Type ListBoxItem}}">
            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
            <Setter Property="Padding" Value="0"/>
            <Setter Property="Margin" Value="8,0,8,6"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ListBoxItem">
                        <Border x:Name="ItemBorder" Background="Transparent"
                                BorderBrush="Transparent" BorderThickness="1"
                                CornerRadius="9" Padding="12,11">
                            <ContentPresenter/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="ItemBorder" Property="Background"
                                        Value="{DynamicResource PanelSoftBrush}"/>
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="ItemBorder" Property="Background"
                                        Value="{DynamicResource PrimarySoftBrush}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="CommunityMetaText" TargetType="TextBlock"
               BasedOn="{StaticResource {x:Type TextBlock}}">
            <Setter Property="FontSize" Value="{DynamicResource Fs11}"/>
            <Setter Property="Foreground" Value="{DynamicResource TextMutedBrush}"/>
        </Style>
    </Window.Resources>

    <Grid Margin="{DynamicResource WindowShadowOuterMargin}">
        <Border Background="{DynamicResource BgBrush}"
                CornerRadius="{DynamicResource WindowShadowCornerRadius}"
                Margin="{DynamicResource WindowShadowInnerMargin}"
                SnapsToDevicePixels="True">
            <Border.Effect>
                <DropShadowEffect ShadowDepth="0" BlurRadius="{DynamicResource WindowShadowBlurRadius}"
                                  Direction="270"
                                  Color="{DynamicResource ShadowColor}"
                                  Opacity="{DynamicResource ShadowOpacity}"/>
            </Border.Effect>
        </Border>

        <Border Background="{DynamicResource BgBrush}"
                BorderBrush="{DynamicResource LineBrush}" BorderThickness="1"
                CornerRadius="14" ClipToBounds="True">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="48"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <Border Grid.Row="0" BorderBrush="{DynamicResource LineBrush}"
                        BorderThickness="0,0,0,1" Background="{DynamicResource PanelBrush}"
                        MouseLeftButtonDown="Header_DragMove">
                    <Grid Margin="16,0,8,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <Path Style="{StaticResource LucideIcon}"
                                  Data="{StaticResource IconMessageSquare}"
                                  Width="16" Height="16" Stroke="{DynamicResource TextBrush}"
                                  Margin="0,0,11,0"/>
                            <TextBlock Text="커뮤니티" FontSize="{DynamicResource Fs14}"
                                       FontWeight="SemiBold" Foreground="{DynamicResource TextBrush}"
                                       VerticalAlignment="Center"/>
                            <Border Width="1" Height="12" Margin="12,0"
                                    Background="{DynamicResource LineBrush}"/>
                            <TextBlock Text="개선 요청 · 오류 제보"
                                       FontSize="{DynamicResource Fs11}"
                                       Foreground="{DynamicResource TextMutedBrush}"
                                       VerticalAlignment="Center"/>
                        </StackPanel>

                        <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                            <Button x:Name="NewPostBtn" Click="NewPostBtn_Click"
                                    Height="32" MinWidth="88" Padding="14,0" Margin="0,0,6,0"
                                    Style="{StaticResource PrimaryButton}" FontSize="{DynamicResource Fs12}">
                                <StackPanel Orientation="Horizontal">
                                    <Path Style="{StaticResource LucideButtonIcon}"
                                          Data="{StaticResource IconPlus}" Width="12" Height="12"
                                          Stroke="White" Margin="0,0,6,0"/>
                                    <TextBlock Text="글쓰기" Foreground="White"/>
                                </StackPanel>
                            </Button>
                            <Button Click="RefreshBtn_Click" Width="32" Height="32" Margin="0,0,2,0"
                                    Style="{StaticResource IconButton}" ToolTip="새로고침">
                                <Path Style="{StaticResource LucideButtonIcon}"
                                      Data="{StaticResource IconRotateCcw}" Width="13" Height="13"/>
                            </Button>
                            <Button Click="CloseBtn_Click" Width="40" Height="32"
                                    Style="{StaticResource WinCloseBtn}" ToolTip="닫기">
                                <TextBlock Text="&#x2715;" FontSize="{DynamicResource Fs11}"/>
                            </Button>
                        </StackPanel>
                    </Grid>
                </Border>

                <Grid Grid.Row="1">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="420"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <Border Grid.Column="0" BorderBrush="{DynamicResource LineBrush}"
                            BorderThickness="0,0,1,0" Background="{DynamicResource PanelBrush}">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="53"/>
                                <RowDefinition Height="*"/>
                                <RowDefinition Height="34"/>
                            </Grid.RowDefinitions>

                            <Grid Grid.Row="0" Margin="8,8,8,10">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="108"/>
                                    <ColumnDefinition Width="8"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <ComboBox x:Name="CategoryFilter" Grid.Column="0"
                                          Style="{StaticResource DockComboBox}" Height="35"
                                          DisplayMemberPath="Label" SelectedValuePath="Value"
                                          SelectionChanged="CategoryFilter_SelectionChanged"/>
                                <Border Grid.Column="2" Height="35" CornerRadius="8"
                                        BorderBrush="{DynamicResource LineBrush}" BorderThickness="1"
                                        Background="{DynamicResource PanelSoftBrush}">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="32"/>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="28"/>
                                        </Grid.ColumnDefinitions>
                                        <Path Grid.Column="0" Style="{StaticResource LucideIcon}"
                                              Data="{StaticResource IconSearch}"
                                              Stroke="{DynamicResource TextMutedBrush}"
                                              Width="13" Height="13" Margin="10,0,0,0"
                                              VerticalAlignment="Center"/>
                                        <Grid Grid.Column="1">
                                            <TextBox x:Name="SearchBox"
                                                     Style="{StaticResource CommunitySearchBox}"
                                                     Margin="4,0,0,0" MaxLength="100"
                                                     ToolTip="제목 또는 공개글 내용 검색"
                                                     KeyDown="SearchBox_KeyDown"/>
                                            <TextBlock Text="게시글 검색 (Enter)"
                                                       IsHitTestVisible="False"
                                                       Margin="4,0,0,0" VerticalAlignment="Center"
                                                       Foreground="{DynamicResource TextMutedBrush}"
                                                       FontSize="{DynamicResource Fs12}">
                                                <TextBlock.Style>
                                                    <Style TargetType="TextBlock"
                                                           BasedOn="{StaticResource {x:Type TextBlock}}">
                                                        <Setter Property="Visibility" Value="Collapsed"/>
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding Text, ElementName=SearchBox}" Value="">
                                                                <Setter Property="Visibility" Value="Visible"/>
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </TextBlock.Style>
                                            </TextBlock>
                                        </Grid>
                                        <Button Grid.Column="2" Click="SearchClearBtn_Click"
                                                Width="20" Height="20" Margin="0,0,7,0"
                                                ToolTip="검색 지우기">
                                            <Button.Style>
                                                <Style TargetType="Button" BasedOn="{StaticResource IconButton}">
                                                    <Setter Property="Visibility" Value="Visible"/>
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding Text, ElementName=SearchBox}" Value="">
                                                            <Setter Property="Visibility" Value="Collapsed"/>
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </Button.Style>
                                            <Path Style="{StaticResource LucideButtonIcon}"
                                                  Data="{StaticResource IconX}" Width="11" Height="11"/>
                                        </Button>
                                    </Grid>
                                </Border>
                            </Grid>

                            <ListBox x:Name="PostList" Grid.Row="1"
                                     Background="Transparent" BorderThickness="0"
                                     ItemContainerStyle="{StaticResource CommunityListItem}"
                                     SelectionChanged="PostList_SelectionChanged"
                                     ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                                <ListBox.ItemTemplate>
                                    <DataTemplate>
                                        <Grid>
                                            <Grid.RowDefinitions>
                                                <RowDefinition Height="Auto"/>
                                                <RowDefinition Height="Auto"/>
                                                <RowDefinition Height="Auto"/>
                                            </Grid.RowDefinitions>
                                            <Grid Grid.Row="0">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="Auto"/>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="Auto"/>
                                                </Grid.ColumnDefinitions>
                                                <Border Background="{DynamicResource PrimarySoftBrush}"
                                                        CornerRadius="5" Padding="7,3" Margin="0,0,8,0">
                                                    <TextBlock Text="{Binding CategoryLabel}"
                                                               FontSize="{DynamicResource Fs10}"
                                                               Foreground="{DynamicResource PrimaryBrush}"/>
                                                </Border>
                                                <TextBlock Grid.Column="2" Text="{Binding DateLabel}"
                                                           Style="{StaticResource CommunityMetaText}"
                                                           VerticalAlignment="Center"/>
                                            </Grid>
                                            <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="1,8,0,0">
                                                <Path Style="{StaticResource LucideIcon}"
                                                      Data="{StaticResource IconLock}" Width="12" Height="12"
                                                      Stroke="{DynamicResource TextMutedBrush}" Margin="0,0,6,0"
                                                      Visibility="{Binding IsPrivate, Converter={StaticResource BoolToVisibility}}"/>
                                                <TextBlock Text="{Binding Title}" FontSize="{DynamicResource Fs13}"
                                                           FontWeight="SemiBold" Foreground="{DynamicResource TextBrush}"
                                                           TextTrimming="CharacterEllipsis"/>
                                            </StackPanel>
                                            <Grid Grid.Row="2" Margin="1,6,0,0">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="Auto"/>
                                                </Grid.ColumnDefinitions>
                                                <TextBlock Text="{Binding PreviewLabel}"
                                                           Style="{StaticResource CommunityMetaText}"
                                                           TextTrimming="CharacterEllipsis"/>
                                                <TextBlock Grid.Column="1" Text="{Binding AuthorName}"
                                                           Style="{StaticResource CommunityMetaText}"
                                                           Margin="12,0,0,0"/>
                                            </Grid>
                                        </Grid>
                                    </DataTemplate>
                                </ListBox.ItemTemplate>
                            </ListBox>

                            <StackPanel x:Name="EmptyListText" Grid.Row="1"
                                        HorizontalAlignment="Center" VerticalAlignment="Center"
                                        Visibility="Collapsed">
                                <Path Style="{StaticResource LucideIcon}"
                                      Data="{StaticResource IconMessageCirclePlus}"
                                      Width="28" Height="28" Stroke="{DynamicResource TextMutedBrush}"
                                      Opacity="0.55" HorizontalAlignment="Center"/>
                                <TextBlock Text="아직 게시글이 없습니다."
                                           Margin="0,12,0,3" HorizontalAlignment="Center"
                                           Foreground="{DynamicResource TextBrush}"
                                           FontSize="{DynamicResource Fs13}" FontWeight="SemiBold"/>
                                <TextBlock Text="첫 개선 요청이나 오류 제보를 남겨보세요."
                                           HorizontalAlignment="Center"
                                           Foreground="{DynamicResource TextMutedBrush}"
                                           FontSize="{DynamicResource Fs11}"/>
                            </StackPanel>

                            <Border Grid.Row="2" BorderBrush="{DynamicResource LineBrush}"
                                    BorderThickness="0,1,0,0">
                                <TextBlock x:Name="ListStatusText" Margin="12,0"
                                           VerticalAlignment="Center"
                                           FontSize="{DynamicResource Fs10}"
                                           Foreground="{DynamicResource TextMutedBrush}"/>
                            </Border>
                        </Grid>
                    </Border>

                    <Grid Grid.Column="1" Background="{DynamicResource BgBrush}">
                        <Grid x:Name="EmptyDetailPane">
                            <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                                <Path Style="{StaticResource LucideIcon}"
                                      Data="{StaticResource IconMessageSquare}" Width="34" Height="34"
                                      Stroke="{DynamicResource TextMutedBrush}" Opacity="0.55"
                                      HorizontalAlignment="Center"/>
                                <TextBlock Text="게시글을 선택하세요." Margin="0,14,0,0"
                                           FontSize="{DynamicResource Fs13}"
                                           Foreground="{DynamicResource TextMutedBrush}"/>
                            </StackPanel>
                        </Grid>

                        <Grid x:Name="LockedDetailPane" Visibility="Collapsed">
                            <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Width="310">
                                <Border Width="58" Height="58" CornerRadius="29"
                                        Background="{DynamicResource PrimarySoftBrush}">
                                    <Path Style="{StaticResource LucideIcon}"
                                          Data="{StaticResource IconLock}" Width="23" Height="23"
                                          Stroke="{DynamicResource PrimaryBrush}"
                                          HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Border>
                                <TextBlock x:Name="LockedTitleText" Margin="0,16,0,0"
                                           FontSize="{DynamicResource Fs16}" FontWeight="SemiBold"
                                           Foreground="{DynamicResource TextBrush}"
                                           TextAlignment="Center" TextWrapping="Wrap"/>
                                <TextBlock Text="비공개 글입니다. 작성 시 설정한 비밀번호를 입력하세요."
                                           Margin="0,8,0,16" TextAlignment="Center" TextWrapping="Wrap"
                                           FontSize="{DynamicResource Fs12}"
                                           Foreground="{DynamicResource TextMutedBrush}"/>
                                <Button Click="UnlockBtn_Click" Height="38" MinWidth="118" Padding="16,0"
                                        HorizontalAlignment="Center"
                                        Style="{StaticResource PrimaryButton}" FontSize="{DynamicResource Fs12}">
                                    <StackPanel Orientation="Horizontal">
                                        <Path Style="{StaticResource LucideButtonIcon}"
                                              Data="{StaticResource IconLockOpen}" Width="12" Height="12"
                                              Stroke="White" Margin="0,0,6,0"/>
                                        <TextBlock Text="비밀번호 입력" Foreground="White"/>
                                    </StackPanel>
                                </Button>
                            </StackPanel>
                        </Grid>

                        <Grid x:Name="DetailPane" Visibility="Collapsed">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*"/>
                            </Grid.RowDefinitions>
                            <Border Grid.Row="0" BorderBrush="{DynamicResource LineBrush}"
                                    BorderThickness="0,0,0,1" Padding="24,20,20,17">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <StackPanel>
                                        <StackPanel Orientation="Horizontal">
                                            <Border Background="{DynamicResource PrimarySoftBrush}"
                                                    CornerRadius="5" Padding="7,3" Margin="0,0,8,0">
                                                <TextBlock x:Name="DetailCategoryText"
                                                           FontSize="{DynamicResource Fs10}"
                                                           Foreground="{DynamicResource PrimaryBrush}"/>
                                            </Border>
                                            <Path x:Name="DetailLockIcon" Style="{StaticResource LucideIcon}"
                                                  Data="{StaticResource IconLock}" Width="12" Height="12"
                                                  Stroke="{DynamicResource TextMutedBrush}"
                                                  Visibility="Collapsed"/>
                                        </StackPanel>
                                        <TextBlock x:Name="DetailTitleText" Margin="0,10,0,0"
                                                   FontSize="{DynamicResource Fs18}" FontWeight="SemiBold"
                                                   Foreground="{DynamicResource TextBrush}"
                                                   TextWrapping="Wrap"/>
                                        <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                                            <TextBlock x:Name="DetailAuthorText"
                                                       Style="{StaticResource CommunityMetaText}"/>
                                            <TextBlock Text="  ·  " Style="{StaticResource CommunityMetaText}"/>
                                            <TextBlock x:Name="DetailDateText"
                                                       Style="{StaticResource CommunityMetaText}"/>
                                        </StackPanel>
                                    </StackPanel>
                                    <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Top">
                                        <Button Click="EditBtn_Click" Width="34" Height="34" Margin="0,0,3,0"
                                                Style="{StaticResource IconButton}" ToolTip="수정">
                                            <Path Style="{StaticResource LucideButtonIcon}"
                                                  Data="{StaticResource IconPencil}" Width="13" Height="13"/>
                                        </Button>
                                        <Button Click="DeleteBtn_Click" Width="34" Height="34"
                                                Style="{StaticResource IconButton}" ToolTip="삭제">
                                            <Path Style="{StaticResource LucideButtonIcon}"
                                                  Data="{StaticResource IconTrash2}" Width="13" Height="13"
                                                  Stroke="{DynamicResource DangerBrush}"/>
                                        </Button>
                                    </StackPanel>
                                </Grid>
                            </Border>
                            <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto"
                                          HorizontalScrollBarVisibility="Disabled" Padding="24,22">
                                <TextBlock x:Name="DetailBodyText" TextWrapping="Wrap"
                                           FontSize="{DynamicResource Fs14}" LineHeight="24"
                                           Foreground="{DynamicResource TextBrush}"/>
                            </ScrollViewer>
                        </Grid>

                        <Border x:Name="LoadingOverlay" Background="#88000000" Visibility="Collapsed">
                            <Border HorizontalAlignment="Center" VerticalAlignment="Center"
                                    Background="{DynamicResource PanelBrush}"
                                    BorderBrush="{DynamicResource LineBrush}" BorderThickness="1"
                                    CornerRadius="10" Padding="18,12">
                                <StackPanel Orientation="Horizontal">
                                    <Ellipse Width="14" Height="14" VerticalAlignment="Center"
                                             models:SpinnerActivator.Track="True"
                                             Stroke="{DynamicResource PrimaryBrush}" StrokeThickness="2"
                                             StrokeDashArray="15 100" StrokeDashCap="Round"
                                             RenderTransformOrigin="0.5,0.5">
                                        <Ellipse.RenderTransform>
                                            <RotateTransform Angle="{Binding Angle, Source={x:Static models:SpinnerSync.Instance}}"/>
                                        </Ellipse.RenderTransform>
                                    </Ellipse>
                                    <TextBlock Text="불러오는 중..." Margin="8,0,0,0"
                                               FontSize="{DynamicResource Fs12}"
                                               Foreground="{DynamicResource TextBrush}"/>
                                </StackPanel>
                            </Border>
                        </Border>
                    </Grid>
                </Grid>
            </Grid>
        </Border>
    </Grid>
</Window>
