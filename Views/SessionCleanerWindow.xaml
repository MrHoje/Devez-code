<Window x:Class="DevezCode.Views.SessionCleanerWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:models="clr-namespace:DevezCode.Models"
        Title="세션 클리너"
        Width="720" Height="500"
        WindowStartupLocation="CenterOwner"
        WindowStyle="None"
        ResizeMode="NoResize"
        AllowsTransparency="True"
        Background="Transparent"
        ShowInTaskbar="False"
        PreviewKeyDown="Window_KeyDown"
        UseLayoutRounding="True"
        SnapsToDevicePixels="True"
        TextOptions.TextFormattingMode="Display"
        TextOptions.TextRenderingMode="ClearType"
        FontFamily="{StaticResource PretendardFont}">
    <Window.Resources>
        <Style x:Key="CategoryItem" TargetType="Button">
            <Setter Property="IsTabStop" Value="False"/>
            <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Foreground" Value="{DynamicResource TextBrush}"/>
            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
            <Setter Property="HorizontalAlignment" Value="Stretch"/>
            <Setter Property="Padding" Value="12,10"/>
            <Setter Property="FontSize" Value="{DynamicResource Fs13}"/>
            <Setter Property="Margin" Value="0,2"/>
            <Setter Property="Cursor" Value="Arrow"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd" Background="{TemplateBinding Background}"
                                CornerRadius="8" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Stretch" VerticalAlignment="Center"
                                              TextElement.Foreground="{TemplateBinding Foreground}"
                                              TextElement.FontWeight="{TemplateBinding FontWeight}"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource PanelBrush}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>
    <Grid x:Name="RootLayer" Margin="{DynamicResource WindowShadowOuterMargin}">
        <Border Background="{DynamicResource BgBrush}" CornerRadius="{DynamicResource WindowShadowCornerRadius}"
                Margin="{DynamicResource WindowShadowInnerMargin}" SnapsToDevicePixels="True">
            <Border.Effect>
                <DropShadowEffect ShadowDepth="0" BlurRadius="{DynamicResource WindowShadowBlurRadius}" Direction="270"
                                  Color="{DynamicResource ShadowColor}" Opacity="{DynamicResource ShadowOpacity}"/>
            </Border.Effect>
        </Border>

        <Border x:Name="ContentBorder" CornerRadius="14" Background="{DynamicResource BgBrush}"
                BorderBrush="{DynamicResource LineBrush}" BorderThickness="1"
                SnapsToDevicePixels="True">
            <Grid x:Name="ContentRoot">
                <Grid.RowDefinitions>
                    <RowDefinition Height="48"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <Border Grid.Row="0" Background="{DynamicResource PanelBrush}"
                        BorderBrush="{DynamicResource LineBrush}" BorderThickness="0,0,0,1"
                        MouseLeftButtonDown="Header_DragMove">
                    <Grid>
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="16,0,0,0">
                            <Path Style="{StaticResource LucideIcon}" Data="{StaticResource IconBrushCleaning}"
                                  Width="16" Height="16" VerticalAlignment="Center"
                                  Stroke="{DynamicResource TextBrush}" Margin="0,-1,11,0"/>
                            <TextBlock Text="세션 클리너" VerticalAlignment="Center"
                                       FontSize="{DynamicResource Fs14}" FontWeight="SemiBold"
                                       Foreground="{DynamicResource TextBrush}"/>
                        </StackPanel>
                        <Button Click="CloseBtn_Click" HorizontalAlignment="Right" VerticalAlignment="Center"
                                Width="40" Height="32" Margin="0,0,8,0" Style="{StaticResource WinCloseBtn}">
                            <TextBlock Text="&#x2715;" FontSize="{DynamicResource Fs11}"/>
                        </Button>
                    </Grid>
                </Border>

                <Grid Grid.Row="1">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="170"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <Border Grid.Column="0" Background="{DynamicResource PanelSoftBrush}"
                            BorderBrush="{DynamicResource LineBrush}" BorderThickness="0,0,1,0">
                        <StackPanel Margin="10,16,10,16">
                            <Button x:Name="ClaudeCatBtn" Tag="claude" Style="{StaticResource CategoryItem}" Click="Category_Click">
                                <StackPanel Orientation="Horizontal">
                                    <Image Width="18" Height="18" Margin="0,0,10,0" VerticalAlignment="Center"
                                           Source="{Binding Tag, RelativeSource={RelativeSource AncestorType=Button}, Converter={x:Static models:AgentImageConverter.Instance}}"
                                           RenderOptions.BitmapScalingMode="HighQuality"/>
                                    <TextBlock Text="Claude" VerticalAlignment="Center"/>
                                </StackPanel>
                            </Button>
                            <Button x:Name="OpenCodeCatBtn" Tag="opencode" Style="{StaticResource CategoryItem}" Click="Category_Click">
                                <StackPanel Orientation="Horizontal">
                                    <Image Width="18" Height="18" Margin="0,0,10,0" VerticalAlignment="Center"
                                           Source="{Binding Tag, RelativeSource={RelativeSource AncestorType=Button}, Converter={x:Static models:AgentImageConverter.Instance}}"
                                           RenderOptions.BitmapScalingMode="HighQuality"/>
                                    <TextBlock Text="OpenCode" VerticalAlignment="Center"/>
                                </StackPanel>
                            </Button>
                            <Button x:Name="GajaeCatBtn" Tag="gajae" Style="{StaticResource CategoryItem}" Click="Category_Click">
                                <StackPanel Orientation="Horizontal">
                                    <Image Width="18" Height="18" Margin="0,0,10,0" VerticalAlignment="Center"
                                           Source="{Binding Tag, RelativeSource={RelativeSource AncestorType=Button}, Converter={x:Static models:AgentImageConverter.Instance}}"
                                           RenderOptions.BitmapScalingMode="HighQuality"/>
                                    <TextBlock Text="Gajae Code" VerticalAlignment="Center"/>
                                </StackPanel>
                            </Button>
                        </StackPanel>
                    </Border>

                    <Grid Grid.Column="1" Margin="28,24,28,22">
                        <StackPanel x:Name="EmptyPanel" Visibility="Collapsed" VerticalAlignment="Center">
                            <TextBlock Text="설정 &gt; 에이전트에서 켜진 클리너 대상 에이전트가 없습니다."
                                       FontSize="{DynamicResource Fs14}" FontWeight="SemiBold"
                                       Foreground="{DynamicResource TextBrush}" TextAlignment="Center"/>
                            <TextBlock Text="Claude, OpenCode, Gajae Code 중 사용할 에이전트를 켜면 여기에 표시됩니다."
                                       FontSize="{DynamicResource Fs12}" Foreground="{DynamicResource TextMutedBrush}"
                                       TextAlignment="Center" Margin="0,8,0,0"/>
                        </StackPanel>

                        <Grid x:Name="ContentPanel">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>

                            <StackPanel Grid.Row="0">
                                <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                                    <Image x:Name="AgentTitleIcon" Width="24" Height="24" Margin="0,0,10,0" VerticalAlignment="Center"
                                           RenderOptions.BitmapScalingMode="HighQuality"/>
                                    <TextBlock x:Name="AgentTitle" FontSize="{DynamicResource Fs18}" FontWeight="SemiBold"
                                               Foreground="{DynamicResource TextBrush}" VerticalAlignment="Center"/>
                                </StackPanel>
                                <TextBlock x:Name="AgentDescription" Text="DevezCode에서 관리중이지 않은 세션을 표시합니다."
                                           TextWrapping="Wrap" Margin="0,0,0,22"
                                           FontSize="{DynamicResource Fs12}" Foreground="{DynamicResource TextMutedBrush}"/>

                                <Border Padding="18" CornerRadius="12" Background="{DynamicResource PanelSoftBrush}"
                                        BorderBrush="{DynamicResource LineBrush}" BorderThickness="1" Margin="0,0,0,16">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <StackPanel VerticalAlignment="Center" Orientation="Horizontal">
                                            <Ellipse x:Name="CountSpinner" Width="28" Height="28" Visibility="Collapsed"
                                                     HorizontalAlignment="Left"
                                                     models:SpinnerActivator.Track="True"
                                                     Stroke="{DynamicResource PrimaryBrush}" StrokeThickness="2.4"
                                                     StrokeDashArray="22 100" StrokeDashCap="Round"
                                                     RenderTransformOrigin="0.5,0.5">
                                                <Ellipse.RenderTransform>
                                                    <RotateTransform Angle="{Binding Angle, Source={x:Static models:SpinnerSync.Instance}}"/>
                                                </Ellipse.RenderTransform>
                                            </Ellipse>
                                            <TextBlock x:Name="AgentCountText" VerticalAlignment="Center"
                                                       FontWeight="SemiBold" Foreground="{DynamicResource TextBrush}"/>
                                            <TextBlock x:Name="AgentCapacityText" Margin="20,0,0,0" VerticalAlignment="Center"
                                                       FontWeight="SemiBold" Foreground="{DynamicResource TextBrush}"/>
                                        </StackPanel>
                                        <Button Grid.Column="1" Content="새로고침" Style="{StaticResource SecondaryButton}"
                                                Height="34" Padding="14,0" VerticalAlignment="Center" Click="Refresh_Click"/>
                                    </Grid>
                                </Border>


                                <TextBlock TextWrapping="Wrap" FontSize="{DynamicResource Fs11}"
                                           Foreground="{DynamicResource TextMutedBrush}">
                                    <Run Text="DevezCode가 현재 관리 중인 세션은 삭제 대상에서 제외됩니다."/>
                                    <LineBreak/>
                                    <Run Text="이 작업은 PC에서 세션 기록을 완전 삭제하며 복구할 수 없습니다."/>
                                </TextBlock>

                                <StackPanel x:Name="VacuumSection" Margin="0,4,0,12" Visibility="Collapsed">
                                    <Separator Margin="0,14,0,14" Background="{DynamicResource LineBrush}"/>
                                    <TextBlock TextWrapping="Wrap" FontSize="{DynamicResource Fs11}"
                                               Foreground="{DynamicResource TextMutedBrush}" Margin="0,0,0,10">
                                        <Run Text="OpenCode는 SQLite를 사용하여 세션을 저장합니다. "/>
                                        <Run FontWeight="SemiBold" Text="DB 정리(VACUUM)"/>
                                        <Run Text="를 실행하면 삭제된 세션의 공간이 회수되어 디스크 용량이 확보됩니다."/>
                                    </TextBlock>
                                    <Button x:Name="VacuumBtn" Content="OpenCode DB 정리" Style="{StaticResource SecondaryButton}"
                                            Height="34" Padding="14,0" HorizontalAlignment="Left" Click="VacuumBtn_Click"/>
                                </StackPanel>
                            </StackPanel>

                            <Button Grid.Row="2" x:Name="DeleteBtn" Content="세션 삭제" Style="{StaticResource PrimaryButton}"
                                    Height="36" MinWidth="128" HorizontalAlignment="Right" Click="DeleteCurrent_Click"/>
                        </Grid>
                    </Grid>
                </Grid>
            </Grid>
        </Border>
    </Grid>
</Window>
