<Window x:Class="DevezCode.Views.McpManagerWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:views="clr-namespace:DevezCode.Views"
        Title="MCP 서버"
        Width="940" Height="640"
        MinWidth="780" MinHeight="520"
        WindowStartupLocation="CenterOwner"
        WindowStyle="None"
        ResizeMode="CanResize"
        AllowsTransparency="True"
        Background="Transparent"
        ShowInTaskbar="False"
        PreviewKeyDown="Window_PreviewKeyDown"
        UseLayoutRounding="True"
        SnapsToDevicePixels="True"
        TextOptions.TextFormattingMode="Display"
        TextOptions.TextRenderingMode="ClearType"
        FontFamily="{StaticResource PretendardFont}">

    <Grid Margin="{DynamicResource WindowShadowOuterMargin}">
        <!-- Shadow layer -->
        <Border Background="{DynamicResource BgBrush}" CornerRadius="{DynamicResource WindowShadowCornerRadius}"
                Margin="{DynamicResource WindowShadowInnerMargin}"
                SnapsToDevicePixels="True">
            <Border.Effect>
                <DropShadowEffect ShadowDepth="0" BlurRadius="{DynamicResource WindowShadowBlurRadius}" Direction="270"
                                  Color="{DynamicResource ShadowColor}" Opacity="{DynamicResource ShadowOpacity}"/>
            </Border.Effect>
        </Border>
        <!-- Content layer -->
        <Border CornerRadius="14"
                Background="{DynamicResource BgBrush}"
                BorderBrush="{DynamicResource LineBrush}" BorderThickness="1"
                ClipToBounds="True"
                SnapsToDevicePixels="True">
            <views:McpManagerDialog x:Name="McpView"/>
        </Border>
    </Grid>
</Window>
