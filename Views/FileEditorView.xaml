<UserControl x:Class="DevezCode.Views.FileEditorView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ae="http://icsharpcode.net/sharpdevelop/avalonedit"
             Background="{DynamicResource BgBrush}"
             ClipToBounds="True"
             UseLayoutRounding="True"
             FontFamily="{StaticResource PretendardFont}">

    <UserControl.Resources>
        <Style TargetType="ae:TextEditor">
            <Setter Property="Background" Value="{DynamicResource BgBrush}"/>
            <Setter Property="Foreground" Value="{DynamicResource TextBrush}"/>
            <Setter Property="FontFamily" Value="Cascadia Mono, Consolas, D2Coding, Malgun Gothic"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Padding" Value="14,10"/>
            <Setter Property="HorizontalScrollBarVisibility" Value="Auto"/>
            <Setter Property="VerticalScrollBarVisibility" Value="Auto"/>
            <Setter Property="ShowLineNumbers" Value="True"/>
        </Style>
    </UserControl.Resources>

    <Border BorderBrush="{DynamicResource LineBrush}" BorderThickness="1,0,0,0">
        <ae:TextEditor x:Name="Editor" WordWrap="False"
                       TextChanged="Editor_TextChanged"/>
    </Border>
</UserControl>
