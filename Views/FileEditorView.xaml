<UserControl x:Class="DevezCode.Views.FileEditorView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ae="http://icsharpcode.net/sharpdevelop/avalonedit"
             Background="{DynamicResource BgBrush}"
             ClipToBounds="True"
             UseLayoutRounding="True"
             FontFamily="{StaticResource PretendardFont}">

    <UserControl.Resources>
        <!-- 구문색이 있으면 라인번호도 켠다(VS 스타일). ShowLineNumbers 는 코드비하인드에서 파일 타입별로 제어. -->
        <Style TargetType="ae:TextEditor">
            <Setter Property="Background" Value="{DynamicResource BgBrush}"/>
            <Setter Property="Foreground" Value="{DynamicResource TextBrush}"/>
            <Setter Property="LineNumbersForeground" Value="{DynamicResource TextMutedBrush}"/>
            <Setter Property="FontFamily" Value="Consolas, D2Coding, Malgun Gothic"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="Padding" Value="24,20"/>
            <Setter Property="HorizontalScrollBarVisibility" Value="Disabled"/>
            <Setter Property="VerticalScrollBarVisibility" Value="Auto"/>
        </Style>
    </UserControl.Resources>

    <!-- 왼쪽 보더 제거(중앙 구분선과 겹쳐 두 줄로 보임) + 1px 왼쪽으로 확장. -->
    <Border Margin="-1,0,0,0">
        <ae:TextEditor x:Name="Editor" WordWrap="True"
                       TextChanged="Editor_TextChanged"/>
    </Border>
</UserControl>
