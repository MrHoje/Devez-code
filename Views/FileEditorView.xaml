<UserControl x:Class="DevezCode.Views.FileEditorView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Background="{DynamicResource BgBrush}"
             ClipToBounds="True"
             UseLayoutRounding="True"
             FontFamily="{StaticResource PretendardFont}">

    <!-- 좌측 1px 보더로 터미널 영역과 채널(분할선) 형성 (devez 디자인 정합) -->
    <Border BorderBrush="{DynamicResource LineBrush}" BorderThickness="1,0,0,0">
        <TextBox x:Name="Editor"
                 Background="{DynamicResource BgBrush}"
                 Foreground="{DynamicResource TextBrush}"
                 CaretBrush="{DynamicResource TextBrush}"
                 BorderThickness="0" Padding="14,10"
                 FontFamily="Cascadia Mono, Consolas, D2Coding, Malgun Gothic"
                 FontSize="13"
                 AcceptsReturn="True" AcceptsTab="True"
                 TextWrapping="NoWrap"
                 HorizontalScrollBarVisibility="Auto"
                 VerticalScrollBarVisibility="Auto"
                 TextChanged="Editor_TextChanged"/>
    </Border>
</UserControl>
