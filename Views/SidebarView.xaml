<UserControl x:Class="DevezCode.Views.SidebarView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:models="clr-namespace:DevezCode.Models"
             xmlns:b="clr-namespace:DevezCode.Behaviors"
             Background="{DynamicResource PanelBrush}"
             FontFamily="{StaticResource PretendardFont}">
    <UserControl.Resources>
        <!-- 세션 상태 점: 살아있으면 테마 primary(다크=주황), 죽으면 회색 -->
        <Style x:Key="SessionDot" TargetType="Ellipse">
            <Setter Property="Width" Value="8"/>
            <Setter Property="Height" Value="8"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="Fill" Value="#6B7280"/>
            <Style.Triggers>
                <DataTrigger Binding="{Binding IsAlive}" Value="True">
                    <Setter Property="Fill" Value="{DynamicResource PrimaryBrush}"/>
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <!-- ── 프로젝트 카드: doit ShellShortcut 카드 디자인. 보더 항상 표시(LineBrush), 호버는 보더/그림자만(배경 유지 → 세션 안 묻힘), 활성은 primary 보더 + 글로우 ── -->
        <Style x:Key="ProjectCard" TargetType="Border">
            <Setter Property="CornerRadius" Value="10"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="BorderBrush" Value="{DynamicResource LineBrush}"/>
            <Setter Property="Background" Value="{DynamicResource PanelBrush}"/>
            <Setter Property="Margin" Value="0,3,0,3"/>
            <Setter Property="Effect" Value="{x:Null}"/>
            <Style.Triggers>
                <!-- 호버: 보더만 살짝 더 진하게 + 미세한 그림자 ('떠오름'감). 배경은 유지 → 세션 row가 묻히지 않음 -->
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="BorderBrush" Value="#5a5a5a"/>
                    <Setter Property="Effect">
                        <Setter.Value>
                            <DropShadowEffect Color="Black" Opacity="0.4" BlurRadius="10" ShadowDepth="2" Direction="270"/>
                        </Setter.Value>
                    </Setter>
                </Trigger>
                <!-- 선택된(활성) 프로젝트: primary 보더 + primary 글로우. 호버보다 우선 -->
                <DataTrigger Binding="{Binding IsSelected}" Value="True">
                    <Setter Property="BorderBrush" Value="{DynamicResource PrimaryBrush}"/>
                    <Setter Property="Effect">
                        <Setter.Value>
                            <DropShadowEffect Color="{DynamicResource PrimaryColor}" Opacity="0.35" BlurRadius="14" ShadowDepth="0"/>
                        </Setter.Value>
                    </Setter>
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <!-- ── 세션 row 카드: 둥근 배경, 호버 시 살짝 진해짐. '선택' 배경은 없음(파란색 미사용) ── -->
        <Style x:Key="SessionCard" TargetType="Border">
            <Setter Property="CornerRadius" Value="8"/>
            <Setter Property="Background" Value="{DynamicResource PanelSoftBrush}"/>
            <Setter Property="Cursor" Value="Arrow"/>
            <Setter Property="Margin" Value="0,2,0,2"/>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="{DynamicResource LineBrush}"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <!-- ── 세션(하위 항목) 템플릿 — Claude 로고 + 상태 점 + 이름 + 호버 ⋯ 메뉴 ── -->
        <DataTemplate x:Key="SessionTemplate" DataType="{x:Type models:SessionItem}">
            <Border x:Name="SessionRow" Style="{StaticResource SessionCard}"
                    MouseLeftButtonUp="Session_Click"
                    PreviewMouseLeftButtonDown="SessionRow_PreviewMouseLeftButtonDown">
                <Border.ContextMenu>
                    <ContextMenu>
                        <MenuItem Header="이름 변경" Tag="{Binding}" Click="SessionRename_Click">
                            <MenuItem.Icon>
                                <Path Style="{StaticResource LucideIcon}" Data="{StaticResource IconPencil}"
                                      Width="13" Height="13" Stroke="{DynamicResource TextMutedBrush}"/>
                            </MenuItem.Icon>
                        </MenuItem>
                        <Separator/>
                        <MenuItem Header="세션 닫기" Tag="{Binding}" Click="SessionStopTracking_Click">
                            <MenuItem.Icon>
                                <Path Style="{StaticResource LucideIcon}" Data="{StaticResource IconTrash2}"
                                      Width="13" Height="13" Stroke="{DynamicResource TextMutedBrush}"/>
                            </MenuItem.Icon>
                        </MenuItem>
                        <MenuItem Header="세션 삭제" Tag="{Binding}" Click="SessionDelete_Click" Foreground="{DynamicResource DangerBrush}">
                            <MenuItem.Icon>
                                <Path Style="{StaticResource LucideIcon}" Data="{StaticResource IconTrash2}"
                                      Width="13" Height="13" Stroke="{DynamicResource DangerBrush}"/>
                            </MenuItem.Icon>
                        </MenuItem>
                    </ContextMenu>
                </Border.ContextMenu>
                <Grid Margin="10,5,10,5">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <!-- 에이전트 로고 (claude/codex/opencode/gajae) — SessionItem.AgentId 기준. 없으면 claude 폴백. -->
                    <Image Grid.Column="0" Width="14" Height="14" Margin="0,0,8,0" VerticalAlignment="Center"
                           Source="{Binding AgentId, Converter={x:Static models:AgentImageConverter.Instance}}"
                           RenderOptions.BitmapScalingMode="HighQuality"/>
                    <!-- 상태 점(평소) ↔ 회전 스피너(요청 처리중). 탭 X 로 숨긴 세션은 추적중지 아이콘. -->
                    <Grid Grid.Column="1" Width="12" Height="12" VerticalAlignment="Center">
                        <Ellipse x:Name="StatusDot" Style="{StaticResource SessionDot}"/>
                        <Ellipse x:Name="BusySpinner" Width="12" Height="12" Visibility="Collapsed"
                                 Stroke="{DynamicResource PrimaryBrush}" StrokeThickness="1.6"
                                 StrokeDashArray="15 100" StrokeDashCap="Round"
                                 RenderTransformOrigin="0.5,0.5">
                            <Ellipse.RenderTransform>
                                <RotateTransform x:Name="SpinRot"/>
                            </Ellipse.RenderTransform>
                        </Ellipse>
                        <!-- 숨김 세션(탭 X) — 추적중지 아이콘. -->
                        <Path x:Name="HiddenIcon" Visibility="Collapsed"
                              Data="{StaticResource IconEyeOff}"
                              Width="12" Height="12" Stretch="Uniform"
                              Stroke="{DynamicResource TextMutedBrush}" StrokeThickness="1.4"
                              Fill="Transparent" SnapsToDevicePixels="True"/>
                    </Grid>
                    <TextBlock Grid.Column="2" Text="{Binding Name}" Margin="10,0,0,0"
                               VerticalAlignment="Center" TextTrimming="CharacterEllipsis"
                               FontSize="{DynamicResource Fs12}"
                               Foreground="{DynamicResource TextBrush}"/>
                </Grid>
            </Border>
            <DataTemplate.Triggers>
                <!-- 숨김 세션(탭 X): 점/스피너 숨기고 추적중지 아이콘 노출. IsBusy 보다 우선. -->
                <DataTrigger Binding="{Binding Hidden}" Value="True">
                    <Setter TargetName="StatusDot" Property="Visibility" Value="Collapsed"/>
                    <Setter TargetName="BusySpinner" Property="Visibility" Value="Collapsed"/>
                    <Setter TargetName="HiddenIcon" Property="Visibility" Value="Visible"/>
                </DataTrigger>
                <!-- 요청 처리중 스피너: 숨김 세션(!Hidden)일 때만 동작. -->
                <MultiDataTrigger>
                    <MultiDataTrigger.Conditions>
                        <Condition Binding="{Binding Hidden}" Value="False"/>
                        <Condition Binding="{Binding IsBusy}" Value="True"/>
                    </MultiDataTrigger.Conditions>
                    <Setter TargetName="StatusDot" Property="Visibility" Value="Collapsed"/>
                    <Setter TargetName="BusySpinner" Property="Visibility" Value="Visible"/>
                    <Setter TargetName="HiddenIcon" Property="Visibility" Value="Collapsed"/>
                    <MultiDataTrigger.EnterActions>
                        <BeginStoryboard x:Name="SpinBs">
                            <Storyboard>
                                <DoubleAnimation Storyboard.TargetName="SpinRot"
                                                 Storyboard.TargetProperty="Angle"
                                                 From="0" To="360" Duration="0:0:0.8"
                                                 RepeatBehavior="Forever"/>
                            </Storyboard>
                        </BeginStoryboard>
                    </MultiDataTrigger.EnterActions>
                    <MultiDataTrigger.ExitActions>
                        <StopStoryboard BeginStoryboardName="SpinBs"/>
                    </MultiDataTrigger.ExitActions>
                </MultiDataTrigger>
            </DataTemplate.Triggers>
        </DataTemplate>

        <!-- ── 프로젝트(상위 항목) 템플릿 — 카드 헤더(아이콘·이름·chevron·⋯) + 세션 row 리스트 ── -->
        <DataTemplate x:Key="ProjectTemplate" DataType="{x:Type models:ProjectItem}">
            <Border Style="{StaticResource ProjectCard}">
                <StackPanel>
                    <!-- 프로젝트 헤더 행 -->
                    <Border Background="Transparent" Cursor="Arrow"
                            MouseLeftButtonUp="Project_Click"
                            PreviewMouseLeftButtonDown="ProjectRow_PreviewMouseLeftButtonDown">
                        <Border.ContextMenu>
                            <ContextMenu>
                                <MenuItem Header="새 세션" Tag="{Binding}" Click="AddSession_Click">
                                    <MenuItem.Icon>
                                        <Path Style="{StaticResource LucideIcon}" Data="{StaticResource IconPlus}"
                                              Width="13" Height="13" Stroke="{DynamicResource TextMutedBrush}"/>
                                    </MenuItem.Icon>
                                </MenuItem>
                                <Separator/>
                                <MenuItem Header="프로젝트 제거" Tag="{Binding}" Click="ProjectDelete_Click" Foreground="{DynamicResource DangerBrush}">
                                    <MenuItem.Icon>
                                        <Path Style="{StaticResource LucideIcon}" Data="{StaticResource IconTrash2}"
                                              Width="13" Height="13" Stroke="{DynamicResource DangerBrush}"/>
                                    </MenuItem.Icon>
                                </MenuItem>
                            </ContextMenu>
                        </Border.ContextMenu>
                        <Grid Margin="12,9,8,9">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <!-- 프로젝트 명 + 경로(작은 폰트, 잘리면 …). chevron/메뉴는 2줄 헤더에 대해 수직 중앙 정렬 -->
                            <StackPanel Grid.Column="0" VerticalAlignment="Center" ToolTip="{Binding Path}">
                                <TextBlock Text="{Binding Name}"
                                           TextTrimming="CharacterEllipsis"
                                           FontSize="{DynamicResource Fs14}" FontWeight="SemiBold"
                                           Foreground="{DynamicResource TextBrush}"/>
                                <TextBlock Text="{Binding Path}" Margin="0,1,0,0"
                                           TextTrimming="CharacterEllipsis"
                                           FontSize="{DynamicResource Fs11}"
                                           Foreground="{DynamicResource TextMutedBrush}"/>
                            </StackPanel>
                            <!-- 접고/펴기는 이 chevron 버튼으로만 (행 클릭은 선택 전용) -->
                            <Button Grid.Column="1" Margin="6,0,0,0" Tag="{Binding}"
                                    Click="ProjectChevron_Click" Cursor="Arrow"
                                    Background="Transparent" BorderThickness="0"
                                    IsTabStop="False" FocusVisualStyle="{x:Null}"
                                    ToolTip="펼치기 / 접기">
                                <Button.Template>
                                    <ControlTemplate TargetType="Button">
                                        <Border x:Name="Bd" Width="22" Height="22" CornerRadius="6"
                                                Background="{TemplateBinding Background}">
                                            <Path Style="{StaticResource LucideButtonIcon}"
                                                  Data="{Binding IsExpanded, Converter={x:Static models:ChevronConverter.Instance}}"
                                                  Width="9" Height="9"
                                                  Stroke="{DynamicResource TextMutedBrush}"
                                                  HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                        </Border>
                                        <ControlTemplate.Triggers>
                                            <Trigger Property="IsMouseOver" Value="True">
                                                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource LineBrush}"/>
                                            </Trigger>
                                        </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                </Button.Template>
                            </Button>
                            <!-- 세로형 ... 버튼 — 우클릭 메뉴를 동일하게 띄움 -->
                            <Button Grid.Column="2" Margin="2,0,0,0" Tag="{Binding}"
                                    Click="ProjectMenu_Click" Cursor="Arrow"
                                    Background="Transparent" BorderThickness="0"
                                    IsTabStop="False" FocusVisualStyle="{x:Null}"
                                    ToolTip="메뉴">
                                <Button.Template>
                                    <ControlTemplate TargetType="Button">
                                        <Border x:Name="Bd" Width="22" Height="22" CornerRadius="6"
                                                Background="{TemplateBinding Background}">
                                            <Path Style="{StaticResource LucideButtonIcon}"
                                                  Data="{StaticResource IconMoreVertical}"
                                                  Width="13" Height="13"
                                                  Stroke="{DynamicResource TextMutedBrush}"
                                                  HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                        </Border>
                                        <ControlTemplate.Triggers>
                                            <Trigger Property="IsMouseOver" Value="True">
                                                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource LineBrush}"/>
                                            </Trigger>
                                        </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                </Button.Template>
                            </Button>
                        </Grid>
                    </Border>
                    <!-- 세션 리스트: 펼침 시 표시. 가이드선/연결됨 텍스트 없음 -->
                    <Border Visibility="Collapsed"
                            b:TreeExpander.IsExpanded="{Binding IsExpanded}">
                        <ItemsControl ItemsSource="{Binding Sessions}"
                                      ItemTemplate="{StaticResource SessionTemplate}"
                                      Margin="8,2,8,8"/>
                    </Border>
                </StackPanel>
            </Border>
        </DataTemplate>
    </UserControl.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Header (라벨 + 모두 펼치기/접기) — devez 정합. 높이 44: 중앙 TabBar·우측 뷰토글과 상단 세퍼레이터 일치 -->
        <Border Grid.Row="0" Height="44"
                BorderBrush="{DynamicResource LineBrush}" BorderThickness="0,0,0,1">
            <Grid Margin="16,0,12,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <TextBlock Grid.Column="0" Text="프로젝트" VerticalAlignment="Center"
                           FontSize="{DynamicResource Fs13}" FontWeight="SemiBold"
                           Foreground="{DynamicResource TextBrush}"/>
                <Button x:Name="ToggleExpandAllBtn" Grid.Column="1"
                        Width="28" Height="28"
                        Style="{StaticResource IconButton}"
                        Click="ToggleExpandAll_Click"
                        ToolTip="모두 펼치기">
                    <Grid Width="14" Height="14">
                        <Path x:Name="ToggleExpandAllIcon"
                              Style="{StaticResource LucideButtonIcon}"
                              Data="{StaticResource IconChevronRight}"
                              Width="12" Height="12"
                              RenderTransformOrigin="0.5,0.5">
                            <Path.RenderTransform>
                                <RotateTransform Angle="90"/>
                            </Path.RenderTransform>
                        </Path>
                    </Grid>
                </Button>
            </Grid>
        </Border>

        <!-- Search row — devez 정합. pill 35 + 상하좌우 8px 균일 여백 = 행 51 -->
        <Border Grid.Row="1"
                BorderBrush="{DynamicResource LineBrush}" BorderThickness="0,0,0,1">
            <Border Margin="8" Height="35"
                    Background="{DynamicResource PanelSoftBrush}"
                    BorderBrush="{DynamicResource LineBrush}"
                    BorderThickness="1" CornerRadius="8">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <Path Grid.Column="0" Style="{StaticResource LucideIcon}"
                          Data="{StaticResource IconSearch}"
                          Stroke="{DynamicResource TextMutedBrush}"
                          Width="13" Height="13"
                          Margin="10,0,0,0" VerticalAlignment="Center"/>
                    <Grid Grid.Column="1">
                        <TextBox x:Name="SidebarSearchBox"
                                 Margin="6,0,0,0" Padding="0,0,10,0" VerticalContentAlignment="Center"
                                 Background="Transparent" BorderThickness="0"
                                 FocusVisualStyle="{x:Null}"
                                 Foreground="{DynamicResource TextBrush}"
                                 CaretBrush="{DynamicResource TextBrush}"
                                 FontSize="{DynamicResource Fs13}"
                                 FontFamily="{StaticResource PretendardFont}"
                                 TextChanged="SidebarSearchBox_TextChanged">
                            <TextBox.Resources>
                                <Style TargetType="Border"><Setter Property="CornerRadius" Value="0"/></Style>
                            </TextBox.Resources>
                        </TextBox>
                        <TextBlock Text="프로젝트 / 세션 검색"
                                   IsHitTestVisible="False"
                                   Margin="8,0,10,0" Padding="0" VerticalAlignment="Center"
                                   Foreground="{DynamicResource TextMutedBrush}"
                                   FontSize="{DynamicResource Fs13}"
                                   FontFamily="{StaticResource PretendardFont}">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock" BasedOn="{StaticResource {x:Type TextBlock}}">
                                    <Setter Property="Visibility" Value="Collapsed"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding Text, ElementName=SidebarSearchBox}" Value="">
                                            <Setter Property="Visibility" Value="Visible"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>
                    </Grid>
                </Grid>
            </Border>
        </Border>

        <!-- Project tree + floating FAB -->
        <Grid Grid.Row="2">
            <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="8,8">
                <ItemsControl x:Name="ProjectsHost" ItemTemplate="{StaticResource ProjectTemplate}"/>
            </ScrollViewer>

            <!-- 새 프로젝트 FAB (devez 방식: 우하단 떠 있는 원형 버튼) -->
            <Border VerticalAlignment="Bottom" HorizontalAlignment="Right"
                    Margin="0,0,10,10" Panel.ZIndex="10">
                <Button Width="32" Height="32" Click="AddProject_Click" ToolTip="새 프로젝트">
                    <Button.Template>
                        <ControlTemplate TargetType="Button">
                            <Border x:Name="Bd" CornerRadius="16" Background="{DynamicResource PrimaryBrush}">
                                <Border.Effect>
                                    <DropShadowEffect Color="{DynamicResource ShadowColor}" Opacity="0.3"
                                                      BlurRadius="12" ShadowDepth="2" Direction="270"/>
                                </Border.Effect>
                                <Path Data="{StaticResource IconPlus}"
                                      Stroke="White" StrokeThickness="2"
                                      StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round"
                                      Width="14" Height="14" Stretch="Uniform"
                                      HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="Bd" Property="Background" Value="{DynamicResource PrimaryHoverBrush}"/>
                                </Trigger>
                                <Trigger Property="IsPressed" Value="True">
                                    <Setter TargetName="Bd" Property="Background" Value="{DynamicResource PrimaryPressedBrush}"/>
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Button.Template>
                </Button>
            </Border>
        </Grid>
    </Grid>
</UserControl>
