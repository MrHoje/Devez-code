<UserControl x:Class="DevezCode.Views.SidebarView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:models="clr-namespace:DevezCode.Models"
             xmlns:b="clr-namespace:DevezCode.Behaviors"
             xmlns:local="clr-namespace:DevezCode.Views"
             Background="{DynamicResource PanelBrush}"
             FontFamily="{StaticResource PretendardFont}">
    <UserControl.Resources>
        <!-- 세로 스크롤바가 레이아웃 공간을 점유(+Auto 컬럼)해 우측 패딩(8px)을 확보,
             스크롤 유무와 관계없이 카드와 스크롤바 사이 간격이 일정(8px)하게 유지된다. -->
        <Style x:Key="OverlayVScroll" TargetType="ScrollViewer">
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ScrollViewer">
                        <!-- 스크롤바는 Auto 컬럼: 숨김이면 폭 0(우측 여백 = 좌측과 동일 8px),
                             표시면 폭 8을 차지하되 콘텐츠는 우측 패딩 8을 유지 → 카드~스크롤바 간격 8px 확보.
                             폭 토글은 세로 스택에서 콘텐츠 높이를 줄이지 못해(좁아지면 같거나 커짐) 진동 없음.
                             과거 꿈틀거림의 실제 원인은 ProjectScrollChanged의 패딩 토글이었고 제거됨. -->
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <ScrollContentPresenter Grid.Column="0" Margin="{TemplateBinding Padding}"/>
                            <ScrollBar x:Name="PART_VerticalScrollBar" Grid.Column="1" Orientation="Vertical"
                                       Cursor="Arrow"
                                       Minimum="0" Maximum="{TemplateBinding ScrollableHeight}"
                                       ViewportSize="{TemplateBinding ViewportHeight}"
                                       Value="{Binding VerticalOffset, RelativeSource={RelativeSource TemplatedParent}, Mode=OneWay}"
                                       Visibility="{TemplateBinding ComputedVerticalScrollBarVisibility}"/>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- 프로젝트 목록 패널: 열 수는 ItemsControl.Tag(설정 > 프로젝트)로 바인딩.
             1열=세로 스택, 2열=좌/우 독립 컬럼(카드별 Column 으로 배치, 자동 재배치 없음). -->
        <ItemsPanelTemplate x:Key="ProjectsPanel">
            <local:ProjectColumnsPanel Columns="{Binding Tag, RelativeSource={RelativeSource AncestorType=ItemsControl}}"/>
        </ItemsPanelTemplate>

        <!-- 세션 상태 점: 살아있으면 테마 primary(다크=주황), 죽으면 회색 -->
        <Style x:Key="SessionDot" TargetType="Ellipse">
            <Setter Property="Width" Value="8"/>
            <Setter Property="Height" Value="8"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="Fill" Value="#6B7280"/>
            <Style.Triggers>
                <DataTrigger Binding="{Binding IsAlive}" Value="True">
                    <Setter Property="Fill" Value="{DynamicResource PrimaryBrush}"/>
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <Thickness x:Key="ProjectCardOuterMargin">0,3,0,8</Thickness>

        <!-- ── 프로젝트 카드: doit ShellShortcut 카드 디자인. 보더 항상 표시(LineBrush), 호버는 보더만(그림자 X → '떠오름' 인상이 텍스트 우상단 이동처럼 보임), 활성은 primary 보더 + 글로우 ── -->
        <Style x:Key="ProjectCard" TargetType="Border">
            <Setter Property="CornerRadius" Value="10"/>
            <Setter Property="BorderThickness" Value="1.5"/>
            <Setter Property="BorderBrush" Value="{DynamicResource LineBrush}"/>
            <Setter Property="Background" Value="{DynamicResource PanelBrush}"/>
            <Setter Property="Padding" Value="0,0,0,5"/>
            <Setter Property="Margin" Value="{DynamicResource ProjectCardOuterMargin}"/>
            <Setter Property="Effect" Value="{x:Null}"/>
            <!-- 채팅 버블 선택 링 방식 참고: 픽셀 스냅·레이아웃 라운딩 끄고 안티에일리어싱 → 부드러운 보더 -->
            <Setter Property="SnapsToDevicePixels" Value="False"/>
            <Setter Property="UseLayoutRounding" Value="False"/>
            <Setter Property="RenderOptions.EdgeMode" Value="Unspecified"/>
            <Style.Triggers>
                <!-- 선택된(활성) 프로젝트: primary 보더 색만 변경 (배경 채움 없음) -->
                <DataTrigger Binding="{Binding IsSelected}" Value="True">
                    <Setter Property="BorderBrush" Value="{DynamicResource PrimaryBrush}"/>
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <!-- ── 세션 row 카드: 둥근 배경, 호버 시 살짝 진해짐. '선택' 배경은 없음(파란색 미사용) ──
             부모 프로젝트가 선택되지 않은 경우: 호버 강조 비활성 (마지막 DataTrigger가 IsMouseOver Trigger를 덮어씀) -->
        <Style x:Key="SessionCard" TargetType="Border">
            <Setter Property="CornerRadius" Value="8"/>
            <Setter Property="Background" Value="{DynamicResource PanelSoftBrush}"/>
            <Setter Property="Cursor" Value="Arrow"/>
            <Setter Property="Margin" Value="0,2,0,2"/>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="{DynamicResource ProjectCardHoverBrush}"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <!-- 자식 드롭 대상 세션 전용: 프로젝트 카드 선택 보더와 같은 1.5px primary 하이라이트 기반. -->
        <Style x:Key="SessionDropTargetCard" TargetType="Border" BasedOn="{StaticResource SessionCard}">
            <Setter Property="BorderThickness" Value="1.5"/>
            <Setter Property="BorderBrush" Value="Transparent"/>
            <Setter Property="Effect" Value="{x:Null}"/>
            <Setter Property="SnapsToDevicePixels" Value="False"/>
            <Setter Property="UseLayoutRounding" Value="False"/>
            <Setter Property="RenderOptions.EdgeMode" Value="Unspecified"/>
            <Style.Triggers>
                <DataTrigger Binding="{Binding ContextMenu.IsOpen, RelativeSource={RelativeSource Self}}" Value="True">
                    <Setter Property="Background" Value="{DynamicResource ProjectCardHoverBrush}"/>
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <!-- ── 세션(하위 항목) 템플릿 — Claude 로고 + 상태 점 + 이름 + 호버 ⋯ 메뉴 ── -->
        <DataTemplate x:Key="SessionTemplate" DataType="{x:Type models:SessionItem}">
            <Border Visibility="Collapsed"
                    b:TreeExpander.IsExpanded="{Binding IsSessionTreeVisible}">
            <Grid x:Name="SessionRowLayout"
                  Visibility="{Binding IsSearchVisible, Converter={x:Static models:BoolToVisibilityConverter.Instance}}">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="{Binding TreeIndent}"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <!-- 분할로 부모가 반대 패널 그룹에 있는 자식: 원래 부모 자리에 보더 없는 이름 라벨만 표시. -->
                <TextBlock Grid.Row="0" Grid.ColumnSpan="2" Margin="2,4,0,2"
                           Text="{Binding DetachedParentSession.Name}"
                           TextTrimming="CharacterEllipsis"
                           FontSize="{DynamicResource Fs12}"
                           Foreground="{DynamicResource TextMutedBrush}"
                           Visibility="{Binding HasDetachedParentLabel, Converter={x:Static models:BoolToVisibilityConverter.Instance}}"/>
                <!-- 자식 연결선: 가로선은 행 중앙을 유지하고 세로선만 카드 윗 보더까지 연장한다. -->
                <Grid Grid.Row="1" Grid.Column="0" Width="10"
                      HorizontalAlignment="Right" VerticalAlignment="Stretch"
                      Visibility="{Binding HasSessionParent, Converter={x:Static models:BoolToVisibilityConverter.Instance}}">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>
                    <Border Grid.Row="0" Width="1.2" Margin="1,2,0,0"
                            HorizontalAlignment="Left"
                            Background="{DynamicResource LineBrush}" CornerRadius="0.6"/>
                    <Border Grid.Row="1" Width="9" Height="1.2" Margin="1,0,0,0"
                            HorizontalAlignment="Left" VerticalAlignment="Top"
                            Background="{DynamicResource LineBrush}" CornerRadius="0.6"/>
                </Grid>
                <Border x:Name="SessionRow" Grid.Row="1" Grid.Column="1" Style="{StaticResource SessionDropTargetCard}"
                        MouseLeftButtonUp="Session_Click"
                        PreviewMouseLeftButtonDown="SessionRow_PreviewMouseLeftButtonDown"
                        PreviewMouseRightButtonDown="SessionRow_PreviewMouseRightButtonDown">
                <Border.ContextMenu>
                    <ContextMenu Opened="SessionMenu_Opened">
                        <MenuItem Header="꺼내기" Tag="{Binding}" CommandParameter="Single" Click="SessionDetach_Click"
                                  Visibility="{Binding HasSessionParent, Converter={x:Static models:BoolToVisibilityConverter.Instance}}">
                            <MenuItem.Icon>
                                <Path Style="{StaticResource LucideIcon}" Data="{StaticResource IconLogOut}"
                                      Width="13" Height="13" Stroke="{DynamicResource TextMutedBrush}"/>
                            </MenuItem.Icon>
                        </MenuItem>
                        <Separator Visibility="{Binding HasSessionParent, Converter={x:Static models:BoolToVisibilityConverter.Instance}}"/>
                        <MenuItem Header="이름 변경" Tag="{Binding}" CommandParameter="Single" Click="SessionRename_Click">
                            <MenuItem.Icon>
                                <Path Style="{StaticResource LucideIcon}" Data="{StaticResource IconPencil}"
                                      Width="13" Height="13" Stroke="{DynamicResource TextMutedBrush}"/>
                            </MenuItem.Icon>
                        </MenuItem>
                        <MenuItem Header="포크" Tag="{Binding}" CommandParameter="Single" Click="SessionFork_Click">
                            <MenuItem.Icon>
                                <Path Style="{StaticResource LucideIcon}" Data="{StaticResource IconGitBranch}"
                                      Width="13" Height="13" Stroke="{DynamicResource TextMutedBrush}"/>
                            </MenuItem.Icon>
                        </MenuItem>
                        <MenuItem Header="내보내기" Tag="{Binding}" CommandParameter="Single" Click="SessionExport_Click">
                            <MenuItem.Icon>
                                <Path Style="{StaticResource LucideIcon}" Data="{StaticResource IconFileText}"
                                      Width="13" Height="13" Stroke="{DynamicResource TextMutedBrush}"/>
                            </MenuItem.Icon>
                        </MenuItem>
                        <!-- Lock toggle -->
                        <MenuItem Header="세션 잠금" Tag="{Binding}" CommandParameter="Lock" Click="SessionLock_Click"
                                  Visibility="{Binding IsLocked, Converter={x:Static models:BoolToVisibilityConverter.Instance}, ConverterParameter=invert}">
                            <MenuItem.Icon>
                                <Path Style="{StaticResource LucideIcon}" Data="{StaticResource IconLock}"
                                      Width="13" Height="13" Stroke="{DynamicResource TextMutedBrush}"/>
                            </MenuItem.Icon>
                        </MenuItem>
                        <MenuItem Header="잠금 해제" Tag="{Binding}" CommandParameter="Unlock" Click="SessionLock_Click"
                                  Visibility="{Binding IsLocked, Converter={x:Static models:BoolToVisibilityConverter.Instance}}">
                            <MenuItem.Icon>
                                <Path Style="{StaticResource LucideIcon}" Data="{StaticResource IconLockOpen}"
                                      Width="13" Height="13" Stroke="{DynamicResource TextMutedBrush}"/>
                            </MenuItem.Icon>
                        </MenuItem>
                        <Separator/>
                        <MenuItem Header="세션 숨기기" Tag="{Binding}" CommandParameter="Hide" Click="SessionHide_Click"
                                  Visibility="{Binding Hidden, Converter={x:Static models:BoolToVisibilityConverter.Instance}, ConverterParameter=invert}">
                            <MenuItem.Icon>
                                <Path Style="{StaticResource LucideIcon}" Data="{StaticResource IconEyeOff}"
                                      Width="13" Height="13" Stroke="{DynamicResource TextMutedBrush}"/>
                            </MenuItem.Icon>
                        </MenuItem>
                        <MenuItem Header="세션 닫기" Tag="{Binding}" CommandParameter="Close" Click="SessionStopTracking_Click"
                                  Visibility="{Binding IsLocked, Converter={x:Static models:BoolToVisibilityConverter.Instance}, ConverterParameter=invert}">
                            <MenuItem.Icon>
                                <Path Style="{StaticResource LucideIcon}" Data="{StaticResource IconX}"
                                      Width="13" Height="13" Stroke="{DynamicResource TextMutedBrush}"/>
                            </MenuItem.Icon>
                        </MenuItem>
                        <MenuItem Header="세션 삭제" Tag="{Binding}" CommandParameter="Delete" Click="SessionDelete_Click" Foreground="{DynamicResource DangerBrush}"
                                  Visibility="{Binding IsLocked, Converter={x:Static models:BoolToVisibilityConverter.Instance}, ConverterParameter=invert}">
                            <MenuItem.Icon>
                                <Path Style="{StaticResource LucideIcon}" Data="{StaticResource IconTrash2}"
                                      Width="13" Height="13" Stroke="{DynamicResource DangerBrush}"/>
                            </MenuItem.Icon>
                        </MenuItem>
                    </ContextMenu>
                </Border.ContextMenu>
                <!-- 1.5px 보더의 가로 위치는 보정하고, 세로 여백은 기존 대비 약 20% 큰 행 높이로 확장. -->
                <Grid Margin="8.5,6,8.5,6">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <!-- 잠금 아이콘(에이전트 아이콘 왼쪽) + 세션 아이콘 -->
                    <CheckBox Grid.Column="0" Width="14" Height="14" Margin="0,0,8,0"
                              VerticalAlignment="Center" Tag="14"
                              Style="{StaticResource ModernCheckBox}"
                              IsChecked="{Binding IsMultiSelected, Mode=TwoWay}"
                              Click="SessionMultiSelect_Click"
                              Visibility="{Binding IsMultiSelectMode, Converter={x:Static models:BoolToVisibilityConverter.Instance}}"/>
                    <StackPanel Grid.Column="1" Orientation="Horizontal" Margin="0,0,8,0" VerticalAlignment="Center">
                        <Path Style="{StaticResource LucideIcon}" Data="{StaticResource IconLock}"
                              Width="14" Height="14" Margin="0,0,8,0" VerticalAlignment="Center"
                              Visibility="{Binding IsLocked, Converter={x:Static models:BoolToVisibilityConverter.Instance}}"
                              Stroke="{DynamicResource TextMutedBrush}"/>
                        <Image Width="14" Height="14" VerticalAlignment="Center"
                               Source="{Binding AgentId, Converter={x:Static models:AgentImageConverter.Instance}}"
                               RenderOptions.BitmapScalingMode="HighQuality">
                            <Image.Style>
                                <Style TargetType="Image">
                                    <Setter Property="RenderTransform">
                                        <Setter.Value>
                                            <TranslateTransform Y="0"/>
                                        </Setter.Value>
                                    </Setter>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding AgentId}" Value="gajae">
                                            <Setter Property="RenderTransform">
                                                <Setter.Value>
                                                    <TranslateTransform Y="-2"/>
                                                </Setter.Value>
                                            </Setter>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Image.Style>
                        </Image>
                    </StackPanel>
                    <!-- 상태 점(평소) ↔ 회전 스피너(요청 처리중). 탭 X 로 숨긴 세션은 추적중지 아이콘. -->
                    <Grid Grid.Column="2" Width="12" Height="12" VerticalAlignment="Center">
                        <Ellipse x:Name="StatusDot" Style="{StaticResource SessionDot}"/>
                        <Ellipse x:Name="BusySpinner" Width="12" Height="12" Visibility="Collapsed"
                                 models:SpinnerActivator.Track="True"
                                 Stroke="{DynamicResource PrimaryBrush}" StrokeThickness="1.6"
                                 StrokeDashArray="15 100" StrokeDashCap="Round"
                                 RenderTransformOrigin="0.5,0.5">
                            <Ellipse.RenderTransform>
                                <RotateTransform Angle="{Binding Angle, Source={x:Static models:SpinnerSync.Instance}}"/>
                            </Ellipse.RenderTransform>
                        </Ellipse>
                        <!-- 숨김 세션(탭 X) — 추적중지 아이콘. -->
                        <Path x:Name="HiddenIcon" Visibility="Collapsed"
                              Data="{StaticResource IconEyeOff}"
                              Width="12" Height="12" Stretch="Uniform"
                              Stroke="{DynamicResource TextMutedBrush}" StrokeThickness="1.4"
                              Fill="Transparent" SnapsToDevicePixels="True"/>
                        <!-- 입력 대기(선택지 메뉴) — 스피너 정지 + 느낌표.
                             Margin 으로 12x12 박스 안쪽에 그려 stretch 시 뾰족한 꼭짓점 stroke 가 잘리지 않게. -->
                        <!-- Margin 음수로 12x12 박스를 살짝 넘겨 조금 더 크게(상태 Grid 는 clip 안 함 → 안 잘림). -->
                        <Path x:Name="WaitingIcon" Visibility="Collapsed"
                              Data="{StaticResource IconExclamation}"
                              Margin="-0.5" Stretch="Uniform"
                              HorizontalAlignment="Stretch" VerticalAlignment="Stretch"
                              Stroke="{DynamicResource WarningBrush}" StrokeThickness="2.2"
                              StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                              Fill="Transparent"/>
                    </Grid>
                    <TextBlock Grid.Column="3" Text="{Binding Name}" Margin="10,0,0,0"
                               VerticalAlignment="Center" TextTrimming="CharacterEllipsis"
                               FontSize="{DynamicResource Fs12}"
                               Foreground="{DynamicResource TextBrush}"/>
                    <TextBlock Grid.Column="4" Text="{Binding SessionChildCount}"
                               Margin="6,0,0,0" VerticalAlignment="Center"
                               FontSize="{DynamicResource Fs11}"
                               Foreground="{DynamicResource TextMutedBrush}"
                               Visibility="{Binding HasSessionChildren, Converter={x:Static models:BoolToVisibilityConverter.Instance}}"/>
                    <Button Grid.Column="5" Width="18" Height="18" Margin="4,0,0,0"
                            Tag="{Binding}" Click="SessionChevron_Click"
                            Style="{StaticResource IconButton}" Padding="3"
                            Cursor="Arrow" VerticalAlignment="Center"
                            Visibility="{Binding HasSessionChildren, Converter={x:Static models:BoolToVisibilityConverter.Instance}}"
                            ToolTip="자식 세션 접기 / 펼치기">
                        <Path Style="{StaticResource LucideButtonIcon}"
                              Data="{Binding AreSessionChildrenExpanded, Converter={x:Static models:ChevronConverter.Instance}}"
                              Width="11" Height="11" Stretch="Uniform"/>
                    </Button>
                </Grid>
                </Border>
            </Grid>
            </Border>
            <DataTemplate.Triggers>
                <!-- 연결선 열에서 조금 더 떨어뜨려 자식 카드를 총 23px 들여쓴다. -->
                <DataTrigger Binding="{Binding HasSessionParent}" Value="True">
                    <Setter TargetName="SessionRow" Property="Margin" Value="4,2,0,2"/>
                </DataTrigger>
                <!-- 활성(보고 있는) 세션: 배경색 변경으로 구분 -->
                <DataTrigger Binding="{Binding IsActive}" Value="True">
                    <Setter TargetName="SessionRow" Property="Background" Value="{DynamicResource SessionFocusBrush}"/>
                </DataTrigger>
                <!-- 숨김 세션(탭 X): 점/스피너 숨기고 추적중지 아이콘 노출. IsBusy 보다 우선. -->
                <DataTrigger Binding="{Binding IsEffectivelyHidden}" Value="True">
                    <Setter TargetName="StatusDot" Property="Visibility" Value="Collapsed"/>
                    <Setter TargetName="BusySpinner" Property="Visibility" Value="Collapsed"/>
                    <Setter TargetName="HiddenIcon" Property="Visibility" Value="Visible"/>
                </DataTrigger>
                <!-- 상단 그룹에서는 최상위 숨김 트리를 항상 접고, 직접 숨긴 자식은
                     프로젝트의 '숨김 세션 표시' 토글을 끈 경우에만 접는다. -->
                <MultiDataTrigger>
                    <MultiDataTrigger.Conditions>
                        <Condition Binding="{Binding Tag, RelativeSource={RelativeSource FindAncestor, AncestorType=ItemsControl}}" Value="False"/>
                        <Condition Binding="{Binding IsSidebarGloballyHidden}" Value="True"/>
                    </MultiDataTrigger.Conditions>
                    <Setter TargetName="SessionRowLayout" Property="Visibility" Value="Collapsed"/>
                </MultiDataTrigger>
                <MultiDataTrigger>
                    <MultiDataTrigger.Conditions>
                        <Condition Binding="{Binding Tag, RelativeSource={RelativeSource FindAncestor, AncestorType=ItemsControl}}" Value="False"/>
                        <Condition Binding="{Binding HasSessionParent}" Value="True"/>
                        <Condition Binding="{Binding Hidden}" Value="True"/>
                        <Condition Binding="{Binding DataContext.ShowHiddenSessions, RelativeSource={RelativeSource FindAncestor, AncestorType=ItemsControl}}" Value="False"/>
                    </MultiDataTrigger.Conditions>
                    <Setter TargetName="SessionRowLayout" Property="Visibility" Value="Collapsed"/>
                </MultiDataTrigger>
                <!-- 요청 처리중 스피너: 숨김 세션(!Hidden)일 때만 동작. -->
                <MultiDataTrigger>
                    <MultiDataTrigger.Conditions>
                        <Condition Binding="{Binding IsEffectivelyHidden}" Value="False"/>
                        <Condition Binding="{Binding IsBusy}" Value="True"/>
                    </MultiDataTrigger.Conditions>
                    <Setter TargetName="StatusDot" Property="Visibility" Value="Collapsed"/>
                    <Setter TargetName="BusySpinner" Property="Visibility" Value="Visible"/>
                    <Setter TargetName="HiddenIcon" Property="Visibility" Value="Collapsed"/>
                </MultiDataTrigger>
                <!-- 입력 대기(선택지 메뉴): 스피너 정지 + 느낌표. busy 보다 뒤에 둬서 우선 적용. -->
                <MultiDataTrigger>
                    <MultiDataTrigger.Conditions>
                        <Condition Binding="{Binding IsEffectivelyHidden}" Value="False"/>
                        <Condition Binding="{Binding IsWaitingChoice}" Value="True"/>
                    </MultiDataTrigger.Conditions>
                    <Setter TargetName="StatusDot" Property="Visibility" Value="Collapsed"/>
                    <Setter TargetName="BusySpinner" Property="Visibility" Value="Collapsed"/>
                    <Setter TargetName="HiddenIcon" Property="Visibility" Value="Collapsed"/>
                    <Setter TargetName="WaitingIcon" Property="Visibility" Value="Visible"/>
                </MultiDataTrigger>
            </DataTemplate.Triggers>
        </DataTemplate>

        <!-- ── 바로가기 row 템플릿 — 세션 row 와 동일 크기. 셸 아이콘 + 이름. 클릭=실행, 우클릭=제거 ── -->
        <DataTemplate x:Key="ShortcutTemplate" DataType="{x:Type models:ProjectFile}">
            <Border x:Name="ShortcutRow" Style="{StaticResource SessionCard}"
                    MouseLeftButtonUp="ProjectFileRow_Click"
                    PreviewMouseLeftButtonDown="ProjectFileRow_PreviewMouseLeftButtonDown"
                    Cursor="Arrow"
                    ToolTip="{Binding FilePath}">
                <Border.ContextMenu>
                    <ContextMenu>
                        <MenuItem Header="이름 변경" Tag="{Binding}" Click="ProjectFileRename_Click">
                            <MenuItem.Icon>
                                <Path Style="{StaticResource LucideIcon}" Data="{StaticResource IconPencil}"
                                      Width="13" Height="13" Stroke="{DynamicResource TextMutedBrush}"/>
                            </MenuItem.Icon>
                        </MenuItem>
                        <Separator/>
                        <MenuItem Header="바로가기 제거" Tag="{Binding}" Click="ProjectFileRemove_Click"
                                  Foreground="{DynamicResource DangerBrush}">
                            <MenuItem.Icon>
                                <Path Style="{StaticResource LucideIcon}" Data="{StaticResource IconTrash2}"
                                      Width="13" Height="13" Stroke="{DynamicResource DangerBrush}"/>
                            </MenuItem.Icon>
                        </MenuItem>
                    </ContextMenu>
                </Border.ContextMenu>
                <Grid Margin="10,5,10,5">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <Image Grid.Column="0" Width="14" Height="14" Margin="0,0,10,0" VerticalAlignment="Center"
                           Source="{Binding Icon}" RenderOptions.BitmapScalingMode="HighQuality"/>
                    <TextBlock Grid.Column="1" Text="{Binding DisplayName}"
                               VerticalAlignment="Center" TextTrimming="CharacterEllipsis"
                               FontSize="{DynamicResource Fs12}"
                               Foreground="{DynamicResource TextBrush}"/>
                    <!-- 관리자 권한 실행 표식 -->
                    <TextBlock Grid.Column="2" Text="(관리자)" Margin="6,0,0,0" VerticalAlignment="Center"
                               FontSize="{DynamicResource Fs11}"
                               Foreground="{DynamicResource TextMutedBrush}"
                               Visibility="{Binding RunAsAdmin, Converter={x:Static models:BoolToVisibilityConverter.Instance}}"/>
                </Grid>
            </Border>
        </DataTemplate>

        <!-- ── 열린 문서(파일 탭) row 템플릿 — 세션 row 와 동일 크기. 문서 아이콘 + 파일명. 클릭=해당 탭 활성 ── -->
        <DataTemplate x:Key="FileDocTemplate" DataType="{x:Type models:FileTabItem}">
            <Border x:Name="DocRow" Style="{StaticResource SessionCard}"
                    MouseLeftButtonUp="OpenDoc_Click"
                    PreviewMouseLeftButtonDown="SessionRow_PreviewMouseLeftButtonDown"
                    Cursor="Arrow"
                    ToolTip="{Binding FilePath}">
                <Border.ContextMenu>
                    <ContextMenu>
                        <MenuItem Header="파일 경로 복사" Tag="{Binding}" Click="OpenDocCopyPath_Click">
                            <MenuItem.Icon>
                                <Path Style="{StaticResource LucideIcon}" Data="{StaticResource IconCopy}"
                                      Width="11" Height="11" Stroke="{DynamicResource TextMutedBrush}"/>
                            </MenuItem.Icon>
                        </MenuItem>
                        <Separator/>
                        <MenuItem Header="문서 닫기" Tag="{Binding}" Click="OpenDocClose_Click">
                            <MenuItem.Icon>
                                <Path Style="{StaticResource LucideIcon}" Data="{StaticResource IconX}"
                                      Width="11" Height="11" Stroke="{DynamicResource TextMutedBrush}"/>
                            </MenuItem.Icon>
                        </MenuItem>
                    </ContextMenu>
                </Border.ContextMenu>
                <Grid Margin="10,5,10,5">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <Path Grid.Column="0" Style="{StaticResource LucideIcon}" Data="{StaticResource IconFileText}"
                          Width="14" Height="14" Margin="0,0,10,0" VerticalAlignment="Center"
                          Stroke="{DynamicResource TextMutedBrush}"/>
                    <TextBlock Grid.Column="1" Text="{Binding Title}"
                               VerticalAlignment="Center" TextTrimming="CharacterEllipsis"
                               FontSize="{DynamicResource Fs12}"
                               Foreground="{DynamicResource TextBrush}"/>
                </Grid>
            </Border>
            <DataTemplate.Triggers>
                <!-- 활성(보고 있는) 문서: 세션과 동일하게 배경 하이라이트 -->
                <DataTrigger Binding="{Binding IsActive}" Value="True">
                    <Setter TargetName="DocRow" Property="Background" Value="{DynamicResource SessionFocusBrush}"/>
                </DataTrigger>
            </DataTemplate.Triggers>
        </DataTemplate>

        <!-- 중앙 웹 브라우저 탭 — 문서 행과 동일한 크기/선택 표현. -->
        <DataTemplate x:Key="BrowserTabTemplate" DataType="{x:Type models:BrowserTabItem}">
            <Border x:Name="BrowserRow" Style="{StaticResource SessionCard}"
                    MouseLeftButtonUp="BrowserTab_Click"
                    PreviewMouseLeftButtonDown="SessionRow_PreviewMouseLeftButtonDown"
                    Cursor="Arrow">
                <Border.ContextMenu>
                    <ContextMenu>
                        <MenuItem Header="기본 브라우저로 열기" Tag="{Binding}" Click="BrowserTabOpenExternal_Click">
                            <MenuItem.Icon>
                                <Path Style="{StaticResource LucideIcon}" Data="{StaticResource IconExternalLink}"
                                      Width="13" Height="13" Stroke="{DynamicResource TextMutedBrush}"/>
                            </MenuItem.Icon>
                        </MenuItem>
                        <MenuItem Header="현재 URL 복사" Tag="{Binding}" Click="BrowserTabCopyUrl_Click">
                            <MenuItem.Icon>
                                <Path Style="{StaticResource LucideIcon}" Data="{StaticResource IconCopy}"
                                      Width="13" Height="13" Stroke="{DynamicResource TextMutedBrush}"/>
                            </MenuItem.Icon>
                        </MenuItem>
                        <MenuItem Header="이름 변경" Tag="{Binding}" Click="BrowserTabRename_Click">
                            <MenuItem.Icon>
                                <Path Style="{StaticResource LucideIcon}" Data="{StaticResource IconPencil}"
                                      Width="13" Height="13" Stroke="{DynamicResource TextMutedBrush}"/>
                            </MenuItem.Icon>
                        </MenuItem>
                        <Separator/>
                        <MenuItem Header="브라우저 닫기" Tag="{Binding}" Click="BrowserTabClose_Click">
                            <MenuItem.Icon>
                                <Path Style="{StaticResource LucideIcon}" Data="{StaticResource IconX}"
                                      Width="11" Height="11" Stroke="{DynamicResource TextMutedBrush}"/>
                            </MenuItem.Icon>
                        </MenuItem>
                    </ContextMenu>
                </Border.ContextMenu>
                <Grid Margin="10,5,10,5">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <Path Grid.Column="0" Style="{StaticResource LucideIcon}" Data="{StaticResource IconGlobe}"
                          Width="14" Height="14" Margin="0,0,10,0" VerticalAlignment="Center"
                          Stroke="{DynamicResource TextMutedBrush}"/>
                    <TextBlock Grid.Column="1" Text="{Binding Title}"
                               VerticalAlignment="Center" TextTrimming="CharacterEllipsis"
                               FontSize="{DynamicResource Fs12}"
                               Foreground="{DynamicResource TextBrush}"/>
                </Grid>
            </Border>
            <DataTemplate.Triggers>
                <DataTrigger Binding="{Binding IsActive}" Value="True">
                    <Setter TargetName="BrowserRow" Property="Background" Value="{DynamicResource SessionFocusBrush}"/>
                </DataTrigger>
            </DataTemplate.Triggers>
        </DataTemplate>

        <!-- 세션/문서/브라우저 행을 타입별 템플릿으로 렌더(좌/우 그룹 ItemsControl 공유) -->
        <models:TabRowTemplateSelector x:Key="TabRowSelector"
                                       SessionTemplate="{StaticResource SessionTemplate}"
                                       FileTemplate="{StaticResource FileDocTemplate}"
                                       BrowserTemplate="{StaticResource BrowserTabTemplate}"/>

        <!-- ── 프로젝트(상위 항목) 템플릿 — 카드 헤더(아이콘·이름·chevron·⋯) + 세션 row 리스트 ── -->
        <DataTemplate x:Key="ProjectTemplate" DataType="{x:Type models:ProjectItem}">
            <Border x:Name="ProjectCardRoot" Style="{StaticResource ProjectCard}"
                    b:CornerRadiusClip.Radius="10">
                <Border.ContextMenu>
                    <!-- 카드 어디서든 우클릭하면 프로젝트 메뉴가 뜨도록 outer Border로 이동 -->
                    <ContextMenu Opened="ProjectMenu_Opened">
                        <MenuItem Header="세션 추가" Tag="{Binding}" Click="AddSession_Click">
                            <MenuItem.Icon>
                                <Path Style="{StaticResource LucideIcon}" Data="{StaticResource IconPlus}"
                                      Width="13" Height="13" Stroke="{DynamicResource TextMutedBrush}"/>
                            </MenuItem.Icon>
                        </MenuItem>
                        <!-- 바로가기 추가 — 등록된 항목은 메뉴가 아니라 카드 하단 행으로 표시된다. -->
                        <MenuItem Header="바로가기 추가" Tag="{Binding}" Click="AddProjectFile_Click">
                            <MenuItem.Icon>
                                <Path Style="{StaticResource LucideIcon}" Data="{StaticResource IconFilePlus}"
                                      Width="13" Height="13" Stroke="{DynamicResource TextMutedBrush}"/>
                            </MenuItem.Icon>
                        </MenuItem>
                        <MenuItem Header="디렉토리 열기" Tag="{Binding}" Click="OpenProjectDirectory_Click">
                            <MenuItem.Icon>
                                <Path Style="{StaticResource LucideIcon}" Data="{StaticResource IconFolderOpen}"
                                      Width="13" Height="13" Stroke="{DynamicResource TextMutedBrush}"/>
                            </MenuItem.Icon>
                        </MenuItem>
                        <MenuItem Header="Git 저장소 웹에서 열기"
                                  CommandParameter="GitRemote"
                                  IsEnabled="False"
                                  Click="OpenGitRemote_Click">
                            <MenuItem.Icon>
                                <Path Style="{StaticResource LucideIcon}" Data="{StaticResource IconExternalLink}"
                                      Width="13" Height="13" Stroke="{DynamicResource TextMutedBrush}"/>
                            </MenuItem.Icon>
                        </MenuItem>
                        <Separator/>
                        <MenuItem Header="이름 변경" Tag="{Binding}" Click="ProjectRename_Click">
                            <MenuItem.Icon>
                                <Path Style="{StaticResource LucideIcon}" Data="{StaticResource IconPencil}"
                                      Width="13" Height="13" Stroke="{DynamicResource TextMutedBrush}"/>
                            </MenuItem.Icon>
                        </MenuItem>
                        <MenuItem Header="폴더에서 꺼내기" Tag="{Binding}" Click="RemoveProjectFromFolder_Click"
                                  Visibility="{Binding HasProjectFolder, Converter={x:Static models:BoolToVisibilityConverter.Instance}}">
                            <MenuItem.Icon>
                                <Path Style="{StaticResource LucideIcon}" Data="{StaticResource IconFolderOpen}"
                                      Width="13" Height="13" Stroke="{DynamicResource TextMutedBrush}"/>
                            </MenuItem.Icon>
                        </MenuItem>
                        <!-- 폴더 밖 활성 프로젝트: 보관함 이동 / 폴더 밖 보관 프로젝트: 꺼내기 -->
                        <MenuItem Header="보관함 이동" Tag="{Binding}" Click="ArchiveProject_Click"
                                  Visibility="{Binding CanArchive, Converter={x:Static models:BoolToVisibilityConverter.Instance}}">
                            <MenuItem.Icon>
                                <Path Style="{StaticResource LucideIcon}" Data="{StaticResource IconArchive}"
                                      Width="13" Height="13" Stroke="{DynamicResource TextMutedBrush}"/>
                            </MenuItem.Icon>
                        </MenuItem>
                        <MenuItem Header="꺼내기" Tag="{Binding}" Click="UnarchiveProject_Click"
                                  Visibility="{Binding CanUnarchive, Converter={x:Static models:BoolToVisibilityConverter.Instance}}">
                            <MenuItem.Icon>
                                <Path Style="{StaticResource LucideIcon}" Data="{StaticResource IconArchiveRestore}"
                                      Width="13" Height="13" Stroke="{DynamicResource TextMutedBrush}"/>
                            </MenuItem.Icon>
                        </MenuItem>
                        <Separator/>
                        <MenuItem Header="세션 관리" Tag="{Binding}" Click="SessionManager_Click">
                            <MenuItem.Icon>
                                <Path Style="{StaticResource LucideIcon}" Data="{StaticResource IconListChecks}"
                                      Width="13" Height="13" Stroke="{DynamicResource TextMutedBrush}"/>
                            </MenuItem.Icon>
                        </MenuItem>
                        <MenuItem Header="프로젝트 제거" Tag="{Binding}" Click="ProjectDelete_Click" Foreground="{DynamicResource DangerBrush}">
                            <MenuItem.Icon>
                                <Path Style="{StaticResource LucideIcon}" Data="{StaticResource IconTrash2}"
                                      Width="13" Height="13" Stroke="{DynamicResource DangerBrush}"/>
                            </MenuItem.Icon>
                        </MenuItem>
                    </ContextMenu>
                </Border.ContextMenu>
                <StackPanel>
                    <!-- 프로젝트 헤더 행 -->
                    <Border x:Name="ProjectHeaderRow" Background="Transparent" Cursor="Arrow"
                            MouseLeftButtonUp="Project_Click"
                            PreviewMouseLeftButtonDown="ProjectRow_PreviewMouseLeftButtonDown">
                        <Grid Margin="12,11,8,9">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <!-- 프로젝트 명 (1행, 좌측). 우상단 버튼과 같은 줄에 떠 잘리지 않음.
                                 접힘 상태에서 내부 세션이 요청 처리중이면 이름 왼쪽에 회전 스피너 노출. -->
                            <StackPanel Grid.Row="0" Grid.Column="0" Orientation="Horizontal">
                                <Ellipse x:Name="ProjectBusySpinner" Width="12" Height="12"
                                         Margin="0,0,7,0" VerticalAlignment="Center"
                                         Visibility="Collapsed"
                                         models:SpinnerActivator.Track="True"
                                         Stroke="{DynamicResource PrimaryBrush}" StrokeThickness="1.6"
                                         StrokeDashArray="15 100" StrokeDashCap="Round"
                                         RenderTransformOrigin="0.5,0.5">
                                    <Ellipse.RenderTransform>
                                        <RotateTransform Angle="{Binding Angle, Source={x:Static models:SpinnerSync.Instance}}"/>
                                    </Ellipse.RenderTransform>
                                </Ellipse>
                                <TextBlock Text="{Binding Name}"
                                           TextTrimming="CharacterEllipsis"
                                           VerticalAlignment="Center"
                                           FontSize="{DynamicResource Fs14}" FontWeight="SemiBold"
                                           Foreground="{DynamicResource TextBrush}">
                                    <TextBlock.RenderTransform>
                                        <TranslateTransform Y="1"/>
                                    </TextBlock.RenderTransform>
                                </TextBlock>
                            </StackPanel>
                            <!-- 우상단 액션: [chevron 등]. (분할은 이제 프로젝트 단위 토글로 관리 — 카드 패널 배지 제거) -->
                            <StackPanel Grid.Row="0" Grid.Column="1" Orientation="Horizontal"
                                        VerticalAlignment="Center" Margin="4,-4,0,0">
                            <!-- 숨김 세션 보기/숨기기 토글 -->
                            <Button Tag="{Binding}"
                                    Click="HiddenToggle_Click" Cursor="Arrow"
                                    Background="Transparent" BorderThickness="0"
                                    IsTabStop="False" FocusVisualStyle="{x:Null}"
                                    VerticalAlignment="Center" Margin="0,0,2,0">
                                <Button.Style>
                                    <Style TargetType="Button">
                                        <Setter Property="ToolTip" Value="숨김 세션 표시"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding ShowHiddenSessions}" Value="True">
                                                <Setter Property="ToolTip" Value="숨김 세션 숨기기"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Button.Style>
                                <Button.Template>
                                    <ControlTemplate TargetType="Button">
                                        <Border x:Name="Bd" Width="18" Height="18" CornerRadius="4"
                                                Background="{TemplateBinding Background}">
                                            <Path x:Name="Icon"
                                                  Style="{StaticResource LucideButtonIcon}"
                                                  Data="{StaticResource IconEyeOff}"
                                                  Width="11" Height="11"
                                                  HorizontalAlignment="Center" VerticalAlignment="Center"
                                                  Stretch="Uniform"
                                                  Stroke="{DynamicResource TextMutedBrush}"/>
                                        </Border>
                                        <ControlTemplate.Triggers>
                                            <Trigger Property="IsMouseOver" Value="True">
                                                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource LineBrush}"/>
                                            </Trigger>
                                            <DataTrigger Binding="{Binding ShowHiddenSessions}" Value="True">
                                                <Setter TargetName="Icon" Property="Data" Value="{StaticResource IconEye}"/>
                                            </DataTrigger>
                                        </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                </Button.Template>
                            </Button>
                            <!-- 접고/펴기는 이 chevron 버튼으로만 (행 클릭은 선택 전용). 항상 노출, 타이틀과 같은 줄 우상단. -->
                            <Button Tag="{Binding}"
                                    Click="ProjectChevron_Click" Cursor="Arrow"
                                    Background="Transparent" BorderThickness="0"
                                    IsTabStop="False" FocusVisualStyle="{x:Null}"
                                    VerticalAlignment="Center"
                                    ToolTip="펼치기 / 접기">
                                <Button.Template>
                                    <ControlTemplate TargetType="Button">
                                        <Border x:Name="Bd" Width="18" Height="18" CornerRadius="4"
                                                Background="{TemplateBinding Background}">
                                            <!-- 18×18 보더 안에서 11×11 아이콘이 정확히 중앙 (3.5, 3.5) ~ (14.5, 14.5) 에 배치 -->
                                            <Path Style="{StaticResource LucideButtonIcon}"
                                                  Data="{Binding IsExpanded, Converter={x:Static models:ChevronConverter.Instance}}"
                                                  Width="11" Height="11"
                                                  HorizontalAlignment="Center" VerticalAlignment="Center"
                                                  Stretch="Uniform"
                                                  Stroke="{DynamicResource TextMutedBrush}"/>
                                        </Border>
                                        <ControlTemplate.Triggers>
                                            <Trigger Property="IsMouseOver" Value="True">
                                                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource LineBrush}"/>
                                            </Trigger>
                                        </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                </Button.Template>
                            </Button>
                            </StackPanel>
                            <!-- 경로 (2행, 전체 폭). 버튼이 1행으로 빠졌으므로 잘림 없이 표시. -->
                            <TextBlock Grid.Row="1" Grid.Column="0" Grid.ColumnSpan="2"
                                       Text="{Binding Path}" Margin="0,1,0,0"
                                       TextTrimming="CharacterEllipsis"
                                       FontSize="{DynamicResource Fs11}"
                                       Foreground="{DynamicResource TextMutedBrush}"
                                       ToolTip="{Binding Path}">
                                <TextBlock.RenderTransform>
                                    <TranslateTransform Y="1"/>
                                </TextBlock.RenderTransform>
                            </TextBlock>
                        </Grid>
                    </Border>
                    <!-- 세션 리스트 + 바로가기 리스트: 펼침 시 표시. 가이드선/연결됨 텍스트 없음 -->
                    <Border Visibility="Collapsed"
                            b:TreeExpander.IsExpanded="{Binding IsExpanded}">
                        <Grid Margin="8,2,8,8">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>
                            <!-- 프로젝트 경로와 첫 세션 사이에서 높이 0↔37로 펼쳐지는 카드 내부 검색창. -->
                            <Border x:Name="ProjectSessionSearchRow" Grid.Row="0"
                                    ClipToBounds="True">
                                <Border.Style>
                                    <Style TargetType="Border">
                                        <Setter Property="Height" Value="0"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsSessionSearchOpen}" Value="True">
                                                <Setter Property="Height" Value="37"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Border.Style>
                                <Border Height="31" Margin="0,2,0,4"
                                        Background="{DynamicResource PanelSoftBrush}"
                                        BorderBrush="{DynamicResource LineBrush}"
                                        BorderThickness="1" CornerRadius="8">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <Path Grid.Column="0" Style="{StaticResource LucideIcon}"
                                              Data="{StaticResource IconSearch}"
                                              Stroke="{DynamicResource TextMutedBrush}"
                                              Width="12" Height="12" Margin="9,0,0,0"
                                              VerticalAlignment="Center"/>
                                        <Grid Grid.Column="1">
                                            <TextBox x:Name="ProjectSessionSearchBox"
                                                     Text="{Binding SessionSearchQuery, UpdateSourceTrigger=PropertyChanged}"
                                                     Margin="6,0,0,0" Padding="0"
                                                     VerticalContentAlignment="Center"
                                                     Background="Transparent" BorderThickness="0"
                                                     FocusVisualStyle="{x:Null}"
                                                     Foreground="{DynamicResource TextBrush}"
                                                     CaretBrush="{DynamicResource TextBrush}"
                                                     FontSize="{DynamicResource Fs12}"
                                                     FontFamily="{StaticResource PretendardFont}">
                                                <TextBox.Resources>
                                                    <Style TargetType="Border"><Setter Property="CornerRadius" Value="0"/></Style>
                                                </TextBox.Resources>
                                            </TextBox>
                                            <TextBlock Text="세션 검색"
                                                       IsHitTestVisible="False"
                                                       Margin="6,0,0,0" Padding="0"
                                                       VerticalAlignment="Center"
                                                       Foreground="{DynamicResource TextMutedBrush}"
                                                       FontSize="{DynamicResource Fs12}"
                                                       FontFamily="{StaticResource PretendardFont}">
                                                <TextBlock.Style>
                                                    <Style TargetType="TextBlock" BasedOn="{StaticResource {x:Type TextBlock}}">
                                                        <Setter Property="Visibility" Value="Collapsed"/>
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding Text, ElementName=ProjectSessionSearchBox}" Value="">
                                                                <Setter Property="Visibility" Value="Visible"/>
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </TextBlock.Style>
                                            </TextBlock>
                                        </Grid>
                                        <Button Grid.Column="2" Width="18" Height="18" Margin="0,0,7,0"
                                                VerticalAlignment="Center"
                                                Click="ProjectSessionSearchClear_Click" Cursor="Arrow"
                                                Background="Transparent" BorderThickness="0"
                                                IsTabStop="False" FocusVisualStyle="{x:Null}"
                                                ToolTip="지우기"
                                                Visibility="{Binding HasSessionSearchQuery, Converter={x:Static models:BoolToVisibilityConverter.Instance}}">
                                            <Button.Template>
                                                <ControlTemplate TargetType="Button">
                                                    <Border x:Name="Bd" Width="18" Height="18" CornerRadius="4"
                                                            Background="{TemplateBinding Background}">
                                                        <Path Style="{StaticResource LucideButtonIcon}"
                                                              Data="{StaticResource IconX}"
                                                              Width="10" Height="10"
                                                              HorizontalAlignment="Center" VerticalAlignment="Center"
                                                              Stretch="Uniform"
                                                              Stroke="{DynamicResource TextMutedBrush}"/>
                                                    </Border>
                                                    <ControlTemplate.Triggers>
                                                        <Trigger Property="IsMouseOver" Value="True">
                                                            <Setter TargetName="Bd" Property="Background" Value="{DynamicResource LineBrush}"/>
                                                        </Trigger>
                                                    </ControlTemplate.Triggers>
                                                </ControlTemplate>
                                            </Button.Template>
                                        </Button>
                                    </Grid>
                                </Border>
                            </Border>
                            <!-- 숨김 세션은 일반 세션 목록 아래에 항상 고정한다. -->
                            <Border Grid.Row="4"
                                    Visibility="Collapsed"
                                    b:TreeExpander.IsExpanded="{Binding ShowHiddenGroup}">
                                <Grid>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                    </Grid.RowDefinitions>
                                    <Border Grid.Row="0"
                                            Height="1" Margin="2,6,2,6"
                                            Background="{DynamicResource LineBrush}">
                                    </Border>
                                    <!-- 숨김 세션 10개 초과 시 그룹만 독립 스크롤(정확히 10행 높이 = 코드비하인드 계산) + 상하 페이드(완료기록 영역과 동일 방식). -->
                                    <Grid Grid.Row="1">
                                        <ScrollViewer VerticalScrollBarVisibility="Auto"
                                                      HorizontalScrollBarVisibility="Disabled"
                                                      Loaded="HiddenScroll_Loaded"
                                                      ScrollChanged="HiddenScroll_ScrollChanged">
                                            <ItemsControl ItemsSource="{Binding HiddenSessions}" Tag="True"
                                                          ItemTemplate="{StaticResource SessionTemplate}"/>
                                        </ScrollViewer>
                                        <Rectangle Height="24" VerticalAlignment="Top" IsHitTestVisible="False"
                                                   Panel.ZIndex="1" Visibility="Collapsed" Fill="{DynamicResource PanelBrush}">
                                            <Rectangle.OpacityMask>
                                                <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                                                    <GradientStop Offset="0" Color="Black"/>
                                                    <GradientStop Offset="0.7" Color="Transparent"/>
                                                </LinearGradientBrush>
                                            </Rectangle.OpacityMask>
                                        </Rectangle>
                                        <Rectangle Height="24" VerticalAlignment="Bottom" IsHitTestVisible="False"
                                                   Panel.ZIndex="1" Visibility="Collapsed" Fill="{DynamicResource PanelBrush}">
                                            <Rectangle.OpacityMask>
                                                <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                                                    <GradientStop Offset="0.3" Color="Transparent"/>
                                                    <GradientStop Offset="1" Color="Black"/>
                                                </LinearGradientBrush>
                                            </Rectangle.OpacityMask>
                                        </Rectangle>
                                    </Grid>
                                </Grid>
                            </Border>
                            <!-- 상단 그룹: 비분할=전체 탭, 분할=좌측 패널 탭(세션+열린 문서).
                                 Tag="False" 고정 → 숨김(Hidden) 세션은 이 그룹에서 항상 접히고
                                 별도 '숨김 세션' 그룹으로만 모인다. -->
                            <ItemsControl Grid.Row="1" ItemsSource="{Binding LeftItems}" Tag="False"
                                          ItemTemplateSelector="{StaticResource TabRowSelector}"/>
                            <!-- 분할 시 우측 그룹: 세퍼레이터로만 구분(라벨 없음) -->
                            <Border Grid.Row="2" Height="1" Margin="2,6,2,6"
                                    Background="{DynamicResource LineBrush}"
                                    Visibility="{Binding HasRightItems, Converter={x:Static models:BoolToVisibilityConverter.Instance}}"/>
                            <ItemsControl Grid.Row="3" ItemsSource="{Binding RightItems}" Tag="False"
                                          ItemTemplateSelector="{StaticResource TabRowSelector}"/>
                            <!-- 바로가기: 세션과 세퍼레이터로 구분, 등록된 게 있을 때만 표시 -->
                            <Border Grid.Row="5" Height="1" Margin="2,6,2,6"
                                    Background="{DynamicResource LineBrush}"
                                    Visibility="{Binding HasFiles, Converter={x:Static models:BoolToVisibilityConverter.Instance}}"/>
                            <ItemsControl Grid.Row="6" ItemsSource="{Binding Files}"
                                          ItemTemplate="{StaticResource ShortcutTemplate}"/>
                        </Grid>
                    </Border>
                </StackPanel>
            </Border>
            <DataTemplate.Triggers>
                <!-- 접힘 + 내부 세션 요청 처리중 → 프로젝트명 왼쪽 스피너 노출. -->
                <MultiDataTrigger>
                    <MultiDataTrigger.Conditions>
                        <Condition Binding="{Binding IsExpanded}" Value="False"/>
                        <Condition Binding="{Binding HasBusySession}" Value="True"/>
                    </MultiDataTrigger.Conditions>
                    <Setter TargetName="ProjectBusySpinner" Property="Visibility" Value="Visible"/>
                </MultiDataTrigger>
                <!-- 프로젝트 카드 호버: 활성/보관함 모두 같은 보더색 변경 -->
                <MultiDataTrigger>
                    <MultiDataTrigger.Conditions>
                        <Condition Binding="{Binding IsSelected}" Value="False"/>
                        <Condition Binding="{Binding IsMouseOver, ElementName=ProjectCardRoot}" Value="True"/>
                    </MultiDataTrigger.Conditions>
                    <Setter TargetName="ProjectCardRoot" Property="BorderBrush" Value="{DynamicResource ProjectCardHoverBorderBrush}"/>
                </MultiDataTrigger>
                <MultiDataTrigger>
                    <MultiDataTrigger.Conditions>
                        <Condition Binding="{Binding IsSelected}" Value="False"/>
                        <Condition Binding="{Binding ContextMenu.IsOpen, ElementName=ProjectCardRoot}" Value="True"/>
                    </MultiDataTrigger.Conditions>
                    <Setter TargetName="ProjectCardRoot" Property="BorderBrush" Value="{DynamicResource ProjectCardHoverBorderBrush}"/>
                </MultiDataTrigger>
            </DataTemplate.Triggers>
        </DataTemplate>
        <Style x:Key="ProjectFolderCard" TargetType="Border">
            <Setter Property="Margin" Value="0,3,0,10"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderBrush" Value="{DynamicResource LineBrush}"/>
            <Setter Property="BorderThickness" Value="1.5"/>
            <Setter Property="CornerRadius" Value="9"/>
            <Setter Property="SnapsToDevicePixels" Value="False"/>
            <Setter Property="UseLayoutRounding" Value="False"/>
            <Setter Property="RenderOptions.EdgeMode" Value="Unspecified"/>
        </Style>

        <!-- 논리 폴더 — 헤더에 프로젝트 카드를 드롭하면 소속이 바뀌고, 내부 카드는 기존 프로젝트 템플릿을 그대로 사용한다. -->
        <DataTemplate x:Key="ProjectFolderTemplate" DataType="{x:Type models:ProjectFolderItem}">
            <Border x:Name="FolderRoot"
                    Style="{StaticResource ProjectFolderCard}"
                    Visibility="{Binding IsSearchVisible, Converter={x:Static models:BoolToVisibilityConverter.Instance}}">
                <StackPanel>
                    <Border x:Name="FolderHeader"
                            Background="{DynamicResource PanelSoftBrush}"
                            BorderThickness="0"
                            CornerRadius="8" Cursor="Arrow"
                            ToolTip="클릭하여 펼치기 / 접기"
                            PreviewMouseLeftButtonDown="FolderHeader_PreviewMouseLeftButtonDown"
                            MouseLeftButtonUp="FolderHeader_Click">
                        <Border.ContextMenu>
                            <ContextMenu>
                                <MenuItem Header="이름 변경" Tag="{Binding}" Click="FolderRename_Click">
                                    <MenuItem.Icon>
                                        <Path Style="{StaticResource LucideIcon}" Data="{StaticResource IconPencil}"
                                              Width="13" Height="13" Stroke="{DynamicResource TextMutedBrush}"/>
                                    </MenuItem.Icon>
                                </MenuItem>
                                <MenuItem Header="아이콘 바꾸기" Tag="{Binding}" Click="FolderIconChange_Click">
                                    <MenuItem.Icon>
                                        <Path Style="{StaticResource LucideIcon}" Data="{StaticResource IconPalette}"
                                              Width="13" Height="13" Stroke="{DynamicResource TextMutedBrush}"/>
                                    </MenuItem.Icon>
                                </MenuItem>
                                <MenuItem Header="보관함 이동" Tag="{Binding}" Click="FolderArchive_Click"
                                          Visibility="{Binding IsActive, Converter={x:Static models:BoolToVisibilityConverter.Instance}}">
                                    <MenuItem.Icon>
                                        <Path Style="{StaticResource LucideIcon}" Data="{StaticResource IconArchive}"
                                              Width="13" Height="13" Stroke="{DynamicResource TextMutedBrush}"/>
                                    </MenuItem.Icon>
                                </MenuItem>
                                <MenuItem Header="꺼내기" Tag="{Binding}" Click="FolderUnarchive_Click"
                                          Visibility="{Binding IsArchived, Converter={x:Static models:BoolToVisibilityConverter.Instance}}">
                                    <MenuItem.Icon>
                                        <Path Style="{StaticResource LucideIcon}" Data="{StaticResource IconArchiveRestore}"
                                              Width="13" Height="13" Stroke="{DynamicResource TextMutedBrush}"/>
                                    </MenuItem.Icon>
                                </MenuItem>
                                <Separator/>
                                <MenuItem Header="폴더 제거" Tag="{Binding}" Click="FolderDelete_Click"
                                          Foreground="{DynamicResource DangerBrush}">
                                    <MenuItem.Icon>
                                        <Path Style="{StaticResource LucideIcon}" Data="{StaticResource IconTrash2}"
                                              Width="13" Height="13" Stroke="{DynamicResource DangerBrush}"/>
                                    </MenuItem.Icon>
                                </MenuItem>
                            </ContextMenu>
                        </Border.ContextMenu>
                        <Grid Margin="11,8,8,8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <Grid Grid.Column="0" Width="15" Height="15"
                                  Margin="0,0,8,0" VerticalAlignment="Center">
                                <Path x:Name="FolderIcon"
                                      Style="{StaticResource LucideIcon}"
                                      Data="{Binding IconGeometry}"
                                      Width="15" Height="15"
                                      Stroke="{DynamicResource TextMutedBrush}"/>
                                <Ellipse x:Name="FolderBusySpinner"
                                         Width="14" Height="14" Visibility="Collapsed"
                                         models:SpinnerActivator.Track="True"
                                         Stroke="{DynamicResource PrimaryBrush}"
                                         StrokeThickness="1.6"
                                         StrokeDashArray="15 100"
                                         StrokeDashCap="Round"
                                         RenderTransformOrigin="0.5,0.5">
                                    <Ellipse.RenderTransform>
                                        <RotateTransform Angle="{Binding Angle, Source={x:Static models:SpinnerSync.Instance}}"/>
                                    </Ellipse.RenderTransform>
                                </Ellipse>
                            </Grid>
                            <TextBlock Grid.Column="1" Text="{Binding Name}"
                                       VerticalAlignment="Center" TextTrimming="CharacterEllipsis"
                                       FontSize="{DynamicResource Fs13}" FontWeight="SemiBold"
                                       Foreground="{DynamicResource TextBrush}"/>
                            <TextBlock Grid.Column="2" Text="{Binding ProjectCountText}" Margin="8,0,6,0" VerticalAlignment="Center"
                                       FontSize="{DynamicResource Fs11}"
                                       Foreground="{DynamicResource TextMutedBrush}"/>
                            <!-- 폴더 내부 목록 1열/2열 전환. 전역 "프로젝트 목록 열 수"가 2일 때만 노출. -->
                            <Button Grid.Column="3" Tag="{Binding}"
                                    Click="FolderColumnToggle_Click" Cursor="Arrow"
                                    Background="Transparent" BorderThickness="0"
                                    IsTabStop="False" FocusVisualStyle="{x:Null}"
                                    VerticalAlignment="Center" Margin="0,0,2,0"
                                    ToolTip="폴더 목록 1열 / 2열 전환"
                                    Visibility="{Binding ColumnToggleAvailable, Converter={x:Static models:BoolToVisibilityConverter.Instance}}">
                                <Button.Template>
                                    <ControlTemplate TargetType="Button">
                                        <Border x:Name="Bd" Width="18" Height="18" CornerRadius="4"
                                                Background="{TemplateBinding Background}">
                                            <Path Style="{StaticResource LucideButtonIcon}"
                                                  Data="{StaticResource IconMoveDiagonal}"
                                                  Width="10" Height="10"
                                                  HorizontalAlignment="Center" VerticalAlignment="Center"
                                                  Stretch="Uniform"
                                                  Stroke="{DynamicResource TextMutedBrush}"/>
                                        </Border>
                                        <ControlTemplate.Triggers>
                                            <Trigger Property="IsMouseOver" Value="True">
                                                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource LineBrush}"/>
                                            </Trigger>
                                        </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                </Button.Template>
                            </Button>
                            <Button Grid.Column="4" Tag="{Binding}"
                                    Click="FolderChevron_Click" Cursor="Arrow"
                                    Background="Transparent" BorderThickness="0"
                                    IsTabStop="False" FocusVisualStyle="{x:Null}"
                                    VerticalAlignment="Center"
                                    ToolTip="펼치기 / 접기">
                                <Button.Template>
                                    <ControlTemplate TargetType="Button">
                                        <Border x:Name="Bd" Width="18" Height="18" CornerRadius="4"
                                                Background="{TemplateBinding Background}">
                                            <Path Style="{StaticResource LucideButtonIcon}"
                                                  Data="{Binding IsExpanded, Converter={x:Static models:ChevronConverter.Instance}}"
                                                  Width="11" Height="11"
                                                  HorizontalAlignment="Center" VerticalAlignment="Center"
                                                  Stretch="Uniform"
                                                  Stroke="{DynamicResource TextMutedBrush}"/>
                                        </Border>
                                        <ControlTemplate.Triggers>
                                            <Trigger Property="IsMouseOver" Value="True">
                                                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource LineBrush}"/>
                                            </Trigger>
                                        </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                </Button.Template>
                            </Button>
                        </Grid>
                    </Border>
                    <Border Visibility="Collapsed"
                            b:TreeExpander.IsExpanded="{Binding IsExpanded}">
                        <ItemsControl ItemsSource="{Binding Projects}"
                                      Tag="{Binding EffectiveColumns}"
                                      ItemTemplate="{StaticResource ProjectTemplate}"
                                      ItemsPanel="{StaticResource ProjectsPanel}"
                                      Margin="8,5,8,5">
                            <ItemsControl.Resources>
                                <Thickness x:Key="ProjectCardOuterMargin">0,3,0,3</Thickness>
                            </ItemsControl.Resources>
                        </ItemsControl>
                    </Border>
                </StackPanel>
            </Border>
            <DataTemplate.Triggers>
                <!-- 접힌 상태는 투명 보더, 펼치면 같은 행 외곽선이 자식 영역까지 이어진다. -->
                <MultiDataTrigger>
                    <MultiDataTrigger.Conditions>
                        <Condition Binding="{Binding IsExpanded}" Value="False"/>
                        <Condition Binding="{Binding HasBusySession}" Value="True"/>
                    </MultiDataTrigger.Conditions>
                    <Setter TargetName="FolderIcon" Property="Visibility" Value="Collapsed"/>
                    <Setter TargetName="FolderBusySpinner" Property="Visibility" Value="Visible"/>
                </MultiDataTrigger>

                <DataTrigger Binding="{Binding IsExpanded}" Value="True">
                    <Setter TargetName="FolderRoot" Property="BorderBrush" Value="{DynamicResource LineBrush}"/>
                    <Setter TargetName="FolderHeader" Property="CornerRadius" Value="8,8,0,0"/>
                </DataTrigger>
                <Trigger SourceName="FolderHeader" Property="IsMouseOver" Value="True">
                    <Setter TargetName="FolderRoot" Property="BorderBrush"
                            Value="{DynamicResource ProjectCardHoverBorderBrush}"/>
                </Trigger>
                <DataTrigger Binding="{Binding ContextMenu.IsOpen, ElementName=FolderHeader}" Value="True">
                    <Setter TargetName="FolderRoot" Property="BorderBrush"
                            Value="{DynamicResource ProjectCardHoverBorderBrush}"/>
                </DataTrigger>
                <MultiDataTrigger>
                    <MultiDataTrigger.Conditions>
                        <Condition Binding="{Binding IsExpanded}" Value="False"/>
                        <Condition Binding="{Binding HasSelectedProject}" Value="True"/>
                    </MultiDataTrigger.Conditions>
                    <Setter TargetName="FolderRoot" Property="BorderBrush" Value="{DynamicResource PrimaryBrush}"/>
                </MultiDataTrigger>
            </DataTemplate.Triggers>
        </DataTemplate>

        <local:ProjectRootTemplateSelector x:Key="ProjectRootRowSelector"
                                           FolderTemplate="{StaticResource ProjectFolderTemplate}"
                                           ProjectTemplate="{StaticResource ProjectTemplate}"/>

    </UserControl.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Header (라벨 + 돋보기 + 모두 펼치기/접기) — devez 정합. 높이 35: 중앙 MetaBar·우측 뷰토글과 상단 세퍼레이터 일치 -->
        <Border Grid.Row="0" Height="37"
                BorderBrush="{DynamicResource LineBrush}" BorderThickness="0,0,0,1">
            <Grid Margin="16,0,12,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                    <!-- 뒤로가기: 보관함 보기일 때만 노출 → 프로젝트 보기로 복귀 -->
                    <!-- 음수 좌마진(-5.5): IconButton Padding4 + 글리프 중앙정렬 inset 만큼 당겨 화살표 시작 x를 "프로젝트" 타이틀 시작 x(좌단 16)와 정렬 -->
                    <Button x:Name="BackBtn" Width="24" Height="24" Margin="-5.5,0,4,0"
                            Visibility="Collapsed"
                            Style="{StaticResource IconButton}"
                            Click="ArchiveBack_Click" ToolTip="프로젝트로 돌아가기">
                        <Path Style="{StaticResource LucideButtonIcon}"
                              Data="{StaticResource IconArrowLeft}"
                              Width="13" Height="13"/>
                    </Button>
                    <TextBlock x:Name="HeaderTitle" Text="프로젝트" VerticalAlignment="Center"
                               FontSize="{DynamicResource Fs13}" FontWeight="SemiBold"
                               Foreground="{DynamicResource TextBrush}"/>
                    <TextBlock x:Name="SelectionCountText" Visibility="Collapsed" VerticalAlignment="Center"
                               FontSize="{DynamicResource Fs13}" FontWeight="SemiBold"
                               Foreground="{DynamicResource PrimaryBrush}"/>
                </StackPanel>
                <!-- 보관함 열기: 프로젝트 보기에서 보관함으로 슬라이드 전환 -->
                <Button x:Name="ArchiveToggleBtn" Grid.Column="1"
                        Width="24" Height="24" Margin="0,0,4,0"
                        Style="{StaticResource IconButton}"
                        Click="ArchiveToggleBtn_Click"
                        ToolTip="보관함">
                    <Path Style="{StaticResource LucideButtonIcon}"
                          Data="{StaticResource IconArchive}"
                          Width="13" Height="13"/>
                </Button>
                <!-- 돋보기: 클릭 시 아래 행(SearchRow) 의 Height 를 0→43 으로 애니메이션하며 펼침 -->
                <Button x:Name="SearchToggleBtn" Grid.Column="2"
                        Width="24" Height="24" Margin="0,0,4,0"
                        Style="{StaticResource IconButton}"
                        Click="SearchToggleBtn_Click"
                        ToolTip="검색">
                    <Path x:Name="SearchToggleIcon"
                          Style="{StaticResource LucideButtonIcon}"
                          Data="{StaticResource IconSearch}"
                          Width="12" Height="12"/>
                </Button>
                <Button x:Name="ToggleExpandAllBtn" Grid.Column="3"
                        Width="24" Height="24"
                        Style="{StaticResource IconButton}"
                        Click="ToggleExpandAll_Click"
                        ToolTip="모두 펼치기">
                    <Grid Width="12" Height="12">
                        <Path x:Name="ToggleExpandAllIcon"
                              Style="{StaticResource LucideButtonIcon}"
                              Data="{StaticResource IconChevronRight}"
                              Width="11" Height="11"
                              RenderTransformOrigin="0.5,0.5">
                            <Path.RenderTransform>
                                <RotateTransform Angle="90"/>
                            </Path.RenderTransform>
                        </Path>
                    </Grid>
                </Button>
            </Grid>
        </Border>

        <!-- Search row — 기본 숨김(Height=0). SearchToggleBtn 클릭 시 Height 0→51 으로 애니메이션하며
             프로젝트 카드를 아래로 밀어냄. ClipToBounds 로 닫힐 때 내부 pill 이 넘쳐 보이지 않게 클립. -->
        <Border x:Name="SearchRow" Grid.Row="1" Height="0"
                ClipToBounds="True">
            <Border Margin="8,8,8,4" Height="35"
                    Background="{DynamicResource PanelSoftBrush}"
                    BorderBrush="{DynamicResource LineBrush}"
                    BorderThickness="1" CornerRadius="8">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <Path Grid.Column="0" Style="{StaticResource LucideIcon}"
                          Data="{StaticResource IconSearch}"
                          Stroke="{DynamicResource TextMutedBrush}"
                          Width="13" Height="13"
                          Margin="10,0,0,0" VerticalAlignment="Center"/>
                    <Grid Grid.Column="1">
                        <TextBox x:Name="SidebarSearchBox"
                                 Margin="6,0,0,0" Padding="0,0,0,0" VerticalContentAlignment="Center"
                                 Background="Transparent" BorderThickness="0"
                                 FocusVisualStyle="{x:Null}"
                                 Foreground="{DynamicResource TextBrush}"
                                 CaretBrush="{DynamicResource TextBrush}"
                                 FontSize="{DynamicResource Fs13}"
                                 FontFamily="{StaticResource PretendardFont}"
                                 TextChanged="SidebarSearchBox_TextChanged">
                            <TextBox.Resources>
                                <Style TargetType="Border"><Setter Property="CornerRadius" Value="0"/></Style>
                            </TextBox.Resources>
                        </TextBox>
                        <TextBlock Text="프로젝트 / 세션 검색"
                                   IsHitTestVisible="False"
                                   Margin="6,0,0,0" Padding="0" VerticalAlignment="Center"
                                   Foreground="{DynamicResource TextMutedBrush}"
                                   FontSize="{DynamicResource Fs13}"
                                   FontFamily="{StaticResource PretendardFont}">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock" BasedOn="{StaticResource {x:Type TextBlock}}">
                                    <Setter Property="Visibility" Value="Collapsed"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding Text, ElementName=SidebarSearchBox}" Value="">
                                            <Setter Property="Visibility" Value="Visible"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>
                    </Grid>
                    <!-- 텍스트 지울 X 버튼: 검색어 있을 때만 노출, 클릭 시 텍스트 비워 필터 해제 -->
                    <Button x:Name="SidebarSearchClearBtn" Grid.Column="2"
                            Width="20" Height="20" Margin="0,0,8,0"
                            VerticalAlignment="Center"
                            Click="SidebarSearchClear_Click" Cursor="Arrow"
                            Background="Transparent" BorderThickness="0"
                            IsTabStop="False" FocusVisualStyle="{x:Null}"
                            ToolTip="지우기">
                        <Button.Template>
                            <ControlTemplate TargetType="Button">
                                <Border x:Name="Bd" Width="20" Height="20" CornerRadius="4"
                                        Background="{TemplateBinding Background}">
                                    <Path Style="{StaticResource LucideButtonIcon}"
                                          Data="{StaticResource IconX}"
                                          Width="11" Height="11"
                                          HorizontalAlignment="Center" VerticalAlignment="Center"
                                          Stretch="Uniform"
                                          Stroke="{DynamicResource TextMutedBrush}"/>
                                </Border>
                                <ControlTemplate.Triggers>
                                    <Trigger Property="IsMouseOver" Value="True">
                                        <Setter TargetName="Bd" Property="Background" Value="{DynamicResource LineBrush}"/>
                                    </Trigger>
                                </ControlTemplate.Triggers>
                            </ControlTemplate>
                        </Button.Template>
                    </Button>
                </Grid>
            </Border>
        </Border>

        <!-- Project tree (활성/보관 슬라이드 전환) + floating FAB -->
        <Grid Grid.Row="2" ClipToBounds="True">
            <!-- 활성 프로젝트 패널 -->
            <Grid x:Name="ActivePanel">
                <Grid.RenderTransform>
                    <TranslateTransform x:Name="ActivePanelTransform" X="0"/>
                </Grid.RenderTransform>
                <ScrollViewer x:Name="ActiveProjectScroll" VerticalScrollBarVisibility="Auto" Padding="8,0,8,0"
                              Style="{StaticResource OverlayVScroll}"
                              ScrollChanged="ProjectScrollChanged">
                    <ItemsControl x:Name="ProjectsHost" Tag="1"
                                  Margin="0,8,0,8"
                                  ItemTemplateSelector="{StaticResource ProjectRootRowSelector}"
                                  ItemsPanel="{StaticResource ProjectsPanel}"/>
                </ScrollViewer>
            </Grid>

            <!-- 보관함 패널 — 동일 ProjectTemplate 사용(선택/세션실행 전부 동일 동작). 우측에 대기하다 슬라이드 인 -->
            <Grid x:Name="ArchivePanel" Visibility="Collapsed"
                  Background="{DynamicResource PanelBrush}">
                <Grid.RenderTransform>
                    <TranslateTransform x:Name="ArchivePanelTransform" X="9999"/>
                </Grid.RenderTransform>
                <ScrollViewer x:Name="ArchiveProjectScroll" VerticalScrollBarVisibility="Auto" Padding="8,0,8,0"
                              Style="{StaticResource OverlayVScroll}"
                              ScrollChanged="ProjectScrollChanged">
                    <ItemsControl x:Name="ArchivedHost" Tag="1"
                                  Margin="0,8,0,8"
                                  ItemTemplateSelector="{StaticResource ProjectRootRowSelector}"
                                  ItemsPanel="{StaticResource ProjectsPanel}"/>
                </ScrollViewer>
                <!-- 보관함 비었을 때 안내 -->
                <TextBlock x:Name="ArchiveEmptyText" Text="보관된 프로젝트 또는 폴더가 없습니다"
                           HorizontalAlignment="Center" VerticalAlignment="Top" Margin="0,24,0,0"
                           Visibility="Collapsed"
                           FontSize="{DynamicResource Fs12}" Foreground="{DynamicResource TextMutedBrush}"/>
            </Grid>
            <Rectangle x:Name="ProjectFadeTop" Height="24" VerticalAlignment="Top" IsHitTestVisible="False" Panel.ZIndex="1"
                       Visibility="Collapsed"
                       Fill="{DynamicResource PanelBrush}">
                <Rectangle.OpacityMask>
                    <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                        <GradientStop Offset="0" Color="Black"/>
                        <GradientStop Offset="0.7" Color="Transparent"/>
                    </LinearGradientBrush>
                </Rectangle.OpacityMask>
            </Rectangle>
            <Rectangle x:Name="ProjectFadeBottom" Height="24" VerticalAlignment="Bottom" IsHitTestVisible="False" Panel.ZIndex="1"
                       Visibility="Collapsed"
                        Fill="{DynamicResource PanelBrush}">
                <Rectangle.OpacityMask>
                    <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                        <GradientStop Offset="0.3" Color="Transparent"/>
                        <GradientStop Offset="1" Color="Black"/>
                    </LinearGradientBrush>
                </Rectangle.OpacityMask>
            </Rectangle>

            <!-- 폴더/프로젝트 추가 FAB — 활성 프로젝트와 보관함에서 모두 사용 -->
            <Border VerticalAlignment="Bottom" HorizontalAlignment="Right"
                    Margin="0,0,10,10" Panel.ZIndex="20">
                <Button Width="32" Height="32" Click="AddProject_Click" ToolTip="폴더 또는 프로젝트 추가">
                    <Button.Template>
                        <ControlTemplate TargetType="Button">
                            <Border x:Name="Bd" CornerRadius="16" Background="{DynamicResource PrimaryBrush}">
                                <Border.Effect>
                                    <DropShadowEffect Color="{DynamicResource ShadowColor}" Opacity="0.3"
                                                      BlurRadius="12" ShadowDepth="2" Direction="270"/>
                                </Border.Effect>
                                <Path Data="{StaticResource IconPlus}"
                                      Stroke="White" StrokeThickness="2"
                                      StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round"
                                      Width="14" Height="14" Stretch="Uniform"
                                      HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="Bd" Property="Background" Value="{DynamicResource PrimaryHoverBrush}"/>
                                </Trigger>
                                <Trigger Property="IsPressed" Value="True">
                                    <Setter TargetName="Bd" Property="Background" Value="{DynamicResource PrimaryPressedBrush}"/>
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Button.Template>
                </Button>
            </Border>
        </Grid>

        <!-- 업데이트 알림 버튼 -->
        <Button x:Name="UpdateButton" Grid.Row="3"
                Margin="12,0,12,10" Height="34" Visibility="Collapsed"
                Click="UpdateButton_Click" Cursor="Arrow"
                ToolTip="새 버전을 설치합니다">
            <Button.Template>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="Bd" CornerRadius="8" Background="{DynamicResource PrimaryBrush}">
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center">
                            <Path Style="{StaticResource LucideButtonIcon}" Data="{StaticResource IconDownload}"
                                  Width="13" Height="13" Margin="0,0,7,0" Stroke="White" VerticalAlignment="Center"/>
                            <TextBlock VerticalAlignment="Center"
                                       FontSize="{DynamicResource Fs12}" FontWeight="SemiBold" Foreground="White">
                                <Run Text="업데이트 v"/><Run Text="{Binding Tag, RelativeSource={RelativeSource TemplatedParent}}"/>
                            </TextBlock>
                        </StackPanel>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="{DynamicResource PrimaryHoverBrush}"/>
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="{DynamicResource PrimaryPressedBrush}"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Button.Template>
        </Button>
    </Grid>
</UserControl>
