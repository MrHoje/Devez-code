<UserControl x:Class="DevezCode.Views.SidebarView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:models="clr-namespace:DevezCode.Models"
             Background="{DynamicResource PanelBrush}"
             FontFamily="{StaticResource PretendardFont}">
    <UserControl.Resources>
        <!-- 트리 행(프로젝트/세션) 공통: 호버·선택 배경 -->
        <Style x:Key="TreeRow" TargetType="Border">
            <Setter Property="CornerRadius" Value="8"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="{DynamicResource PanelSoftBrush}"/>
                </Trigger>
                <DataTrigger Binding="{Binding IsSelected}" Value="True">
                    <Setter Property="Background" Value="{DynamicResource PrimarySoftBrush}"/>
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <!-- 행 위에 떠 있는 작은 액션 버튼(+ / x) -->
        <Style x:Key="RowActionBtn" TargetType="Button">
            <Setter Property="IsTabStop" Value="False"/>
            <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Width" Value="26"/>
            <Setter Property="Height" Value="26"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd" Background="{TemplateBinding Background}" CornerRadius="6">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource LineBrush}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- 세션 상태 점: 살아있으면 테마색, 끊기거나 죽으면 회색 -->
        <Style x:Key="SessionDot" TargetType="Ellipse">
            <Setter Property="Width" Value="8"/>
            <Setter Property="Height" Value="8"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="Fill" Value="#6B7280"/>
            <Style.Triggers>
                <DataTrigger Binding="{Binding IsAlive}" Value="True">
                    <Setter Property="Fill" Value="{DynamicResource PrimaryBrush}"/>
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <!-- 세션(하위 항목) 템플릿 — 아이콘 없이 상태 점 + 이름 -->
        <DataTemplate x:Key="SessionTemplate" DataType="{x:Type models:SessionItem}">
            <Grid Margin="0,1">
                <Border Style="{StaticResource TreeRow}" Padding="0"
                        MouseLeftButtonUp="Session_Click">
                    <Grid Margin="12,6,8,6">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="26"/>
                        </Grid.ColumnDefinitions>
                        <Ellipse Grid.Column="0" Style="{StaticResource SessionDot}"/>
                        <TextBlock Grid.Column="1" Text="{Binding Name}" Margin="10,0,0,0"
                                   VerticalAlignment="Center" TextTrimming="CharacterEllipsis"
                                   FontSize="{DynamicResource Fs12}"
                                   Foreground="{DynamicResource SidebarSubTextBrush}"/>
                    </Grid>
                </Border>
                <Button Style="{StaticResource RowActionBtn}" HorizontalAlignment="Right"
                        Margin="0,0,6,0" Click="SessionDelete_Click" ToolTip="세션 삭제">
                    <Path Style="{StaticResource LucideIcon}" Data="{StaticResource IconX}"
                          Width="12" Height="12" Stroke="{DynamicResource TextMutedBrush}"/>
                </Button>
            </Grid>
        </DataTemplate>

        <!-- 프로젝트(상위 항목) 템플릿 -->
        <DataTemplate x:Key="ProjectTemplate" DataType="{x:Type models:ProjectItem}">
            <StackPanel Margin="0,1">
                <Grid>
                    <Border Style="{StaticResource TreeRow}" Padding="0"
                            MouseLeftButtonUp="Project_Click">
                        <Grid Margin="8,9,8,9">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="52"/>
                            </Grid.ColumnDefinitions>
                            <Path Grid.Column="0" Style="{StaticResource LucideIcon}"
                                  Data="{Binding IsExpanded, Converter={x:Static models:ChevronConverter.Instance}}"
                                  Width="13" Height="13" Stroke="{DynamicResource TextMutedBrush}"
                                  VerticalAlignment="Center"/>
                            <Path Grid.Column="1" Style="{StaticResource LucideIcon}"
                                  Data="{StaticResource IconBox}" Width="15" Height="15" Margin="7,0,0,0"
                                  Stroke="{DynamicResource RailIconBrush}" VerticalAlignment="Center"/>
                            <TextBlock Grid.Column="2" Text="{Binding Name}" Margin="9,0,0,0"
                                       VerticalAlignment="Center" TextTrimming="CharacterEllipsis"
                                       FontSize="{DynamicResource Fs14}" FontWeight="SemiBold"
                                       Foreground="{DynamicResource TextBrush}"/>
                        </Grid>
                    </Border>
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,0,6,0">
                        <Button Style="{StaticResource RowActionBtn}" Click="AddSession_Click" ToolTip="새 세션">
                            <Path Style="{StaticResource LucideIcon}" Data="{StaticResource IconPlus}"
                                  Width="14" Height="14" Stroke="{DynamicResource TextMutedBrush}"/>
                        </Button>
                        <Button Style="{StaticResource RowActionBtn}" Click="ProjectDelete_Click" ToolTip="프로젝트 제거">
                            <Path Style="{StaticResource LucideIcon}" Data="{StaticResource IconTrash2}"
                                  Width="13" Height="13" Stroke="{DynamicResource TextMutedBrush}"/>
                        </Button>
                    </StackPanel>
                </Grid>
                <!-- 들여쓰기 + 좌측 세로 가이드선 (devez 방식) -->
                <Border Margin="20,1,0,4"
                        BorderBrush="{DynamicResource LineBrush}"
                        BorderThickness="1,0,0,0"
                        Visibility="{Binding IsExpanded, Converter={x:Static models:BoolVisibilityConverter.Instance}}">
                    <ItemsControl ItemsSource="{Binding Sessions}"
                                  ItemTemplate="{StaticResource SessionTemplate}"
                                  Margin="4,0,0,0"/>
                </Border>
            </StackPanel>
        </DataTemplate>
    </UserControl.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Header -->
        <Border Grid.Row="0" Height="44"
                BorderBrush="{DynamicResource LineBrush}" BorderThickness="0,0,0,1">
            <TextBlock Text="디렉터리 &amp; 세션" Margin="16,0" VerticalAlignment="Center"
                       FontSize="{DynamicResource Fs12}" FontWeight="SemiBold"
                       Foreground="{DynamicResource TextMutedBrush}"/>
        </Border>

        <!-- Project tree -->
        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" Padding="8,8">
            <ItemsControl x:Name="ProjectsHost" ItemTemplate="{StaticResource ProjectTemplate}"/>
        </ScrollViewer>

        <!-- Footer: 새 프로젝트 -->
        <Border Grid.Row="2" BorderBrush="{DynamicResource LineBrush}" BorderThickness="0,1,0,0"
                Padding="12">
            <Button Height="40" Style="{StaticResource PrimaryButton}" Click="AddProject_Click">
                <StackPanel Orientation="Horizontal">
                    <Path Style="{StaticResource LucideButtonIcon}" Data="{StaticResource IconPlus}"
                          Width="15" Height="15" Stroke="White"/>
                    <TextBlock Text="새 프로젝트" Margin="8,0,0,0" Foreground="White"/>
                </StackPanel>
            </Button>
        </Border>
    </Grid>
</UserControl>
