<UserControl x:Class="DevezCode.Views.SidebarView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:models="clr-namespace:DevezCode.Models"
             Background="{DynamicResource PanelBrush}"
             FontFamily="{StaticResource PretendardFont}">
    <UserControl.Resources>
        <!-- 트리 행(프로젝트/세션) 공통: 호버·선택 배경 -->
        <Style x:Key="TreeRow" TargetType="Border">
            <Setter Property="CornerRadius" Value="8"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="{DynamicResource PanelSoftBrush}"/>
                </Trigger>
                <!-- 우클릭 메뉴가 열려 있는 동안에도 호버 배경 유지 (devez 방식) -->
                <DataTrigger Binding="{Binding RelativeSource={RelativeSource Self}, Path=ContextMenu.IsOpen}" Value="True">
                    <Setter Property="Background" Value="{DynamicResource PanelSoftBrush}"/>
                </DataTrigger>
                <DataTrigger Binding="{Binding IsSelected}" Value="True">
                    <Setter Property="Background" Value="{DynamicResource PrimarySoftBrush}"/>
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <!-- 세션 상태 점: 살아있으면 테마색, 끊기거나 죽으면 회색 -->
        <Style x:Key="SessionDot" TargetType="Ellipse">
            <Setter Property="Width" Value="8"/>
            <Setter Property="Height" Value="8"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="Fill" Value="#6B7280"/>
            <Style.Triggers>
                <DataTrigger Binding="{Binding IsAlive}" Value="True">
                    <Setter Property="Fill" Value="{DynamicResource PrimaryBrush}"/>
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <!-- 세션(하위 항목) 템플릿 — 상태 점 + 이름. 액션은 우클릭 메뉴 -->
        <DataTemplate x:Key="SessionTemplate" DataType="{x:Type models:SessionItem}">
            <Border Style="{StaticResource TreeRow}" Margin="0,1" MouseLeftButtonUp="Session_Click">
                <Border.ContextMenu>
                    <ContextMenu>
                        <MenuItem Header="세션 삭제" Tag="{Binding}" Click="SessionDelete_Click" Foreground="#ef4444">
                            <MenuItem.Icon>
                                <Path Style="{StaticResource LucideIcon}" Data="{StaticResource IconTrash2}"
                                      Width="13" Height="13" Stroke="#ef4444"/>
                            </MenuItem.Icon>
                        </MenuItem>
                    </ContextMenu>
                </Border.ContextMenu>
                <Grid Margin="12,6,12,6">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <Ellipse Grid.Column="0" Style="{StaticResource SessionDot}"/>
                    <TextBlock Grid.Column="1" Text="{Binding Name}" Margin="10,0,0,0"
                               VerticalAlignment="Center" TextTrimming="CharacterEllipsis"
                               FontSize="{DynamicResource Fs12}"
                               Foreground="{DynamicResource SidebarSubTextBrush}"/>
                </Grid>
            </Border>
        </DataTemplate>

        <!-- 프로젝트(상위 항목) 템플릿 — 박스·이름·접고펴기 chevron(오른쪽). 액션은 우클릭 메뉴 -->
        <DataTemplate x:Key="ProjectTemplate" DataType="{x:Type models:ProjectItem}">
            <StackPanel Margin="0,1">
                <Border Style="{StaticResource TreeRow}" MouseLeftButtonUp="Project_Click"
                        AllowDrop="True"
                        PreviewMouseLeftButtonDown="ProjectRow_PreviewMouseLeftButtonDown"
                        PreviewMouseMove="ProjectRow_PreviewMouseMove"
                        DragOver="ProjectRow_DragOver"
                        DragLeave="ProjectRow_DragLeave"
                        Drop="ProjectRow_Drop">
                    <Border.ContextMenu>
                        <ContextMenu>
                            <MenuItem Header="새 세션" Tag="{Binding}" Click="AddSession_Click">
                                <MenuItem.Icon>
                                    <Path Style="{StaticResource LucideIcon}" Data="{StaticResource IconPlus}"
                                          Width="13" Height="13" Stroke="{DynamicResource TextMutedBrush}"/>
                                </MenuItem.Icon>
                            </MenuItem>
                            <MenuItem Header="아이콘 바꾸기" Tag="{Binding}" Click="ChangeProjectIcon_Click">
                                <MenuItem.Icon>
                                    <Path Style="{StaticResource LucideIcon}" Data="{StaticResource IconPalette}"
                                          Width="13" Height="13" Stroke="{DynamicResource TextMutedBrush}"/>
                                </MenuItem.Icon>
                            </MenuItem>
                            <Separator/>
                            <MenuItem Header="프로젝트 제거" Tag="{Binding}" Click="ProjectDelete_Click" Foreground="#ef4444">
                                <MenuItem.Icon>
                                    <Path Style="{StaticResource LucideIcon}" Data="{StaticResource IconTrash2}"
                                          Width="13" Height="13" Stroke="#ef4444"/>
                                </MenuItem.Icon>
                            </MenuItem>
                        </ContextMenu>
                    </Border.ContextMenu>
                    <Grid Margin="10,9,10,9">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <Path Grid.Column="0" Style="{StaticResource LucideIcon}"
                              Data="{Binding IconKey, Converter={x:Static models:ProjectIconConverter.Instance}}"
                              Width="15" Height="15"
                              Stroke="{Binding IconColor, Converter={x:Static models:ProjectIconColorConverter.Instance}}"
                              VerticalAlignment="Center"/>
                        <TextBlock Grid.Column="1" Text="{Binding Name}" Margin="9,0,0,0"
                                   VerticalAlignment="Center" TextTrimming="CharacterEllipsis"
                                   FontSize="{DynamicResource Fs14}" FontWeight="SemiBold"
                                   Foreground="{DynamicResource TextBrush}"/>
                        <Path Grid.Column="2" Style="{StaticResource LucideButtonIcon}"
                              Data="{Binding IsExpanded, Converter={x:Static models:ChevronConverter.Instance}}"
                              Width="9" Height="9" Margin="8,0,2,0"
                              Stroke="{DynamicResource TextMutedBrush}" VerticalAlignment="Center"/>
                    </Grid>
                </Border>
                <!-- 들여쓰기 + 좌측 세로 가이드선. 세로선 x를 프로젝트 아이콘 x중심(17.5px)에 맞춤 (devez 방식) -->
                <Border Margin="17,1,0,4"
                        BorderBrush="{DynamicResource LineBrush}"
                        BorderThickness="1,0,0,0"
                        Visibility="{Binding IsExpanded, Converter={x:Static models:BoolVisibilityConverter.Instance}}">
                    <ItemsControl ItemsSource="{Binding Sessions}"
                                  ItemTemplate="{StaticResource SessionTemplate}"
                                  Margin="4,0,0,0"/>
                </Border>
            </StackPanel>
        </DataTemplate>
    </UserControl.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Header -->
        <Border Grid.Row="0" Height="44"
                BorderBrush="{DynamicResource LineBrush}" BorderThickness="0,0,0,1">
            <TextBlock Text="디렉터리 &amp; 세션" Margin="16,0" VerticalAlignment="Center"
                       FontSize="{DynamicResource Fs12}" FontWeight="SemiBold"
                       Foreground="{DynamicResource TextMutedBrush}"/>
        </Border>

        <!-- Project tree + floating FAB -->
        <Grid Grid.Row="1">
            <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="8,8">
                <ItemsControl x:Name="ProjectsHost" ItemTemplate="{StaticResource ProjectTemplate}"/>
            </ScrollViewer>

            <!-- 새 프로젝트 FAB (devez 방식: 우하단 떠 있는 원형 버튼) -->
            <Border VerticalAlignment="Bottom" HorizontalAlignment="Right"
                    Margin="0,0,12,12" Panel.ZIndex="10">
                <Button Width="44" Height="44" Click="AddProject_Click" ToolTip="새 프로젝트">
                    <Button.Template>
                        <ControlTemplate TargetType="Button">
                            <Border x:Name="Bd" CornerRadius="22" Background="{DynamicResource PrimaryBrush}">
                                <Border.Effect>
                                    <DropShadowEffect Color="{DynamicResource ShadowColor}" Opacity="0.3"
                                                      BlurRadius="12" ShadowDepth="2" Direction="270"/>
                                </Border.Effect>
                                <Path Data="{StaticResource IconPlus}"
                                      Stroke="White" StrokeThickness="2"
                                      StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round"
                                      Width="18" Height="18" Stretch="Uniform"
                                      HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="Bd" Property="Background" Value="{DynamicResource PrimaryHoverBrush}"/>
                                </Trigger>
                                <Trigger Property="IsPressed" Value="True">
                                    <Setter TargetName="Bd" Property="Background" Value="{DynamicResource PrimaryPressedBrush}"/>
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Button.Template>
                </Button>
            </Border>
        </Grid>
    </Grid>
</UserControl>
