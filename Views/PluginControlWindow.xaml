<Window x:Class="DevezCode.Views.PluginControlWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:views="clr-namespace:DevezCode.Views"
        xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
        Title="Claude 플러그인 관리"
        Width="1240" Height="840"
        MinWidth="980" MinHeight="600"
        WindowStartupLocation="Manual"
        WindowStyle="None"
        ResizeMode="CanResize"
        Background="{DynamicResource BgBrush}"
        ShowInTaskbar="False"
        PreviewKeyDown="Window_PreviewKeyDown"
        UseLayoutRounding="True"
        SnapsToDevicePixels="True"
        TextOptions.TextFormattingMode="Display"
        TextOptions.TextRenderingMode="ClearType"
        FontFamily="{StaticResource PretendardFont}">

    <!-- 네이티브 리사이즈·최대화 애니메이션을 위해 WindowChrome 사용(메인창과 동일 방식).
         캡션(헤더 48px)은 드래그·더블클릭 최대화, 창 컨트롤 버튼은 IsHitTestVisibleInChrome 로 클릭 가능. -->
    <shell:WindowChrome.WindowChrome>
        <shell:WindowChrome CaptionHeight="48" ResizeBorderThickness="6"
                            CornerRadius="0" GlassFrameThickness="0,0,0,1" UseAeroCaptionButtons="False"/>
    </shell:WindowChrome.WindowChrome>

    <Border x:Name="RootChrome" Background="{DynamicResource BgBrush}"
            BorderBrush="{DynamicResource LineBrush}" BorderThickness="1">
        <views:PluginControlDialog x:Name="PluginView"/>
    </Border>
</Window>
