<Window x:Class="DevezCode.Views.PluginControlWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:views="clr-namespace:DevezCode.Views"
        Title="Claude 플러그인 컨트롤러"
        Width="1240" Height="840"
        MinWidth="980" MinHeight="600"
        WindowStartupLocation="Manual"
        WindowStyle="None"
        ResizeMode="CanResize"
        AllowsTransparency="True"
        Background="Transparent"
        ShowInTaskbar="False"
        PreviewKeyDown="Window_PreviewKeyDown"
        UseLayoutRounding="True"
        SnapsToDevicePixels="True"
        TextOptions.TextFormattingMode="Display"
        TextOptions.TextRenderingMode="ClearType"
        FontFamily="{StaticResource PretendardFont}">

    <Grid Margin="{DynamicResource WindowShadowOuterMargin}">
        <Border Background="{DynamicResource BgBrush}" CornerRadius="{DynamicResource WindowShadowCornerRadius}"
                Margin="{DynamicResource WindowShadowInnerMargin}"
                SnapsToDevicePixels="True">
            <Border.Effect>
                <DropShadowEffect ShadowDepth="0" BlurRadius="{DynamicResource WindowShadowBlurRadius}" Direction="270"
                                  Color="{DynamicResource ShadowColor}" Opacity="{DynamicResource ShadowOpacity}"/>
            </Border.Effect>
        </Border>
        <Border CornerRadius="14"
                Background="{DynamicResource BgBrush}"
                BorderBrush="{DynamicResource LineBrush}" BorderThickness="1"
                ClipToBounds="True"
                SnapsToDevicePixels="True">
            <views:PluginControlDialog x:Name="PluginView"/>
        </Border>
    </Grid>
</Window>
