<Window x:Class="DevezCode.Views.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:views="clr-namespace:DevezCode.Views"
        xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
        Title="설정"
        Width="1280" Height="860"
        MinWidth="900" MinHeight="600"
        WindowState="Maximized"
        WindowStyle="None"
        ResizeMode="CanResize"
        Background="{DynamicResource BgBrush}"
        ShowInTaskbar="False"
        PreviewKeyDown="Window_KeyDown"
        UseLayoutRounding="True"
        SnapsToDevicePixels="True"
        TextOptions.TextFormattingMode="Display"
        TextOptions.TextRenderingMode="ClearType"
        FontFamily="{StaticResource PretendardFont}">

    <!-- 전체화면 창(Slack 스타일). AllowsTransparency 를 쓰지 않으므로 최대화 시 작업표시줄을 덮지 않고,
         WindowChrome 으로 OS 리사이즈 테두리만 유지한다(기본 캡션은 감춤 — 헤더가 캡션 역할). -->
    <shell:WindowChrome.WindowChrome>
        <shell:WindowChrome CaptionHeight="0" ResizeBorderThickness="5"
                            CornerRadius="0" GlassFrameThickness="0" UseAeroCaptionButtons="False"/>
    </shell:WindowChrome.WindowChrome>

    <Border x:Name="RootLayer" Background="{DynamicResource BgBrush}"
            BorderBrush="{DynamicResource LineBrush}" BorderThickness="1"
            SnapsToDevicePixels="True">
        <views:SettingsDialog x:Name="SettingsView"/>
    </Border>
</Window>
