<Window x:Class="DevezCode.Views.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:views="clr-namespace:DevezCode.Views"
        Title="설정"
        Width="1240" Height="760"
        WindowStartupLocation="Manual"
        WindowStyle="None"
        ResizeMode="NoResize"
        Background="{DynamicResource BgBrush}"
        ShowInTaskbar="False"
        PreviewKeyDown="Window_KeyDown"
        UseLayoutRounding="True"
        SnapsToDevicePixels="True"
        TextOptions.TextFormattingMode="Display"
        TextOptions.TextRenderingMode="ClearType"
        FontFamily="{StaticResource PretendardFont}">

    <!-- 메인창을 꽉 채우는 설정 화면(Slack 스타일).
         Owner(MainWindow)의 클라이언트 영역에 정확히 겹치고 이동·리사이즈를 따라간다.
         꽉 차므로 라운드/그림자/투명도는 쓰지 않는다(투명 창은 최대화 시 작업표시줄을 덮음). -->
    <Border x:Name="RootLayer" Background="{DynamicResource BgBrush}" SnapsToDevicePixels="True">
        <views:SettingsDialog x:Name="SettingsView"/>
    </Border>
</Window>
