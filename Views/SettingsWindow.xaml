<Window x:Class="DevezCode.Views.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:views="clr-namespace:DevezCode.Views"
        Title="설정"
        Width="1240" Height="760"
        WindowStartupLocation="Manual"
        WindowStyle="None"
        ResizeMode="NoResize"
        Background="{DynamicResource BgBrush}"
        ShowInTaskbar="False"
        PreviewKeyDown="Window_KeyDown"
        UseLayoutRounding="True"
        SnapsToDevicePixels="True"
        TextOptions.TextFormattingMode="Display"
        TextOptions.TextRenderingMode="ClearType"
        FontFamily="{StaticResource PretendardFont}">

    <!-- 메인창을 꽉 채우는 설정 화면(Slack 스타일).
         Owner(MainWindow)의 시각적 콘텐츠 영역에 정확히 겹치고 이동·리사이즈를 따라간다.
         둥근 모서리는 메인창과 같은 방식(DWM CORNER_PREFERENCE)으로 코드에서 적용하고,
         테두리는 메인창(RootChrome)과 같은 1px 라인을 그려 덮은 자리를 그대로 잇는다.
         AllowsTransparency 는 쓰지 않는다(투명 창은 최대화 시 작업표시줄을 덮고 DWM 라운드도 무시됨). -->
    <Border x:Name="RootLayer" Background="{DynamicResource BgBrush}"
            BorderBrush="{DynamicResource LineBrush}" BorderThickness="1"
            SnapsToDevicePixels="True">
        <views:SettingsDialog x:Name="SettingsView"/>
    </Border>
</Window>
