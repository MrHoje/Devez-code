<Window x:Class="DevezCode.Views.FolderIconPickerDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="폴더 아이콘 바꾸기"
        Width="390" SizeToContent="Height"
        WindowStartupLocation="CenterOwner"
        WindowStyle="None"
        ResizeMode="NoResize"
        AllowsTransparency="True"
        Background="Transparent"
        ShowInTaskbar="False"
        UseLayoutRounding="True"
        SnapsToDevicePixels="True"
        TextOptions.TextFormattingMode="Display"
        FontFamily="{StaticResource PretendardFont}">
    <Grid Margin="{DynamicResource WindowShadowOuterMargin}">
        <Border Background="{DynamicResource BgBrush}"
                CornerRadius="{DynamicResource WindowShadowCornerRadius}"
                Margin="{DynamicResource WindowShadowInnerMargin}"
                SnapsToDevicePixels="True">
            <Border.Effect>
                <DropShadowEffect ShadowDepth="0"
                                  BlurRadius="{DynamicResource WindowShadowBlurRadius}"
                                  Direction="270"
                                  Color="{DynamicResource ShadowColor}"
                                  Opacity="{DynamicResource ShadowOpacity}"/>
            </Border.Effect>
        </Border>

        <Border CornerRadius="14"
                Background="{DynamicResource BgBrush}"
                BorderBrush="{DynamicResource LineBrush}"
                BorderThickness="1"
                ClipToBounds="True"
                SnapsToDevicePixels="True">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <StackPanel Grid.Row="0" Margin="16,12,16,0">
                    <Grid Margin="0,0,0,10">
                        <TextBlock Text="폴더 아이콘 바꾸기"
                                   FontSize="{DynamicResource Fs14}"
                                   FontWeight="SemiBold"
                                   Foreground="{DynamicResource TextBrush}"
                                   VerticalAlignment="Center"/>
                        <Button Click="CancelBtn_Click"
                                HorizontalAlignment="Right"
                                VerticalAlignment="Top"
                                Width="28" Height="28"
                                Margin="0,-4,-6,0"
                                Style="{StaticResource WinCloseBtn}">
                            <TextBlock Text="&#x2715;" FontSize="{DynamicResource Fs11}"/>
                        </Button>
                    </Grid>
                </StackPanel>

                <UniformGrid x:Name="IconGrid"
                             Grid.Row="1"
                             Columns="5" Rows="2"
                             Margin="13,0,13,13"/>

                <Border Grid.Row="2"
                        Background="{DynamicResource PanelSoftBrush}"
                        BorderBrush="{DynamicResource LineBrush}"
                        BorderThickness="0,1,0,0">
                    <StackPanel Orientation="Horizontal"
                                HorizontalAlignment="Right"
                                Margin="16,9,16,9">
                        <Button Click="CancelBtn_Click"
                                Width="92" Height="34"
                                Style="{StaticResource SecondaryButton}"
                                FontSize="{DynamicResource Fs12}"
                                Margin="0,0,8,0">
                            <TextBlock Text="취소"/>
                        </Button>
                        <Button Click="ApplyBtn_Click"
                                Width="92" Height="34"
                                Style="{StaticResource PrimaryButton}"
                                FontSize="{DynamicResource Fs12}">
                            <TextBlock Text="적용" Foreground="{DynamicResource OnPrimaryBrush}"/>
                        </Button>
                    </StackPanel>
                </Border>
            </Grid>
        </Border>
    </Grid>
</Window>