<UserControl x:Class="DevezCode.Views.TaskQueueView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:models="clr-namespace:DevezCode.Models"
             Background="{DynamicResource BgBrush}"
             FontFamily="{StaticResource PretendardFont}"
             Focusable="True" FocusVisualStyle="{x:Null}"
             PreviewMouseWheel="Root_PreviewMouseWheel"
             PreviewMouseLeftButtonDown="Root_PreviewMouseLeftButtonDown"
             PreviewMouseLeftButtonUp="Root_PreviewMouseLeftButtonUp"
             PreviewMouseMove="Root_PreviewMouseMove"
             PreviewKeyDown="Root_PreviewKeyDown"
             DataContextChanged="TaskQueueView_DataContextChanged">
    <UserControl.Resources>
        <models:SubtractConverter x:Key="Subtract"/>

        <!-- ── 컨텍스트 메뉴 (Setter.Value 인라인 X → 리소스로 분리) ── -->
        <ContextMenu x:Key="BubbleContextMenu" Opened="BubbleContextMenu_Opened" Closed="BubbleContextMenu_Closed">
            <MenuItem Click="BubbleCopy_Click">
                <MenuItem.Icon>
                    <Path Style="{StaticResource LucideMenuIcon}" Data="{StaticResource IconCopy}"/>
                </MenuItem.Icon>
            </MenuItem>
            <MenuItem Header="수정" Click="BubbleEdit_Click">
                <MenuItem.Icon>
                    <Path Style="{StaticResource LucideMenuIcon}" Data="{StaticResource IconPencil}"/>
                </MenuItem.Icon>
            </MenuItem>
            <MenuItem Header="줄별로 분리" Click="BubbleSplit_Click">
                <MenuItem.Icon>
                    <Path Style="{StaticResource LucideMenuIcon}" Data="{StaticResource IconScissors}"/>
                </MenuItem.Icon>
            </MenuItem>
            <Separator/>
            <MenuItem Click="BubbleDelete_Click" Foreground="{DynamicResource DangerBrush}">
                <MenuItem.Icon>
                    <Path Style="{StaticResource LucideMenuIcon}" Data="{StaticResource IconTrash2}"
                          Stroke="{DynamicResource DangerBrush}"/>
                </MenuItem.Icon>
            </MenuItem>
        </ContextMenu>
    </UserControl.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- ── 선택 모드 액션바 (debit 정합: IsSelectionMode=true 일 때만 노출, N개 삭제) ── -->
        <Border x:Name="SelectionActionBar" Grid.Row="0" Height="44"
                Background="{DynamicResource PanelBrush}"
                BorderBrush="{DynamicResource LineBrush}" BorderThickness="0,0,0,1"
                Visibility="Collapsed">
            <Grid Margin="14,0,12,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <Button Grid.Column="0" Click="CancelSelection_Click"
                        Style="{StaticResource IconButton}" Width="28" Height="28"
                        ToolTip="선택 취소 (Esc)" VerticalAlignment="Center">
                    <Path Style="{StaticResource LucideButtonIcon}"
                          Data="{StaticResource IconX}" Width="14" Height="14"/>
                </Button>
                <TextBlock Grid.Column="1" x:Name="SelectionCountText"
                           VerticalAlignment="Center" Margin="10,0,0,0"
                           FontSize="{DynamicResource Fs13}" FontWeight="SemiBold"
                           Foreground="{DynamicResource TextBrush}"
                           Text="0개 선택"/>
                <Button Grid.Column="2" x:Name="DeleteSelectedBtn" Click="DeleteSelected_Click"
                        Height="28" Padding="12,0" Cursor="Arrow"
                        Style="{StaticResource PrimaryButton}"
                        VerticalAlignment="Center"
                        FontSize="{DynamicResource Fs12}">
                    <TextBlock Text="삭제" Foreground="{DynamicResource OnPrimaryBrush}"/>
                </Button>
            </Grid>
        </Border>

        <!-- ── 버블 리스트 (debit MemoList 정합) ── -->
        <Grid Grid.Row="1">
            <!-- 비어있을 때 안내 -->
            <StackPanel x:Name="EmptyHint" VerticalAlignment="Center" HorizontalAlignment="Center"
                        Visibility="Collapsed">
                <Path Style="{StaticResource LucideIcon}" Data="{StaticResource IconMessageSquare}"
                      Width="32" Height="32" Stroke="{DynamicResource TextMutedBrush}"
                      HorizontalAlignment="Center" Opacity="0.5"/>
                <TextBlock Text="아직 작업이 없어요."
                           Margin="0,10,0,0" FontSize="{DynamicResource Fs12}"
                           Foreground="{DynamicResource TextMutedBrush}" TextAlignment="Center"/>
                <TextBlock Text="아래에서 텍스트를 입력하고 Enter"
                           Margin="0,4,0,0" FontSize="{DynamicResource Fs11}"
                           Foreground="{DynamicResource TextMutedBrush}" TextAlignment="Center" Opacity="0.7"/>
            </StackPanel>

            <ListBox x:Name="BubblesList"
                     ItemsSource="{Binding Items}"
                     Background="Transparent" BorderThickness="0" Padding="0,12,0,0"
                     Focusable="False"
                     HorizontalContentAlignment="Stretch"
                     ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                     ScrollViewer.VerticalScrollBarVisibility="Auto"
                     ScrollViewer.CanContentScroll="True"
                     VirtualizingPanel.IsVirtualizing="True"
                     VirtualizingPanel.VirtualizationMode="Recycling"
                     VirtualizingPanel.ScrollUnit="Pixel"
                     KeyDown="BubblesList_KeyDown">
                <ListBox.ItemContainerStyle>
                    <Style TargetType="ListBoxItem">
                        <Setter Property="Padding" Value="0"/>
                        <Setter Property="Margin" Value="0"/>
                        <Setter Property="Background" Value="Transparent"/>
                        <Setter Property="BorderThickness" Value="0"/>
                        <Setter Property="Focusable" Value="False"/>
                        <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                        <Setter Property="Cursor" Value="Arrow"/>
                        <!-- 커스텀 템플릿 (ContentPresenter 만): WPF 기본 ListBoxItem 템플릿의
                              IsSelected 트리거가 행 전체에 색을 칠하는 함정 회피. -->
                        <Setter Property="Template">
                            <Setter.Value>
                                <ControlTemplate TargetType="ListBoxItem">
                                    <ContentPresenter/>
                                </ControlTemplate>
                            </Setter.Value>
                        </Setter>
                        <Setter Property="ContextMenu" Value="{StaticResource BubbleContextMenu}"/>
                    </Style>
                </ListBox.ItemContainerStyle>
                <ListBox.Resources>
                    <!-- ── 버블 한 줄: doit MemoMessage 템플릿의 task queue 슬림 버전 ──
                          BubbleRow(Grid) + SelectCheck(CheckBox) + BubbleDock(DockPanel) + BubbleWrapper(Grid) + SelectionRing/BubbleBorder/BubbleInner/TextBlock.
                          코드블럭/태그/핀/별/시트/할일/타이머/첨부/URL/링크프리뷰/댓글/공유/일정등록/편집/AI채팅 모두 제외. -->
                    <DataTemplate DataType="{x:Type models:TaskQueueItem}">
                        <Grid Margin="0,3" x:Name="BubbleRow" Background="Transparent">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>

                            <!-- SelectCheck: 버블 좌측(절대 좌표) 오버레이. IsSelectionMode ON 일 때만 표시.
                                  Opacity 트리거로 노출/숨김 → 레이아웃 영향 없음, 가상화 ListBox 우루루 차단. -->
                            <CheckBox x:Name="SelectCheck"
                                      IsChecked="{Binding IsSelected}"
                                      HorizontalAlignment="Left" VerticalAlignment="Bottom"
                                      Margin="11,0,0,6"
                                      Opacity="0" IsHitTestVisible="False"
                                      Style="{StaticResource ModernCheckBox}"/>

                            <DockPanel x:Name="BubbleDock"
                                       HorizontalAlignment="Left"
                                       LastChildFill="False"
                                       Margin="11,0,0,0">
                                <DockPanel.RenderTransform>
                                    <TranslateTransform X="0"/>
                                </DockPanel.RenderTransform>
                                <Grid DockPanel.Dock="Left"
                                      x:Name="BubbleWrapper"
                                      MaxWidth="{Binding ActualWidth, ElementName=BubblesList,
                                                 Converter={StaticResource Subtract}, ConverterParameter=20}">
                                    <!-- SelectionRing: BubbleWrapper 내부 sibling. BubbleBorder 와 독립.
                                          IsHighlighted(IsSelected || IsRightClickHighlighted) → Visible.
                                          BubbleBorder 의 테두리/배경과 같게 따라가도록 CornerRadius 바인딩. -->
                                    <Border x:Name="SelectionRing"
                                            Panel.ZIndex="10"
                                            CornerRadius="{Binding CornerRadius, ElementName=BubbleBorder}"
                                            BorderBrush="{DynamicResource PrimaryBrush}"
                                            BorderThickness="1.5"
                                            Background="Transparent"
                                            IsHitTestVisible="False"
                                            SnapsToDevicePixels="False"
                                            UseLayoutRounding="False"
                                            Visibility="Collapsed"/>
                                    <Border x:Name="BubbleBorder"
                                            Background="{DynamicResource BubbleBorderBrush}"
                                            CornerRadius="14,14,14,4"
                                            Padding="1"
                                            UseLayoutRounding="True"
                                            SnapsToDevicePixels="True"
                                            Focusable="False"
                                            PreviewMouseLeftButtonDown="Bubble_PreviewMouseLeftButtonDown"
                                            MouseLeftButtonDown="Bubble_LeftClick"
                                            MouseRightButtonDown="Bubble_RightClick">
                                        <Border x:Name="BubbleInner"
                                                Background="{DynamicResource BubbleBrush}"
                                                CornerRadius="13,13,13,3"
                                                Padding="14,10">
                                            <Grid>
                                                <TextBlock x:Name="BubbleText" Text="{Binding Text}"
                                                           TextWrapping="Wrap"
                                                           FontSize="{Binding BubbleFontSize, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                           Foreground="{DynamicResource TextBrush}"/>
                                                <!-- 인라인 수정모드: IsEditing 일 때 TextBlock 대신 편집 TextBox 노출. -->
                                                <TextBox x:Name="BubbleEditBox"
                                                         Visibility="Collapsed"
                                                         Text="{Binding EditText, UpdateSourceTrigger=PropertyChanged}"
                                                         TextWrapping="Wrap" AcceptsReturn="True"
                                                         BorderThickness="0" Background="Transparent"
                                                         Padding="0" MinWidth="160"
                                                         Foreground="{DynamicResource TextBrush}"
                                                         CaretBrush="{DynamicResource TextBrush}"
                                                         FontSize="{Binding BubbleFontSize, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                         FontFamily="{StaticResource PretendardFont}"
                                                         PreviewKeyDown="BubbleEditBox_PreviewKeyDown"
                                                         LostKeyboardFocus="BubbleEditBox_LostFocus"/>
                                            </Grid>
                                        </Border>
                                    </Border>
                                </Grid>
                            </DockPanel>

                            <!-- 작업지시 버튼: 단일 클릭(비선택모드) 시 버블 아래 좌측(버블 시작점)에 노출.
                                  클릭 → 현재 활성 탭 세션에 이 버블 텍스트 입력+전송. -->
                            <Button x:Name="ActionButton" Grid.Row="1"
                                    Visibility="Collapsed"
                                    HorizontalAlignment="Left"
                                    Margin="11,5,0,2" Padding="11,5"
                                    Cursor="Hand"
                                    Click="ActionButton_Click"
                                    Tag="{Binding}">
                                <Button.Template>
                                    <ControlTemplate TargetType="Button">
                                        <Border x:Name="ActBorder"
                                                Background="{DynamicResource PrimaryBrush}"
                                                CornerRadius="9" Padding="{TemplateBinding Padding}">
                                            <StackPanel Orientation="Horizontal">
                                                <Path Style="{StaticResource LucideIcon}"
                                                      Data="{StaticResource IconSend}"
                                                      Width="13" Height="13" Stroke="{DynamicResource OnPrimaryBrush}"
                                                      VerticalAlignment="Center"/>
                                                <TextBlock Text="작업지시" Margin="6,0,0,0"
                                                           Foreground="{DynamicResource OnPrimaryBrush}" FontWeight="SemiBold"
                                                           FontSize="{DynamicResource Fs12}"
                                                           VerticalAlignment="Center"/>
                                            </StackPanel>
                                        </Border>
                                        <ControlTemplate.Triggers>
                                            <Trigger Property="IsMouseOver" Value="True">
                                                <Setter TargetName="ActBorder" Property="Opacity" Value="0.88"/>
                                            </Trigger>
                                        </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                </Button.Template>
                            </Button>
                        </Grid>
                        <DataTemplate.Triggers>
                            <!-- 하이라이트(선택 OR 우클릭) → SelectionRing 노출 -->
                            <DataTrigger Binding="{Binding IsHighlighted}" Value="True">
                                <Setter TargetName="SelectionRing" Property="Visibility" Value="Visible"/>
                            </DataTrigger>
                            <!-- 수정모드: 편집 TextBox 노출 + 본문 TextBlock 숨김 + 링으로 강조 -->
                            <DataTrigger Binding="{Binding IsEditing}" Value="True">
                                <Setter TargetName="BubbleText" Property="Visibility" Value="Collapsed"/>
                                <Setter TargetName="BubbleEditBox" Property="Visibility" Value="Visible"/>
                                <Setter TargetName="SelectionRing" Property="Visibility" Value="Visible"/>
                            </DataTrigger>
                            <!-- 드래그 병합 도착지 → 두꺼운 링으로 "여기에 합쳐짐" 표시 (devez IsMergeHoverIndicatorVisible) -->
                            <DataTrigger Binding="{Binding IsMergeTarget}" Value="True">
                                <Setter TargetName="SelectionRing" Property="Visibility" Value="Visible"/>
                                <Setter TargetName="SelectionRing" Property="BorderThickness" Value="2.5"/>
                            </DataTrigger>
                            <!-- 단일 클릭 대상 → '작업지시' 버튼 노출 -->
                            <DataTrigger Binding="{Binding IsActionTarget}" Value="True">
                                <Setter TargetName="ActionButton" Property="Visibility" Value="Visible"/>
                            </DataTrigger>
                            <!-- IsSelectionMode ON → SelectCheck 표시 + 버블 좌측으로 16 이동(체크박스 자리 확보) -->
                            <DataTrigger Binding="{Binding DataContext.IsSelectionMode,
                                                    RelativeSource={RelativeSource AncestorType=UserControl}}"
                                         Value="True">
                                <Setter TargetName="SelectCheck" Property="Opacity"         Value="1"/>
                                <Setter TargetName="SelectCheck" Property="IsHitTestVisible" Value="True"/>
                                <!-- 체크박스(좌측) 노출 시 버블을 오른쪽으로 이동해 체크박스 자리 확보. -->
                                <Setter TargetName="BubbleDock" Property="RenderTransform">
                                    <Setter.Value>
                                        <TranslateTransform X="27"/>
                                    </Setter.Value>
                                </Setter>
                            </DataTrigger>
                        </DataTemplate.Triggers>
                    </DataTemplate>
                </ListBox.Resources>
            </ListBox>

            <!-- ── 러버밴드 오버레이: 빈 영역 드래그로 다중선택 ── -->
            <Canvas x:Name="RubberBandCanvas"
                    Panel.ZIndex="23"
                    IsHitTestVisible="False"
                    ClipToBounds="True"
                    Visibility="Collapsed">
                <Rectangle x:Name="RubberBandRect"
                           Stroke="{DynamicResource PrimaryBrush}"
                           StrokeThickness="1"
                           RadiusX="2" RadiusY="2">
                    <Rectangle.Fill>
                        <SolidColorBrush Color="{DynamicResource PrimaryColor}" Opacity="0.12"/>
                    </Rectangle.Fill>
                </Rectangle>
            </Canvas>

            <!-- ── 드래그 고스트: 버블을 끌 때 커서를 따라다니는 반투명 미니 버블 ── -->
            <Canvas x:Name="DragGhostLayer"
                    Panel.ZIndex="30"
                    IsHitTestVisible="False"
                    Visibility="Collapsed">
                <Border x:Name="DragGhost"
                        Opacity="0.75"
                        Background="{DynamicResource BubbleBrush}"
                        BorderBrush="{DynamicResource PrimaryBrush}" BorderThickness="1"
                        CornerRadius="13,13,13,3" Padding="12,8" MaxWidth="240">
                    <Grid>
                        <TextBlock x:Name="DragGhostText"
                                   TextWrapping="NoWrap" TextTrimming="CharacterEllipsis"
                                   FontSize="{DynamicResource Fs13}"
                                   Foreground="{DynamicResource TextBrush}"/>
                        <Border x:Name="DragGhostBadge"
                                Visibility="Collapsed"
                                HorizontalAlignment="Right" VerticalAlignment="Top"
                                Margin="0,-16,-8,0"
                                Background="{DynamicResource PrimaryBrush}"
                                CornerRadius="9" MinWidth="18" Height="18" Padding="5,0">
                            <TextBlock x:Name="DragGhostBadgeText"
                                       Foreground="{DynamicResource OnPrimaryBrush}" FontSize="11" FontWeight="SemiBold"
                                       HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                    </Grid>
                </Border>
            </Canvas>
        </Grid>

        <!-- ── 입력 바: devez 정합 — 상단 구분선 없이 BgBrush 로 영역과 동화,
                  상단 리사이즈 Thumb 로 높이 조절, 둥근 카드 입력칸. (code/snippet 툴바 제외) ── -->
        <Border Grid.Row="2"
                Background="{DynamicResource BgBrush}"
                Padding="10,0,10,10">
            <DockPanel LastChildFill="True">
                <!-- 리사이즈 핸들(점 3개, SizeNS) — devez InputResizeThumb 정합 -->
                <Thumb DockPanel.Dock="Top" x:Name="InputResizeThumb"
                       Height="10" Cursor="SizeNS" Margin="0,0,0,2"
                       DragDelta="InputResizeThumb_DragDelta">
                    <Thumb.Template>
                        <ControlTemplate TargetType="Thumb">
                            <Grid Background="Transparent">
                                <Path x:Name="InputResizeDots"
                                      HorizontalAlignment="Center" VerticalAlignment="Center"
                                      Fill="{DynamicResource TextMutedBrush}"
                                      RenderOptions.EdgeMode="Aliased"
                                      UseLayoutRounding="True" SnapsToDevicePixels="True"
                                      Data="M0,0 H2 V2 H0 Z M4,0 H6 V2 H4 Z M8,0 H10 V2 H8 Z"/>
                            </Grid>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="InputResizeDots" Property="Fill"
                                            Value="{DynamicResource PrimaryBrush}"/>
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Thumb.Template>
                </Thumb>

                <Border Background="{DynamicResource PanelBrush}"
                        BorderBrush="{DynamicResource LineBrush}" BorderThickness="1"
                        CornerRadius="14" Padding="12,8" VerticalAlignment="Bottom">
                    <Grid>
                        <TextBox x:Name="InputBox"
                                 BorderThickness="0" Background="Transparent"
                                 Foreground="{DynamicResource TextBrush}"
                                 CaretBrush="{DynamicResource TextBrush}"
                                 FontSize="{Binding BubbleFontSize, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                 FontFamily="{StaticResource PretendardFont}"
                                 VerticalContentAlignment="Center"
                                 MaxHeight="180"
                                 TextWrapping="Wrap" AcceptsReturn="True"
                                 VerticalScrollBarVisibility="Auto"
                                 PreviewKeyDown="InputBox_PreviewKeyDown"
                                 TextChanged="InputBox_TextChanged"/>
                        <TextBlock Text="작업을 입력하고 Enter"
                                   IsHitTestVisible="False"
                                   Margin="1,0,0,0" VerticalAlignment="Center"
                                   Foreground="{DynamicResource TextMutedBrush}"
                                   FontSize="{Binding BubbleFontSize, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                   FontFamily="{StaticResource PretendardFont}">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock" BasedOn="{StaticResource {x:Type TextBlock}}">
                                    <Setter Property="Visibility" Value="Collapsed"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding Text, ElementName=InputBox}" Value="">
                                            <Setter Property="Visibility" Value="Visible"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>
                    </Grid>
                </Border>
            </DockPanel>
        </Border>
    </Grid>
</UserControl>
