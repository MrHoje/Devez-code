<UserControl x:Class="DevezCode.Views.TaskQueueView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:models="clr-namespace:DevezCode.Models"
             Background="{DynamicResource PanelBrush}"
             FontFamily="{StaticResource PretendardFont}">
    <UserControl.Resources>
        <!-- ── 버블 한 줄: doit/devez 정합 — 이중 border (outer=BubbleBorderBrush, inner=BubbleBrush),
              Padding=1 로 inset 되어 외곽선+배경이 1px 라인처럼 보임.
              CornerRadius: outer 14,14,4,14 / inner 13,13,3,13 (outer-1).
              우측 정렬 + content-hugging + 우클릭 메뉴(삭제)만 지원. 호버 X 없음. -->
        <DataTemplate x:Key="TaskBubbleTemplate" DataType="{x:Type models:TaskQueueItem}">
            <Grid Margin="0,3" Background="Transparent" HorizontalAlignment="Stretch">
                <Border x:Name="BubbleBorder"
                        HorizontalAlignment="Right"
                        MaxWidth="260"
                        Background="{DynamicResource BubbleBorderBrush}"
                        CornerRadius="14,14,4,14"
                        Padding="1"
                        UseLayoutRounding="True"
                        SnapsToDevicePixels="True"
                        Focusable="False">
                    <Border x:Name="BubbleInner"
                            Background="{DynamicResource BubbleBrush}"
                            CornerRadius="13,13,3,13"
                            Padding="14,10">
                        <TextBlock Text="{Binding Text}"
                                   TextWrapping="Wrap"
                                   FontSize="{DynamicResource Fs14}"
                                   Foreground="{DynamicResource TextBrush}"/>
                    </Border>
                </Border>
            </Grid>
        </DataTemplate>
    </UserControl.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="44"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- 헤더: 기존 우측 패널 탭 헤더와 정합(44px). 아이콘 + 카운트 -->
        <Border Grid.Row="0"
                BorderBrush="{DynamicResource LineBrush}" BorderThickness="0,0,0,1"
                Background="{DynamicResource PanelBrush}">
            <Grid Margin="14,0,12,0">
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <Path Style="{StaticResource LucideIcon}" Data="{StaticResource IconListTodo}"
                          Width="15" Height="15" Stroke="{DynamicResource TextMutedBrush}" VerticalAlignment="Center"/>
                    <TextBlock Text="작업 큐" Margin="8,0,0,0" VerticalAlignment="Center"
                               FontSize="{DynamicResource Fs12}" FontWeight="SemiBold"
                               Foreground="{DynamicResource TextBrush}"/>
                    <Border Background="{DynamicResource LineBrush}" CornerRadius="8"
                            Padding="6,1" Margin="8,0,0,0" VerticalAlignment="Center">
                        <TextBlock x:Name="CountText" Text="0"
                                   FontSize="{DynamicResource Fs11}"
                                   Foreground="{DynamicResource TextMutedBrush}"/>
                    </Border>
                </StackPanel>
            </Grid>
        </Border>

        <!-- 버블 리스트 -->
        <Grid Grid.Row="1">
            <!-- 비어 있을 때 안내 (ItemsSource가 null 또는 비어있으면 노출) -->
            <StackPanel x:Name="EmptyHint" VerticalAlignment="Center" HorizontalAlignment="Center"
                        Visibility="Collapsed">
                <Path Style="{StaticResource LucideIcon}" Data="{StaticResource IconListTodo}"
                      Width="32" Height="32" Stroke="{DynamicResource TextMutedBrush}"
                      HorizontalAlignment="Center" Opacity="0.5"/>
                <TextBlock Text="아직 작업이 없어요."
                           Margin="0,10,0,0" FontSize="{DynamicResource Fs12}"
                           Foreground="{DynamicResource TextMutedBrush}" TextAlignment="Center"/>
                <TextBlock Text="아래에서 텍스트를 입력하고 Enter"
                           Margin="0,4,0,0" FontSize="{DynamicResource Fs11}"
                           Foreground="{DynamicResource TextMutedBrush}" TextAlignment="Center" Opacity="0.7"/>
            </StackPanel>

            <ScrollViewer x:Name="BubbleScroller" VerticalScrollBarVisibility="Auto" Padding="10,10">
                <!-- ListBox: 다중선택(SelectionMode=Extended) + 선택 링(컨테이너 템플릿).
                     기본 선택 배경/포커스 시각효과 제거(컨테이너 템플릿으로 덮어씀). -->
                <ListBox x:Name="BubblesList"
                         ItemsSource="{Binding Items}"
                         ItemTemplate="{StaticResource TaskBubbleTemplate}"
                         SelectionMode="Extended"
                         Background="Transparent" BorderThickness="0"
                         Foreground="{DynamicResource TextBrush}"
                         HorizontalContentAlignment="Stretch"
                         ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                         KeyDown="BubblesList_KeyDown">
                    <ListBox.ItemContainerStyle>
                        <Style TargetType="ListBoxItem">
                            <Setter Property="Background" Value="Transparent"/>
                            <Setter Property="Padding" Value="0"/>
                            <Setter Property="Margin" Value="0"/>
                            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                            <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
                            <Setter Property="Cursor" Value="Arrow"/>
                            <!-- 우클릭 시: 미선택이면 이 항목만 선택 / 이미 선택(다중)이면 선택 유지 -->
                            <EventSetter Event="PreviewMouseRightButtonDown" Handler="BubbleItem_PreviewRightButtonDown"/>
                            <!-- 컨텍스트 메뉴: 선택 수에 따라 헤더가 '삭제' ↔ '선택 N개 삭제' 로 바뀜 (Opened 핸들러) -->
                            <Setter Property="ContextMenu">
                                <Setter.Value>
                                    <ContextMenu x:Name="BubbleContextMenu" Opened="BubbleContextMenu_Opened">
                                        <MenuItem x:Name="DeleteMenuItem" Click="BubbleDelete_Click">
                                            <MenuItem.Icon>
                                                <Path Style="{StaticResource LucideMenuIcon}" Data="{StaticResource IconTrash2}"/>
                                            </MenuItem.Icon>
                                        </MenuItem>
                                    </ContextMenu>
                                </Setter.Value>
                            </Setter>
                            <!-- 선택 링: 버블 외곽(14,14,4,14 + 1.5px 두께 + 1.5px 마진 = 15,15,5,15)에 primary 보더 -->
                            <Setter Property="Template">
                                <Setter.Value>
                                    <ControlTemplate TargetType="ListBoxItem">
                                        <Grid>
                                            <ContentPresenter/>
                                            <Border x:Name="SelectionRing"
                                                    IsHitTestVisible="False"
                                                    CornerRadius="15,15,5,15"
                                                    BorderBrush="{DynamicResource PrimaryBrush}"
                                                    BorderThickness="1.5"
                                                    Margin="-1.5"
                                                    Visibility="Collapsed"/>
                                        </Grid>
                                        <ControlTemplate.Triggers>
                                            <Trigger Property="IsSelected" Value="True">
                                                <Setter TargetName="SelectionRing" Property="Visibility" Value="Visible"/>
                                            </Trigger>
                                        </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                </Setter.Value>
                            </Setter>
                        </Style>
                    </ListBox.ItemContainerStyle>
                </ListBox>
            </ScrollViewer>
        </Grid>

        <!-- 입력 바: AiChatHostView 정합 — 둥근 배경 + Enter로 추가 -->
        <Border Grid.Row="2"
                Background="{DynamicResource PanelBrush}"
                BorderBrush="{DynamicResource LineBrush}" BorderThickness="0,1,0,0"
                Padding="10,8,10,10">
            <Border Background="{DynamicResource BgBrush}"
                    BorderBrush="{DynamicResource LineBrush}" BorderThickness="1"
                    CornerRadius="12" Padding="10,4,10,4">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <TextBox x:Name="InputBox" Grid.Column="0"
                             BorderThickness="0" Background="Transparent"
                             Foreground="{DynamicResource TextBrush}"
                             CaretBrush="{DynamicResource TextBrush}"
                             FontSize="{DynamicResource Fs12}"
                             FontFamily="{StaticResource PretendardFont}"
                             VerticalContentAlignment="Center"
                             MinHeight="28" MaxHeight="80"
                             TextWrapping="Wrap" AcceptsReturn="False"
                             PreviewKeyDown="InputBox_PreviewKeyDown"
                             TextChanged="InputBox_TextChanged"/>
                    <!-- placeholder (TextBox 가 비었을 때만 노출) -->
                    <TextBlock Grid.Column="0"
                               Text="작업을 입력하고 Enter"
                               IsHitTestVisible="False"
                               Margin="1,0,0,0" VerticalAlignment="Center"
                               Foreground="{DynamicResource TextMutedBrush}"
                               FontSize="{DynamicResource Fs12}"
                               FontFamily="{StaticResource PretendardFont}">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock" BasedOn="{StaticResource {x:Type TextBlock}}">
                                <Setter Property="Visibility" Value="Collapsed"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding Text, ElementName=InputBox}" Value="">
                                        <Setter Property="Visibility" Value="Visible"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>
                    <!-- Enter 활성화 표시(텍스트가 있을 때만) — 보내기 아이콘 -->
                    <Path x:Name="SendHint" Grid.Column="1"
                          Style="{StaticResource LucideIcon}"
                          Data="{StaticResource IconArrowRight}"
                          Width="13" Height="13"
                          Stroke="{DynamicResource TextMutedBrush}"
                          VerticalAlignment="Center" Margin="6,0,0,0"
                          Opacity="0.4"/>
                </Grid>
            </Border>
        </Border>
    </Grid>
</UserControl>
