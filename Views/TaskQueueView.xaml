<UserControl x:Class="DevezCode.Views.TaskQueueView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:models="clr-namespace:DevezCode.Models"
             Background="{DynamicResource PanelBrush}"
             FontFamily="{StaticResource PretendardFont}">
    <UserControl.Resources>
        <!-- 동적 MaxWidth: ListBox 폭에서 padding(20) 빼기. 패널 폭에 맞춰 자동 조정. -->
        <models:SubtractConverter x:Key="Subtract"/>

        <!-- ── 버블 우클릭 컨텍스트 메뉴 (doit 정합: 복사 / 삭제).
              주의: Setter.Value 내부에 인라인으로 두면 WPF 컴파일러가 자식 요소들을
              부모 ListBoxItem 에 매핑하면서 connectionId 가 충돌해 런타임에
              InvalidCastException 이 발생한다. 그래서 리소스로 분리해 StaticResource 로 참조. -->
        <ContextMenu x:Key="BubbleContextMenu" Opened="BubbleContextMenu_Opened">
            <MenuItem Click="BubbleCopy_Click">
                <MenuItem.Icon>
                    <Path Style="{StaticResource LucideMenuIcon}" Data="{StaticResource IconCopy}"/>
                </MenuItem.Icon>
            </MenuItem>
            <Separator/>
            <MenuItem Click="BubbleDelete_Click">
                <MenuItem.Icon>
                    <Path Style="{StaticResource LucideMenuIcon}" Data="{StaticResource IconTrash2}"/>
                </MenuItem.Icon>
            </MenuItem>
        </ContextMenu>

        <!-- ── 버블 한 줄: doit/devez 정합 — BubbleWrapper Grid 안에
              (a) BubbleBorder(BubbleBorderBrush 1px 외곽) + (b) SelectionRing(선택 시 Primary 1.5px 외곽)을 sibling 으로 배치.
              둘 다 BubbleWrapper 사이즈를 채우므로 SelectionRing 이 자동으로 버블 외곽에 정렬됨.
              CornerRadius: BubbleBorder 14,14,4,14 / SelectionRing 15,15,5,15 (= outer+0.75 × 2) / BubbleInner 13,13,3,13. -->
        <DataTemplate x:Key="TaskBubbleTemplate" DataType="{x:Type models:TaskQueueItem}">
            <Grid Margin="0,3" Background="Transparent" HorizontalAlignment="Stretch">
                <Grid x:Name="BubbleWrapper"
                      HorizontalAlignment="Right"
                      MaxWidth="{Binding ActualWidth, RelativeSource={RelativeSource AncestorType=ListBox}, Converter={StaticResource Subtract}, ConverterParameter=20}">
                    <!-- (a) 본체: 이중 border -->
                    <Border x:Name="BubbleBorder"
                            Background="{DynamicResource BubbleBorderBrush}"
                            CornerRadius="14,14,4,14"
                            Padding="1"
                            UseLayoutRounding="True"
                            SnapsToDevicePixels="True"
                            Focusable="False">
                        <Border x:Name="BubbleInner"
                                Background="{DynamicResource BubbleBrush}"
                                CornerRadius="13,13,3,13"
                                Padding="14,10">
                            <TextBlock Text="{Binding Text}"
                                       TextWrapping="Wrap"
                                       FontSize="{DynamicResource Fs14}"
                                       Foreground="{DynamicResource TextBrush}"/>
                        </Border>
                    </Border>
                    <!-- (b) 선택 링: IsHitTestVisible=False 로 클릭이 ListBoxItem 으로 전달됨.
                          Visibility 는 DataTrigger 로 ListBoxItem.IsSelected 에 연동. -->
                    <Border x:Name="SelectionRing"
                            IsHitTestVisible="False"
                            CornerRadius="15,15,5,15"
                            BorderBrush="{DynamicResource PrimaryBrush}"
                            BorderThickness="1.5"
                            SnapsToDevicePixels="False"
                            UseLayoutRounding="False"
                            Visibility="Collapsed"/>
                </Grid>
            </Grid>
            <DataTemplate.Triggers>
                <!-- 선택 시 링 노출 (ListBoxItem.IsSelected → DataTemplate) -->
                <DataTrigger Binding="{Binding IsSelected, RelativeSource={RelativeSource AncestorType=ListBoxItem}}" Value="True">
                    <Setter TargetName="SelectionRing" Property="Visibility" Value="Visible"/>
                </DataTrigger>
            </DataTemplate.Triggers>
        </DataTemplate>
    </UserControl.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- 버블 리스트 + 빈 안내 (탭 자체가 '작업 큐' 제목 역할 → 내부 헤더 생략, 바로 메시지 콘텐츠) -->
        <Grid Grid.Row="0">
            <StackPanel x:Name="EmptyHint" VerticalAlignment="Center" HorizontalAlignment="Center"
                        Visibility="Collapsed">
                <Path Style="{StaticResource LucideIcon}" Data="{StaticResource IconListTodo}"
                      Width="32" Height="32" Stroke="{DynamicResource TextMutedBrush}"
                      HorizontalAlignment="Center" Opacity="0.5"/>
                <TextBlock Text="아직 작업이 없어요."
                           Margin="0,10,0,0" FontSize="{DynamicResource Fs12}"
                           Foreground="{DynamicResource TextMutedBrush}" TextAlignment="Center"/>
                <TextBlock Text="아래에서 텍스트를 입력하고 Enter"
                           Margin="0,4,0,0" FontSize="{DynamicResource Fs11}"
                           Foreground="{DynamicResource TextMutedBrush}" TextAlignment="Center" Opacity="0.7"/>
            </StackPanel>

            <Border Padding="10,10">
                <ListBox x:Name="BubblesList"
                         ItemsSource="{Binding Items}"
                         ItemTemplate="{StaticResource TaskBubbleTemplate}"
                         SelectionMode="Extended"
                         Background="Transparent" BorderThickness="0"
                         Foreground="{DynamicResource TextBrush}"
                         HorizontalContentAlignment="Stretch"
                         ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                         KeyDown="BubblesList_KeyDown"
                         PreviewMouseDown="BubblesList_PreviewMouseDown">
                    <ListBox.ItemContainerStyle>
                        <Style TargetType="ListBoxItem">
                            <Setter Property="Background" Value="Transparent"/>
                            <Setter Property="Padding" Value="0"/>
                            <Setter Property="Margin" Value="0"/>
                            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                            <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
                            <Setter Property="Cursor" Value="Arrow"/>
                            <!-- 우클릭 시: 미선택이면 이 항목만 선택 / 이미 선택(다중)이면 선택 유지 -->
                            <EventSetter Event="PreviewMouseRightButtonDown" Handler="BubbleItem_PreviewRightButtonDown"/>
                            <!-- 컨텍스트 메뉴: UserControl.Resources 에서 정의한 것을 참조.
                                 Setter.Value 인라인에 두면 WPF 컴파일러 connectionId 충돌 발생 → InvalidCastException -->
                            <Setter Property="ContextMenu" Value="{StaticResource BubbleContextMenu}"/>
                            <!-- 커스텀 템플릿: WPF 기본 ListBoxItem 템플릿은 IsSelected 트리거로
                                  파란색 선택 배경을 칠해 행 전체가 색이 들어간 것처럼 보인다.
                                  ContentPresenter 만 두는 미니멀 템플릿으로 기본 트리거를 완전히 제거 →
                                  선택 표시는 DataTemplate 내부의 SelectionRing 으로만 표현.
                                  (doit 정합: 버블 자체에만 외곽선, 행 배경은 항상 투명) -->
                            <Setter Property="Template">
                                <Setter.Value>
                                    <ControlTemplate TargetType="ListBoxItem">
                                        <ContentPresenter/>
                                    </ControlTemplate>
                                </Setter.Value>
                            </Setter>
                        </Style>
                    </ListBox.ItemContainerStyle>
                </ListBox>
            </Border>
        </Grid>

        <!-- 입력 바: doit 정합 — 둥근 배경, 전송 아이콘 없음, Enter 로 추가 -->
        <Border Grid.Row="1"
                Background="{DynamicResource PanelBrush}"
                BorderBrush="{DynamicResource LineBrush}" BorderThickness="0,1,0,0"
                Padding="10,8,10,10">
            <Border Background="{DynamicResource BgBrush}"
                    BorderBrush="{DynamicResource LineBrush}" BorderThickness="1"
                    CornerRadius="12" Padding="10,6,10,6">
                <Grid>
                    <TextBox x:Name="InputBox"
                             BorderThickness="0" Background="Transparent"
                             Foreground="{DynamicResource TextBrush}"
                             CaretBrush="{DynamicResource TextBrush}"
                             FontSize="{DynamicResource Fs13}"
                             FontFamily="{StaticResource PretendardFont}"
                             VerticalContentAlignment="Center"
                             MinHeight="28" MaxHeight="100"
                             TextWrapping="Wrap" AcceptsReturn="True"
                             PreviewKeyDown="InputBox_PreviewKeyDown"
                             TextChanged="InputBox_TextChanged"/>
                    <!-- placeholder (TextBox 가 비었을 때만 노출) -->
                    <TextBlock Text="작업을 입력하고 Enter"
                               IsHitTestVisible="False"
                               Margin="1,0,0,0" VerticalAlignment="Center"
                               Foreground="{DynamicResource TextMutedBrush}"
                               FontSize="{DynamicResource Fs13}"
                               FontFamily="{StaticResource PretendardFont}">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock" BasedOn="{StaticResource {x:Type TextBlock}}">
                                <Setter Property="Visibility" Value="Collapsed"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding Text, ElementName=InputBox}" Value="">
                                        <Setter Property="Visibility" Value="Visible"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>
                </Grid>
            </Border>
        </Border>
    </Grid>
</UserControl>
