<UserControl x:Class="DevezCode.Views.TaskQueueView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:models="clr-namespace:DevezCode.Models"
             Background="{DynamicResource PanelBrush}"
             FontFamily="{StaticResource PretendardFont}">
    <UserControl.Resources>
        <!-- ── 버블 한 줄: 우측 정렬 + content-hugging + 호버 시 X 노출 (devez BubbleBorder 정합) ── -->
        <DataTemplate x:Key="TaskBubbleTemplate" DataType="{x:Type models:TaskQueueItem}">
            <Grid Margin="0,4,0,4" HorizontalAlignment="Stretch">
                <Border HorizontalAlignment="Right"
                        MaxWidth="260"
                        CornerRadius="14,14,4,14"
                        Background="{DynamicResource BubbleBrush}"
                        BorderBrush="{DynamicResource BubbleBorderBrush}"
                        BorderThickness="1"
                        Padding="12,8,12,8"
                        SnapsToDevicePixels="True">
                    <Border.ContextMenu>
                        <ContextMenu>
                            <MenuItem Header="삭제" Click="BubbleDelete_Click" Tag="{Binding}">
                                <MenuItem.Icon>
                                    <Path Style="{StaticResource LucideMenuIcon}" Data="{StaticResource IconTrash2}"/>
                                </MenuItem.Icon>
                            </MenuItem>
                        </ContextMenu>
                    </Border.ContextMenu>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0"
                                   Text="{Binding Text}"
                                   TextWrapping="Wrap"
                                   VerticalAlignment="Center"
                                   FontSize="{DynamicResource Fs12}"
                                   Foreground="{DynamicResource TextBrush}"/>
                        <!-- 호버 시 노출되는 X — WPF의 IsMouseOver는 Border 자체로 옮겨 트리거. -->
                        <Button Grid.Column="1" x:Name="DelBtn"
                                Width="16" Height="16" Margin="6,0,0,0"
                                Click="BubbleDelete_Click" Tag="{Binding}"
                                Background="Transparent" BorderThickness="0"
                                Cursor="Arrow" IsTabStop="False" FocusVisualStyle="{x:Null}"
                                ToolTip="삭제"
                                Visibility="Collapsed"
                                VerticalAlignment="Top">
                            <Button.Template>
                                <ControlTemplate TargetType="Button">
                                    <Border x:Name="Bd" Background="{TemplateBinding Background}" CornerRadius="4">
                                        <Path Style="{StaticResource LucideIcon}" Data="{StaticResource IconX}"
                                              Width="9" Height="9" Stroke="{DynamicResource TextMutedBrush}"/>
                                    </Border>
                                    <ControlTemplate.Triggers>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter TargetName="Bd" Property="Background" Value="{DynamicResource LineBrush}"/>
                                        </Trigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </Button.Template>
                        </Button>
                    </Grid>
                </Border>
            </Grid>
            <DataTemplate.Triggers>
                <!-- 호버 시 X 노출. DataTemplate.Triggers는 DataTemplate 자체의 DataContext(MemoMessage) 기준 -->
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter TargetName="DelBtn" Property="Visibility" Value="Visible"/>
                </Trigger>
            </DataTemplate.Triggers>
        </DataTemplate>
    </UserControl.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="44"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- 헤더: 기존 우측 패널 탭 헤더와 정합(44px). 아이콘 + 카운트 -->
        <Border Grid.Row="0"
                BorderBrush="{DynamicResource LineBrush}" BorderThickness="0,0,0,1"
                Background="{DynamicResource PanelBrush}">
            <Grid Margin="14,0,12,0">
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <Path Style="{StaticResource LucideIcon}" Data="{StaticResource IconListTodo}"
                          Width="15" Height="15" Stroke="{DynamicResource TextMutedBrush}" VerticalAlignment="Center"/>
                    <TextBlock Text="작업 큐" Margin="8,0,0,0" VerticalAlignment="Center"
                               FontSize="{DynamicResource Fs12}" FontWeight="SemiBold"
                               Foreground="{DynamicResource TextBrush}"/>
                    <Border Background="{DynamicResource LineBrush}" CornerRadius="8"
                            Padding="6,1" Margin="8,0,0,0" VerticalAlignment="Center">
                        <TextBlock x:Name="CountText" Text="0"
                                   FontSize="{DynamicResource Fs11}"
                                   Foreground="{DynamicResource TextMutedBrush}"/>
                    </Border>
                </StackPanel>
            </Grid>
        </Border>

        <!-- 버블 리스트 -->
        <Grid Grid.Row="1">
            <!-- 비어 있을 때 안내 (ItemsSource가 null 또는 비어있으면 노출) -->
            <StackPanel x:Name="EmptyHint" VerticalAlignment="Center" HorizontalAlignment="Center"
                        Visibility="Collapsed">
                <Path Style="{StaticResource LucideIcon}" Data="{StaticResource IconListTodo}"
                      Width="32" Height="32" Stroke="{DynamicResource TextMutedBrush}"
                      HorizontalAlignment="Center" Opacity="0.5"/>
                <TextBlock Text="아직 작업이 없어요."
                           Margin="0,10,0,0" FontSize="{DynamicResource Fs12}"
                           Foreground="{DynamicResource TextMutedBrush}" TextAlignment="Center"/>
                <TextBlock Text="아래에서 텍스트를 입력하고 Enter"
                           Margin="0,4,0,0" FontSize="{DynamicResource Fs11}"
                           Foreground="{DynamicResource TextMutedBrush}" TextAlignment="Center" Opacity="0.7"/>
            </StackPanel>

            <ScrollViewer x:Name="BubbleScroller" VerticalScrollBarVisibility="Auto" Padding="10,10">
                <ItemsControl x:Name="BubblesHost" ItemTemplate="{StaticResource TaskBubbleTemplate}"/>
            </ScrollViewer>
        </Grid>

        <!-- 입력 바: AiChatHostView 정합 — 둥근 배경 + Enter로 추가 -->
        <Border Grid.Row="2"
                Background="{DynamicResource PanelBrush}"
                BorderBrush="{DynamicResource LineBrush}" BorderThickness="0,1,0,0"
                Padding="10,8,10,10">
            <Border Background="{DynamicResource BgBrush}"
                    BorderBrush="{DynamicResource LineBrush}" BorderThickness="1"
                    CornerRadius="12" Padding="10,4,10,4">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <TextBox x:Name="InputBox" Grid.Column="0"
                             BorderThickness="0" Background="Transparent"
                             Foreground="{DynamicResource TextBrush}"
                             CaretBrush="{DynamicResource TextBrush}"
                             FontSize="{DynamicResource Fs12}"
                             FontFamily="{StaticResource PretendardFont}"
                             VerticalContentAlignment="Center"
                             MinHeight="28" MaxHeight="80"
                             TextWrapping="Wrap" AcceptsReturn="False"
                             PreviewKeyDown="InputBox_PreviewKeyDown"
                             TextChanged="InputBox_TextChanged"/>
                    <!-- placeholder (TextBox 가 비었을 때만 노출) -->
                    <TextBlock Grid.Column="0"
                               Text="작업을 입력하고 Enter"
                               IsHitTestVisible="False"
                               Margin="1,0,0,0" VerticalAlignment="Center"
                               Foreground="{DynamicResource TextMutedBrush}"
                               FontSize="{DynamicResource Fs12}"
                               FontFamily="{StaticResource PretendardFont}">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock" BasedOn="{StaticResource {x:Type TextBlock}}">
                                <Setter Property="Visibility" Value="Collapsed"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding Text, ElementName=InputBox}" Value="">
                                        <Setter Property="Visibility" Value="Visible"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>
                    <!-- Enter 활성화 표시(텍스트가 있을 때만) — 보내기 아이콘 -->
                    <Path x:Name="SendHint" Grid.Column="1"
                          Style="{StaticResource LucideIcon}"
                          Data="{StaticResource IconArrowRight}"
                          Width="13" Height="13"
                          Stroke="{DynamicResource TextMutedBrush}"
                          VerticalAlignment="Center" Margin="6,0,0,0"
                          Opacity="0.4"/>
                </Grid>
            </Border>
        </Border>
    </Grid>
</UserControl>
