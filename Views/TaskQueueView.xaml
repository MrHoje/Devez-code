<UserControl x:Class="DevezCode.Views.TaskQueueView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:models="clr-namespace:DevezCode.Models"
             Background="{DynamicResource PanelBrush}"
             FontFamily="{StaticResource PretendardFont}"
             PreviewMouseLeftButtonDown="Root_PreviewMouseLeftButtonDown"
             PreviewMouseLeftButtonUp="Root_PreviewMouseLeftButtonUp"
             PreviewMouseMove="Root_PreviewMouseMove"
             PreviewKeyDown="Root_PreviewKeyDown"
             DataContextChanged="TaskQueueView_DataContextChanged">
    <UserControl.Resources>
        <models:SubtractConverter x:Key="Subtract"/>

        <!-- ── 컨텍스트 메뉴 (Setter.Value 인라인 X → 리소스로 분리) ── -->
        <ContextMenu x:Key="BubbleContextMenu" Opened="BubbleContextMenu_Opened" Closed="BubbleContextMenu_Closed">
            <MenuItem Click="BubbleCopy_Click">
                <MenuItem.Icon>
                    <Path Style="{StaticResource LucideMenuIcon}" Data="{StaticResource IconCopy}"/>
                </MenuItem.Icon>
            </MenuItem>
            <MenuItem Header="줄별로 분리" Click="BubbleSplit_Click">
                <MenuItem.Icon>
                    <Path Style="{StaticResource LucideMenuIcon}" Data="{StaticResource IconScissors}"/>
                </MenuItem.Icon>
            </MenuItem>
            <Separator/>
            <MenuItem Click="BubbleDelete_Click">
                <MenuItem.Icon>
                    <Path Style="{StaticResource LucideMenuIcon}" Data="{StaticResource IconTrash2}"/>
                </MenuItem.Icon>
            </MenuItem>
        </ContextMenu>
    </UserControl.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- ── 선택 모드 액션바 (debit 정합: IsSelectionMode=true 일 때만 노출, N개 삭제) ── -->
        <Border x:Name="SelectionActionBar" Grid.Row="0" Height="44"
                Background="{DynamicResource PanelBrush}"
                BorderBrush="{DynamicResource LineBrush}" BorderThickness="0,0,0,1"
                Visibility="Collapsed">
            <Grid Margin="14,0,12,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <Button Grid.Column="0" Click="CancelSelection_Click"
                        Style="{StaticResource IconButton}" Width="28" Height="28"
                        ToolTip="선택 취소 (Esc)" VerticalAlignment="Center">
                    <Path Style="{StaticResource LucideButtonIcon}"
                          Data="{StaticResource IconX}" Width="14" Height="14"/>
                </Button>
                <TextBlock Grid.Column="1" x:Name="SelectionCountText"
                           VerticalAlignment="Center" Margin="10,0,0,0"
                           FontSize="{DynamicResource Fs13}" FontWeight="SemiBold"
                           Foreground="{DynamicResource TextBrush}"
                           Text="0개 선택"/>
                <Button Grid.Column="2" x:Name="DeleteSelectedBtn" Click="DeleteSelected_Click"
                        Height="28" Padding="12,0" Cursor="Arrow"
                        Style="{StaticResource PrimaryButton}"
                        VerticalAlignment="Center"
                        FontSize="{DynamicResource Fs12}">
                    <TextBlock Text="삭제" Foreground="White"/>
                </Button>
            </Grid>
        </Border>

        <!-- ── 버블 리스트 (debit MemoList 정합) ── -->
        <Grid Grid.Row="1">
            <!-- 비어있을 때 안내 -->
            <StackPanel x:Name="EmptyHint" VerticalAlignment="Center" HorizontalAlignment="Center"
                        Visibility="Collapsed">
                <Path Style="{StaticResource LucideIcon}" Data="{StaticResource IconListTodo}"
                      Width="32" Height="32" Stroke="{DynamicResource TextMutedBrush}"
                      HorizontalAlignment="Center" Opacity="0.5"/>
                <TextBlock Text="아직 작업이 없어요."
                           Margin="0,10,0,0" FontSize="{DynamicResource Fs12}"
                           Foreground="{DynamicResource TextMutedBrush}" TextAlignment="Center"/>
                <TextBlock Text="아래에서 텍스트를 입력하고 Enter"
                           Margin="0,4,0,0" FontSize="{DynamicResource Fs11}"
                           Foreground="{DynamicResource TextMutedBrush}" TextAlignment="Center" Opacity="0.7"/>
            </StackPanel>

            <ListBox x:Name="BubblesList"
                     ItemsSource="{Binding Items}"
                     Background="Transparent" BorderThickness="0" Padding="0,12,0,0"
                     Focusable="False"
                     HorizontalContentAlignment="Stretch"
                     ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                     ScrollViewer.VerticalScrollBarVisibility="Auto"
                     ScrollViewer.CanContentScroll="True"
                     VirtualizingPanel.IsVirtualizing="True"
                     VirtualizingPanel.VirtualizationMode="Recycling"
                     VirtualizingPanel.ScrollUnit="Pixel"
                     KeyDown="BubblesList_KeyDown">
                <ListBox.ItemContainerStyle>
                    <Style TargetType="ListBoxItem">
                        <Setter Property="Padding" Value="0"/>
                        <Setter Property="Margin" Value="0"/>
                        <Setter Property="Background" Value="Transparent"/>
                        <Setter Property="BorderThickness" Value="0"/>
                        <Setter Property="Focusable" Value="False"/>
                        <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                        <Setter Property="Cursor" Value="Arrow"/>
                        <!-- 커스텀 템플릿 (ContentPresenter 만): WPF 기본 ListBoxItem 템플릿의
                              IsSelected 트리거가 행 전체에 색을 칠하는 함정 회피. -->
                        <Setter Property="Template">
                            <Setter.Value>
                                <ControlTemplate TargetType="ListBoxItem">
                                    <ContentPresenter/>
                                </ControlTemplate>
                            </Setter.Value>
                        </Setter>
                        <Setter Property="ContextMenu" Value="{StaticResource BubbleContextMenu}"/>
                    </Style>
                </ListBox.ItemContainerStyle>
                <ListBox.Resources>
                    <!-- ── 버블 한 줄: doit MemoMessage 템플릿의 task queue 슬림 버전 ──
                          BubbleRow(Grid) + SelectCheck(CheckBox) + BubbleDock(DockPanel) + BubbleWrapper(Grid) + SelectionRing/BubbleBorder/BubbleInner/TextBlock.
                          코드블럭/태그/핀/별/시트/할일/타이머/첨부/URL/링크프리뷰/댓글/공유/일정등록/편집/AI채팅 모두 제외. -->
                    <DataTemplate DataType="{x:Type models:TaskQueueItem}">
                        <Grid Margin="0,3" x:Name="BubbleRow" Background="Transparent">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>

                            <!-- SelectCheck: 버블 우측(절대 좌표) 오버레이. IsSelectionMode ON 일 때만 표시.
                                  Opacity 트리거로 노출/숨김 → 레이아웃 영향 없음, 가상화 ListBox 우루루 차단. -->
                            <CheckBox x:Name="SelectCheck"
                                      IsChecked="{Binding IsSelected}"
                                      HorizontalAlignment="Right" VerticalAlignment="Bottom"
                                      Margin="0,0,11,6"
                                      Opacity="0" IsHitTestVisible="False"
                                      Style="{StaticResource ModernCheckBox}"/>

                            <DockPanel x:Name="BubbleDock"
                                       HorizontalAlignment="Right"
                                       LastChildFill="False"
                                       Margin="0,0,22,0">
                                <DockPanel.RenderTransform>
                                    <TranslateTransform X="0"/>
                                </DockPanel.RenderTransform>
                                <Grid DockPanel.Dock="Right"
                                      x:Name="BubbleWrapper"
                                      MaxWidth="{Binding ActualWidth, ElementName=BubblesList,
                                                 Converter={StaticResource Subtract}, ConverterParameter=20}">
                                    <!-- SelectionRing: BubbleWrapper 내부 sibling. BubbleBorder 와 독립.
                                          IsHighlighted(IsSelected || IsRightClickHighlighted) → Visible.
                                          BubbleBorder 의 테두리/배경과 같게 따라가도록 CornerRadius 바인딩. -->
                                    <Border x:Name="SelectionRing"
                                            Panel.ZIndex="10"
                                            CornerRadius="{Binding CornerRadius, ElementName=BubbleBorder}"
                                            BorderBrush="{DynamicResource PrimaryBrush}"
                                            BorderThickness="1.5"
                                            Background="Transparent"
                                            IsHitTestVisible="False"
                                            SnapsToDevicePixels="False"
                                            UseLayoutRounding="False"
                                            Visibility="Collapsed"/>
                                    <Border x:Name="BubbleBorder"
                                            Background="{DynamicResource BubbleBorderBrush}"
                                            CornerRadius="14,14,4,14"
                                            Padding="1"
                                            UseLayoutRounding="True"
                                            SnapsToDevicePixels="True"
                                            Focusable="False"
                                            PreviewMouseLeftButtonDown="Bubble_PreviewMouseLeftButtonDown"
                                            MouseLeftButtonDown="Bubble_LeftClick"
                                            MouseRightButtonDown="Bubble_RightClick">
                                        <Border x:Name="BubbleInner"
                                                Background="{DynamicResource BubbleBrush}"
                                                CornerRadius="13,13,3,13"
                                                Padding="14,10">
                                            <TextBlock Text="{Binding Text}"
                                                       TextWrapping="Wrap"
                                                       FontSize="{DynamicResource Fs14}"
                                                       Foreground="{DynamicResource TextBrush}"/>
                                        </Border>
                                    </Border>
                                </Grid>
                            </DockPanel>
                        </Grid>
                        <DataTemplate.Triggers>
                            <!-- 하이라이트(선택 OR 우클릭) → SelectionRing 노출 -->
                            <DataTrigger Binding="{Binding IsHighlighted}" Value="True">
                                <Setter TargetName="SelectionRing" Property="Visibility" Value="Visible"/>
                            </DataTrigger>
                            <!-- 드래그 병합 도착지 → 두꺼운 링으로 "여기에 합쳐짐" 표시 (devez IsMergeHoverIndicatorVisible) -->
                            <DataTrigger Binding="{Binding IsMergeTarget}" Value="True">
                                <Setter TargetName="SelectionRing" Property="Visibility" Value="Visible"/>
                                <Setter TargetName="SelectionRing" Property="BorderThickness" Value="2.5"/>
                            </DataTrigger>
                            <!-- IsSelectionMode ON → SelectCheck 표시 + 버블 좌측으로 16 이동(체크박스 자리 확보) -->
                            <DataTrigger Binding="{Binding DataContext.IsSelectionMode,
                                                    RelativeSource={RelativeSource AncestorType=UserControl}}"
                                         Value="True">
                                <Setter TargetName="SelectCheck" Property="Opacity"         Value="1"/>
                                <Setter TargetName="SelectCheck" Property="IsHitTestVisible" Value="True"/>
                                <Setter TargetName="BubbleDock" Property="RenderTransform">
                                    <Setter.Value>
                                        <TranslateTransform X="-16"/>
                                    </Setter.Value>
                                </Setter>
                            </DataTrigger>
                        </DataTemplate.Triggers>
                    </DataTemplate>
                </ListBox.Resources>
            </ListBox>

            <!-- ── 러버밴드 오버레이: 빈 영역 드래그로 다중선택 ── -->
            <Canvas x:Name="RubberBandCanvas"
                    Panel.ZIndex="23"
                    IsHitTestVisible="False"
                    ClipToBounds="True"
                    Visibility="Collapsed">
                <Rectangle x:Name="RubberBandRect"
                           Stroke="{DynamicResource PrimaryBrush}"
                           StrokeThickness="1"
                           RadiusX="2" RadiusY="2">
                    <Rectangle.Fill>
                        <SolidColorBrush Color="{DynamicResource PrimaryColor}" Opacity="0.12"/>
                    </Rectangle.Fill>
                </Rectangle>
            </Canvas>

            <!-- ── 드래그 고스트: 버블을 끌 때 커서를 따라다니는 반투명 미니 버블 ── -->
            <Canvas x:Name="DragGhostLayer"
                    Panel.ZIndex="30"
                    IsHitTestVisible="False"
                    Visibility="Collapsed">
                <Border x:Name="DragGhost"
                        Opacity="0.75"
                        Background="{DynamicResource BubbleBrush}"
                        BorderBrush="{DynamicResource PrimaryBrush}" BorderThickness="1"
                        CornerRadius="13,13,3,13" Padding="12,8" MaxWidth="240">
                    <Grid>
                        <TextBlock x:Name="DragGhostText"
                                   TextWrapping="NoWrap" TextTrimming="CharacterEllipsis"
                                   FontSize="{DynamicResource Fs13}"
                                   Foreground="{DynamicResource TextBrush}"/>
                        <Border x:Name="DragGhostBadge"
                                Visibility="Collapsed"
                                HorizontalAlignment="Right" VerticalAlignment="Top"
                                Margin="0,-16,-8,0"
                                Background="{DynamicResource PrimaryBrush}"
                                CornerRadius="9" MinWidth="18" Height="18" Padding="5,0">
                            <TextBlock x:Name="DragGhostBadgeText"
                                       Foreground="White" FontSize="11" FontWeight="SemiBold"
                                       HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                    </Grid>
                </Border>
            </Canvas>
        </Grid>

        <!-- ── 입력 바: doit 정합 (단일 라인, 둥근 배경, Enter=추가) ── -->
        <Border Grid.Row="2"
                Background="{DynamicResource PanelBrush}"
                BorderBrush="{DynamicResource LineBrush}" BorderThickness="0,1,0,0"
                Padding="10,8,10,10">
            <Border Background="{DynamicResource BgBrush}"
                    BorderBrush="{DynamicResource LineBrush}" BorderThickness="1"
                    CornerRadius="12" Padding="10,6,10,6">
                <Grid>
                    <TextBox x:Name="InputBox"
                             BorderThickness="0" Background="Transparent"
                             Foreground="{DynamicResource TextBrush}"
                             CaretBrush="{DynamicResource TextBrush}"
                             FontSize="{DynamicResource Fs13}"
                             FontFamily="{StaticResource PretendardFont}"
                             VerticalContentAlignment="Center"
                             MinHeight="28" MaxHeight="100"
                             TextWrapping="Wrap" AcceptsReturn="True"
                             PreviewKeyDown="InputBox_PreviewKeyDown"
                             TextChanged="InputBox_TextChanged"/>
                    <TextBlock Text="작업을 입력하고 Enter"
                               IsHitTestVisible="False"
                               Margin="1,0,0,0" VerticalAlignment="Center"
                               Foreground="{DynamicResource TextMutedBrush}"
                               FontSize="{DynamicResource Fs13}"
                               FontFamily="{StaticResource PretendardFont}">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock" BasedOn="{StaticResource {x:Type TextBlock}}">
                                <Setter Property="Visibility" Value="Collapsed"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding Text, ElementName=InputBox}" Value="">
                                        <Setter Property="Visibility" Value="Visible"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>
                </Grid>
            </Border>
        </Border>
    </Grid>
</UserControl>
