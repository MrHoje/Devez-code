<UserControl x:Class="DevezCode.Views.GitScmView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:models="clr-namespace:DevezCode.Models"
             xmlns:v="clr-namespace:DevezCode.Views"
             Background="{DynamicResource PanelBrush}"
             FontFamily="{StaticResource PretendardFont}">
    <UserControl.Resources>
        <!-- TreeViewItem: 파일 탐색기식(삼각형 + 행 + 들여쓴 자식). 행은 StackPanel 로 쌓아
             컨텐츠 크기 기준 레이아웃(중첩 들여쓰기). 트리는 유한 높이 영역에 놓여 내부 ScrollViewer 가
             가상화한다(아래 본문 참고). -->
        <Style x:Key="ScmTreeItem" TargetType="TreeViewItem" BasedOn="{StaticResource {x:Type TreeViewItem}}">
            <Setter Property="IsExpanded" Value="{Binding IsExpanded, Mode=TwoWay}"/>
            <Setter Property="Focusable" Value="False"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TreeViewItem">
                        <!-- 루트는 반드시 Grid(행 Auto/*) — ItemsPresenter 를 Grid 행에 둬야 계층 UI 가상화가
                             유지된다. 세로 StackPanel 로 감싸면 자식(중첩 VirtualizingStackPanel)이 무한 높이로
                             측정돼 가상화가 꺼지고, 트리가 전부 펼쳐진 상태에서 변경이 많으면 모든 컨테이너가
                             한꺼번에 실체화 → 스크롤 중 리소스 고갈로 앱이 죽는다. (파일 탐색기 템플릿과 동일 구조) -->
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition/>
                            </Grid.RowDefinitions>
                            <!-- 행 전체를 한 Border 로 감싸 hover 안정화(경계 넘나들며 깜빡이던 문제 해결).
                                 펼침 삼각형은 헤더(데이터 템플릿) 안 표시전용 Path — 토글은 Node_Click 한 곳에서만
                                 처리해 더블토글(두 번 동작해 제자리) 방지. -->
                            <Border x:Name="Bd" Grid.Row="0" CornerRadius="6" Background="Transparent" SnapsToDevicePixels="True">
                                <ContentPresenter ContentSource="Header"
                                                  HorizontalAlignment="Stretch" Margin="0,3,0,3"/>
                            </Border>
                            <ItemsPresenter x:Name="ItemsHost" Grid.Row="1" Margin="16,0,0,0"
                                            Visibility="Collapsed" v:SlideExpand.IsEnabled="True"/>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <!-- ItemsHost 가시성/높이는 v:SlideExpand 가 애니메이션과 함께 관리(트리거 제거) -->
                            <Trigger SourceName="Bd" Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource HoverBrush}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- 노드 행: 폴더/파일 아이콘 + 이름 + (액션) + 우측 상태글자. ItemsSource=Children 로 재귀. -->
        <HierarchicalDataTemplate x:Key="ScmNode" DataType="{x:Type models:ScmTreeNode}" ItemsSource="{Binding Children}">
            <Grid Background="Transparent" MouseLeftButtonDown="Node_Click">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="16"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <!-- 펼침 삼각형: 폴더만, 펼치면 90° 회전. 화살표(이 Border)는 단일 클릭으로 토글. -->
                <Border Grid.Column="0" Background="Transparent" MouseLeftButtonDown="Tri_Click" Margin="0,0,2,0">
                    <Path x:Name="Tri" Width="8" Height="8" Stretch="Uniform"
                          Fill="{DynamicResource TextMutedBrush}" Data="M 0 0 L 4 4 L 0 8 Z"
                          RenderTransformOrigin="0.5,0.5"
                          HorizontalAlignment="Center" VerticalAlignment="Center"/>
                </Border>
                <!-- 파일 탐색기와 동일한 확장자별 Visual Studio 파일 아이콘. -->
                <Grid Grid.Column="1" Width="16" Height="16" VerticalAlignment="Center">
                    <Path x:Name="FallbackFileIcon" Style="{StaticResource LucideIcon}"
                          Data="{Binding Converter={x:Static models:DirIconConverter.Instance}}"
                          Width="14" Height="14" Visibility="Collapsed"
                          Stroke="{DynamicResource TextMutedBrush}"
                          HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    <Image Source="{Binding Converter={x:Static models:VisualStudioFileIconConverter.LightInstance}}"
                           Width="16" Height="16" Stretch="None"
                           Opacity="{DynamicResource LightFileIconOpacity}"/>
                    <Image Source="{Binding Converter={x:Static models:VisualStudioFileIconConverter.DarkInstance}}"
                           Width="16" Height="16" Stretch="None"
                           Opacity="{DynamicResource DarkFileIconOpacity}"/>
                    <Grid x:Name="VisualStudioFolderIcon" Visibility="Collapsed">
                        <Image Source="{Binding IsExpanded, Converter={x:Static models:VisualStudioFolderIconConverter.LightInstance}}"
                               Width="16" Height="16" Stretch="None"
                               Opacity="{DynamicResource LightFileIconOpacity}"/>
                        <Image Source="{Binding IsExpanded, Converter={x:Static models:VisualStudioFolderIconConverter.DarkInstance}}"
                               Width="16" Height="16" Stretch="None"
                               Opacity="{DynamicResource DarkFileIconOpacity}"/>
                    </Grid>
                </Grid>
                <TextBlock Grid.Column="2" Text="{Binding Name}" Margin="7,0,0,0"
                           VerticalAlignment="Center" TextTrimming="CharacterEllipsis"
                           ToolTip="{Binding Change.Path}" v:RowToolTip.ShowWhenTrimmed="True"
                           FontSize="{DynamicResource Fs12}">
                    <TextBlock.Style>
                        <!-- 삭제(D)된 파일은 VS 처럼 취소선 + 살짝 흐린 색 -->
                        <Style TargetType="TextBlock" BasedOn="{StaticResource {x:Type TextBlock}}">
                            <Setter Property="Foreground" Value="{DynamicResource TextBrush}"/>
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding Status}" Value="D">
                                    <Setter Property="TextDecorations" Value="Strikethrough"/>
                                    <Setter Property="Foreground" Value="{DynamicResource TextMutedBrush}"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </TextBlock.Style>
                </TextBlock>
                <!-- 행 액션: discard(↩)+stage(+) 또는 unstage(−). 파일/폴더/루트 공통(Tag=노드).
                     폴더면 하위 전체, 루트면 저장소 전체를 대상으로 동작.
                     평소 숨김 → 행 hover 시에만 노출(리플로우 없음). -->
                <Button x:Name="DiscardBtn" Grid.Column="3" Tag="{Binding}"
                        Click="Discard_Click" Style="{StaticResource IconButton}" Width="20" Height="16" Padding="2" VerticalAlignment="Center"
                        Visibility="Collapsed" ToolTip="변경 취소">
                    <Path Data="{StaticResource IconRotateCcw}" Width="10" Height="10" Stretch="Uniform"
                          Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                          StrokeThickness="1.5" StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round"/>
                </Button>
                <Button x:Name="StageBtn" Grid.Column="4" Tag="{Binding}"
                        Click="Stage_Click" Style="{StaticResource IconButton}" Width="20" Height="16" Padding="2" Margin="0,0,9,0" VerticalAlignment="Center"
                                    Visibility="Collapsed" ToolTip="스테이징">
                    <Path Data="{StaticResource IconPlus}" Width="10" Height="10" Stretch="Uniform"
                          Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                          StrokeThickness="1.5" StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round"/>
                </Button>
                <Button x:Name="UnstageBtn" Grid.Column="4" Tag="{Binding}"
                        Click="Unstage_Click" Style="{StaticResource IconButton}" Width="20" Height="16" Padding="2" Margin="0,0,9,0" VerticalAlignment="Center"
                                     Visibility="Collapsed" ToolTip="스테이징 해제">
                    <Rectangle Width="8" Height="1.5" RadiusX="1" RadiusY="1"
                               Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"/>
                </Button>
                <!-- 파일 상태 글자(폴더면 빈칸) — 우측 정렬. Diff Git 미사용 시 숨김. -->
                <TextBlock Grid.Column="5" Text="{Binding Status}" Width="14" Margin="11,0,12,0"
                           VerticalAlignment="Center" TextAlignment="Center"
                           FontWeight="Bold" FontSize="{DynamicResource Fs8}" Foreground="{Binding StatusColor}">
                    <TextBlock.Style>
                        <Style TargetType="TextBlock" BasedOn="{StaticResource {x:Type TextBlock}}">
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding DiffGitEnabled, Source={x:Static models:GitUiState.Instance}}" Value="False">
                                    <Setter Property="Visibility" Value="Collapsed"/>
                                </DataTrigger>
                                <!-- 행 hover 시 상태글자 숨김(칼럼 Auto → 폭 0) → 우측 액션 버튼이 오른쪽 끝에 붙음. -->
                                <DataTrigger Binding="{Binding IsMouseOver, RelativeSource={RelativeSource AncestorType={x:Type Border}}}" Value="True">
                                    <Setter Property="Visibility" Value="Collapsed"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </TextBlock.Style>
                </TextBlock>
            </Grid>
            <HierarchicalDataTemplate.Triggers>
                <!-- 파일이면 삼각형 숨김 -->
                <DataTrigger Binding="{Binding IsFolder}" Value="False">
                    <Setter TargetName="Tri" Property="Visibility" Value="Hidden"/>
                </DataTrigger>
                <!-- 펼침 시 삼각형 90° 회전(▶→▼) -->
                <DataTrigger Binding="{Binding IsExpanded}" Value="True">
                    <Setter TargetName="Tri" Property="RenderTransform">
                        <Setter.Value><RotateTransform Angle="90"/></Setter.Value>
                    </Setter>
                </DataTrigger>
                <MultiDataTrigger>
                    <MultiDataTrigger.Conditions>
                        <Condition Binding="{Binding IsFolder}" Value="False"/>
                        <Condition Binding="{Binding Converter={x:Static models:VisualStudioFileIconConverter.LightInstance}}"
                                   Value="{x:Null}"/>
                    </MultiDataTrigger.Conditions>
                    <Setter TargetName="FallbackFileIcon" Property="Visibility" Value="Visible"/>
                </MultiDataTrigger>
                <DataTrigger Binding="{Binding IsFolder}" Value="True">
                    <Setter TargetName="VisualStudioFolderIcon" Property="Visibility" Value="Visible"/>
                </DataTrigger>
                <!-- 평소엔 버튼 숨김 → 이름이 M/U 바로 옆까지 표시. hover 시에만 상태별 버튼 노출
                     → 이름 칼럼이 줄며 자동으로 …(CharacterEllipsis) 처리.
                     hover 판정은 행 Border(AncestorType=Border=템플릿의 Bd)로 한정 — TreeViewItem 로 잡으면
                     자식 행 hover 시 조상 폴더 버튼까지 동시에 점등된다. -->
                <!-- staged 행(파일/폴더/루트) & hover → unstage -->
                <MultiDataTrigger>
                    <MultiDataTrigger.Conditions>
                        <Condition Binding="{Binding DiffGitEnabled, Source={x:Static models:GitUiState.Instance}}" Value="True"/>
                        <Condition Binding="{Binding IsMouseOver, RelativeSource={RelativeSource AncestorType={x:Type Border}}}" Value="True"/>
                        <Condition Binding="{Binding IsStaged}" Value="True"/>
                    </MultiDataTrigger.Conditions>
                    <Setter TargetName="UnstageBtn" Property="Visibility" Value="Visible"/>
                </MultiDataTrigger>
                <!-- 작업트리 행(파일/폴더/루트) & hover → discard + stage (Diff Git 사용 시에만) -->
                <MultiDataTrigger>
                    <MultiDataTrigger.Conditions>
                        <Condition Binding="{Binding DiffGitEnabled, Source={x:Static models:GitUiState.Instance}}" Value="True"/>
                        <Condition Binding="{Binding IsMouseOver, RelativeSource={RelativeSource AncestorType={x:Type Border}}}" Value="True"/>
                        <Condition Binding="{Binding IsStaged}" Value="False"/>
                    </MultiDataTrigger.Conditions>
                    <Setter TargetName="DiscardBtn" Property="Visibility" Value="Visible"/>
                    <Setter TargetName="StageBtn" Property="Visibility" Value="Visible"/>
                </MultiDataTrigger>
            </HierarchicalDataTemplate.Triggers>
        </HierarchicalDataTemplate>

        <!-- 커밋 버튼: PrimaryButton 과 동일하되 라운드만 절반(10→5) -->
        <Style x:Key="CommitButton" TargetType="Button" BasedOn="{StaticResource PrimaryButton}">
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd" Background="{TemplateBinding Background}" CornerRadius="5" Padding="16,0">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"
                                              TextElement.Foreground="{TemplateBinding Foreground}"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background">
                                    <Setter.Value><SolidColorBrush Color="{DynamicResource PrimaryHoverColor}"/></Setter.Value>
                                </Setter>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Bd" Property="Background">
                                    <Setter.Value><SolidColorBrush Color="{DynamicResource PrimaryPressedColor}"/></Setter.Value>
                                </Setter>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource LineBrush}"/>
                                <Setter TargetName="Bd" Property="Opacity" Value="1"/>
                                <Setter Property="Foreground" Value="{DynamicResource TextMutedBrush}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </UserControl.Resources>
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- 두 트리를 각각 유한 높이 영역에 두어 TreeView 내부 ScrollViewer(가상화)가 동작하게 한다.
             바깥 ScrollViewer/StackPanel(무한높이)에 넣으면 UI 가상화가 꺼져 변경 파일 전부를 매 레이아웃
             패스마다 measure → 대량 변경(예: untracked 폴더) 시 UI 스레드가 코어를 태워 시스템 전체
             입력까지 느려진다. Staged 는 상한(MaxHeight)까지 자라고, Changes 가 남은 공간을 채운다. -->
        <Grid x:Name="ScmBodyGrid" Grid.Row="0" Margin="4">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>
            <!-- 섹션 헤더(클릭 시 트리 통째 접기/펼치기) -->
            <Grid x:Name="StagedHeaderRow" Grid.Row="0" Background="Transparent" Margin="0,11,0,2">
                <Border Background="Transparent" MouseLeftButtonUp="ToggleStaged">
                    <StackPanel Orientation="Horizontal">
                        <StackPanel.RenderTransform><TranslateTransform Y="-2"/></StackPanel.RenderTransform>
                        <Grid Width="16">
                            <Path x:Name="StagedChevron" Width="8" Height="8" Stretch="Uniform"
                                  Data="M 0 0 L 4 4 L 0 8 Z" Fill="{DynamicResource TextMutedBrush}"
                                  RenderTransformOrigin="0.5,0.5"
                                  HorizontalAlignment="Center" VerticalAlignment="Center">
                                <Path.RenderTransform><RotateTransform Angle="90"/></Path.RenderTransform>
                            </Path>
                        </Grid>
                        <TextBlock x:Name="StagedHeader" Text="스테이징된 변경 사항" Margin="2,0,0,0"
                                   FontSize="{DynamicResource Fs12}" FontWeight="SemiBold"
                                   Foreground="{DynamicResource TextBrush}"/>
                    </StackPanel>
                </Border>
            </Grid>
            <!-- 스테이징·변경 둘 다 있을 때만 절반 캡(코드에서 MaxHeight 설정) → 초과 시 내부 스크롤 -->
            <Grid x:Name="StagedTreeHost" Grid.Row="1" Margin="0,0,0,0" ClipToBounds="True">
                <TreeView x:Name="StagedTree"
                          Background="Transparent" BorderThickness="0"
                          VirtualizingStackPanel.IsVirtualizing="True"
                          VirtualizingPanel.VirtualizationMode="Recycling"
                          ItemContainerStyle="{StaticResource ScmTreeItem}"
                          ItemTemplate="{StaticResource ScmNode}"
                          ScrollViewer.ScrollChanged="ScmTree_ScrollChanged"
                          ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                    <TreeView.ItemsPanel>
                        <ItemsPanelTemplate>
                            <VirtualizingStackPanel Margin="0,8,0,8"/>
                        </ItemsPanelTemplate>
                    </TreeView.ItemsPanel>
                </TreeView>
                <Rectangle x:Name="StagedFadeTop" Height="24" VerticalAlignment="Top"
                           IsHitTestVisible="False" Panel.ZIndex="1" Visibility="Collapsed"
                           Fill="{DynamicResource PanelBrush}">
                    <Rectangle.OpacityMask>
                        <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                            <GradientStop Offset="0" Color="Black"/>
                            <GradientStop Offset="0.7" Color="Transparent"/>
                        </LinearGradientBrush>
                    </Rectangle.OpacityMask>
                </Rectangle>
                <Rectangle x:Name="StagedFadeBottom" Height="24" VerticalAlignment="Bottom"
                           IsHitTestVisible="False" Panel.ZIndex="1" Visibility="Collapsed"
                           Fill="{DynamicResource PanelBrush}">
                    <Rectangle.OpacityMask>
                        <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                            <GradientStop Offset="0.3" Color="Transparent"/>
                            <GradientStop Offset="1" Color="Black"/>
                        </LinearGradientBrush>
                    </Rectangle.OpacityMask>
                </Rectangle>
            </Grid>

            <!-- 스테이징·변경내용 둘 다 있을 때만 구분선 -->
            <Border x:Name="SectionSeparator" Grid.Row="2" Height="1" Margin="0,7,0,0"
                    Background="{DynamicResource LineBrush}" Visibility="Collapsed"/>

            <Grid x:Name="ChangesHeaderRow" Grid.Row="3" Background="Transparent" Margin="0,14,0,2">
                <Border Background="Transparent" MouseLeftButtonUp="ToggleUnstaged">
                    <StackPanel Orientation="Horizontal">
                        <StackPanel.RenderTransform><TranslateTransform Y="-2"/></StackPanel.RenderTransform>
                        <Grid Width="16">
                            <Path x:Name="ChangesChevron" Width="8" Height="8" Stretch="Uniform"
                                  Data="M 0 0 L 4 4 L 0 8 Z" Fill="{DynamicResource TextMutedBrush}"
                                  RenderTransformOrigin="0.5,0.5"
                                  HorizontalAlignment="Center" VerticalAlignment="Center">
                                <Path.RenderTransform><RotateTransform Angle="90"/></Path.RenderTransform>
                            </Path>
                        </Grid>
                        <TextBlock x:Name="ChangesHeader" Text="변경 내용" Margin="2,0,0,0"
                                   FontSize="{DynamicResource Fs12}" FontWeight="SemiBold"
                                   Foreground="{DynamicResource TextBrush}"/>
                    </StackPanel>
                </Border>
            </Grid>
            <Grid x:Name="UnstagedTreeHost" Grid.Row="4" Margin="0,0,0,0" ClipToBounds="True">
                <TreeView x:Name="UnstagedTree"
                          Background="Transparent" BorderThickness="0"
                          VirtualizingStackPanel.IsVirtualizing="True"
                          VirtualizingPanel.VirtualizationMode="Recycling"
                          ItemContainerStyle="{StaticResource ScmTreeItem}"
                          ItemTemplate="{StaticResource ScmNode}"
                          ScrollViewer.ScrollChanged="ScmTree_ScrollChanged"
                          ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                    <TreeView.ItemsPanel>
                        <ItemsPanelTemplate>
                            <VirtualizingStackPanel Margin="0,8,0,8"/>
                        </ItemsPanelTemplate>
                    </TreeView.ItemsPanel>
                </TreeView>
                <Rectangle x:Name="ChangesFadeTop" Height="24" VerticalAlignment="Top"
                           IsHitTestVisible="False" Panel.ZIndex="1" Visibility="Collapsed"
                           Fill="{DynamicResource PanelBrush}">
                    <Rectangle.OpacityMask>
                        <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                            <GradientStop Offset="0" Color="Black"/>
                            <GradientStop Offset="0.7" Color="Transparent"/>
                        </LinearGradientBrush>
                    </Rectangle.OpacityMask>
                </Rectangle>
                <Rectangle x:Name="ChangesFadeBottom" Height="24" VerticalAlignment="Bottom"
                           IsHitTestVisible="False" Panel.ZIndex="1" Visibility="Collapsed"
                           Fill="{DynamicResource PanelBrush}">
                    <Rectangle.OpacityMask>
                        <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                            <GradientStop Offset="0.3" Color="Transparent"/>
                            <GradientStop Offset="1" Color="Black"/>
                        </LinearGradientBrush>
                    </Rectangle.OpacityMask>
                </Rectangle>
            </Grid>

            <TextBlock x:Name="EmptyText" Grid.Row="4" Text="변경된 파일이 없습니다." Visibility="Collapsed"
                       Margin="10" TextAlignment="Center" VerticalAlignment="Top"
                       Foreground="{DynamicResource TextMutedBrush}"/>
        </Grid>

        <Border x:Name="GitControlBar" Grid.Row="1" Visibility="Collapsed" Background="{DynamicResource PanelBrush}"
                BorderBrush="{DynamicResource LineBrush}" BorderThickness="0,1,0,0" Padding="8">
            <StackPanel>
                <!-- 동기화 헤더: 브랜치 + ↓N ↑N + fetch/pull/push/sync 아이콘 -->
                <Grid Margin="2,0,0,6">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <Grid Grid.Column="0" Width="14" Height="14" VerticalAlignment="Center" Margin="0,2,0,0">
                        <Path x:Name="BranchIcon" Data="{StaticResource IconGitBranch}" Width="14" Height="14" Stretch="Uniform"
                              Style="{StaticResource LucideIcon}" Stroke="{DynamicResource TextMutedBrush}"
                              HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        <!-- 원격 작업 진행 중엔 브랜치 아이콘 자리에 스피너 -->
                        <Ellipse x:Name="BranchSpinner" Width="14" Height="14" Visibility="Collapsed"
                                 HorizontalAlignment="Center" VerticalAlignment="Center"
                                 models:SpinnerActivator.Track="True"
                                 Stroke="{DynamicResource PrimaryBrush}" StrokeThickness="2"
                                 StrokeDashArray="15 100" StrokeDashCap="Round"
                                 RenderTransformOrigin="0.5,0.5">
                            <Ellipse.RenderTransform>
                                <RotateTransform Angle="{Binding Angle, Source={x:Static models:SpinnerSync.Instance}}"/>
                            </Ellipse.RenderTransform>
                        </Ellipse>
                    </Grid>
                    <TextBlock x:Name="BranchText" Grid.Column="1" Margin="6,0,0,0" VerticalAlignment="Center"
                               TextTrimming="CharacterEllipsis"
                               Foreground="{DynamicResource TextBrush}" FontSize="{DynamicResource Fs12}"/>
                    <!-- fetch(점선 아래 화살표)를 맨 왼쪽으로. 원격 작업 버튼은 동일 크기. -->
                    <Button x:Name="FetchBtn" Grid.Column="2" Click="Fetch_Click"
                            Style="{StaticResource IconButton}" Width="24" Height="24" Padding="3" ToolTip="원격 정보 가져오기">
                        <!-- 좁은 fetch(점선 아래 화살표) — 세로 꽉·가로 좁게 직접 그림 -->
                        <Path Data="M6 1 V13.5 M2.5 9.5 L6 13.5 L9.5 9.5"
                              Style="{StaticResource LucideIcon}" StrokeThickness="1.5" SnapsToDevicePixels="False"
                              StrokeDashArray="0.75 1.4" StrokeDashCap="Round"
                              Width="14" Height="14"
                              Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"/>
                    </Button>
                    <Button x:Name="PullBtn" Grid.Column="3" Click="Pull_Click" Margin="2,0,0,0"
                            Style="{StaticResource IconButton}" Width="24" Height="24" Padding="3" ToolTip="원격 변경 동기화">
                        <!-- 좁은 arrow-down(pull) -->
                        <Path Data="M6 2 V14 M2.5 10 L6 14 L9.5 10"
                              Style="{StaticResource LucideIcon}" StrokeThickness="1.5" SnapsToDevicePixels="False"
                              Width="14" Height="14"
                              Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"/>
                    </Button>
                    <Button x:Name="PushBtn" Grid.Column="4" Click="Push_Click" Margin="2,0,0,0"
                            Style="{StaticResource IconButton}" Width="24" Height="24" Padding="3" ToolTip="원격 저장소에 푸시">
                        <!-- 좁은 arrow-up(push) -->
                        <Path Data="M6 14 V2 M2.5 6 L6 2 L9.5 6"
                              Style="{StaticResource LucideIcon}" StrokeThickness="1.5" SnapsToDevicePixels="False"
                              Width="14" Height="14"
                              Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"/>
                    </Button>
                    <Button x:Name="SyncBtn" Grid.Column="5" Click="Sync_Click" Margin="2,0,0,0"
                            Style="{StaticResource IconButton}" Width="24" Height="24" Padding="4"
                            ToolTip="동기화(가져오기 후 푸시)">
                        <Path Data="{StaticResource IconRefresh}" Width="12" Height="12" Stretch="Uniform"
                              Style="{StaticResource LucideIcon}"
                              Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"/>
                    </Button>
                </Grid>

                <!-- 커밋 메시지 카드 (라운드=아래 커밋 버튼과 동일한 5) -->
                <Border Background="{DynamicResource BgBrush}"
                        BorderBrush="{DynamicResource LineBrush}" BorderThickness="1"
                        CornerRadius="5" Padding="10,6">
                    <Grid>
                        <!-- 높이는 코드비하인드에서 실제 폰트 라인높이×3 으로 확정(테마 폰트크기 연동).
                             MinLines/MaxLines 는 커스텀 폰트 로드 타이밍에 간헐 실패해 사용하지 않음. -->
                        <TextBox x:Name="MsgBox" BorderThickness="0" Background="Transparent"
                                 Foreground="{DynamicResource TextBrush}" CaretBrush="{DynamicResource TextBrush}"
                                 FontFamily="{StaticResource PretendardFont}" FontSize="{DynamicResource Fs12}"
                                 TextWrapping="Wrap" AcceptsReturn="True"
                                 VerticalContentAlignment="Top" VerticalScrollBarVisibility="Auto"
                                 TextChanged="MsgBox_TextChanged" PreviewKeyDown="MsgBox_PreviewKeyDown"/>
                        <TextBlock x:Name="MsgPlaceholder" Text="커밋 메시지 입력" IsHitTestVisible="False"
                                   VerticalAlignment="Top" Margin="1,0,0,0"
                                   Foreground="{DynamicResource TextMutedBrush}"
                                   FontFamily="{StaticResource PretendardFont}" FontSize="{DynamicResource Fs12}">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock" BasedOn="{StaticResource {x:Type TextBlock}}">
                                    <Setter Property="Visibility" Value="Collapsed"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding Text, ElementName=MsgBox}" Value="">
                                            <Setter Property="Visibility" Value="Visible"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>
                    </Grid>
                </Border>

                <!-- 커밋 버튼(전체 폭) -->
                <Button x:Name="CommitBtn" Content="✓ 커밋" Click="Commit_Click" Margin="0,6,0,0"
                        Style="{StaticResource CommitButton}" Height="30" IsEnabled="False"
                        HorizontalAlignment="Stretch" FontSize="{DynamicResource Fs12}"/>
            </StackPanel>
        </Border>
    </Grid>
</UserControl>
