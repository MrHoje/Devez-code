<UserControl x:Class="DevezCode.Views.GitScmView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:models="clr-namespace:DevezCode.Models"
             xmlns:v="clr-namespace:DevezCode.Views"
             Background="{DynamicResource PanelBrush}"
             FontFamily="{StaticResource PretendardFont}">
    <UserControl.Resources>
        <!-- TreeViewItem: 파일 탐색기식(삼각형 + 행 + 들여쓴 자식). 행은 StackPanel 로 쌓아
             컨텐츠 크기 기준 레이아웃(중첩 들여쓰기). 트리는 유한 높이 영역에 놓여 내부 ScrollViewer 가
             가상화한다(아래 본문 참고). -->
        <Style x:Key="ScmTreeItem" TargetType="TreeViewItem" BasedOn="{StaticResource {x:Type TreeViewItem}}">
            <Setter Property="IsExpanded" Value="{Binding IsExpanded, Mode=TwoWay}"/>
            <Setter Property="Focusable" Value="False"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TreeViewItem">
                        <!-- 루트는 반드시 Grid(행 Auto/*) — ItemsPresenter 를 Grid 행에 둬야 계층 UI 가상화가
                             유지된다. 세로 StackPanel 로 감싸면 자식(중첩 VirtualizingStackPanel)이 무한 높이로
                             측정돼 가상화가 꺼지고, 트리가 전부 펼쳐진 상태에서 변경이 많으면 모든 컨테이너가
                             한꺼번에 실체화 → 스크롤 중 리소스 고갈로 앱이 죽는다. (파일 탐색기 템플릿과 동일 구조) -->
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition/>
                            </Grid.RowDefinitions>
                            <!-- 행 전체를 한 Border 로 감싸 hover 안정화(경계 넘나들며 깜빡이던 문제 해결).
                                 펼침 삼각형은 헤더(데이터 템플릿) 안 표시전용 Path — 토글은 Node_Click 한 곳에서만
                                 처리해 더블토글(두 번 동작해 제자리) 방지. -->
                            <Border x:Name="Bd" Grid.Row="0" CornerRadius="6" Background="Transparent" SnapsToDevicePixels="True">
                                <ContentPresenter ContentSource="Header"
                                                  HorizontalAlignment="Stretch" Margin="0,3,0,3"/>
                            </Border>
                            <ItemsPresenter x:Name="ItemsHost" Grid.Row="1" Margin="16,0,0,0"
                                            Visibility="Collapsed" v:SlideExpand.IsEnabled="True"/>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <!-- ItemsHost 가시성/높이는 v:SlideExpand 가 애니메이션과 함께 관리(트리거 제거) -->
                            <Trigger SourceName="Bd" Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource HoverBrush}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- 노드 행: 폴더/파일 아이콘 + 이름 + (액션) + 우측 상태글자. ItemsSource=Children 로 재귀. -->
        <HierarchicalDataTemplate x:Key="ScmNode" DataType="{x:Type models:ScmTreeNode}" ItemsSource="{Binding Children}">
            <Grid Background="Transparent" MouseLeftButtonDown="Node_Click">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="16"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <!-- 펼침 삼각형: 폴더만, 펼치면 90° 회전. 화살표(이 Border)는 단일 클릭으로 토글. -->
                <Border Grid.Column="0" Background="Transparent" MouseLeftButtonDown="Tri_Click" Margin="0,0,2,0">
                    <Path x:Name="Tri" Width="8" Height="8" Stretch="Uniform"
                          Fill="{DynamicResource TextMutedBrush}" Data="M 0 0 L 4 4 L 0 8 Z"
                          RenderTransformOrigin="0.5,0.5"
                          HorizontalAlignment="Center" VerticalAlignment="Center"/>
                </Border>
                <!-- 파일 탐색기와 동일한 확장자별 Visual Studio 파일 아이콘. -->
                <Grid Grid.Column="1" Width="16" Height="16" VerticalAlignment="Center">
                    <Path x:Name="FallbackFileIcon" Style="{StaticResource LucideIcon}"
                          Data="{Binding Converter={x:Static models:DirIconConverter.Instance}}"
                          Width="14" Height="14" Visibility="Collapsed"
                          Stroke="{DynamicResource TextMutedBrush}"
                          HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    <Image Source="{Binding Converter={x:Static models:VisualStudioFileIconConverter.LightInstance}}"
                           Width="16" Height="16" Stretch="None"
                           Opacity="{DynamicResource LightFileIconOpacity}"/>
                    <Image Source="{Binding Converter={x:Static models:VisualStudioFileIconConverter.DarkInstance}}"
                           Width="16" Height="16" Stretch="None"
                           Opacity="{DynamicResource DarkFileIconOpacity}"/>
                    <Grid x:Name="VisualStudioFolderIcon" Visibility="Collapsed">
                        <Image Source="{Binding IsExpanded, Converter={x:Static models:VisualStudioFolderIconConverter.LightInstance}}"
                               Width="16" Height="16" Stretch="None"
                               Opacity="{DynamicResource LightFileIconOpacity}"/>
                        <Image Source="{Binding IsExpanded, Converter={x:Static models:VisualStudioFolderIconConverter.DarkInstance}}"
                               Width="16" Height="16" Stretch="None"
                               Opacity="{DynamicResource DarkFileIconOpacity}"/>
                    </Grid>
                </Grid>
                <TextBlock Grid.Column="2" Text="{Binding Name}" Margin="7,0,0,0"
                           VerticalAlignment="Center" TextTrimming="CharacterEllipsis"
                           ToolTip="{Binding Change.Path}" v:RowToolTip.ShowWhenTrimmed="True"
                           FontSize="{DynamicResource Fs12}">
                    <TextBlock.Style>
                        <!-- 삭제(D)된 파일은 VS 처럼 취소선 + 살짝 흐린 색 -->
                        <Style TargetType="TextBlock" BasedOn="{StaticResource {x:Type TextBlock}}">
                            <Setter Property="Foreground" Value="{DynamicResource TextBrush}"/>
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding Status}" Value="D">
                                    <Setter Property="TextDecorations" Value="Strikethrough"/>
                                    <Setter Property="Foreground" Value="{DynamicResource TextMutedBrush}"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </TextBlock.Style>
                </TextBlock>
                <!-- 행 액션: discard(↩)+stage(+) 또는 unstage(−). 파일/폴더/루트 공통(Tag=노드).
                     폴더면 하위 전체, 루트면 저장소 전체를 대상으로 동작.
                     평소 숨김 → 행 hover 시에만 노출(리플로우 없음). -->
                <Button x:Name="DiscardBtn" Grid.Column="3" Tag="{Binding}"
                        Click="Discard_Click" Style="{StaticResource IconButton}" Width="20" Height="16" Padding="2" VerticalAlignment="Center"
                        Visibility="Collapsed" ToolTip="변경 취소">
                    <Path Data="{StaticResource IconRotateCcw}" Width="10" Height="10" Stretch="Uniform"
                          Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                          StrokeThickness="1.5" StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round"/>
                </Button>
                <Button x:Name="StageBtn" Grid.Column="4" Tag="{Binding}"
                        Click="Stage_Click" Style="{StaticResource IconButton}" Width="20" Height="16" Padding="2" Margin="0,0,9,0" VerticalAlignment="Center"
                                    Visibility="Collapsed" ToolTip="스테이징">
                    <Path Data="{StaticResource IconPlus}" Width="10" Height="10" Stretch="Uniform"
                          Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                          StrokeThickness="1.5" StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round"/>
                </Button>
                <Button x:Name="UnstageBtn" Grid.Column="4" Tag="{Binding}"
                        Click="Unstage_Click" Style="{StaticResource IconButton}" Width="20" Height="16" Padding="2" Margin="0,0,9,0" VerticalAlignment="Center"
                                     Visibility="Collapsed" ToolTip="스테이징 해제">
                    <Rectangle Width="8" Height="1.5" RadiusX="1" RadiusY="1"
                               Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"/>
                </Button>
                <!-- 파일 상태 글자(폴더면 빈칸) — 우측 정렬. Diff Git 미사용 시 숨김. -->
                <TextBlock Grid.Column="5" Text="{Binding Status}" Width="14" Margin="11,0,12,0"
                           VerticalAlignment="Center" TextAlignment="Center"
                           FontWeight="Bold" FontSize="{DynamicResource Fs8}" Foreground="{Binding StatusColor}">
                    <TextBlock.Style>
                        <Style TargetType="TextBlock" BasedOn="{StaticResource {x:Type TextBlock}}">
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding DiffGitEnabled, Source={x:Static models:GitUiState.Instance}}" Value="False">
                                    <Setter Property="Visibility" Value="Collapsed"/>
                                </DataTrigger>
                                <!-- 행 hover 시 상태글자 숨김(칼럼 Auto → 폭 0) → 우측 액션 버튼이 오른쪽 끝에 붙음. -->
                                <DataTrigger Binding="{Binding IsMouseOver, RelativeSource={RelativeSource AncestorType={x:Type Border}}}" Value="True">
                                    <Setter Property="Visibility" Value="Collapsed"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </TextBlock.Style>
                </TextBlock>
            </Grid>
            <HierarchicalDataTemplate.Triggers>
                <!-- 파일이면 삼각형 숨김 -->
                <DataTrigger Binding="{Binding IsFolder}" Value="False">
                    <Setter TargetName="Tri" Property="Visibility" Value="Hidden"/>
                </DataTrigger>
                <!-- 펼침 시 삼각형 90° 회전(▶→▼) -->
                <DataTrigger Binding="{Binding IsExpanded}" Value="True">
                    <Setter TargetName="Tri" Property="RenderTransform">
                        <Setter.Value><RotateTransform Angle="90"/></Setter.Value>
                    </Setter>
                </DataTrigger>
                <MultiDataTrigger>
                    <MultiDataTrigger.Conditions>
                        <Condition Binding="{Binding IsFolder}" Value="False"/>
                        <Condition Binding="{Binding Converter={x:Static models:VisualStudioFileIconConverter.LightInstance}}"
                                   Value="{x:Null}"/>
                    </MultiDataTrigger.Conditions>
                    <Setter TargetName="FallbackFileIcon" Property="Visibility" Value="Visible"/>
                </MultiDataTrigger>
                <DataTrigger Binding="{Binding IsFolder}" Value="True">
                    <Setter TargetName="VisualStudioFolderIcon" Property="Visibility" Value="Visible"/>
                </DataTrigger>
                <!-- 평소엔 버튼 숨김 → 이름이 M/U 바로 옆까지 표시. hover 시에만 상태별 버튼 노출
                     → 이름 칼럼이 줄며 자동으로 …(CharacterEllipsis) 처리.
                     hover 판정은 행 Border(AncestorType=Border=템플릿의 Bd)로 한정 — TreeViewItem 로 잡으면
                     자식 행 hover 시 조상 폴더 버튼까지 동시에 점등된다. -->
                <!-- staged 행(파일/폴더/루트) & hover → unstage -->
                <MultiDataTrigger>
                    <MultiDataTrigger.Conditions>
                        <Condition Binding="{Binding DiffGitEnabled, Source={x:Static models:GitUiState.Instance}}" Value="True"/>
                        <Condition Binding="{Binding IsMouseOver, RelativeSource={RelativeSource AncestorType={x:Type Border}}}" Value="True"/>
                        <Condition Binding="{Binding IsStaged}" Value="True"/>
                    </MultiDataTrigger.Conditions>
                    <Setter TargetName="UnstageBtn" Property="Visibility" Value="Visible"/>
                </MultiDataTrigger>
                <!-- 작업트리 행(파일/폴더/루트) & hover → discard + stage (Diff Git 사용 시에만) -->
                <MultiDataTrigger>
                    <MultiDataTrigger.Conditions>
                        <Condition Binding="{Binding DiffGitEnabled, Source={x:Static models:GitUiState.Instance}}" Value="True"/>
                        <Condition Binding="{Binding IsMouseOver, RelativeSource={RelativeSource AncestorType={x:Type Border}}}" Value="True"/>
                        <Condition Binding="{Binding IsStaged}" Value="False"/>
                    </MultiDataTrigger.Conditions>
                    <Setter TargetName="DiscardBtn" Property="Visibility" Value="Visible"/>
                    <Setter TargetName="StageBtn" Property="Visibility" Value="Visible"/>
                </MultiDataTrigger>
            </HierarchicalDataTemplate.Triggers>
        </HierarchicalDataTemplate>

        <!-- 커밋 버튼: PrimaryButton 과 동일하되 라운드만 절반(10→5) -->
        <Style x:Key="CommitButton" TargetType="Button" BasedOn="{StaticResource PrimaryButton}">
            <Setter Property="IsTabStop" Value="True"/>
            <Setter Property="BorderBrush" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd" Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="5" Padding="16,0">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"
                                              TextElement.Foreground="{TemplateBinding Foreground}"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background">
                                    <Setter.Value><SolidColorBrush Color="{DynamicResource PrimaryHoverColor}"/></Setter.Value>
                                </Setter>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Bd" Property="Background">
                                    <Setter.Value><SolidColorBrush Color="{DynamicResource PrimaryPressedColor}"/></Setter.Value>
                                </Setter>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource LineBrush}"/>
                                <Setter TargetName="Bd" Property="Opacity" Value="1"/>
                                <Setter Property="Foreground" Value="{DynamicResource TextMutedBrush}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Git 패널 내부 탐색: 자주 전환하는 화면이라 움직임 없이 배경·전경만 즉시 바꾼다. -->
        <Style x:Key="GitModeButton" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
            <Setter Property="Cursor" Value="Arrow"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="{DynamicResource TextMutedBrush}"/>
            <Setter Property="BorderBrush" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
            <Setter Property="IsTabStop" Value="True"/>
            <Setter Property="Height" Value="29"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd" Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="7" Padding="6,0">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"
                                              TextElement.Foreground="{TemplateBinding Foreground}"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource PanelSoftBrush}"/>
                                <Setter Property="Foreground" Value="{DynamicResource TextBrush}"/>
                            </Trigger>
                            <Trigger Property="Tag" Value="active">
                                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource PrimarySoftBrush}"/>
                                <Setter Property="Foreground" Value="{DynamicResource PrimaryBrush}"/>
                            </Trigger>
                            <Trigger Property="IsKeyboardFocused" Value="True">
                                <Setter TargetName="Bd" Property="BorderBrush" Value="{DynamicResource PrimaryBrush}"/>
                            </Trigger>
                            <Trigger Property="IsKeyboardFocused" Value="True">
                                <Setter TargetName="Bd" Property="BorderBrush" Value="{DynamicResource TextBrush}"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource LineBrush}"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.35"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="GitFilterButton" TargetType="Button" BasedOn="{StaticResource GitModeButton}">
            <Setter Property="Height" Value="26"/>
            <Setter Property="FontSize" Value="{DynamicResource Fs11}"/>
        </Style>

        <!-- 우측 보조 패널 목록은 선택 시 배경만 강조한다. -->
        <Style x:Key="GitListItem" TargetType="ListBoxItem" BasedOn="{StaticResource {x:Type ListBoxItem}}">
            <Setter Property="Cursor" Value="Arrow"/>
            <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
            <Setter Property="Padding" Value="0"/>
            <Setter Property="Margin" Value="4,1"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ListBoxItem">
                        <Border x:Name="Bd" Background="Transparent" CornerRadius="7">
                            <ContentPresenter/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource HoverBrush}"/>
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource PrimarySoftBrush}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="GitSmallActionButton" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
            <Setter Property="Cursor" Value="Arrow"/>
            <Setter Property="Background" Value="{DynamicResource PanelBrush}"/>
            <Setter Property="Foreground" Value="{DynamicResource TextBrush}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource LineBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
            <Setter Property="Padding" Value="10,0"/>
            <Setter Property="Height" Value="28"/>
            <Setter Property="FontSize" Value="{DynamicResource Fs11}"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd" Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="6" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"
                                              TextElement.Foreground="{TemplateBinding Foreground}"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource PanelSoftBrush}"/>
                            </Trigger>
                            <Trigger Property="IsKeyboardFocused" Value="True">
                                <Setter TargetName="Bd" Property="BorderBrush" Value="{DynamicResource PrimaryBrush}"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource LineBrush}"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.4"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </UserControl.Resources>
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="46"/>
            <RowDefinition Height="38"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Orca식 branch context: 현재 브랜치와 비교 기준을 모든 Git 화면에서 고정 노출. -->
        <Border Grid.Row="0" Background="{DynamicResource PanelBrush}"
                BorderBrush="{DynamicResource LineBrush}" BorderThickness="0,0,0,1">
            <Grid Margin="10,0,8,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="18"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <Grid Grid.Column="0" Width="15" Height="15" VerticalAlignment="Center">
                    <Path x:Name="HeaderBranchIcon" Data="{StaticResource IconGitBranch}"
                          Style="{StaticResource LucideIcon}" Width="15" Height="15"
                          Stroke="{DynamicResource TextMutedBrush}"/>
                    <Ellipse x:Name="HeaderSpinner" Width="14" Height="14" Visibility="Collapsed"
                             models:SpinnerActivator.Track="True"
                             Stroke="{DynamicResource PrimaryBrush}" StrokeThickness="1.8"
                             StrokeDashArray="14 100" StrokeDashCap="Round"
                             RenderTransformOrigin="0.5,0.5">
                        <Ellipse.RenderTransform>
                            <RotateTransform Angle="{Binding Angle, Source={x:Static models:SpinnerSync.Instance}}"/>
                        </Ellipse.RenderTransform>
                    </Ellipse>
                </Grid>
                <StackPanel Grid.Column="1" Margin="6,0,8,0" VerticalAlignment="Center">
                    <TextBlock x:Name="BranchContextText" Text="Git 저장소 없음"
                               FontSize="{DynamicResource Fs12}" FontWeight="SemiBold"
                               Foreground="{DynamicResource TextBrush}" TextTrimming="CharacterEllipsis"/>
                    <TextBlock x:Name="BranchMetaText" Text="프로젝트를 선택하세요"
                               Margin="0,2,0,0" FontSize="{DynamicResource Fs11}"
                               Foreground="{DynamicResource TextMutedBrush}" TextTrimming="CharacterEllipsis"/>
                </StackPanel>
                <Button x:Name="RefreshAllBtn" Grid.Column="2" Click="RefreshAll_Click"
                        Style="{StaticResource IconButton}" Width="24" Height="24" Padding="4"
                        ToolTip="새로 고침 (F5)">
                    <Path Data="{StaticResource IconRefresh}" Style="{StaticResource LucideButtonIcon}"
                          Width="13" Height="13"/>
                </Button>
                <Button x:Name="OpenRepositoryBtn" Grid.Column="3" Click="OpenRepository_Click"
                        Margin="2,0,0,0" Style="{StaticResource IconButton}" Width="24" Height="24" Padding="4"
                        ToolTip="원격 저장소 열기">
                    <Path Data="{StaticResource IconExternalLink}" Style="{StaticResource LucideButtonIcon}"
                          Width="13" Height="13"/>
                </Button>
            </Grid>
        </Border>

        <Border Grid.Row="1" Background="{DynamicResource PanelBrush}"
                BorderBrush="{DynamicResource LineBrush}" BorderThickness="0,0,0,1">
            <Grid Margin="8,4">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <Button x:Name="ChangesModeBtn" Grid.Column="0" Click="GitMode_Click"
                        Style="{StaticResource GitModeButton}" Tag="active" ToolTip="작업 트리 변경 사항">
                    <StackPanel Orientation="Horizontal">
                        <Path Data="{StaticResource IconGitCompare}" Style="{StaticResource LucideButtonIcon}"
                              Width="12" Height="12" Margin="0,0,4,0"/>
                        <TextBlock x:Name="ChangesModeText" Text="변경" FontSize="{DynamicResource Fs12}"/>
                    </StackPanel>
                </Button>
                <Button x:Name="HistoryModeBtn" Grid.Column="1" Click="GitMode_Click"
                        Style="{StaticResource GitModeButton}" ToolTip="현재 브랜치 커밋 내역">
                    <StackPanel Orientation="Horizontal">
                        <Path Data="{StaticResource IconGitCommit}" Style="{StaticResource LucideButtonIcon}"
                              Width="12" Height="12" Margin="0,0,4,0"/>
                        <TextBlock Text="커밋" FontSize="{DynamicResource Fs12}"/>
                    </StackPanel>
                </Button>
                <Button x:Name="PullRequestsModeBtn" Grid.Column="2" Click="GitMode_Click"
                        Style="{StaticResource GitModeButton}" ToolTip="GitHub pull request">
                    <StackPanel Orientation="Horizontal">
                        <Path Data="{StaticResource IconGitPullRequest}" Style="{StaticResource LucideButtonIcon}"
                              Width="12" Height="12" Margin="0,0,4,0"/>
                        <TextBlock x:Name="PullRequestsModeText" Text="PR" FontSize="{DynamicResource Fs12}"/>
                    </StackPanel>
                </Button>
            </Grid>
        </Border>

        <Grid x:Name="ChangesView" Grid.Row="2">
            <Grid.RowDefinitions>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

        <!-- 두 트리를 각각 유한 높이 영역에 두어 TreeView 내부 ScrollViewer(가상화)가 동작하게 한다.
             바깥 ScrollViewer/StackPanel(무한높이)에 넣으면 UI 가상화가 꺼져 변경 파일 전부를 매 레이아웃
             패스마다 measure → 대량 변경(예: untracked 폴더) 시 UI 스레드가 코어를 태워 시스템 전체
             입력까지 느려진다. Staged 는 상한(MaxHeight)까지 자라고, Changes 가 남은 공간을 채운다. -->
        <Grid x:Name="ScmBodyGrid" Grid.Row="0" Margin="4">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>
            <!-- 섹션 헤더(클릭 시 트리 통째 접기/펼치기) -->
            <Grid x:Name="StagedHeaderRow" Grid.Row="0" Background="Transparent" Margin="0,11,0,2">
                <Border Background="Transparent" MouseLeftButtonUp="ToggleStaged">
                    <StackPanel Orientation="Horizontal">
                        <StackPanel.RenderTransform><TranslateTransform Y="-2"/></StackPanel.RenderTransform>
                        <Grid Width="16">
                            <Path x:Name="StagedChevron" Width="8" Height="8" Stretch="Uniform"
                                  Data="M 0 0 L 4 4 L 0 8 Z" Fill="{DynamicResource TextMutedBrush}"
                                  RenderTransformOrigin="0.5,0.5"
                                  HorizontalAlignment="Center" VerticalAlignment="Center">
                                <Path.RenderTransform><RotateTransform Angle="90"/></Path.RenderTransform>
                            </Path>
                        </Grid>
                        <TextBlock x:Name="StagedHeader" Text="스테이징된 변경 사항" Margin="2,0,0,0"
                                   FontSize="{DynamicResource Fs12}" FontWeight="SemiBold"
                                   Foreground="{DynamicResource TextBrush}"/>
                    </StackPanel>
                </Border>
            </Grid>
            <!-- 스테이징·변경 둘 다 있을 때만 절반 캡(코드에서 MaxHeight 설정) → 초과 시 내부 스크롤 -->
            <Grid x:Name="StagedTreeHost" Grid.Row="1" Margin="0,0,0,0" ClipToBounds="True">
                <TreeView x:Name="StagedTree"
                          Background="Transparent" BorderThickness="0"
                          VirtualizingStackPanel.IsVirtualizing="True"
                          VirtualizingPanel.VirtualizationMode="Recycling"
                          ItemContainerStyle="{StaticResource ScmTreeItem}"
                          ItemTemplate="{StaticResource ScmNode}"
                          ScrollViewer.ScrollChanged="ScmTree_ScrollChanged"
                          ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                    <TreeView.ItemsPanel>
                        <ItemsPanelTemplate>
                            <VirtualizingStackPanel Margin="0,8,0,8"/>
                        </ItemsPanelTemplate>
                    </TreeView.ItemsPanel>
                </TreeView>
                <Rectangle x:Name="StagedFadeTop" Height="24" VerticalAlignment="Top"
                           IsHitTestVisible="False" Panel.ZIndex="1" Visibility="Collapsed"
                           Fill="{DynamicResource PanelBrush}">
                    <Rectangle.OpacityMask>
                        <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                            <GradientStop Offset="0" Color="Black"/>
                            <GradientStop Offset="0.7" Color="Transparent"/>
                        </LinearGradientBrush>
                    </Rectangle.OpacityMask>
                </Rectangle>
                <Rectangle x:Name="StagedFadeBottom" Height="24" VerticalAlignment="Bottom"
                           IsHitTestVisible="False" Panel.ZIndex="1" Visibility="Collapsed"
                           Fill="{DynamicResource PanelBrush}">
                    <Rectangle.OpacityMask>
                        <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                            <GradientStop Offset="0.3" Color="Transparent"/>
                            <GradientStop Offset="1" Color="Black"/>
                        </LinearGradientBrush>
                    </Rectangle.OpacityMask>
                </Rectangle>
            </Grid>

            <!-- 스테이징·변경내용 둘 다 있을 때만 구분선 -->
            <Border x:Name="SectionSeparator" Grid.Row="2" Height="1" Margin="0,7,0,0"
                    Background="{DynamicResource LineBrush}" Visibility="Collapsed"/>

            <Grid x:Name="ChangesHeaderRow" Grid.Row="3" Background="Transparent" Margin="0,14,0,2">
                <Border Background="Transparent" MouseLeftButtonUp="ToggleUnstaged">
                    <StackPanel Orientation="Horizontal">
                        <StackPanel.RenderTransform><TranslateTransform Y="-2"/></StackPanel.RenderTransform>
                        <Grid Width="16">
                            <Path x:Name="ChangesChevron" Width="8" Height="8" Stretch="Uniform"
                                  Data="M 0 0 L 4 4 L 0 8 Z" Fill="{DynamicResource TextMutedBrush}"
                                  RenderTransformOrigin="0.5,0.5"
                                  HorizontalAlignment="Center" VerticalAlignment="Center">
                                <Path.RenderTransform><RotateTransform Angle="90"/></Path.RenderTransform>
                            </Path>
                        </Grid>
                        <TextBlock x:Name="ChangesHeader" Text="변경 내용" Margin="2,0,0,0"
                                   FontSize="{DynamicResource Fs12}" FontWeight="SemiBold"
                                   Foreground="{DynamicResource TextBrush}"/>
                    </StackPanel>
                </Border>
            </Grid>
            <Grid x:Name="UnstagedTreeHost" Grid.Row="4" Margin="0,0,0,0" ClipToBounds="True">
                <TreeView x:Name="UnstagedTree"
                          Background="Transparent" BorderThickness="0"
                          VirtualizingStackPanel.IsVirtualizing="True"
                          VirtualizingPanel.VirtualizationMode="Recycling"
                          ItemContainerStyle="{StaticResource ScmTreeItem}"
                          ItemTemplate="{StaticResource ScmNode}"
                          ScrollViewer.ScrollChanged="ScmTree_ScrollChanged"
                          ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                    <TreeView.ItemsPanel>
                        <ItemsPanelTemplate>
                            <VirtualizingStackPanel Margin="0,8,0,8"/>
                        </ItemsPanelTemplate>
                    </TreeView.ItemsPanel>
                </TreeView>
                <Rectangle x:Name="ChangesFadeTop" Height="24" VerticalAlignment="Top"
                           IsHitTestVisible="False" Panel.ZIndex="1" Visibility="Collapsed"
                           Fill="{DynamicResource PanelBrush}">
                    <Rectangle.OpacityMask>
                        <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                            <GradientStop Offset="0" Color="Black"/>
                            <GradientStop Offset="0.7" Color="Transparent"/>
                        </LinearGradientBrush>
                    </Rectangle.OpacityMask>
                </Rectangle>
                <Rectangle x:Name="ChangesFadeBottom" Height="24" VerticalAlignment="Bottom"
                           IsHitTestVisible="False" Panel.ZIndex="1" Visibility="Collapsed"
                           Fill="{DynamicResource PanelBrush}">
                    <Rectangle.OpacityMask>
                        <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                            <GradientStop Offset="0.3" Color="Transparent"/>
                            <GradientStop Offset="1" Color="Black"/>
                        </LinearGradientBrush>
                    </Rectangle.OpacityMask>
                </Rectangle>
            </Grid>

            <TextBlock x:Name="EmptyText" Grid.Row="4" Text="변경된 파일이 없습니다." Visibility="Collapsed"
                       Margin="10" TextAlignment="Center" VerticalAlignment="Top"
                       Foreground="{DynamicResource TextMutedBrush}"/>
        </Grid>

        <Border x:Name="GitControlBar" Grid.Row="1" Visibility="Collapsed" Background="{DynamicResource PanelBrush}"
                BorderBrush="{DynamicResource LineBrush}" BorderThickness="0,1,0,0" Padding="8">
            <StackPanel>
                <!-- 브랜치 문맥은 상단에 고정하고, 하단에는 원격 액션만 둔다. -->
                <Grid Margin="2,0,0,6">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Grid.Column="0" Text="원격" VerticalAlignment="Center"
                               Foreground="{DynamicResource TextMutedBrush}" FontSize="{DynamicResource Fs11}"/>
                    <!-- fetch(점선 아래 화살표)를 맨 왼쪽으로. 원격 작업 버튼은 동일 크기. -->
                    <Button x:Name="FetchBtn" Grid.Column="1" Click="Fetch_Click"
                            Style="{StaticResource IconButton}" Width="24" Height="24" Padding="3" ToolTip="원격 정보 가져오기">
                        <!-- 좁은 fetch(점선 아래 화살표) — 세로 꽉·가로 좁게 직접 그림 -->
                        <Path Data="M6 1 V13.5 M2.5 9.5 L6 13.5 L9.5 9.5"
                              Style="{StaticResource LucideIcon}" StrokeThickness="1.5" SnapsToDevicePixels="False"
                              StrokeDashArray="0.75 1.4" StrokeDashCap="Round"
                              Width="14" Height="14"
                              Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"/>
                    </Button>
                    <Button x:Name="PullBtn" Grid.Column="2" Click="Pull_Click" Margin="2,0,0,0"
                            Style="{StaticResource IconButton}" Width="24" Height="24" Padding="3" ToolTip="원격 변경 동기화">
                        <!-- 좁은 arrow-down(pull) -->
                        <Path Data="M6 2 V14 M2.5 10 L6 14 L9.5 10"
                              Style="{StaticResource LucideIcon}" StrokeThickness="1.5" SnapsToDevicePixels="False"
                              Width="14" Height="14"
                              Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"/>
                    </Button>
                    <Button x:Name="PushBtn" Grid.Column="3" Click="Push_Click" Margin="2,0,0,0"
                            Style="{StaticResource IconButton}" Width="24" Height="24" Padding="3" ToolTip="원격 저장소에 푸시">
                        <!-- 좁은 arrow-up(push) -->
                        <Path Data="M6 14 V2 M2.5 6 L6 2 L9.5 6"
                              Style="{StaticResource LucideIcon}" StrokeThickness="1.5" SnapsToDevicePixels="False"
                              Width="14" Height="14"
                              Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"/>
                    </Button>
                    <Button x:Name="SyncBtn" Grid.Column="4" Click="Sync_Click" Margin="2,0,0,0"
                            Style="{StaticResource IconButton}" Width="24" Height="24" Padding="4"
                            ToolTip="동기화(가져오기 후 푸시)">
                        <Path Data="{StaticResource IconRefresh}" Width="12" Height="12" Stretch="Uniform"
                              Style="{StaticResource LucideIcon}"
                              Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"/>
                    </Button>
                </Grid>

                <!-- 커밋 메시지 카드 (라운드=아래 커밋 버튼과 동일한 5) -->
                <Border Background="{DynamicResource BgBrush}"
                        BorderBrush="{DynamicResource LineBrush}" BorderThickness="1"
                        CornerRadius="5" Padding="10,6">
                    <Grid>
                        <!-- 높이는 코드비하인드에서 실제 폰트 라인높이×3 으로 확정(테마 폰트크기 연동).
                             MinLines/MaxLines 는 커스텀 폰트 로드 타이밍에 간헐 실패해 사용하지 않음. -->
                        <TextBox x:Name="MsgBox" BorderThickness="0" Background="Transparent"
                                 Foreground="{DynamicResource TextBrush}" CaretBrush="{DynamicResource TextBrush}"
                                 FontFamily="{StaticResource PretendardFont}" FontSize="{DynamicResource Fs12}"
                                 TextWrapping="Wrap" AcceptsReturn="True"
                                 VerticalContentAlignment="Top" VerticalScrollBarVisibility="Auto"
                                 TextChanged="MsgBox_TextChanged" PreviewKeyDown="MsgBox_PreviewKeyDown"/>
                        <TextBlock x:Name="MsgPlaceholder" Text="커밋 메시지 입력" IsHitTestVisible="False"
                                   VerticalAlignment="Top" Margin="1,0,0,0"
                                   Foreground="{DynamicResource TextMutedBrush}"
                                   FontFamily="{StaticResource PretendardFont}" FontSize="{DynamicResource Fs12}">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock" BasedOn="{StaticResource {x:Type TextBlock}}">
                                    <Setter Property="Visibility" Value="Collapsed"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding Text, ElementName=MsgBox}" Value="">
                                            <Setter Property="Visibility" Value="Visible"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>
                    </Grid>
                </Border>

                <!-- 커밋 버튼(전체 폭) -->
                <Button x:Name="CommitBtn" Content="✓ 커밋" Click="Commit_Click" Margin="0,6,0,0"
                        Style="{StaticResource CommitButton}" Height="32" IsEnabled="False"
                        HorizontalAlignment="Stretch" FontSize="{DynamicResource Fs13}"/>
            </StackPanel>
        </Border>
        </Grid>

        <!-- 현재 브랜치 커밋 내역. 검색은 이미 읽은 목록을 즉시 필터링하고, 세부 파일은 선택 시 로드. -->
        <Grid x:Name="HistoryView" Grid.Row="2" Visibility="Collapsed">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <Border Grid.Row="0" Margin="8,8,8,4" Height="35"
                    Background="{DynamicResource PanelSoftBrush}"
                    BorderThickness="1" CornerRadius="8">
                <Border.Style>
                    <Style TargetType="Border">
                        <Setter Property="BorderBrush" Value="{DynamicResource LineBrush}"/>
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding IsKeyboardFocused, ElementName=HistorySearchBox}" Value="True">
                                <Setter Property="BorderBrush" Value="{DynamicResource PrimaryBrush}"/>
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Border.Style>
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <Path Grid.Column="0" Data="{StaticResource IconSearch}" Style="{StaticResource LucideIcon}"
                          Width="13" Height="13" Margin="10,0,0,0" Stroke="{DynamicResource TextMutedBrush}"/>
                    <Grid Grid.Column="1">
                        <TextBox x:Name="HistorySearchBox" Margin="7,0,0,0" Padding="0"
                                 Background="Transparent" BorderThickness="0" VerticalContentAlignment="Center"
                                 FontSize="{DynamicResource Fs13}" Foreground="{DynamicResource TextBrush}"
                                 SelectionBrush="{DynamicResource PrimaryBrush}" SelectionOpacity="0.35"
                                 AutomationProperties.Name="커밋 내역 검색"
                                 CaretBrush="{DynamicResource TextBrush}" TextChanged="HistorySearch_TextChanged"/>
                        <TextBlock Text="메시지, 작성자 또는 SHA 검색" Margin="7,0,0,0" VerticalAlignment="Center"
                                   IsHitTestVisible="False" FontSize="{DynamicResource Fs13}"
                                   TextTrimming="CharacterEllipsis"
                                   Foreground="{DynamicResource TextMutedBrush}">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock" BasedOn="{StaticResource {x:Type TextBlock}}">
                                    <Setter Property="Visibility" Value="Collapsed"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding Text, ElementName=HistorySearchBox}" Value="">
                                            <Setter Property="Visibility" Value="Visible"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>
                    </Grid>
                    <Button Grid.Column="2" Click="ClearHistorySearch_Click" Width="20" Height="20" Margin="0,0,8,0"
                            Padding="4" ToolTip="검색 지우기">
                        <Button.Style>
                            <Style TargetType="Button" BasedOn="{StaticResource IconButton}">
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding Text, ElementName=HistorySearchBox}" Value="">
                                        <Setter Property="Visibility" Value="Collapsed"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Button.Style>
                        <Path Data="{StaticResource IconX}" Style="{StaticResource LucideButtonIcon}" Width="10" Height="10"/>
                    </Button>
                </Grid>
            </Border>

            <Border x:Name="HistoryStatusBanner" Grid.Row="1" Margin="8,2,8,4" Padding="8,7"
                    Background="{DynamicResource PanelSoftBrush}" BorderBrush="{DynamicResource LineBrush}"
                    BorderThickness="1" CornerRadius="7" Visibility="Collapsed">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <Path Data="{StaticResource IconTriangleAlert}" Style="{StaticResource LucideIcon}"
                              Width="12" Height="12" Margin="0,1,6,0" Stroke="{DynamicResource DangerBrush}"
                              VerticalAlignment="Top"/>
                        <TextBlock x:Name="HistoryStatusText" Grid.Column="1" Text="커밋 내역을 새로 고치지 못했습니다."
                                   FontSize="{DynamicResource Fs11}" Foreground="{DynamicResource TextMutedBrush}"
                                   TextWrapping="Wrap"/>
                    </Grid>
                    <Button Grid.Row="1" Content="다시 시도" Click="HistoryRetry_Click"
                            Style="{StaticResource GitSmallActionButton}" Height="24" Padding="7,0"
                            Margin="18,6,0,0" HorizontalAlignment="Left"/>
                </Grid>
            </Border>

            <Grid Grid.Row="2" ClipToBounds="True">
                <ListBox x:Name="CommitList" Background="Transparent" BorderThickness="0"
                         AutomationProperties.Name="커밋 내역"
                         ItemContainerStyle="{StaticResource GitListItem}"
                         SelectionChanged="CommitList_SelectionChanged"
                         VirtualizingStackPanel.IsVirtualizing="True"
                         VirtualizingPanel.VirtualizationMode="Recycling"
                         ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                    <ListBox.ItemTemplate>
                        <DataTemplate DataType="{x:Type models:GitCommitEntry}">
                            <Grid Margin="9,8">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="28"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <Grid Grid.Column="0" Width="24" Height="24" VerticalAlignment="Top">
                                    <Border CornerRadius="12" Background="{DynamicResource PanelSoftBrush}"
                                            BorderBrush="{DynamicResource LineBrush}" BorderThickness="1">
                                        <TextBlock Text="{Binding AuthorInitial}" HorizontalAlignment="Center" VerticalAlignment="Center"
                                                   FontSize="{DynamicResource Fs10}" FontWeight="SemiBold"
                                                   Foreground="{DynamicResource TextMutedBrush}"/>
                                    </Border>
                                    <Ellipse x:Name="HeadDot" Width="7" Height="7" HorizontalAlignment="Right" VerticalAlignment="Top"
                                             Fill="{DynamicResource PrimaryBrush}" Stroke="{DynamicResource PanelBrush}" StrokeThickness="1"
                                             Visibility="Collapsed"/>
                                </Grid>
                                <StackPanel Grid.Column="1" Margin="3,0,0,0">
                                    <TextBlock Text="{Binding Subject}" FontSize="{DynamicResource Fs12}" FontWeight="SemiBold"
                                               Foreground="{DynamicResource TextBrush}" TextTrimming="CharacterEllipsis"
                                               ToolTip="{Binding Subject}" v:RowToolTip.ShowWhenTrimmed="True"/>
                                    <Grid Margin="0,4,0,0">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Text="{Binding ShortSha}" FontFamily="Consolas" FontSize="{DynamicResource Fs11}"
                                                   Foreground="{DynamicResource PrimaryBrush}"/>
                                        <TextBlock Grid.Column="1" Text="{Binding AuthorName}" Margin="8,0,6,0"
                                                   FontSize="{DynamicResource Fs11}" Foreground="{DynamicResource TextMutedBrush}"
                                                   TextTrimming="CharacterEllipsis"/>
                                        <TextBlock Grid.Column="2" Text="{Binding RelativeTime}" FontSize="{DynamicResource Fs11}"
                                                   Foreground="{DynamicResource TextMutedBrush}"/>
                                    </Grid>
                                    <Border x:Name="MergeBadge" Margin="0,6,0,0" Padding="6,2" HorizontalAlignment="Left"
                                            CornerRadius="5" Background="{DynamicResource PanelSoftBrush}" Visibility="Collapsed">
                                        <TextBlock Text="merge" FontSize="{DynamicResource Fs10}"
                                                   Foreground="{DynamicResource TextMutedBrush}"/>
                                    </Border>
                                </StackPanel>
                            </Grid>
                            <DataTemplate.Triggers>
                                <DataTrigger Binding="{Binding IsHead}" Value="True">
                                    <Setter TargetName="HeadDot" Property="Visibility" Value="Visible"/>
                                </DataTrigger>
                                <DataTrigger Binding="{Binding IsMerge}" Value="True">
                                    <Setter TargetName="MergeBadge" Property="Visibility" Value="Visible"/>
                                </DataTrigger>
                            </DataTemplate.Triggers>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>

                <StackPanel x:Name="HistoryEmptyState" HorizontalAlignment="Center" VerticalAlignment="Center"
                            Margin="24" Visibility="Collapsed">
                    <Path Data="{StaticResource IconGitCommit}" Style="{StaticResource LucideIcon}"
                          Width="26" Height="26" Stroke="{DynamicResource TextMutedBrush}" HorizontalAlignment="Center"/>
                    <TextBlock x:Name="HistoryEmptyTitle" Text="커밋 내역이 없습니다" Margin="0,12,0,0"
                               FontSize="{DynamicResource Fs16}" FontWeight="SemiBold"
                               Foreground="{DynamicResource TextBrush}" HorizontalAlignment="Center"
                               TextAlignment="Center" TextWrapping="Wrap"/>
                    <TextBlock x:Name="HistoryEmptyDescription" Text="첫 커밋을 만들면 여기에 표시됩니다."
                               Margin="0,5,0,0" TextAlignment="Center" TextWrapping="Wrap"
                               FontSize="{DynamicResource Fs12}" Foreground="{DynamicResource TextMutedBrush}"/>
                    <Button x:Name="HistoryEmptyActionBtn" Content="다시 시도" Click="HistoryRetry_Click"
                            Style="{StaticResource CommitButton}" Height="32" MinWidth="110"
                            FontSize="{DynamicResource Fs13}" Margin="0,12,0,0" Visibility="Collapsed"/>
                </StackPanel>

                <Grid x:Name="HistoryLoadingOverlay" Background="{DynamicResource PanelBrush}" Visibility="Collapsed">
                    <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                        <Ellipse Width="36" Height="36" models:SpinnerActivator.Track="True"
                                 Stroke="{DynamicResource PrimaryBrush}" StrokeThickness="3"
                                 StrokeDashArray="28 10" StrokeDashCap="Round" RenderTransformOrigin="0.5,0.5">
                            <Ellipse.RenderTransform>
                                <RotateTransform Angle="{Binding Angle, Source={x:Static models:SpinnerSync.Instance}}"/>
                            </Ellipse.RenderTransform>
                        </Ellipse>
                        <TextBlock Text="커밋 내역을 불러오는 중…" Margin="0,10,0,0"
                                   FontSize="{DynamicResource Fs12}" Foreground="{DynamicResource TextMutedBrush}"/>
                    </StackPanel>
                </Grid>
            </Grid>

            <Border x:Name="CommitDetailPanel" Grid.Row="3" MaxHeight="230"
                    Background="{DynamicResource PanelSoftBrush}" BorderBrush="{DynamicResource LineBrush}"
                    BorderThickness="0,1,0,0">
                <Border.Style>
                    <Style TargetType="Border">
                        <Setter Property="Visibility" Value="Visible"/>
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding SelectedItem, ElementName=CommitList}" Value="{x:Null}">
                                <Setter Property="Visibility" Value="Collapsed"/>
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Border.Style>
                <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                    <StackPanel Margin="10,9" DataContext="{Binding SelectedItem, ElementName=CommitList}">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="{Binding StatsText}" FontSize="{DynamicResource Fs11}"
                                       Foreground="{DynamicResource TextMutedBrush}"/>
                            <StackPanel Grid.Column="1" Orientation="Horizontal" Margin="8,0,0,0">
                                <Ellipse Width="12" Height="12" Margin="0,0,5,0"
                                         models:SpinnerActivator.Track="True"
                                         Stroke="{DynamicResource PrimaryBrush}" StrokeThickness="1.8"
                                         StrokeDashArray="12 100" StrokeDashCap="Round" RenderTransformOrigin="0.5,0.5"
                                         Visibility="{Binding IsDetailsLoading, Converter={x:Static models:BoolToVisibilityConverter.Instance}}">
                                    <Ellipse.RenderTransform>
                                        <RotateTransform Angle="{Binding Angle, Source={x:Static models:SpinnerSync.Instance}}"/>
                                    </Ellipse.RenderTransform>
                                </Ellipse>
                                <Button x:Name="OpenCommitBtn" Tag="{Binding Sha}" Click="OpenCommit_Click"
                                        Style="{StaticResource IconButton}" Width="20" Height="20" Padding="4"
                                        ToolTip="GitHub에서 커밋 열기">
                                    <Path Data="{StaticResource IconExternalLink}" Style="{StaticResource LucideButtonIcon}"
                                          Width="10" Height="10"/>
                                </Button>
                            </StackPanel>
                        </Grid>
                        <Grid Margin="0,7,0,0"
                              Visibility="{Binding HasDetailsError, Converter={x:Static models:BoolToVisibilityConverter.Instance}}">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="{Binding DetailsError}" FontSize="{DynamicResource Fs11}"
                                       Foreground="{DynamicResource DangerBrush}" TextWrapping="Wrap"
                                       VerticalAlignment="Center"/>
                            <Button Grid.Column="1" Content="재시도" Tag="{Binding}"
                                    Click="RetryCommitDetails_Click" Style="{StaticResource GitSmallActionButton}"
                                    Height="24" Padding="7,0" Margin="8,0,0,0"/>
                        </Grid>
                        <TextBlock Text="{Binding DetailBody}" Margin="0,7,0,0" TextWrapping="Wrap"
                                   FontSize="{DynamicResource Fs12}" LineHeight="18"
                                   Foreground="{DynamicResource TextBrush}"
                                   Visibility="{Binding HasDetailBody, Converter={x:Static models:BoolToVisibilityConverter.Instance}}"/>
                        <ItemsControl ItemsSource="{Binding Files}" Margin="0,7,0,0">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate DataType="{x:Type models:GitCommitFile}">
                                    <Grid Margin="0,2">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Text="{Binding Path}" FontSize="{DynamicResource Fs11}"
                                                   Foreground="{DynamicResource TextBrush}" TextTrimming="CharacterEllipsis"
                                                   ToolTip="{Binding Path}" v:RowToolTip.ShowWhenTrimmed="True"/>
                                        <TextBlock Grid.Column="1" Text="{Binding ChangeText}" Margin="8,0,0,0"
                                                   FontFamily="Consolas" FontSize="{DynamicResource Fs11}"
                                                   Foreground="{DynamicResource TextMutedBrush}"/>
                                    </Grid>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                        <TextBlock Text="{Binding MoreFilesText}" Margin="0,5,0,0"
                                   FontSize="{DynamicResource Fs11}" Foreground="{DynamicResource TextMutedBrush}"
                                   Visibility="{Binding HasMoreFiles, Converter={x:Static models:BoolToVisibilityConverter.Instance}}"/>
                    </StackPanel>
                </ScrollViewer>
            </Border>

            <Button x:Name="HistoryLoadMoreBtn" Grid.Row="4" Content="이전 커밋 더 보기"
                    Click="HistoryLoadMore_Click" Style="{StaticResource GitSmallActionButton}"
                    Margin="8,6,8,8" HorizontalAlignment="Stretch" Visibility="Collapsed"/>
        </Grid>

        <!-- GitHub PR: 열린/완료/전체 필터, checks·review 상태, 선택 상세와 웹 연결. -->
        <Grid x:Name="PullRequestsView" Grid.Row="2" Visibility="Collapsed">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <Border Grid.Row="0" Margin="8,8,8,4" Height="35"
                    Background="{DynamicResource PanelSoftBrush}"
                    BorderThickness="1" CornerRadius="8">
                <Border.Style>
                    <Style TargetType="Border">
                        <Setter Property="BorderBrush" Value="{DynamicResource LineBrush}"/>
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding IsKeyboardFocused, ElementName=PullRequestSearchBox}" Value="True">
                                <Setter Property="BorderBrush" Value="{DynamicResource PrimaryBrush}"/>
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Border.Style>
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <Path Grid.Column="0" Data="{StaticResource IconSearch}" Style="{StaticResource LucideIcon}"
                          Width="13" Height="13" Margin="10,0,0,0" Stroke="{DynamicResource TextMutedBrush}"/>
                    <Grid Grid.Column="1">
                        <TextBox x:Name="PullRequestSearchBox" Margin="7,0,0,0" Padding="0"
                                 Background="Transparent" BorderThickness="0" VerticalContentAlignment="Center"
                                 FontSize="{DynamicResource Fs13}" Foreground="{DynamicResource TextBrush}"
                                 SelectionBrush="{DynamicResource PrimaryBrush}" SelectionOpacity="0.35"
                                 AutomationProperties.Name="PR 검색"
                                 CaretBrush="{DynamicResource TextBrush}" TextChanged="PullRequestSearch_TextChanged"/>
                        <TextBlock Text="제목, 번호 또는 브랜치 검색" Margin="7,0,0,0" VerticalAlignment="Center"
                                   IsHitTestVisible="False" FontSize="{DynamicResource Fs13}"
                                   TextTrimming="CharacterEllipsis"
                                   Foreground="{DynamicResource TextMutedBrush}">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock" BasedOn="{StaticResource {x:Type TextBlock}}">
                                    <Setter Property="Visibility" Value="Collapsed"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding Text, ElementName=PullRequestSearchBox}" Value="">
                                            <Setter Property="Visibility" Value="Visible"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>
                    </Grid>
                    <Button Grid.Column="2" Click="ClearPullRequestSearch_Click" Width="20" Height="20" Margin="0,0,8,0"
                            Padding="4" ToolTip="검색 지우기">
                        <Button.Style>
                            <Style TargetType="Button" BasedOn="{StaticResource IconButton}">
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding Text, ElementName=PullRequestSearchBox}" Value="">
                                        <Setter Property="Visibility" Value="Collapsed"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Button.Style>
                        <Path Data="{StaticResource IconX}" Style="{StaticResource LucideButtonIcon}" Width="10" Height="10"/>
                    </Button>
                </Grid>
            </Border>

            <Grid Grid.Row="1" Margin="8,2,8,5">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <Button x:Name="OpenPrFilterBtn" Grid.Column="0" Content="열림" CommandParameter="open"
                        Click="PrFilter_Click" Style="{StaticResource GitFilterButton}" Tag="active"/>
                <Button x:Name="CompletedPrFilterBtn" Grid.Column="1" Content="완료" CommandParameter="completed"
                        Click="PrFilter_Click" Style="{StaticResource GitFilterButton}" Margin="3,0"/>
                <Button x:Name="AllPrFilterBtn" Grid.Column="2" Content="전체" CommandParameter="all"
                        Click="PrFilter_Click" Style="{StaticResource GitFilterButton}"/>
            </Grid>

            <Border x:Name="PullRequestStatusBanner" Grid.Row="2" Margin="8,0,8,5" Padding="8,7"
                    Background="{DynamicResource PanelSoftBrush}" BorderBrush="{DynamicResource LineBrush}"
                    BorderThickness="1" CornerRadius="7" Visibility="Collapsed">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <Path Data="{StaticResource IconTriangleAlert}" Style="{StaticResource LucideIcon}"
                              Width="12" Height="12" Margin="0,1,6,0" Stroke="{DynamicResource DangerBrush}"
                              VerticalAlignment="Top"/>
                        <TextBlock x:Name="PullRequestStatusText" Grid.Column="1" Text="PR을 새로 고치지 못했습니다."
                                   FontSize="{DynamicResource Fs11}" Foreground="{DynamicResource TextMutedBrush}"
                                   TextWrapping="Wrap"/>
                    </Grid>
                    <Button x:Name="PullRequestStatusActionBtn" Grid.Row="1" Content="다시 시도"
                            Click="PullRequestEmptyAction_Click" Style="{StaticResource GitSmallActionButton}"
                            Height="24" Padding="7,0" Margin="18,6,0,0" HorizontalAlignment="Left"/>
                </Grid>
            </Border>

            <Grid Grid.Row="3" ClipToBounds="True">
                <ListBox x:Name="PullRequestList" Background="Transparent" BorderThickness="0"
                         AutomationProperties.Name="Pull request 목록"
                         ItemContainerStyle="{StaticResource GitListItem}"
                         SelectionChanged="PullRequestList_SelectionChanged"
                         VirtualizingStackPanel.IsVirtualizing="True"
                         VirtualizingPanel.VirtualizationMode="Recycling"
                         ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                    <ListBox.ItemTemplate>
                        <DataTemplate DataType="{x:Type models:GitPullRequestItem}">
                            <StackPanel Margin="9,8">
                                <TextBlock Text="{Binding Title}" FontSize="{DynamicResource Fs12}" FontWeight="SemiBold"
                                           Foreground="{DynamicResource TextBrush}" TextTrimming="CharacterEllipsis"
                                           ToolTip="{Binding Title}" v:RowToolTip.ShowWhenTrimmed="True"/>
                                <Grid Margin="0,5,0,0">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="{Binding NumberText}" FontFamily="Consolas"
                                               FontSize="{DynamicResource Fs11}" Foreground="{DynamicResource TextMutedBrush}"/>
                                    <Border Grid.Column="1" Margin="7,0,0,0" Padding="5,1" CornerRadius="5"
                                            Background="{DynamicResource PanelSoftBrush}">
                                        <TextBlock x:Name="PrStateText" Text="{Binding StateText}"
                                                   FontSize="{DynamicResource Fs10}" FontWeight="SemiBold"
                                                   Foreground="{DynamicResource PrimaryBrush}"/>
                                    </Border>
                                    <TextBlock Grid.Column="2" Text="{Binding AuthorText}" Margin="7,0,6,0"
                                               FontSize="{DynamicResource Fs11}" Foreground="{DynamicResource TextMutedBrush}"
                                               TextTrimming="CharacterEllipsis"/>
                                </Grid>
                                <Grid Margin="0,5,0,0">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="{Binding BranchText}" FontFamily="Consolas" FontSize="{DynamicResource Fs11}"
                                               Foreground="{DynamicResource TextMutedBrush}" TextTrimming="CharacterEllipsis"/>
                                    <StackPanel x:Name="CheckGroup" Grid.Column="1" Orientation="Horizontal" Margin="8,0,0,0">
                                        <Ellipse x:Name="CheckDot" Width="7" Height="7" Margin="0,0,4,0"
                                                 Fill="{DynamicResource TextMutedBrush}" VerticalAlignment="Center"/>
                                        <TextBlock Text="{Binding ChecksText}" FontSize="{DynamicResource Fs11}"
                                                   Foreground="{DynamicResource TextMutedBrush}"/>
                                    </StackPanel>
                                </Grid>
                            </StackPanel>
                            <DataTemplate.Triggers>
                                <DataTrigger Binding="{Binding IsDraft}" Value="True">
                                    <Setter TargetName="PrStateText" Property="Foreground" Value="{DynamicResource TextMutedBrush}"/>
                                </DataTrigger>
                                <DataTrigger Binding="{Binding IsMerged}" Value="True">
                                    <Setter TargetName="PrStateText" Property="Foreground" Value="{DynamicResource SuccessBrush}"/>
                                </DataTrigger>
                                <DataTrigger Binding="{Binding IsClosed}" Value="True">
                                    <Setter TargetName="PrStateText" Property="Foreground" Value="{DynamicResource DangerBrush}"/>
                                </DataTrigger>
                                <DataTrigger Binding="{Binding ChecksState}" Value="{x:Static models:PullRequestChecksState.Passing}">
                                    <Setter TargetName="CheckDot" Property="Fill" Value="{DynamicResource SuccessBrush}"/>
                                </DataTrigger>
                                <DataTrigger Binding="{Binding ChecksState}" Value="{x:Static models:PullRequestChecksState.Pending}">
                                    <Setter TargetName="CheckDot" Property="Fill" Value="{DynamicResource WarningBrush}"/>
                                </DataTrigger>
                                <DataTrigger Binding="{Binding ChecksState}" Value="{x:Static models:PullRequestChecksState.Failing}">
                                    <Setter TargetName="CheckDot" Property="Fill" Value="{DynamicResource DangerBrush}"/>
                                </DataTrigger>
                                <DataTrigger Binding="{Binding ChecksState}" Value="{x:Static models:PullRequestChecksState.None}">
                                    <Setter TargetName="CheckGroup" Property="Visibility" Value="Collapsed"/>
                                </DataTrigger>
                            </DataTemplate.Triggers>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>

                <StackPanel x:Name="PullRequestEmptyState" HorizontalAlignment="Center" VerticalAlignment="Center"
                            Margin="24" Visibility="Collapsed">
                    <Path Data="{StaticResource IconGitPullRequest}" Style="{StaticResource LucideIcon}"
                          Width="28" Height="28" Stroke="{DynamicResource TextMutedBrush}" HorizontalAlignment="Center"/>
                    <TextBlock x:Name="PullRequestEmptyTitle" Text="열린 PR이 없습니다" Margin="0,12,0,0"
                               FontSize="{DynamicResource Fs16}" FontWeight="SemiBold"
                               Foreground="{DynamicResource TextBrush}" HorizontalAlignment="Center"
                               TextAlignment="Center" TextWrapping="Wrap"/>
                    <TextBlock x:Name="PullRequestEmptyDescription" Text="완료 또는 전체 필터에서 이전 PR도 볼 수 있습니다."
                               Margin="0,5,0,0" TextAlignment="Center" TextWrapping="Wrap"
                               FontSize="{DynamicResource Fs12}" Foreground="{DynamicResource TextMutedBrush}"/>
                    <Button x:Name="PullRequestEmptyActionBtn" Content="GitHub에서 보기"
                            Click="PullRequestEmptyAction_Click" Style="{StaticResource CommitButton}"
                            Margin="0,12,0,0" MinWidth="110" Height="32" FontSize="{DynamicResource Fs13}"/>
                </StackPanel>

                <Grid x:Name="PullRequestLoadingOverlay" Background="{DynamicResource PanelBrush}" Visibility="Collapsed">
                    <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                        <Ellipse Width="36" Height="36" models:SpinnerActivator.Track="True"
                                 Stroke="{DynamicResource PrimaryBrush}" StrokeThickness="3"
                                 StrokeDashArray="28 10" StrokeDashCap="Round" RenderTransformOrigin="0.5,0.5">
                            <Ellipse.RenderTransform>
                                <RotateTransform Angle="{Binding Angle, Source={x:Static models:SpinnerSync.Instance}}"/>
                            </Ellipse.RenderTransform>
                        </Ellipse>
                        <TextBlock Text="PR 상태를 불러오는 중…" Margin="0,10,0,0"
                                   FontSize="{DynamicResource Fs12}" Foreground="{DynamicResource TextMutedBrush}"/>
                    </StackPanel>
                </Grid>
            </Grid>

            <Border x:Name="PullRequestDetailPanel" Grid.Row="4" MaxHeight="230"
                    Background="{DynamicResource PanelSoftBrush}" BorderBrush="{DynamicResource LineBrush}"
                    BorderThickness="0,1,0,0">
                <Border.Style>
                    <Style TargetType="Border">
                        <Setter Property="Visibility" Value="Visible"/>
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding SelectedItem, ElementName=PullRequestList}" Value="{x:Null}">
                                <Setter Property="Visibility" Value="Collapsed"/>
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Border.Style>
                <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                    <StackPanel Margin="10,9" DataContext="{Binding SelectedItem, ElementName=PullRequestList}">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel>
                                <TextBlock Text="{Binding BranchText}" FontFamily="Consolas"
                                           FontSize="{DynamicResource Fs11}" Foreground="{DynamicResource TextMutedBrush}"
                                           TextTrimming="CharacterEllipsis"/>
                                <TextBlock Text="{Binding ChangeText}" Margin="0,4,0,0"
                                           FontSize="{DynamicResource Fs11}" Foreground="{DynamicResource TextMutedBrush}"/>
                            </StackPanel>
                            <Button Grid.Column="1" Tag="{Binding Url}" Click="OpenPullRequest_Click"
                                    Style="{StaticResource GitSmallActionButton}" Padding="8,0" ToolTip="GitHub에서 PR 열기">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="열기"/>
                                    <Path Data="{StaticResource IconExternalLink}" Style="{StaticResource LucideButtonIcon}"
                                          Width="11" Height="11" Margin="5,0,0,0"/>
                                </StackPanel>
                            </Button>
                        </Grid>
                        <Grid Margin="0,8,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="{Binding ReviewText}" FontSize="{DynamicResource Fs11}"
                                       Foreground="{DynamicResource TextBrush}"/>
                            <TextBlock Grid.Column="1" Text="{Binding ChecksText}" TextAlignment="Right"
                                       FontSize="{DynamicResource Fs11}" Foreground="{DynamicResource TextBrush}"/>
                        </Grid>
                        <Grid Margin="0,9,0,0"
                              Visibility="{Binding HasDetailsError, Converter={x:Static models:BoolToVisibilityConverter.Instance}}">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="{Binding DetailsError}" FontSize="{DynamicResource Fs11}"
                                       Foreground="{DynamicResource DangerBrush}" TextWrapping="Wrap"
                                       VerticalAlignment="Center"/>
                            <Button Grid.Column="1" Content="재시도" Tag="{Binding}"
                                    Click="RetryPullRequestDetails_Click" Style="{StaticResource GitSmallActionButton}"
                                    Height="24" Padding="7,0" Margin="8,0,0,0"/>
                        </Grid>
                        <Ellipse Width="12" Height="12" Margin="0,9,0,0" HorizontalAlignment="Left"
                                 models:SpinnerActivator.Track="True"
                                 Stroke="{DynamicResource PrimaryBrush}" StrokeThickness="1.8"
                                 StrokeDashArray="12 100" StrokeDashCap="Round" RenderTransformOrigin="0.5,0.5"
                                 Visibility="{Binding IsDetailsLoading, Converter={x:Static models:BoolToVisibilityConverter.Instance}}">
                            <Ellipse.RenderTransform>
                                <RotateTransform Angle="{Binding Angle, Source={x:Static models:SpinnerSync.Instance}}"/>
                            </Ellipse.RenderTransform>
                        </Ellipse>
                        <TextBlock Text="{Binding Body}" Margin="0,9,0,0" TextWrapping="Wrap"
                                   FontSize="{DynamicResource Fs12}" LineHeight="18" Foreground="{DynamicResource TextBrush}"
                                   Visibility="{Binding HasBody, Converter={x:Static models:BoolToVisibilityConverter.Instance}}"/>
                        <TextBlock Text="설명이 없습니다." Margin="0,9,0,0"
                                   FontSize="{DynamicResource Fs11}" Foreground="{DynamicResource TextMutedBrush}"
                                   Visibility="{Binding HasNoBody, Converter={x:Static models:BoolToVisibilityConverter.Instance}}"/>
                    </StackPanel>
                </ScrollViewer>
            </Border>
        </Grid>
    </Grid>
</UserControl>
