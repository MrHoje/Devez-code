<UserControl x:Class="DevezCode.Views.GitScmView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:models="clr-namespace:DevezCode.Models"
             Background="{DynamicResource PanelBrush}"
             FontFamily="{StaticResource PretendardFont}">
    <UserControl.Resources>
        <!-- TreeViewItem: 파일 탐색기식(삼각형 + 행 + 들여쓴 자식). 행은 StackPanel 로 쌓아
             컨텐츠 크기 기준 레이아웃(중첩 들여쓰기). 트리는 유한 높이 영역에 놓여 내부 ScrollViewer 가
             가상화한다(아래 본문 참고). -->
        <Style x:Key="ScmTreeItem" TargetType="TreeViewItem" BasedOn="{StaticResource {x:Type TreeViewItem}}">
            <Setter Property="IsExpanded" Value="{Binding IsExpanded, Mode=TwoWay}"/>
            <Setter Property="Focusable" Value="False"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TreeViewItem">
                        <StackPanel>
                            <!-- 행 전체를 한 Border 로 감싸 hover 안정화(경계 넘나들며 깜빡이던 문제 해결).
                                 펼침 삼각형은 헤더(데이터 템플릿) 안 표시전용 Path — 토글은 Node_Click 한 곳에서만
                                 처리해 더블토글(두 번 동작해 제자리) 방지. -->
                            <Border x:Name="Bd" CornerRadius="6" Background="Transparent" SnapsToDevicePixels="True">
                                <ContentPresenter ContentSource="Header"
                                                  HorizontalAlignment="Stretch" Margin="0,2,0,3"/>
                            </Border>
                            <ItemsPresenter x:Name="ItemsHost" Margin="16,0,0,0"/>
                        </StackPanel>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsExpanded" Value="False">
                                <Setter TargetName="ItemsHost" Property="Visibility" Value="Collapsed"/>
                            </Trigger>
                            <Trigger SourceName="Bd" Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource HoverBrush}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- 노드 행: 폴더/파일 아이콘 + 이름 + (액션) + 우측 상태글자. ItemsSource=Children 로 재귀. -->
        <HierarchicalDataTemplate x:Key="ScmNode" DataType="{x:Type models:ScmTreeNode}" ItemsSource="{Binding Children}">
            <Grid Background="Transparent" MouseLeftButtonDown="Node_Click">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="16"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <!-- 펼침 삼각형: 폴더만, 펼치면 90° 회전. 화살표(이 Border)는 단일 클릭으로 토글. -->
                <Border Grid.Column="0" Background="Transparent" MouseLeftButtonDown="Tri_Click" Margin="0,0,2,0">
                    <Path x:Name="Tri" Width="8" Height="8" Stretch="Uniform"
                          Fill="{DynamicResource TextMutedBrush}" Data="M 0 0 L 4 4 L 0 8 Z"
                          RenderTransformOrigin="0.5,0.5"
                          HorizontalAlignment="Center" VerticalAlignment="Center"/>
                </Border>
                <!-- 폴더/파일 아이콘(파일 종류 구분 없이 일반 파일 아이콘) -->
                <Path Grid.Column="1" Style="{StaticResource LucideIcon}"
                      Data="{Binding IsFolder, Converter={x:Static models:DirIconConverter.Instance}}"
                      Width="14" Height="14" Stroke="{DynamicResource TextMutedBrush}"
                      VerticalAlignment="Center"/>
                <TextBlock Grid.Column="2" Text="{Binding Name}" Margin="7,0,0,0"
                           VerticalAlignment="Center" TextTrimming="CharacterEllipsis"
                           ToolTip="{Binding Change.Path}"
                           FontSize="{DynamicResource Fs12}"
                           Foreground="{DynamicResource TextBrush}"/>
                <!-- 파일 리프 액션: discard(↩)+stage(+) 또는 unstage(−). 폴더면 숨김.
                     기본 Opacity=0(공간은 유지) → 행 hover 시에만 1 로 노출(리플로우 없음). -->
                <Button x:Name="DiscardBtn" Grid.Column="3" Tag="{Binding Change}"
                        Click="Discard_Click" Style="{StaticResource IconButton}" Width="20" Height="16" Padding="2"
                        Visibility="Collapsed" ToolTip="변경 취소">
                    <Path Data="{StaticResource IconRotateCcw}" Width="10" Height="10" Stretch="Uniform"
                          Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                          StrokeThickness="1.5" StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round"/>
                </Button>
                <Button x:Name="StageBtn" Grid.Column="4" Tag="{Binding Change}"
                        Click="Stage_Click" Style="{StaticResource IconButton}" Width="20" Height="16" Padding="2"
                        Visibility="Collapsed" ToolTip="stage">
                    <Path Data="{StaticResource IconPlus}" Width="10" Height="10" Stretch="Uniform"
                          Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                          StrokeThickness="1.5" StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round"/>
                </Button>
                <Button x:Name="UnstageBtn" Grid.Column="4" Tag="{Binding Change}"
                        Click="Unstage_Click" Style="{StaticResource IconButton}" Width="20" Height="16" Padding="2"
                        Visibility="Collapsed" ToolTip="unstage">
                    <Rectangle Width="8" Height="1.5" RadiusX="1" RadiusY="1"
                               Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"/>
                </Button>
                <!-- 파일 상태 글자(폴더면 빈칸) — 우측 정렬 -->
                <TextBlock Grid.Column="5" Text="{Binding Status}" Width="14" Margin="11,0,10,0"
                           VerticalAlignment="Center" TextAlignment="Center"
                           FontWeight="Bold" FontSize="{DynamicResource Fs12}" Foreground="{Binding StatusColor}"/>
            </Grid>
            <HierarchicalDataTemplate.Triggers>
                <!-- 파일이면 삼각형 숨김 -->
                <DataTrigger Binding="{Binding IsFolder}" Value="False">
                    <Setter TargetName="Tri" Property="Visibility" Value="Hidden"/>
                </DataTrigger>
                <!-- 펼침 시 삼각형 90° 회전(▶→▼) -->
                <DataTrigger Binding="{Binding IsExpanded}" Value="True">
                    <Setter TargetName="Tri" Property="RenderTransform">
                        <Setter.Value><RotateTransform Angle="90"/></Setter.Value>
                    </Setter>
                </DataTrigger>
                <!-- 평소엔 버튼 숨김 → 이름이 M/U 바로 옆까지 표시. hover 시에만 상태별 버튼 노출
                     → 이름 칼럼이 줄며 자동으로 …(CharacterEllipsis) 처리. -->
                <!-- staged 파일 & hover → unstage -->
                <MultiDataTrigger>
                    <MultiDataTrigger.Conditions>
                        <Condition Binding="{Binding IsMouseOver, RelativeSource={RelativeSource AncestorType=TreeViewItem}}" Value="True"/>
                        <Condition Binding="{Binding Change.IsStaged}" Value="True"/>
                    </MultiDataTrigger.Conditions>
                    <Setter TargetName="UnstageBtn" Property="Visibility" Value="Visible"/>
                </MultiDataTrigger>
                <!-- unstaged 파일 & hover → discard + stage -->
                <MultiDataTrigger>
                    <MultiDataTrigger.Conditions>
                        <Condition Binding="{Binding IsMouseOver, RelativeSource={RelativeSource AncestorType=TreeViewItem}}" Value="True"/>
                        <Condition Binding="{Binding IsFolder}" Value="False"/>
                        <Condition Binding="{Binding Change.IsStaged}" Value="False"/>
                    </MultiDataTrigger.Conditions>
                    <Setter TargetName="DiscardBtn" Property="Visibility" Value="Visible"/>
                    <Setter TargetName="StageBtn" Property="Visibility" Value="Visible"/>
                </MultiDataTrigger>
            </HierarchicalDataTemplate.Triggers>
        </HierarchicalDataTemplate>

        <!-- 커밋 버튼: PrimaryButton 과 동일하되 라운드만 절반(10→5) -->
        <Style x:Key="CommitButton" TargetType="Button" BasedOn="{StaticResource PrimaryButton}">
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd" Background="{TemplateBinding Background}" CornerRadius="5" Padding="16,0">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"
                                              TextElement.Foreground="{TemplateBinding Foreground}"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background">
                                    <Setter.Value><SolidColorBrush Color="{DynamicResource PrimaryHoverColor}"/></Setter.Value>
                                </Setter>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Bd" Property="Background">
                                    <Setter.Value><SolidColorBrush Color="{DynamicResource PrimaryPressedColor}"/></Setter.Value>
                                </Setter>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource LineBrush}"/>
                                <Setter TargetName="Bd" Property="Opacity" Value="1"/>
                                <Setter Property="Foreground" Value="{DynamicResource TextMutedBrush}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </UserControl.Resources>
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- 두 트리를 각각 유한 높이 영역에 두어 TreeView 내부 ScrollViewer(가상화)가 동작하게 한다.
             바깥 ScrollViewer/StackPanel(무한높이)에 넣으면 UI 가상화가 꺼져 변경 파일 전부를 매 레이아웃
             패스마다 measure → 대량 변경(예: untracked 폴더) 시 UI 스레드가 코어를 태워 시스템 전체
             입력까지 느려진다. Staged 는 상한(MaxHeight)까지 자라고, Changes 가 남은 공간을 채운다. -->
        <Grid x:Name="ScmBodyGrid" Grid.Row="0" Margin="4">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>
            <!-- 섹션 헤더(클릭 시 트리 통째 접기/펼치기) -->
            <Grid x:Name="StagedHeaderRow" Grid.Row="0" Background="Transparent"
                  MouseLeftButtonUp="ToggleStaged" Margin="0,11,0,2">
                <StackPanel Orientation="Horizontal">
                    <StackPanel.RenderTransform><TranslateTransform Y="-2"/></StackPanel.RenderTransform>
                    <Grid Width="16">
                        <Path x:Name="StagedChevron" Width="8" Height="8" Stretch="Uniform"
                              Data="M 0 0 L 4 4 L 0 8 Z" Fill="{DynamicResource TextMutedBrush}"
                              RenderTransformOrigin="0.5,0.5"
                              HorizontalAlignment="Center" VerticalAlignment="Center">
                            <Path.RenderTransform><RotateTransform Angle="90"/></Path.RenderTransform>
                        </Path>
                    </Grid>
                    <TextBlock x:Name="StagedHeader" Text="스테이징된 변경 사항" Margin="2,0,0,0"
                               FontSize="{DynamicResource Fs12}" FontWeight="SemiBold"
                               Foreground="{DynamicResource TextBrush}"/>
                </StackPanel>
            </Grid>
            <!-- 스테이징·변경 둘 다 있을 때만 절반 캡(코드에서 MaxHeight 설정) → 초과 시 내부 스크롤 -->
            <Grid x:Name="StagedTreeHost" Grid.Row="1" Margin="0,0,0,0" ClipToBounds="True">
                <TreeView x:Name="StagedTree"
                          Background="Transparent" BorderThickness="0"
                          VirtualizingStackPanel.IsVirtualizing="True"
                          VirtualizingPanel.VirtualizationMode="Recycling"
                          ItemContainerStyle="{StaticResource ScmTreeItem}"
                          ItemTemplate="{StaticResource ScmNode}"
                          ScrollViewer.ScrollChanged="ScmTree_ScrollChanged"
                          ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                    <TreeView.ItemsPanel>
                        <ItemsPanelTemplate>
                            <VirtualizingStackPanel Margin="0,8,0,8"/>
                        </ItemsPanelTemplate>
                    </TreeView.ItemsPanel>
                </TreeView>
                <Rectangle x:Name="StagedFadeTop" Height="24" VerticalAlignment="Top"
                           IsHitTestVisible="False" Panel.ZIndex="1" Visibility="Collapsed"
                           Fill="{DynamicResource PanelBrush}">
                    <Rectangle.OpacityMask>
                        <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                            <GradientStop Offset="0" Color="Black"/>
                            <GradientStop Offset="0.7" Color="Transparent"/>
                        </LinearGradientBrush>
                    </Rectangle.OpacityMask>
                </Rectangle>
                <Rectangle x:Name="StagedFadeBottom" Height="24" VerticalAlignment="Bottom"
                           IsHitTestVisible="False" Panel.ZIndex="1" Visibility="Collapsed"
                           Fill="{DynamicResource PanelBrush}">
                    <Rectangle.OpacityMask>
                        <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                            <GradientStop Offset="0.3" Color="Transparent"/>
                            <GradientStop Offset="1" Color="Black"/>
                        </LinearGradientBrush>
                    </Rectangle.OpacityMask>
                </Rectangle>
            </Grid>

            <!-- 스테이징·변경내용 둘 다 있을 때만 구분선 -->
            <Border x:Name="SectionSeparator" Grid.Row="2" Height="1" Margin="0,7,0,0"
                    Background="{DynamicResource LineBrush}" Visibility="Collapsed"/>

            <Grid x:Name="ChangesHeaderRow" Grid.Row="3" Background="Transparent"
                  MouseLeftButtonUp="ToggleUnstaged" Margin="0,14,0,2">
                <StackPanel Orientation="Horizontal">
                    <StackPanel.RenderTransform><TranslateTransform Y="-2"/></StackPanel.RenderTransform>
                    <Grid Width="16">
                        <Path x:Name="ChangesChevron" Width="8" Height="8" Stretch="Uniform"
                              Data="M 0 0 L 4 4 L 0 8 Z" Fill="{DynamicResource TextMutedBrush}"
                              RenderTransformOrigin="0.5,0.5"
                              HorizontalAlignment="Center" VerticalAlignment="Center">
                            <Path.RenderTransform><RotateTransform Angle="90"/></Path.RenderTransform>
                        </Path>
                    </Grid>
                    <TextBlock x:Name="ChangesHeader" Text="변경 내용" Margin="2,0,0,0"
                               FontSize="{DynamicResource Fs12}" FontWeight="SemiBold"
                               Foreground="{DynamicResource TextBrush}"/>
                </StackPanel>
            </Grid>
            <Grid x:Name="UnstagedTreeHost" Grid.Row="4" Margin="0,0,0,0" ClipToBounds="True">
                <TreeView x:Name="UnstagedTree"
                          Background="Transparent" BorderThickness="0"
                          VirtualizingStackPanel.IsVirtualizing="True"
                          VirtualizingPanel.VirtualizationMode="Recycling"
                          ItemContainerStyle="{StaticResource ScmTreeItem}"
                          ItemTemplate="{StaticResource ScmNode}"
                          ScrollViewer.ScrollChanged="ScmTree_ScrollChanged"
                          ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                    <TreeView.ItemsPanel>
                        <ItemsPanelTemplate>
                            <VirtualizingStackPanel Margin="0,8,0,8"/>
                        </ItemsPanelTemplate>
                    </TreeView.ItemsPanel>
                </TreeView>
                <Rectangle x:Name="ChangesFadeTop" Height="24" VerticalAlignment="Top"
                           IsHitTestVisible="False" Panel.ZIndex="1" Visibility="Collapsed"
                           Fill="{DynamicResource PanelBrush}">
                    <Rectangle.OpacityMask>
                        <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                            <GradientStop Offset="0" Color="Black"/>
                            <GradientStop Offset="0.7" Color="Transparent"/>
                        </LinearGradientBrush>
                    </Rectangle.OpacityMask>
                </Rectangle>
                <Rectangle x:Name="ChangesFadeBottom" Height="24" VerticalAlignment="Bottom"
                           IsHitTestVisible="False" Panel.ZIndex="1" Visibility="Collapsed"
                           Fill="{DynamicResource PanelBrush}">
                    <Rectangle.OpacityMask>
                        <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                            <GradientStop Offset="0.3" Color="Transparent"/>
                            <GradientStop Offset="1" Color="Black"/>
                        </LinearGradientBrush>
                    </Rectangle.OpacityMask>
                </Rectangle>
            </Grid>

            <TextBlock x:Name="EmptyText" Grid.Row="4" Text="변경된 파일이 없습니다." Visibility="Collapsed"
                       Margin="10" TextAlignment="Center" VerticalAlignment="Top"
                       Foreground="{DynamicResource TextMutedBrush}"/>
        </Grid>

        <Border Grid.Row="1" Background="{DynamicResource PanelBrush}"
                BorderBrush="{DynamicResource LineBrush}" BorderThickness="0,1,0,0" Padding="8">
            <StackPanel>
                <!-- 동기화 헤더: 브랜치 + ↓N ↑N + pull/push/fetch 아이콘 -->
                <Grid Margin="2,0,0,6">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <Path Grid.Column="0" Data="{StaticResource IconGitBranch}" Width="14" Height="14" Stretch="Uniform"
                          Style="{StaticResource LucideIcon}" Stroke="{DynamicResource TextMutedBrush}"
                          VerticalAlignment="Center"/>
                    <TextBlock x:Name="BranchText" Grid.Column="1" Margin="6,0,0,0" VerticalAlignment="Center"
                               TextTrimming="CharacterEllipsis"
                               Foreground="{DynamicResource TextBrush}" FontSize="{DynamicResource Fs12}"/>
                    <!-- fetch(점선 아래 화살표)를 맨 왼쪽으로. pull/push/fetch 동일 크기. -->
                    <Button x:Name="FetchBtn" Grid.Column="2" Click="Fetch_Click"
                            Style="{StaticResource IconButton}" Width="24" Height="24" Padding="3" ToolTip="fetch">
                        <!-- Codicon git-fetch (MIT) — 점선(대시) 아래 화살표 -->
                        <Path Data="M13.854 8.854L8.85401 13.854C8.75601 13.952 8.62801 14 8.50001 14C8.37201 14 8.24401 13.951 8.14601 13.854L3.14601 8.854C2.95101 8.659 2.95101 8.342 3.14601 8.147C3.34101 7.952 3.65801 7.952 3.85301 8.147L7.99901 12.293V10.427C7.99901 10.151 8.22301 9.927 8.49901 9.927C8.77501 9.927 8.99901 10.151 8.99901 10.427V12.293L13.145 8.147C13.34 7.952 13.657 7.952 13.852 8.147C14.047 8.342 14.047 8.659 13.852 8.854H13.854ZM8.50001 9C8.77601 9 9.00001 8.776 9.00001 8.5V6.5C9.00001 6.224 8.77601 6 8.50001 6C8.22401 6 8.00001 6.224 8.00001 6.5V8.5C8.00001 8.776 8.22401 9 8.50001 9ZM8.50001 5C8.77601 5 9.00001 4.776 9.00001 4.5V2.5C9.00001 2.224 8.77601 2 8.50001 2C8.22401 2 8.00001 2.224 8.00001 2.5V4.5C8.00001 4.776 8.22401 5 8.50001 5Z"
                              Width="14" Height="14" Stretch="Uniform"
                              Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"/>
                    </Button>
                    <Button x:Name="PullBtn" Grid.Column="3" Click="Pull_Click" Margin="2,0,0,0"
                            Style="{StaticResource IconButton}" Width="24" Height="24" Padding="3" ToolTip="pull">
                        <!-- Codicon arrow-down (MIT) -->
                        <Path Data="M13.854 8.146C13.659 7.951 13.342 7.951 13.147 8.146L9.00096 12.292V2.5C9.00096 2.224 8.77696 2 8.50096 2C8.22496 2 8.00096 2.224 8.00096 2.5V12.293L3.85496 8.147C3.65996 7.952 3.34296 7.952 3.14796 8.147C2.95296 8.342 2.95296 8.659 3.14796 8.854L8.14796 13.854C8.24596 13.952 8.37396 14 8.50196 14C8.62996 14 8.75796 13.951 8.85596 13.854L13.856 8.854C14.051 8.659 14.051 8.342 13.856 8.147L13.854 8.146Z"
                              Width="14" Height="14" Stretch="Uniform"
                              Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"/>
                    </Button>
                    <Button x:Name="PushBtn" Grid.Column="4" Click="Push_Click" Margin="2,0,0,0"
                            Style="{StaticResource IconButton}" Width="24" Height="24" Padding="3" ToolTip="push">
                        <!-- Codicon arrow-up (MIT) -->
                        <Path Data="M13.854 7.14576L8.85401 2.14576C8.65901 1.95076 8.34201 1.95076 8.14701 2.14576L3.14601 7.14576C2.95101 7.34076 2.95101 7.65776 3.14601 7.85276C3.34101 8.04776 3.65801 8.04776 3.85301 7.85276L7.99901 3.70676V13.4998C7.99901 13.7758 8.22301 13.9998 8.49901 13.9998C8.77501 13.9998 8.99901 13.7758 8.99901 13.4998V3.70676L13.145 7.85276C13.243 7.95076 13.371 7.99876 13.499 7.99876C13.627 7.99876 13.755 7.94976 13.853 7.85276C14.048 7.65776 14.048 7.34076 13.853 7.14576H13.854Z"
                              Width="14" Height="14" Stretch="Uniform"
                              Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"/>
                    </Button>
                </Grid>

                <!-- 커밋 메시지 카드 -->
                <Border Background="{DynamicResource BgBrush}"
                        BorderBrush="{DynamicResource LineBrush}" BorderThickness="1"
                        CornerRadius="10" Padding="10,6">
                    <Grid>
                        <TextBox x:Name="MsgBox" BorderThickness="0" Background="Transparent"
                                 Foreground="{DynamicResource TextBrush}" CaretBrush="{DynamicResource TextBrush}"
                                 FontFamily="{StaticResource PretendardFont}" FontSize="{DynamicResource Fs12}"
                                 MinLines="3" MaxLines="8" TextWrapping="Wrap" AcceptsReturn="True"
                                 VerticalContentAlignment="Top" VerticalScrollBarVisibility="Auto"
                                 TextChanged="MsgBox_TextChanged" PreviewKeyDown="MsgBox_PreviewKeyDown"/>
                        <TextBlock x:Name="MsgPlaceholder" Text="메시지" IsHitTestVisible="False"
                                   VerticalAlignment="Top" Margin="1,0,0,0"
                                   Foreground="{DynamicResource TextMutedBrush}"
                                   FontFamily="{StaticResource PretendardFont}" FontSize="{DynamicResource Fs12}">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock" BasedOn="{StaticResource {x:Type TextBlock}}">
                                    <Setter Property="Visibility" Value="Collapsed"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding Text, ElementName=MsgBox}" Value="">
                                            <Setter Property="Visibility" Value="Visible"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>
                    </Grid>
                </Border>

                <!-- 커밋 버튼(전체 폭) -->
                <Button x:Name="CommitBtn" Content="✓ 커밋" Click="Commit_Click" Margin="0,6,0,0"
                        Style="{StaticResource CommitButton}" Height="30" IsEnabled="False"
                        HorizontalAlignment="Stretch" FontSize="{DynamicResource Fs12}"/>
            </StackPanel>
        </Border>
    </Grid>
</UserControl>
