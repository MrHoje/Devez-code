<UserControl x:Class="DevezCode.Views.GitDiffView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:models="clr-namespace:DevezCode.Models"
             Background="{DynamicResource PanelBrush}"
             FontFamily="{StaticResource PretendardFont}">
    <Grid>
        <Grid.ColumnDefinitions>
            <!-- 변경 파일 목록 (우측 보더 1px 가 채널의 좌측 선) -->
            <ColumnDefinition x:Name="ListCol" Width="200" MinWidth="130"/>
            <!-- 4px 채널: BgBrush 간격. 사이의 GridSplitter 는 평소 투명, 호버 시 핸들 노출 (devez 정합) -->
            <ColumnDefinition Width="4"/>
            <!-- 선택 파일 diff (좌측 보더 1px 가 채널의 우측 선) -->
            <ColumnDefinition Width="*" MinWidth="200"/>
        </Grid.ColumnDefinitions>

        <!-- 변경 파일 목록 (전체 높이). Border 로 감싸 우측 1px 보더를 채널 좌측 선으로 사용 -->
        <Border Grid.Column="0"
                Background="{DynamicResource PanelBrush}"
                BorderBrush="{DynamicResource LineBrush}" BorderThickness="0,0,1,0">
            <Grid>
                <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="4,4">
                    <ItemsControl x:Name="ChangesHost">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate DataType="{x:Type models:GitChange}">
                                <Border x:Name="Row" CornerRadius="6" Background="Transparent"
                                        Padding="8,5" Margin="0,1" Cursor="Hand"
                                        MouseLeftButtonUp="Change_Click">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Grid.Column="0" Text="{Binding Status}" Width="16"
                                                   TextAlignment="Center" FontWeight="Bold"
                                                   FontFamily="Cascadia Mono, Consolas, D2Coding, Malgun Gothic"
                                                   FontSize="{DynamicResource Fs12}"
                                                   Foreground="{Binding StatusColor}"/>
                                        <TextBlock Grid.Column="1" Text="{Binding Path}" Margin="8,0,0,0"
                                                   TextTrimming="CharacterEllipsis"
                                                   ToolTip="{Binding Path}"
                                                   FontSize="{DynamicResource Fs12}"
                                                   Foreground="{DynamicResource TextBrush}"/>
                                    </Grid>
                                </Border>
                                <DataTemplate.Triggers>
                                    <Trigger SourceName="Row" Property="IsMouseOver" Value="True">
                                        <Setter TargetName="Row" Property="Background" Value="{DynamicResource PanelSoftBrush}"/>
                                    </Trigger>
                                    <DataTrigger Binding="{Binding IsSelected}" Value="True">
                                        <Setter TargetName="Row" Property="Background" Value="{DynamicResource PrimarySoftBrush}"/>
                                    </DataTrigger>
                                </DataTemplate.Triggers>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>

                <!-- 변경 없음 / 안내 -->
                <TextBlock x:Name="EmptyText" Visibility="Collapsed"
                           VerticalAlignment="Center" HorizontalAlignment="Center"
                           TextAlignment="Center" Margin="14"
                           TextWrapping="Wrap"
                           FontSize="{DynamicResource Fs12}"
                           Foreground="{DynamicResource TextMutedBrush}"/>
            </Grid>
        </Border>

        <!-- 목록 ↔ diff 분할 (devez 정합: 4px 채널 위 투명 오버레이, 호버 시 PrimaryBrush 핸들) -->
        <GridSplitter Grid.Column="1" Width="4" HorizontalAlignment="Stretch"
                      ResizeDirection="Columns" ResizeBehavior="PreviousAndNext"/>

        <!-- 선택 파일 diff (side-by-side: 좌=수정 전 / 우=수정 후). 좌측 1px 보더가 채널 우측 선 -->
        <Border Grid.Column="2"
                Background="{DynamicResource BgBrush}"
                BorderBrush="{DynamicResource LineBrush}" BorderThickness="1,0,0,0">
            <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <!-- diff 머리글: 좌/우 라벨 -->
            <Border x:Name="DiffHeader" Grid.Row="0" Visibility="Collapsed"
                    Background="{DynamicResource PanelBrush}"
                    BorderBrush="{DynamicResource LineBrush}" BorderThickness="0,0,0,1">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="1"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Grid.Column="0" Text="수정 전" Margin="10,5" VerticalAlignment="Center"
                               FontSize="{DynamicResource Fs11}" FontWeight="SemiBold"
                               Foreground="{DynamicResource TextMutedBrush}"/>
                    <Border Grid.Column="1" Background="{DynamicResource LineBrush}"/>
                    <TextBlock Grid.Column="2" Text="수정 후" Margin="10,5" VerticalAlignment="Center"
                               FontSize="{DynamicResource Fs11}" FontWeight="SemiBold"
                               Foreground="{DynamicResource TextMutedBrush}"/>
                </Grid>
            </Border>

            <!-- diff 본문 + 변경 위치 오버뷰 스트립 -->
            <Grid Grid.Row="1">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

            <!-- Ctrl+휠 로 폰트 크기 조절. 라인 텍스트는 DiffList.FontSize 를 상속.
                 ListBox 는 가상화를 기본 지원(픽셀 단위)하므로 큰 파일도 화면 분량만 렌더한다. -->
            <ListBox x:Name="DiffList" Grid.Column="0"
                     Background="Transparent" BorderThickness="0"
                     Padding="0" HorizontalContentAlignment="Stretch"
                     ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                     ScrollViewer.VerticalScrollBarVisibility="Auto"
                     VirtualizingPanel.IsVirtualizing="True"
                     VirtualizingPanel.VirtualizationMode="Recycling"
                     VirtualizingPanel.ScrollUnit="Pixel"
                     TextOptions.TextFormattingMode="Ideal"
                     PreviewMouseWheel="DiffScroller_PreviewMouseWheel">
                <ListBox.ItemContainerStyle>
                    <!-- 컨테이너 장식 제거(선택/호버/패딩) — diff 행은 자체 배경만 사용 -->
                    <Style TargetType="ListBoxItem">
                        <Setter Property="Padding" Value="0"/>
                        <Setter Property="Margin" Value="0"/>
                        <Setter Property="BorderThickness" Value="0"/>
                        <Setter Property="Focusable" Value="False"/>
                        <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                        <Setter Property="Template">
                            <Setter.Value>
                                <ControlTemplate TargetType="ListBoxItem">
                                    <ContentPresenter/>
                                </ControlTemplate>
                            </Setter.Value>
                        </Setter>
                    </Style>
                </ListBox.ItemContainerStyle>
                <ListBox.ItemTemplate>
                        <DataTemplate DataType="{x:Type models:DiffRow}">
                            <Grid>
                                <!-- hunk 머리글 (@@ …) — 양쪽에 걸쳐 한 줄 -->
                                <Border x:Name="HunkBd" Visibility="Collapsed"
                                        Background="{DynamicResource PanelSoftBrush}" Padding="8,2">
                                    <TextBlock Text="{Binding HunkText}"
                                               FontFamily="Cascadia Mono, Consolas, D2Coding, Malgun Gothic"
                                               Foreground="#58A6FF"/>
                                </Border>

                                <!-- 좌/우 코드 셀 (줄 번호는 고정 폭 — SharedSize 제거로 가상화 유지) -->
                                <Grid x:Name="ColsGrid">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="46"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="1"/>
                                        <ColumnDefinition Width="46"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>

                                    <!-- 좌(수정 전) 배경: 번호+코드 두 칼럼 덮기 -->
                                    <Border x:Name="LeftBg" Grid.Column="0" Grid.ColumnSpan="2" Background="Transparent"/>
                                    <!-- 우(수정 후) 배경 -->
                                    <Border x:Name="RightBg" Grid.Column="3" Grid.ColumnSpan="2" Background="Transparent"/>

                                    <TextBlock Grid.Column="0" Text="{Binding LeftNum}"
                                               Padding="6,1,8,1" TextAlignment="Right"
                                               FontFamily="Cascadia Mono, Consolas, D2Coding, Malgun Gothic"
                                               Foreground="{DynamicResource TextMutedBrush}"/>
                                    <TextBlock x:Name="LeftTxt" Grid.Column="1" Text="{Binding LeftText}"
                                               Padding="2,1,8,1" TextWrapping="Wrap"
                                               FontFamily="Cascadia Mono, Consolas, D2Coding, Malgun Gothic"
                                               Foreground="{DynamicResource TextBrush}"/>

                                    <Border Grid.Column="2" Background="{DynamicResource LineBrush}"/>

                                    <TextBlock Grid.Column="3" Text="{Binding RightNum}"
                                               Padding="6,1,8,1" TextAlignment="Right"
                                               FontFamily="Cascadia Mono, Consolas, D2Coding, Malgun Gothic"
                                               Foreground="{DynamicResource TextMutedBrush}"/>
                                    <TextBlock x:Name="RightTxt" Grid.Column="4" Text="{Binding RightText}"
                                               Padding="2,1,8,1" TextWrapping="Wrap"
                                               FontFamily="Cascadia Mono, Consolas, D2Coding, Malgun Gothic"
                                               Foreground="{DynamicResource TextBrush}"/>
                                </Grid>
                            </Grid>
                            <DataTemplate.Triggers>
                                <DataTrigger Binding="{Binding IsHunk}" Value="True">
                                    <Setter TargetName="HunkBd" Property="Visibility" Value="Visible"/>
                                    <Setter TargetName="ColsGrid" Property="Visibility" Value="Collapsed"/>
                                </DataTrigger>
                                <!-- 좌측 셀 상태 -->
                                <DataTrigger Binding="{Binding LeftKind}" Value="Del">
                                    <Setter TargetName="LeftBg" Property="Background" Value="#26F85149"/>
                                    <Setter TargetName="LeftTxt" Property="Foreground" Value="#F85149"/>
                                </DataTrigger>
                                <DataTrigger Binding="{Binding LeftKind}" Value="Empty">
                                    <Setter TargetName="LeftBg" Property="Background" Value="#14808080"/>
                                </DataTrigger>
                                <!-- 우측 셀 상태 -->
                                <DataTrigger Binding="{Binding RightKind}" Value="Add">
                                    <Setter TargetName="RightBg" Property="Background" Value="#263FB950"/>
                                    <Setter TargetName="RightTxt" Property="Foreground" Value="#3FB950"/>
                                </DataTrigger>
                                <DataTrigger Binding="{Binding RightKind}" Value="Empty">
                                    <Setter TargetName="RightBg" Property="Background" Value="#14808080"/>
                                </DataTrigger>
                            </DataTemplate.Triggers>
                        </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>

            <!-- 변경 위치 오버뷰 스트립(스크롤바 옆): 추가=녹색·삭제=빨강·수정=노랑.
                 클릭 시 해당 위치로 스크롤. 마커는 코드에서 그린다. -->
            <Canvas x:Name="MarkerStrip" Grid.Column="1" Width="12"
                    Background="{DynamicResource PanelBrush}" ClipToBounds="True" Cursor="Hand"
                    ToolTip="변경 위치 — 클릭하면 해당 지점으로 이동"
                    MouseLeftButtonDown="MarkerStrip_Click"
                    SizeChanged="MarkerStrip_SizeChanged"/>
            </Grid>

            <TextBlock x:Name="DiffHint" Grid.Row="1" Visibility="Collapsed"
                       VerticalAlignment="Center" HorizontalAlignment="Center"
                       Text="변경 파일을 선택하면 전체 코드 비교가 표시됩니다."
                       FontSize="{DynamicResource Fs12}"
                       Foreground="{DynamicResource TextMutedBrush}"/>
            </Grid>
        </Border>
    </Grid>
</UserControl>
