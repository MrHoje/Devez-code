<Window x:Class="DevezCode.Views.AgentPickerDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:svc="clr-namespace:DevezCode.Services"
        xmlns:models="clr-namespace:DevezCode.Models"
        Title="에이전트 선택"
        Width="380" Height="Auto"
        WindowStartupLocation="CenterOwner"
        WindowStyle="None"
        ResizeMode="NoResize"
        AllowsTransparency="True"
        Background="Transparent"
        ShowInTaskbar="False"
        UseLayoutRounding="True"
        SnapsToDevicePixels="True"
        TextOptions.TextFormattingMode="Display"
        FontFamily="{StaticResource PretendardFont}">

    <Window.Resources>
        <!-- 에이전트 카드: 110 × 50, 아이콘 + 이름만. 단순 호버 -->
        <Style x:Key="AgentCard" TargetType="Border">
            <Setter Property="CornerRadius" Value="8"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="BorderBrush" Value="{DynamicResource LineBrush}"/>
            <Setter Property="Background" Value="{DynamicResource PanelBrush}"/>
            <Setter Property="Width" Value="110"/>
            <Setter Property="Height" Value="50"/>
            <Setter Property="Margin" Value="0,0,6,0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="{DynamicResource PanelSoftBrush}"/>
                    <Setter Property="BorderBrush" Value="{DynamicResource PrimaryBrush}"/>
                </Trigger>
            </Style.Triggers>
        </Style>
    </Window.Resources>

    <Grid Margin="{DynamicResource WindowShadowOuterMargin}">
        <Border Background="{DynamicResource BgBrush}" CornerRadius="{DynamicResource WindowShadowCornerRadius}"
                Margin="{DynamicResource WindowShadowInnerMargin}" SnapsToDevicePixels="True">
            <Border.Effect>
                <DropShadowEffect ShadowDepth="0" BlurRadius="{DynamicResource WindowShadowBlurRadius}" Direction="270"
                                  Color="{DynamicResource ShadowColor}" Opacity="{DynamicResource ShadowOpacity}"/>
            </Border.Effect>
        </Border>
        <Border CornerRadius="12"
                Background="{DynamicResource BgBrush}"
                BorderBrush="{DynamicResource LineBrush}" BorderThickness="1"
                ClipToBounds="True" SnapsToDevicePixels="True">
            <StackPanel Margin="20,16,20,14">
                <!-- 타이틀 -->
                <StackPanel Orientation="Horizontal" Margin="0,0,0,4">
                    <TextBlock Text="에이전트 선택" FontSize="{DynamicResource Fs13}" FontWeight="SemiBold"
                               Foreground="{DynamicResource TextBrush}" VerticalAlignment="Center"/>
                    <TextBlock x:Name="CountText" FontSize="{DynamicResource Fs12}"
                               Foreground="{DynamicResource TextMutedBrush}" Margin="8,0,0,0"
                               VerticalAlignment="Center"/>
                </StackPanel>
                <TextBlock x:Name="HintText" FontSize="{DynamicResource Fs11}"
                           Foreground="{DynamicResource TextMutedBrush}" Margin="0,0,0,12"
                           TextTrimming="CharacterEllipsis" MaxWidth="340"/>

                <!-- 카드 (가로, 한 줄) -->
                <ItemsControl x:Name="AgentList">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <WrapPanel Orientation="Horizontal"/>
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate DataType="{x:Type svc:AgentDef}">
                            <Border Style="{StaticResource AgentCard}"
                                    Tag="{Binding Id}"
                                    MouseLeftButtonUp="Card_Click">
                                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center">
                                    <Image Width="22" Height="22" Margin="0,0,7,0"
                                           Source="{Binding Id, Converter={x:Static models:AgentImageConverter.Instance}}"
                                           RenderOptions.BitmapScalingMode="HighQuality" Stretch="Uniform"/>
                                    <TextBlock Text="{Binding DisplayName}"
                                               FontSize="{DynamicResource Fs12}" FontWeight="SemiBold"
                                               Foreground="{DynamicResource TextBrush}" VerticalAlignment="Center"
                                               TextTrimming="CharacterEllipsis"/>
                                </StackPanel>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </StackPanel>
        </Border>
    </Grid>
</Window>
