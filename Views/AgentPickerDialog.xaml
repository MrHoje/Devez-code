<Window x:Class="DevezCode.Views.AgentPickerDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:svc="clr-namespace:DevezCode.Services"
        xmlns:models="clr-namespace:DevezCode.Models"
        Title="에이전트 선택"
        Width="380" Height="Auto"
        WindowStartupLocation="CenterOwner"
        WindowStyle="None"
        ResizeMode="NoResize"
        AllowsTransparency="True"
        Background="Transparent"
        ShowInTaskbar="False"
        UseLayoutRounding="True"
        SnapsToDevicePixels="True"
        TextOptions.TextFormattingMode="Display"
        FontFamily="{StaticResource PretendardFont}">

    <Grid Margin="{DynamicResource WindowShadowOuterMargin}">
        <Border Background="{DynamicResource BgBrush}" CornerRadius="{DynamicResource WindowShadowCornerRadius}"
                Margin="{DynamicResource WindowShadowInnerMargin}" SnapsToDevicePixels="True">
            <Border.Effect>
                <DropShadowEffect ShadowDepth="0" BlurRadius="{DynamicResource WindowShadowBlurRadius}" Direction="270"
                                  Color="{DynamicResource ShadowColor}" Opacity="{DynamicResource ShadowOpacity}"/>
            </Border.Effect>
        </Border>
        <Border CornerRadius="12"
                Background="{DynamicResource BgBrush}"
                BorderBrush="{DynamicResource TodayBrush}" BorderThickness="1.5"
                ClipToBounds="True" SnapsToDevicePixels="True">
            <StackPanel Margin="18,16,18,14">
                <!-- 타이틀 + 프로젝트 경로 -->
                <TextBlock Text="에이전트 선택" FontSize="{DynamicResource Fs14}" FontWeight="SemiBold"
                           Foreground="{DynamicResource TextBrush}" Margin="0,0,0,4"/>
                <TextBlock x:Name="HintText" FontSize="{DynamicResource Fs11}"
                           Foreground="{DynamicResource TextMutedBrush}" Margin="0,0,0,14"
                           TextTrimming="CharacterEllipsis" MaxWidth="340"/>

                <!-- 세로 풀폭 카드 목록. RadioButton 으로 단일 선택 + 호버/체크 상태 표시 -->
                <ItemsControl x:Name="AgentList">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate DataType="{x:Type svc:AgentDef}">
                            <RadioButton GroupName="AgentPicker"
                                         Click="Card_Click"
                                         Tag="{Binding Id}"
                                         Cursor="Hand"
                                         Focusable="False"
                                         HorizontalContentAlignment="Stretch"
                                         VerticalContentAlignment="Stretch">
                                <RadioButton.Template>
                                    <ControlTemplate TargetType="RadioButton">
                                        <Border x:Name="Card"
                                                CornerRadius="10" BorderThickness="1"
                                                BorderBrush="{DynamicResource LineBrush}"
                                                Background="{DynamicResource PanelBrush}"
                                                Padding="12,10" Margin="0,0,0,8"
                                                SnapsToDevicePixels="True">
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="Auto"/>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="Auto"/>
                                                </Grid.ColumnDefinitions>

                                                <Image Grid.Column="0" Width="40" Height="40" Margin="0,0,14,0"
                                                       Source="{Binding Id, Converter={x:Static models:AgentImageConverter.Instance}}"
                                                       RenderOptions.BitmapScalingMode="HighQuality" Stretch="Uniform"
                                                       VerticalAlignment="Center"/>

                                                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                                    <TextBlock Text="{Binding DisplayName}"
                                                               FontSize="{DynamicResource Fs13}" FontWeight="SemiBold"
                                                               Foreground="{DynamicResource TextBrush}"/>
                                                    <TextBlock Text="{Binding Provider}"
                                                               FontSize="{DynamicResource Fs11}"
                                                               Foreground="{DynamicResource TextMutedBrush}"
                                                               Margin="0,2,0,0"/>
                                                </StackPanel>

                                                <!-- 라디오: 평소 빈 원, 호버/체크 시 TodayBrush 채움 + 흰 체크 -->
                                                <Grid Grid.Column="2" Width="22" Height="22" VerticalAlignment="Center">
                                                    <Ellipse x:Name="Ring" Width="22" Height="22"
                                                             Stroke="{DynamicResource LineBrush}" StrokeThickness="1.5"
                                                             Fill="Transparent"/>
                                                    <Ellipse x:Name="Dot" Width="22" Height="22"
                                                             Fill="{DynamicResource TodayBrush}" Visibility="Collapsed"/>
                                                    <Path x:Name="Check" Data="M 0,5 L 4.5,9.5 L 12,1.5"
                                                          Stretch="None"
                                                          Stroke="White" StrokeThickness="2"
                                                          StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                                                          StrokeLineJoin="Round"
                                                          HorizontalAlignment="Center" VerticalAlignment="Center"
                                                          Visibility="Collapsed"/>
                                                </Grid>
                                            </Grid>
                                        </Border>
                                        <ControlTemplate.Triggers>
                                            <Trigger Property="IsMouseOver" Value="True">
                                                <Setter TargetName="Card" Property="Background" Value="{DynamicResource PanelSoftBrush}"/>
                                                <Setter TargetName="Card" Property="BorderBrush" Value="{DynamicResource TodayBrush}"/>
                                                <Setter TargetName="Dot" Property="Visibility" Value="Visible"/>
                                                <Setter TargetName="Check" Property="Visibility" Value="Visible"/>
                                                <Setter TargetName="Ring" Property="Visibility" Value="Collapsed"/>
                                            </Trigger>
                                            <Trigger Property="IsChecked" Value="True">
                                                <Setter TargetName="Dot" Property="Visibility" Value="Visible"/>
                                                <Setter TargetName="Check" Property="Visibility" Value="Visible"/>
                                                <Setter TargetName="Ring" Property="Visibility" Value="Collapsed"/>
                                            </Trigger>
                                        </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                </RadioButton.Template>
                            </RadioButton>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </StackPanel>
        </Border>
    </Grid>
</Window>
