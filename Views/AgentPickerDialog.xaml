<Window x:Class="DevezCode.Views.AgentPickerDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:svc="clr-namespace:DevezCode.Services"
        Title="에이전트 선택"
        Width="540" Height="Auto"
        WindowStartupLocation="CenterOwner"
        WindowStyle="None"
        ResizeMode="NoResize"
        AllowsTransparency="True"
        Background="Transparent"
        ShowInTaskbar="False"
        UseLayoutRounding="True"
        SnapsToDevicePixels="True"
        TextOptions.TextFormattingMode="Display"
        FontFamily="{StaticResource PretendardFont}">

    <Window.Resources>
        <!-- 에이전트 카드 (가로 150 × 64) -->
        <Style x:Key="AgentCard" TargetType="Border">
            <Setter Property="CornerRadius" Value="10"/>
            <Setter Property="BorderThickness" Value="1.5"/>
            <Setter Property="BorderBrush" Value="{DynamicResource LineBrush}"/>
            <Setter Property="Background" Value="{DynamicResource PanelBrush}"/>
            <Setter Property="Width" Value="150"/>
            <Setter Property="Height" Value="64"/>
            <Setter Property="Margin" Value="0,0,8,8"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="{DynamicResource PanelSoftBrush}"/>
                    <Setter Property="BorderBrush" Value="{DynamicResource PrimaryBrush}"/>
                </Trigger>
            </Style.Triggers>
        </Style>
    </Window.Resources>

    <Grid Margin="{DynamicResource WindowShadowOuterMargin}">
        <Border Background="{DynamicResource BgBrush}" CornerRadius="{DynamicResource WindowShadowCornerRadius}"
                Margin="{DynamicResource WindowShadowInnerMargin}" SnapsToDevicePixels="True">
            <Border.Effect>
                <DropShadowEffect ShadowDepth="0" BlurRadius="{DynamicResource WindowShadowBlurRadius}" Direction="270"
                                  Color="{DynamicResource ShadowColor}" Opacity="{DynamicResource ShadowOpacity}"/>
            </Border.Effect>
        </Border>
        <Border CornerRadius="12"
                Background="{DynamicResource BgBrush}"
                BorderBrush="{DynamicResource LineBrush}" BorderThickness="1"
                ClipToBounds="True" SnapsToDevicePixels="True">
            <StackPanel Margin="22,20,22,18">
                <StackPanel Orientation="Horizontal">
                    <Path Style="{StaticResource LucideIcon}" Data="{StaticResource IconPlus}"
                          Width="15" Height="15" VerticalAlignment="Center" Margin="0,0,9,0"
                          Stroke="{DynamicResource TextBrush}"/>
                    <TextBlock Text="새 세션 — 에이전트 선택" FontSize="{DynamicResource Fs14}" FontWeight="SemiBold"
                               Foreground="{DynamicResource TextBrush}" VerticalAlignment="Center"/>
                </StackPanel>
                <TextBlock x:Name="HintText" FontSize="{DynamicResource Fs12}"
                           Foreground="{DynamicResource TextMutedBrush}" Margin="0,6,0,14"
                           TextWrapping="Wrap"/>

                <ItemsControl x:Name="AgentList">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <WrapPanel Orientation="Horizontal"/>
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate DataType="{x:Type svc:AgentDef}">
                            <Border Style="{StaticResource AgentCard}"
                                    Tag="{Binding Id}"
                                    MouseLeftButtonUp="Card_Click">
                                <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                                    <TextBlock Text="{Binding DisplayName}"
                                               FontSize="{DynamicResource Fs13}" FontWeight="SemiBold"
                                               Foreground="{DynamicResource TextBrush}"/>
                                </StackPanel>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>

                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,16,0,0">
                    <Button x:Name="CancelBtn" Click="CancelBtn_Click"
                            MinWidth="80" Height="34" Padding="14,0" Margin="0,0,8,0"
                            Style="{StaticResource SecondaryButton}" FontSize="{DynamicResource Fs12}">
                        <TextBlock Text="취소"/>
                    </Button>
                </StackPanel>
            </StackPanel>
        </Border>
    </Grid>
</Window>
