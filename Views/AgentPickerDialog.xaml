<Window x:Class="DevezCode.Views.AgentPickerDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:svc="clr-namespace:DevezCode.Services"
        xmlns:models="clr-namespace:DevezCode.Models"
        Title="새 세션 — 에이전트 선택"
        Width="560" Height="Auto"
        WindowStartupLocation="CenterOwner"
        WindowStyle="None"
        ResizeMode="NoResize"
        AllowsTransparency="True"
        Background="Transparent"
        ShowInTaskbar="False"
        UseLayoutRounding="True"
        SnapsToDevicePixels="True"
        TextOptions.TextFormattingMode="Display"
        FontFamily="{StaticResource PretendardFont}">

    <Window.Resources>
        <!-- 에이전트 카드: 160 × 110, 아이콘 + 이름 + 설명 + 화살표 -->
        <Style x:Key="AgentCard" TargetType="Border">
            <Setter Property="CornerRadius" Value="12"/>
            <Setter Property="BorderThickness" Value="1.5"/>
            <Setter Property="BorderBrush" Value="{DynamicResource LineBrush}"/>
            <Setter Property="Background" Value="{DynamicResource PanelBrush}"/>
            <Setter Property="Width" Value="160"/>
            <Setter Property="Height" Value="110"/>
            <Setter Property="Margin" Value="0,0,12,12"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Focusable" Value="True"/>
            <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="{DynamicResource PanelSoftBrush}"/>
                    <Setter Property="BorderBrush" Value="{DynamicResource PrimaryBrush}"/>
                </Trigger>
                <Trigger Property="IsKeyboardFocused" Value="True">
                    <Setter Property="Background" Value="{DynamicResource PanelSoftBrush}"/>
                    <Setter Property="BorderBrush" Value="{DynamicResource PrimaryBrush}"/>
                </Trigger>
            </Style.Triggers>
        </Style>
    </Window.Resources>

    <Grid Margin="{DynamicResource WindowShadowOuterMargin}">
        <!-- 그림자 레이어 -->
        <Border Background="{DynamicResource BgBrush}" CornerRadius="{DynamicResource WindowShadowCornerRadius}"
                Margin="{DynamicResource WindowShadowInnerMargin}" SnapsToDevicePixels="True">
            <Border.Effect>
                <DropShadowEffect ShadowDepth="0" BlurRadius="{DynamicResource WindowShadowBlurRadius}" Direction="270"
                                  Color="{DynamicResource ShadowColor}" Opacity="{DynamicResource ShadowOpacity}"/>
            </Border.Effect>
        </Border>
        <!-- 콘텐츠 레이어 -->
        <Border CornerRadius="14"
                Background="{DynamicResource BgBrush}"
                BorderBrush="{DynamicResource LineBrush}" BorderThickness="1"
                ClipToBounds="True" SnapsToDevicePixels="True">
            <StackPanel Margin="22,20,22,18">
                <!-- 헤더: 아이콘 + 타이틀 + 기본 뱃지 -->
                <StackPanel Orientation="Horizontal">
                    <Path Style="{StaticResource LucideIcon}" Data="{StaticResource IconPlus}"
                          Width="16" Height="16" VerticalAlignment="Center" Margin="0,0,9,0"
                          Stroke="{DynamicResource TextBrush}"/>
                    <TextBlock Text="새 세션" FontSize="{DynamicResource Fs15}" FontWeight="SemiBold"
                               Foreground="{DynamicResource TextBrush}" VerticalAlignment="Center"/>
                </StackPanel>
                <TextBlock x:Name="HintText" FontSize="{DynamicResource Fs12}"
                           Foreground="{DynamicResource TextMutedBrush}" Margin="0,6,0,16"
                           TextWrapping="Wrap" MaxWidth="500"
                           TextTrimming="CharacterEllipsis"/>

                <!-- 에이전트 카드 그리드 (3열 균등) -->
                <ItemsControl x:Name="AgentList" Focusable="True"
                              KeyboardNavigation.TabNavigation="Continue">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <WrapPanel Orientation="Horizontal"/>
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate DataType="{x:Type svc:AgentDef}">
                            <Border Style="{StaticResource AgentCard}"
                                    Tag="{Binding Id}"
                                    MouseLeftButtonUp="Card_Click"
                                    KeyDown="Card_KeyDown">
                                <Border.ToolTip>
                                    <ToolTip Content="{Binding Description}"/>
                                </Border.ToolTip>
                                <Grid Margin="14,12">
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="32"/>
                                        <RowDefinition Height="*"/>
                                    </Grid.RowDefinitions>
                                    <!-- 아이콘 + 이름 -->
                                    <StackPanel Grid.Row="0" Orientation="Horizontal" VerticalAlignment="Center">
                                        <Border Width="32" Height="32" CornerRadius="8"
                                                Background="{DynamicResource PanelSoftBrush}" Padding="4" Margin="0,0,9,0">
                                            <Image Source="{Binding Id, Converter={x:Static models:AgentImageConverter.Instance}}"
                                                   RenderOptions.BitmapScalingMode="HighQuality" Stretch="Uniform"/>
                                        </Border>
                                        <TextBlock Text="{Binding DisplayName}"
                                                   FontSize="{DynamicResource Fs13}" FontWeight="SemiBold"
                                                   Foreground="{DynamicResource TextBrush}"
                                                   VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
                                    </StackPanel>
                                    <!-- 설명 + 호버 시 ↵ -->
                                    <Grid Grid.Row="1">
                                        <TextBlock Text="{Binding Description}" TextWrapping="Wrap"
                                                   FontSize="{DynamicResource Fs11}"
                                                   Foreground="{DynamicResource TextMutedBrush}"
                                                   VerticalAlignment="Top" Margin="0,8,0,0"/>
                                        <TextBlock Text="↵" FontSize="14"
                                                   HorizontalAlignment="Right" VerticalAlignment="Bottom"
                                                   Foreground="{DynamicResource PrimaryBrush}" Opacity="0.7"/>
                                    </Grid>
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>

                <!-- 푸터: 안내 + 취소 -->
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,8,0,0">
                    <TextBlock Text="Enter 선택 · ESC 취소"
                               FontSize="{DynamicResource Fs11}"
                               Foreground="{DynamicResource TextMutedBrush}"
                               VerticalAlignment="Center" Margin="0,0,12,0"/>
                    <Button x:Name="CancelBtn" Click="CancelBtn_Click"
                            MinWidth="80" Height="34" Padding="14,0"
                            Style="{StaticResource SecondaryButton}" FontSize="{DynamicResource Fs12}">
                        <TextBlock Text="취소"/>
                    </Button>
                </StackPanel>
            </StackPanel>
        </Border>
    </Grid>
</Window>
