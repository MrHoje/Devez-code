<Window x:Class="DevezCode.Views.AgentPickerDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:svc="clr-namespace:DevezCode.Services"
        xmlns:models="clr-namespace:DevezCode.Models"
        Title="에이전트 선택"
        Width="340" SizeToContent="Height"
        WindowStartupLocation="CenterOwner"
        WindowStyle="None"
        ResizeMode="NoResize"
        AllowsTransparency="True"
        Background="Transparent"
        ShowInTaskbar="False"
        UseLayoutRounding="True"
        SnapsToDevicePixels="True"
        TextOptions.TextFormattingMode="Display"
        FontFamily="{StaticResource PretendardFont}">

    <Grid Margin="{DynamicResource WindowShadowOuterMargin}">
        <!-- Shadow layer -->
        <Border Background="{DynamicResource BgBrush}" CornerRadius="{DynamicResource WindowShadowCornerRadius}"
                Margin="{DynamicResource WindowShadowInnerMargin}" SnapsToDevicePixels="True">
            <Border.Effect>
                <DropShadowEffect ShadowDepth="0" BlurRadius="{DynamicResource WindowShadowBlurRadius}" Direction="270"
                                  Color="{DynamicResource ShadowColor}" Opacity="{DynamicResource ShadowOpacity}"/>
            </Border.Effect>
        </Border>
        <!-- Content layer (설정창과 동일한 일반 보더) -->
        <Border CornerRadius="14"
                Background="{DynamicResource BgBrush}"
                BorderBrush="{DynamicResource LineBrush}" BorderThickness="1"
                ClipToBounds="True" SnapsToDevicePixels="True">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <!-- 본문 -->
                <StackPanel Grid.Row="0" Margin="16,12,16,8">
                    <!-- 타이틀 + X 닫기 (우상단) -->
                    <Grid Margin="0,0,0,8">
                        <TextBlock Text="에이전트 선택" FontSize="{DynamicResource Fs14}" FontWeight="SemiBold"
                                   Foreground="{DynamicResource TextBrush}" VerticalAlignment="Center"/>
                        <Button Click="CancelBtn_Click"
                                HorizontalAlignment="Right" VerticalAlignment="Top"
                                Width="28" Height="28" Margin="0,-4,-6,0"
                                Style="{StaticResource WinCloseBtn}">
                            <TextBlock Text="&#x2715;" FontSize="{DynamicResource Fs11}"/>
                        </Button>
                    </Grid>
                    <!-- 프로젝트 경로. 카드와의 간격 = 본문 하단 여백(8)과 동일 -->
                    <TextBlock x:Name="HintText" FontSize="{DynamicResource Fs11}"
                               Foreground="{DynamicResource TextMutedBrush}" Margin="0,0,0,13"
                               TextTrimming="CharacterEllipsis" MaxWidth="300"/>

                    <!-- 세로 풀폭 카드 목록. RadioButton 으로 단일 선택 + 호버/체크 상태 표시 -->
                    <ItemsControl x:Name="AgentList">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate DataType="{x:Type svc:AgentDef}">
                                <RadioButton GroupName="AgentPicker"
                                             Click="Card_Click"
                                             Tag="{Binding Id}"
                                             Cursor="Arrow"
                                             Focusable="False"
                                             HorizontalContentAlignment="Stretch"
                                             VerticalContentAlignment="Stretch">
                                    <RadioButton.Template>
                                        <ControlTemplate TargetType="RadioButton">
                                            <Grid Margin="0,0,0,6" SnapsToDevicePixels="True">
                                                <Border x:Name="Card"
                                                        CornerRadius="8" BorderThickness="1"
                                                        BorderBrush="{DynamicResource LineBrush}"
                                                        Background="{DynamicResource PanelBrush}"
                                                        Padding="10,7">
                                                    <Grid>
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="Auto"/>
                                                            <ColumnDefinition Width="*"/>
                                                            <ColumnDefinition Width="Auto"/>
                                                        </Grid.ColumnDefinitions>

                                                        <Image Grid.Column="0" Width="26" Height="26" Margin="0,0,11,0"
                                                               Source="{Binding Id, Converter={x:Static models:AgentImageConverter.Instance}}"
                                                               RenderOptions.BitmapScalingMode="HighQuality" Stretch="Uniform"
                                                               VerticalAlignment="Center"/>

                                                        <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                                            <TextBlock Text="{Binding DisplayName}"
                                                                       FontSize="{DynamicResource Fs13}" FontWeight="SemiBold"
                                                                       Foreground="{DynamicResource TextBrush}"/>
                                                            <TextBlock Text="{Binding Provider}"
                                                                       FontSize="{DynamicResource Fs11}"
                                                                       Foreground="{DynamicResource TextMutedBrush}"
                                                                       Margin="0,1,0,0"/>
                                                        </StackPanel>

                                                        <!-- 라디오 체크 불필요 — 클릭 즉시 생성 -->
                                                        <Grid Grid.Column="2" Width="18" Height="18" VerticalAlignment="Center"/>
                                                    </Grid>
                                                </Border>
                                                <!-- 단축키(키보드) 진입 시 하이라이트 — 테마 강조색을 흐리게 한 점선 보더 -->
                                                <Rectangle x:Name="HiCue" RadiusX="8" RadiusY="8"
                                                           Stroke="{DynamicResource PrimaryBrush}" StrokeThickness="1.5"
                                                           StrokeDashArray="3 2.5" Opacity="0.55"
                                                           IsHitTestVisible="False" Visibility="Collapsed"/>
                                            </Grid>
                                            <ControlTemplate.Triggers>
                                                <Trigger Property="IsMouseOver" Value="True">
                                                    <Setter TargetName="Card" Property="Background" Value="{DynamicResource PanelSoftBrush}"/>
                                                </Trigger>
                                                <Trigger Property="IsChecked" Value="True">
                                                    <Setter TargetName="Card" Property="Background" Value="{DynamicResource PanelSoftBrush}"/>
                                                    <Setter TargetName="Card" Property="BorderBrush" Value="{DynamicResource PrimaryBrush}"/>
                                                </Trigger>
                                            </ControlTemplate.Triggers>
                                        </ControlTemplate>
                                    </RadioButton.Template>
                                </RadioButton>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>

                <!-- Footer: 취소 (확인은 카드 클릭 시 바로 처리) -->
                <Border Grid.Row="1"
                        Background="{DynamicResource PanelSoftBrush}"
                        BorderBrush="{DynamicResource LineBrush}"
                        BorderThickness="0,1,0,0">
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right"
                                Margin="16,9,16,9">
                        <Button Click="CancelBtn_Click"
                                Width="92" Height="34"
                                Style="{StaticResource SecondaryButton}"
                                FontSize="{DynamicResource Fs12}">
                            <TextBlock Text="취소"/>
                        </Button>
                    </StackPanel>
                </Border>
            </Grid>
        </Border>
    </Grid>
</Window>
