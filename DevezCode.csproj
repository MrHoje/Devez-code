<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net9.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWPF>true</UseWPF>
    <RootNamespace>DevezCode</RootNamespace>
    <AssemblyName>DevezCode</AssemblyName>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <AppendTargetFrameworkToOutputPath>false</AppendTargetFrameworkToOutputPath>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Web.WebView2" Version="1.0.3967.48" />
  </ItemGroup>

  <ItemGroup>
    <!-- xterm.js 번들을 실행 폴더로 복사 (WebView2 가상 호스트가 디스크에서 로드) -->
    <Content Include="Resources\Terminal\web\**">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
  </ItemGroup>

  <ItemGroup>
    <Resource Include="Fonts\Pretendard-Regular.ttf" />
    <Resource Include="Fonts\Pretendard-Medium.ttf" />
    <Resource Include="Fonts\Pretendard-SemiBold.ttf" />
    <Resource Include="Fonts\Pretendard-Bold.ttf" />
    <Resource Include="Fonts\BrunoAceSC-Regular.ttf" />
  </ItemGroup>

</Project>
