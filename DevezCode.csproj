<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net9.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWPF>true</UseWPF>
    <RootNamespace>DevezCode</RootNamespace>
    <AssemblyName>DevezCode</AssemblyName>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <AppendTargetFrameworkToOutputPath>false</AppendTargetFrameworkToOutputPath>
    <!-- 단일 버전 소스: UpdateService.CurrentVersion 이 이 값을 읽는다. 릴리스 때 여기만 올린다.
         (csproj <Version> → 어셈블리 버전 → FileVersion → version.json 이 자동 일치) -->
    <Version>1.0.0</Version>
    <!-- 아래 3개는 single-file publish 시에만 효력 — 일반 dotnet build 동작에는 영향 없음.
         네이티브 DLL(WebView2Loader)·Content(xterm.js 자산)·zstd.exe 를 단일 exe 에 포함 →
         자동 업데이트가 DevezCode.exe 하나만 교체해도 터미널/델타복원이 동작한다.
         실행 시 임시 폴더로 추출되며 AppContext.BaseDirectory 가 그 폴더를 가리킨다. -->
    <IncludeNativeLibrariesForSelfExtract>true</IncludeNativeLibrariesForSelfExtract>
    <IncludeAllContentForSelfExtract>true</IncludeAllContentForSelfExtract>
    <EnableCompressionInSingleFile>false</EnableCompressionInSingleFile>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Web.WebView2" Version="1.0.3967.48" />
  </ItemGroup>

  <ItemGroup>
    <!-- xterm.js 번들을 실행 폴더로 복사 (WebView2 가상 호스트가 디스크에서 로드) -->
    <Content Include="Resources\Terminal\web\**">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
    <!-- 델타 업데이트 복원 도구 (single-file 에도 포함됨) -->
    <Content Include="Resources\Tools\zstd.exe">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
  </ItemGroup>

  <ItemGroup>
    <Resource Include="Fonts\Pretendard-Regular.ttf" />
    <Resource Include="Fonts\Pretendard-Medium.ttf" />
    <Resource Include="Fonts\Pretendard-SemiBold.ttf" />
    <Resource Include="Fonts\Pretendard-Bold.ttf" />
    <Resource Include="Fonts\BrunoAceSC-Regular.ttf" />
    <!-- Claude Code 아이콘 이미지 (탭 헤더·타이틀바, devez 이식) -->
    <Resource Include="Resources\Images\ShellPresets\claude_code.png" />
  </ItemGroup>

</Project>
