<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net9.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWPF>true</UseWPF>
    <RootNamespace>DevezCode</RootNamespace>
    <AssemblyName>DevezCode</AssemblyName>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <ApplicationIcon>Resources\Logos\app.ico</ApplicationIcon>
    <!-- devez 방식: 일반 빌드 산출물을 bin\Release(\rid) 가 아니라 bin\ 에 바로 떨군다.
         (publish 는 build_installer.ps1 의 -o 로 bin\win-x64\publish 로 따로 나간다) -->
    <OutputPath>bin\</OutputPath>
    <AppendTargetFrameworkToOutputPath>false</AppendTargetFrameworkToOutputPath>
    <AppendRuntimeIdentifierToOutputPath>false</AppendRuntimeIdentifierToOutputPath>
    <!-- 단일 버전 소스: UpdateService.CurrentVersion 이 이 값을 읽는다. 릴리스 때 여기만 올린다.
         (csproj <Version> → 어셈블리 버전 → FileVersion → version.json 이 자동 일치) -->
    <Version>1.19.1</Version>
    <!-- 아래 3개는 single-file publish 시에만 효력 — 일반 dotnet build 동작에는 영향 없음.
         네이티브 DLL(WebView2Loader)·Content(xterm.js 자산)·zstd.exe 를 단일 exe 에 포함 →
         자동 업데이트가 DevezCode.exe 하나만 교체해도 터미널/델타복원이 동작한다.
         실행 시 임시 폴더로 추출되며 AppContext.BaseDirectory 가 그 폴더를 가리킨다. -->
    <IncludeNativeLibrariesForSelfExtract>true</IncludeNativeLibrariesForSelfExtract>
    <IncludeAllContentForSelfExtract>true</IncludeAllContentForSelfExtract>
    <EnableCompressionInSingleFile>false</EnableCompressionInSingleFile>
  </PropertyGroup>

  <ItemGroup>
    <!-- 독립 추적 회귀 테스트 프로젝트의 소스는 WPF 앱 기본 Compile glob에서 제외. -->
    <Compile Remove="Tests\**\*.cs" />

    <PackageReference Include="AvalonEdit" Version="6.3.1.120" />
    <PackageReference Include="Microsoft.Data.Sqlite" Version="10.0.9" />
    <PackageReference Include="Microsoft.Web.WebView2" Version="1.0.3967.48" />
    <PackageReference Include="System.Diagnostics.PerformanceCounter" Version="9.0.4" />
  </ItemGroup>

  <ItemGroup>
    <!-- xterm.js 번들을 실행 폴더로 복사 (WebView2 가상 호스트가 디스크에서 로드) -->
    <Content Include="Resources\Terminal\web\**">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
    <!-- Toast UI 기반 마크다운 에디터 번들(WebView2 가상 호스트 로드) -->
    <Content Include="Resources\Markdown\web\**">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
    <!-- Monaco Editor 오프라인 번들(WebView2 가상 호스트 로드, diff 뷰) -->
    <Content Include="Resources\Monaco\web\**">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
    <!-- 델타 업데이트 복원 도구 (single-file 에도 포함됨) -->
    <Content Include="Resources\Tools\zstd.exe">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
    <!-- codex 훅 스크립트 (Resources\Hooks\codex-hook.ps1).
         Resources 패턴으로 실행 폴더에 복사되며, CodexHookInstaller 가 매 시작 시
         %LOCALAPPDATA%\DevezCode\codex\hook.ps1 로 재기록. -->
    <Content Include="Resources\Hooks\codex-hook.ps1">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
    <!-- codex 권한/도구 전이 전용 경량 훅. 매 툴마다 PowerShell을 띄우지 않고
         active turn이 일치할 때만 waiting 상태를 처리한다(busy는 사용자 턴 훅만 소유). -->
    <Content Include="Resources\Hooks\codex-state-hook.cmd">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
    <!-- grok 훅 스크립트. GrokHookInstaller 가 %LOCALAPPDATA%\DevezCode\grok\hook.ps1 로 재기록. -->
    <Content Include="Resources\Hooks\grok-hook.ps1">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
    <!-- grok tool 이벤트 전용 경량 훅. 완료 fence 안에서 waiting만 처리하며 busy를 재점화하지 않는다. -->
    <Content Include="Resources\Hooks\grok-state-hook.cmd">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
    <!-- antigravity(agy) 훅 배치. AntigravityHookInstaller 가 %LOCALAPPDATA%\DevezCode\antigravity\hook.cmd 로 재기록.
         (PowerShell 은 agy 훅 조기취소에 기동이 못 버텨 배치 사용 — AntigravityHookInstaller 주석 참고) -->
    <Content Include="Resources\Hooks\antigravity-hook.cmd">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
    <!-- kimi(Kimi Code CLI) 훅 스크립트. KimiHookInstaller 가 %LOCALAPPDATA%\DevezCode\kimi\hook.ps1 로 재기록.
         Kimi 훅 runner 는 spawn(shell:true)→cmd.exe 실행, stdin 으로 이벤트 JSON(hookEventName/sessionId/cwd) 전달. -->
    <Content Include="Resources\Hooks\kimi-hook.ps1">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
    <!-- kimi tool/permission 이벤트 전용 경량 훅(PowerShell 미기동). PreToolUse/PostToolUse=working, PermissionRequest/Result=waiting. -->
    <Content Include="Resources\Hooks\kimi-state-hook.cmd">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
    <!-- opencode 플러그인 (Resources\Plugins\opencode-room-tracker.js).
         OpenCodePluginInstaller 가 앱 시작과 OpenCode 세션 실행 직전에 전역 플러그인 경로로 멱등 복사. -->
    <Content Include="Resources\Plugins\opencode-room-tracker.js">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
    <!-- claude code 커스텀 statusline (Resources\StatusLine\statusline.js).
         UserStatusLineInstaller 가 매 시작 시 ~/.claude\statusline.js 로 복사 +
         ~/.claude\settings.json 의 statusLine 키를 자동 등록. 다른 PC 첫 실행 시 자동 설치. -->
    <Content Include="Resources\StatusLine\statusline.js">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
  </ItemGroup>

  <ItemGroup>
    <Resource Include="Fonts\Pretendard-Regular.ttf" />
    <Resource Include="Fonts\Pretendard-Medium.ttf" />
    <Resource Include="Fonts\Pretendard-SemiBold.ttf" />
    <Resource Include="Fonts\Pretendard-Bold.ttf" />
    <Resource Include="Fonts\BrunoAceSC-Regular.ttf" />
    <!-- 에이전트/공급자 브랜드 자산. MIT 적용 대상이 아니며 BRAND_ASSETS.md의 별도 고지를 따른다. -->
    <Resource Include="Resources\Images\ShellPresets\claude_code.png" />
    <!-- 에이전트 아이콘 (devez 이식) — 세션 행에 에이전트별 로고 표시 -->
    <Resource Include="Resources\Images\ShellPresets\codex.png" />
    <Resource Include="Resources\Images\ShellPresets\opencode_icon_black_50.png" />
    <Resource Include="Resources\Images\ShellPresets\opencode_icon_white_50.png" />
    <Resource Include="Resources\Images\ShellPresets\gajae_code.png" />
    <!-- grok(X logo): dark=white glyph, light=black glyph (opencode 와 동일 패턴) -->
    <Resource Include="Resources\Images\ShellPresets\grok_icon_black_50.png" />
    <Resource Include="Resources\Images\ShellPresets\grok_icon_white_50.png" />
    <Resource Include="Resources\Images\ShellPresets\deepseek.png" />
    <Resource Include="Resources\Images\ShellPresets\anti.png" />
    <!-- kimi(Kimi Code): dark=흰색 글리프, light=검정 글리프 (opencode/grok 와 동일 패턴) -->
    <Resource Include="Resources\Images\ShellPresets\kimi_icon_white_50.png" />
    <Resource Include="Resources\Images\ShellPresets\kimi_icon_black_50.png" />
    <!-- devezvibe(Devez Vibe, dvz): 채워진 컬러 로고라 테마 변형 없이 한 장으로 쓴다 -->
    <Resource Include="Resources\Images\ShellPresets\devezvibe_icon.png" />
    <!-- Visual Studio 2022 Image Library 파일 형식 아이콘.
         Microsoft Software License Terms 적용(MIT 아님) — 설정 > 라이선스에서 전문 제공. -->
    <Resource Include="Resources\Images\FileTypes\VisualStudio2022\*.png" />
    <Resource Include="Resources\Images\FileTypes\VisualStudio2022\Dark\*.png" />
    <!-- 2017 채움형 폴더 아이콘. 같은 공식 다운로드 페이지의 버전별 EULA 적용. -->
    <Resource Include="Resources\Images\FileTypes\VisualStudio2017\*.png" />
    <Resource Include="Resources\Images\FileTypes\VisualStudio2017\Dark\*.png" />
    <Resource Include="Resources\Licenses\VisualStudio2017ImageLibraryEULA.rtf" />
    <Resource Include="Resources\Licenses\VisualStudio2022ImageLibraryEULA.rtf" />
    <!-- 앱 로고 이미지 (좌상단 타이틀바, 데스크탑 image.png 기반) -->
    <Resource Include="Resources\Logos\logo.png" />
    <!-- 창 아이콘(Window.Icon pack URI). ApplicationIcon(EXE 아이콘)과 별개로
         WPF Resource 로도 포함해야 pack://.../app.ico 로딩이 가능하다. -->
    <Resource Include="Resources\Logos\app.ico" />
  </ItemGroup>

</Project>
