<Window x:Class="DevezCode.MainWindow"
        x:Name="ThisWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:views="clr-namespace:DevezCode.Views"
        xmlns:models="clr-namespace:DevezCode.Models"
        xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
        Title="DevezCode" Height="760" Width="1240"
        MinHeight="640" MinWidth="960"
        Icon="pack://application:,,,/Resources/Logos/app.ico"
        WindowStartupLocation="CenterScreen"
        WindowStyle="None" ResizeMode="CanResize"
        Background="{DynamicResource BgBrush}"
        FontFamily="{StaticResource PretendardFont}">

    <shell:WindowChrome.WindowChrome>
        <shell:WindowChrome CaptionHeight="32" ResizeBorderThickness="5"
                            CornerRadius="0" GlassFrameThickness="0,0,0,1" UseAeroCaptionButtons="False"/>
    </shell:WindowChrome.WindowChrome>

    <Border x:Name="RootChrome" Background="{DynamicResource BgBrush}" BorderBrush="{DynamicResource LineBrush}" BorderThickness="1">
        <Grid x:Name="RootGrid" Grid.IsSharedSizeScope="True">
            <Grid.RowDefinitions>
                <RowDefinition Height="32"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- ── 훅 연동 설정 배너 (없을 때만 표시) ───────────────────────
                 세션 요청중 스피너용 claude 훅이 미설치/구버전이면 상단에 원클릭 설정을 띄운다. -->
            <Border x:Name="HookSetupBanner" Grid.Row="1" Visibility="Collapsed"
                    Background="{DynamicResource PanelSoftBrush}"
                    BorderBrush="{DynamicResource LineBrush}" BorderThickness="0,0,0,1">
                <Grid Margin="14,8,8,8">
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center" HorizontalAlignment="Left">
                        <Path Style="{StaticResource LucideIcon}" Data="{StaticResource IconTriangleAlert}"
                              Width="15" Height="15" VerticalAlignment="Center"
                              Stroke="{DynamicResource PrimaryBrush}"/>
                        <TextBlock x:Name="HookBannerText" Margin="9,0,0,0" VerticalAlignment="Center"
                                   FontSize="{DynamicResource Fs12}" Foreground="{DynamicResource TextBrush}"
                                   Text="세션 상태(요청 중 스피너) 연동이 설정되지 않았습니다. 원클릭으로 설정할 수 있어요."/>
                    </StackPanel>
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                        <Button x:Name="HookSetupBtn" Click="HookSetupBtn_Click" Height="28" Padding="14,0" Cursor="Arrow"
                                Style="{StaticResource PrimaryButton}" FontSize="{DynamicResource Fs12}">
                            <TextBlock Text="설정" Foreground="White"/>
                        </Button>
                        <Button x:Name="HookBannerDismiss" Click="HookBannerDismiss_Click"
                                Width="30" Height="28" Margin="6,0,0,0" Cursor="Arrow"
                                Style="{StaticResource WinCtrlBtn}" ToolTip="닫기">
                            <Path Style="{StaticResource LucideIcon}" Data="{StaticResource IconX}"
                                  Width="12" Height="12" Stroke="{DynamicResource TextMutedBrush}"/>
                        </Button>
                    </StackPanel>
                </Grid>
            </Border>

            <!-- ── Title bar ───────────────────────────────────────────── -->
            <!-- 타이틀 바 컬럼은 메인 영역과 SharedSizeGroup 으로 묶여 스플리터 조절 시에도
                 중앙패널 시작 x 에 콤보박스/브렌치 버블이 고정. 앱 이름·윈도우 컨트롤은
                 별도 컨테이너(고정 위치) — 사이드바 폭에 따라 끌려가지 않음. -->
            <Grid Grid.Row="0" Background="{DynamicResource BgBrush}">
                <!-- 앱 이름(왼쪽 고정) -->
                <StackPanel x:Name="TitleLogoBlock" Orientation="Horizontal" VerticalAlignment="Center" Margin="6,0,0,0"
                            HorizontalAlignment="Left"
                            shell:WindowChrome.IsHitTestVisibleInChrome="True">
                    <TextBlock Text="DevezCode" FontSize="12" FontWeight="Bold"
                               FontFamily="{StaticResource BrunoAceSCFont}"
                               Foreground="{DynamicResource TextBrush}"
                               VerticalAlignment="Center" Margin="3,1,0,0"/>
                    <!-- 왼쪽 패널 접기/펼치기 — 타이틀 바로 옆에 배치(원위치) -->
                    <Button x:Name="LeftPanelBtn" Click="LeftPanelBtn_Click" Margin="8,0,0,0"
                            Style="{StaticResource TitleBarChipButton}" ToolTip="왼쪽 패널 접기/펼치기 (F1)">
                        <Path x:Name="LeftPanelIcon" Style="{StaticResource LucideIcon}"
                              Data="{StaticResource IconPanelLeft}" Width="16" Height="16"
                              Stroke="{DynamicResource TextMutedBrush}"/>
                    </Button>
                    <Border Width="1" Height="16" Margin="3,0,3,0" VerticalAlignment="Center"
                            Background="{DynamicResource LineBrush}" Opacity="0.5"/>
                    <Button x:Name="SplitToggleBtn" Click="SplitToggleBtn_Click" Margin="0,0,0,0"
                            Style="{StaticResource TitleBarChipButton}" ToolTip="패널 분할">
                        <Path x:Name="SplitToggleIcon" Style="{StaticResource LucideIcon}"
                              Data="{StaticResource IconPanelLeftOpen}" Width="16" Height="16"
                              Stroke="{DynamicResource TextMutedBrush}"/>
                    </Button>
                </StackPanel>

                <!-- 윈도우 컨트롤(오른쪽 고정) -->
                <StackPanel Orientation="Horizontal" Margin="0,0,4,0" HorizontalAlignment="Right"
                            shell:WindowChrome.IsHitTestVisibleInChrome="True">
                    <!-- 성능 모니터 칩(CPU/RAM) — 상단 타이틀바. -->
                    <StackPanel x:Name="PerfChipGroup" Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,0,0">
                        <Button x:Name="PerfChipBtn" Click="PerfChipBtn_Click" ToolTip="작업 관리자 열기"
                                shell:WindowChrome.IsHitTestVisibleInChrome="True"
                                Style="{StaticResource PerfChipButton}">
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <TextBlock Text="CPU  " FontSize="{DynamicResource PerfChipLblFs}"
                                           Foreground="{DynamicResource TextMutedBrush}" VerticalAlignment="Center"/>
                                <TextBlock x:Name="PerfCpuText" Text="--" TextAlignment="Left"
                                           FontSize="{DynamicResource PerfChipValFs}" VerticalAlignment="Center"
                                           Foreground="{DynamicResource TextBrush}"/>
                                <TextBlock Text="RAM  " Margin="14,0,0,0" FontSize="{DynamicResource PerfChipLblFs}"
                                           Foreground="{DynamicResource TextMutedBrush}" VerticalAlignment="Center"/>
                                <TextBlock x:Name="PerfRamText" Text="--" TextAlignment="Left"
                                           FontSize="{DynamicResource PerfChipValFs}" VerticalAlignment="Center"
                                           Foreground="{DynamicResource TextBrush}"/>
                            </StackPanel>
                        </Button>
                    </StackPanel>
                    <Border Width="1" Height="16" Margin="3,0,3,0" VerticalAlignment="Center"
                            Background="{DynamicResource LineBrush}" Opacity="0.5"/>

                    <!-- ── 우 패널 접기/펼치기 (좌측 패널 버튼은 타이틀 로고 블록으로 이동) ──── -->
                    <Button x:Name="RightPanelBtn" Click="RightPanelBtn_Click"
                            Style="{StaticResource TitleBarChipButton}" ToolTip="오른쪽 패널 접기/펼치기 (F2)">
                        <Path x:Name="RightPanelIcon" Style="{StaticResource LucideIcon}"
                              Data="{StaticResource IconPanelRight}" Width="16" Height="16"
                              Stroke="{DynamicResource TextMutedBrush}"/>
                    </Button>
                    <Border Width="1" Height="16" Margin="3,0,3,0" VerticalAlignment="Center"
                            Background="{DynamicResource LineBrush}" Opacity="0.5"/>

                    <!-- ── 세션 완료 기록 패널 접기/펼치기 (우측 패널 → 계정 사용량 순) ──── -->
                    <Button x:Name="SessionHistoryPanelBtn" Click="SessionHistoryPanelBtn_Click"
                            Style="{StaticResource TitleBarChipButton}" ToolTip="세션 완료 기록 패널 접기/펼치기 (F3)">
                        <Path x:Name="SessionHistoryPanelIcon" Style="{StaticResource LucideIcon}"
                              Data="{StaticResource IconClock}" Width="16" Height="16"
                              Stroke="{DynamicResource TextMutedBrush}"/>
                    </Button>
                    <Button x:Name="UsagePanelBtn" Click="UsagePanelBtn_Click" Margin="2,0,0,0"
                            Style="{StaticResource TitleBarChipButton}" ToolTip="계정 사용량 패널 접기/펼치기 (F4)">
                        <Path x:Name="UsagePanelIcon" Style="{StaticResource LucideIcon}"
                              Data="{StaticResource IconChartBar}" Width="16" Height="16"
                              Stroke="{DynamicResource TextMutedBrush}"/>
                    </Button>
                    <Border Width="1" Height="16" Margin="3,0,3,0" VerticalAlignment="Center"
                            Background="{DynamicResource LineBrush}" Opacity="0.5"/>

                    <Button Style="{StaticResource WinCtrlBtn}" Click="MinBtn_Click">
                        <TextBlock Text="&#x2013;" FontSize="{DynamicResource Fs14}"/>
                    </Button>
                    <Button Style="{StaticResource WinCtrlBtn}" Click="MaxBtn_Click">
                        <TextBlock Text="&#x25A1;" FontSize="{DynamicResource Fs12}"/>
                    </Button>
                    <Button Style="{StaticResource WinCloseBtn}" Click="CloseBtn_Click">
                        <TextBlock Text="&#x2715;" FontSize="{DynamicResource Fs11}"/>
                    </Button>
                </StackPanel>
            </Grid>

            <!-- 상단바 ↔ 콘텐츠 가로 구분선 (devez 방식, 전체폭 1px) -->
            <Border Grid.Row="2" VerticalAlignment="Top" Height="1"
                    Background="{DynamicResource LineBrush}" Panel.ZIndex="100"/>

            <!-- ── 3-pane body ─────────────────────────────────────────── -->
            <Grid Grid.Row="2" x:Name="BodyGrid" SizeChanged="BodyGrid_SizeChanged">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition x:Name="SidebarCol" Width="262" MinWidth="190" SharedSizeGroup="MainSidebar"/>
                    <ColumnDefinition x:Name="SidebarSplitterCol" Width="4" SharedSizeGroup="MainSidebarSplitter"/>
                    <ColumnDefinition x:Name="CenterCol" Width="*" MinWidth="360"/>
                    <ColumnDefinition x:Name="FileExpSplitterCol" Width="4" SharedSizeGroup="MainFileExpSplitter"/>
                    <ColumnDefinition x:Name="FileExpCol" Width="300" MinWidth="0" SharedSizeGroup="MainFileExp"/>
                    <!-- 세션 완료 기록 사이드바 스플리터 / 사이드바 / 계정 사용량 ── col5=splitter, col6=기록, col7=사용량 -->
                    <ColumnDefinition x:Name="SessionHistorySplitterCol" Width="4" MinWidth="0"/>
                    <ColumnDefinition x:Name="SessionHistoryCol" Width="0" MinWidth="150"/>
                    <ColumnDefinition x:Name="UsageCol" Width="0" MinWidth="0"/>
                </Grid.ColumnDefinitions>

                <!-- 패널 경계(devez 방식): 좌·우 패널이 각자 1px LineBrush 보더를 그리고,
                     그 사이 4px 컬럼이 BgBrush 간격(채널)으로 유지된다. 스플리터는 그 위
                     투명 오버레이 — 평소엔 안 보이고 호버 시에만 PrimaryBrush 핸들이 뜬다. -->

                <!-- Left: sidebar -->
                <views:SidebarView x:Name="Sidebar" Grid.Column="0"
                                   BorderBrush="{DynamicResource LineBrush}" BorderThickness="0,0,1,0"/>
                <GridSplitter Grid.Column="1" HorizontalAlignment="Stretch"
                              ResizeDirection="Columns" ResizeBehavior="PreviousAndNext"
                              DragDelta="SidebarSplitter_DragDelta"
                              DragCompleted="SidebarSplitter_DragCompleted"/>

                <!-- Center: 워크스페이스 패널 A | (분할 시) 스플리터 + 패널 B -->
                <Grid Grid.Column="2" x:Name="CenterSplit">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition x:Name="PaneACol" Width="*"/>
                        <ColumnDefinition x:Name="PaneSplitterCol" Width="0"/>
                        <ColumnDefinition x:Name="PaneBCol" Width="0"/>
                    </Grid.ColumnDefinitions>
                    <views:WorkspacePaneView x:Name="PaneA" Grid.Column="0"/>
                    <GridSplitter x:Name="PaneSplitter" Grid.Column="1" Width="4"
                                  HorizontalAlignment="Stretch" Visibility="Collapsed"
                                  ResizeDirection="Columns" ResizeBehavior="PreviousAndNext"
                                  DragDelta="PaneSplitter_DragDelta"
                                  DragCompleted="PaneSplitter_DragCompleted"/>
                    <views:WorkspacePaneView x:Name="PaneB" Grid.Column="2" Visibility="Collapsed"/>
                </Grid>

                <GridSplitter x:Name="FileExpSplitter" Grid.Column="3" HorizontalAlignment="Stretch"
                              ResizeDirection="Columns" ResizeBehavior="PreviousAndNext"
                              DragDelta="FileExpSplitter_DragDelta"
                              DragCompleted="FileExpSplitter_DragCompleted"/>

                <!-- Right: file explorer (좌측 보더로 채널 형성).
                     좁은 창에서는 RightOverlayHost 로 재부모화되어 오버레이 드로어로 뜬다. -->
                <views:FileExplorerView x:Name="FileExplorer" Grid.Column="4"
                                        BorderBrush="{DynamicResource LineBrush}" BorderThickness="1,0,0,0"/>

                <!-- 세션 완료 기록 스플리터 (파일탐색기와 세션기록 사이) -->
                <GridSplitter x:Name="SessionHistorySplitter" Grid.Column="5" HorizontalAlignment="Stretch"
                              ResizeDirection="Columns" ResizeBehavior="PreviousAndNext"
                              DragStarted="SessionHistorySplitter_DragStarted"
                              DragDelta="SessionHistorySplitter_DragDelta"
                              DragCompleted="SessionHistorySplitter_DragCompleted"/>

                <!-- ── 안쪽(col6): 세션 완료 기록 사이드바 ──────────────────
                     계정 사용량보다 중앙에 가까이 위치. -->
                <Border Grid.Column="6" x:Name="SessionHistorySidebar" ClipToBounds="True"
                        Background="{DynamicResource PanelBrush}"
                        BorderBrush="{DynamicResource LineBrush}" BorderThickness="1,0,0,0">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="37"/>
                            <!-- 응답 대기 줄이 생기면 자동으로 높이가 늘어나도록 Auto (단일 줄이면 MinHeight 35 유지). -->
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>
                        <Border Grid.Row="0" BorderBrush="{DynamicResource LineBrush}" BorderThickness="0,0,0,1">
                            <Grid Margin="9,0,12,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="세션 완료 기록" VerticalAlignment="Center"
                                           FontSize="{DynamicResource Fs12}" FontWeight="SemiBold"
                                           Foreground="{DynamicResource TextBrush}"/>
                                <StackPanel Grid.Column="1" Orientation="Horizontal">
                                     <Button x:Name="TogglePromptBtn" Click="TogglePromptBtn_Click"
                                         Width="22" Height="22">
                                    <Button.Style>
                                        <Style TargetType="Button" BasedOn="{StaticResource IconButton}">
                                            <Setter Property="ToolTip" Value="프롬프트 전체보기"/>
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding ShowFullPrompt, RelativeSource={RelativeSource AncestorType=Window}}" Value="True">
                                                    <Setter Property="ToolTip" Value="한줄만 보기"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Button.Style>
                                    <Grid>
                                    <Path Data="{StaticResource IconChevronDown}" Width="12" Height="12">
                                             <Path.Style>
                                                 <Style TargetType="Path" BasedOn="{StaticResource LucideButtonIcon}">
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding ShowFullPrompt, RelativeSource={RelativeSource AncestorType=Window}}" Value="True">
                                                            <Setter Property="Visibility" Value="Collapsed"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                            </Path.Style>
                                        </Path>
                                     <Path Data="{StaticResource IconChevronUp}" Width="12" Height="12">
                                             <Path.Style>
                                                 <Style TargetType="Path" BasedOn="{StaticResource LucideButtonIcon}">
                                                     <Setter Property="Visibility" Value="Collapsed"/>
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding ShowFullPrompt, RelativeSource={RelativeSource AncestorType=Window}}" Value="True">
                                                            <Setter Property="Visibility" Value="Visible"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                            </Path.Style>
                                        </Path>
                                    </Grid>
                                </Button>
                                    <Button x:Name="MarkAllReadBtn" Click="MarkAllReadBtn_Click"
                                        Width="22" Height="22"
                                        Style="{StaticResource IconButton}"
                                            ToolTip="모두 확인">
                                    <Path Style="{StaticResource LucideButtonIcon}"
                                              Data="{StaticResource IconCheckCheck}" Width="12" Height="12"/>
                                </Button>
                                    <Button x:Name="ClearHistoryBtn" Click="ClearHistoryBtn_Click"
                                        Width="22" Height="22"
                                        Style="{StaticResource IconButton}"
                                        ToolTip="모든 기록 지우기">
                                    <Path Style="{StaticResource LucideButtonIcon}"
                                          Data="{StaticResource IconBrushCleaning}" Width="12" Height="12"/>
                                </Button>
                                </StackPanel>
                            </Grid>
                        </Border>
                        <!-- 세션 타이틀 영역과 동일 사이즈 패널 -->
                        <Border Grid.Row="1" MinHeight="35"
                                BorderBrush="{DynamicResource LineBrush}" BorderThickness="0,0,0,1">
                            <StackPanel VerticalAlignment="Center" Margin="9,6,12,6">
                                <!-- 진행중 줄: 스피너 + 텍스트 -->
                                <StackPanel x:Name="SessionBusyRow" Orientation="Horizontal">
                                    <Ellipse x:Name="SessionBusySpinner" Width="12" Height="12"
                                             VerticalAlignment="Center" Margin="0,0,7,0" Visibility="Collapsed"
                                             Stroke="{DynamicResource PrimaryBrush}" StrokeThickness="1.6"
                                             StrokeDashArray="15 100" StrokeDashCap="Round"
                                             RenderTransformOrigin="0.5,0.5">
                                        <Ellipse.RenderTransform>
                                            <RotateTransform Angle="{Binding Angle, Source={x:Static models:SpinnerSync.Instance}}"/>
                                        </Ellipse.RenderTransform>
                                    </Ellipse>
                                    <TextBlock x:Name="SessionBusyLabel" Text="진행중인 세션 없음." VerticalAlignment="Center"
                                               FontSize="{DynamicResource Fs12}" Foreground="{DynamicResource TextMutedBrush}"/>
                                </StackPanel>
                                <!-- 응답 대기 줄: 느낌표 + 텍스트. 대기 세션이 있을 때만 노출 → 이때만 높이가 늘어난다. -->
                                <StackPanel x:Name="SessionWaitingRow" Orientation="Horizontal"
                                            Visibility="Collapsed" Margin="0,4,0,0">
                                    <Path Width="12" Height="12" VerticalAlignment="Center" Margin="0,0,7,0"
                                          Data="{StaticResource IconExclamation}" Stretch="Uniform"
                                          Stroke="{DynamicResource WarningBrush}" StrokeThickness="2.2"
                                          StrokeStartLineCap="Round" StrokeEndLineCap="Round" Fill="Transparent"/>
                                    <TextBlock x:Name="SessionWaitingLabel" VerticalAlignment="Center"
                                               FontSize="{DynamicResource Fs12}" Foreground="{DynamicResource WarningBrush}"/>
                                </StackPanel>
                            </StackPanel>
                        </Border>
                        <ScrollViewer x:Name="SessionHistoryScrollViewer" Grid.Row="2" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"
                                      ScrollChanged="SessionHistoryScrollChanged"
                                      Padding="8,8,8,8">
                            <StackPanel>
                                <!-- ── 응답 대기(선택지) 세션 카드 — 항상 완료기록 위. 내용은 내가 보낸 프롬프트(LastMessage). ── -->
                                <ItemsControl x:Name="WaitingList" Visibility="Collapsed">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate DataType="{x:Type models:SessionItem}">
                                            <Grid Margin="0,3,0,3">
                                                <Border x:Name="WaitingCardBd" CornerRadius="10" Padding="12,11,12,9"
                                                        Cursor="Arrow" MouseLeftButtonUp="WaitingCard_Click"
                                                        BorderBrush="{DynamicResource LineBrush}" BorderThickness="1">
                                                    <Border.Style>
                                                        <Style TargetType="Border">
                                                            <Setter Property="Background" Value="Transparent"/>
                                                            <Style.Triggers>
                                                                <Trigger Property="IsMouseOver" Value="True">
                                                                    <Setter Property="Background" Value="{DynamicResource HoverBrush}"/>
                                                                </Trigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </Border.Style>
                                                    <Grid>
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="Auto"/>
                                                            <ColumnDefinition Width="*"/>
                                                            <ColumnDefinition Width="Auto"/>
                                                        </Grid.ColumnDefinitions>
                                                        <Grid.RowDefinitions>
                                                            <RowDefinition Height="Auto"/>
                                                            <RowDefinition Height="Auto"/>
                                                        </Grid.RowDefinitions>
                                                        <Image Grid.Row="0" Grid.Column="0" Width="15" Height="15"
                                                               Margin="0,0,9,0" VerticalAlignment="Center"
                                                               Source="{Binding AgentId, Converter={x:Static models:AgentImageConverter.Instance}}"
                                                               RenderOptions.BitmapScalingMode="HighQuality"/>
                                                        <TextBlock Grid.Row="0" Grid.Column="1" Text="{Binding Name}"
                                                                   VerticalAlignment="Center" TextTrimming="CharacterEllipsis"
                                                                   FontSize="{DynamicResource Fs13}" FontWeight="SemiBold"
                                                                   Foreground="{DynamicResource TextBrush}"/>
                                                        <!-- 완료카드의 시간 위치에 노란색 '대기' 표시. 위로 3px 올림. -->
                                                        <TextBlock Grid.Row="0" Grid.Column="2" Text="대기" Margin="8,0,0,0"
                                                                   VerticalAlignment="Center"
                                                                   FontSize="{DynamicResource Fs10}" FontWeight="SemiBold"
                                                                   Foreground="{DynamicResource WarningBrush}">
                                                            <TextBlock.RenderTransform>
                                                                <TranslateTransform Y="-3"/>
                                                            </TextBlock.RenderTransform>
                                                        </TextBlock>
                                                        <TextBlock Grid.Row="1" Grid.Column="0" Grid.ColumnSpan="3"
                                                                   Text="{Binding LastMessage}" Margin="0,5,0,0"
                                                                   FontSize="{DynamicResource Fs12}"
                                                                   Foreground="{DynamicResource TextMutedBrush}">
                                                            <TextBlock.Style>
                                                                <Style TargetType="TextBlock">
                                                                    <Setter Property="TextWrapping" Value="NoWrap"/>
                                                                    <Setter Property="TextTrimming" Value="CharacterEllipsis"/>
                                                                    <Style.Triggers>
                                                                        <DataTrigger Binding="{Binding ShowFullPrompt, ElementName=ThisWindow}" Value="True">
                                                                            <Setter Property="TextWrapping" Value="Wrap"/>
                                                                            <Setter Property="TextTrimming" Value="None"/>
                                                                        </DataTrigger>
                                                                    </Style.Triggers>
                                                                </Style>
                                                            </TextBlock.Style>
                                                        </TextBlock>
                                                    </Grid>
                                                </Border>
                                                <!-- 토스트 스택 좌측 액센트(warning) — 대기 카드 표식.
                                                     완료기록과 동일하게 카드 라운드(10)의 '좌측만 두꺼운' 보더로 모서리를 따라 가늘어지게. -->
                                                <Border IsHitTestVisible="False" CornerRadius="10"
                                                        BorderThickness="2.5,0,0,0" BorderBrush="{DynamicResource WarningBrush}"/>
                                            </Grid>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>

                                <!-- 세퍼레이터: 대기 카드와 완료기록 구분(둘 다 있을 때만) -->
                                <Border x:Name="WaitingSeparator" Visibility="Collapsed" Height="1"
                                        Margin="2,7,2,9" Background="{DynamicResource LineBrush}"/>

                                <ItemsControl x:Name="SessionHistoryList">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate DataType="{x:Type models:SessionCompletionRecord}">
                                            <Grid Margin="0,3,0,3">
                                            <Border x:Name="SessionHistoryCard" CornerRadius="10" Padding="12,11,12,9"
                                                    Cursor="Arrow" MouseLeftButtonUp="SessionHistoryItem_Click"
                                                    BorderBrush="{DynamicResource LineBrush}" BorderThickness="1">
                                                <Border.Style>
                                                    <Style TargetType="Border">
                                                        <Setter Property="Background" Value="Transparent"/>
                                                        <Style.Triggers>
                                                            <Trigger Property="IsMouseOver" Value="True">
                                                                <Setter Property="Background" Value="{DynamicResource HoverBrush}"/>
                                                            </Trigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </Border.Style>
                                                <Grid>
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="Auto"/>
                                                        <ColumnDefinition Width="*"/>
                                                        <ColumnDefinition Width="Auto"/>
                                                    </Grid.ColumnDefinitions>
                                                    <Grid.RowDefinitions>
                                                        <RowDefinition Height="Auto"/>
                                                        <RowDefinition Height="Auto"/>
                                                        <RowDefinition Height="Auto"/>
                                                    </Grid.RowDefinitions>
                                                    <Image Grid.Row="0" Grid.Column="0" Width="15" Height="15"
                                                           Margin="0,0,9,0" VerticalAlignment="Top"
                                                           Source="{Binding AgentId, Converter={x:Static models:AgentImageConverter.Instance}}"
                                                           RenderOptions.BitmapScalingMode="HighQuality">
                                                        <Image.RenderTransform>
                                                            <!-- 텍스트는 Y=-2 유지, 아이콘만 글꼴 크기별 보정(작게 -2 / 크게 0). -->
                                                            <TranslateTransform Y="{DynamicResource HistoryIconY}"/>
                                                        </Image.RenderTransform>
                                                    </Image>
                                                    <StackPanel Grid.Row="0" Grid.Column="1" Orientation="Horizontal">
                                                        <TextBlock Text="{Binding ProjectName}"
                                                                   Visibility="{Binding ProjectVisibility}"
                                                                   VerticalAlignment="Center" TextTrimming="CharacterEllipsis"
                                                                   FontSize="{DynamicResource Fs13}" FontWeight="SemiBold"
                                                                   Foreground="{DynamicResource TextBrush}">
                                                            <TextBlock.RenderTransform>
                                                                <TranslateTransform Y="-2"/>
                                                            </TextBlock.RenderTransform>
                                                        </TextBlock>
                                                    </StackPanel>
                                                    <!-- 시간 + 카드 제거(x) 버튼. 위로 3px 올림(TranslateTransform). -->
                                                    <StackPanel Grid.Row="0" Grid.Column="2" Orientation="Horizontal"
                                                                Margin="8,0,0,0" VerticalAlignment="Center">
                                                        <StackPanel.RenderTransform>
                                                            <TranslateTransform Y="-2"/>
                                                        </StackPanel.RenderTransform>
                                                        <TextBlock Text="{Binding TimeText}" VerticalAlignment="Center"
                                                                   FontSize="{DynamicResource Fs10}"
                                                                   Foreground="{DynamicResource TextMutedBrush}"/>
                                                        <Button Width="16" Height="16" Margin="6,0,-2,0" VerticalAlignment="Center"
                                                                Click="HistoryDelete_Click" Cursor="Arrow"
                                                                Background="Transparent" BorderThickness="0"
                                                                FocusVisualStyle="{x:Null}" ToolTip="기록 제거">
                                                            <Button.Template>
                                                                <ControlTemplate TargetType="Button">
                                                                    <Border x:Name="Bd" Background="Transparent" CornerRadius="4">
                                                                        <Path Width="8" Height="8" Stretch="Uniform" StrokeThickness="1.4"
                                                                              StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                                                                              Stroke="{DynamicResource TextMutedBrush}"
                                                                              Data="M18 6 6 18 M6 6 l12 12"/>
                                                                    </Border>
                                                                    <ControlTemplate.Triggers>
                                                                        <Trigger Property="IsMouseOver" Value="True">
                                                                            <Setter TargetName="Bd" Property="Background" Value="{DynamicResource PanelSoftBrush}"/>
                                                                        </Trigger>
                                                                    </ControlTemplate.Triggers>
                                                                </ControlTemplate>
                                                            </Button.Template>
                                                        </Button>
                                                    </StackPanel>
                                                    <TextBlock Grid.Row="1" Grid.Column="0" Grid.ColumnSpan="3"
                                                               Text="{Binding SessionName}" Margin="0,5,0,0"
                                                               TextTrimming="CharacterEllipsis"
                                                               FontSize="{DynamicResource Fs13}"
                                                               Foreground="{DynamicResource TextBrush}"/>
                                                    <TextBlock Grid.Row="2" Grid.Column="0" Grid.ColumnSpan="3"
                                                               Text="{Binding LastMessage}" Visibility="{Binding LastMessageVisibility}"
                                                               Margin="0,4,0,0"
                                                               FontSize="{DynamicResource Fs12}"
                                                               Foreground="{DynamicResource TextMutedBrush}">
                                                        <TextBlock.Style>
                                                            <Style TargetType="TextBlock">
                                                                <Setter Property="TextWrapping" Value="NoWrap"/>
                                                                <Setter Property="TextTrimming" Value="CharacterEllipsis"/>
                                                                <Style.Triggers>
                                                                    <DataTrigger Binding="{Binding ShowFullPrompt, ElementName=ThisWindow}" Value="True">
                                                                        <Setter Property="TextWrapping" Value="Wrap"/>
                                                                        <Setter Property="TextTrimming" Value="None"/>
                                                                    </DataTrigger>
                                                                </Style.Triggers>
                                                            </Style>
                                                        </TextBlock.Style>
                                                    </TextBlock>
                                                </Grid>
                                            </Border>
                                                <!-- 토스트 스택 좌측 액센트: 카드와 동일한 라운드(10)의 '좌측만 두꺼운' 보더로 그려
                                                     모서리를 따라 자연스럽게 가늘어지게 한다(오른쪽 세로선이 뚝 떨어지지 않음). -->
                                                <Border IsHitTestVisible="False" CornerRadius="10"
                                                        BorderThickness="2.5,0,0,0" BorderBrush="{DynamicResource PrimaryBrush}"
                                                        Visibility="{Binding IsRead, Converter={x:Static models:BoolToVisibilityConverter.Instance}, ConverterParameter=invert}"/>
                                            </Grid>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>

                                <TextBlock x:Name="SessionHistoryEmpty"
                                           Text="완료된 세션 기록이 없습니다."
                                           Margin="2,4,2,2" TextWrapping="Wrap" LineHeight="18"
                                           FontSize="{DynamicResource Fs12}"
                                           Foreground="{DynamicResource TextMutedBrush}"/>
                            </StackPanel>
                        </ScrollViewer>
                        <Rectangle x:Name="SessionHistoryFadeTop" Grid.Row="2" Height="24" VerticalAlignment="Top" IsHitTestVisible="False" Panel.ZIndex="1"
                                   Fill="{DynamicResource PanelBrush}">
                            <Rectangle.OpacityMask>
                                <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                                    <GradientStop Offset="0" Color="Black"/>
                                    <GradientStop Offset="0.7" Color="Transparent"/>
                                </LinearGradientBrush>
                            </Rectangle.OpacityMask>
                        </Rectangle>
                        <Rectangle x:Name="SessionHistoryFadeBottom" Grid.Row="2" Height="24" VerticalAlignment="Bottom" IsHitTestVisible="False" Panel.ZIndex="1"
                                   Fill="{DynamicResource PanelBrush}">
                            <Rectangle.OpacityMask>
                                <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                                    <GradientStop Offset="0" Color="Transparent"/>
                                    <GradientStop Offset="0.7" Color="Black"/>
                                </LinearGradientBrush>
                            </Rectangle.OpacityMask>
                        </Rectangle>
                    </Grid>
                </Border>

                <!-- ── 최우측(col6): 계정 사용량 전용 사이드바 ─────────────
                     기존 UI 그대로. 세션 완료 기록보다 바깥쪽에 위치. -->
                <Border Grid.Column="7" x:Name="UsageSidebar" ClipToBounds="True"
                        Background="{DynamicResource PanelBrush}"
                        BorderBrush="{DynamicResource LineBrush}" BorderThickness="1,0,0,0">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="37"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>
                        <Border Grid.Row="0" BorderBrush="{DynamicResource LineBrush}" BorderThickness="0,0,0,1">
                            <StackPanel Orientation="Horizontal" Margin="9,0,12,0" VerticalAlignment="Center">
                                <TextBlock Text="계정 사용량" VerticalAlignment="Center"
                                           FontSize="{DynamicResource Fs12}" FontWeight="SemiBold"
                                           Foreground="{DynamicResource TextBrush}"/>
                                <TextBlock x:Name="SidebarUsageUpdated" Margin="10,0,0,0" VerticalAlignment="Center"
                                           FontSize="{DynamicResource Fs11}" Foreground="{DynamicResource TextMutedBrush}"/>
                            </StackPanel>
                        </Border>
                        <StackPanel x:Name="UsageUpdateProgress" Grid.Row="1" Visibility="Collapsed" Margin="16,12,16,0">
                            <TextBlock x:Name="UsageUpdateText" FontSize="{DynamicResource Fs12}"
                                       Foreground="{DynamicResource TextBrush}" Margin="0,0,0,6"/>
                            <Border x:Name="UsageUpdateTrack" Height="6" CornerRadius="3" Background="{DynamicResource LineBrush}">
                                <Border x:Name="UsageUpdateBar" Width="0" HorizontalAlignment="Left" CornerRadius="3"
                                        Background="{DynamicResource PrimaryBrush}"/>
                            </Border>
                        </StackPanel>
                        <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                            <StackPanel Margin="16,14,16,14" MinWidth="218">
                                <ItemsControl x:Name="SidebarUsageList" AlternationCount="99">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate DataType="{x:Type models:UsageCardVM}">
                                            <Border Margin="0" Background="Transparent"
                                                    BorderBrush="{DynamicResource LineBrush}">
                                                <Border.Style>
                                                    <Style TargetType="Border">
                                                        <Setter Property="BorderThickness" Value="0,1,0,0"/>
                                                        <Setter Property="Padding" Value="0,14,0,14"/>
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding (ItemsControl.AlternationIndex), RelativeSource={RelativeSource AncestorType=ContentPresenter}}" Value="0">
                                                                <Setter Property="BorderThickness" Value="0"/>
                                                                <Setter Property="Padding" Value="0,0,0,14"/>
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </Border.Style>
                                                <StackPanel>
                                                    <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
                                                        <Image Source="{Binding IconPath}" Width="15" Height="15"
                                                               VerticalAlignment="Center"
                                                               RenderOptions.BitmapScalingMode="HighQuality"/>
                                                        <TextBlock Text="{Binding Name}" Margin="8,0,0,0" VerticalAlignment="Center"
                                                                   FontSize="{DynamicResource Fs12}" FontWeight="SemiBold"
                                                                   Foreground="{DynamicResource TextBrush}"/>
                                                        <TextBlock Text="{Binding Plan}" Visibility="{Binding PlanVisibility}"
                                                                   Margin="8,0,0,0" VerticalAlignment="Center"
                                                                   FontSize="{DynamicResource Fs11}"
                                                                   Foreground="{DynamicResource TextMutedBrush}"/>
                                                    </StackPanel>
                                                    <ItemsControl ItemsSource="{Binding Rows}">
                                                        <ItemsControl.ItemTemplate>
                                                            <DataTemplate DataType="{x:Type models:UsageRowVM}">
                                                                <Grid Margin="0,0,0,8">
                                                                    <Grid.RowDefinitions>
                                                                        <RowDefinition Height="Auto"/>
                                                                        <RowDefinition Height="Auto"/>
                                                                    </Grid.RowDefinitions>
                                                                    <Grid.ColumnDefinitions>
                                                                        <ColumnDefinition Width="34"/>
                                                                        <ColumnDefinition Width="Auto"/>
                                                                        <ColumnDefinition Width="Auto"/>
                                                                    </Grid.ColumnDefinitions>
                                                                    <TextBlock Grid.Row="0" Grid.Column="0" Text="{Binding Label}"
                                                                               VerticalAlignment="Center"
                                                                               FontSize="{DynamicResource Fs11}"
                                                                               Foreground="{DynamicResource TextMutedBrush}"/>
                                                                    <Border Grid.Row="0" Grid.Column="1" Width="102" Height="6"
                                                                            Margin="6,0,0,0" CornerRadius="3"
                                                                            Background="{DynamicResource LineBrush}"
                                                                            Visibility="{Binding BarVisibility}"
                                                                            VerticalAlignment="Center">
                                                                        <Border Width="{Binding BarWidth}" HorizontalAlignment="Left"
                                                                                CornerRadius="3" Background="{Binding BarBrush}"/>
                                                                    </Border>
                                                                    <TextBlock Grid.Row="0" Grid.Column="2" Text="{Binding PercentText}"
                                                                               Margin="{Binding PercentMargin}" VerticalAlignment="Center"
                                                                               FontSize="{DynamicResource Fs12}" FontWeight="SemiBold"
                                                                               Foreground="{DynamicResource TextBrush}"/>
                                                                    <TextBlock Grid.Row="1" Grid.Column="1" Grid.ColumnSpan="2"
                                                                               Text="{Binding ResetText}" Visibility="{Binding ResetVisibility}"
                                                                               Margin="6,3,0,0"
                                                                               FontSize="{DynamicResource Fs11}"
                                                                               Foreground="{DynamicResource TextMutedBrush}"/>
                                                                </Grid>
                                                            </DataTemplate>
                                                        </ItemsControl.ItemTemplate>

                                                    </ItemsControl>
                                                    <!-- ── 초기화권 (codex 전용) ── -->
                                                    <StackPanel Visibility="{Binding ResetCreditsVisibility}" Margin="0,8,0,0">
                                                        <TextBlock Text="{Binding ResetHeaderText}" 
                                                                   FontSize="{DynamicResource Fs11}" FontWeight="SemiBold"
                                                                   Foreground="{DynamicResource TextMutedBrush}" Margin="0,0,0,6"/>
                                                        <ItemsControl ItemsSource="{Binding ResetCredits}">
                                                            <ItemsControl.ItemTemplate>
                                                                <DataTemplate DataType="{x:Type models:ResetCreditRowVM}">
                                                                    <Grid Margin="0,0,0,3">
                                                                        <Grid.ColumnDefinitions>
                                                                            <ColumnDefinition Width="Auto"/>
                                                                            <ColumnDefinition Width="Auto"/>
                                                                        </Grid.ColumnDefinitions>
                                                                        <TextBlock Text="{Binding ExpiryText}"
                                                                                   FontSize="{DynamicResource Fs11}"
                                                                                   Foreground="{DynamicResource TextMutedBrush}"/>
                                                                        <TextBlock Grid.Column="1" Text="{Binding DaysLeftText}"
                                                                                   Margin="8,0,0,0"
                                                                                   FontSize="{DynamicResource Fs11}" FontWeight="SemiBold">
                                                                            <TextBlock.Style>
                                                                                <Style TargetType="TextBlock">
                                                                                    <Setter Property="Foreground" Value="{DynamicResource TextBrush}"/>
                                                                                    <Style.Triggers>
                                                                                        <DataTrigger Binding="{Binding IsExpiringSoon}" Value="True">
                                                                                            <Setter Property="Foreground" Value="{DynamicResource DangerBrush}"/>
                                                                                        </DataTrigger>
                                                                                    </Style.Triggers>
                                                                                </Style>
                                                                            </TextBlock.Style>
                                                                        </TextBlock>
                                                                    </Grid>
                                                                </DataTemplate>
                                                            </ItemsControl.ItemTemplate>
                                                        </ItemsControl>
                                                    </StackPanel>
                                                </StackPanel>
                                            </Border>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                                <TextBlock x:Name="SidebarUsageEmpty" Visibility="Collapsed"
                                           Text="표시할 사용량 정보가 없습니다.&#10;계정에 연결되면 여기에 표시됩니다."
                                           Margin="0,4,0,2" TextWrapping="Wrap" LineHeight="18"
                                           FontSize="{DynamicResource Fs12}"
                                           Foreground="{DynamicResource TextMutedBrush}"/>
                            </StackPanel>
                        </ScrollViewer>
                    </Grid>
                </Border>
            </Grid>
            <!-- ── Status bar (헤더와 동일 높이 32, 우측 설정 버튼) ────────────
                 좌측은 사이드바 SharedSizeGroup 에 묶지 않고 Auto 폭 — 사이드바 접힘/폭 변경과
                 무관하게 CPU/RAM + 클로드 사용량이 항상 같은 자리에 고정. -->
            <Border Grid.Row="3" Height="32" Background="{DynamicResource BgBrush}"
                    BorderBrush="{DynamicResource LineBrush}" BorderThickness="0,1,0,0">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition x:Name="FooterSidebarCol" Width="Auto" MinWidth="190"/>
                        <ColumnDefinition Width="*"/>
                    <ColumnDefinition x:Name="FooterFileExpSplitterCol" Width="4" SharedSizeGroup="MainFileExpSplitter"/>
                    <ColumnDefinition x:Name="FooterFileExpCol" Width="300" SharedSizeGroup="MainFileExp" MinWidth="0"/>
                    <!-- 우측 패널 접힘과 무관하게 항상 보이는 설정 버튼용 고정폭 컬럼 -->
                    <ColumnDefinition x:Name="FooterActionsCol" Width="Auto" MinWidth="48"/>
                </Grid.ColumnDefinitions>
                    <!-- 좌측: 계정 사용량 (설정 > '하단 푸터 표시' 토글로 provider별 on/off). 우측 사이드바와 별개. -->
                    <StackPanel Grid.Column="0" Grid.ColumnSpan="4" Orientation="Horizontal" Margin="14,0" VerticalAlignment="Center">
                        <!-- 계정 사용량: provider(Claude/Codex/Go)별 [구분선][아이콘][이름][5h바][주바]. -->
                        <!-- Claude (클릭 시 OAuth 로그인) -->
                        <StackPanel x:Name="RateLimitPanel" Orientation="Horizontal" VerticalAlignment="Center"
                                    Visibility="Collapsed" Background="Transparent" Cursor="Arrow"
                                    ToolTip="Claude 계정 사용량 (5시간 / 주간 한도)">
                            <Image Width="15" Height="15" Margin="0,0,7,0" VerticalAlignment="Center"
                                   Source="pack://application:,,,/Resources/Images/ShellPresets/claude_code.png"
                                   RenderOptions.BitmapScalingMode="HighQuality"/>
                            <TextBlock x:Name="RlFiveLabel" VerticalAlignment="Center"
                                       FontSize="{DynamicResource Fs12}" Foreground="{DynamicResource TextMutedBrush}"/>
                            <Border Width="56" Height="6" Margin="6,0,0,0" CornerRadius="3"
                                    Background="{DynamicResource LineBrush}" VerticalAlignment="Center">
                                <Border x:Name="RlFiveBar" Width="0" HorizontalAlignment="Left" CornerRadius="3"/>
                            </Border>
                            <TextBlock x:Name="RlFivePct" Margin="6,0,0,0" VerticalAlignment="Center"
                                       FontSize="{DynamicResource Fs12}" Foreground="{DynamicResource TextBrush}"/>
                            <TextBlock x:Name="RlSevenLabel" Text="주간" Margin="14,0,0,0" VerticalAlignment="Center"
                                       FontSize="{DynamicResource Fs12}" Foreground="{DynamicResource TextMutedBrush}"/>
                            <Border Width="56" Height="6" Margin="6,0,0,0" CornerRadius="3"
                                    Background="{DynamicResource LineBrush}" VerticalAlignment="Center">
                                <Border x:Name="RlSevenBar" Width="0" HorizontalAlignment="Left" CornerRadius="3"/>
                            </Border>
                            <TextBlock x:Name="RlSevenPct" Margin="6,0,0,0" VerticalAlignment="Center"
                                       FontSize="{DynamicResource Fs12}" Foreground="{DynamicResource TextBrush}"/>
                        </StackPanel>
                        <!-- Codex (클릭 시 ChatGPT OAuth 로그인) -->
                        <StackPanel x:Name="CodexPanel" Orientation="Horizontal" VerticalAlignment="Center" Visibility="Collapsed"
                                    Background="Transparent" Cursor="Arrow">
                            <Border x:Name="CxLeadDivider" Width="1" Height="12" Margin="14,0,14,0" VerticalAlignment="Center"
                                    Background="{DynamicResource TextMutedBrush}" Opacity="0.55"/>
                            <Image Width="15" Height="15" Margin="0,0,7,0" VerticalAlignment="Center"
                                   Source="pack://application:,,,/Resources/Images/ShellPresets/codex.png"
                                   RenderOptions.BitmapScalingMode="HighQuality"/>
                            <TextBlock x:Name="CxFiveLabel" VerticalAlignment="Center"
                                       FontSize="{DynamicResource Fs12}" Foreground="{DynamicResource TextMutedBrush}"/>
                            <Border Width="56" Height="6" Margin="6,0,0,0" CornerRadius="3"
                                    Background="{DynamicResource LineBrush}" VerticalAlignment="Center">
                                <Border x:Name="CxFiveBar" Width="0" HorizontalAlignment="Left" CornerRadius="3"/>
                            </Border>
                            <TextBlock x:Name="CxFivePct" Margin="6,0,0,0" VerticalAlignment="Center"
                                       FontSize="{DynamicResource Fs12}" Foreground="{DynamicResource TextBrush}"/>
                            <TextBlock x:Name="CxSevenLabel" Text="주간" Margin="14,0,0,0" VerticalAlignment="Center"
                                       FontSize="{DynamicResource Fs12}" Foreground="{DynamicResource TextMutedBrush}"/>
                            <Border Width="56" Height="6" Margin="6,0,0,0" CornerRadius="3"
                                    Background="{DynamicResource LineBrush}" VerticalAlignment="Center">
                                <Border x:Name="CxSevenBar" Width="0" HorizontalAlignment="Left" CornerRadius="3"/>
                            </Border>
                            <TextBlock x:Name="CxSevenPct" Margin="6,0,0,0" VerticalAlignment="Center"
                                       FontSize="{DynamicResource Fs12}" Foreground="{DynamicResource TextBrush}"/>
                        </StackPanel>
                        <!-- opencode-go (클릭 시 재로그인) -->
                        <StackPanel x:Name="GoPanel" Orientation="Horizontal" VerticalAlignment="Center" Visibility="Collapsed"
                                    Background="Transparent" Cursor="Arrow">
                            <Border x:Name="GoLeadDivider" Width="1" Height="12" Margin="14,0,14,0" VerticalAlignment="Center"
                                    Background="{DynamicResource TextMutedBrush}" Opacity="0.55"/>
                            <Image x:Name="GoFooterIcon" Width="15" Height="15" Margin="0,0,7,0" VerticalAlignment="Center"
                                   Source="pack://application:,,,/Resources/Images/ShellPresets/opencode_icon_white_50.png"
                                   RenderOptions.BitmapScalingMode="HighQuality"/>
                            <TextBlock x:Name="GoFiveLabel" VerticalAlignment="Center"
                                       FontSize="{DynamicResource Fs12}" Foreground="{DynamicResource TextMutedBrush}"/>
                            <Border Width="56" Height="6" Margin="6,0,0,0" CornerRadius="3"
                                    Background="{DynamicResource LineBrush}" VerticalAlignment="Center">
                                <Border x:Name="GoFiveBar" Width="0" HorizontalAlignment="Left" CornerRadius="3"/>
                            </Border>
                            <TextBlock x:Name="GoFivePct" Margin="6,0,0,0" VerticalAlignment="Center"
                                       FontSize="{DynamicResource Fs12}" Foreground="{DynamicResource TextBrush}"/>
                            <TextBlock x:Name="GoSevenLabel" Text="주간" Margin="14,0,0,0" VerticalAlignment="Center"
                                       FontSize="{DynamicResource Fs12}" Foreground="{DynamicResource TextMutedBrush}"/>
                            <Border Width="56" Height="6" Margin="6,0,0,0" CornerRadius="3"
                                    Background="{DynamicResource LineBrush}" VerticalAlignment="Center">
                                <Border x:Name="GoSevenBar" Width="0" HorizontalAlignment="Left" CornerRadius="3"/>
                            </Border>
                            <TextBlock x:Name="GoSevenPct" Margin="6,0,0,0" VerticalAlignment="Center"
                                       FontSize="{DynamicResource Fs12}" Foreground="{DynamicResource TextBrush}"/>
                            <TextBlock x:Name="GoMonthLabel" Text="월간" Margin="14,0,0,0" VerticalAlignment="Center"
                                       FontSize="{DynamicResource Fs12}" Foreground="{DynamicResource TextMutedBrush}"/>
                            <Border Width="56" Height="6" Margin="6,0,0,0" CornerRadius="3"
                                    Background="{DynamicResource LineBrush}" VerticalAlignment="Center">
                                <Border x:Name="GoMonthBar" Width="0" HorizontalAlignment="Left" CornerRadius="3"/>
                            </Border>
                            <TextBlock x:Name="GoMonthPct" Margin="6,0,0,0" VerticalAlignment="Center"
                                       FontSize="{DynamicResource Fs12}" Foreground="{DynamicResource TextBrush}"/>
                        </StackPanel>
                        <!-- DeepSeek (API 키 잔액) -->
                        <StackPanel x:Name="DeepSeekPanel" Orientation="Horizontal" VerticalAlignment="Center" Visibility="Collapsed"
                                    Background="Transparent" Cursor="Arrow">
                            <Border x:Name="DeepSeekLeadDivider" Width="1" Height="12" Margin="14,0,14,0" VerticalAlignment="Center"
                                    Background="{DynamicResource TextMutedBrush}" Opacity="0.55"/>
                            <Image Width="15" Height="15" Margin="0,0,7,0" VerticalAlignment="Center"
                                   Source="pack://application:,,,/Resources/Images/ShellPresets/deepseek.png"
                                   RenderOptions.BitmapScalingMode="HighQuality"/>
                            <TextBlock x:Name="DeepSeekBalanceLabel" VerticalAlignment="Center"
                                       FontSize="{DynamicResource Fs12}" Foreground="{DynamicResource TextBrush}"/>
                        </StackPanel>
                    </StackPanel>
                    <!-- 우측: 설정 버튼 (MCP 서버 버튼은 보류 — 2026-06 보류, 재활성 시 Visibility 제거 + Uncomment).
                         컬럼은 FooterFileExpCol(FooterActionsCol)이 아닌 별도 고정폭 컬럼에 둔다 — 우측 패널 접힘과 무관하게 항상 노출. -->
                    <StackPanel Grid.Column="4" Orientation="Horizontal" HorizontalAlignment="Right">
                        <!--
                        <Button Style="{StaticResource WinCtrlBtn}" Click="McpBtn_Click"
                                ToolTip="MCP 서버" Margin="0,0,2,0">
                            <Path Style="{StaticResource LucideIcon}" Data="{StaticResource IconServer}"
                                  Width="15" Height="15" Stroke="{DynamicResource TextMutedBrush}"/>
                        </Button>
                        -->
                        <Button x:Name="CleanerBtn" Style="{StaticResource WinCtrlBtn}" Width="30"
                                Click="CleanerBtn_Click" ToolTip="세션 클리너" Margin="0,0,2,0">
                            <Path Style="{StaticResource LucideIcon}" Data="{StaticResource IconBrushCleaning}"
                                  Width="15" Height="15" Stroke="{DynamicResource TextMutedBrush}"/>
                        </Button>
                        <Button Style="{StaticResource WinCtrlBtn}" Width="30" Click="SettingsBtn_Click"
                                ToolTip="설정" Margin="0,0,4,0">
                            <Path Style="{StaticResource LucideIcon}" Data="{StaticResource IconSettings}"
                                  Width="15" Height="15" Stroke="{DynamicResource TextMutedBrush}"/>
                        </Button>
                    </StackPanel>
                </Grid>
            </Border>

            <!-- 좁은 창용 우측 패널 오버레이 호스트 (body 행만 덮음).
                 좁아지면 FileExplorer 를 여기로 재부모화해 우측 드로어로 띄운다.
                 스크림 클릭 시 닫힘. ZIndex 는 설정 오버레이(200)보다 낮게. -->
            <Grid x:Name="RightOverlayHost" Grid.Row="2" Panel.ZIndex="90" Visibility="Collapsed">
                <Border x:Name="RightScrim" Background="#80000000"
                        MouseLeftButtonDown="RightScrim_Click"/>
                <Border x:Name="RightOverlayPanel" HorizontalAlignment="Right"
                        Background="{DynamicResource PanelBrush}"
                        BorderBrush="{DynamicResource LineBrush}" BorderThickness="1,0,0,0">
                    <Border.Effect>
                        <DropShadowEffect BlurRadius="18" ShadowDepth="0" Opacity="0.4" Color="Black"/>
                    </Border.Effect>
                </Border>
            </Grid>

            <!-- 설정창 오버레이 호스트 (전체 영역 덮음) -->
            <Grid x:Name="OverlayHost" Grid.Row="0" Grid.RowSpan="4" Panel.ZIndex="200"/>

            <!-- 종료 중 오버레이 — 열린 세션을 graceful 종료하는 동안 표시 -->
            <Grid x:Name="ShutdownOverlay" Grid.Row="0" Grid.RowSpan="4" Panel.ZIndex="300"
                  Visibility="Collapsed" Background="#B0000000">
                <Border HorizontalAlignment="Center" VerticalAlignment="Center"
                        CornerRadius="14" Padding="32,28"
                        Background="{DynamicResource PanelBrush}"
                        BorderBrush="{DynamicResource LineBrush}" BorderThickness="1">
                    <StackPanel HorizontalAlignment="Center">
                        <!-- 회전 스피너 -->
                        <Ellipse Width="34" Height="34"
                                 Stroke="{DynamicResource PrimaryBrush}" StrokeThickness="3"
                                 StrokeDashArray="18 100" StrokeDashCap="Round"
                                 RenderTransformOrigin="0.5,0.5">
                            <Ellipse.RenderTransform>
                                <RotateTransform x:Name="ShutdownSpinnerRotate"/>
                            </Ellipse.RenderTransform>
                            <Ellipse.Triggers>
                                <EventTrigger RoutedEvent="FrameworkElement.Loaded">
                                    <BeginStoryboard>
                                        <Storyboard>
                                            <DoubleAnimation Storyboard.TargetName="ShutdownSpinnerRotate"
                                                             Storyboard.TargetProperty="Angle"
                                                             From="0" To="360" Duration="0:0:0.9"
                                                             RepeatBehavior="Forever"/>
                                        </Storyboard>
                                    </BeginStoryboard>
                                </EventTrigger>
                            </Ellipse.Triggers>
                        </Ellipse>
                        <TextBlock Text="열려있는 세션을 안전하게 닫는 중 입니다." Margin="0,18,0,0"
                                   HorizontalAlignment="Center"
                                   FontSize="{DynamicResource Fs14}" FontWeight="SemiBold"
                                   Foreground="{DynamicResource TextBrush}"/>
                        <TextBlock Text="강제 종료 시 마지막 대화 내용이 소실될 수 있습니다." Margin="0,8,0,0"
                                   HorizontalAlignment="Center" TextAlignment="Center"
                                   FontSize="{DynamicResource Fs12}"
                                   Foreground="{DynamicResource TextMutedBrush}"/>
                    </StackPanel>
                </Border>
            </Grid>
        </Grid>
    </Border>
</Window>
