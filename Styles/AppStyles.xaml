<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:sys="clr-namespace:System;assembly=mscorlib"
                    xmlns:primitives="clr-namespace:System.Windows.Controls.Primitives;assembly=PresentationFramework">

    <!-- Pretendard font -->
    <FontFamily x:Key="PretendardFont">pack://application:,,,/Fonts/#Pretendard</FontFamily>
    <!-- Bruno Ace SC font -->
    <FontFamily x:Key="BrunoAceSCFont">pack://application:,,,/Fonts/#Bruno Ace SC</FontFamily>

    <!-- ── Minimal (default) theme colors ─────────────────────────────── -->
    <Color x:Key="BgColor">#f8fafc</Color>
    <Color x:Key="PanelColor">#ffffff</Color>
    <Color x:Key="PanelSoftColor">#f1f5f9</Color>
    <Color x:Key="LineColor">#e2e8f0</Color>
    <Color x:Key="TextColor">#0f172a</Color>
    <Color x:Key="TextMutedColor">#475569</Color>
    <Color x:Key="PrimaryColor">#2563eb</Color>
    <Color x:Key="PrimaryHoverColor">#1d4ed8</Color>
    <Color x:Key="PrimaryPressedColor">#1e40af</Color>
    <Color x:Key="PrimarySoftColor">#dbeafe</Color>
    <Color x:Key="BubbleColor">#eef4ff</Color>
    <Color x:Key="DangerColor">#ef4444</Color>
    <Color x:Key="SuccessColor">#22c55e</Color>
    <Color x:Key="WarningColor">#eab308</Color>
    <Color x:Key="TodayColor">#f97316</Color>
    <Color x:Key="SidebarSubTextColor">#475569</Color>
    <sys:Double x:Key="CheckedBubbleOpacity">0.4</sys:Double>
    <Color x:Key="BubbleCheckedBgColor">#f0fdf4</Color>
    <Color x:Key="BubbleCheckedBorderColor">#86efac</Color>
    <Color x:Key="BubbleCheckedTextColor">#166534</Color>
    <Color x:Key="ShadowColor">#000000</Color>
    <sys:Double x:Key="ShadowOpacity">0.68</sys:Double>
    <sys:Double x:Key="PopupShadowOpacity">0.42</sys:Double>
    <sys:Double x:Key="WindowShadowBlurRadius">40</sys:Double>
    <Thickness x:Key="WindowShadowOuterMargin">20</Thickness>
    <Thickness x:Key="WindowShadowInnerMargin">1</Thickness>
    <CornerRadius x:Key="WindowShadowCornerRadius">13</CornerRadius>

    <SolidColorBrush x:Key="BgBrush"          Color="{DynamicResource BgColor}"/>
    <SolidColorBrush x:Key="PanelBrush"        Color="{DynamicResource PanelColor}"/>
    <SolidColorBrush x:Key="PanelSoftBrush"    Color="{DynamicResource PanelSoftColor}"/>
    <SolidColorBrush x:Key="LineBrush"         Color="{DynamicResource LineColor}"/>
    <SolidColorBrush x:Key="TextBrush"         Color="{DynamicResource TextColor}"/>
    <SolidColorBrush x:Key="TextMutedBrush"    Color="{DynamicResource TextMutedColor}"/>
    <SolidColorBrush x:Key="PrimaryBrush"      Color="{DynamicResource PrimaryColor}"/>
    <SolidColorBrush x:Key="LinkBrush"         Color="#4A9EE8"/>
    <SolidColorBrush x:Key="PrimaryHoverBrush" Color="{DynamicResource PrimaryHoverColor}"/>
    <!-- 탭 선택 포커스 링: 채팅 버블 하이라이트처럼 은은한 반투명 primary 테두리 -->
    <SolidColorBrush x:Key="TabFocusRingBrush" Color="{DynamicResource PrimaryColor}" Opacity="0.55"/>
    <SolidColorBrush x:Key="PrimarySoftBrush"  Color="{DynamicResource PrimarySoftColor}"/>
    <SolidColorBrush x:Key="BubbleBrush"       Color="{DynamicResource BubbleColor}"/>
    <SolidColorBrush x:Key="BubbleBorderBrush" Color="{DynamicResource BubbleBorderColor}"/>
    <SolidColorBrush x:Key="DangerBrush"        Color="{DynamicResource DangerColor}"/>
    <!-- 입력 대기(선택지 메뉴) ❗ 등 주의 상태색. 팔레트 계열의 노란색(yellow-500). -->
    <SolidColorBrush x:Key="WarningBrush"       Color="{DynamicResource WarningColor}"/>
    <SolidColorBrush x:Key="SuccessBrush"       Color="{DynamicResource SuccessColor}"/>
    <SolidColorBrush x:Key="TodayBrush"         Color="{DynamicResource TodayColor}"/>
    <SolidColorBrush x:Key="SidebarSubTextBrush" Color="{DynamicResource SidebarSubTextColor}"/>
    <Color x:Key="RailIconColor">#475569</Color>
    <SolidColorBrush x:Key="RailIconBrush" Color="{DynamicResource RailIconColor}"/>

    <!-- 글꼴 크기 (보통=기본값, 크게=+2). 런타임에 App.SetFontScale 에서 조정 -->
    <sys:Double x:Key="Fs8">8</sys:Double>
    <sys:Double x:Key="Fs10">10</sys:Double>
    <sys:Double x:Key="Fs11">11</sys:Double>
    <sys:Double x:Key="Fs12">12</sys:Double>
    <sys:Double x:Key="Fs13">13</sys:Double>
    <sys:Double x:Key="Fs14">14</sys:Double>
    <sys:Double x:Key="Fs15">15</sys:Double>
    <sys:Double x:Key="Fs16">16</sys:Double>
    <sys:Double x:Key="Fs17">17</sys:Double>
    <sys:Double x:Key="Fs18">18</sys:Double>
    <sys:Double x:Key="Fs20">20</sys:Double>
    <sys:Double x:Key="Fs26">26</sys:Double>
    <sys:Double x:Key="Fs36">36</sys:Double>

    <!-- 컨트롤 크기 기준값 (App.SetFontScale에서 글꼴 크기에 따라 조정) -->
    <Thickness x:Key="CardStarMargin">-1,-2,7,0</Thickness>
    <sys:Double x:Key="RailWidth">44</sys:Double>
    <sys:Double x:Key="RailBtnSize">32</sys:Double>
    <sys:Double x:Key="RailIconSize">30</sys:Double>
    <sys:Double x:Key="HdrBtnSize">28</sys:Double>
    <SolidColorBrush x:Key="CountBadgeBrush"   Color="#5b8af0"/>
    <SolidColorBrush x:Key="CountBadgeTextBrush" Color="White"/>
    <SolidColorBrush x:Key="StarBrush"         Color="#f59e0b"/>

    <!-- ── ToolTip ─────────────────────────────────────────────────────── -->
    <Style TargetType="ToolTip">
        <Setter Property="FontFamily" Value="{StaticResource PretendardFont}"/>
        <Setter Property="FontSize" Value="{DynamicResource Fs12}"/>
        <Setter Property="Foreground" Value="{DynamicResource TextBrush}"/>
        <Setter Property="Background" Value="{DynamicResource PanelBrush}"/>
        <Setter Property="BorderBrush" Value="{DynamicResource LineBrush}"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="Padding" Value="8,5"/>
        <Setter Property="HasDropShadow" Value="True"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ToolTip">
                    <Border Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}"
                            CornerRadius="6"
                            Padding="{TemplateBinding Padding}"
                            Effect="{TemplateBinding Effect}">
                        <TextBlock Text="{TemplateBinding Content}"
                                   FontFamily="{TemplateBinding FontFamily}"
                                   FontSize="{TemplateBinding FontSize}"
                                   Foreground="{TemplateBinding Foreground}"/>
                    </Border>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ── High-quality rendering (inherited by all children) ───────────── -->
    <Style TargetType="Window">
        <Setter Property="UseLayoutRounding" Value="True"/>
        <Setter Property="RenderOptions.BitmapScalingMode" Value="HighQuality"/>
        <Setter Property="TextOptions.TextRenderingMode" Value="ClearType"/>
    </Style>
    <Style TargetType="UserControl">
        <Setter Property="RenderOptions.BitmapScalingMode" Value="HighQuality"/>
        <Setter Property="TextOptions.TextRenderingMode" Value="ClearType"/>
    </Style>

    <!-- ── Global font + focus defaults ──────────────────────────────────── -->
    <!-- Override the system-wide focus visual key with an empty template so
         no dotted border ever appears, regardless of control type. -->
    <Style x:Key="{x:Static SystemParameters.FocusVisualStyleKey}">
        <Setter Property="Control.Template">
            <Setter.Value><ControlTemplate/></Setter.Value>
        </Setter>
    </Style>
    <Style TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{StaticResource PretendardFont}"/>
        <Setter Property="TextOptions.TextFormattingMode" Value="Ideal"/>
        <Setter Property="TextOptions.TextRenderingMode" Value="ClearType"/>
    </Style>

    <!-- ── 텍스트 편집 컨텍스트 메뉴 항목 (아이콘 없는 심플: 헤더 + 단축키) ──── -->
    <Style x:Key="EditMenuItem" TargetType="MenuItem">
        <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="Foreground" Value="{DynamicResource TextBrush}"/>
        <Setter Property="FontFamily" Value="{StaticResource PretendardFont}"/>
        <Setter Property="FontSize" Value="{DynamicResource Fs12}"/>
        <Setter Property="Padding" Value="12,7"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="MenuItem">
                    <Border x:Name="Bd" CornerRadius="6"
                            Background="{TemplateBinding Background}"
                            Padding="{TemplateBinding Padding}"
                            MinWidth="150">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="20"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <ContentPresenter Grid.Column="0" ContentSource="Icon"
                                              Width="14" Height="14"
                                              HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            <ContentPresenter Grid.Column="1" ContentSource="Header"
                                              RecognizesAccessKey="True"
                                              VerticalAlignment="Center"
                                              HorizontalAlignment="Left"
                                              Margin="6,0,0,0"
                                              TextElement.Foreground="{TemplateBinding Foreground}"/>
                            <TextBlock Grid.Column="2"
                                       Text="{TemplateBinding InputGestureText}"
                                       Foreground="{DynamicResource TextMutedBrush}"
                                       Margin="20,0,0,0"
                                       VerticalAlignment="Center"
                                       FontSize="{DynamicResource Fs11}"/>
                        </Grid>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsHighlighted" Value="True">
                            <Setter TargetName="Bd" Property="Background"
                                    Value="{DynamicResource PanelSoftBrush}"/>
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Opacity" Value="0.4"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- 전 텍스트박스 공용 편집 메뉴. x:Shared=False → 인스턴스마다 새로 생성(부모 충돌 방지). -->
    <ContextMenu x:Key="TextEditContextMenu" x:Shared="False">
        <MenuItem Header="잘라내기" InputGestureText="Ctrl+X" Style="{StaticResource EditMenuItem}"
                  Command="ApplicationCommands.Cut"
                  CommandTarget="{Binding PlacementTarget, RelativeSource={RelativeSource AncestorType=ContextMenu}}">
            <MenuItem.Icon>
                <Viewbox Width="14" Height="14" Stretch="Uniform">
                    <Path Data="{DynamicResource IconScissors}" Width="24" Height="24" Stretch="Uniform"
                          Stroke="{DynamicResource TextBrush}" StrokeThickness="2" Fill="Transparent"
                          StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round"/>
                </Viewbox>
            </MenuItem.Icon>
        </MenuItem>
        <MenuItem Header="복사" InputGestureText="Ctrl+C" Style="{StaticResource EditMenuItem}"
                  Command="ApplicationCommands.Copy"
                  CommandTarget="{Binding PlacementTarget, RelativeSource={RelativeSource AncestorType=ContextMenu}}">
            <MenuItem.Icon>
                <Viewbox Width="14" Height="14" Stretch="Uniform">
                    <Path Data="{DynamicResource IconCopy}" Width="24" Height="24" Stretch="Uniform"
                          Stroke="{DynamicResource TextBrush}" StrokeThickness="2" Fill="Transparent"
                          StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round"/>
                </Viewbox>
            </MenuItem.Icon>
        </MenuItem>
        <MenuItem Header="붙여넣기" InputGestureText="Ctrl+V" Style="{StaticResource EditMenuItem}"
                  Command="ApplicationCommands.Paste"
                  CommandTarget="{Binding PlacementTarget, RelativeSource={RelativeSource AncestorType=ContextMenu}}">
            <MenuItem.Icon>
                <Viewbox Width="14" Height="14" Stretch="Uniform">
                    <Path Data="{DynamicResource IconClipboard}" Width="24" Height="24" Stretch="Uniform"
                          Stroke="{DynamicResource TextBrush}" StrokeThickness="2" Fill="Transparent"
                          StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round"/>
                </Viewbox>
            </MenuItem.Icon>
        </MenuItem>
        <Separator/>
        <MenuItem Header="전체 선택" InputGestureText="Ctrl+A" Style="{StaticResource EditMenuItem}"
                  Command="ApplicationCommands.SelectAll"
                  CommandTarget="{Binding PlacementTarget, RelativeSource={RelativeSource AncestorType=ContextMenu}}">
            <MenuItem.Icon>
                <Viewbox Width="14" Height="14" Stretch="Uniform">
                    <Path Data="{DynamicResource IconSelectAll}" Width="24" Height="24" Stretch="Uniform"
                          Stroke="{DynamicResource TextBrush}" StrokeThickness="2" Fill="Transparent"
                          StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round"/>
                </Viewbox>
            </MenuItem.Icon>
        </MenuItem>
    </ContextMenu>

    <Style TargetType="TextBox">
        <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
        <Setter Property="FontFamily" Value="{StaticResource PretendardFont}"/>
        <Setter Property="TextOptions.TextFormattingMode" Value="Ideal"/>
        <Setter Property="TextOptions.TextRenderingMode" Value="ClearType"/>
        <Setter Property="SelectionBrush" Value="{DynamicResource PrimaryBrush}"/>
        <Setter Property="SelectionOpacity" Value="0.35"/>
        <Setter Property="SelectionTextBrush" Value="{DynamicResource TextBrush}"/>
        <Setter Property="ContextMenu" Value="{StaticResource TextEditContextMenu}"/>
    </Style>
    <Style TargetType="RichTextBox">
        <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
        <Setter Property="FontFamily" Value="{StaticResource PretendardFont}"/>
        <Setter Property="TextOptions.TextFormattingMode" Value="Ideal"/>
        <Setter Property="TextOptions.TextRenderingMode" Value="ClearType"/>
        <Setter Property="SelectionBrush" Value="{DynamicResource PrimaryBrush}"/>
        <Setter Property="SelectionOpacity" Value="0.35"/>
        <Setter Property="SpellCheck.IsEnabled" Value="False"/>
        <Setter Property="ContextMenu" Value="{StaticResource TextEditContextMenu}"/>
    </Style>
    <Style TargetType="Button">
        <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
        <Setter Property="FontFamily" Value="{StaticResource PretendardFont}"/>
    </Style>
    <Style TargetType="PasswordBox">
        <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
        <Setter Property="FontFamily" Value="{StaticResource PretendardFont}"/>
    </Style>
    <Style TargetType="Label">
        <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
        <Setter Property="FontFamily" Value="{StaticResource PretendardFont}"/>
    </Style>
    <Style TargetType="CheckBox">
        <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
    </Style>
    <Style TargetType="RadioButton">
        <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
    </Style>
    <Style TargetType="ToggleButton">
        <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
    </Style>
    <Style TargetType="ComboBox">
        <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
    </Style>
    <Style TargetType="ComboBoxItem">
        <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
    </Style>

    <!-- ── 컴팩트 Dock 콤보박스 (메타바 model/effort 선택) ──────────────────────
         테마 대응 알약형. PanelSoft 배경 + Line 테두리 + chevron. 드롭다운은 PanelBrush 카드. -->
    <Style x:Key="DockComboBoxItem" TargetType="ComboBoxItem">
        <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
        <Setter Property="FontFamily" Value="{StaticResource PretendardFont}"/>
        <Setter Property="FontSize" Value="{DynamicResource Fs12}"/>
        <Setter Property="Foreground" Value="{DynamicResource TextBrush}"/>
        <Setter Property="Padding" Value="9,5"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ComboBoxItem">
                    <Border x:Name="Bd" Background="Transparent" CornerRadius="6" Margin="3,1" Padding="{TemplateBinding Padding}">
                        <ContentPresenter VerticalAlignment="Center"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="{DynamicResource PanelSoftBrush}"/>
                        </Trigger>
                        <Trigger Property="IsSelected" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="{DynamicResource PrimaryBrush}"/>
                            <Setter Property="Foreground" Value="White"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="DockComboBox" TargetType="ComboBox">
        <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
        <Setter Property="FontFamily" Value="{StaticResource PretendardFont}"/>
        <Setter Property="FontSize" Value="{DynamicResource Fs12}"/>
        <Setter Property="Foreground" Value="{DynamicResource TextBrush}"/>
        <Setter Property="Height" Value="24"/>
        <Setter Property="ItemContainerStyle" Value="{StaticResource DockComboBoxItem}"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ComboBox">
                    <Grid>
                        <ToggleButton x:Name="Tgl" Focusable="False" ClickMode="Press"
                                      IsChecked="{Binding IsDropDownOpen, Mode=TwoWay, RelativeSource={RelativeSource TemplatedParent}}">
                            <ToggleButton.Template>
                                <ControlTemplate TargetType="ToggleButton">
                                    <Border x:Name="Bd" Background="{DynamicResource PanelSoftBrush}" CornerRadius="5"
                                            BorderBrush="{DynamicResource LineBrush}" BorderThickness="1" Padding="9,0,6,0">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>
                                            <ContentPresenter Grid.Column="0" VerticalAlignment="Center"
                                                              TextElement.Foreground="{DynamicResource TextBrush}"
                                                              TextElement.FontFamily="{StaticResource PretendardFont}"
                                                              TextElement.FontSize="{DynamicResource Fs12}"
                                                              Content="{Binding SelectionBoxItem, RelativeSource={RelativeSource AncestorType=ComboBox}}"/>
                                            <Path Grid.Column="1" Width="11" Height="11" Margin="6,0,0,0" Stretch="Uniform"
                                                  Data="{DynamicResource IconChevronDown}"
                                                  Stroke="{DynamicResource TextMutedBrush}" StrokeThickness="2"
                                                  StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round"
                                                  Fill="Transparent" VerticalAlignment="Center"/>
                                        </Grid>
                                    </Border>
                                    <ControlTemplate.Triggers>
                                        <!-- 호버: 보더 유지, 배경만 살짝 하이라이트 -->
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter TargetName="Bd" Property="Background" Value="{DynamicResource PanelBrush}"/>
                                        </Trigger>
                                        <Trigger Property="IsChecked" Value="True">
                                            <Setter TargetName="Bd" Property="Background" Value="{DynamicResource PanelBrush}"/>
                                        </Trigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </ToggleButton.Template>
                        </ToggleButton>

                        <Popup x:Name="PART_Popup" Placement="Bottom" VerticalOffset="4"
                               AllowsTransparency="True" PopupAnimation="Fade"
                               IsOpen="{Binding IsDropDownOpen, RelativeSource={RelativeSource TemplatedParent}}">
                            <Border Background="{DynamicResource PanelBrush}" BorderBrush="{DynamicResource LineBrush}"
                                    BorderThickness="1" CornerRadius="10" Padding="2" MinWidth="{Binding ActualWidth, RelativeSource={RelativeSource TemplatedParent}}"
                                    Margin="0,0,8,8">
                                <Border.Effect>
                                    <DropShadowEffect BlurRadius="18" ShadowDepth="2" Opacity="0.28" Color="#000000"/>
                                </Border.Effect>
                                <ScrollViewer MaxHeight="280" VerticalScrollBarVisibility="Auto">
                                    <ItemsPresenter/>
                                </ScrollViewer>
                            </Border>
                        </Popup>
                    </Grid>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ── Calendar (DatePicker dropdown) ──────────────────────────────────── -->
    <Style x:Key="ThemedCalendarDayButton" TargetType="CalendarDayButton">
        <Setter Property="Foreground" Value="{DynamicResource TextBrush}"/>
        <Setter Property="FontSize" Value="{DynamicResource Fs12}"/>
        <Setter Property="FontFamily" Value="{StaticResource PretendardFont}"/>
        <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="CalendarDayButton">
                    <Border x:Name="Bd" CornerRadius="6" Background="Transparent"
                            BorderBrush="Transparent" BorderThickness="1.5" Margin="1">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="{DynamicResource PanelSoftBrush}"/>
                        </Trigger>
                        <Trigger Property="IsInactive" Value="True">
                            <Setter Property="Foreground" Value="{DynamicResource TextMutedBrush}"/>
                            <Setter Property="Opacity" Value="0.45"/>
                        </Trigger>
                        <Trigger Property="IsToday" Value="True">
                            <Setter TargetName="Bd" Property="BorderBrush" Value="{DynamicResource PrimaryBrush}"/>
                        </Trigger>
                        <Trigger Property="IsSelected" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="{DynamicResource PrimaryBrush}"/>
                            <Setter TargetName="Bd" Property="BorderBrush" Value="{DynamicResource PrimaryBrush}"/>
                            <Setter Property="Foreground" Value="White"/>
                        </Trigger>
                        <Trigger Property="IsBlackedOut" Value="True">
                            <Setter Property="Opacity" Value="0.3"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="ThemedCalendarButton" TargetType="CalendarButton">
        <Setter Property="Foreground" Value="{DynamicResource TextBrush}"/>
        <Setter Property="FontSize" Value="{DynamicResource Fs12}"/>
        <Setter Property="FontFamily" Value="{StaticResource PretendardFont}"/>
        <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="CalendarButton">
                    <Border x:Name="Bd" CornerRadius="6" Background="Transparent" Margin="2">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="{DynamicResource PanelSoftBrush}"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="ThemedCalendar" TargetType="Calendar">
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="BorderBrush" Value="{DynamicResource LineBrush}"/>
        <Setter Property="Foreground" Value="{DynamicResource TextBrush}"/>
        <Setter Property="FontFamily" Value="{StaticResource PretendardFont}"/>
        <Setter Property="CalendarItemStyle" Value="{DynamicResource ThemedCalendarItem}"/>
        <Setter Property="CalendarDayButtonStyle" Value="{DynamicResource ThemedCalendarDayButton}"/>
        <Setter Property="CalendarButtonStyle" Value="{DynamicResource ThemedCalendarButton}"/>
    </Style>

    <Style x:Key="ThemedCalendarItem" TargetType="CalendarItem">
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="CalendarItem">
                    <ControlTemplate.Resources>
                        <DataTemplate x:Key="{x:Static primitives:CalendarItem.DayTitleTemplateResourceKey}">
                            <TextBlock Text="{Binding}" HorizontalAlignment="Center" VerticalAlignment="Center"
                                       FontSize="{DynamicResource Fs11}" Foreground="{DynamicResource TextMutedBrush}" Margin="0,2,0,6"/>
                        </DataTemplate>
                    </ControlTemplate.Resources>
                    <Border Background="{DynamicResource PanelBrush}" BorderBrush="{DynamicResource LineBrush}"
                            BorderThickness="1" CornerRadius="10" Padding="10,8">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*"/>
                            </Grid.RowDefinitions>

                            <!-- Header -->
                            <Grid Grid.Row="0" Margin="0,0,0,4">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <Button x:Name="PART_PreviousButton" Grid.Column="0" Width="26" Height="26" Focusable="False">
                                    <Button.Template>
                                        <ControlTemplate TargetType="Button">
                                            <Border x:Name="b" Background="Transparent" CornerRadius="6">
                                                <Path Data="{DynamicResource IconChevronRight}" Stroke="{DynamicResource TextMutedBrush}"
                                                      StrokeThickness="2" StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round"
                                                      Width="11" Height="11" Stretch="Uniform" Fill="Transparent"
                                                      HorizontalAlignment="Center" VerticalAlignment="Center"
                                                      RenderTransformOrigin="0.5,0.5">
                                                    <Path.RenderTransform><ScaleTransform ScaleX="-1"/></Path.RenderTransform>
                                                </Path>
                                            </Border>
                                            <ControlTemplate.Triggers>
                                                <Trigger Property="IsMouseOver" Value="True">
                                                    <Setter TargetName="b" Property="Background" Value="{DynamicResource PanelSoftBrush}"/>
                                                </Trigger>
                                            </ControlTemplate.Triggers>
                                        </ControlTemplate>
                                    </Button.Template>
                                </Button>
                                <Button x:Name="PART_HeaderButton" Grid.Column="1" Focusable="False"
                                        Foreground="{DynamicResource TextBrush}" FontWeight="SemiBold" FontSize="{DynamicResource Fs13}">
                                    <Button.Template>
                                        <ControlTemplate TargetType="Button">
                                            <Border Background="Transparent" CornerRadius="6" Padding="6,2">
                                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"
                                                                  TextElement.Foreground="{DynamicResource TextBrush}"/>
                                            </Border>
                                        </ControlTemplate>
                                    </Button.Template>
                                </Button>
                                <Button x:Name="PART_NextButton" Grid.Column="2" Width="26" Height="26" Focusable="False">
                                    <Button.Template>
                                        <ControlTemplate TargetType="Button">
                                            <Border x:Name="b" Background="Transparent" CornerRadius="6">
                                                <Path Data="{DynamicResource IconChevronRight}" Stroke="{DynamicResource TextMutedBrush}"
                                                      StrokeThickness="2" StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round"
                                                      Width="11" Height="11" Stretch="Uniform" Fill="Transparent"
                                                      HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                            </Border>
                                            <ControlTemplate.Triggers>
                                                <Trigger Property="IsMouseOver" Value="True">
                                                    <Setter TargetName="b" Property="Background" Value="{DynamicResource PanelSoftBrush}"/>
                                                </Trigger>
                                            </ControlTemplate.Triggers>
                                        </ControlTemplate>
                                    </Button.Template>
                                </Button>
                            </Grid>

                            <!-- Month view -->
                            <Grid x:Name="PART_MonthView" Grid.Row="1" HorizontalAlignment="Center" VerticalAlignment="Center">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="32"/><ColumnDefinition Width="32"/><ColumnDefinition Width="32"/>
                                    <ColumnDefinition Width="32"/><ColumnDefinition Width="32"/><ColumnDefinition Width="32"/>
                                    <ColumnDefinition Width="32"/>
                                </Grid.ColumnDefinitions>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="32"/><RowDefinition Height="32"/><RowDefinition Height="32"/>
                                    <RowDefinition Height="32"/><RowDefinition Height="32"/><RowDefinition Height="32"/>
                                </Grid.RowDefinitions>
                            </Grid>

                            <!-- Year/Decade view -->
                            <Grid x:Name="PART_YearView" Grid.Row="1" HorizontalAlignment="Center" VerticalAlignment="Center" Visibility="Hidden">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="68"/><ColumnDefinition Width="68"/><ColumnDefinition Width="68"/>
                                </Grid.ColumnDefinitions>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="44"/><RowDefinition Height="44"/><RowDefinition Height="44"/>
                                </Grid.RowDefinitions>
                            </Grid>
                        </Grid>
                    </Border>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
    <Style TargetType="ListBoxItem">
        <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
    </Style>
    <Style TargetType="RepeatButton">
        <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
    </Style>
    <Style TargetType="Thumb">
        <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
    </Style>

    <!-- ── Auth input border wrapper (provides rounded corners) ────────── -->
    <Style x:Key="AuthInputBorder" TargetType="Border">
        <Setter Property="BorderBrush" Value="{DynamicResource LineBrush}"/>
        <Setter Property="BorderThickness" Value="1.5"/>
        <Setter Property="Background" Value="{DynamicResource PanelBrush}"/>
        <Setter Property="CornerRadius" Value="8"/>
        <Setter Property="Height" Value="40"/>
        <Setter Property="Padding" Value="10,0"/>
    </Style>

    <!-- ── Auth TextBox (Input) ──────────────────────────────────────────── -->
    <Style x:Key="InputStyle" TargetType="TextBox" BasedOn="{StaticResource {x:Type TextBox}}">
        <Setter Property="BorderThickness" Value="0"/>
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="Foreground" Value="{DynamicResource TextBrush}"/>
        <Setter Property="CaretBrush" Value="{DynamicResource TextBrush}"/>
        <Setter Property="SelectionBrush" Value="{DynamicResource PrimaryBrush}"/>
        <Setter Property="SelectionOpacity" Value="0.35"/>
        <Setter Property="SelectionTextBrush" Value="{DynamicResource TextBrush}"/>
        <Setter Property="FontSize" Value="{DynamicResource Fs14}"/>
        <Setter Property="FontFamily" Value="{StaticResource PretendardFont}"/>
        <Setter Property="VerticalContentAlignment" Value="Center"/>
        <Setter Property="Padding" Value="0"/>
        <Setter Property="TextOptions.TextFormattingMode" Value="Ideal"/>
        <Setter Property="TextOptions.TextRenderingMode" Value="ClearType"/>
    </Style>

    <!-- ── PasswordBox ───────────────────────────────────────────────────── -->
    <Style x:Key="PasswordStyle" TargetType="PasswordBox">
        <Setter Property="BorderThickness" Value="0"/>
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="Foreground" Value="{DynamicResource TextBrush}"/>
        <Setter Property="CaretBrush" Value="{DynamicResource TextBrush}"/>
        <Setter Property="FontSize" Value="{DynamicResource Fs14}"/>
        <Setter Property="FontFamily" Value="{StaticResource PretendardFont}"/>
        <Setter Property="VerticalContentAlignment" Value="Center"/>
        <Setter Property="Padding" Value="0"/>
        <Setter Property="TextOptions.TextFormattingMode" Value="Ideal"/>
        <Setter Property="TextOptions.TextRenderingMode" Value="ClearType"/>
    </Style>

    <!-- ── 타이틀바 칩 버튼 (devez 이식) — 성능 모니터/패널 토글 등 헤더 위젯 공용.
         평소 투명, 호버 시 PanelSoftBrush 배경(코너4, 위아래 2px 인셋). ──────────── -->
    <Style x:Key="TitleBarChipButton" TargetType="Button">
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="BorderThickness" Value="0"/>
        <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
        <Setter Property="Cursor" Value="Arrow"/>
        <Setter Property="Padding" Value="0"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Grid>
                        <Border x:Name="Bd" Background="Transparent" CornerRadius="4"/>
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"
                                          Margin="5,2"/>
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="{DynamicResource PanelSoftBrush}"/>
                            <Setter TargetName="Bd" Property="Margin" Value="0,2"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- 푸터 CPU/RAM 칩 — TitleBarChipButton 과 동일하나 호버 배경을 상하 2px 더 키움(Margin 0,0). -->
    <Style x:Key="PerfChipButton" TargetType="Button" BasedOn="{StaticResource TitleBarChipButton}">
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Grid>
                        <Border x:Name="Bd" Background="Transparent" CornerRadius="4"/>
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"
                                          Margin="5,2"/>
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="{DynamicResource PanelSoftBrush}"/>
                            <Setter TargetName="Bd" Property="Margin" Value="0,0"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ── Primary button ────────────────────────────────────────────────── -->
    <Style x:Key="PrimaryButton" TargetType="Button">
        <Setter Property="IsTabStop" Value="False"/>
        <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
        <Setter Property="Background" Value="{DynamicResource PrimaryBrush}"/>
        <Setter Property="Foreground" Value="White"/>
        <Setter Property="BorderThickness" Value="0"/>
        <Setter Property="FontWeight" Value="SemiBold"/>
        <Setter Property="FontFamily" Value="{StaticResource PretendardFont}"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="Bd" Background="{TemplateBinding Background}"
                            CornerRadius="10" Padding="16,0">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"
                                          TextElement.Foreground="{TemplateBinding Foreground}"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Bd" Property="Background">
                                <Setter.Value><SolidColorBrush Color="{DynamicResource PrimaryHoverColor}"/></Setter.Value>
                            </Setter>
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="Bd" Property="Background">
                                <Setter.Value><SolidColorBrush Color="{DynamicResource PrimaryPressedColor}"/></Setter.Value>
                            </Setter>
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter TargetName="Bd" Property="Background" Value="{DynamicResource LineBrush}"/>
                            <Setter TargetName="Bd" Property="Opacity" Value="1"/>
                            <Setter Property="Foreground" Value="{DynamicResource TextMutedBrush}"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ── Today button (주황, 캘린더 헤더 '일정 추가') — TodayBrush 기반 ── -->
    <Style x:Key="TodayButton" TargetType="Button">
        <Setter Property="IsTabStop" Value="False"/>
        <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
        <Setter Property="Background" Value="{DynamicResource TodayBrush}"/>
        <Setter Property="Foreground" Value="White"/>
        <Setter Property="BorderThickness" Value="0"/>
        <Setter Property="FontWeight" Value="SemiBold"/>
        <Setter Property="FontFamily" Value="{StaticResource PretendardFont}"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="Bd" Background="{TemplateBinding Background}"
                            CornerRadius="10" Padding="{TemplateBinding Padding}">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"
                                          TextElement.Foreground="{TemplateBinding Foreground}"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Bd" Property="Opacity" Value="0.9"/>
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="Bd" Property="Opacity" Value="0.8"/>
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter TargetName="Bd" Property="Background" Value="{DynamicResource LineBrush}"/>
                            <Setter Property="Foreground" Value="{DynamicResource TextMutedBrush}"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ── Success button (초록, '일정 추가' 등) — PrimaryButton 복제 + Success 토큰 ── -->
    <Style x:Key="SuccessButton" TargetType="Button">
        <Setter Property="IsTabStop" Value="False"/>
        <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
        <Setter Property="Background" Value="{DynamicResource SuccessBrush}"/>
        <Setter Property="Foreground" Value="White"/>
        <Setter Property="BorderThickness" Value="0"/>
        <Setter Property="FontWeight" Value="SemiBold"/>
        <Setter Property="FontFamily" Value="{StaticResource PretendardFont}"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="Bd" Background="{TemplateBinding Background}"
                            CornerRadius="10" Padding="16,0">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"
                                          TextElement.Foreground="{TemplateBinding Foreground}"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Bd" Property="Opacity" Value="0.9"/>
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="Bd" Property="Opacity" Value="0.8"/>
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter TargetName="Bd" Property="Background" Value="{DynamicResource LineBrush}"/>
                            <Setter Property="Foreground" Value="{DynamicResource TextMutedBrush}"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ── Secondary button (cancel) ───────────────────────────────────── -->
    <Style x:Key="SecondaryButton" TargetType="Button">
        <Setter Property="IsTabStop" Value="False"/>
        <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
        <Setter Property="Background" Value="{DynamicResource PanelBrush}"/>
        <Setter Property="Foreground" Value="{DynamicResource TextBrush}"/>
        <Setter Property="BorderThickness" Value="0"/>
        <Setter Property="FontWeight" Value="SemiBold"/>
        <Setter Property="FontFamily" Value="{StaticResource PretendardFont}"/>
        <Setter Property="Padding" Value="16,0"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Grid>
                        <!-- fill layer: same structure as PrimaryButton, full 100×38 -->
                        <Border x:Name="Bd" Background="{TemplateBinding Background}"
                                CornerRadius="10" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"
                                              TextElement.Foreground="{TemplateBinding Foreground}"/>
                        </Border>
                        <!-- stroke layer: Margin="-0.75" 로 테두리 중심을 버튼 경계에 정렬 →
                             PrimaryButton 과 시각적 크기 일치 -->
                        <Border CornerRadius="10.75" BorderBrush="{DynamicResource LineBrush}"
                                BorderThickness="1.5" Background="Transparent" IsHitTestVisible="False"
                                Margin="-0.75"/>
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="{DynamicResource PanelSoftBrush}"/>
                        </Trigger>
                        <!-- 비활성: PrimaryButton 과 동일하게 LineBrush 배경 + muted 텍스트로 '못 누름' 표현 -->
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter TargetName="Bd" Property="Background" Value="{DynamicResource LineBrush}"/>
                            <Setter Property="Foreground" Value="{DynamicResource TextMutedBrush}"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ── Icon button (transparent, small) ─────────────────────────────── -->
    <Style x:Key="IconButton" TargetType="Button">
        <Setter Property="IsTabStop" Value="False"/>
        <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="BorderThickness" Value="0"/>
        <Setter Property="Padding" Value="4"/>
        <Setter Property="Foreground" Value="{DynamicResource TextMutedBrush}"/>
        <Setter Property="FontFamily" Value="{StaticResource PretendardFont}"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="Bd" Background="{TemplateBinding Background}"
                            CornerRadius="6" Padding="{TemplateBinding Padding}">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"
                                          TextElement.Foreground="{TemplateBinding Foreground}"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="{DynamicResource PanelSoftBrush}"/>
                            <Setter Property="Foreground" Value="{DynamicResource TextBrush}"/>
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="{DynamicResource LineBrush}"/>
                        </Trigger>
                        <!-- 활성(켜짐) 상태 — 코드비하인드에서 Tag="active"로 토글한다.
                             IsMouseOver 트리거보다 뒤에 두어 hover 시에도 강조색이 우선. -->
                        <Trigger Property="Tag" Value="active">
                            <Setter TargetName="Bd" Property="Background" Value="{DynamicResource PrimaryBrush}"/>
                            <Setter Property="Foreground" Value="White"/>
                        </Trigger>
                        <!-- 활성 + 호버 조합: 더 어두운 파란색 -->
                        <MultiTrigger>
                            <MultiTrigger.Conditions>
                                <Condition Property="IsMouseOver" Value="True"/>
                                <Condition Property="Tag" Value="active"/>
                            </MultiTrigger.Conditions>
                            <Setter TargetName="Bd" Property="Background" Value="{DynamicResource PrimaryHoverBrush}"/>
                            <Setter Property="Foreground" Value="White"/>
                        </MultiTrigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- 선택 칩(드롭다운 트리거): 작은 둥근 pill. 테두리·hover로 "누르면 메뉴가 열린다"를 전달.
         라벨 끝의 ▾ 캐럿은 코드비하인드 Content 문자열에 포함한다. -->
    <Style x:Key="SelectorChip" TargetType="Button">
        <Setter Property="IsTabStop" Value="False"/>
        <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="BorderBrush" Value="{DynamicResource LineBrush}"/>
        <Setter Property="Padding" Value="9,4"/>
        <Setter Property="Cursor" Value="Arrow"/>
        <Setter Property="Foreground" Value="{DynamicResource TextMutedBrush}"/>
        <Setter Property="FontFamily" Value="{StaticResource PretendardFont}"/>
        <Setter Property="FontSize" Value="{DynamicResource Fs12}"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="Bd" Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}"
                            CornerRadius="7" Padding="{TemplateBinding Padding}">
                        <ContentPresenter VerticalAlignment="Center"
                                          TextElement.Foreground="{TemplateBinding Foreground}"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="{DynamicResource PanelSoftBrush}"/>
                            <Setter TargetName="Bd" Property="BorderBrush" Value="{DynamicResource PrimaryBrush}"/>
                            <Setter Property="Foreground" Value="{DynamicResource TextBrush}"/>
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="{DynamicResource PrimarySoftBrush}"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- 좌측 레일 아이콘 버튼: 아이콘(고정폭) + 캡션(레일 펼침 시 ToolTip 텍스트 노출).
         레일이 접히면 아이콘만, 펼치면 오른쪽에 캡션이 보인다. -->
    <Style x:Key="RailIconButton" TargetType="Button">
        <Setter Property="IsTabStop" Value="False"/>
        <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="BorderThickness" Value="0"/>
        <Setter Property="Foreground" Value="{DynamicResource RailIconBrush}"/>
        <Setter Property="FontFamily" Value="{StaticResource PretendardFont}"/>
        <Setter Property="HorizontalAlignment" Value="Stretch"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="Bd" Background="{TemplateBinding Background}"
                            CornerRadius="10" Height="{DynamicResource RailBtnSize}"
                            HorizontalAlignment="Stretch" Margin="6,0">
                        <StackPanel Orientation="Horizontal">
                            <Grid Width="{DynamicResource RailBtnSize}">
                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"
                                                  TextElement.Foreground="{TemplateBinding Foreground}"/>
                            </Grid>
                            <TextBlock x:Name="Cap" Text="{TemplateBinding ToolTip}"
                                       VerticalAlignment="Center" Visibility="Collapsed"
                                       Foreground="{TemplateBinding Foreground}"
                                       FontSize="{DynamicResource Fs13}"
                                       FontFamily="{StaticResource PretendardFont}"
                                       TextTrimming="CharacterEllipsis"/>
                        </StackPanel>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="{DynamicResource PanelSoftBrush}"/>
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="{DynamicResource LineBrush}"/>
                        </Trigger>
                        <Trigger Property="Tag" Value="active">
                            <Setter TargetName="Bd" Property="Background" Value="{DynamicResource PrimaryBrush}"/>
                            <Setter Property="Foreground" Value="White"/>
                        </Trigger>
                        <!-- 레일이 펼쳐지면 캡션 노출 -->
                        <DataTrigger Binding="{Binding DataContext.IsRailExpanded, RelativeSource={RelativeSource AncestorType=Window}}" Value="True">
                            <Setter TargetName="Cap" Property="Visibility" Value="Visible"/>
                        </DataTrigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ── Small icon button (RailIconButton 호버 규칙과 동일, 인라인 배치용) ── -->
    <Style x:Key="SmallIconButton" TargetType="Button">
        <Setter Property="IsTabStop" Value="False"/>
        <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="BorderThickness" Value="0"/>
        <Setter Property="Padding" Value="0"/>
        <Setter Property="Foreground" Value="{DynamicResource RailIconBrush}"/>
        <Setter Property="Cursor" Value="Arrow"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="Bd" Background="{TemplateBinding Background}"
                            CornerRadius="6"
                            Width="{TemplateBinding Width}" Height="{TemplateBinding Height}">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"
                                          TextElement.Foreground="{TemplateBinding Foreground}"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="{DynamicResource PanelSoftBrush}"/>
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="{DynamicResource LineBrush}"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ── Sidebar project item ──────────────────────────────────────────── -->
    <Style x:Key="SidebarItem" TargetType="Button">
        <Setter Property="IsTabStop" Value="False"/>
        <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="BorderThickness" Value="0"/>
        <Setter Property="Foreground" Value="{DynamicResource TextBrush}"/>
        <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
        <Setter Property="Padding" Value="12,13"/>
        <Setter Property="FontSize" Value="{DynamicResource Fs14}"/>
        <Setter Property="FontFamily" Value="{StaticResource PretendardFont}"/>
        <Setter Property="HorizontalAlignment" Value="Stretch"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Grid>
                        <!-- 배경만 Tag(Thickness)만큼 들여쓰기 — 들여쓰기 선 우측부터 호버/선택 배경 -->
                        <Border x:Name="Bd" Background="{TemplateBinding Background}"
                                CornerRadius="8" Margin="{TemplateBinding Tag}"/>
                        <ContentPresenter Margin="{TemplateBinding Padding}"
                                          HorizontalAlignment="Stretch" VerticalAlignment="Center"
                                          TextElement.Foreground="{TemplateBinding Foreground}"/>
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="{DynamicResource PanelSoftBrush}"/>
                            <Setter Property="Foreground" Value="{DynamicResource TextBrush}"/>
                        </Trigger>
                        <!-- 컨텍스트 메뉴가 열려있을 때도 호버 스타일 유지 -->
                        <DataTrigger Binding="{Binding IsOpen, RelativeSource={RelativeSource Self}, Path=ContextMenu}" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="{DynamicResource PanelSoftBrush}"/>
                            <Setter Property="Foreground" Value="{DynamicResource TextBrush}"/>
                        </DataTrigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ── Sidebar item selected state ──────────────────────────────────── -->
    <!-- Template is overridden to keep selected background on hover (no override). -->
    <Style x:Key="SidebarItemSelected" TargetType="Button" BasedOn="{StaticResource SidebarItem}">
        <Setter Property="Background" Value="{DynamicResource PrimarySoftBrush}"/>
        <Setter Property="Foreground" Value="{DynamicResource TextBrush}"/>
        <Setter Property="FontWeight" Value="SemiBold"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Grid>
                        <!-- 배경만 Tag(Thickness)만큼 들여쓰기 — 들여쓰기 선 우측부터 호버/선택 배경 -->
                        <Border x:Name="Bd" Background="{TemplateBinding Background}"
                                CornerRadius="8" Margin="{TemplateBinding Tag}"/>
                        <ContentPresenter Margin="{TemplateBinding Padding}"
                                          HorizontalAlignment="Stretch" VerticalAlignment="Center"
                                          TextElement.Foreground="{TemplateBinding Foreground}"/>
                    </Grid>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ── Sidebar sub-item (folder) ─────────────────────────────────────── -->
    <Style x:Key="SidebarSubItem" TargetType="Button" BasedOn="{StaticResource SidebarItem}">
        <Setter Property="Padding" Value="10,6"/>
        <Setter Property="FontSize" Value="{DynamicResource Fs12}"/>
        <Setter Property="Foreground" Value="{DynamicResource SidebarSubTextBrush}"/>
    </Style>

    <!-- ── Sidebar sub-item selected ────────────────────────────────────── -->
    <Style x:Key="SidebarSubItemSelected" TargetType="Button" BasedOn="{StaticResource SidebarSubItem}">
        <Setter Property="Background" Value="{DynamicResource PrimarySoftBrush}"/>
        <Setter Property="Foreground" Value="{DynamicResource TextBrush}"/>
        <Setter Property="FontWeight" Value="SemiBold"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Grid>
                        <!-- 배경만 Tag(Thickness)만큼 들여쓰기 — 들여쓰기 선 우측부터 호버/선택 배경 -->
                        <Border x:Name="Bd" Background="{TemplateBinding Background}"
                                CornerRadius="8" Margin="{TemplateBinding Tag}"/>
                        <ContentPresenter Margin="{TemplateBinding Padding}"
                                          HorizontalAlignment="Stretch" VerticalAlignment="Center"
                                          TextElement.Foreground="{TemplateBinding Foreground}"/>
                    </Grid>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ── Thread room list item ─────────────────────────────────────────── -->
    <Style x:Key="ThreadRoomItem" TargetType="Button">
        <Setter Property="IsTabStop" Value="False"/>
        <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="BorderThickness" Value="0"/>
        <Setter Property="Foreground" Value="{DynamicResource TextBrush}"/>
        <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
        <Setter Property="Padding" Value="14,14"/>
        <Setter Property="FontSize" Value="{DynamicResource Fs14}"/>
        <Setter Property="FontFamily" Value="{StaticResource PretendardFont}"/>
        <Setter Property="HorizontalAlignment" Value="Stretch"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Grid>
                        <!-- 배경만 Tag(Thickness)만큼 들여쓰기 — 들여쓰기 선 우측부터 호버/선택 배경 -->
                        <Border x:Name="Bd" Background="{TemplateBinding Background}"
                                CornerRadius="8" Margin="{TemplateBinding Tag}"/>
                        <ContentPresenter Margin="{TemplateBinding Padding}"
                                          HorizontalAlignment="Stretch" VerticalAlignment="Center"
                                          TextElement.Foreground="{TemplateBinding Foreground}"/>
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="{DynamicResource PanelSoftBrush}"/>
                        </Trigger>
                        <!-- 컨텍스트 메뉴가 열려있을 때도 호버 스타일 유지 -->
                        <DataTrigger Binding="{Binding IsOpen, RelativeSource={RelativeSource Self}, Path=ContextMenu}" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="{DynamicResource PanelSoftBrush}"/>
                        </DataTrigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="{DynamicResource LineBrush}"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ── Thread room item selected ────────────────────────────────────── -->
    <Style x:Key="ThreadRoomItemSelected" TargetType="Button" BasedOn="{StaticResource ThreadRoomItem}">
        <Setter Property="Background" Value="{DynamicResource PrimarySoftBrush}"/>
        <Setter Property="Foreground" Value="{DynamicResource TextBrush}"/>
        <Setter Property="FontWeight" Value="SemiBold"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="Bd" Background="{TemplateBinding Background}"
                            CornerRadius="10" Padding="{TemplateBinding Padding}"
                            BorderBrush="{DynamicResource PrimarySoftBrush}"
                            BorderThickness="1">
                        <ContentPresenter HorizontalAlignment="Stretch" VerticalAlignment="Center"
                                          TextElement.Foreground="{TemplateBinding Foreground}"/>
                    </Border>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ── Memo input (multi-line textarea) ─────────────────────────────── -->
    <Style x:Key="MemoInputStyle" TargetType="TextBox" BasedOn="{StaticResource {x:Type TextBox}}">
        <Setter Property="Padding" Value="16,14"/>
        <Setter Property="FontSize" Value="{DynamicResource Fs14}"/>
        <Setter Property="FontFamily" Value="{StaticResource PretendardFont}"/>
        <Setter Property="BorderBrush" Value="{DynamicResource LineBrush}"/>
        <Setter Property="BorderThickness" Value="1.5"/>
        <Setter Property="Background" Value="{DynamicResource PanelBrush}"/>
        <Setter Property="Foreground" Value="{DynamicResource TextBrush}"/>
        <Setter Property="CaretBrush" Value="{DynamicResource TextBrush}"/>
        <Setter Property="SelectionBrush" Value="{DynamicResource PrimaryBrush}"/>
        <Setter Property="SelectionOpacity" Value="0.35"/>
        <Setter Property="SelectionTextBrush" Value="{DynamicResource TextBrush}"/>
        <Setter Property="VerticalContentAlignment" Value="Top"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="TextBox">
                    <Border x:Name="Bd" Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}"
                            CornerRadius="10" Padding="{TemplateBinding Padding}">
                        <ScrollViewer x:Name="PART_ContentHost"
                                      Foreground="{TemplateBinding Foreground}"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsFocused" Value="True">
                            <Setter TargetName="Bd" Property="BorderBrush" Value="{DynamicResource PrimaryBrush}"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ── Send button (circular blue) ──────────────────────────────────── -->
    <Style x:Key="SendButton" TargetType="Button">
        <Setter Property="IsTabStop" Value="False"/>
        <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
        <Setter Property="Background" Value="{DynamicResource PrimaryBrush}"/>
        <Setter Property="Foreground" Value="White"/>
        <Setter Property="BorderThickness" Value="0"/>
        <Setter Property="FontFamily" Value="{StaticResource PretendardFont}"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="Bd" Background="{TemplateBinding Background}"
                            CornerRadius="50"
                            Width="{TemplateBinding Width}"
                            Height="{TemplateBinding Height}">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"
                                          TextElement.Foreground="{TemplateBinding Foreground}"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Bd" Property="Background">
                                <Setter.Value><SolidColorBrush Color="{DynamicResource PrimaryHoverColor}"/></Setter.Value>
                            </Setter>
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="Bd" Property="Background">
                                <Setter.Value><SolidColorBrush Color="{DynamicResource PrimaryPressedColor}"/></Setter.Value>
                            </Setter>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ── Bubble action buttons (circular 28×28) ───────────────────────── -->
    <Style x:Key="BubbleActionBtn" TargetType="Button">
        <Setter Property="IsTabStop" Value="False"/>
        <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
        <Setter Property="Width" Value="28"/>
        <Setter Property="Height" Value="28"/>
        <Setter Property="Background" Value="{DynamicResource PanelSoftBrush}"/>
        <Setter Property="Foreground" Value="{DynamicResource TextMutedBrush}"/>
        <Setter Property="BorderBrush" Value="{DynamicResource LineBrush}"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="FontFamily" Value="{StaticResource PretendardFont}"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="Bd" Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}"
                            CornerRadius="14">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"
                                          TextElement.Foreground="{TemplateBinding Foreground}"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="{DynamicResource LineBrush}"/>
                            <Setter Property="Foreground" Value="{DynamicResource TextBrush}"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="BubbleActionBtnDanger" TargetType="Button" BasedOn="{StaticResource BubbleActionBtn}">
        <Setter Property="Foreground" Value="{DynamicResource DangerBrush}"/>
    </Style>

    <!-- ── Toggle switch (CheckBox skinned as iOS-style switch) ─────────── -->
    <Style x:Key="ToggleSwitch" TargetType="CheckBox">
        <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
        <Setter Property="SnapsToDevicePixels" Value="True"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="CheckBox">
                    <Grid Width="44" Height="24">
                        <Border x:Name="Track" CornerRadius="12"
                                Background="{DynamicResource LineBrush}"/>
                        <Border x:Name="Thumb" Width="20" Height="20"
                                CornerRadius="10" Background="White"
                                HorizontalAlignment="Left"
                                Margin="2,0,0,0"
                                BorderBrush="#22000000" BorderThickness="0.5">
                            <Border.RenderTransform>
                                <TranslateTransform X="0"/>
                            </Border.RenderTransform>
                        </Border>
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsChecked" Value="True">
                            <Setter TargetName="Track" Property="Background"
                                    Value="{DynamicResource PrimaryBrush}"/>
                            <Trigger.EnterActions>
                                <BeginStoryboard>
                                    <Storyboard>
                                        <DoubleAnimation
                                            Storyboard.TargetName="Thumb"
                                            Storyboard.TargetProperty="(UIElement.RenderTransform).(TranslateTransform.X)"
                                            To="20" Duration="0:0:0.15"/>
                                    </Storyboard>
                                </BeginStoryboard>
                            </Trigger.EnterActions>
                            <Trigger.ExitActions>
                                <BeginStoryboard>
                                    <Storyboard>
                                        <DoubleAnimation
                                            Storyboard.TargetName="Thumb"
                                            Storyboard.TargetProperty="(UIElement.RenderTransform).(TranslateTransform.X)"
                                            To="0" Duration="0:0:0.15"/>
                                    </Storyboard>
                                </BeginStoryboard>
                            </Trigger.ExitActions>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ── Toggle switch (small variant: 36×20) ────────────────────────── -->
    <Style x:Key="ToggleSwitchSmall" TargetType="CheckBox">
        <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
        <Setter Property="SnapsToDevicePixels" Value="True"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="CheckBox">
                    <Grid Width="36" Height="20">
                        <Border x:Name="Track" CornerRadius="10"
                                Background="{DynamicResource LineBrush}"/>
                        <Border x:Name="Thumb" Width="16" Height="16"
                                CornerRadius="8" Background="White"
                                HorizontalAlignment="Left"
                                Margin="2,0,0,0"
                                BorderBrush="#22000000" BorderThickness="0.5">
                            <Border.RenderTransform>
                                <TranslateTransform X="0"/>
                            </Border.RenderTransform>
                        </Border>
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsChecked" Value="True">
                            <Setter TargetName="Track" Property="Background"
                                    Value="{DynamicResource PrimaryBrush}"/>
                            <Trigger.EnterActions>
                                <BeginStoryboard>
                                    <Storyboard>
                                        <DoubleAnimation
                                            Storyboard.TargetName="Thumb"
                                            Storyboard.TargetProperty="(UIElement.RenderTransform).(TranslateTransform.X)"
                                            To="16" Duration="0:0:0.15"/>
                                    </Storyboard>
                                </BeginStoryboard>
                            </Trigger.EnterActions>
                            <Trigger.ExitActions>
                                <BeginStoryboard>
                                    <Storyboard>
                                        <DoubleAnimation
                                            Storyboard.TargetName="Thumb"
                                            Storyboard.TargetProperty="(UIElement.RenderTransform).(TranslateTransform.X)"
                                            To="0" Duration="0:0:0.15"/>
                                    </Storyboard>
                                </BeginStoryboard>
                            </Trigger.ExitActions>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ── Modern check box ─────────────────────────────────────────────── -->
    <Style x:Key="ModernCheckBox" TargetType="CheckBox">
        <Setter Property="Foreground" Value="{DynamicResource TextBrush}"/>
        <Setter Property="FontFamily" Value="{StaticResource PretendardFont}"/>
        <Setter Property="FontSize" Value="{DynamicResource Fs13}"/>
        <Setter Property="VerticalContentAlignment" Value="Center"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="CheckBox">
                    <StackPanel Orientation="Horizontal" Background="Transparent">
                        <Border x:Name="Box"
                                Width="{Binding Tag, RelativeSource={RelativeSource AncestorType=CheckBox}, TargetNullValue=18, FallbackValue=18}"
                                Height="{Binding Tag, RelativeSource={RelativeSource AncestorType=CheckBox}, TargetNullValue=18, FallbackValue=18}"
                                CornerRadius="4"
                                Background="{DynamicResource PanelBrush}"
                                BorderBrush="{DynamicResource LineBrush}"
                                BorderThickness="1.5"
                                VerticalAlignment="Center">
                            <Path x:Name="Check"
                                  Data="M 0,4 L 4,8 L 11,0"
                                  Stretch="None"
                                  HorizontalAlignment="Center"
                                  VerticalAlignment="Center"
                                  Stroke="White" StrokeThickness="2"
                                  StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                                  StrokeLineJoin="Round"
                                  Visibility="Collapsed"/>
                        </Border>
                        <ContentPresenter x:Name="ContentHost"
                                          Margin="8,0,0,0"
                                          VerticalAlignment="Center"
                                          RecognizesAccessKey="True"
                                          TextElement.Foreground="{TemplateBinding Foreground}"/>
                    </StackPanel>
                    <ControlTemplate.Triggers>
                        <Trigger Property="Content" Value="{x:Null}">
                            <Setter TargetName="ContentHost" Property="Margin" Value="0"/>
                        </Trigger>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Box" Property="BorderBrush" Value="{DynamicResource PrimaryBrush}"/>
                            <!-- 호버 시 보더 두께 1.5 유지 — 색만 강조. -->
                            <Setter TargetName="Box" Property="BorderThickness" Value="1.5"/>
                        </Trigger>
                        <Trigger Property="IsChecked" Value="True">
                            <Setter TargetName="Box" Property="Background" Value="{DynamicResource PrimaryBrush}"/>
                            <!-- 단색 처리 — BorderThickness=0 으로 보더/배경 시각 차이 제거. -->
                            <Setter TargetName="Box" Property="BorderThickness" Value="0"/>
                            <Setter TargetName="Check" Property="Visibility" Value="Visible"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ── GridSplitter ──────────────────────────────────────────────────── -->
    <Style TargetType="GridSplitter">
        <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="Margin" Value="-1,0,-1,0"/>
        <Setter Property="Panel.ZIndex" Value="1"/>
        <Setter Property="Cursor" Value="SizeWE"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="GridSplitter">
                    <Grid Background="Transparent">
                        <Border x:Name="Handle" Width="2" Height="28" CornerRadius="1"
                                HorizontalAlignment="Center" VerticalAlignment="Center"
                                Background="{DynamicResource PrimaryBrush}" Opacity="0"/>
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Handle" Property="Opacity" Value="1"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- 가로(행) 스플리터 — 핸들이 수평 막대 (기본 스타일은 세로 막대 핸들이라 가로 스플리터에선 점으로 보임) -->
    <Style x:Key="GridSplitterHorizontal" TargetType="GridSplitter" BasedOn="{StaticResource {x:Type GridSplitter}}">
        <Setter Property="Margin" Value="0,-1,0,-1"/>
        <Setter Property="Cursor" Value="SizeNS"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="GridSplitter">
                    <Grid Background="Transparent">
                        <Border x:Name="Handle" Width="28" Height="2" CornerRadius="1"
                                HorizontalAlignment="Center" VerticalAlignment="Center"
                                Background="{DynamicResource PrimaryBrush}" Opacity="0"/>
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Handle" Property="Opacity" Value="1"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ── Slim scroll bar ──────────────────────────────────────────────── -->
    <Style x:Key="SlimScrollThumb" TargetType="Thumb">
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Thumb">
                    <Border CornerRadius="3"
                            Background="{DynamicResource LineBrush}"
                            Margin="1,2"/>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style TargetType="ScrollBar">
        <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="Width" Value="8"/>
        <Setter Property="MinWidth" Value="8"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ScrollBar">
                    <Grid Background="Transparent">
                        <Track x:Name="PART_Track" IsDirectionReversed="True">
                            <Track.Thumb>
                                <Thumb Style="{StaticResource SlimScrollThumb}"/>
                            </Track.Thumb>
                            <Track.IncreaseRepeatButton>
                                <RepeatButton Command="ScrollBar.PageDownCommand" Opacity="0" Focusable="False"/>
                            </Track.IncreaseRepeatButton>
                            <Track.DecreaseRepeatButton>
                                <RepeatButton Command="ScrollBar.PageUpCommand" Opacity="0" Focusable="False"/>
                            </Track.DecreaseRepeatButton>
                        </Track>
                    </Grid>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
        <Style.Triggers>
            <Trigger Property="Orientation" Value="Horizontal">
                <Setter Property="Width" Value="Auto"/>
                <Setter Property="Height" Value="8"/>
                <Setter Property="MinHeight" Value="8"/>
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="ScrollBar">
                            <Grid Background="Transparent">
                                <Track x:Name="PART_Track">
                                    <Track.Thumb>
                                        <Thumb Style="{StaticResource SlimScrollThumb}"/>
                                    </Track.Thumb>
                                    <Track.IncreaseRepeatButton>
                                        <RepeatButton Command="ScrollBar.PageRightCommand" Opacity="0" Focusable="False"/>
                                    </Track.IncreaseRepeatButton>
                                    <Track.DecreaseRepeatButton>
                                        <RepeatButton Command="ScrollBar.PageLeftCommand" Opacity="0" Focusable="False"/>
                                    </Track.DecreaseRepeatButton>
                                </Track>
                            </Grid>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Trigger>
        </Style.Triggers>
    </Style>

    <!-- ── Code language dropdown menu item ────────────────────────────── -->
    <Style x:Key="CodeLangMenuItem" TargetType="Button">
        <Setter Property="IsTabStop" Value="False"/>
        <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
        <Setter Property="HorizontalContentAlignment" Value="Left"/>
        <Setter Property="MinWidth" Value="96"/>
        <Setter Property="Padding" Value="10,6"/>
        <Setter Property="FontSize" Value="12"/>
        <Setter Property="FontFamily" Value="{StaticResource PretendardFont}"/>
        <Setter Property="Foreground" Value="{DynamicResource TextBrush}"/>
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="Cursor" Value="Arrow"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="Bd" Background="{TemplateBinding Background}"
                            CornerRadius="4" Padding="{TemplateBinding Padding}">
                        <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                          VerticalAlignment="Center"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="{DynamicResource PrimarySoftBrush}"/>
                        </Trigger>
                        <Trigger Property="Tag" Value="active">
                            <Setter TargetName="Bd" Property="Background" Value="{DynamicResource CodeActiveBgBrush}"/>
                            <Setter Property="Foreground" Value="{DynamicResource CodeActiveTextBrush}"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ── Slash command popup menu item ───────────────────────────────── -->
    <Style x:Key="SlashMenuItem" TargetType="Button">
        <Setter Property="Focusable" Value="False"/>
        <Setter Property="IsTabStop" Value="False"/>
        <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
        <Setter Property="HorizontalContentAlignment" Value="Left"/>
        <Setter Property="Padding" Value="10,7"/>
        <Setter Property="FontSize" Value="{DynamicResource Fs13}"/>
        <Setter Property="Foreground" Value="{DynamicResource TextBrush}"/>
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="Cursor" Value="Arrow"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="Bd" Background="{TemplateBinding Background}"
                            CornerRadius="6" Padding="{TemplateBinding Padding}">
                        <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                          VerticalAlignment="Center"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="{DynamicResource PanelSoftBrush}"/>
                        </Trigger>
                        <Trigger Property="Tag" Value="selected">
                            <Setter TargetName="Bd" Property="Background" Value="{DynamicResource PrimarySoftBrush}"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ── Window control buttons (light theme: AuthWindow) ─────────────── -->
    <!-- 탭 스트립의 새 탭 + 버튼 (스택 아이콘). 비활성(IsEnabled=False) 시 흐려짐.
         일반 탭과 같은 높이로 배치되되 배경은 투명 → 호버 시 PanelSoftBrush 로 살짝 떠오르는 느낌. -->
    <Style x:Key="NewTabButton" TargetType="Button">
        <Setter Property="IsTabStop" Value="False"/>
        <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="Foreground" Value="{DynamicResource TextMutedBrush}"/>
        <Setter Property="BorderThickness" Value="0"/>
        <Setter Property="Cursor" Value="Arrow"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="Bd" Background="{TemplateBinding Background}" CornerRadius="8">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="{DynamicResource PanelSoftBrush}"/>
                            <Setter Property="Foreground" Value="{DynamicResource TextBrush}"/>
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="{DynamicResource LineBrush}"/>
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Opacity" Value="0.3"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- 탭 오버플로우 좌·우 스크롤 버튼 (devez TabNavButton). 비활성(끝 도달) 시 흐려짐. -->
    <Style x:Key="TabNavButton" TargetType="Button">
        <Setter Property="IsTabStop" Value="False"/>
        <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
        <Setter Property="Width" Value="22"/>
        <Setter Property="Height" Value="22"/>
        <Setter Property="Cursor" Value="Arrow"/>
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="Foreground" Value="{DynamicResource TextMutedBrush}"/>
        <Setter Property="BorderThickness" Value="0"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="Bd" Background="{TemplateBinding Background}" CornerRadius="5">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="{DynamicResource PanelSoftBrush}"/>
                            <Setter Property="Foreground" Value="{DynamicResource TextBrush}"/>
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Opacity" Value="0.3"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="WinCtrlBtn" TargetType="Button">
        <Setter Property="IsTabStop" Value="False"/>
        <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
        <Setter Property="Width" Value="40"/>
        <Setter Property="Height" Value="26"/>
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="Foreground" Value="{DynamicResource TextMutedBrush}"/>
        <Setter Property="BorderThickness" Value="0"/>
        <Setter Property="FontFamily" Value="{StaticResource PretendardFont}"/>
        <Setter Property="FontSize" Value="{DynamicResource Fs13}"/>
        <Setter Property="WindowChrome.IsHitTestVisibleInChrome" Value="True"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="Bd" Background="{TemplateBinding Background}"
                            CornerRadius="5"
                            BorderThickness="1" BorderBrush="Transparent">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"
                                          TextElement.Foreground="{TemplateBinding Foreground}"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="{DynamicResource PanelSoftBrush}"/>
                            <Setter TargetName="Bd" Property="BorderBrush" Value="{DynamicResource LineBrush}"/>
                            <Setter Property="Foreground" Value="{DynamicResource TextBrush}"/>
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="{DynamicResource LineBrush}"/>
                            <Setter TargetName="Bd" Property="BorderBrush" Value="{DynamicResource LineBrush}"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ── 세그먼트 라디오 (3분할 그룹 — McpOAuthMode 용) ────────────────── -->
    <!-- 3개의 라디오를 좌/중/우로 붙여 한 줄 그룹처럼 보이게 한다. 코너는 양 끝만 라운드. -->
    <Style x:Key="McpRadioLeft" TargetType="RadioButton" BasedOn="{StaticResource {x:Type RadioButton}}">
        <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="FontSize" Value="{DynamicResource Fs12}"/>
        <Setter Property="Foreground" Value="{DynamicResource TextBrush}"/>
        <Setter Property="Padding" Value="10,6"/>
        <Setter Property="HorizontalContentAlignment" Value="Center"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="RadioButton">
                    <Border x:Name="Bd" CornerRadius="6,0,0,6" Padding="{TemplateBinding Padding}"
                            BorderBrush="{DynamicResource LineBrush}" BorderThickness="1,1,0,1"
                            Background="{DynamicResource PanelBrush}">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"
                                          TextElement.Foreground="{TemplateBinding Foreground}"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsChecked" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="{DynamicResource PrimarySoftBrush}"/>
                            <Setter TargetName="Bd" Property="BorderBrush" Value="{DynamicResource PrimaryBrush}"/>
                            <Setter Property="Foreground" Value="{DynamicResource PrimaryBrush}"/>
                            <Setter Property="FontWeight" Value="SemiBold"/>
                        </Trigger>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="{DynamicResource PanelSoftBrush}"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
    <Style x:Key="McpRadioMid" TargetType="RadioButton" BasedOn="{StaticResource McpRadioLeft}">
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="RadioButton">
                    <Border x:Name="Bd" CornerRadius="0" Padding="{TemplateBinding Padding}"
                            BorderBrush="{DynamicResource LineBrush}" BorderThickness="1,1,0,1"
                            Background="{DynamicResource PanelBrush}">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"
                                          TextElement.Foreground="{TemplateBinding Foreground}"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsChecked" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="{DynamicResource PrimarySoftBrush}"/>
                            <Setter TargetName="Bd" Property="BorderBrush" Value="{DynamicResource PrimaryBrush}"/>
                            <Setter Property="Foreground" Value="{DynamicResource PrimaryBrush}"/>
                            <Setter Property="FontWeight" Value="SemiBold"/>
                        </Trigger>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="{DynamicResource PanelSoftBrush}"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
    <Style x:Key="McpRadioRight" TargetType="RadioButton" BasedOn="{StaticResource McpRadioLeft}">
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="RadioButton">
                    <Border x:Name="Bd" CornerRadius="0,6,6,0" Padding="{TemplateBinding Padding}"
                            BorderBrush="{DynamicResource LineBrush}" BorderThickness="1"
                            Background="{DynamicResource PanelBrush}">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"
                                          TextElement.Foreground="{TemplateBinding Foreground}"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsChecked" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="{DynamicResource PrimarySoftBrush}"/>
                            <Setter TargetName="Bd" Property="BorderBrush" Value="{DynamicResource PrimaryBrush}"/>
                            <Setter Property="Foreground" Value="{DynamicResource PrimaryBrush}"/>
                            <Setter Property="FontWeight" Value="SemiBold"/>
                        </Trigger>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="{DynamicResource PanelSoftBrush}"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="WinCloseBtn" TargetType="Button" BasedOn="{StaticResource WinCtrlBtn}">
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="Bd" Background="{TemplateBinding Background}"
                            CornerRadius="5"
                            BorderThickness="1" BorderBrush="Transparent">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"
                                          TextElement.Foreground="{TemplateBinding Foreground}"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="#ef4444"/>
                            <Setter TargetName="Bd" Property="BorderBrush" Value="#dc2626"/>
                            <Setter Property="Foreground" Value="White"/>
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="#dc2626"/>
                            <Setter TargetName="Bd" Property="BorderBrush" Value="#b91c1c"/>
                            <Setter Property="Foreground" Value="White"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ── Window control buttons (dark navy title bar: MainWindow) ────── -->
    <Style x:Key="WinCtrlBtnDark" TargetType="Button">
        <Setter Property="IsTabStop" Value="False"/>
        <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
        <Setter Property="Width" Value="46"/>
        <Setter Property="Height" Value="46"/>
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="Foreground" Value="#cbd5e1"/>
        <Setter Property="BorderThickness" Value="0"/>
        <Setter Property="FontFamily" Value="{StaticResource PretendardFont}"/>
        <Setter Property="FontSize" Value="{DynamicResource Fs13}"/>
        <Setter Property="WindowChrome.IsHitTestVisibleInChrome" Value="True"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="Bd" Background="{TemplateBinding Background}">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"
                                          TextElement.Foreground="{TemplateBinding Foreground}"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="#2a3a5e"/>
                            <Setter Property="Foreground" Value="White"/>
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="#1f2d4d"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ── Context menu (rounded popup with subtle shadow) ─────────────── -->
    <Style TargetType="ContextMenu">
        <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
        <Setter Property="Background" Value="{DynamicResource PanelBrush}"/>
        <Setter Property="BorderBrush" Value="{DynamicResource LineBrush}"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="Padding" Value="4"/>
        <Setter Property="FontFamily" Value="{StaticResource PretendardFont}"/>
        <Setter Property="Foreground" Value="{DynamicResource TextBrush}"/>
        <Setter Property="HasDropShadow" Value="False"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ContextMenu">
                    <Grid Margin="10">
                        <!-- Shadow layer (unclipped so shadow bleeds into margin) -->
                        <Border CornerRadius="14"
                                Background="{TemplateBinding Background}">
                            <Border.Effect>
                                <DropShadowEffect Color="{DynamicResource ShadowColor}" Opacity="{DynamicResource PopupShadowOpacity}"
                                                  ShadowDepth="4" BlurRadius="16"
                                                  Direction="270"/>
                            </Border.Effect>
                        </Border>
                        <!-- Content layer (clipped so items don't bleed past rounded corners) -->
                        <Border CornerRadius="10"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                Padding="{TemplateBinding Padding}"
                                ClipToBounds="True">
                            <StackPanel IsItemsHost="True"
                                        KeyboardNavigation.DirectionalNavigation="Cycle"/>
                        </Border>
                    </Grid>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ── Top-level / inline MenuItem (rows inside a ContextMenu) ──────── -->
    <Style TargetType="MenuItem">
        <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="Foreground" Value="{DynamicResource TextBrush}"/>
        <Setter Property="FontFamily" Value="{StaticResource PretendardFont}"/>
        <Setter Property="FontSize" Value="{DynamicResource Fs12}"/>
        <Setter Property="Padding" Value="10,8"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="MenuItem">
                    <Border x:Name="Bd" CornerRadius="6"
                            Background="{TemplateBinding Background}"
                            Padding="{TemplateBinding Padding}"
                            MinWidth="160">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="20"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <ContentPresenter Grid.Column="0" ContentSource="Icon"
                                              Width="16" Height="16"
                                              HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            <ContentPresenter Grid.Column="1"
                                              ContentSource="Header"
                                              RecognizesAccessKey="True"
                                              VerticalAlignment="Center"
                                              HorizontalAlignment="Left"
                                              Margin="8,0,0,0"
                                              TextElement.Foreground="{TemplateBinding Foreground}"/>
                            <TextBlock Grid.Column="2"
                                       Text="{TemplateBinding InputGestureText}"
                                       Foreground="{DynamicResource TextMutedBrush}"
                                       Margin="20,0,0,0"
                                       VerticalAlignment="Center"
                                       FontSize="{DynamicResource Fs11}"/>
                        </Grid>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsHighlighted" Value="True">
                            <Setter TargetName="Bd" Property="Background"
                                    Value="{DynamicResource PanelSoftBrush}"/>
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Opacity" Value="0.5"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ── Submenu-capable MenuItem (has child items → shows arrow + popup) ── -->
    <Style x:Key="SubMenuHeaderItem" TargetType="MenuItem">
        <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="Foreground" Value="{DynamicResource TextBrush}"/>
        <Setter Property="FontFamily" Value="{StaticResource PretendardFont}"/>
        <Setter Property="FontSize" Value="{DynamicResource Fs12}"/>
        <Setter Property="Padding" Value="10,8"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="MenuItem">
                    <Grid>
                        <Border x:Name="Bd" CornerRadius="6"
                                Background="{TemplateBinding Background}"
                                Padding="{TemplateBinding Padding}"
                                MinWidth="160">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="20"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <ContentPresenter Grid.Column="0" ContentSource="Icon"
                                                  Width="16" Height="16"
                                                  HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                <ContentPresenter Grid.Column="1"
                                                  ContentSource="Header"
                                                  RecognizesAccessKey="True"
                                                  VerticalAlignment="Center"
                                                  HorizontalAlignment="Left"
                                                  Margin="8,0,0,0"
                                                  TextElement.Foreground="{TemplateBinding Foreground}"/>
                                <Path Grid.Column="2"
                                      Data="M0,0 L0,8 L5,4 Z"
                                      Fill="{DynamicResource TextMutedBrush}"
                                      VerticalAlignment="Center"
                                      Width="5" Height="8"
                                      Stretch="Fill"
                                      Margin="6,0,0,0"/>
                            </Grid>
                        </Border>
                        <Popup x:Name="PART_Popup"
                               AllowsTransparency="True"
                               Focusable="False"
                               IsOpen="{Binding IsSubmenuOpen, RelativeSource={RelativeSource TemplatedParent}}"
                               Placement="Right"
                               PlacementTarget="{Binding ElementName=Bd}">
                            <Grid Margin="10">
                                <Border Background="{DynamicResource PanelBrush}"
                                        CornerRadius="14">
                                    <Border.Effect>
                                        <DropShadowEffect Color="{DynamicResource ShadowColor}" Opacity="{DynamicResource PopupShadowOpacity}"
                                                          ShadowDepth="4" BlurRadius="16"
                                                          Direction="270"/>
                                    </Border.Effect>
                                </Border>
                                <Border Background="{DynamicResource PanelBrush}"
                                        BorderBrush="{DynamicResource LineBrush}"
                                        BorderThickness="1"
                                        CornerRadius="10"
                                        Padding="4"
                                        ClipToBounds="True">
                                    <StackPanel IsItemsHost="True"
                                                KeyboardNavigation.DirectionalNavigation="Cycle"/>
                                </Border>
                            </Grid>
                        </Popup>
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsHighlighted" Value="True">
                            <Setter TargetName="Bd" Property="Background"
                                    Value="{DynamicResource PanelSoftBrush}"/>
                            <Setter Property="IsSubmenuOpen" Value="True"/>
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Opacity" Value="0.5"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ── Separator inside a ContextMenu ────────────────────────────── -->
    <Style x:Key="{x:Static MenuItem.SeparatorStyleKey}" TargetType="Separator">
        <Setter Property="Height" Value="1"/>
        <Setter Property="Margin" Value="6,4"/>
        <Setter Property="Background" Value="{DynamicResource LineBrush}"/>
        <Setter Property="BorderThickness" Value="0"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Separator">
                    <Border Background="{TemplateBinding Background}"
                            Height="{TemplateBinding Height}"/>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="WinCloseBtnDark" TargetType="Button" BasedOn="{StaticResource WinCtrlBtnDark}">
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="Bd" Background="{TemplateBinding Background}">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"
                                          TextElement.Foreground="{TemplateBinding Foreground}"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="#ef4444"/>
                            <Setter Property="Foreground" Value="White"/>
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="#dc2626"/>
                            <Setter Property="Foreground" Value="White"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

</ResourceDictionary>
